            {
                alarm[0] = 1;
            }
        }
    }
}
if (con == 1)
{
    lifespan -= (1 / global.fps_scale);
    if (lifespan < 1)
    {
        image_alpha *= power(0.9, 1 / global.fps_scale);
        if (image_alpha < 0.05)
        {
            instance_destroy();
        }
    }
}
if (x < camerax() || x > (camerax() + 640) || y < cameray() || y > (cameray() + 480) || x < (0 - (sprite_width * 2)) || x > (room_width + (sprite_width * 2)) || y > (room_height + (sprite_height * 2)) || y < (0 - (sprite_height * 2)))
{
    instance_destroy();
}
