Apply("gml_Object_obj_bq_baseball_final_Step_0", @"physics_tick += 1;
if (physics_tick >= global.fps_scale)
{
    physics_tick = 0;
}
if (global.fps_scale <= 1 || physics_tick == 1)
{
    var v30 = vspeed * global.fps_scale;
    if (state == 0 && v30 >= (8 / f))
    {
        acc += 0.1;
        v30 += acc;
        if (v30 > (24 / f))
        {
            state = 1;
        }
    }
    if (state == 1)
    {
        acc -= 0.1;
        v30 += acc;
        if (v30 < (4 / f))
        {
            state = 2;
            v30 = 4;
        }
    }
    vspeed = v30 / global.fps_scale;
}
if (hit == -1)
{
    if (image_xscale < 6)
    {
        image_xscale += (0.1 / global.fps_scale);
        image_yscale += (0.1 / global.fps_scale);
    }
    x = (xstart - 5) + irandom(10);
    y = (ystart - 5) + irandom(10);
    spin_speed = scr_movetowards(spin_speed, 135, 1 / global.fps_scale);
}
image_angle += (spin_speed / global.fps_scale);
if (hit == 1)
{
    snd_stop(snd_quake_nes);
    hit_timer += (1 / global.fps_scale);
    if (hit_timer <= (1 / global.fps_scale))
    {
        reticletimer = -999;
        repeat (3)
        {
            fakesplash = instance_create((x - 20) + irandom(40), (y - 20) + irandom(40), o_boxing_splash);
            fakesplash.friction = -0.5 / (global.fps_scale * global.fps_scale);
            fakesplash.sprite_index = spr_boxing_splash2;
            if (hit_direction == -1)
            {
                fakesplash.hspeed = (-1 - random(2)) / global.fps_scale;
            }
            if (hit_direction == 1)
            {
                fakesplash.hspeed = (1 + random(2)) / global.fps_scale;
            }
            fakesplash.vspeed = (1 + random(2)) / global.fps_scale;
        }
        xbase = x;
        ybase = y;
    }
    if (hit_timer == (90 / f))
    {
        snd_pitch(snd_play(snd_wing), 0.7);
    }
    if (hit_timer == (160 / f))
    {
        snd_pitch(snd_play(snd_wing), 1);
    }
    if (hit_timer == (220 / f))
    {
        snd_pitch(snd_play(snd_wing), 1.3);
    }
    if (hit_timer > 0 && hit_timer < (40 / f))
    {
        x = (xbase + (40 / ceil(hit_timer))) - irandom(80 / ceil(hit_timer));
        y = (ybase + (40 / ceil(hit_timer))) - irandom(80 / ceil(hit_timer));
        player_basex = o_boxingcontroller.x;
        player_basey = o_boxingcontroller.y;
    }
    if (hit_timer > (90 / f) && hit_timer < (130 / f))
    {
        player_shake_timer += (1 / global.fps_scale);
        o_boxingcontroller.x = (player_basex + (20 / ceil(player_shake_timer))) - irandom(40 / ceil(player_shake_timer));
        o_boxingcontroller.y = (player_basey + (20 / ceil(player_shake_timer))) - irandom(40 / ceil(player_shake_timer));
    }
    if (hit_timer == (130 / f))
    {
        player_shake_timer = 0;
    }
    if (hit_timer > (160 / f) && hit_timer < (200 / f))
    {
        player_shake_timer += (1 / global.fps_scale);
        o_boxingcontroller.x = (player_basex + (20 / ceil(player_shake_timer))) - irandom(40 / ceil(player_shake_timer));
        o_boxingcontroller.y = (player_basey + (20 / ceil(player_shake_timer))) - irandom(40 / ceil(player_shake_timer));
    }
    if (hit_timer == (220 / f))
    {
        instance_create(x, y + 91, o_bq_screen_flash);
        with (obj_fx_speedlines)
        {
            instance_destroy();
        }
        var speedlines = instance_create(x, o_boxingcontroller.y - 144, obj_fx_speedlines);
        speedlines.offsety = true;
        speedlines.flashframe = true;
        speedlines.depth = o_bq_screen_flash.depth - 1;
        snd_play(snd_whip_throw_only);
    }
    if (hit_timer > (220 / f))
    {
        spin_speed = -135;
        vspeed = -64 / f / global.fps_scale;
    }
    else if (hit_timer > (30 / f))
    {
        spin_speed = scr_movetowards(spin_speed, 0, 1 / global.fps_scale);
    }
    if (y < -850)
    {
        instance_destroy();
        instance_create(x, y, obj_bq_baseball_final_hits_boss);
        snd_play(snd_queen_gasp);
    }
}
if (y > 20 && !instance_exists(o_bq_whitefade) && hit != 1)
{
    instance_create(x, y, o_bq_whitefade);
}
");

