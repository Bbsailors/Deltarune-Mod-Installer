            }
        }
        if (check2 < -80)
        {
            with (check2)
            {
                instance_destroy();
            }
        }
    }
    if (i_ex(check3))
    {
        if (frac(timer) == 0)
        {
            with (check3)
            {
                scr_afterimagefast();
            }
        }
        check3.vspeed *= power(1.1, 1 / global.fps_scale);
        check3.hspeed *= power(1.1, 1 / global.fps_scale);
        if (check3 < -80)
        {
            with (check3)
            {
                instance_destroy();
            }
        }
    }
    if (timer == 25)
