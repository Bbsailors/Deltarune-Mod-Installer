{
    obj_queen_enemy.actcon = 35;
    instance_destroy();
}
if (angledraw == 1)
{
    lx = lengthdir_x(mypower, angle);
    ly = lengthdir_y(mypower, angle);
    for (i = 0; i < 42; i += 1)
    {
        krisyadd = krisgrav + (krisgrav * i);
        if (i > 0)
        {
            krisyoff[i] = krisyoff[i - 1] + krisyadd;
        }
        else
        {
            krisyoff[0] = krisyadd;
        }
    }
}
