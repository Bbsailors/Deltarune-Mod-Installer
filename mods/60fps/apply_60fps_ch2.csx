    {
        target = instance_nearest(x, y, obj_sneo_faceattack_target);
    }
}
if (x >= (camerax() + 500) && x < (camerax() + 530) && instance_exists(obj_sneo_faceattack) && obj_sneo_faceattack.init == 1)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_sneo_vine_cut_Draw_0", @"timer += (1 / global.fps_scale);
if (shakeamount > 0)
{
    shakeamount--;
}
var shakeamount2 = shakeamount - random(shakeamount * 2);
y1 = ((obj_spamton_neo_enemy.y + obj_spamton_neo_enemy.party[vineid]) - 10) + obj_spamton_neo_enemy.partyoff[vineid];
if (type == 0)
{
    if (timer == 11)
    {
        x3 = x1;
        x4 = x2;
        y3 = y1 - 130;
        y4 = y2;
        y2 = y1 - 130;
    }
    if (timer > 11)
    {
        if (y4 < y3)
        {
            y3 -= (4 / global.fps_scale);
        }
        if (y1 > y2)
        {
            y2 += (4 / global.fps_scale);
        }
    }
    if (timer == 60)
    {
        instance_destroy();
    }
}
if (type == 1)
{
    if (timer > 1 && timer < 17)
    {
        x3 += (lengthdir_x(anglecutspeed, lineangle + 23) / global.fps_scale);
        y3 += (lengthdir_y(anglecutspeed, lineangle + 23) / global.fps_scale);
        x2 += (lengthdir_x(anglecutspeed, lineangle - 157) / global.fps_scale);
        y2 += (lengthdir_y(anglecutspeed, lineangle - 157) / global.fps_scale);
        anglecutspeed -= (0.2 / global.fps_scale);
    }
    if (timer > 11)
    {
        alpha -= (0.1 / global.fps_scale);
    }
    if (timer > 21)
    {
    }
    if (timer == 60 || alpha < 0.1)
    {
        instance_destroy();
    }
}
