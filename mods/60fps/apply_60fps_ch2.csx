    {
        depth = -100;
        if (global.lang == ""ja"")
        {
            STRINGMAX = 7;
        }
    }
}
if (EVENT == 71)
{
    if (i_ex(CHOICE))
    {
        global.truename = CHOICE.NAMESTRING;
        FN_3 = global.truename;
        if (FN_3 == ""GASTER"" || FN_3 == ""ãŒã™ãŸãƒ¼"" || FN_3 == ""ã‚¬ã‚¹ã‚¿ãƒ¼"")
        {
            snd_free_all();
            game_restart_true();
        }
        if (CHOICE.backout == 1)
        {
            CANCELMENU = 1;
            with (CHOICE)
            {
                instance_destroy();
            }
        }
    }
    else
    {
        EVENT = 73;
    }
}
if (EVENT == 73)
{
    with (obj_writer)
    {
        instance_destroy();
    }
    FOUND = 0;
    FN = global.truename;
    event_user(0);
    msgsetloc(0, ""THIS IS YOUR NAME."", ""DEVICE_NAMER_slash_Draw_0_gml_84_0"");
    if (global.lang == ""ja"")
    {
