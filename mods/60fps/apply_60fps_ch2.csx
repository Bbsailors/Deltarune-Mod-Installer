Apply("gml_Object_obj_queencar_Step_0", @"if (con == 1)
{
    global.interact = 1;
    contimer = 0;
    msgtimer = 0;
    swantimer = 0;
    if (swan == 0)
    {
        active = 1;
        con = 2;
        obj_mainchara.visible = 0;
        with (obj_caterpillarchara)
        {
            visible = 0;
        }
    }
    if (swan == 1)
    {
        con = 1.5;
        with (obj_mainchara)
        {
            fun = 1;
            global.facing = 1;
            scr_move_to_point_over_time(obj_queencar.x + obj_queencar.swanmaincharax, obj_queencar.y + obj_queencar.swanmaincharay, 15);
        }
        with (obj_caterpillarchara)
        {
            follow = 0;
            fun = 1;
            sprite_index = rsprite;
            scr_move_to_point_over_time((obj_queencar.x + obj_queencar.swanmaincharax) - 50, (obj_queencar.y + obj_queencar.swanmaincharay) - 12, 15);
        }
    }
}
if (con == 1.5)
{
    if (room == room_dw_mansion_acid_tunnel_puzzle_entrance && global.flag[343] == 1)
    {
        swantimer += (1 / global.fps_scale);
        if (swantimer >= 15)
        {
            con = 1.6;
            scr_speaker(""ralsei"");
            msgsetloc(0, ""\\EJ* Let's go^1, Kris!/%"", ""obj_queencar_slash_Step_0_gml_36_0"");
            d_make();
        }
    }
    else
    {
        swantimer += (1 / global.fps_scale);
        if (swantimer >= 15)
        {
            swantimer = 0;
            con = 2;
            active = 1;
        }
    }
}
if (con == 1.6 && !d_ex())
{
    swantimer += (1 / global.fps_scale);
    if (swantimer >= 15)
    {
        swantimer = 0;
        con = 2;
        active = 1;
    }
}
if (active == 1)
{
    wx = 4;
    if (room >= room_dw_mansion_acid_tunnel)
    {
        wx = 2;
    }
    wy = 0;
    if (up_h())
    {
        wy = -2;
    }
    if (down_h())
    {
        wy = 2;
    }
    if (left_p())
    {
        if (backwardstalkcon == 0)
        {
            backwardstalkcon = 1;
            dobackwardstalk = 1;
        }
    }
    movex = 0;
    movey = 0;
    if (!place_meeting(x + (wx / global.fps_scale), y + (wy / global.fps_scale), obj_solidblock) && !place_meeting(x + (wx / global.fps_scale), y + (wy / global.fps_scale), obj_solidenemy))
    {
        movex = 1;
        movey = 1;
    }
    else
    {
        if (!place_meeting(x + (wx / global.fps_scale), y, obj_solidblock) && !place_meeting(x + (wx / global.fps_scale), y, obj_solidenemy))
        {
            movex = 1;
        }
        if (!place_meeting(x, y + (wy / global.fps_scale), obj_solidblock) && !place_meeting(x, y + (wy / global.fps_scale), obj_solidenemy))
        {
            movey = 1;
        }
    }
    if (movex == 1 && !pause_x_move)
    {
        x += (wx / global.fps_scale);
    }
    if (movey == 1 && !pause_y_move)
    {
        y += (wy / global.fps_scale);
    }
    if (swan == 0)
    {
        obj_mainchara.x = x + 85;
        obj_mainchara.y = y;
    }
    else
