            thrash = instance_create(camerax() + 320, cameray() + 220, obj_thrashmachine);
            thrash.s = 6;
            thrash.drawfeet = 1;
            thrash.animate = 0;
            thrash.depth = 150;
            thrash.override_color = c_black;
            thrash.glow = 0;
