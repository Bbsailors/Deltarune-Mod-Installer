    default_sprite_back = -1;
    character_sprite = spr_noelle_walk_left_dw;
    actor = scr_dark_marker(0, 0, spr_noelle_walk_left_dw);
    actor.image_speed = 0;
    actor.visible = 0;
    coaster_offset_x = -65;
    coaster_offset_y = 45;
}
if (character_sprite != actor.sprite_index)
{
    actor.sprite_index = character_sprite;
    actor.image_index = 0;
}
if (con == 0)
{
    actor.image_speed = (animate ? 0.25 : 0) / global.fps_scale;
}
else
{
    image_speed = 0;
    if (type == 0 && actor.image_index < 6)
    {
        actor.image_index += 0.25 / global.fps_scale;
    }
    if (type == 1 && actor.image_index < 5)
    {
        actor.image_index += 0.25 / global.fps_scale;
    }
    if (type == 2 && actor.image_index < 10)
    {
        actor.image_index += 0.5 / global.fps_scale;
    }
}
if (stop_siner == 1)
{
    sinerx = 0;
    battlecoasterx = (camerax() + 122) - (type * 20);
    if (type == 3)
    {
        battlecoasterx = camerax() + 515;
    }
    if (type == 0)
    {
        battlecoasterx += 4;
    }
    repeat (4)
    {
        if (x < battlecoasterx)
        {
            x += (1 / global.fps_scale);
        }
        if (x > battlecoasterx)
        {
            x -= (1 / global.fps_scale);
        }
    }
}
else
{
    sinerx = 0;
    sinery = 0;
    if (siner_add0 != 0)
    {
        siner0 += (siner_add0 / global.fps_scale);
        if (siner_type0 == ""sin"")
        {
            sinmove = sin(siner0) * siner_amplitude0;
        }
        else
        {
            sinmove = cos(siner0) * siner_amplitude0;
        }
        if (siner_visual0 == 1)
        {
            sinerx += lengthdir_x(sinmove, siner_direction0);
            sinery += lengthdir_y(sinmove, siner_direction0);
        }
        else
        {
            x += (lengthdir_x(sinmove, siner_direction0) / global.fps_scale);
            y += (lengthdir_y(sinmove, siner_direction0) / global.fps_scale);
        }
    }
}
");

Apply("gml_Object_obj_confetti_Create_0", @"speed = random_range(10, 30) / global.fps_scale;
friction = 2 / (global.fps_scale * global.fps_scale);
fallspeed = 0;
siner = random(94.24777960769379);
image_blend = choose(#5555FF, #55FF55, #FF5555, c_aqua, c_orange);
");

Apply("gml_Object_obj_confetti_Step_0", @"if (speed < (5 / global.fps_scale))
{
    friction = 0.4 / (global.fps_scale * global.fps_scale);
}
if (speed < (2 / global.fps_scale))
{
    fallspeed = scr_movetowards(fallspeed, 2, 0.1 / global.fps_scale);
}
y += (fallspeed / global.fps_scale);
x += ((sin(siner / 15) * (fallspeed / 2)) / global.fps_scale);
siner += (1 / global.fps_scale);
image_speed = (1 / global.fps_scale) + (speed / 15);
");

Apply("gml_Object_obj_confetti_overworld_Create_0", @"speed = random_range(10, 30) / global.fps_scale;
friction = 2 / (global.fps_scale * global.fps_scale);
fallspeed = -random_range(20, 30);
siner = random(94.24777960769379);
image_blend = choose(#5555FF, #55FF55, #FF5555, c_aqua, c_orange);
height = 1;
airborne = true;
destroyOnLand = false;
falltime = 0;
init = false;
maxDepth = 800000;
fallFriction = 2;
maxy = 340;
shadow = -4;
image_xscale = 2;
image_yscale = 2;
");

Apply("gml_Object_obj_confetti_overworld_Step_0", @"if ((y - height) > (cameray() + 500) || x < (camerax() - 100) || x > (camerax() + 740) || (!airborne && y < (cameray() - 100)))
{
    if (i_ex(shadow))
    {
        instance_destroy(shadow);
    }
    instance_destroy();
}
if (!init)
{
    init = true;
    if (i_ex(shadow))
    {
        shadow.depth = maxDepth;
    }
}
falltime++;
if (!airborne)
{
    if (!destroyOnLand)
    {
        exit;
    }
    siner -= (0.1 / global.fps_scale);
    image_alpha = min(siner, 1);
    if (siner <= 0)
    {
        if (i_ex(shadow))
        {
            instance_destroy(shadow);
        }
        instance_destroy();
    }
    exit;
}
if (fallspeed < 0)
{
    fallspeed += (fallFriction / global.fps_scale);
}
if (fallspeed > -5)
{
    fallFriction = 0.4;
}
if (speed < (5 / global.fps_scale))
{
    friction = 0.4 / (global.fps_scale * global.fps_scale);
}
if (fallspeed < 2)
{
    fallspeed = scr_movetowards(fallspeed, 2, 0.1 / global.fps_scale);
}
height -= (fallspeed / global.fps_scale);
if (airborne && height <= 0 && y < maxy)
{
    instance_destroy(shadow);
    fallspeed = 0;
    height = 0;
    airborne = false;
    image_index = (image_index < 4) ? 3 : 7;
    speed = 0;
    image_speed = 0;
    x += sin(siner / 15);
    depth = maxDepth - falltime;
    siner = 3;
    exit;
}
x += ((sin(siner / 15) * (fallspeed / 2)) / global.fps_scale);
siner += (1 / global.fps_scale);
image_speed = (1 / global.fps_scale) + (speed / 15);
scr_depth();
if (i_ex(shadow))
{
    shadow.image_alpha = (y > maxy) ? 0 : 1;
    shadow.image_index = image_index;
    shadow.x = x + ((sprite_width - shadow.sprite_width) / 2);
    shadow.y = y + ((sprite_height - shadow.sprite_height) / 2);
    var shadowScale = clamp((40 - (height / 2)) / 20, 0, 2);
    shadow.image_xscale = shadowScale;
    shadow.image_yscale = shadowScale;
}
");

Apply("gml_Object_obj_controller_city_mice2_Draw_0", @"var _cx = camerax();
var _cy = cameray();
if (instance_exists(obj_controller_city_mice2))
{
    goalHit = obj_controller_city_mice2.victory;
}
inusecount = 0;
with (obj_rotationController_track)
