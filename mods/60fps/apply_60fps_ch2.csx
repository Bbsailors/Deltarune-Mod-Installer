    with (sidespade[side])
    {
        damage = 17;
        if (global.hp[1] <= 40)
        {
            damage = 13;
        }
        image_angle = direction;
    }
    intensity += 1;
}
if (homing == 3)
{
    radius = 100 + random(900);
