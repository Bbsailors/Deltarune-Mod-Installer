{
    timer = ((timer + 1) * power(2, 1 / global.fps_scale)) - 1;
    image_xscale = lerp(4, 1, timer / 30);
    image_yscale = lerp(0, 4, timer / 30);
    if (timer >= 30)
    {
        con = 1;
        timer = 0;
    }
}
if (con == 1)
{
