            scr_draw_sprite_tiled_area(spr_cyber_starry_sky_black, 0, 0, 2100, 0, 2100, x + room_width, (2100 + sprite_get_height(spr_cyber_starry_sky_black)) - 1, 1, 1, c_white, 1);
            draw_set_color(c_black);
