Apply("gml_Object_obj_sneo_headwave_Step_0", @"if (x >= (camerax() + 900) || x <= (camerax() - 200) || y >= (cameray() + 600) || y <= (cameray() - 200))
{
    instance_destroy();
}
if (init == 0 && image_alpha >= 0.5)
{
    destroyable = 1;
    init = 1;
}
if (state == 0)
{
    if (speed <= 0)
    {
        state = 1;
    }
}
else if (state == 1)
{
    timer += (1 / global.fps_scale);
    if (timer >= 5)
    {
        timer = 0;
        state = 2;
        d = instance_create(x, y, obj_regularbullet);
        d.direction = point_direction(x, y, obj_heart.x + 4, obj_heart.y + 4);
        d.sprite_index = spr_sneo_bullet0;
        d.speed = 4 / global.fps_scale;
    }
}
else if (state == 2)
{
    timer += (1 / global.fps_scale);
    if (timer >= 15)
    {
        timer = 0;
        state = 3;
    }
}
else if (state == 3)
{
    if (timer == 0)
    {
        spin += (24 / global.fps_scale);
        direction = lerp(180, flydirection, spin / 360);
        image_angle = direction + spin + 180;
        if (spin >= 360)
        {
            direction = flydirection;
            image_angle = direction + 180;
            timer += (1 / global.fps_scale);
        }
    }
    else
    {
        timer += (1 / global.fps_scale);
        if (timer >= 10)
        {
            friction = -0.2 / (global.fps_scale * global.fps_scale);
            speed = 0.1 / global.fps_scale;
            state = 4;
        }
    }
}
else if (state == 4)
{
    if (speed >= 8)
    {
        friction = 0;
        speed = 8 / global.fps_scale;
    }
}
");

