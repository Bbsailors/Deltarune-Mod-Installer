    if (pontotal > 1)
    {
        siner += (spinspeed / 8 / global.fps_scale);
    }
    else
    {
        siner += (spinspeed / 20 / global.fps_scale);
    }
    eye_angle = 180 + (sin(siner / 8) * 70);
    if (eye_radius < 8)
    {
        eye_radius += (1 / global.fps_scale);
    }
    grandbuffer -= 1;
    if (instance_exists(obj_heart))
    {
        x_angle = point_direction(eyex + 28 + x, eyey + 32 + y, obj_heart.x + 8, obj_heart.y + 8);
    }
    else
    {
        x_angle = 0;
    }
    if (abs(x_angle - eye_angle) < 25 && eye_angle >= 120 && eye_angle <= 240)
    {
        if (shotbuffer < 0 && shotcount < 3 && totalshotcount < maxshot)
        {
            shotcount += 1;
            if (pontotal == 2)
            {
                shotcount += 1;
            }
            if (pontotal == 3)
            {
                shotcount += 1;
            }
            if (shotcount >= 3)
            {
                totalshotcount += 1;
                shotcount = 0;
                if (pontotal == 1)
                {
                    shotbuffer = 10;
                }
                if (pontotal == 2)
                {
                    shotbuffer = 13;
                }
                if (pontotal == 3)
                {
                    shotbuffer = 22;
                }
            }
            if (totalshotcount >= maxshot)
            {
                maxtimer = 1;
            }
            snd_play(snd_hurt1);
            bul = instance_create(eyex + 28 + x, eyey + 32 + y, obj_regularbullet);
            bul.speed = 2 / global.fps_scale;
            bul.timepoints = 2.5;
            bul.target = mytarget;
            bul.damage = global.monsterat[myself] * 5;
            bul.friction = -0.11 / (global.fps_scale * global.fps_scale);
            if (pontotal == 1)
            {
                bul.friction = -0.12 / (global.fps_scale * global.fps_scale);
            }
            bul.direction = eye_angle;
            with (bul)
            {
                sprite_index = spr_diamondbullet;
                image_angle = direction;
            }
        }
    }
    if (maxtimer > 0)
    {
        maxtimer += (1 / global.fps_scale);
    }
    if (global.turntimer < 10)
    {
        eyecon = 10;
    }
}
siner += (1 / global.fps_scale);
shotbuffer -= (1 / global.fps_scale);
