            rot = 15;
        }
        if (right_h())
        {
            raheight = -8;
            suheight = 8;
            rot = -15;
        }
        if ((right_h() && left_h()) || (!right_h() && !left_h()))
        {
            raheight = 0;
            suheight = 0;
            rot = 0;
        }
    }
    else
    {
        raheight = 0;
        suheight = 0;
        rot = 0;
    }
