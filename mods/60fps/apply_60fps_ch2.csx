}
image_index += (1 / global.fps_scale);
");

Apply("gml_Object_obj_closing_block_left_Step_0", @"x += (grav / global.fps_scale);
grav += (0.6 / global.fps_scale);
if (x >= 320)
{
    speed = 0;
    gravity = 0;
    x = 320;
    grav = 0;
