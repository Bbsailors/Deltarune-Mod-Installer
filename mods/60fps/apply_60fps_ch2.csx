Apply("gml_Object_obj_ow_viroring_Step_0", @"with (obj_ow_viroringTrig)
{
    if (trigNum == other.trigNum)
    {
        if (place_meeting(x, y, obj_mainchara))
        {
            other.active = true;
        }
        else
        {
            other.active = false;
        }
    }
}
if (con == 0)
{
    if (active == true)
    {
        timer = 0;
        con = 1;
    }
}
