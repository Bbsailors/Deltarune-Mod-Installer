Apply("gml_Object_obj_dojofx_Create_0", @"siner = 0;
inbattle = 0;
ball = scr_dark_marker(x, y, spr_dojo_discoball);
ball.depth = 5000;
ball.x = room_width / 2;
ball.y = 0;
ball.image_speed = 0.18 / global.fps_scale;
ballback = scr_dark_marker(x, y, spr_dojo_discoball_back);
drawalpha = 1;
depth = 1100000;
bsiner = 0;
instance_create(0, 0, obj_dojofx_front);
");

Apply("gml_Object_obj_dojofx_Draw_0", @"if (global.mnfight > 0 && global.fighting == 1)
{
    if (ball.y >= -200)
    {
        ball.vspeed -= 1 / global.fps_scale;
    }
    else
    {
        ball.vspeed = 0;
    }
}
else if (ball.y < -10)
{
    ball.y = lerp(ball.y, 0, scr_fps_lerp_rate(0.5));
}
if (global.fighting)
{
    with (obj_battleback)
    {
        bgtype = 1;
    }
}
siner += (1 / global.fps_scale);
var color = scr_make_color_hsv(siner / 4, 255, 220 + (sin(siner / 15) * 30));
draw_set_color(color);
ballback.image_blend = color;
ballback.x = ball.x;
ballback.y = ball.y;
ballback.depth = 6000;
draw_set_alpha(0.5);
for (i = 0; i < 16; i++)
{
    sino = sin((i / 2) + (siner / 48));
    draw_circle(ball.x + (sino * 200), ball.y + 60 + (sin(i / 4) * 20), 16 + (abs(sino) * 12), false);
}
draw_triangle_color(x, y + 80, x - 80, y + 200, x + 80, y + 200, c_white, 0, 0, false);
draw_set_alpha(1);
bsiner += (1 / global.fps_scale);
if (bsiner >= 80)
{
    bsiner -= 80;
}
for (i = 0; i < 12; i++)
{
    draw_sprite_ext(spr_cc_boombox, siner / 8, 4, (-240 + y + (i * 80)) - bsiner, 2, 2, 0, color, image_alpha);
    draw_sprite_ext(spr_cc_boombox, siner / 8, 570, -240 + y + (i * 80) + bsiner, 2, 2, 0, color, image_alpha);
}
");

Apply("gml_Object_obj_dojofx_front_Draw_0", @"depth = 202;
if (global.fighting == 1)
{
    if (image_alpha < 1)
    {
        image_alpha += (0.02 / global.fps_scale);
    }
    for (i = 0; i < 6; i++)
    {
        myy[i] = 0;
        exists[i] = 0;
        if (i <= 2)
        {
            if (global.char[i] != 0)
            {
                if (i_ex(global.charinstance[i]))
                {
                    exists[i] = 1;
                    instance[i] = global.charinstance[i];
                    width[i] = 80;
                    myy[i] = instance[i].y + (sprite_get_height(instance[i].idlesprite) * 2);
                    myx[i] = instance[i].x + 20;
                    if (global.char[i] == 2)
                    {
                        myx[i] += 15;
                    }
                    if (global.char[i] == 3)
                    {
                        myx[i] += 15;
                    }
                }
            }
        }
        if (i >= 3 && i <= 6)
        {
            if (i_ex(global.monsterinstance[i - 3]))
            {
                exists[i] = 1;
            }
            if (exists[i])
            {
                instance[i] = global.monsterinstance[i - 3];
                myx[i] = instance[i].x + (instance[i].sprite_width / 2);
                myy[i] = instance[i].y + instance[i].sprite_height;
                width[i] = global.monsterinstance[i - 3].sprite_width;
            }
        }
        if (exists[i] && i_ex(instance[i]))
        {
            if ((global.encounterno == 90 || global.encounterno == 91 || global.encounterno == 92 || global.encounterno == 93 || global.encounterno == 94) && i > 2)
            {
            }
            else
            {
                var lightHeight = 280;
                draw_sprite_pos(spr_whitegradientdown_40, 0, myx[i], myy[i] - lightHeight, myx[i], myy[i] - lightHeight, (myx[i] - (width[i] / 2)) + 2, myy[i] - 2, myx[i] + (width[i] / 2), myy[i] - 2, 0.25);
                draw_set_color(c_gray);
                draw_ellipse(myx[i] - (width[i] / 2), myy[i] + 4, myx[i] + (width[i] / 2), myy[i] - 10, false);
            }
        }
    }
    draw_set_alpha(1);
}
else if (image_alpha > 0)
{
    image_alpha -= (0.02 / global.fps_scale);
}
");

Apply("gml_Object_obj_dojograzeenemy_Create_0", @"scr_enemy_object_init();
talkmax = 90;
image_speed = 0.16666666666666666 / global.fps_scale;
idlesprite = sprite_index;
hurtsprite = sprite_index;
sparedsprite = sprite_index;
custom_draw_example = 0;
