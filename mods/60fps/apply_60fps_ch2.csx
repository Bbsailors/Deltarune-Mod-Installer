    {
        if (y <= (obj_kris_headobj.bbox_bottom - 20))
        {
            depth = obj_kris_headobj.depth + 100;
        }
        else
        {
            depth = obj_kris_headobj.depth - 100;
        }
    }
    var boxcheck = instance_place(x, y, obj_kris_headobj);
    if (boxcheck >= 100)
    {
        var qualify = 0;
        var xpush = 0;
        if (y >= (boxcheck.bbox_top - 8))
        {
            qualify = 1;
        }
        if (y >= (boxcheck.bbox_bottom - 20))
        {
            qualify = 0;
        }
        if (x <= (boxcheck.bbox_left + 4))
        {
            qualify = 0;
            xpush = -4;
        }
        if (x >= (boxcheck.bbox_right - 4))
        {
            qualify = 0;
            xpush = 4;
        }
        x += (xpush / global.fps_scale);
        if (qualify)
        {
            obj_kris_headobj.miceheld++;
            cloud = scr_afterimage();
            cloud.depth = depth - 200;
            cloud.vspeed = (-1 - random(1.4)) / global.fps_scale;
            cloud.friction = 0.2 / (global.fps_scale * global.fps_scale);
            cloud.y -= 8;
            cloud.sprite_index = spr_fx_mushroomcloud;
            snd_play(snd_bump);
            snd_play(snd_wing);
            instance_destroy();
        }
    }
    if (y >= ythreshold || y > (cameray() + 480))
    {
        if (balloonid >= 0)
        {
            obj_room_dw_city_postbaseball.balloondestroyed[balloonid] = 1;
        }
        if (obj_kris_headobj.mousefailcon == 0 && obj_room_dw_city_postbaseball.minigame == 1)
        {
            obj_kris_headobj.mousefailcon = 1;
        }
        snd_play(snd_mouse);
        jumper = scr_afterimage();
        with (jumper)
        {
            scr_jump_to_point(x + random_range(-40, 40), room_height + (sprite_height * 2), 20, 16);
        }
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_city_parallaxStreet_Draw_0", @"drawx = ((__view_get(e__VW.XView, 0) + auto) * ss) + xstart;
scr_draw_sprite_tiled_area(sprite_index, 0, drawx, 0, 0, y, room_width, cameray() + view_hport[0], 1, 1, c_dark, 1);
animsiner += (1 / global.fps_scale);
for (var i = 0; i < max_cars; i++)
{
    for (var j = 0; j < 2; j++)
    {
        var y_offset = 0;
        if (room == room_dw_city_traffic_2 || room == room_dw_city_big_2)
        {
            y_offset = -20;
        }
        var ypos = (j == 1) ? (404 + y_offset) : 444;
        car_timer[i][j] += (5 / global.fps_scale);
        if ((car_pos[i][j] + car_timer[i][j]) > ((room_width * 2) + 50))
        {
            car_pos[i][j] = -50;
            car_timer[i][j] = 0;
        }
        var xpos = car_pos[i][j] + drawx + car_timer[i][j];
        if (nocars == false)
        {
            draw_sprite_ext(spr_traffic_car_side_wheels_small, animsiner / 6, xpos, ypos, 2, 2, 0, c_dark, 1);
        }
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_city_postbaseball_background_Draw_0", @"bg_y_pos = (cameray() * 0.92) + 680;
bg_x_pos = camerax() * 0.95;
