Apply("gml_Object_obj_overworld_poppup_Step_0", @"if (global.flag[encounterflag] == 1)
{
    instance_destroy();
}
if (global.flag[encounterflag] == 6 && init == 0)
{
    if (frozensprite == 0)
    {
        frozensprite = spr_poppup_hurt;
    }
    frozennpc = instance_create(x, y, obj_frozennpc);
    frozennpc.sprite_index = frozensprite;
    frozennpc.fresh = 1;
    instance_destroy();
    init = 1;
}
offX = x + 42;
offY = y + 62;
if (weird == 0)
{
    if (instance_exists(obj_mainchara))
    {
        dist = point_distance(offX, offY, charaX(), charaY());
    }
    if (dist < radius && con == 0)
    {
        speed1 = 0.25;
        con = 2;
    }
    if (con == 0 && room == room_dw_city_roadblock)
    {
        if (point_in_rectangle(charaX(), charaY(), 880, 640, 1040, 760))
        {
            speed1 = 0.25;
            con = 2;
        }
    }
    if (con == 2)
    {
        image_speed = 0.5 / global.fps_scale;
        if (image_index == 7)
        {
            image_index = 3;
        }
        if (speedboost == 0)
        {
            speed1 *= power(1.1, 1 / global.fps_scale);
        }
        if (speedboost == 1)
        {
            speed1 *= power(1.4, 1 / global.fps_scale);
        }
        if (speedboost == 0)
        {
            speed1 = clamp(speed1, 0, 8);
        }
        if (speedboost == 1)
        {
            speed1 = clamp(speed1, 0, 16);
        }
        if (global.interact == 0)
        {
            if (speed1 == 0)
            {
                speed1 = memspeed;
            }
        }
        else
        {
            if (speed1 != 0)
            {
                memspeed = speed1;
            }
            speed1 = 0;
        }
        if (instance_exists(obj_mainchara))
        {
            move_towards_point(charaHeartX() - 42, charaHeartY() - 20 - 62, speed1 / global.fps_scale);
        }
    }
}
if (weird == 1)
{
    if (con == 0)
    {
        image_speed = 0.25 / global.fps_scale;
        if (image_index >= 7)
        {
            image_index = 3;
        }
        if (i_ex(obj_mainchara))
        {
            if (distance_to_object(obj_mainchara) < 120)
            {
                con = 1;
            }
        }
    }
    if (con == 1)
    {
        image_speed = 0;
        if (image_index != 0)
        {
            image_index = lerp(image_index, 0, scr_fps_lerp_rate(0.5));
        }
        if (distance_to_object(obj_mainchara) > 120)
        {
            image_index = 0;
            con = 0;
        }
    }
}
