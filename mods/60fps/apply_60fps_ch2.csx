    }
    if (movedir == 3)
    {
        x -= (8 / global.fps_scale);
    }
    movetimer += (1 / global.fps_scale);
    if (movetimer >= 5)
    {
        movetimer = 0;
        global.interact = 0;
        movecourse = 0;
