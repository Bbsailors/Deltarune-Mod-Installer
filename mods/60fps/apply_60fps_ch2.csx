Apply("gml_Object_obj_kk_npc_Draw_0", @"if (state == 0)
{
    if (dancing == 1)
    {
        if (flash == 1)
        {
            fsiner += (1 / global.fps_scale);
        }
        updatetimer++;
        if (updatetimer >= 2)
        {
            siner += (2 / global.fps_scale);
            updatetimer = 0;
        }
        draw_monster_body_part_ext(spr_kk_dance, dance_index, x + (sin(siner / 4) * 14), (y + (abs(cos(siner / 4)) * 4)) - 4, 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(spr_kk_dance, 3, x - (sin(siner / 4) * 8), y + (cos(siner / 2) * 3), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(spr_kk_dance, 2, x + (sin(siner / 3) * 3), y + (cos(siner / 2) * 4), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(spr_kk_dance, 1, x + (sin(siner / 2) * 2), y + (cos(siner / 2) * 6), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(spr_kk_dance, 6, x + (sin(siner / 2) * 2) + (sin(siner / 4) * 4), y + (cos(siner / 2) * 6), 2, 2, 0, c_white, 1);
        dancetimer += (1 / global.fps_scale);
        if (sin(siner / 4) > 0)
        {
            dance_index = 4;
        }
        else
        {
            dance_index = 5;
        }
        musicalnotetimer += (1 / global.fps_scale);
        if (musicalnotetimer >= 14)
        {
            musicalnotetimer = 0;
            anim = instance_create(((x + (sprite_width / 2)) - 10) + random(40), y + 20, obj_afterimage);
            anim.sprite_index = spr_musicalbattlenote1;
            anim.depth = depth - 5;
            anim.image_xscale = 2;
            anim.image_yscale = 2;
            anim.direction = 270;
            anim.gravity = -0.2 / (global.fps_scale * global.fps_scale);
            anim.hspeed = (random_range(0.1, 0.8) * choose(1, -1)) / global.fps_scale;
        }
    }
    else
    {
        if (flash == 1)
        {
            fsiner += (1 / global.fps_scale);
        }
        timer += (2 / global.fps_scale);
        if (timer > 8)
        {
            timerB += 1;
            timer = 0;
        }
        if (cos(timerB) > 0.8)
        {
            down = 1;
        }
        if (cos(timerB) < -0.8)
        {
            down = 0;
        }
        draw_monster_body_part_ext(sprite[0], 0, x, y, 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[1], 0, x, y + (cos(timerB) * 2), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[2], 0, x, y + (cos(timerB) * 2), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[3], down, x, y, 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[5], down, x, y + (cos(timerB) * 2), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[6], 0, x + (-sin(timerB) * 4), y + (cos(timerB) * 2), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[7], 0, x + (-sin(timerB) * 4), y + (cos(timerB) * 2), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[8], 0, x + (-sin(timerB) * 2), y + cos(timerB), 2, 2, 0, c_white, 1);
        draw_monster_body_part_ext(sprite[9], 0, x + (-sin(timerB * 1.2) * 6), y + (cos(timerB * 2) * 2), 2, 2, 0, c_white, 1);
    }
}
");

Apply("gml_Object_obj_kris_fountain_Draw_0", @"if (active == 1)
{
    if (drawkris == 1)
    {
        draw_self();
    }
    if (ballcon == 1)
    {
        xballtimer = ((xballtimer + 1) * power(2, 1 / global.fps_scale)) - 1;
        yballtimer += (1 / global.fps_scale);
        balltimer += (1 / global.fps_scale);
        cenx = x + 18;
        ceny = y + 57;
        draw_set_color(c_white);
        draw_ellipse(cenx - xballtimer, ceny - 1, cenx + xballtimer, ceny + 1, false);
        if (xballtimer >= 80)
        {
            balltimer = 0;
            yballtimer = 1;
            ballcon = 2;
            whitecolor = 16777215;
        }
    }
    if (ballcon == 2)
    {
        balltimer += (1 / global.fps_scale);
        if (balltimer > 90)
        {
            inverttimer += (1 / global.fps_scale);
        }
        if (inverttimer >= 90)
        {
            releasetimer += (1 / global.fps_scale);
        }
        if (inverttimer >= 0 && inverttimer < 60)
        {
            whitecolor = merge_color(c_white, c_black, inverttimer / 60);
        }
        xballtimer *= power(0.5, 1 / global.fps_scale);
        if (releasetimer <= 0)
        {
            if (xballtimer <= 20)
            {
                xballtimer = 20;
            }
            if (xballtimer < (yballtimer / 6))
            {
                xballtimer = yballtimer / 6;
            }
            if (yballtimer >= 98)
            {
                yballtimer = 99 + random(5);
            }
            yballtimer *= 3;
        }
        else
        {
            yballtimer *= 3;
            instance_create(cenx, ceny, obj_fountainball);
            if (releasetimer == 1)
            {
                con = 64;
            }
            if (releasetimer >= 10)
            {
                ballcon = 3;
                fountain_sound = audio_play_sound(snd_deep_noise, 50, 1);
            }
        }
        draw_set_color(c_white);
        draw_ellipse(cenx - xballtimer - 2, ceny - yballtimer, cenx + xballtimer + 2, ceny + 1, false);
        draw_set_color(whitecolor);
        draw_ellipse(cenx - xballtimer, ceny - yballtimer, cenx + xballtimer, ceny + 1, false);
        if (releasetimer <= 0)
        {
            if (balltimer >= 6)
            {
                draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, 0.3 - (1 / ((balltimer / 2) + 1)));
            }
            if (inverttimer >= 1)
            {
                draw_sprite_ext(spr_kris_make_fountain_invert, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, 1 - (30 / inverttimer));
            }
        }
        if (releasetimer <= 0)
        {
            if ((balltimer % 5) == 0)
            {
                afterimage = instance_create(cenx - 4, ceny + 4, obj_afterimage);
                afterimage.sprite_index = spr_kris_make_fountain_flash;
                afterimage.image_speed = 0;
                afterimage.image_xscale = 4;
                afterimage.image_yxscale = 0.5;
                afterimage.image_alpha = 0.8;
            }
        }
        with (obj_afterimage)
        {
            image_xscale *= power(1.15 + random(0.02), 1 / global.fps_scale);
            image_yscale *= power(1.05 + random(0.02), 1 / global.fps_scale);
            y += (0.4 / global.fps_scale);
            x -= (0.4 / global.fps_scale);
        }
    }
    if (ballcon == 3)
    {
        instance_create(cenx, ceny, obj_fountainball);
        ceiltimer += (1 / global.fps_scale);
        if (ceilheight < 120)
        {
            ceilheight += ((sin(ceiltimer / 18) + 0.3) / global.fps_scale);
        }
        if (ceilheight >= 120)
        {
            ceilheight += (0.5 / global.fps_scale);
        }
        for (i = 0; i < 12; i++)
        {
            ceilballx[i] = ((ceiltimer + (i * 40)) % 400) + -40 + camerax();
            draw_sprite_ext(spr_kris_fountain_ball, 0, ceilballx[i], (ceilheight - 80) + (sin(i + (ceiltimer / 8)) * 7), 1.05, 1.05, 0, c_white, 1);
        }
        for (i = 0; i < 12; i++)
        {
            draw_sprite_ext(spr_kris_fountain_ball, 0, ceilballx[i], (ceilheight - 80) + (sin(i + (ceiltimer / 8)) * 7), 1, 1, 0, c_black, 1);
        }
        draw_set_color(c_black);
        draw_rectangle(-10, ceilheight - 80, 999, -90, false);
    }
}
");

