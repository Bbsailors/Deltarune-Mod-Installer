Apply("gml_Object_obj_power_up_afterimage_Draw_0", @"if (init == 0)
{
    if (use_pivot)
    {
        if (pivotx == -999)
        {
            pivotx = 0;
        }
        if (pivoty == -999)
        {
            pivoty = 0;
        }
        startscalex = pivotx * image_xscale;
        startscaley = pivoty * image_yscale;
    }
    else
    {
        if (pivotx == -999)
        {
            pivotx = sprite_width / 2;
        }
        if (pivoty == -999)
        {
            pivoty = sprite_height / 2;
        }
    }
    xrate *= scale;
    yrate *= scale;
    init = 1;
    if (reverse == 1)
    {
        image_xscale += (xrate / fade / global.fps_scale);
        image_yscale += (yrate / fade / global.fps_scale);
        xrate *= -1;
        yrate *= -1;
        maxalpha = image_alpha;
        image_alpha = 0;
        fade *= -1;
    }
    exit;
}
maxalpha = clamp(maxalpha, 0, 1);
image_alpha -= (fade / global.fps_scale);
image_xscale += (xrate / global.fps_scale);
image_yscale += (yrate / global.fps_scale);
if (use_pivot)
{
    xx = (x + (pivotx * image_xscale)) - startscalex;
    yy = (y + (pivoty * image_yscale)) - startscaley;
}
else
{
    xx = x - (pivotx * ((image_xscale - 2) / 2));
    yy = y - (pivoty * ((image_yscale - 2) / 2));
}
if (image_alpha < 0 || image_alpha > 1)
{
    instance_destroy();
}
d3d_set_fog(true, image_blend, 0, 1);
draw_sprite_ext(sprite_index, image_index, xx, yy, image_xscale, image_yscale, 0, image_blend, image_alpha * maxalpha);
d3d_set_fog(false, c_black, 0, 0);
");

Apply("gml_Object_obj_power_up_fx_Draw_0", @"if (init == 0)
{
    if (use_pivot)
    {
        if (pivotx == -999)
        {
            pivotx = 0;
        }
        if (pivoty == -999)
        {
            pivoty = 0;
        }
    }
    else
    {
        if (pivotx == -999)
        {
            pivotx = (sprite_width / 2) - (sprite_get_xoffset(sprite_index) * image_xscale);
        }
        if (pivoty == -999)
        {
            pivoty = (sprite_height / 2) - (sprite_get_yoffset(sprite_index) * image_yscale);
        }
    }
    init = 1;
}
timer += (1 / global.fps_scale);
effecttimer += (1 / global.fps_scale);
var __alpha = clamp(timer / poweruptime, 0, 1);
scr_draw_outline(2, image_blend, __alpha * 2);
draw_self();
d3d_set_fog(true, image_blend, 0, 1);
flashtimer += (1 / global.fps_scale);
if (flashtimer >= flashspeed)
{
    flashtimer = 0;
    flashspeed = max(4, (flashspeed * 2) / 3);
}
var __flash = __alpha + (sin((flashtimer / flashspeed) * pi) / 4);
draw_set_blend_mode(bm_add);
if (ring_timer > 0)
{
    ring_timer -= (1 / global.fps_scale);
}
draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, __flash);
d3d_set_fog(false, c_black, 0, 0);
var centerX = x + pivotx;
var centerY = y + pivoty;
if (effecttimer >= effectPause)
{
    if ((timer + 15) >= poweruptime)
    {
        d = scr_custom_afterimage(obj_power_up_afterimage);
        d.depth = depth + 1;
        d.image_alpha = max(0.1, __alpha);
        d.reverse = 1;
        d.fade = 0.1;
        d.pivotx = pivotx;
        d.pivoty = pivoty;
        d.use_pivot = use_pivot;
        d = scr_custom_afterimage(obj_power_up_afterimage);
        d.image_alpha = max(0.1, __alpha);
        d.fade = 0.1;
        d.image_blend = image_blend;
