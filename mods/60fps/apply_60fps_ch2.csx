            {
                global.monsterattackname[myself] = ""ThrashHead"";
                dc = scr_bulletspawner(x, y, obj_dbulletcontroller);
                dc.type = 26;
            }
            else if (rr == 1)
            {
                global.monsterattackname[myself] = ""ThrashFoot"";
