    {
        wire1_actor.gravity = 0;
        wire1_actor.vspeed = 0;
        wire2_actor.gravity = 0;
        wire2_actor.vspeed = 0;
        wire1_actor.y = npc1_actor.y + 20;
        wire2_actor.y = npc2_actor.y + 20;
        snd_play(snd_grab);
        with (npc1_actor)
        {
