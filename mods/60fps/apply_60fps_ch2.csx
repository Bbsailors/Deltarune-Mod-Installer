Apply("gml_Object_obj_sneo_heartattack_Step_0", @"if (shakex > 0)
{
    shakex -= (1 / global.fps_scale);
}
if (shakey > 0)
{
    shakey -= (1 / global.fps_scale);
}
if (global.turntimer < 51)
{
    global.turntimer = 50;
    attackcount = 0;
}
if (con == 0)
{
    if (difficulty == 1)
    {
        speed += ((0.5 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
    }
    else if (difficulty == 2)
    {
        if (movementstyle == 1)
        {
            speed += ((0.1 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
        }
        if (movementstyle != 0)
        {
            speed += ((0.4 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
