            }
            if (button1_p() && onebuffer < 0)
            {
                onebuffer = 5;
                canequip = 0;
                wwho = global.char[global.submenucoord[10]];
                wmsg = "" "";
                if (global.submenu == 12)
                {
                    scr_weaponinfo(global.weapon[global.submenucoord[global.submenu]]);
                    if (wwho == 2)
