Apply("gml_Object_obj_firework_explosion_Step_0", @"time += (1 / global.fps_scale);
for (var i = 0; i < pixels; i++)
{
    mypixely[i] += pixelvsp[i] / global.fps_scale;
    if (maintain_shape)
    {
        pixelvsp[i] += def_grav / global.fps_scale;
        if (pixelvsp[i] > max_vsp)
        {
            pixelvsp[i] = max_vsp;
        }
    }
    else
    {
        pixelvsp[i] += pixelgravoffset[i] / global.fps_scale;
        if (pixelvsp[i] > (max_vsp + pixelvspmaxoffset[i]))
        {
            pixelvsp[i] = max_vsp + pixelvspmaxoffset[i];
        }
    }
    if (pixelexpandprog[i] < 1)
    {
        pixelexpandprog[i] += pixelexpandspd[i] / global.fps_scale;
        if (pixelexpandprog[i] >= 1)
        {
            pixelexpandprog[i] = 1;
        }
        var _expand = sin(1.5707963267948966 * pixelexpandprog[i]);
        pixelexpand_h[i] = _expand;
        pixelexpand_v[i] = sin(1.0995574287564276 * _expand);
    }
    else
    {
        pixelexpand_v[i] += (0.01 + (pixelexpandspd[i] * 0.01)) / global.fps_scale;
        pixelexpand_h[i] += (0.01 + (pixelexpandspd[i] * 0.01)) / global.fps_scale;
        if (pixelvsp[i] >= 1)
        {
            pixelscale[i] -= 0.02 / global.fps_scale;
            if (pixelscale[i] <= 0)
            {
                pixelscale[i] = 0;
            }
        }
    }
    if (!maintain_shape)
    {
        pixelalpha[i] -= 0.01 / global.fps_scale;
    }
    if (pixelspritechangealarm[i])
    {
        pixelspritechangealarm[i] -= 1 / global.fps_scale;
    }
}
");

