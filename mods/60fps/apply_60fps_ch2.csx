Apply("gml_Object_obj_hypnofx_Draw_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
    initsiner = random(400);
    for (i = 0; i < ringmax; i += 1)
    {
        ringsize[i] = 1 + (0.5 * i);
        ringradius[i] = 2 + (i * 12);
        ringspeed[i] = 0.3;
        ringalpha[i] = 0;
        ringsiner[i] = initsiner;
    }
}
if (timer >= 2)
{
    for (i = 0; i < ringmax; i += 1)
    {
        ringsiner[i] += ((i + 2) * ringalpha[i]) / global.fps_scale;
        if (timer < 12 && ringalpha[i] < 1)
        {
            ringalpha[i] += 0.2 / global.fps_scale;
        }
        if (timer >= 24)
        {
            ringalpha[i] -= 0.1 / global.fps_scale;
        }
        draw_sprite_ext(spr_hypnoring, 0, x + (sin(ringsiner[i] / 12) * ringradius[i]), y + (cos(ringsiner[i] / 12) * ringradius[i]), ringsize[i], ringsize[i], 0, c_white, ringalpha[i]);
    }
    if (timer >= 38)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_icespell_Draw_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
    snd_play(snd_icespell);
}
if (timer == 1)
{
    hex[0] = instance_create(x - 25, y - 20, obj_icespell_hexagon);
}
if (timer == 4)
{
    hex[1] = instance_create(x + 25, y - 20, obj_icespell_hexagon);
}
if (timer == 7)
{
    hex[2] = instance_create(x, y + 20, obj_icespell_hexagon);
}
if (timer == 10)
{
    for (i = 0; i < 3; i++)
    {
        with (hex[i])
        {
            for (j = 0; j < 6; j++)
            {
                hexhex[j] = instance_create(x, y, obj_icespell_hexagon);
                hexhex[j].image_xscale = 0.75;
                hexhex[j].image_yscale = 0.75;
                hexhex[j].con = 1;
                hexhex[j].direction = 60 * j;
                hexhex[j].speed = 8 / global.fps_scale;
                hexhex[j].friction = 0.2 / (global.fps_scale * global.fps_scale);
            }
        }
    }
}
if (timer == 11)
{
    with (hex[0])
    {
        instance_destroy();
    }
    with (hex[1])
    {
        instance_destroy();
    }
    with (hex[2])
    {
        instance_destroy();
    }
}
if (timer == 15)
{
    if (global.fighting == 1)
    {
        global.hittarget[star] = 0;
        if (damage >= global.monsterhp[star])
        {
            if (i_ex(global.monsterinstance[star]))
            {
                if (global.monsterinstance[star].freezable == 1)
                {
                    global.flag[51 + star] = 6;
                }
            }
        }
        scr_damage_enemy(star, damage);
        if (global.monster[star] == 1)
        {
            with (target)
            {
                __of = scr_oflash();
            }
        }
    }
}
if (timer >= 10 && timer <= 30)
{
    draw_set_alpha(2.2 - (timer / 10));
    draw_set_color(c_white);
    draw_circle(x, y, 60 - (timer * 6), true);
    draw_circle(x, y, 61 - (timer * 6), true);
    draw_circle(x, y, 62 - (timer * 6), true);
    draw_set_alpha(1);
}
if (timer == 60)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_icespell_hexagon_Step_0", @"if (con == 1)
{
    image_angle += ((rotspeed * 2) / global.fps_scale);
    direction += ((rotspeed * 3) / global.fps_scale);
