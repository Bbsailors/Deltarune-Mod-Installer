playsounds = 0;
");

Apply("gml_Object_obj_bgattack_piece_Step_0", @"if (y >= 635)
{
    instance_destroy();
    exit;
}
if (y < 120)
{
    image_yscale = 0;
}
if (y > 120)
{
    image_yscale = (y - 120) / 150;
}
image_xscale = image_yscale * flip;
minx = lerp(320, 40, image_yscale / 2);
maxx = lerp(320, 600, image_yscale / 2);
x = lerp(minx, maxx, xrange);
if (image_yscale < 0.1)
{
    abs(image_yscale == (0.1 * flip));
    image_xscale = 0.1;
}
else if (variant == 2)
{
    if (gravity < (3.2 / (global.fps_scale * global.fps_scale)))
    {
        gravity += (0.08 / (global.fps_scale * global.fps_scale * global.fps_scale));
    }
}
else if (variant == 1)
{
    if (gravity < (3.2 / (global.fps_scale * global.fps_scale)))
    {
        gravity += (0.04 / (global.fps_scale * global.fps_scale * global.fps_scale));
    }
}
else if (gravity < (1.6 / (global.fps_scale * global.fps_scale)))
{
    gravity += (0.02 / (global.fps_scale * global.fps_scale * global.fps_scale));
}
if (y >= 290)
{
}
rep = 0;
if (sprite_index == spr_bqueen_kick_cancan && animtimer < 7)
{
    rep = 1;
}
if (sprite_index == spr_bqueen_kick_cancan && animtimer < 14)
{
    rep = 3;
}
if (sprite_index == spr_bqueen_kick_cancan && animtimer >= 14)
{
    rep = 1;
}
repeat (rep)
{
    animtimer += (1 / global.fps_scale);
}
if (animtimer <= 50)
{
    image_index = animtimer / 8;
}
if (animtimer == 9 && playsounds == 1)
{
    snd_play(snd_heavyswing);
    snd_play(snd_queenhowl_b);
    snd_volume(snd_heavyswing, (image_yscale + 0.4) / 2, 0);
    snd_volume(snd_queenhowl_b, (image_yscale + 0.4) / 2, 0);
    snd3 = snd_play(snd_heavyswing);
    snd4 = snd_play(snd_queenhowl_b);
    snd_volume(snd_heavyswing, (image_yscale + 0.4) / 2, 0);
    snd_volume(snd_queenhowl_b, (image_yscale + 0.4) / 2, 0);
    snd_pitch(snd3, 0.95);
    snd_pitch(snd4, 1.05);
}
if (sprite_index == spr_bqueen_kick_cancan && image_index > 2.99)
{
    animtimer = 0;
    if (flip == 1)
    {
        flip = -1;
    }
    else
    {
        flip = 1;
    }
}
if (y > 375)
{
    depth = o_boxingcontroller.depth - 1;
}
if (y > 375 && create_hitbox == 0)
{
    if (sprite_index == spr_bqueen_kick_cancan && visible == true)
    {
        create_hitbox = 1;
        kick_hitbox = instance_create(x, y - 120, o_boxing_hitbox);
        with (kick_hitbox)
        {
            give_hurt = 22 / f;
            timer = 400 / f;
            damage = 25;
            hit_dodging = 1;
            hit_jumping = 1;
            hit_ducking = 1;
            image_yscale = 20;
            image_xscale = 5;
        }
    }
    if (sprite_index == spr_bqueen_leggy_tall && visible == true)
    {
        create_hitbox = 2;
        leggy_hitbox = instance_create(x, y - 110, o_boxing_hitbox);
        with (leggy_hitbox)
        {
            give_hurt = 22 / f;
            timer = 400 / f;
            damage = 25;
            hit_dodging = 1;
            hit_jumping = 1;
            image_yscale = 10;
            image_xscale = 5;
        }
    }
}
if (y > 375 && y < 390 && visible == true)
{
    if (sprite_index == spr_bqueen_kick_cancan)
    {
        kick_hitbox.y = y - 120;
    }
    if (sprite_index == spr_bqueen_leggy_tall)
    {
        leggy_hitbox.y = y - 110;
    }
}
if (y > 390 && visible == true)
{
    if (create_hitbox == 1)
    {
        with (kick_hitbox)
        {
            instance_destroy();
        }
    }
    if (create_hitbox == 2)
    {
        with (leggy_hitbox)
        {
            instance_destroy();
        }
    }
    create_hitbox = 3;
}
");

Apply("gml_Object_obj_blocked_total_fx_Draw_0", @"if (state == 1)
{
    draw_self();
    scr_84_set_draw_font(""main"");
    draw_set_color(c_black);
    draw_set_halign(fa_center);
    if (global.lang == ""ja"")
    {
        draw_text(x, y - 6, string(count));
        draw_text(x, y + 8, stringsetloc(""Blocked"", ""obj_blocked_total_fx_slash_Draw_0_gml_9_0"") + stringsetloc("" ads!"", ""obj_blocked_total_fx_slash_Draw_0_gml_10_0""));
    }
    else
    {
        draw_text(x, y - 6, stringsetloc(""Blocked"", ""obj_blocked_total_fx_slash_Draw_0_gml_9_0""));
        draw_text(x, y + 8, string(count) + stringsetloc("" ads!"", ""obj_blocked_total_fx_slash_Draw_0_gml_10_0""));
    }
    draw_set_halign(fa_left);
    draw_set_color(c_white);
    con = 1;
}
else if (state < 3)
{
    if (state == -1)
    {
        scale += (0.25 / global.fps_scale);
        if (scale > 1)
        {
            scale = 1.2;
            state = 0;
        }
    }
    else if (state == 0)
    {
        scale = 1;
        state = 1;
    }
    else if (state == 2)
    {
        scale -= (0.25 / global.fps_scale);
        if (scale <= 0)
        {
            instance_destroy();
        }
    }
    draw_set_alpha(0.5);
    draw_set_color(c_black);
    draw_rectangle((x - (sprite_width / 2)) + 6, (y - (sprite_height / 2)) + 6, x + (sprite_width / 2) + 6, y + (sprite_height / 2) + 6, false);
    draw_set_alpha(1);
    draw_set_color(c_white);
    draw_sprite_ext(sprite_index, 0, x, y, scale, scale, 0, c_white, 1);
}
if (con == 1)
{
    image_alpha -= (0.4 / global.fps_scale);
}
if (image_alpha < 0)
{
    instance_destroy();
}
");

