    if (preptimer == 0)
    {
        d = instance_create(x, y, obj_bulletparent);
        d.sprite_index = spr_maus_holesblack;
        d.depth += 3;
    }
}
else
{
    draw_sprite_ext(sprite_index, image_index, x + (random(shaky) * choose(1, -1)), y + (random(shaky) * choose(1, -1)), image_xscale, image_yscale, image_angle, image_blend, image_alpha);
}
shaky = scr_approach(shaky, 0, max(0.1, shaky / 8));
");

Apply("gml_Object_obj_maus_holes_Step_0", @"if (preptimer > 0)
{
    exit;
}
if (preptimer == 0)
{
    depth -= 11;
    preptimer = -1;
}
if (timer <= 0 && mausqueue > 0)
{
    mausqueue--;
    var nexthole = irandom(7);
    var safety = 0;
    while (maushole[nexthole] > 0 && (maushole[nexthole] - 50) < global.turntimer)
    {
        nexthole = irandom(7);
        safety++;
        if (safety > 8)
        {
            exit;
        }
    }
    maushole[nexthole] = global.turntimer;
    timer += 10;
    var xx = x;
    var yy = y;
    var side = randomsign();
    if (nexthole < 4)
    {
        xx = (x - sideoffset) + 46 + (holeoffset * nexthole);
        yy = y + (sideoffset * side);
    }
    else
    {
        xx = x + (sideoffset * side);
        yy = (y - sideoffset) + 46 + (holeoffset * (nexthole - 4));
    }
    if (dontcreatemouse == 0)
    {
        d = scr_childbullet(xx, yy, obj_maus_critter);
        if (nexthole < 4)
        {
            d.direction += 90 * side;
        }
        else if (side > 0)
        {
            d.direction = 180;
        }
        d.speed = 6 / global.fps_scale;
        d.image_angle = d.direction;
        d.grazepoints = grazepoints;
        if (bigmaus)
        {
            d.big = true;
            d.sprite_index = spr_maus_critter_stuck;
            d.alarm[0] = round(22 * global.fps_scale);
            bigmaus--;
        }
    }
}
else if (timer > 0)
{
    timer -= (1 / global.fps_scale);
}
");

