Apply("gml_Object_obj_darkponman_ow_Step_0", @"rot += (rotspeed / global.fps_scale);
xx = lengthdir_x(eyer, rot) + offx;
yy = lengthdir_y(eyer, rot) + offy;
if (boss == 1)
{
    if (instance_exists(obj_mainchara))
    {
        obj_mainchara.battlemode = 0;
        with (obj_darkponman_ow)
        {
            if (obj_mainchara.x > (x - xrange) && obj_mainchara.x < (x + xrange) && obj_mainchara.y > (y - yrange) && obj_mainchara.y < (y + yrange))
            {
                obj_mainchara.battlemode = 1;
            }
        }
    }
}
if (con == 0)
{
    if (made == 0)
    {
        for (i = 0; i < bmax; i += 1)
        {
            xa = lengthdir_x(eyer * (2 + (i * 2)), rot - (i * 2)) + offx;
            ya = lengthdir_y(eyer * (2 + (i * 2)), rot - (i * 2)) + offy;
            fb[i] = instance_create(x + xa, y + ya, obj_overworldbulletparent);
            fb[i].sprite_index = spr_diamondbullet;
            fb[i].active = 1;
            fb[i].target = 3;
            fb[i].damage = 16;
            fb[i].image_angle = rot - i;
            fb[i].depth = 200;
            fb[i].alarm[0] = -10;
            fb[i].image_alpha = 0;
            fb[i].image_xscale = 0.7;
        }
        made = 1;
    }
    if (eyer < 11)
    {
        eyer += (1 / global.fps_scale);
    }
    else
    {
        con = 1;
        image_speed = 0.1 / global.fps_scale;
    }
}
if (made == 1)
{
    if (rotspeed > 0)
    {
        siner += (1 / global.fps_scale);
    }
    if (rotspeed < 0)
    {
        siner -= (1 / global.fps_scale);
    }
    for (i = 0; i < bmax; i += 1)
    {
        if (i_ex(fb[i]))
        {
            xa = lengthdir_x(eyer * (2 + (i * 2)), rot - (sin(siner / 10) * (i * 2))) + offx;
            ya = lengthdir_y(eyer * (2 + (i * 2)), rot - (sin(siner / 10) * (i * 2))) + offy;
            fb[i].x = x + xa;
            fb[i].y = y + ya;
            fb[i].image_alpha = 0.8 + (sin(((i * 4) + siner) / 5) * 0.2);
            if (con < 1)
            {
                fb[i].image_alpha = 0 + (eyer / 10);
            }
            fb[i].image_angle = rot - (sin(siner / 10) * (i * 4));
        }
    }
}
");

Apply("gml_Object_obj_darkslide_Collision_obj_mainchara", @"cancollide = 0;
if (global.interact == 0 || collide == 1)
{
    cancollide = 1;
}
if (cancollide == 1)
{
    if (abovey == 0)
    {
        if (obj_mainchara.y < y)
        {
            abovey = 1;
            snd_play(snd_noise);
            slide_noise = snd_loop(snd_paper_surf);
            with (obj_mainchara)
            {
                fun = 1;
                sprite_index = spr_krisd_slide;
            }
        }
        if (obj_mainchara.y > y)
        {
            abovey = -1;
        }
    }
    collide = 1;
    global.interact = 1;
    other.y += (12 / global.fps_scale);
    collidetimer = 3;
    collider += 1;
    if (slidetimer == 0 && abovey == 1)
    {
        dust = instance_create(obj_mainchara.x + 20, obj_mainchara.y + 30, obj_slidedust);
        with (dust)
        {
            vspeed = -6 / global.fps_scale;
            hspeed = (-1 + random(2)) / global.fps_scale;
        }
        slidetimer = -6;
    }
    slidetimer += (1 / global.fps_scale);
    if (move_lr_enabled && obj_mainchara.px == 0)
    {
        var _stk_on = global.flag[960] >= 1 && global.stick_mag > 0;
        var _stk_l = left_h() || (_stk_on && global.stick_lx < 0 && abs(global.stick_lx) >= abs(global.stick_ly));
        var _stk_r = right_h() || (_stk_on && global.stick_lx > 0 && abs(global.stick_lx) >= abs(global.stick_ly));
        if (_stk_l)
        {
            with (obj_mainchara)
            {
                _px = -6 / global.fps_scale;
                if (!place_meeting(x + _px, y, obj_solidblock))
                {
                    x += _px;
                }
            }
        }
        if (_stk_r)
        {
            with (obj_mainchara)
            {
                _px = 6 / global.fps_scale;
                if (!place_meeting(x + _px, y, obj_solidblock))
                {
                    x += _px;
                }
            }
        }
    }
}
");

Apply("gml_Object_obj_darkslide_new_Collision_obj_mainchara", @"var solidcheck = 0;
cancollide = 0;
if (sliding == 0 && global.interact == 0)
{
    if (obj_mainchara.y < ((y + sprite_height) - obj_mainchara.sprite_height))
    {
        with (obj_mainchara)
        {
            if (place_meeting(x, y + 20, obj_solidblock))
            {
                solidcheck = 1;
            }
        }
        if (solidcheck == 0)
        {
            snd_play(snd_noise);
            if (room == room_dw_cyber_teacup_final)
            {
                snd_play(snd_paper_surf);
            }
            else
            {
                slide_noise = snd_loop(snd_paper_surf);
            }
            with (obj_mainchara)
            {
                sliding = 1;
                fun = 1;
                sprite_index = spr_krisd_slide;
            }
            sliding = 1;
        }
    }
    else
    {
        obj_mainchara.y = (y + sprite_height) - 48;
