Apply("gml_Object_obj_ch2_scene19c_berdly_smart_word_Step_0", @"if (!text_finish)
{
    if (text_alpha < 1)
    {
        text_alpha += (0.05 / global.fps_scale);
    }
    else
    {
        text_finish = true;
        alarm[0] = round(30 * global.fps_scale);
    }
}
if (text_fade)
{
    if (text_alpha > 0)
    {
        text_alpha -= (0.05 / global.fps_scale);
    }
    else
    {
        instance_destroy();
    }
}
");

