    if (actingral == 1 && actconral == 1)
    {
        msgset(0, """");
        scr_mercyadd(myself, 35);
        scr_battletext_default();
        actcon = 1;
        actconral = 0;
    }
    if (actingral == 2 && actconral == 1)
    {
        msgset(0, """");
        scr_mercyadd(myself, 35);
