        draw_rectangle(x, y + 440, x + room_width + 100, y + 500 + room_height + 2, false);
    }
}
if (shadoweffect == 2)
{
    image_blend = c_white;
    draw_sprite_tiled(sprite_index, image_index, x, y);
    image_blend = c_gray;
    draw_sprite_tiled_ext(sprite_index, image_index, x, y + 8, 1, 1, c_dkgray, 1);
