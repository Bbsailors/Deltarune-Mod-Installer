Apply("gml_Object_obj_ch2_scene26_powers_combined_Draw_0", @"if (glow_in_out != 0)
{
    glow_lerp = round(lerp(glow_lerp, 1, scr_fps_lerp_rate(0.35)) * 100) / 100;
    if (glow_in_out == 1)
    {
        scr_draw_outline(2, recruit_col, glow_lerp);
    }
    else
    {
        scr_draw_outline(2, recruit_col, 1 - glow_lerp);
    }
    if (glow_lerp >= 0.95)
    {
        if (glow_in_out == 1)
        {
            glow_in_out = -1;
        }
        else
        {
            glow_in_out = 0;
        }
        glow_lerp = 0;
    }
}
