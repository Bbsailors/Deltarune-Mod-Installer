            image_xscale = lerp(image_xscale, 2, scr_fps_lerp_rate(0.125));
        }
    }
    with (check2)
    {
        if (image_xscale != 2)
        {
            image_xscale = lerp(image_xscale, 2, scr_fps_lerp_rate(0.125));
        }
    }
    with (check3)
    {
        if (image_xscale != 2)
        {
            image_xscale = lerp(image_xscale, 2, scr_fps_lerp_rate(0.125));
