                    {
                        global.msg[2] = stringsetloc(""\\E3* W-wait^1, aren't you supposed to be ACTing!?/%"", ""obj_ralseienemy_slash_Step_0_gml_218_0"");
                    }
                    if (plot == 1)
                    {
