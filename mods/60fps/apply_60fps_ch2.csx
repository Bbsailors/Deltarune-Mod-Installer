        {
            speed -= ((0.1 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
        }
        if (movementstyle != 0)
        {
            speed -= ((0.6 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
        }
    }
    if (x > (xstart - 12))
    {
        attackcount -= 1;
        if (attackcount > 0)
        {
            x = xstart;
