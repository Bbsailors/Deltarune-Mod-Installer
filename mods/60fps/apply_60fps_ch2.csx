if (state == 1)
{
    image_angle -= (4 / global.fps_scale);
    throw_yspeed += (grav / global.fps_scale);
    if (throw_yspeed > max_yspeed)
    {
        throw_yspeed = max_syspeed;
    }
    prevx = x;
    if (throw_xspeed < 0)
    {
        for (i = throw_xspeed; i < 0; i++)
        {
            x += (i / global.fps_scale);
            break;
        }
    }
    if (throw_yspeed < 0)
    {
        for (i = throw_yspeed; i < 0; i++)
        {
            if ((y + i) < floory)
            {
                y += (i / global.fps_scale);
                break;
            }
        }
    }
    if (throw_yspeed > 0)
    {
        for (i = throw_yspeed; i > 0; i--)
        {
            if ((y + i) < floory)
            {
                y += (i / global.fps_scale);
                break;
            }
        }
    }
    if ((y + 1) > floory)
    {
        if (throw_yspeed > 0)
        {
            if (throw_yspeed > 0)
            {
                throw_yspeed = -throw_yspeed * 0.5;
            }
            if (throw_xspeed > 0)
            {
                throw_xspeed -= min(0.5 / global.fps_scale, throw_xspeed);
            }
            else if (throw_xspeed < 0)
            {
                throw_xspeed += min(0.5 / global.fps_scale, abs(throw_xspeed));
            }
        }
    }
}
");

