{
    instance_destroy();
}
");

Apply("gml_Object_obj_npc_castle_cliff_Step_0", @"if (con == 1 && !d_ex() && i_ex(obj_npc_room))
{
    if (!sfx)
    {
        sfx = true;
        snd_play(snd_hypnosis);
    }
    sinerx = 0;
    sinery = 0;
    siner_amplitude0 += (0.2 / global.fps_scale);
    siner0 += (0.2 / global.fps_scale);
    var sinmove_x = sin(siner0) * siner_amplitude0;
    sinerx += lengthdir_x(sinmove_x, siner_direction0);
    sinery += lengthdir_y(sinmove_x, siner_direction0);
    var xpos = sinerx;
    var ypos = sinery;
    siner1 += (siner_add1 / global.fps_scale);
    var sinmove_y = cos(siner1) * siner_amplitude1;
    sinerx += lengthdir_x(sinmove_y, siner_direction1);
    sinery += lengthdir_y(sinmove_y, siner_direction1);
    xpos = sinerx;
    ypos = sinery;
    with (obj_npc_room)
    {
        x += (xpos / global.fps_scale);
        y = (y + (ypos / global.fps_scale)) - (6 / global.fps_scale);
    }
    if (obj_npc_room.y <= -100)
    {
        con = 99;
    }
}
if (remove_shine)
{
    remove_shine = false;
    if (shine != -4)
    {
        with (shine)
        {
            instance_destroy();
        }
    }
}
");

