        with (DEVICE_MENU)
        {
            MENU_NO = 0;
            ONEBUFFER = 3;
            TWOBUFFER = 3;
        }
        with (obj_writer)
        {
            instance_destroy();
        }
        instance_destroy();
        exit;
    }
}
if (EVENT == 75)
{
    TIMER += (1 / global.fps_scale);
    if (TIMER >= 130)
    {
        EVENT = 76;
    }
}
if (EVENT == 76)
{
