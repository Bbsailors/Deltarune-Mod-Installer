            }
            var sentenceEnd = (sact_count == 1) ? ""/"" : ""/%"";
            msgsetsubloc(0, ""* Susie roared!! The enemies became TIRED.~1"", sentenceEnd, ""obj_tasque_enemy_slash_Step_0_gml_155_0"");
            snd_play(snd_sussurprise);
            if (sact_count == 1)
            {
