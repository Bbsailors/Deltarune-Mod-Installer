            }
            if (rr == 3)
            {
                global.battlemsg[0] = stringsetloc(""* Berdly laughs and goes to his mind palace."", ""obj_berdlyb2_enemy_slash_Step_0_gml_127_0"");
            }
            if (rr == 4)
