{
    scr_speaker(""no_name"");
    msgsetloc(0, ""* I was fishing for lost pottery in the acid when I found this photo./"", ""obj_npc_room_slash_Other_10_gml_2619_0"");
    msgnextloc(""* Please take a look./"", ""obj_npc_room_slash_Other_10_gml_2620_0"");
