        r2 = choose(-1, 0, 1);
        draw_sprite_ext(spr_puzzlemaster_body, type, x, y, 2, 2, 0, c_white, 1);
        draw_sprite_ext(spr_puzzlemaster_face1, type, x + 24 + sin(siner), y + 16, 2, 2, 0, c_white, 1);
        if (beanie[0] == 1)
