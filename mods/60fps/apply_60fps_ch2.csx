    with (check1)
    {
        if (image_yscale != 2)
        {
            image_yscale = lerp(image_yscale, 2, scr_fps_lerp_rate(0.15));
        }
    }
    with (check2)
    {
        if (image_yscale != 2)
        {
            image_yscale = lerp(image_yscale, 2, scr_fps_lerp_rate(0.15));
        }
    }
    with (check3)
    {
        if (image_yscale != 2)
        {
            image_yscale = lerp(image_yscale, 2, scr_fps_lerp_rate(0.15));
        }
    }
    if ((timer % 2) == 0)
    {
        with (check1)
        {
            scr_afterimagefast();
        }
        with (check2)
        {
            scr_afterimagefast();
        }
        with (check3)
        {
            scr_afterimagefast();
        }
    }
    with (check1)
    {
        if (x != 240)
        {
            x = lerp(x, 240, scr_fps_lerp_rate(0.125));
        }
        if (y != 160)
        {
            y = lerp(y, 160, scr_fps_lerp_rate(0.125));
        }
    }
    with (check2)
    {
        if (x != 320)
        {
            x = lerp(x, 320, scr_fps_lerp_rate(0.125));
        }
        if (y != 80)
        {
            y = lerp(y, 80, scr_fps_lerp_rate(0.125));
