        }
        if (sprite_index == spr_npc_scarflady)
        {
            if (talked == 0)
            {
                scr_speaker(""no_name"");
                msgsetloc(0, ""* You kids came out of the library^1, didn't you? Studying..^1. How wonderful./"", ""obj_npc_room_slash_Other_10_gml_794_0"");
