    {
        sb_crowd.image_alpha = min(1, sb_crowd.image_alpha + (0.05 / global.fps_scale));
    }
    sb_crowd_siner += (1 / global.fps_scale);
    sb_crowd.x = sb_crowd_base_x + (sin(sb_crowd_siner / 4) * 4);
    sb_crowd.y = sb_crowd_base_y + (cos(sb_crowd_siner / 1.5) * 4);
}
if (sb_crowd_hide)
{
    sb_crowd_show = false;
    sb_crowd_siner += (1 / global.fps_scale);
    sb_crowd.x = sb_crowd_base_x + (sin(sb_crowd_siner / 4) * 4);
    sb_crowd.y = sb_crowd_base_y + (cos(sb_crowd_siner / 1.5) * 4);
    if (sb_crowd.image_alpha > 0)
    {
        sb_crowd.image_alpha = max(0, sb_crowd.image_alpha - (0.05 / global.fps_scale));
    }
    else
    {
        sb_crowd_hide = false;
    }
}
if (berdly_applause_start)
{
