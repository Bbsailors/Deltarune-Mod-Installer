        {
            fade = 1;
        }
    }
}
else if (state == 11)
{
    if (formtimer < 15)
    {
        exit;
    }
    if (x < (camerax() + 438))
    {
        x += (4 / global.fps_scale);
    }
    if (x > (camerax() + 438) && formtimer < 65)
    {
        formtimer = 65;
    }
    if ((formtimer % 5) == 0 && formtimer >= 30 && formtimer <= 65)
