        if (!d_ex())
        {
            snd_pause(global.currentsong[1]);
            sprite_index = spr_hammerguy_powerup;
            image_index = 0;
            image_speed = 0.5 / global.fps_scale;
            snd_play(snd_noise);
            con += 1;
            alarm[4] = round(30 * global.fps_scale);
            charcycle = 0;
            charamt = 0;
            if (global.char[1] > 0)
            {
                charamt = 1;
            }
            if (global.char[2] > 0)
            {
                charamt = 2;
            }
            charcycle = charamt;
        }
    }
    if (con == 12 || con == 32 || con == 52 || con == 72)
    {
        hitmode = 1;
        sprite_index = spr_hammerguy_hit;
        image_speed = 0.5 / global.fps_scale;
        image_index = 0;
