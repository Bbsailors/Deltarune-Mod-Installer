Apply("gml_Object_obj_caradventure_car_Step_0", @"if (active)
{
    scr_depth();
    block = 0;
    if (!pause_x_move)
    {
        hspeed = 6 / global.fps_scale;
    }
    else
    {
        hspeed = 0;
    }
    __view_set(e__VW.XView, 0, __view_get(e__VW.XView, 0) + hspeed);
    var canmove = true;
    if (room == room_dw_city_traffic_4)
    {
        if (x < 1080)
        {
            canmove = false;
        }
    }
    if (canmove)
    {
        if (y > 120 && up_h())
        {
            y -= (5 / global.fps_scale);
        }
        if (y < 240 && down_h())
        {
            y += (5 / global.fps_scale);
        }
    }
    if (left_h() && x > (camerax() + 20))
    {
        x -= (3 / global.fps_scale);
        if (hits < 4)
        {
            block = 1;
        }
    }
    if (right_h() && x < (camerax() + 100))
    {
        x += (6 / global.fps_scale);
    }
    if (instance_exists(obj_mainchara))
    {
        obj_mainchara.x = x + 85;
        obj_mainchara.y = y;
    }
    cartimer += (1 / global.fps_scale);
    if (cartimer >= (carthreshold - min(hits / 2, 6)) && talktimer < 860)
    {
        var y_pos = 0;
        var random_y = irandom(1);
        if (bananamode)
        {
            y_pos = (random_y == 0) ? random_range(110, 150) : random_range(260, 280);
        }
