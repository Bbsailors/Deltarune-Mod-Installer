    if (global.flag[325] == 3)
    {
        scr_anyface_next(""susie"", ""Y"");
        msgnextloc(""\\EY* Hahaha!^1! That's awesome^1, Kris!/%"", ""obj_npc_room_slash_Other_10_gml_2640_0"");
    }
}
