    if (thrash_con == 2)
    {
        if (thrash.glow < 1)
        {
            thrash.glow = lerp(thrash.glow, 1, scr_fps_lerp_rate(0.35));
        }
        if (thrash.glow >= 0.99 && thrash_con <= 2)
        {
            thrash.glow = 1;
            thrash_con = 2.5;
            var d = instance_create(x, y + 26, obj_ch2_scene26_henshin_flash);
