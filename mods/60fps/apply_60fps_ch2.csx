        {
            if (forcefield == -4)
            {
                make_forcefield = true;
            }
        }
    }
}
if (con == 1)
{
    if (boss == 1)
    {
        snd_play(snd_spearappear);
    }
    radius = 0;
    keysaucer = floor(random(saucercount));
    for (i = 0; i < saucercount; i += 1)
    {
