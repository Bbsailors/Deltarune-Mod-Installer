        scr_anyface_next(""susie"", ""6"");
        msgnextloc(""\\E6* Wait^1, \""Kro-shay?\"" Isn't that the^1, uh^1, game with the hammer?/"", ""obj_npc_room_slash_Other_10_gml_202_0"");
