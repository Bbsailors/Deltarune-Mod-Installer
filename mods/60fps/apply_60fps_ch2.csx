    {
        with (su_actor)
        {
            sprite_index = spr_susie_shock_r;
        }
        with (no_actor)
        {
            sprite_index = spr_noelle_shocked_dw;
        }
    }
    if (customtimer == 49)
    {
        snd_play(snd_spearappear);
        with (ca_actor)
        {
            gravity = -1 / (global.fps_scale * global.fps_scale);
        }
        with (no_actor)
        {
            gravity = -1 / (global.fps_scale * global.fps_scale);
        }
        c_waitcustom_end();
        customcon = 3;
    }
}
