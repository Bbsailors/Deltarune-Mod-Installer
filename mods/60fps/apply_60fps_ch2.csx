Apply("gml_Object_obj_dogtable_idle_Step_0", @"if (con == 1 && !d_ex())
{
    if (instance_exists(obj_controller_dining3))
    {
        obj_controller_dining3.dogcon = 1;
    }
    global.interact = 0;
    con++;
}
if (icon == 0 && x > (camerax() - 100) && x < (camerax() + 640) && y > (cameray() - 94) && y < (cameray() + 480))
{
    timer = 0;
    icon = 1;
}
if (icon == 1)
{
    timer += (1 / global.fps_scale);
    hspeed = 2 / global.fps_scale;
    if (timer == 12)
    {
        hspeed = 0;
        icon++;
    }
}
if (icon == 2)
{
    dogIndex = 0;
    raise -= (2 / global.fps_scale);
    raise = clamp(raise, 0, 18);
    if (raise == 0)
    {
        icon++;
    }
}
if (toss == 1)
{
    lid = instance_create(x + 24, y + 18, obj_marker);
    lid.sprite_index = spr_saucerlid;
    lid.image_xscale = 2;
    lid.image_yscale = 2;
    if (tossdir == ""left"")
    {
        lid.direction = 120;
    }
    else
    {
        lid.direction = 60;
    }
    lid.speed = 16 / global.fps_scale;
    toss = 2;
    lidtimer = 0;
}
if (toss == 2)
{
    lidtimer += (1 / global.fps_scale);
    if (tossdir == ""left"")
    {
        lid.image_angle += 16 / global.fps_scale;
    }
    else
    {
        lid.image_angle -= 16 / global.fps_scale;
    }
    lid.image_alpha *= power(0.9, 1 / global.fps_scale);
    if (lidtimer == 60)
    {
        with (lid)
        {
            instance_destroy();
        }
        toss = 3;
    }
}
");

