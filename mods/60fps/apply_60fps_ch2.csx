        d.type = 1;
        d.image_angle = obj_bqueen_breath_controller.place1;
        d.depth = bulletdepth;
        d.rotator_target = id;
        timer = 5;
    }
}
if (timer2 > 9 && difficulty == 1)
{
    bulletcount2++;
