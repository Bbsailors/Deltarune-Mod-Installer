    {
        thrash_con = 0.5;
        scr_speaker(""rouxls"");
        msgsetloc(0, ""* And...^1. mosteth of all.../%"", ""obj_ch2_scene26_powers_combined_slash_Step_0_gml_159_0"");
        var d = d_make();
        d.side = 1;
    }
    if (thrash_con == 0.5 && !d_ex())
    {
        thrash_con = 1;
    }
