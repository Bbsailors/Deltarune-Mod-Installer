Apply("gml_Object_obj_spamton_warped_box_Draw_0", @"var colo = draw_get_color();
draw_set_colour(#00C000);
draw_triangle(minx, miny, lerp(maxx, suckx, suckpower), lerp(miny, upper_sucky, suckpower), lerp(maxx, suckx, suckpower), lerp(maxy, lower_sucky, suckpower), 0);
draw_triangle(minx, miny, minx, maxy, lerp(maxx, suckx, suckpower), lerp(maxy, lower_sucky, suckpower), 0);
draw_set_colour(c_black);
draw_triangle(minx + 4, miny + 4, lerp(maxx - 4, suckx - 4, suckpower), lerp(miny + 4, upper_sucky + 3, suckpower), lerp(maxx - 4, suckx - 4, suckpower), lerp(maxy - 4, lower_sucky - 3, suckpower), 0);
draw_triangle(minx + 4, miny + 4, minx + 4, maxy - 4, lerp(maxx - 4, suckx - 4, suckpower), lerp(maxy - 4, lower_sucky - 3, suckpower), 0);
draw_set_colour(colo);
if (global.turntimer > 30)
{
    if (timer < 60)
    {
        timer += (1 / global.fps_scale);
    }
    else
    {
        timer -= (1 / global.fps_scale);
    }
    if (timer >= 59)
    {
        suckpower = timer / 60;
    }
    else
    {
        suckpower = scr_ease_in(timer / 60, 3);
    }
}
else
{
    if (timer > 30)
    {
        timer = 30;
    }
    if (snapback == 0)
    {
        snapback = -1;
    }
    if (timer > 0)
    {
        timer -= (1 / global.fps_scale);
    }
    suckpower = scr_ease_in(timer / 30, -2);
}
");

Apply("gml_Object_obj_spamton_warped_box_Step_2", @"if (instance_exists(obj_heart))
{
    rborder = lerp(maxx, suckx, suckpower);
    uborder = miny;
    dborder = maxy;
    if (snapback == 0)
    {
        obj_heart.x += (suckpower / global.fps_scale);
    }
    if (snapback <= 0 && global.turntimer <= 30 && obj_heart.x >= (rborder - 22))
    {
        snapback = suckpower;
        if (suckpower > 0.5)
        {
            if (!instance_exists(obj_shake))
            {
                d = instance_create(0, 0, obj_shake);
                d.shakex = ceil(suckpower * 4);
                d.shakey = ceil(suckpower * 4);
            }
        }
    }
    if (snapback > 0)
    {
        obj_heart.x -= ((20 * scr_ease_in(snapback, 2)) / global.fps_scale);
        snapback -= (0.1 / global.fps_scale);
    }
    if (obj_heart.x < (minx + 3))
    {
        obj_heart.x = minx + 3;
    }
    if (obj_heart.x > (rborder - 20))
    {
        obj_heart.x = rborder - 20;
    }
    var xoffset = (obj_heart.x - (minx + 3)) / (rborder - 20 - (minx + 3));
    var uppersuckoffset = (upper_sucky - miny) * xoffset * suckpower;
    var lowersuckoffset = (maxy - lower_sucky) * xoffset * suckpower;
    if (obj_heart.y < (uborder + 3 + uppersuckoffset))
    {
        obj_heart.y = uborder + 3 + uppersuckoffset;
    }
    if (obj_heart.y > (dborder - 20 - lowersuckoffset))
    {
        obj_heart.y = dborder - 20 - lowersuckoffset;
    }
    if (obj_heart.y < (uborder + 3))
    {
        obj_heart.y = uborder + 3;
    }
    if (obj_heart.y > (dborder - 20))
    {
        obj_heart.y = dborder - 20;
    }
}
");

Apply("gml_Object_obj_spamton_wordbullet_Draw_0", @"if ((x - sprite_xoffset) < mouthx)
{
    draw_set_color(c_black);
    scr_84_set_draw_font(""main"");
    if (scale < 3)
    {
        scale += (0.025 / global.fps_scale);
    }
    image_xscale = scale * 0.5;
    image_yscale = scale * 0.8;
    xx = x - (3 * scale);
    yy = y - (9 * scale);
    draw_text_transformed(xx + scale, yy, bulletletter, scale, scale, 0);
    draw_text_transformed(xx, yy + scale, bulletletter, scale, scale, 0);
    draw_text_transformed(xx - scale, yy, bulletletter, scale, scale, 0);
    draw_text_transformed(xx, yy - scale, bulletletter, scale, scale, 0);
    draw_set_color(c_white);
    draw_text_transformed(xx, yy, bulletletter, scale, scale, 0);
}
");

Apply("gml_Object_obj_spamton_wordbullet_Step_0", @"event_inherited();
if (init == 0)
{
    rawspeed = speed;
    init = 1;
}
if (x >= (mouthx - 16) && i_ex(creator))
{
    offset = (creator.y + creator.mouthy) - 4 - ystart;
}
else if (x < (mouthx - 16))
{
    offset = scr_movetowards(offset, 0, 3 / global.fps_scale);
}
if (type == 1 && x < mouthx)
{
    speed = 0;
    if (!tracked)
    {
        var __targetdir = point_direction(x, truey, targetx, targety);
        var __diff = angle_difference(fauxdirection, __targetdir);
        if (abs(__diff) > 10)
        {
            fauxdirection -= ((sign(__diff) * 10) / global.fps_scale);
        }
        else
        {
            tracked = true;
            fauxdirection = __targetdir;
        }
    }
    var _xdir = lengthdir_x(5, fauxdirection);
    x += ((_xdir * abs(5 / _xdir)) / global.fps_scale);
    truey += ((lengthdir_y(5, fauxdirection) * abs(5 / _xdir)) / global.fps_scale);
}
y = truey + (cos(x / ((x > (mouthx - 16)) ? 12 : clamp(sinesize, 10, 20))) * 10 * sinesign) + offset;
if (type == 0 || x >= mouthx)
{
    speed = scr_movetowards(speed, 5 / global.fps_scale, 0.25 / global.fps_scale);
}
");

Apply("gml_Object_obj_spamtonshot_Create_0", @"if (instance_exists(obj_sneo_heartattack) && obj_sneo_heartattack.heart_health < 1)
{
    instance_destroy();
    exit;
}
scr_bullet_init();
element = 6;
f = 2;
con = 0;
mode = 1;
dontexplode = 0;
destroyable = 0;
image_xscale = 1;
image_yscale = 1;
siner = 0;
fluffyguarddestroysthis = 0;
targetx = camerax() + (camerawidth() / 2);
targety = cameray() + (cameraheight() / 4);
if (instance_exists(obj_heart))
{
    targetx = obj_heart.x;
    targety = obj_heart.y;
}
move_towards_point(targetx, targety, 5 / global.fps_scale);
angle_speed = 0;
grazepoints = 4;
if (instance_exists(obj_sneo_bulletcontroller))
{
    target = obj_sneo_bulletcontroller.target;
}
");

Apply("gml_Object_obj_spamtonshot_Step_0", @"if (instance_exists(obj_spamton_neo_enemy))
{
