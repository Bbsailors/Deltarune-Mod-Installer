        check1.vspeed = -0.02 / global.fps_scale;
        check1.hspeed = 0.02 / global.fps_scale;
        check2.vspeed = -0.02 / global.fps_scale;
        check3.vspeed = -0.02 / global.fps_scale;
        check3.hspeed = -0.02 / global.fps_scale;
    }
}
if (fireworks_con == 4)
{
    timer += (1 / global.fps_scale);
    if (i_ex(check1))
    {
        check1.vspeed *= power(1.1, 1 / global.fps_scale);
        check1.hspeed *= power(1.1, 1 / global.fps_scale);
        if (frac(timer) == 0)
        {
            with (check1)
            {
                scr_afterimagefast();
            }
