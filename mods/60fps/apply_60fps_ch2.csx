    {
        snd_play(snd_boxing_round3);
    }
}
if (o_boxingcontroller.wireframe_boxing == 1)
{
    if (timer <= 30)
    {
        y = EaseOutBounce(timer / 30, ystart + 60, ystart + 60, 1);
    }
}
else if (timer <= 30)
{
    y = EaseOutBounce(timer / 30, ystart + 100, cameray() + 200, 1);
}
if (timer < 52)
{
    draw_self();
}
else
{
    image_alpha -= (0.1 / global.fps_scale);
    if (image_alpha < 0)
    {
        instance_destroy();
