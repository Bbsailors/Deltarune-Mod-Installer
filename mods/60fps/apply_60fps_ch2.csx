Apply("gml_Object_obj_queenart_mona_Step_0", @"if (decorative == true)
{
    active = 0;
}
if (con == 0)
{
    image_index = 0;
    timer += (1 / global.fps_scale);
    threshold = 60;
    if (type == 0)
    {
        threshold = 60;
    }
    if (type == 1)
    {
        threshold = 20;
    }
    if (type == 2)
    {
        threshold = 35;
    }
    if (type == 3)
    {
        threshold = 15;
    }
    if (timer >= threshold && active == 1)
    {
        con = 1;
        timer = 0;
    }
}
if (con == 1)
{
    timer += (1 / global.fps_scale);
    flashamt = sin(timer / 2);
    if (flashamt < 0 && timer >= 5)
    {
        con = 2;
        timer = 0;
    }
}
if (con == 2)
{
    image_index = 1;
    timer += (1 / global.fps_scale);
    if (type == 0)
    {
        flameangle = -25;
    }
    if (type == 1)
    {
        flameangle = -30;
    }
    if (type == 2)
    {
        flameangle = -140;
    }
    if (type == 3)
    {
        flameangle = -25;
    }
    if (type == 4)
    {
        flameangle = -15;
    }
    flameanglemax = abs(flameangle);
    flameangle = sin(timer / 4) * flameanglemax;
    if (movetype == 1)
    {
        flameangle = 0;
    }
    rate = 4;
    if (type == 1)
    {
        rate = 3;
    }
    if (type == 2)
    {
        rate = 1;
    }
    if (type == 3)
    {
        rate = 3;
    }
    if (type == 4)
    {
        rate = 3;
    }
    if ((timer % rate) == 0)
    {
        if (scr_onscreen_tolerance(id, -40))
        {
            if (type != 4)
            {
                with (bossid)
                {
                    flamesfx = 1;
                }
            }
        }
        flame = instance_create(x + 34, y + 40, obj_queenartfire);
        flame.image_xscale = 0.2;
        flame.image_yscale = 0.2;
        flame.growamt = 0.2;
        flame.image_alpha = 3;
        flame.fadespeed = 0.2;
        flame.direction = 270 + flameangle;
        flame.speed = 15 / global.fps_scale;
        flame.friction = 1 / (global.fps_scale * global.fps_scale);
        flame.vspeed += 8 / global.fps_scale;
        if (type == 2)
        {
            flame.fadespeed = 0.15;
            flame.vspeed -= 6 / global.fps_scale;
            flame.speed += 5 / global.fps_scale;
        }
        if (type == 3)
        {
            flame.vspeed -= 6 / global.fps_scale;
            flame.speed += 3 / global.fps_scale;
            flame.fadespeed = 0.16;
        }
        if (type == 4)
        {
            flame.damage = 60;
            flame.vspeed = 20 / global.fps_scale;
            flame.fadespeed = 0.12;
        }
    }
    threshold = 57;
    if (type == 1)
    {
        threshold = 30;
    }
    if (type == 2)
    {
        threshold = 18;
    }
    if (type == 3)
    {
        threshold = 15;
    }
    if (timer >= threshold && type != 4)
    {
        image_index = 0;
        con = 0;
        timer = 0;
    }
}
if (con == 3)
{
    flashamt = 0;
    if (type == 4)
    {
        con = 2;
    }
    laughtimer += (1 / global.fps_scale);
    if ((laughtimer % 9) == 0)
    {
        image_index = 1;
    }
    if ((laughtimer % 9) == 3)
    {
        image_index = 0;
    }
    if (laughtimer >= 40)
    {
        timer = 0;
        image_index = 0;
        laughtimer = 0;
        con = 0;
    }
}
if (movetype == 1)
{
    movesiner += (1 / global.fps_scale);
    x += ((sin(movesiner / 9) * 9) / global.fps_scale);
}
if (instance_exists(obj_musictracker))
{
    trackpos = obj_musictracker.trackpos;
}
if (trackpos >= 18.862 && trackpos <= 18.902)
{
    con = 3;
}
if (id == bossid && con != 3)
{
    if (flamesfx == 1)
    {
        snd_stop(snd_rocket_mona);
        flame = snd_play_pitch(snd_rocket_mona, 1.5);
        snd_volume(flame, 0.35, 0);
        flamesfx = 0;
    }
    if (dingsfx == 1)
    {
        snd_stop(snd_spearappear);
        snd_play_pitch(snd_spearappear, 0.9);
        dingsfx = 0;
    }
}
");

Apply("gml_Object_obj_queenart_red_Draw_0", @"if (flip == false)
{
    draw_self();
}
if (flip == true)
{
    con = 0;
    global.interact = 1;
    if (flipcon == 0)
    {
        draw_set_alpha(0.2);
        draw_rectangle(x - 38, y + 2, x + 38, (y + 120) - 2, 0);
        draw_set_alpha(1);
        if (flipped == 0)
        {
            draw_sprite_ext(spriteindex2, image_index, x + 2, y, image_xscale, image_yscale, image_angle, c_gray, image_alpha);
            draw_sprite_ext(spriteindex2, image_index, x + 1, y, image_xscale, image_yscale, image_angle, c_gray, image_alpha);
        }
        if (flipped == 1)
        {
            draw_sprite_ext(spriteindex1, image_index, x + 2, y, image_xscale, image_yscale, image_angle, c_gray, image_alpha);
            draw_sprite_ext(spriteindex1, image_index, x + 1, y, image_xscale, image_yscale, image_angle, c_gray, image_alpha);
        }
        draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, c_white, image_alpha);
        if (image_xscale > 0.1)
        {
            image_xscale *= power(flipfactor, 1 / global.fps_scale);
            image_xscale = clamp(image_xscale, 0, 2);
        }
        else
        {
            flipcon = 1;
            image_xscale = 0.1;
            fliptimer = 0;
        }
    }
    if (flipcon == 1)
    {
        draw_sprite_ext(spriteindex1, 0, x - 2, y, image_xscale, image_yscale, 0, c_white, 1);
        draw_sprite_ext(spriteindex2, 0, x, y, image_xscale, image_yscale, 0, c_white, 1);
        fliptimer += (1 / global.fps_scale);
        if (fliptimer == 2)
        {
            if (flipped == 0)
            {
                sprite_index = spriteindex2;
                flipped = true;
                flipcon = 2;
            }
            else
            {
                sprite_index = spriteindex1;
                flipped = false;
                flipcon = 2;
            }
        }
    }
    if (flipcon == 2)
    {
        draw_set_alpha(0.2);
        draw_rectangle(x - 38, y + 2, x + 38, (y + 120) - 2, 0);
        draw_set_alpha(1);
        draw_self();
        if (image_xscale < 1.99)
        {
            image_xscale *= power(1 / flipfactor, 1 / global.fps_scale);
            image_xscale = clamp(image_xscale, 0, 2);
        }
        else
        {
            image_xscale = 2;
            flip = false;
            global.interact = 0;
            flipcon = 0;
        }
    }
}
if (decorative == true && flip == false)
{
    shadow = instance_create(x, y, obj_marker);
    shadow.image_xscale = 2;
    shadow.image_yscale = 2;
    shadow.sprite_index = sprite_index;
    shadow.image_index = image_index;
    shadow.depth = depth;
    shadow.image_speed = image_speed / global.fps_scale;
    instance_destroy();
}
if (isswitch && dontshine == 0)
{
    if (!shine_init)
    {
        shine_init = true;
        shine = scr_dark_marker(x - 8, y + 84, spr_shine_white);
        shine.depth = depth - 10;
        shine.image_speed = 0.1 / global.fps_scale;
    }
}
");

