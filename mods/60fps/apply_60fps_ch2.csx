}
if ((hspeed > 0 && x > (obj_growtangle.x + (obj_growtangle.sprite_width / 2) + 10)) || (hspeed < 0 && x < (obj_growtangle.x - (obj_growtangle.sprite_width / 2) - 10)))
{
