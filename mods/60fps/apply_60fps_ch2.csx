            if (rr == 1)
            {
                global.battlemsg[0] = """";
            }
            if (rr == 2)
            {
                global.battlemsg[0] = """";
            }
            if (rr == 3)
            {
                global.battlemsg[0] = """";
            }
            attacked = 1;
            buildedblocks = 0;
        }
        else
        {
            scr_turntimer(120);
        }
    }
}
if (global.myfight == 3)
