    noellebox.sprite_index = spr_cutscene_13_noelle_box_walk_right;
    noellebox.visible = 0;
    noellebox.image_speed = 0;
    noellebox.image_xscale = 2;
    noellebox.image_yscale = 2;
    with (noellebox)
    {
        scr_depth();
    }
    noellelost = false;
}
");

