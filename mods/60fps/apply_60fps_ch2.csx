    if (frozen == 1)
    {
        if (hadfrozen == 0)
        {
            remspeed = speed;
            speed = 0;
            hadfrozen = 1;
        }
    }
    if (frozen == 0)
    {
        if (hadfrozen == 1)
        {
            if (speed == 0)
            {
                speed = remspeed;
            }
            hadfrozen = 0;
        }
    }
    if (frozen == 0)
    {
        fliptimer += (1 / global.fps_scale);
        if (fliptimer >= 30)
        {
            vspeed = -vspeed;
