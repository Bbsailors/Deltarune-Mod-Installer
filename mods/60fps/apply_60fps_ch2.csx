// ---- non-code: move obj_chaseenemy in room_dw_city_big_3 (488,1226) -> (520,1290) ----
// A Data.Rooms edit, so it is NOT in the code diff above and a code-only repack would drop it.
{
    var __r = Data.Rooms.ByName("room_dw_city_big_3");
    int __mv = 0;
    if (__r != null)
        foreach (var __go in __r.GameObjects)
            if (__go.ObjectDefinition != null && __go.ObjectDefinition.Name != null
                && __go.ObjectDefinition.Name.Content == "obj_chaseenemy"
                && __go.X == 488 && __go.Y == 1226)
            { __go.X = 520; __go.Y = 1290; __mv++; }
    if (__mv != 1)
        throw new Exception("instance-move room_dw_city_big_3/obj_chaseenemy: expected 1, moved " + __mv);
    Console.WriteLine("room_dw_city_big_3: obj_chaseenemy (488,1226) -> (520,1290).");
}

// ---- non-code: room asset-layer animation speed room_dw_castle_area_2 / spr_castle_fountain 0.1 -> 0.05 (x1) ----
// A Data.Rooms asset-layer edit (not a code entry), so it is NOT in the code diff above. These
// FramesPerSecond asset-layer sprites are frame-coupled -> play 2x at room_speed=60; halved here.
{
    var __r = Data.Rooms.ByName("room_dw_castle_area_2");
    int __n = 0;
    if (__r != null && __r.Layers != null)
        foreach (var __ly in __r.Layers)
        {
            if (__ly.LayerType != UndertaleRoom.LayerType.Assets || __ly.AssetsData == null || __ly.AssetsData.Sprites == null) continue;
            foreach (var __si in __ly.AssetsData.Sprites)
            {
                if (__si.Sprite == null || __si.Sprite.Name == null || __si.Sprite.Name.Content != "spr_castle_fountain") continue;
                int __f = (__si.Sprite.Textures == null) ? 0 : __si.Sprite.Textures.Count;
                if (__f <= 1 || __si.AnimationSpeed <= 0) continue; // skip static (1-frame) plaques
                if (Math.Abs(__si.AnimationSpeed - 0.1) > 0.0006)
                    throw new Exception("asset-layer room_dw_castle_area_2/spr_castle_fountain: speed " + __si.AnimationSpeed + " != expected 0.1 (already fixed / drift?)");
                __si.AnimationSpeed = 0.05f;
                __n++;
            }
        }
    if (__n != 1)
        throw new Exception("asset-layer room_dw_castle_area_2/spr_castle_fountain: expected 1, applied " + __n);
    Console.WriteLine("asset-layer room_dw_castle_area_2/spr_castle_fountain: 0.1 -> 0.05 (x" + __n + ").");
}

