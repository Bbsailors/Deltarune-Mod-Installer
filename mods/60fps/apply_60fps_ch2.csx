Apply("gml_Object_obj_dw_transition_Draw_0", @"index += (1 / global.fps_scale);
if (rect_draw == 1)
{
    rs += (1 / global.fps_scale);
    for (var i = 0; i < rect_amount; i += 1)
    {
        rsize[i] += 0.25 / global.fps_scale;
        if (quick_mode == 1)
        {
            rsize[i] += 0.25 / global.fps_scale;
        }
        if (rsize[i] > 0)
        {
            r_darkest = 5 - (rsize[i] * 0.8);
            if (rs < 20)
            {
                r_darkest *= (rs / 20);
            }
            if (r_darkest < 0)
            {
                r_darkest = 0;
            }
            if (r_darkest > 1)
            {
                r_darkest = 1;
            }
            r_color = merge_color(c_black, c_white, r_darkest);
            draw_sprite_ext(spr_doorblack, 0, rx + camerax(), ry + cameray(), rw * rsize[i], rh * rsize[i], rsize[i], r_color, 1);
        }
    }
}
if (con == 8)
{
    mus_volume(global.currentsong[1], 0, 30);
    with (obj_mainchara)
    {
        cutscene = 1;
    }
    with (obj_kris_headobj)
    {
        follow = 0;
        depth = obj_dw_transition.depth - 10;
    }
    sus_draw = 1;
    sus_sprite = spr_susieu;
    sus_index = 0;
    kris_sprite = spr_krisu;
    kris_index = 0;
    sus_v = 1.2 / global.fps_scale;
    if (quick_mode == 1)
    {
        sus_v = 2 / global.fps_scale;
    }
    timer = 0;
    con = 9;
    doorblack = 0;
}
if (con == 9)
{
    timer += (1 / global.fps_scale);
    if (quick_mode == 1 || skiprunback == 1)
    {
        if (timer < 40)
        {
            snd_free_all();
            if (skiprunback == 0)
            {
                snd_play(snd_locker);
                doorblack = 1;
            }
            sus_v = 6 / global.fps_scale;
            sus_f = 0.4 / (global.fps_scale * global.fps_scale);
            timer = 45;
            kris_x -= 4;
            sus_sprite = spr_susieu_run;
            kris_sprite = spr_krisu_run;
        }
    }
    if (timer < 30)
    {
        sus_index += (0.2 / global.fps_scale);
    }
    if (timer == 30)
    {
        snd_free_all();
        snd_play(snd_locker);
        with (obj_darkdoor)
        {
            instance_destroy();
        }
        doorblack = 1;
        sus_index = 0;
        sus_v = 0;
        kris_x -= 4;
        sus_sprite = spr_susieu_run;
        kris_sprite = spr_krisu_run;
    }
    if (timer == 60)
    {
        sus_sprite = spr_susieu_run;
        kris_sprite = spr_krisu_run;
        sus_v = -5 / global.fps_scale;
        sus_f = 0;
    }
    if (timer > 60 && timer < 68)
    {
        kris_y -= (1 / global.fps_scale);
        sus_index += (0.25 / global.fps_scale);
    }
    if (timer == 68)
    {
        sus_f = 0.15 / (global.fps_scale * global.fps_scale);
        sus_v = -4 / global.fps_scale;
        sus_y -= 2;
        sus_x -= 2;
        sus_sprite = spr_susie_lw_fall_u;
        kris_sprite = spr_krisu_fall_lw;
        con = 15;
        soundtimer = 0;
    }
    if (doorblack == 1)
    {
        draw_set_color(c_black);
        draw_rectangle(rx1 + camerax(), ry1 + cameray(), rx2 + camerax(), ry2 + cameray(), false);
    }
}
if (con == 15)
{
    rs = 0;
    rh = (ry2 - ry1) / 100;
    rw = (rx2 - rx1) / 100;
    rx = (rx1 + rx2) / 2;
    ry = (ry1 + ry2) / 2;
    for (var i = 0; i < 8; i += 1)
    {
        rsize[i] = 1 + (i * -2);
    }
    rect_amount = 6;
    rect_draw = 1;
    timer = 0;
    if (quick_mode == 1)
    {
        rect_amount = 3;
    }
    con = 16;
    soundtimer = 3;
    rectsound = 0;
}
if (con == 16)
{
    soundthreshold = 6;
    if (quick_mode == 1)
    {
        soundthreshold = 3;
    }
    soundtimer += (1 / global.fps_scale);
    if (soundtimer >= soundthreshold && rectsound < rect_amount)
    {
        soundtimer = 0;
        snd_stop(snd_dtrans_square);
        snd_play(snd_dtrans_square);
        snd_volume(snd_dtrans_square, 0.5, 0);
        rectsound++;
    }
    sus_index += (0.25 / global.fps_scale);
    if (sus_v >= 0)
    {
        sus_f = 0;
        sus_v += (0.005 / (global.fps_scale * global.fps_scale));
    }
    timer += (1 / global.fps_scale);
    threshold = 80;
    if (quick_mode == 1)
    {
        threshold = 30;
    }
    if (timer >= threshold)
    {
        timer = 0;
        con = 17;
        sus_index = 0;
    }
}
if (con == 17)
{
    __background_set(e__BG.Visible, 0, 0);
    draw_rect = 0;
    linecon = 1;
    sus_x_current = sus_x;
    kris_x_current = kris_x;
    sus_sprite = spr_susie_lw_fall_turn;
    kris_sprite = spr_kris_fall_turnaround;
    con = 18;
    soundcon = 1;
    radius = 60;
}
if (soundcon == 1)
{
    dronesfx = snd_loop(snd_dtrans_drone);
    snd_volume(dronesfx, 0, 0);
    snd_volume(dronesfx, 0.5, 60);
    snd_pitch(dronesfx, 0.1);
    dronetimer = 0;
    soundcon = 2;
}
if (soundcon == 2)
{
    dronetimer += (1 / global.fps_scale);
    if (quick_mode == 1)
    {
        dronetimer += (1 / global.fps_scale);
    }
    dronepitch = dronetimer / 80;
    if (dronepitch >= 1)
    {
        dronepitch = 1;
        soundcon = 3;
    }
    snd_pitch(dronesfx, dronepitch);
}
if (con == 18)
{
    timer += (1 / global.fps_scale);
    if (quick_mode == 1)
    {
        timer += (1 / global.fps_scale);
