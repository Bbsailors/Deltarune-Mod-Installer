Apply("gml_Object_obj_sneo_phonehand_Step_0", @"if (init == 0)
{
    if (i_ex(boss))
    {
        if (orientation == ""top"")
        {
            jointx = boss.x - 10;
            jointy = y - 30;
        }
        if (orientation == ""bottom"")
        {
            image_yscale = -1;
            jointx = boss.x - 10;
            jointy = y + 30;
        }
        remjointy = jointy;
        init = 1;
    }
}
if (btimer == 13)
{
    if (image_yscale > 0)
    {
        image_yscale = 2;
    }
    if (image_yscale < 0)
    {
        image_yscale = -2;
    }
}
if (image_yscale > 1)
{
    image_yscale -= (0.2 / global.fps_scale);
}
if (image_yscale < -1)
{
    image_yscale += (0.2 / global.fps_scale);
}
movingcheck = 0;
if (alt == 0)
{
    crawlsiner += (1 / global.fps_scale);
    if (orientation == ""top"")
    {
        if (sin(crawlsiner / period) < 0)
        {
            wasmoving = 1;
            movingcheck = 1;
            y += ((cos(crawlsiner / period) * amplitude * 2) / global.fps_scale);
            x += ((sin(crawlsiner / period) * amplitude) / global.fps_scale);
        }
    }
    if (orientation == ""bottom"")
    {
        if (cos((crawlsiner / period) + 1.5707963267948966) < 0)
        {
            wasmoving = 1;
            movingcheck = 1;
            y += ((sin((crawlsiner / period) + 1.5707963267948966) * amplitude * 2) / global.fps_scale);
            x += ((cos((crawlsiner / period) + 1.5707963267948966) * amplitude) / global.fps_scale);
        }
    }
    if (i_ex(boss))
    {
        jointx = (x + boss.x) / 2;
        jointy = (remjointy + y) / 2;
    }
}
if (alt == 1 && i_ex(boss))
{
    if (orientation == ""top"")
    {
        crawlsiner += (1 / global.fps_scale);
    }
    else
    {
        crawlsiner -= (1 / global.fps_scale);
    }
    xx = camerax() + 200;
    endx = boss.x - 20;
    x = xx + ((endx - xx) / 2) + (sin(crawlsiner / 12) * ((endx - xx) / 2));
    btimer += (1 / global.fps_scale);
    threshold = 18;
    if (orientation == ""top"")
    {
        threshold = 28;
    }
    if (btimer >= threshold)
    {
        shot = instance_create(x, y, obj_basicbullet_sneo);
        if (orientation == ""top"")
        {
            shot.direction = 270 + random_range(-2, 2);
        }
        if (orientation == ""bottom"")
        {
            shot.direction = 90 + random_range(-2, 2);
        }
        shot.speed = 3 / global.fps_scale;
        shot.sprite_index = spr_sneo_soundbullet;
        shot.image_angle = shot.direction;
        shot.grazepoints = 3;
        shot.target = target;
