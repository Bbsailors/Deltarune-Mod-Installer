Apply("gml_Object_obj_berdlyb_tornado_Step_1", @"if (firstwave == 1)
{
    speed = 0;
    for (i = 0; i < 50; i++)
    {
        speed += -(-1.75 + (sin((i + 15.707963267948966) / 10) * 1.75));
