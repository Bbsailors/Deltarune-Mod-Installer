    draw_sprite_ext(spr_dogtable_table, 0, x, y, 2, 2, 0, c_white, 1);
}
");

Apply("gml_Object_obj_dogtable_controlled_Step_1", @"ctimer += (1 / global.fps_scale);
if (vertState == 0)
{
    if (pauseInit == 1)
    {
        vspeed = memvspeed;
        hsp = memhsp;
        hspeed = memhspeed;
        pauseInit = 0;
    }
    if (abs(vspeed) < maxvspeed)
    {
        vspeed += ((1 * sign(vspeed)) / global.fps_scale);
    }
    if (abs(vspeed) > maxvspeed)
    {
        vspeed *= power(0.9, 1 / global.fps_scale);
    }
    if (place_meeting(x, y + vspeed, obj_solidblock) && room != room_dw_mansion_dininghall)
    {
        vspeed *= -1;
    }
    if (left_h())
    {
        if (hsp >= 0)
        {
            hsp = -1;
        }
        hsp *= power(1.2, 1 / global.fps_scale);
        if (room != room_dw_mansion_dininghall)
        {
            maxvspeed = halfmaxvspeed;
        }
        if ((floor(ctimer) % 4) == 0 && frac(ctimer) == 0)
        {
            dust = instance_create(x - 34, y, obj_slidedust);
            dust.depth = depth + 100;
        }
    }
    else if (right_h())
    {
        if (hsp <= 0)
        {
            hsp = 1;
        }
        hsp *= power(1.2, 1 / global.fps_scale);
        if (room != room_dw_mansion_dininghall)
        {
            maxvspeed = halfmaxvspeed;
        }
        if ((floor(ctimer) % 4) == 0 && frac(ctimer) == 0)
        {
            dust = instance_create(x + 34, y, obj_slidedust);
            dust.depth = depth + 100;
        }
    }
    else
    {
        image_angle = 0;
        if (hsp > 0.1)
        {
            hsp *= power(0.9, 1 / global.fps_scale);
        }
        else if (hsp < -0.1)
        {
            hsp *= power(0.9, 1 / global.fps_scale);
        }
        else
        {
            hsp = 0;
        }
        maxvspeed = realmaxvspeed;
        if ((floor(ctimer) % 4) == 0 && frac(ctimer) == 0)
        {
            dust1 = instance_create(x - 34, y, obj_slidedust);
            dust1.depth = depth + 100;
            dust2 = instance_create(x + 34, y, obj_slidedust);
            dust2.depth = depth + 100;
        }
    }
    if (left_h() && right_h())
    {
        image_angle = 0;
        hsp = 0;
        if (room != room_dw_mansion_dininghall)
        {
            maxvspeed = halfmaxvspeed;
        }
    }
    hsp = clamp(hsp, -16, 16);
    hspeed = hsp / global.fps_scale;
    if (place_meeting(x + hspeed, y, obj_solidblock))
    {
        hsp = -(hsp / 2);
        hspeed = hsp / global.fps_scale;
    }
}
if (vertState == 1)
{
    if (pauseInit == 0)
    {
        memvspeed = vspeed;
        memhsp = hsp;
        memhspeed = hspeed;
        pauseInit = 1;
    }
    vspeed = 0;
    hsp = 0;
    hspeed = 0;
}
if (drawtype == 0)
{
    scr_depth_alt();
}
if (active == 1 && drawtype == 0)
{
    obj_mainchara.x = x - 24;
    obj_mainchara.y = y - 60;
}
if (global.interact != 0)
{
    vertState = 1;
}
if (global.interact == 0)
{
    vertState = 0;
}
if (!collided && room == room_dw_mansion_dininghall)
{
    if (y <= 194)
    {
        y = 194;
        collided = true;
        vertState = 1;
        global.interact = 1;
        scr_debug_print(""collision happened"");
        with (obj_controller_dininghall)
        {
            con = 2;
        }
        hsp = 0;
        vspeed = 0;
    }
}
");

