    if (place_meeting(x + px, y, obj_solidblock))
    {
        if (place_meeting(x + px, y, obj_solidblock))
        {
            g = max(abs(px), abs(py));
            while (g > 0)
            {
                mvd = 0;
                if (press_d == 0 && !place_meeting(x + px, y - g, obj_solidblock))
                {
                    y -= g;
                    py = 0;
                    break;
                    mvd = 1;
                }
                if (press_u == 0 && mvd == 0 && !place_meeting(x + px, y + g, obj_solidblock))
                {
                    y += g;
                    py = 0;
                    break;
                }
                g -= 1;
            }
        }
        xmeet = 1;
        bkx = 0;
        if (px > 0)
        {
            for (i = px; i >= 0; i -= 1)
            {
                if (!place_meeting(x + i, y, obj_solidblock))
                {
                    px = i;
                    bkx = 1;
                    break;
                }
            }
        }
        if (px < 0)
        {
            for (i = px; i <= 0; i += 1)
            {
                if (!place_meeting(x + i, y, obj_solidblock))
                {
                    px = i;
                    bkx = 1;
                    break;
                }
            }
        }
        if (bkx == 0)
        {
            px = 0;
        }
    }
    if (place_meeting(x, y + py, obj_solidblock))
    {
        ymeet = 1;
        bky = 0;
        if (place_meeting(x, y + py, obj_solidblock))
        {
            g = max(abs(px), abs(py));
            while (g > 0)
            {
                mvd = 0;
                if (press_r == 0 && !place_meeting(x - g, y + py, obj_solidblock))
                {
                    x -= g;
                    px = 0;
                    break;
                    mvd = 1;
                }
                if (mvd == 0 && press_l == 0 && !place_meeting(x + g, y + py, obj_solidblock))
                {
                    x += g;
                    px = 0;
                    break;
                }
                g -= 1;
            }
        }
        if (py > 0)
        {
            for (i = py; i >= 0; i -= 1)
            {
                if (!place_meeting(x, y + i, obj_solidblock))
                {
                    py = i;
                    bky = 1;
                    break;
                }
            }
        }
        if (py < 0)
        {
            for (i = py; i <= 0; i += 1)
            {
                if (!place_meeting(x, y + i, obj_solidblock))
                {
                    py = i;
                    bky = 1;
                    break;
                }
            }
        }
        if (bky == 0)
        {
            py = 0;
        }
    }
    if (place_meeting(x + px, y + py, obj_solidblock))
    {
        xymeet = 1;
        bkxy = 0;
        i = px;
        j = py;
        while (j != 0 || i != 0)
        {
            if (!place_meeting(x + i, y + j, obj_solidblock))
            {
                px = i;
                py = j;
                bkxy = 1;
                break;
            }
            if (abs(j) >= 1)
            {
                if (j > 0)
                {
                    j -= 1;
                }
                if (j < 0)
                {
                    j += 1;
                }
            }
            else
            {
                j = 0;
            }
            if (abs(i) >= 1)
            {
                if (i > 0)
                {
                    i -= 1;
                }
                if (i < 0)
                {
                    i += 1;
                }
            }
            else
            {
                i = 0;
            }
        }
        if (bkxy == 0)
        {
            px = 0;
            py = 0;
        }
    }
    runmove = 0;
    if (run == 1 && xmeet == 0 && ymeet == 0 && xymeet == 0)
    {
