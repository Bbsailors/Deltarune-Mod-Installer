    afterimage.image_alpha = 0.8;
}
draw_set_alpha(1);
");

Apply("gml_Object_obj_hangplug_spark_Step_0", @"timer += (1 / global.fps_scale);
if (timer <= 15)
{
    flashtimer += (1 / global.fps_scale);
    image_alpha = abs(cos(flashtimer / 2));
}
if (timer == 15)
{
    image_alpha = 1;
    vspeed = 0.1 / global.fps_scale;
    if (!snd_is_playing(snd_ultraswing))
    {
        spawn = snd_play_pitch(snd_ultraswing, 2);
        snd_volume(spawn, 0.6, 0);
    }
    con = 1;
}
if (con == 1)
{
    if (room == room_dw_mansion_east_4f_c)
    {
        vspeed = clamp(vspeed, 0, 18 / global.fps_scale);
        vspeed *= power(1.6, 1 / global.fps_scale);
    }
    else
    {
        vspeed = clamp(vspeed, 0, 14 / global.fps_scale);
        vspeed *= power(1.5, 1 / global.fps_scale);
    }
    if (y >= (basey + fallAmount))
    {
        y = basey + fallAmount;
        con = 2;
    }
}
if (con == 2)
{
    left = instance_create(x, y - (sprite_height / 2), obj_hangplug_sparkwave);
    with (left)
    {
        dir = ""left"";
    }
    right = instance_create(x, y - (sprite_height / 2), obj_hangplug_sparkwave);
    with (right)
    {
        dir = ""right"";
    }
    drop = snd_play_pitch(snd_battleenter, 1.5);
    snd_volume(drop, 0.3, 0);
    instance_destroy();
}
scr_depth_alt();
");

Apply("gml_Object_obj_hangplug_sparkwave_Step_0", @"scr_depth_alt();
if ((global.time % global.fps_scale) == 0)
{
    a = scr_afterimage();
    a.x += deshspeed;
    a.image_alpha = image_alpha * 0.5;
    a.fadeSpeed = 0.15;
    a.depth = depth + 10;
}
if (init == 0)
{
    if (dir == ""left"")
    {
        deshspeed = -12 / global.fps_scale;
    }
    if (dir == ""right"")
    {
        deshspeed = 12 / global.fps_scale;
    }
    hspeed = (0.1 * sign(deshspeed)) / global.fps_scale;
    image_xscale = 2 * sign(deshspeed) * -1;
    init = 1;
    image_alpha = 0;
}
if (hspeed < abs(deshspeed))
{
    hspeed *= power(1.5, 1 / global.fps_scale);
}
hspeed = clamp(hspeed, -abs(deshspeed), abs(deshspeed));
if (con == 0)
{
    image_alpha = image_yscale / 2;
    image_yscale *= power(1.3, 1 / global.fps_scale);
    if (image_yscale >= 2)
    {
        image_yscale = 2;
        con++;
    }
}
if (place_meeting(x, y, obj_solidenemy) || x > (room_width + sprite_width) || x < (0 - sprite_width))
{
    active = 0;
    fadeaway = 1;
}
if (fadeaway == 1)
{
    image_alpha *= power(0.6, 1 / global.fps_scale);
    active = 0;
    if (image_alpha <= 0.01)
    {
        instance_destroy();
    }
}
");

