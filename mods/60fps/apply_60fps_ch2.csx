        }
    }
    if (acting == 5 && actcon == 0)
    {
        msgset(0, """");
        scr_battletext_default();
        actcon = 1;
    }
    if (acting == 6 && actcon == 0)
    {
        msgset(0, """");
        scr_monster_make_tired(myself);
        scr_battletext_default();
        actcon = 1;
    }
    if (actingsus == 1 && actconsus == 1)
