{
    draw_sprite_ext_flash(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, merge_color(start_color, end_color, color_lerp), 1);
    if (glow_in_out == 0 && color_lerp >= 0.35)
    {
        glow_in_out = 1;
        glow_lerp = 0;
    }
}
else
{
    draw_self();
}
