}
");

Apply("gml_Object_obj_particle_effect_Create_0", @"lifetime = 0;
fadeondeath = false;
destroyoffscreen = true;
autodepth = false;
rotation = 0;
image_speed = 1 / global.fps_scale;
random_image = false;
init = 0;
height = 0;
psuedo_gravity = 0;
");

Apply("gml_Object_obj_particle_effect_Step_0", @"if (init == 0)
{
    if (random_image)
    {
        image_speed = 0;
        image_index = irandom(image_number - 1);
    }
    init = 1;
}
if (rotation != 0)
{
    image_angle += (rotation / global.fps_scale);
}
if (destroyoffscreen && (x < (camerax() - 50) || x > (camerax() + 680) || y < (cameray() - 50) || y > (cameray() + 510)))
{
    instance_destroy();
}
else if (lifetime > 0)
{
    lifetime -= (1 / global.fps_scale);
    if (lifetime <= 0)
    {
        instance_destroy();
    }
    else if (fadeondeath && lifetime < 10)
    {
        image_alpha = lifetime / 10;
    }
}
");

Apply("gml_Object_obj_persistentfadein_Draw_0", @"image_alpha += (fadespeed / global.fps_scale);
draw_sprite_ext(sprite_index, image_index, x, y, length, height, 0, image_blend, image_alpha);
if (image_alpha <= 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_pipisFireworkGenerator_Step_0", @"with (obj_caterpillarchara)
{
    if (image_alpha <= 0)
    {
        visible = false;
    }
    else
    {
        visible = true;
    }
}
if (con == 0)
{
    with (obj_caterpillarchara)
    {
        if (image_alpha != 1)
        {
            image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.125));
        }
    }
    if (obj_mainchara.battlemode == 1)
    {
        con = 1;
        timer = 0;
    }
    if (i_ex(obj_overworldbullet_fireworks))
    {
        with (obj_overworldbullet_fireworks)
        {
            image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.25));
            if (image_alpha == 0)
            {
                instance_destroy();
            }
            timer = 0;
        }
    }
    if (i_ex(obj_overworldbulletparent))
    {
        with (obj_overworldbulletparent)
        {
            image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.25));
            if (image_alpha == 0)
            {
                instance_destroy();
            }
            timer = 0;
        }
    }
}
if (con == 1)
{
    with (obj_caterpillarchara)
    {
        if (image_alpha != 0)
        {
            image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.3));
        }
    }
    timer += (1 / global.fps_scale);
    if (timer >= 20)
    {
        py = cameray() + random_range(0, 120);
        py = clamp(py, 360, 2920);
        py = clamp(py, cameray(), 2920);
        if ((shotcount % 2) == 0)
        {
            px = random_range(-20, -40);
        }
        else
        {
            px = random_range(room_width + 20, room_width + 40);
        }
        pipis = instance_create(px, py, obj_overworldbullet_fireworks);
        pipis.depth = depth - 50;
        shotcount++;
        timer = random_range(-5, 5);
    }
    if (obj_mainchara.battlemode == 0)
    {
        con = 0;
        timer = 0;
    }
}
");

Apply("gml_Object_obj_pipis_bullet_Step_0", @"if (!i_ex(parent))
{
    instance_destroy();
    exit;
}
if (length < 36)
{
    length += (2 / global.fps_scale);
}
x = parent.x + lengthdir_x(length, place);
y = parent.y + lengthdir_y(length, place);
if (hp == 0)
{
    event_user(1);
}
");

