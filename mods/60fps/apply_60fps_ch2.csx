            msgnextloc(""* Why is it round dough is always so overpriced?/"", ""obj_npc_room_slash_Other_10_gml_2400_0"");
            msgnextloc(""\\m2\t\t*The hole is expensive!/%"", ""obj_npc_room_slash_Other_10_gml_2401_0"");
