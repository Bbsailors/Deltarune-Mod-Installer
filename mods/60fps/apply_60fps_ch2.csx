    {
        with (obj_kris_fountain)
        {
            if (fountain_sound != -4)
            {
                audio_sound_gain(fountain_sound, 0, 3000);
            }
        }
    }
}
if (return_title)
{
    credits_timer += (1 / global.fps_scale);
    if (credits_timer >= 1)
    {
        snd_free_all();
    }
    if (credits_timer >= 180)
    {
        if (i_ex(obj_kris_fountain))
        {
            instance_destroy(obj_kris_fountain);
        }
        room_goto(room_ed);
    }
}
