{
    sprite_index = spr_king_sulk_drink;
    image_speed = 0.2 / global.fps_scale;
}
if (global.flag[20] == 3)
{
    if (x < 1380)
    {
        if (hspeed < (3 / global.fps_scale))
        {
            hspeed = 3 / global.fps_scale;
        }
        hspeed += (1 / (global.fps_scale * global.fps_scale));
        if (y >= (ystart - 60))
        {
            y -= (4 / global.fps_scale);
        }
    }
    else
    {
        hspeed = 0;
    }
}
else if (x > xstart)
{
    if (y <= ystart)
    {
        y += (4 / global.fps_scale);
    }
    hspeed -= (1 / (global.fps_scale * global.fps_scale));
}
else
{
    hspeed = 0;
}
if (x > 1455)
{
    x = 1455;
}
");

