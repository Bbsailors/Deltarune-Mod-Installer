    {
        hspeed = 0;
        x = basex;
    }
    dizzytimer -= (1 / global.fps_scale);
    image_speed = 0;
    image_index += (0.1 / global.fps_scale);
    if (image_index >= 2)
    {
        image_index = 0;
        drawflip *= -1;
    }
    if (dizzytimer <= 0)
    {
        event_user(1);
    }
}
dizzytimer -= (1 / global.fps_scale);

