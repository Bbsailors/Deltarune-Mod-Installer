        msgsetloc(0, ""* Noelle takes on and off her nurse hat really fast!/%"", ""obj_omawaroid_enemy_slash_Step_0_gml_253_0"");
        scr_battletext_default();
        actcon = 1;
        actconnoe = 0;
    }
    if (actcon == 1 && !instance_exists(obj_writer))
    {
