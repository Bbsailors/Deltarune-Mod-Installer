        thrash.image_yscale = 3;
        thrash_con = 4;
        alarm_timer = round(45 * global.fps_scale);
    }
}
if (con == 5)
{
    if (thrash_con == 4)
    {
        snd_play(snd_weaponpull);
        snd_play(snd_closet_impact);
        thrash_con = 5;
        thrash.max_index = 3;
        thrash.image_play = true;
        thrash.image_index++;
        alarm_timer = round(30 * global.fps_scale);
    }
}
if (con == 6)
{
    if (thrash_con == 5)
    {
        snd_play(snd_weaponpull);
        snd_play(snd_closet_impact);
        thrash.max_index = 6;
        thrash.image_play = true;
        thrash.image_index++;
        thrash_con = 6;
        alarm_timer = round(30 * global.fps_scale);
    }
}
if (con == 7)
{
    if (thrash_con == 6)
    {
        snd_play(snd_weaponpull);
        snd_play(snd_closet_impact);
        thrash.image_play = true;
        thrash.image_index++;
        thrash.max_index = 9;
