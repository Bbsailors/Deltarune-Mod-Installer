    if (other.trackpos >= (trigpoint - 0.03) && other.trackpos <= (trigpoint + 0.01))
    {
        hspeed = -5 / global.fps_scale;
        image_xscale = -sign(hspeed);
        x = 320;
    }
    trigpoint = 11.375;
    if (other.trackpos >= (trigpoint - 0.03) && other.trackpos <= (trigpoint + 0.01))
    {
