Apply("gml_Object_obj_ch2_cyber01_Step_0", @"if (obj_mainchara.x > (x - 80) && con == -1)
{
    with (nisesweet)
    {
        x -= (5 / global.fps_scale);
    }
    with (djtable)
    {
        x -= (5 / global.fps_scale);
    }
    if (nisesweet.x <= (camerax() + 520))
    {
        con = 10;
    }
}
if (con == 10)
{
    with (nisesweet)
    {
        x = camerax() + 520;
    }
    if (obj_controller_dw_cyber_music_final.state == 3)
    {
        floattimer += (0.35 / global.fps_scale);
        desy = 30 + sin(floattimer);
        with (nisesweet)
        {
            if (y != other.desy)
            {
                y = lerp(y, other.desy, scr_fps_lerp_rate(0.25));
            }
            sprite_index = spr_sweet_dance;
            image_speed = 0.25 / global.fps_scale;
        }
    }
    else
    {
        floattimer += (0.35 / global.fps_scale);
        desy = targy + sin(floattimer);
        with (nisesweet)
        {
            if (y != other.desy)
            {
                y = lerp(y, other.desy, scr_fps_lerp_rate(0.25));
            }
            sprite_index = spr_sweet_idle;
        }
    }
    var xpos = nisesweet.x - 40;
    var ypos = nisesweet.y + 64;
    with (djtable)
    {
        x = xpos;
    }
    with (djtable)
    {
        y = ypos;
    }
    if (djtable.x >= 2250)
    {
        con = 20;
    }
}
