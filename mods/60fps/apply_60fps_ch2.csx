        {
            fx = instance_create(x, y, obj_sneo_heart_defeated_fx);
            fx.direction = a * 30;
            a++;
        }
    }
    if (defeatedtimer > 20 && defeatedtimer < 50)
    {
        x += (((xstart - x) * 0.1) / global.fps_scale);
        y += (((ystart - y) * 0.1) / global.fps_scale);
    }
    if (defeatedtimer > 50)
    {
        image_alpha -= (0.1 / global.fps_scale);
        if (image_alpha < 0)
        {
            instance_destroy();
            with (obj_sneo_heartattack_intro)
            {
                timer = 0;
                con = 1;
            }
        }
    }
}
if (shootcon == 1)
{
