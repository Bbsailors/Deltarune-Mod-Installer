Apply("gml_Object_obj_monster1_Draw_0", @"if (state == 3)
{
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        if (global.monster[myself] == 0)
        {
            hspeed = 12 / global.fps_scale;
            turnt -= (8 / global.fps_scale);
            vspeed = -4 / global.fps_scale;
        }
        hurtshake += 1;
        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= (1 / global.fps_scale);
            }
            if (shakex < 0)
            {
                shakex += (1 / global.fps_scale);
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(spr_enemy1_hurt, 0, x + shakex, y, 2, 2, turnt, image_blend, 1);
    }
}
if (state == 0)
{
    siner += (1 / global.fps_scale);
    thissprite = spr_enemy1_idle;
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        thissprite = spr_enemy1_spared;
    }
    draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
        d3d_set_fog(true, c_white, 0, 1);
        draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
        d3d_set_fog(false, c_black, 0, 0);
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_monster1_Step_0", @"if (global.monster[myself] == 1)
{
    if (global.mnfight == 1 && talked == 0)
    {
        abletotarget = 1;
        if (global.charcantarget[0] == 0 && global.charcantarget[1] == 0 && global.charcantarget[2] == 0)
        {
            abletotarget = 0;
        }
        mytarget = choose(0, 1, 2);
        if (abletotarget == 1)
        {
            while (global.charcantarget[mytarget] == 0)
            {
                mytarget = choose(0, 1, 2);
            }
        }
        else
        {
            target = 3;
        }
        global.targeted[mytarget] = 1;
        instance_create(0, 0, obj_darkener);
        global.typer = 7;
        global.msg[0] = """";
        if (global.mercymod[myself] >= global.mercymax[myself])
        {
            global.msg[0] = """";
        }
        mywriter = instance_create(x - 60, y - 30, obj_writer);
        talked = 1;
        talktimer = 0;
    }
    if (talked == 1 && global.mnfight == 1)
    {
        if (button1_p() && talktimer > 15)
        {
            talktimer = talkmax;
        }
        talktimer += (1 / global.fps_scale);
        if (talktimer >= talkmax)
        {
            with (obj_writer)
            {
                instance_destroy();
            }
            global.mnfight = 2;
        }
    }
    if (global.mnfight == 2 && attacked == 0)
    {
        simp = instance_create(0, 0, obj_simplecontroller);
        simp.damage = global.monsterat[myself] * 5;
        simp.target = mytarget;
        attacked = 1;
        rr = floor(random(4));
    }
}
if (global.myfight == 3)
{
    xx = __view_get(e__VW.XView, 0);
    yy = __view_get(e__VW.YView, 0);
    if (acting == 1 && actcon == 0)
    {
        actcon = 1;
        global.msg[0] = """";
        global.typer = global.battletyper;
        battlewriter = instance_create(xx + 30, yy + 376, obj_writer);
        if (global.fc != 0)
        {
            myface = instance_create(xx + 26, yy + 380, obj_face);
        }
        if (acting == 1)
        {
            global.mercymod[myself] += 120;
        }
        if (global.mercymod[myself] >= global.mercymax[myself])
        {
            global.msg[0] = """";
        }
    }
    if (acting == 2)
    {
        if (acttimer == 0)
        {
            global.msg[0] = """";
            global.typer = global.battletyper;
            battlewriter = instance_create(xx + 130, yy + 376, obj_writer);
            if (global.fc != 0)
            {
                myface = instance_create(xx + 26, yy + 380, obj_face);
            }
        }
        if (acttimer == 20)
        {
            global.chartarget[0] = myself;
            global.chartarget[1] = myself;
            global.charspecial[0] = 1;
            global.charspecial[1] = 1;
            with (global.charinstance[0])
            {
                state = 2;
            }
            with (global.charinstance[1])
            {
                state = 2;
            }
        }
        if (acttimer == 40)
        {
            actcon = 1;
        }
        acttimer += (1 / global.fps_scale);
    }
    if (actcon == 1 && !instance_exists(obj_writer))
    {
        actcon = 0;
        scr_attackphase();
    }
}
if (x > (__view_get(e__VW.XView, 0) + 800) && global.myfight != 3)
{
    instance_destroy();
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

