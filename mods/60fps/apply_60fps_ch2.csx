            msgset(0, dialogue);
        }
        if (noelle_splat == 1)
        {
            msgsetloc(0, ""Nice"", ""obj_virovirokun_enemy_slash_Step_0_gml_58_0"");
        }
        noelle_splat = 0;
        scr_enemyblcon(x - 10, global.monstery[myself], 10);
        talked = 1;
        talktimer = 0;
    }
    if (talked == 1 && scr_isphase(""enemytalk""))
    {
        rtimer = 0;
