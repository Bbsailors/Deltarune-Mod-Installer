    {
        DRAWNAME = 0;
        EVENT = 70;
        with (DEVICE_MENU)
        {
            ONEBUFFER = 3;
            TWOBUFFER = 3;
        }
        safe_delete(obj_writer);
        safe_delete(DEVICE_CHOICE);
    }
    else
    {
