        {
            speed += ((0.4 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
        }
    }
    var destination = 70 + random(3);
    if (movementstyle != 2)
    {
        destination = 152;
    }
    if (distance_to_point(xstart, ystart) > destination)
    {
        if (movementstyle == 2)
        {
            con = 2;
        }
        else
        {
            speed = 0;
        }
        shootcon = 1;
        if (movementstyle == 2)
        {
            shoottimer = -10;
        }
    }
}
if (con == 2)
{
    if (difficulty == 1)
    {
        speed -= ((0.3 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
    }
    else if (difficulty == 2)
    {
        if (movementstyle == 1)
        {
            speed -= ((0.1 * heart_speed_scaling) / (global.fps_scale * global.fps_scale));
