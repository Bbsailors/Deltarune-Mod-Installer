Apply("gml_Object_obj_lerpvar_Step_0", @"if (i_ex(target))
{
    if (init == 0)
    {
        if (is_string(pointa))
        {
            pointa = variable_instance_get(target, varname);
        }
        init = 1;
    }
    time += (1 / global.fps_scale);
    if (easetype == 0)
    {
        variable_instance_set(target, varname, lerp(pointa, pointb, time / maxtime));
    }
    else
    {
        if (easeinout == ""out"")
        {
            variable_instance_set(target, varname, lerp_ease_out(pointa, pointb, time / maxtime, easetype));
        }
        if (easeinout == ""in"")
        {
            variable_instance_set(target, varname, lerp_ease_in(pointa, pointb, time / maxtime, easetype));
        }
        if (easeinout == ""inout"")
        {
            variable_instance_set(target, varname, lerp_ease_inout(pointa, pointb, time / maxtime, easetype));
        }
    }
    if (time >= maxtime)
    {
        instance_destroy();
    }
}
else
{
    instance_destroy();
}
");

Apply("gml_Object_obj_lightfairy_Create_0", @"siner = random(6000);
sinx = random(15) + 18;
siny = random(15) + 18;
period = 0.5 + random(1);
image_xscale = 2;
image_yscale = 2;
image_speed = 0.1 / global.fps_scale;
factor = 1;
");

Apply("gml_Object_obj_lightfairy_Step_0", @"x += ((sin(siner / sinx) * period) / global.fps_scale);
y += ((sin(siner / siny) * period) / global.fps_scale);
siner += (1 / global.fps_scale);
");

Apply("gml_Object_obj_looping_tiled_area_Draw_0", @"if (!init)
{
    init = true;
    width = (width == -1) ? (sprite_get_width(sprite_index) * x_scale) : width;
    height = (height == -1) ? (sprite_get_height(sprite_index) * y_scale) : height;
}
x_pos += (x_speed / global.fps_scale);
if (room_wide)
{
    if ((x_pos + width) < 0)
    {
        x_pos += width;
    }
    if ((x_pos - width) > 0)
    {
        x_pos -= width;
    }
}
else
{
    if ((x_pos + width) < camerax())
    {
        x_pos += width;
    }
    if ((x_pos - width) > camerax())
    {
        x_pos -= width;
    }
}
if (y_speed != 0)
{
    y_pos += (y_speed / global.fps_scale);
    if ((y_pos + height) < cameray())
    {
        y_pos += height;
    }
    if ((y_pos - height) > cameray())
    {
        y_pos -= height;
    }
}
