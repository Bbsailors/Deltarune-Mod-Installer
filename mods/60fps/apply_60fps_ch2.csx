}
if (con == 1)
{
    if (global.interact == 0)
    {
        if (instance_exists(obj_queenvase))
        {
            with (susid)
            {
                scr_depth();
                nearestpot = instance_nearest(x + (sprite_width / 2), (y + sprite_height) - 2, obj_queenvase);
                if (collision_line(x + (sprite_width / 2), (y + sprite_height) - 2, nearestpot.x + 20, nearestpot.y + 52, obj_solidblock, true, false) == -4)
                {
                    direction = point_direction(x + (sprite_width / 2), (y + sprite_height) - 2, nearestpot.x + 20, (nearestpot.y + 52) - 10);
                    fake_speed = scr_move_step_solids_direction(8 / global.fps_scale, direction);
                    fake_direction = direction;
                }
                else
                {
                    other.con = 2;
                }
                if (place_meeting(x, y, obj_queenvase))
                {
                    other.timer = 0;
                    other.con = 1.1;
                    image_index = 0;
                    sprite_index = spr_susie_right_diagonal_kick_dw;
                }
            }
        }
        else
        {
            con = 2;
        }
    }
}
if (con == 1.1)
{
    if (!i_ex(kick))
    {
        kick = instance_create(susid.x, susid.y, obj_marker);
        kick.sprite_index = spr_susie_right_diagonal_kick_dw;
        kick.visible = true;
        if ((susid.x + (susid.sprite_width / 2)) > susid.nearestpot.x)
        {
            kick.sprite_index = spr_susie_left_diagonal_kick_dw;
        }
        kick.image_xscale = 2;
        kick.image_yscale = 2;
        kick.image_speed = 0.25 / global.fps_scale;
        with (kick)
        {
            scr_depth();
        }
        susid.visible = false;
    }
    if (kick.image_index == 2)
    {
        susid.active = 1;
    }
    if (kick.image_index == 4)
    {
        susid.active = 0;
        susid.visible = true;
        with (kick)
        {
            instance_destroy();
        }
        con = 1;
    }
}
if (con == 2)
{
    if (global.interact == 0)
    {
        var caid = caterpillarid;
        with (susid)
        {
            direction = point_direction(x, y, caid.x, caid.y);
            fake_direction = direction;
            fake_speed = scr_move_step_solids_direction(8 / global.fps_scale, direction);
        }
        if ((abs(susid.x - caterpillarid.x) + abs(susid.y - caterpillarid.y)) < 12)
        {
            with (susid)
            {
                instance_destroy();
            }
            caterpillarid.visible = 1;
            con = 0;
            instance_destroy();
        }
    }
    else
    {
        with (susid)
        {
            fake_speed = 0;
        }
    }
}
");

Apply("gml_Object_obj_ch2_blue_button_Step_0", @"if (pressed)
{
    exit;
}
var checkPress = 0;
if (i_ex(obj_mainchara) && !pressed && global.interact == 0)
{
    if (place_meeting(x, y, obj_mainchara))
    {
        checkPress = 1;
    }
}
if (checkPress)
{
    if (pressed == 0)
    {
        pressed = 1;
        alarm[0] = round(30 * global.fps_scale);
    }
}
");

Apply("gml_Object_obj_ch2_capsule_Create_0", @"con = 0;
timer = 0;
siner = 0;
image_speed = 0.25 / global.fps_scale;
image_xscale = 2;
image_yscale = 2;
extendtimer = 0;
repeattimer = 0;
imagetimer = 0;
main = 1;
if (instance_find(object_index, 0) != id)
{
    main = 0;
}
");

Apply("gml_Object_obj_ch2_capsule_Draw_0", @"if (con == 0 && visible == 1)
{
    draw_self();
    repeattimer -= (1 / global.fps_scale);
    if (repeattimer <= 0)
    {
        repeattimer = 8;
        if (main)
        {
            noise = snd_play(snd_chain_extend);
        }
    }
}
if (con == 1)
{
    if (extendtimer == 0)
    {
        if (main)
        {
            snd_play(snd_swing);
        }
    }
    extendtimer += (0.25 / global.fps_scale);
    if (extendtimer >= 4)
    {
        con = 2;
        if (main)
        {
            snd_play(snd_impact);
        }
    }
    else
    {
        draw_sprite_ext(spr_cutscene_09_capsule_extend, extendtimer, x, y, image_yscale, image_yscale, image_angle, image_blend, image_alpha);
    }
}
if (con == 2)
{
    image_index = 0;
    image_speed = 0;
    sprite_index = spr_cutscene_09_capsule_extended;
    imagetimer += (1 / global.fps_scale);
    if (imagetimer >= 2)
    {
        scr_afterimage();
        imagetimer = 0;
    }
    siner += (1 / global.fps_scale);
    draw_sprite_ext(spr_cutscene_09_capsule_extended, 0, x, y, image_yscale, image_yscale, image_angle, image_blend, image_alpha);
    draw_sprite_ext(spr_cutscene_09_capsule_extended, 1, x, y, image_yscale, image_yscale, image_angle, image_blend, 0.1 + (sin(siner / 2) * 0.1));
}
");

