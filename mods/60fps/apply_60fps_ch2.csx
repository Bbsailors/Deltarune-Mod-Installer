            shoottimer = 0;
            speed *= -0.4;
            visible = false;
            alarm[0] = round(2 * global.fps_scale);
            if (difficulty == 2)
            {
                alarm[0] = round(58 * global.fps_scale);
            }
            direction = 162 + random(36);
        }
