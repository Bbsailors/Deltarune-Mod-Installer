Apply("gml_Object_obj_conveyorbelt_Draw_0", @"var _horiz = yspeed == 0;
var _spd = xspeed;
if (!_horiz)
{
    _spd = yspeed;
}
var _step = (2 * clamp(_spd, -1, 1)) / global.fps_scale;
beltscroll -= _step;
var _sw = sprite_get_width(sprite_index);
var _sh = sprite_get_height(sprite_index);
beltscroll = ((beltscroll % _sw) + _sw) % _sw;
image_speed = 0;
image_index = 0;
var _s = beltscroll;
ht = image_yscale / 2;
wd = image_xscale / 2;
for (var i = 0; i < ht; i++)
{
    for (var j = 0; j < wd; j++)
    {
        var _cx = x + (j * 40);
        var _cy = y + (i * 40);
        if (_horiz)
        {
            draw_sprite_part_ext(sprite_index, 0, _s, 0, _sw - _s, _sh, _cx, _cy, 2, 2, c_white, image_alpha);
            if (_s > 0)
            {
                draw_sprite_part_ext(sprite_index, 0, 0, 0, _s, _sh, _cx + ((_sw - _s) * 2), _cy, 2, 2, c_white, image_alpha);
            }
        }
        else
        {
            draw_sprite_part_ext(sprite_index, 0, 0, _s, _sw, _sh - _s, _cx, _cy, 2, 2, c_white, image_alpha);
            if (_s > 0)
            {
                draw_sprite_part_ext(sprite_index, 0, 0, 0, _sw, _s, _cx, _cy + ((_sh - _s) * 2), 2, 2, c_white, image_alpha);
            }
        }
    }
}
");

