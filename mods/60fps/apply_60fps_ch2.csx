            {
                fakesplash.hspeed = (1 + random(2)) / global.fps_scale;
            }
            fakesplash.vspeed = (1 + random(2)) / global.fps_scale;
        }
        xbase = x;
        ybase = y;
    }
    if (hit_timer > 0 && hit_timer < (10 / f))
    {
        x = (xbase + (15 / ceil(hit_timer))) - irandom(30 / ceil(hit_timer));
        y = (ybase + (15 / ceil(hit_timer))) - irandom(30 / ceil(hit_timer));
    }
    if (hit_timer > 0 && hit_timer < (10 / f))
    {
        with (obj_bq_baseball)
        {
            if (hit == 0)
            {
                y -= vspeed;
            }
        }
    }
    if (hit_timer > (10 / f))
    {
        vspeed = -32 / f / global.fps_scale;
    }
    if (y < -4 && vspeed < 0)
    {
        instance_destroy();
    }
}
if (y > 490)
{
