    }
    with (obj_queen_kristhrown)
    {
        instance_destroy();
    }
    with (obj_queen_ralseithrown)
    {
        instance_destroy();
    }
    with (obj_queen_throwtarget)
    {
        instance_destroy();
    }
    throwXcon = 5;
}
