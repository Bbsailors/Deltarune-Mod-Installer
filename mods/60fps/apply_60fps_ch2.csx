    scr_draw_sprite_tiled_area(spr_cyber_starry_sky_white, 0, 0, dark_y_pos, 0, dark_y_pos, x + room_width, (dark_y_pos + sky_height) - 1, 1, 1, sky_blue_dark, 1);
    var dark_star_y_pos = (cameray() * 0.5) + 10;
