            stat[addstat2] += 1;
        }
    }
}
type = -1;
topstat = -1;
topstatlevel = 0;
for (i = 0; i < 6; i += 1)
{
    if (stat[i] == topstatlevel && topstatlevel >= 2)
    {
        type = 7;
    }
    if (stat[i] > topstatlevel)
    {
        topstat = i;
        topstatlevel = stat[i];
    }
}
type = topstat;
if (type == 7)
{
    type = -1;
}
if (topstatlevel == 0)
{
    type = 6;
}
");

Apply("gml_Object_obj_rouxls_enemy_Draw_0", @"if (state == 3)
{
    scr_enemyhurt_tired_after_damage(0);
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        hurtshake += (1 / global.fps_scale);
        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= 1;
            }
            if (shakex < 0)
            {
                shakex += 1;
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(hurtsprite, 0, x + shakex + hurtspriteoffx, y + hurtspriteoffy, 2, 2, 0, image_blend, 1);
    }
}
fixy = 0;
if (global.flag[221] == 2)
{
    fixy = 10;
}
if (global.flag[221] == 3)
{
    fixy = 26;
}
thrash.xx = x + 34;
thrash.yy = y + 108;
if (state == 0)
{
    fsiner += (1 / global.fps_scale);
    if (saberanim)
    {
        if (thissprite != sabersprite)
        {
            siner = 0;
            thissprite = sabersprite;
        }
        else if (siner < 3)
        {
            siner += (1 / global.fps_scale);
        }
    }
    else
    {
        siner += (0.16666666666666666 / global.fps_scale);
        thissprite = idlesprite;
        if (global.mercymod[myself] >= global.mercymax[myself])
        {
            thissprite = sparedsprite;
        }
    }
    var xpos = (thrashcon == 0) ? x : remx;
    if (thrashcon > 2 && thrashcon != 6)
    {
        draw_monster_body_part(thissprite, siner, xpos, y + floatheight);
    }
    else
    {
        draw_monster_body_part(thissprite, siner, xpos, y + (thrash.s * thrash.walkc) + fixy);
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
if (scr_debug())
{
}
var turretbody = thrash.part[0] == 2;
thrash.s = 3;
var puddx = remx + (turretbody ? 18 : 34);
var puddy = remy + 173 + ((thrash.s * thrash.walkc) / 4);
if (!depthChange && instance_exists(obj_growtangle))
{
    depthChange = 1;
    puddle.depth = thrash.depth + 1;
}
else if (depthChange && !instance_exists(obj_growtangle))
{
    depthChange = 0;
    puddle.depth = simcity.depth + 1;
}
puddle.x = puddx;
puddle.y = remy + 173 + ((thrash.s * cos((thrash.wsiner + thrash.wsinerrate) / 3)) / 4);
if (thrashcon < 2 || thrashcon > 5)
{
    draw_sprite_ext(spr_rouxls_puddle, turretbody ? 3 : 1, puddx, puddy, 2, 2, 0, c_white, 1);
}
puddle.image_index = turretbody ? 2 : 0;
var _wheels = obj_thrashmachine.part[2] == 1;
if (thrashmode == 0)
{
}
if (thrashmode == 1)
{
    if (thrashcon == 0)
    {
        thrashtimer = 0;
        thrashcon = 1;
        var xoff = 0;
        if (turretbody)
        {
            xoff = 10;
            d = instance_create((puddle.x - 60) + xoff, puddle.y + 4, obj_rouxls_splasheffect);
            d.depth = depth - 1;
        }
        d = instance_create((puddle.x - 30) + xoff, puddle.y + 4, obj_rouxls_splasheffect);
        d.depth = depth - 1;
        d = instance_create(puddle.x + 30 + xoff, puddle.y + 4, obj_rouxls_splasheffect);
        d.depth = depth - 1;
        d = instance_create(puddle.x + xoff, puddle.y + 6, obj_rouxls_splasheffect);
        d.depth = depth - 2;
    }
    if (thrashcon == 1)
    {
        thrash.wsinerrate = 0;
        if (y < (remy - 10))
        {
            thrash.drawfeet = 1;
        }
        if (y >= (cameray() + (!headattack ? 45 : 10)))
        {
            thrash.wsiner += 1.6 / global.fps_scale;
            y -= (4 / global.fps_scale);
        }
        else
        {
            if (headattack)
            {
                thrashtimer = arcsin(0.75) * 10;
            }
            aimtime = irandom(15) + 15;
            if (!headattack)
            {
                aimtime = 10;
                switch (obj_thrashmachine.part[2])
                {
                    case 0:
                        height_multiplier = aimtime / 4.71238898038469;
                        break;
                    case 1:
                        height_multiplier = aimtime / 4.71238898038469;
                        thrashtimer = aimtime - 10;
                        break;
                    case 2:
                        height_multiplier = aimtime / 4.71238898038469;
                        break;
                    case 3:
                        height_multiplier = 5;
                        break;
                        height_multiplier = -sin(thrashtimer);
                }
            }
            else
            {
                height_multiplier = 5;
            }
            thrashcon = 2;
            thrash.wsinerrate = 0;
        }
    }
    if (thrashcon == 2)
    {
        thrashtimer += (1 / global.fps_scale);
        if ((thrashtimer % 8) == 0)
        {
            var ripple = instance_create(puddle.x, puddle.y, obj_rouxls_ripple);
            ripple.maxsize = clamp(1 - ((y - 90) / 45), 0.1, 2);
            ripple.image_speed = 0;
            ripple.image_index = turretbody ? 1 : 0;
            ripple.depth = puddle.depth - 1;
            submerged = 0;
        }
        if (headattack)
        {
            y = (cameray() + (headattack ? 40 : 10)) - (sin(thrashtimer / (headattack ? 10 : height_multiplier)) * 40);
        }
        else if (thrashtimer <= aimtime)
        {
            y = (cameray() + 45) - (sin((thrashtimer / aimtime) * pi) * 10);
        }
        if (headattack && y <= (cameray() + 10) && global.turntimer <= 40)
        {
            headattack = 0;
            thrashtimer = 0;
            thrashcon = 5;
        }
        else if (!headattack && thrashtimer >= (aimtime + 10))
        {
            thrashtimer = 0;
            thrashcon = 3;
            thrash.moving = 1;
            floatheight = (thrash.s * thrash.walkc) + fixy;
            d = instance_create(puddle.x, puddle.y + 10, obj_rouxls_splasheffect);
            d.depth = depth - 1;
            d.speed = advancespeed / global.fps_scale;
            d.yscale = 4;
            d.xscale = 3;
        }
        else if (!headattack)
        {
            thrash.wsiner += (1.6 * (advancespeed / 4)) / global.fps_scale;
            if (!headattack && ((thrashtimer - aimtime) % 3) == 0)
            {
                d = instance_create(puddle.x, puddle.y + 10, obj_rouxls_splasheffect);
                d.depth = depth - 1;
                d.speed = advancespeed / global.fps_scale;
                d.yscale = 3;
                d.xscale = 2;
            }
        }
    }
    if (thrashcon == 3)
    {
        if (x >= (camerax() + 200))
        {
            thrash.wsiner += (1.6 * (advancespeed / 8)) / global.fps_scale;
            x -= (advancespeed / global.fps_scale);
        }
        else
        {
            thrashcon = 4;
        }
    }
    if (thrashcon == 4)
    {
        thrashtimer += (1 / global.fps_scale);
        if (_wheels)
        {
            if (thrashtimer <= 90)
            {
                thrash.wsiner += (1.6 * (advancespeed / 8)) / global.fps_scale;
            }
            else
            {
                thrash.wsiner -= 0.5 / global.fps_scale;
            }
        }
        if (thrashtimer >= (_wheels ? 105 : 15))
        {
            thrashcon = 5;
            thrashtimer = 0;
        }
    }
    if (thrashcon == 5)
    {
        if (x < (remx - 6))
        {
            x += (returnspeed / global.fps_scale);
            thrash.wsiner -= (1.6 * (returnspeed / 6)) / global.fps_scale;
        }
        else
        {
            x = remx;
            thrashcon = 6;
            thrash.moving = 0;
        }
    }
    if (thrashcon == 6)
    {
        if (!submerged && y > (remy - 18))
        {
            var xoff = 0;
            if (turretbody)
            {
                xoff = 10;
                d = instance_create((puddle.x - 60) + xoff, puddle.y + 4, obj_rouxls_splasheffect);
                d.depth = depth - 1;
                d.speed = -2 / global.fps_scale;
            }
            d = instance_create((puddle.x - 30) + xoff, puddle.y + 4, obj_rouxls_splasheffect);
            d.depth = depth - 1;
            d.speed = (turretbody ? -1.33 : -1) / global.fps_scale;
            d = instance_create(puddle.x + xoff, puddle.y + 6, obj_rouxls_splasheffect);
            d.depth = depth - 2;
            d.speed = (turretbody ? 1.33 : 0) / global.fps_scale;
            d = instance_create(puddle.x + 30 + xoff, puddle.y + 4, obj_rouxls_splasheffect);
            d.depth = depth - 1;
            d.speed = 2 / global.fps_scale;
            submerged = 1;
        }
        if (y > (remy - 10))
        {
            thrash.drawfeet = 0;
        }
        if (y <= (remy - 4))
        {
            y += (4 / global.fps_scale);
            thrash.wsiner -= 0.8 / global.fps_scale;
        }
        else
        {
            y = remy;
            x = remx;
            thrashcon = 0;
            thrashmode = 0;
            thrash.wsinerrate = 0.8;
            advancespeed = 8;
            returnspeed = 6;
        }
    }
    if (thrashcon == 7)
    {
        if (thrashtimer == 50)
        {
            snd_play(snd_pombark);
            thrash.a = 1;
        }
        if (thrashtimer < 75)
        {
            thrashtimer += (1 / global.fps_scale);
            thrash.wsiner -= 0.8 / global.fps_scale;
        }
        else
        {
            x = remx;
            thrashcon = 6;
            thrash.moving = 0;
            returnease = 0;
            thrashtimer = 0;
        }
    }
}
if (scr_debug())
{
    draw_set_color(c_white);
    if (instance_exists(obj_battletester))
    {
        var debugstring = ""[B] turn thrash debug on/off"";
        if (thrash.dbselect == 1)
        {
            debugstring += ""#up/down/shift: change thrash parts#1-3/Numpad7-9 for specific attacks#4/Numpad 5 for random attack#0/Numpad 0 for random machine"";
        }
        scr_debug_print_persistent(debugstring);
    }
    if (keyboard_check_pressed(ord(""N"")))
    {
        thrashmode++;
    }
    if (thrashmode >= 2)
    {
        thrashmode = 0;
    }
    if (thrashmode == 0)
    {
        thrash.drawfeet = thrash.dbselect;
    }
}
");

Apply("gml_Object_obj_rouxls_enemy_Step_0", @"if (global.monster[myself] == 1)
{
    if (scr_isphase(""enemytalk"") && talked == 0)
    {
        scr_randomtarget();
        global.typer = 50;
        if (attackorder == 3)
        {
            attackorder = 0;
        }
        if (attackorder == 0)
        {
            rr = 1;
        }
        if (attackorder == 1)
        {
            rr = 2;
        }
        if (attackorder == 2)
        {
            rr = 0;
        }
        attackorder++;
        if (rr == 0)
        {
            if (duckmode)
            {
                msgsetloc(0, ""Fly, mine Duckie! Fly!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_19_0"");
            }
            else
            {
                msgsetloc(0, ""Go forth,&my caravan!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_22_0"");
            }
            chosenattack = 1;
        }
        else if (rr == 1)
        {
            msgsetloc(0, ""Solveth my puzzleth,&yon Maties!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_28_0"");
            chosenattack = 2;
        }
        else if (rr == 2)
        {
            msgsetloc(0, ""Thrashst off&the Porthbow!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_33_0"");
            chosenattack = 0;
        }
        talkedcon = 0;
        talktimer = 0;
        ralseitalks = 0;
        if (ballooncount == 0)
        {
            msgsetloc(0, ""The Rouxls&(pronounced Rules)&art Simple!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_42_0"");
            ballooncon = 1;
        }
        if (ballooncount == 1)
        {
            if (hasplayerplacedhouses == 0 && global.monsterhp[myself] != global.monstermaxhp[myself])
            {
                msgsetloc(0, ""O-oweth! The houses,&thoust fool! THE&HOUSES!!!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_45_0"");
            }
            else
            {
                msgsetloc(0, ""Soon, Victorie&will be Mineth,&and Queene will&maketh me her&Left Hande Man.../%"", ""obj_rouxls_enemy_slash_Step_0_gml_46_0"");
            }
        }
        if (ballooncount == 2)
        {
            if (hasplayerplacedhouses == 0 && global.monsterhp[myself] != global.monstermaxhp[myself])
            {
                msgsetloc(0, ""STOP HITTINGETH&ME AND PLAYETH&MY MINI-GAME,&YOU ROGUES!!!/%"", ""obj_rouxls_enemy_slash_Step_0_gml_50_0"");
            }
            else
            {
                msgsetloc(0, ""Umm,&Mr. Kaard?&What happens&if WE win?/%"", ""obj_rouxls_enemy_slash_Step_0_gml_51_0"");
                ralseitalks = 1;
