    c_msgsetloc(0, ""\\EI* Since then^1, year after year^1, I've been number 1 in the class./%"", ""obj_ch2_scene19c_slash_Step_0_gml_356_0"");
    c_talk_wait();
    c_var_instance(noelleoutline, ""x"", 63);
