    }
}
");

Apply("gml_Object_obj_npc_castle_cliff_Create_0", @"con = -1;
sinerx = 0;
sinery = 0;
siner0 = 0;
siner_add0 = 0.2;
siner_amplitude0 = 0;
siner_direction0 = 0;
siner1 = 0;
siner_add1 = 0.2;
siner_amplitude1 = 5;
siner_direction1 = 90;
sfx = false;
shine = -4;
remove_shine = false;
if (global.plot >= 10)
{
    if (scr_armorcheck_equipped_party(7) == 0 && scr_armorcheck_inventory(7) == 0 && scr_weaponcheck_inventory(7) == 0 && global.charweapon[2] != 7)
    {
