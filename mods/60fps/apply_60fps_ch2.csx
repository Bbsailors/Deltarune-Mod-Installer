        if (x < minx)
        {
            stop = 1;
        }
        if (x > maxx)
        {
            stop = 1;
        }
        if (contimer > contimermax)
        {
            stop = 1;
        }
        if (stop == 1)
        {
            hspeed = 0;
            sprite_index = choose(dsprite, dsprite, spr_lancer_ut_flip);
            image_speed = 0.25 / global.fps_scale;
            alarm[0] = round(30 * global.fps_scale);
