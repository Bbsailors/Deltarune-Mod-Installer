Apply("gml_Object_o_coaster_jama_Step_0", @"if (type == 0)
{
    if (con == 0)
    {
        if (chancer == 1)
        {
            sprite_index = spr_coaster_barricade_alt;
        }
        contimer += (1 / global.fps_scale);
        flashtimer += (1 / global.fps_scale);
        if (flashtimer == 2)
        {
            if (image_alpha == 0)
            {
                image_alpha = 1;
            }
            else
            {
                image_alpha = 0;
            }
            flashtimer = 0;
        }
        if (contimer >= waitamount && image_alpha == 1)
        {
            con = 1;
        }
    }
    if (con == 1)
    {
        hspeed = -2 / global.fps_scale;
        gravity_direction = 180;
        gravity = 0.5 / (global.fps_scale * global.fps_scale);
        con = 2;
    }
    if (con == 2)
    {
        if (x <= -20)
        {
            instance_destroy();
        }
    }
}
if (type == 1)
{
    contimer += (1 / global.fps_scale);
    if (contimer >= waitamount)
    {
        active = 0;
        image_alpha -= (0.1 / global.fps_scale);
        if (image_alpha <= 0)
        {
