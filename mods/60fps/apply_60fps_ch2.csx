        image_index = 1;
    }
    if (con == 51)
    {
        global.interact = 1;
    }
    if (con == 51 && !d_ex())
    {
        global.interact = 1;
        con = 52;
        doortimer = 0;
    }
    if (con == 52)
    {
        doortimer += (1 / global.fps_scale);
        if (doortimer >= 6)
        {
            snd_free_all();
            snd_play(snd_doorclose);
            dark_marker = scr_dark_marker(__view_get(e__VW.XView, 0) - 10, __view_get(e__VW.YView, 0) - 10, spr_pixel_white);
            with (dark_marker)
            {
                image_xscale = 700;
                image_yscale = 700;
                depth = -100;
                image_blend = c_black;
            }
            con = 53;
            doortimer = 0;
        }
    }
    if (con == 53)
    {
        doortimer += (1 / global.fps_scale);
        if (doortimer >= 30)
        {
            global.facing = 0;
            con = 54;
            snd_play(snd_dooropen);
            global.interact = 3;
            instance_create(0, 0, obj_persistentfadein);
            global.entrance = 23;
            room_goto(door_destination);
        }
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_shrinktangle_Step_0", @"if (playercrush == 1)
{
    exit;
}
if (init == 0)
{
    depth = obj_growtangle.depth;
    obj_growtangle.image_alpha = 0;
    obj_battlesolid.image_xscale = 3;
    obj_battlesolid.image_yscale = 3;
    init = 1;
}
if (global.turntimer <= 30 && (global.turntimer % 2) >= 1 && instance_exists(obj_sneo_splitbouncer))
{
    destroytimer -= (1 / global.fps_scale);
    if (destroytimer <= 0)
    {
        var spouncer = instance_find(obj_sneo_splitbouncer, 0);
        d = instance_create(spouncer.x, spouncer.y, obj_animation_dx);
        d.sprite_index = spr_thrash_missile_explosion;
        d.image_speed = 1 / global.fps_scale;
        d.image_xscale = spouncer.size;
        d.image_yscale = spouncer.size;
        destroytimer = spouncer.size;
        instance_destroy(spouncer);
    }
}
if (sizeup > 0)
{
    top -= (2 / global.fps_scale);
    if (top < maxtop)
    {
        top = maxtop;
    }
    bottom += (2 / global.fps_scale);
    if (bottom > maxbottom)
    {
        bottom = maxbottom;
    }
    left -= (2 / global.fps_scale);
    if (left < maxleft)
    {
        left = maxleft;
    }
    right += (2 / global.fps_scale);
    if (right > maxright)
    {
        right = maxright;
    }
    sizeup -= (2 / global.fps_scale);
}
if ((bottom - top) < 10 || (right - left) < 10)
{
    if ((bottom - top) < 10)
    {
        var centerpoint = (top + bottom) / 2;
        top = centerpoint - 2;
        bottom = centerpoint + 2;
        obj_heart.y = centerpoint - 4;
    }
    else
    {
        var centerpoint = (left + right) / 2;
        left = centerpoint - 2;
        right = centerpoint + 2;
        obj_heart.x = centerpoint - 4;
    }
    playercrush = 1;
    damage = 0;
    for (i = 0; i < instance_number(obj_sneo_splitbouncer); i++)
    {
        d = instance_find(obj_sneo_splitbouncer, i);
        damage += power(d.size, 3);
        dm = instance_create(d.x, d.y, obj_animation_dx);
        dm.sprite_index = spr_realisticexplosion;
        dm.image_speed = 1 / global.fps_scale;
        dm.image_xscale = d.size / 3;
        dm.image_yscale = d.size / 3;
    }
    if (target != 3)
    {
        scr_damage();
    }
    else if (target == 3)
    {
        damage = ceil(damage / 3);
        scr_damage_all();
    }
    snd_play(snd_badexplosion);
    instance_destroy(obj_sneo_splitbouncer);
    if (global.turntimer > 30)
    {
        global.turntimer = 30;
    }
}
");

