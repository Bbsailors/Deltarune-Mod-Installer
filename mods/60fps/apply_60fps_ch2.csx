    c_msgsetloc(0, ""\\E6* A world where we'll ALWAYS be number 1 and number 2!!!/%"", ""obj_ch2_scene19c_slash_Step_0_gml_399_0"");
    c_talk_wait();
    c_var_instance(sb_controller, ""berdly_smart"", false);
