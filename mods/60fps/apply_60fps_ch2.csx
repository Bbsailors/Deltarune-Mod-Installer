                hspeed = 45 / global.fps_scale;
            }
        }
        else
        {
            hspeed += (4 / (global.fps_scale * global.fps_scale));
            if (hspeed > 30)
            {
                hspeed = 30 / global.fps_scale;
            }
        }
    }
    if (nitro == 1)
    {
        hspeed += (8 / (global.fps_scale * global.fps_scale));
        if (hspeed > 60)
        {
            hspeed = 60 / global.fps_scale;
        }
    }
    smoketimer += 2;
    if (smoketimer >= 3)
    {
        smoketimer = 0;
    }
    if (x >= (camerax() + 200))
    {
        con = 2;
    }
    if (damaged == 1)
    {
        con = 5;
        hspeed = -48 / global.fps_scale;
        if (nitro == 1)
        {
            hspeed = -200 / global.fps_scale;
        }
    }
}
if (con == 2)
{
    if (damaged == 1)
    {
        con = 5;
    }
    if (hspeed >= -6)
    {
        hspeed -= (2 / (global.fps_scale * global.fps_scale));
    }
    if (nitro == 1)
    {
        hspeed -= (1 / (global.fps_scale * global.fps_scale));
        if (x >= (camerax() + 400) && hspeed > 0)
        {
            hspeed = -2 / global.fps_scale;
        }
    }
    if (x <= (xstart + 10))
    {
        damaged = 0;
        hspeed = 0;
        siner = 0;
        con = 0;
    }
}
if (con == 5)
{
    hspeed = -30 / global.fps_scale;
    if (nitro == 1)
    {
        hspeed = -100 / global.fps_scale;
    }
    if (x <= (xstart - hspeed))
    {
        hspeed = 0;
        damaged = 0;
        siner = 0;
        con = 0;
    }
}
mykeybuffer -= 1;
if (gooffscreen == 2)
{
    if (HeroID == 0)
    {
        x -= 2;
    }
}
");

