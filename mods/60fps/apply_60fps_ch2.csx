Apply("gml_Object_obj_cybercity_bg_carbridge_Draw_0", @"if (dontdraw == 0)
{
    if (type == 0)
    {
        draw_sprite_ext(sprite_index, 0, x, y, 2, 2, 0, c_white, 1);
        timer += (1 / global.fps_scale);
        for (i = 0; i < count; i++)
        {
            myx = ((timer * 4) + (i * 50)) % 152;
            myy = -sin(myx / 36) * 10;
            draw_sprite_ext(spr_traffic_car_side_legs_small, timer / 4, x + myx, y + myy, 2, 2, 0, c_white, 1);
        }
    }
    if (type == 1)
    {
        draw_sprite_ext(sprite_index, 0, x, y, 2, 2, 0, c_white, 1);
        if (movemode == 0)
        {
            timer += (1 / global.fps_scale);
            image = timer / 4;
        }
        if (movemode == 1)
        {
            image = 0;
            btimer += (1 / global.fps_scale);
            timeradd = (sin(btimer / 3) * 1.2) + 0.8;
            if (timeradd > -0.6)
            {
                timer += (timeradd / global.fps_scale);
            }
            if (timeradd < 0.4)
            {
                image = 0;
            }
            else
            {
                image = 1;
            }
            image = timer / 8;
        }
        for (i = 0; i < count; i++)
        {
            myx = ((timer * 4) + (i * 60)) % 236;
            myy = (-sin(myx / 60) * 10) + 10;
            if (orientation == ""r"")
            {
                draw_sprite_ext(spr_traffic_car_side_legs_small, image, (x + myx) - 40, y + myy, 2, 2, 0, c_white, 1);
            }
            if (orientation == ""l"")
            {
                draw_sprite_ext(spr_traffic_car_side_legs_small, image, (x - myx) + 240, y + myy, -2, 2, 0, c_white, 1);
            }
        }
    }
}
else
{
    if (type == 0)
    {
        draw_sprite_ext(sprite_index, 0, x, y, 2, 2, 0, c_white, 1);
    }
    if (type == 1)
    {
        draw_sprite_ext(sprite_index, 0, x, y, 2, 2, 0, c_white, 1);
    }
}
if (extflag == ""big3Right"")
{
    draw_sprite_ext(spr_dw_city_big_3_caroverlay_right, 0, x, y - 10, 2, 2, 0, c_white, 1);
}
");

Apply("gml_Object_obj_cybercity_bg_lightset_Draw_0", @"timer += (1 / global.fps_scale);
minitimer += (1 / global.fps_scale);
minitimerthreshold = 2;
timerthreshold = 12;
for (i = 0; i < l; i++)
{
    if (mode < 2)
    {
        yscale[i] = lerp(yscale[i], 0, scr_fps_lerp_rate(0.06));
        if (yscale[i] > 0)
        {
            yscale[i] -= 0.02 / global.fps_scale;
        }
    }
    if (mode == 2 && minitimer >= minitimerthreshold)
    {
        barsiner[i] += 1 / global.fps_scale;
        yscale[i] = (0.6 * h) + (sin(barsiner[i] / 2) * 0.3 * h) + (sin(barsiner[i] / 3) * 0.1 * h);
    }
    if (mode == 0)
    {
        if (yscale[i] < (0.8 * h))
        {
            if (floor(random(12)) == 0)
            {
                yscale[i] = 1 * h;
            }
        }
    }
    if (mode == 1)
    {
        if (timer >= timerthreshold)
        {
            yscale[i] = min(yscale[i] + random(0.5 * h), 1 * h);
        }
    }
