Apply("gml_Object_obj_holemouse_generator_Step_0", @"if (mousecreate == 1)
{
    doorstate = 0;
}
if (mousecreate == 0)
{
    doorstate = 1;
}
if (image_index <= 1)
{
    gentimer -= (1 / global.fps_scale);
}
if (gentimer <= 0)
{
    mousecreate = 0;
}
if ((gentimer % 5) == 1 && mousecreate == 1 && closed == 0)
{
    instance_create(x, y, obj_holemouse);
}
if (doorstate == 0)
{
    desIndex -= (1 / global.fps_scale);
}
if (doorstate == 1)
{
    desIndex += (1 / global.fps_scale);
}
desIndex = clamp(desIndex, 0, 5);
image_index = desIndex;
");

Apply("gml_Object_obj_holemouse_lottery_Step_0", @"if (con == 0)
{
    image_alpha += (0.25 / global.fps_scale);
    y += (4 / global.fps_scale);
    if (image_alpha >= 1.5)
    {
        image_alpha = 1;
        con = 1;
        y = ystart + 40;
    }
}
if (con == 1 && !d_ex())
{
    timer += (1 / global.fps_scale);
    if (timer >= 2)
    {
        if (direction == 90 || direction == 270)
        {
            if (direction == 90)
            {
                if (place_meeting(x, y - 40, obj_solidblock))
                {
                    direction = 0;
                    x += 40;
                }
                else
                {
                    direction = 90;
                    y -= 40;
                }
            }
            if (direction == 270)
            {
                if (place_meeting(x, y + 40, obj_solidblock))
                {
                    direction = 0;
                    x += 40;
                }
                else
                {
                    direction = 270;
                    y += 40;
                }
            }
        }
        else if (place_meeting(x, y - 40, obj_solidblock) && place_meeting(x, y + 40, obj_solidblock))
        {
            direction = 0;
            x += 40;
        }
        else if (!place_meeting(x, y - 40, obj_solidblock))
        {
            direction = 90;
            y -= 40;
        }
        else if (!place_meeting(x, y + 40, obj_solidblock))
        {
            direction = 270;
            y += 40;
        }
        movex = 0;
        movey = 0;
        timer = 0;
    }
}
if (con == 2)
{
    depth += 1;
    y -= (4 / global.fps_scale);
    image_alpha -= (0.25 / global.fps_scale);
    deathtimer += (1 / global.fps_scale);
    if (deathtimer >= 3)
    {
        instance_destroy();
    }
}
");

