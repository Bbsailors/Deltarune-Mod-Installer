Apply("gml_Object_obj_mainchara_Step_0", @"scr_depth();
wallcheck = 0;
nowx = x;
nowy = y;
if (press_d == 0 && press_l == 0 && press_u == 0 && press_r == 0)
{
    nopress = 1;
}
press_l = 0;
press_r = 0;
press_d = 0;
press_u = 0;
bkx = 0;
bky = 0;
bkxy = 0;
jelly = 2;
if (!roomenterfreezeend)
{
    if (global.interact == 3)
    {
        if (global.flag[21] > 0)
        {
            global.flag[21] -= 1 / global.fps_scale;
        }
        else
        {
            roomenterfreezeend = 1;
            global.interact = 0;
            global.flag[21] = -10;
        }
    }
}
if (global.interact == 0)
{
    if (button3_p() && threebuffer < 0)
    {
        if (global.flag[7] == 0 && battlemode == 0 && swordmode == 0)
        {
            with (obj_darkcontroller)
            {
                threebuffer = 2;
            }
            with (obj_overworldc)
            {
                movenoise = 1;
                threebuffer = 2;
            }
            global.menuno = 0;
            global.interact = 5;
            threebuffer = 2;
            twobuffer = 2;
        }
    }
}
if (swordcon == 1)
{
    swordtimer += (1 / global.fps_scale);
    if (swordtimer >= 15)
    {
        with (slashmarker)
        {
            instance_destroy();
        }
        swordcon = 0;
        swordsprite = rsprite;
        fun = 0;
        if (global.interact == 4)
        {
            global.interact = 0;
        }
        swordtimer = 0;
        image_speed = 0;
        image_index = 0;
        image_alpha = 1;
    }
}
if (global.interact == 0)
{
    if (global.flag[11] == 1)
    {
        if (button2_h() && twobuffer < 0)
        {
            run = 0;
        }
        else
        {
            run = 1;
        }
    }
    else if (button2_h() && twobuffer < 0)
    {
        run = 1;
    }
    else
    {
        run = 0;
    }
    if (autorun > 0)
    {
        if (autorun == 1)
        {
            run = 1;
            runtimer = 200;
        }
        if (autorun == 2)
        {
            run = 1;
            runtimer = 50;
        }
    }
    if (run == 1)
    {
        if (darkmode == 0)
        {
            wspeed = bwspeed + (1 / global.fps_scale);
            if (runtimer > 10)
            {
                wspeed = bwspeed + (2 / global.fps_scale);
            }
            if (runtimer > 60)
            {
                wspeed = bwspeed + (3 / global.fps_scale);
            }
        }
        if (darkmode == 1)
        {
            wspeed = bwspeed + (2 / global.fps_scale);
            if (runtimer > 10)
            {
                wspeed = bwspeed + (4 / global.fps_scale);
            }
            if (runtimer > 60)
            {
                wspeed = bwspeed + (5 / global.fps_scale);
            }
        }
    }
    if (run == 0)
    {
        wspeed = bwspeed;
    }
    if (left_h())
    {
        press_l = 1;
    }
    if (right_h())
    {
        press_r = 1;
    }
    if (up_h())
    {
        press_u = 1;
    }
    if (down_h())
    {
        press_d = 1;
    }
    px = 0;
    py = 0;
    pressdir = -1;
    if (global.stick_mag > 0 && global.flag[960] >= 1)
    {
        var _maxc = max(abs(global.stick_lx), abs(global.stick_ly));
        if (global.flag[960] == 1)
        {
            px = (global.stick_lx / _maxc) * global.stick_mag * wspeed;
            py = (global.stick_ly / _maxc) * global.stick_mag * wspeed;
        }
        else
        {
            px = (global.stick_lx / _maxc) * wspeed;
            py = (global.stick_ly / _maxc) * wspeed;
        }
        if (abs(global.stick_lx) >= abs(global.stick_ly))
        {
            if (global.stick_lx > 0)
            {
                pressdir = 1;
            }
            else
            {
                pressdir = 3;
            }
        }
        else if (global.stick_ly > 0)
        {
            pressdir = 0;
        }
        else
        {
            pressdir = 2;
        }
    }
    else
    {
        if (press_r == 1)
        {
            px = wspeed;
            pressdir = 1;
        }
        if (press_l == 1)
        {
            px = -wspeed;
            pressdir = 3;
        }
        if (press_d == 1)
        {
            py = wspeed;
            pressdir = 0;
        }
        if (press_u == 1)
        {
            py = -wspeed;
            pressdir = 2;
        }
    }
    if (global.stick_mag > 0 && global.flag[960] >= 1)
    {
        if (pressdir != -1 && abs(abs(global.stick_lx) - abs(global.stick_ly)) > (global.stick_mag * 0.15))
        {
            global.facing = pressdir;
        }
    }
    else
    {
        if (nopress == 1 && pressdir != -1)
        {
            global.facing = pressdir;
        }
        if (global.facing == 2)
        {
            if (press_d == 1)
            {
                global.facing = 0;
            }
            if (press_u == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 0)
        {
            if (press_u == 1)
            {
                global.facing = 2;
            }
            if (press_d == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 3)
        {
            if (press_r == 1)
            {
                global.facing = 1;
            }
            if (press_l == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 1)
        {
            if (press_l == 1)
            {
                global.facing = 3;
            }
            if (press_r == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
    }
    if (press_r == 1)
    {
        swordfacing = 1;
    }
    if (press_l == 1)
    {
        swordfacing = -1;
    }
    if (swordmode == 1)
    {
        if (button1_p() && swordcon == 0 && global.interact == 0)
        {
            global.interact = 4;
            swordsprite = rsprite;
            slashmarker = scr_dark_marker(x, y, rsprite);
            slashmarker.depth = depth;
            slashmarker.image_speed = 1 / global.fps_scale;
            if (swordfacing == -1)
            {
                slashmarker.x += sprite_width;
                slashmarker.image_xscale = -image_xscale;
            }
            image_alpha = 0;
            fun = 1;
