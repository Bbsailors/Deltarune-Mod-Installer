        {
            attacktimer += (1 / global.fps_scale);
            attack_succeeded = 1;
            if (attacktimer >= ((45 / f) - ((attack_succeeded * 45) / f)))
            {
                speed = 0;
                image_index = 0;
                image_speed = 0;
                attackcon = 0;
                attack_succeeded = 0;
                event_user(1);
            }
        }
    }
}
