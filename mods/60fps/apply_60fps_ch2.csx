Apply("gml_Object_obj_city_cyberballoon_mouse_Step_0", @"if (falling == 1)
{
    if (d_ex())
    {
        if (paused == 0)
        {
            remvspeed = vspeed;
            remx = x;
            remy = y;
            paused = 1;
        }
        setxy(remx, remy);
    }
    else
    {
        if (paused == 1)
        {
            vspeed = remvspeed;
            paused = 0;
        }
        vspeed += (0.4 / (global.fps_scale * global.fps_scale));
        vspeed = clamp(vspeed, 0, 8 / global.fps_scale);
    }
