    xoffset[0] -= 3 / global.fps_scale;
    yoffset[0] -= 4 / global.fps_scale;
    xoffset[1] += 3 / global.fps_scale;
    yoffset[1] -= 4 / global.fps_scale;
    xoffset[2] += 3 / global.fps_scale;
    yoffset[2] += 4 / global.fps_scale;
    xoffset[3] -= 3 / global.fps_scale;
    yoffset[3] += 4 / global.fps_scale;
    for (i = 0; i < 4; i += 1)
    {
        draw_sprite_ext(sprite_index, 1 + i, x + xoffset[i], y + yoffset[i], image_xscale, image_yscale, image_angle, c_white, image_alpha);
    }
}
");

