        }
        with (obj_battlecontroller)
        {
            skipvictory = 1;
        }
    }
    if (endtime == 30)
    {
        snd_free(global.batmusic[0]);
        o_coaster_berdly.xshake = 10;
        o_coaster_berdly.sprite_index = spr_cutscene_17_berdly_shocked;
        if (instance_exists(obj_ch2_scene11a))
        {
