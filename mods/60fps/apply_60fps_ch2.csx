        global.msg[2] = stringsetloc(""* This is truly a tremendous cake^1.&* Use its power wisely.../%"", ""obj_npc_hammerguy_slash_Step_0_gml_155_0"");
        mydialoguer = instance_create(0, 0, obj_dialoguer);
