{
}
else
{
    with (obj_mainchara)
    {
        roomenterfreezeend = 1;
    }
}
if (doorPreset > 0)
{
    if (doorPreset == 1)
    {
        doorDelay = 14;
        doorPostDelay = 6;
        doorSound = snd_dooropen;
        doorSound2 = snd_doorclose;
    }
    else if (doorPreset == 2)
    {
        doorDelay = 16;
        doorPostDelay = 6;
        doorSound = snd_escaped;
    }
}
if (doorFadeMusic)
{
    alarm[3] = round(doorFadeMusicTime * global.fps_scale);
    mus_volume(global.currentsong[1], 0, doorFadeMusicTime);
    if (doorDelay <= doorFadeMusicTime)
    {
        doorDelay = doorFadeMusicTime + 1;
    }
}
if (doorDelay > 0)
{
    alarm[2] = round(doorDelay * global.fps_scale);
}
if (doorSound != -1)
{
    snd_play(doorSound);
}
if (i_ex(obj_fadeout))
{
    var off = 0;
    if (os_type == os_macosx)
    {
        off = 1;
    }
    if (alarm[2] > 0)
    {
        obj_fadeout.fadespeed = global.fps_scale / (alarm[2] - off);
    }
}
with (obj_overworldbulletparent)
{
    active = 0;
}
");

Apply("gml_Object_obj_doorw_musfade_Other_19", @"global.interact = 3;
mus_volume(global.currentsong[1], 0, 14);
instance_create(0, 0, obj_fadeout);
if (touched == 0)
{
    alarm[2] = round(15 * global.fps_scale);
    alarm[3] = round(14 * global.fps_scale);
    event_user(8);
    touched = 1;
}
");

Apply("gml_Object_obj_dummyenemy_Draw_0", @"if (state == 3)
{
    global.monsterstatus[myself] = 1;
    if (global.monstercomment[myself] == "" "")
    {
        global.monstercomment[myself] = ""(Tired)"";
    }
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        if (global.monster[myself] == 0)
        {
        }
        hurtshake += 1;
        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= (1 / global.fps_scale);
            }
            if (shakex < 0)
            {
                shakex += (1 / global.fps_scale);
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(sprite_index, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
    }
}
if (state == 0)
{
    siner += (1 / global.fps_scale);
    thissprite = sprite_index;
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        thissprite = sprite_index;
    }
    draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
        d3d_set_fog(true, c_white, 0, 1);
        draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
        d3d_set_fog(false, c_black, 0, 0);
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
");

