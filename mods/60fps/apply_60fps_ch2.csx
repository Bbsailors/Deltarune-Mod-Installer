}
if (instance_exists(obj_sneo_lilguy_bullet))
{
    if (distance_to_object(instance_nearest(x, y, obj_sneo_lilguy_bullet)) < dist)
    {
        target = instance_nearest(x, y, obj_sneo_lilguy_bullet);
