Apply("gml_Object_obj_bgattack_piece_Create_0", @"image_yscale = 0;
image_xscale = 0;
xrange = 0;
vspeed = 0.1 / global.fps_scale;
gravity = 0.02 / (global.fps_scale * global.fps_scale);
init = 0;
depth = o_boxingcontroller.depth + 1;
animtimer = 0;
flip = 1;
create_hitbox = 0;
rep = 2;
