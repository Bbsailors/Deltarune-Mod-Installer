Apply("gml_Object_obj_ch2_scene26_cityscape_Draw_0", @"var cx = camera_get_view_x(view_camera[0]);
var cy = camera_get_view_y(view_camera[0]);
var vw = view_wport[0];
var vh = view_hport[0];
siner += (1 / global.fps_scale);
drawx = (cx * -0.125) + xstart;
drawy = (room == room_dw_mansion_prefountain) ? ((cy * -0.125) + 620) : ((cy + ystart) - 80);
if (auto_scroll)
{
    x_offset -= (0.5 / global.fps_scale);
}
if (auto_scroll_y)
{
    auto_scroll_y_timer += (1 / global.fps_scale);
    y_offset -= (0.75 / global.fps_scale);
    if (auto_scroll_y_timer >= 30)
    {
        auto_scroll_y = false;
    }
}
scr_draw_sprite_tiled_area(spr_mansion_ferris_wheel_bg, 0, drawx + x_offset, drawy + y_offset, drawx + x_offset, drawy, room_width, drawy + y_offset + vh, 1, 1, c_white, 1);
if (show_laser_outline)
{
    if (reveal_pos < 0)
    {
        reveal_pos = cx;
    }
    if (!cityscape_reveal)
    {
        reveal_pos += (16 / global.fps_scale);
        if (reveal_pos >= (cx + vw))
        {
            cityscape_reveal = true;
        }
        gpu_set_blendenable(false);
        gpu_set_colorwriteenable(false, false, false, true);
        draw_set_alpha(0);
        draw_rectangle(reveal_pos, 0, cx + vw, cy + vh, false);
        draw_set_alpha(1);
        gpu_set_blendenable(true);
        gpu_set_colorwriteenable(true, true, true, true);
        gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
        gpu_set_alphatestenable(true);
        scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, 1);
        gpu_set_alphatestenable(false);
        gpu_set_blendmode(bm_normal);
    }
    else
    {
        scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, main_alpha);
    }
}
if (show_laser_beam)
{
    if (beam_offset < 60)
    {
        beam_offset += (4 / global.fps_scale);
    }
    if (show_laser_hand && hand_alpha > 0)
    {
        hand_alpha -= (0.1 / global.fps_scale);
    }
    else
    {
        show_laser_hand = false;
    }
    gpu_set_blendenable(false);
    gpu_set_colorwriteenable(false, false, false, true);
    draw_set_alpha(0);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape_mask, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, main_alpha);
    draw_rectangle(drawx, cy + 190, cx + vw, cy + vh, false);
    draw_set_alpha(1);
    gpu_set_blendenable(true);
    gpu_set_colorwriteenable(true, true, true, true);
    gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
    gpu_set_alphatestenable(true);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_beam_big, 0, (cx + (vw / 2)) - beam_offset, cy, (cx + (vw / 2)) - beam_offset, cy, cx + (vw / 2) + beam_offset, cy + 200, 1, 1, c_white, 1);
    d3d_set_fog(false, c_black, 0, 0);
    gpu_set_alphatestenable(false);
    gpu_set_blendmode(bm_normal);
}
if (show_mini_fountains)
{
    if (mini_alpha < 1)
    {
        mini_alpha += (0.1 / global.fps_scale);
    }
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, mini_alpha);
    gpu_set_blendenable(false);
    gpu_set_colorwriteenable(false, false, false, true);
    draw_set_alpha(0);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape_mask, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, mini_alpha);
    draw_rectangle(drawx, cy + 190, cx + vw, cy + vh, false);
    draw_set_alpha(1);
    gpu_set_blendenable(true);
    gpu_set_colorwriteenable(true, true, true, true);
    gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
    gpu_set_alphatestenable(true);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_beam_big, 0, kris_screen.x - 2, cy, kris_screen.x - 2, cy, kris_screen.x + 2, cy + 210, 1, 1, c_white, mini_alpha);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_beam_big, 0, sus_screen.x - 2, cy, sus_screen.x - 2, cy, sus_screen.x + 2, cy + 210, 1, 1, c_white, mini_alpha);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_beam_big, 0, no_screen.x - 2, cy, no_screen.x - 2, cy, no_screen.x + 2, cy + 210, 1, 1, c_white, mini_alpha);
    d3d_set_fog(false, c_black, 0, 0);
    gpu_set_alphatestenable(false);
    gpu_set_blendmode(bm_normal);
}
if (mini_cityscape)
{
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, main_alpha);
}
if (tender_goodbye)
{
    siner += (1 / global.fps_scale);
    if (!tender_fly)
    {
        sinery = sin(siner / 20) * 4;
    }
    else
    {
        sinery -= (10 / global.fps_scale);
    }
    if (tender_reveal_pos < 0)
    {
        snd_play(snd_magicsprinkle);
        tender_reveal_pos = (cx + (vw / 2)) - sprite_get_width(byebye_sprite);
    }
    if (!tender_reveal)
    {
        tender_reveal_pos += (8 / global.fps_scale);
        if (tender_reveal_pos >= (cx + (vw / 2) + (sprite_get_width(byebye_sprite) * 2)))
        {
            tender_reveal = true;
        }
    }
    gpu_set_blendenable(false);
    gpu_set_colorwriteenable(false, false, false, true);
    draw_set_alpha(0);
    draw_rectangle(tender_reveal_pos, cy + 40 + sinery, cx + (vw / 2) + (sprite_get_width(byebye_sprite) * 2), cy + 40 + (sprite_get_height(byebye_sprite) * 2) + sinery, false);
    draw_set_alpha(1);
    gpu_set_blendenable(true);
    gpu_set_colorwriteenable(true, true, true, true);
    gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
    gpu_set_alphatestenable(true);
    draw_sprite_ext(byebye_sprite, 0, (cx + (vw / 2)) - sprite_get_width(byebye_sprite), cy + 40 + sinery, 2, 2, 0, c_white, 0.8 + (sin(siner / 8) * 0.2));
    gpu_set_alphatestenable(false);
    gpu_set_blendmode(bm_normal);
}
if (tender_cancel)
{
    siner += (1 / global.fps_scale);
    if (tender_cancel_pos < 0)
    {
        tender_cancel_pos = (cx + (vw / 2)) - sprite_get_width(byebye_sprite) - 10;
    }
    tender_cancel_pos += (16 / global.fps_scale);
    if (tender_cancel_pos >= (cx + (vw / 2) + sprite_get_width(byebye_sprite) + 10))
    {
        tender_timer -= (1 / global.fps_scale);
        if (tender_timer <= -30)
        {
            tender_fly = true;
        }
    }
    if (!tender_fly)
    {
        sinery = sin(siner / 20) * 4;
    }
    else
    {
        sinery -= (10 / global.fps_scale);
        if (sinery <= -200)
        {
            tender_goodbye = false;
            tender_cancel = false;
        }
    }
    gpu_set_blendenable(false);
    gpu_set_colorwriteenable(false, false, false, true);
    draw_set_alpha(0);
    draw_rectangle(tender_cancel_pos, sinery + cy + 50 + (sprite_get_height(byebye_sprite) / 2), cx + (vw / 2) + sprite_get_width(byebye_sprite) + 10, cy + 120 + (sprite_get_height(spr_cutscene_27_tender_cancelled) * 2) + sinery, false);
    draw_set_alpha(1);
    gpu_set_blendenable(true);
    gpu_set_colorwriteenable(true, true, true, true);
    gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
    gpu_set_alphatestenable(true);
    draw_set_color(c_red);
    draw_rectangle((cx + (vw / 2)) - sprite_get_width(byebye_sprite) - 10, cy + 50 + (sprite_get_height(byebye_sprite) / 2) + sinery, cx + (vw / 2) + sprite_get_width(byebye_sprite) + 10, cy + 50 + (sprite_get_height(byebye_sprite) / 2) + 4 + sinery, false);
    draw_set_color(c_white);
    draw_sprite_ext(spr_cutscene_27_tender_cancelled, 0, (cx + (vw / 2)) - sprite_get_width(spr_cutscene_27_tender_cancelled), cy + 120 + sinery, 2, 2, 0, c_white, 0.9 + (sin(siner / 8) * 0.1));
    gpu_set_alphatestenable(false);
    gpu_set_blendmode(bm_normal);
}
if (show_hands)
{
    draw_sprite_ext(spr_cutscene_26_laser_hand_right, 0, hand_right_xpos, cy + 80, 2, 2, 0, c_white, 1);
    gpu_set_blendenable(false);
    gpu_set_colorwriteenable(false, false, false, true);
    draw_set_alpha(0);
    scr_draw_sprite_tiled_area(spr_cutscene_26_laser_cityscape_mask, 0, drawx, drawy, drawx, drawy, room_width, room_height, 1, 1, c_white, knife_alpha);
    draw_rectangle(drawx, cy + 190, cx + vw, cy + vh, false);
    draw_set_alpha(1);
    gpu_set_blendenable(true);
    gpu_set_colorwriteenable(true, true, true, true);
    gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
    gpu_set_alphatestenable(true);
    draw_sprite_ext(spr_cutscene_26_laser_knife, 0, (cx + (vw / 2)) - sprite_get_width(spr_cutscene_26_laser_knife), knife_ypos, 2, 2, 0, c_white, 1);
    d3d_set_fog(false, c_black, 0, 0);
    gpu_set_alphatestenable(false);
    gpu_set_blendmode(bm_normal);
}
");

Apply("gml_Object_obj_ch2_scene26_cityscape_Step_0", @"if (fade_away)
{
    if (main_alpha > 0)
    {
        main_alpha -= (0.1 / global.fps_scale);
    }
    else
    {
        fade_away = false;
        beam_offset = 0;
        show_laser_outline = false;
        show_laser_beam = false;
    }
}
if (show_lightners)
{
    show_lightners = false;
    kris_screen = instance_create(camerax() + screen_offset, cameray() + 80, obj_queenscreen);
    kris_screen.image_index = 38;
    kris_screen.aligned = 1;
    sus_screen = instance_create(camerax() + (screen_offset * 2), cameray() + 80, obj_queenscreen);
    sus_screen.image_index = 39;
    sus_screen.aligned = 1;
    no_screen = instance_create(camerax() + (screen_offset * 3), cameray() + 80, obj_queenscreen);
    no_screen.image_index = 7;
    no_screen.aligned = 1;
}
if (merge_lightners)
{
    make_new = true;
    merge_lightners = false;
    beam_offset = 0;
    with (kris_screen)
    {
        scr_move_to_point_over_time(other.sus_screen.x, other.sus_screen.y, other.merge_timer);
    }
    with (no_screen)
    {
        scr_move_to_point_over_time(other.sus_screen.x, other.sus_screen.y, other.merge_timer);
    }
}
if (make_new)
{
    merge_timer -= (1 / global.fps_scale);
    if (merge_timer <= 0)
    {
        make_new = false;
        fade_screens = true;
        show_mini_fountains = false;
        main_alpha = 1;
        beam_offset = 0;
        show_laser_beam = true;
        show_laser_outline = true;
    }
}
if (fade_screens)
{
    screen_alpha -= (0.1 / global.fps_scale);
    with (obj_queenscreen)
    {
        image_alpha = other.screen_alpha;
    }
    if (screen_alpha <= 0)
    {
        fade_screens = false;
        with (obj_queenscreen)
        {
            instance_destroy();
        }
    }
}
if (show_hands)
{
    if (!hand_init)
    {
        hand_init = true;
        hand_right_xpos = camerax() + view_wport[0];
    }
    if (hand_both_reveal)
    {
        hand_right_xpos = lerp(hand_right_xpos, camerax() + (view_wport[0] / 2) + 60, scr_fps_lerp_rate(0.2));
        if (hand_right_xpos <= (camerax() + (view_wport[0] / 2) + 60))
        {
            hand_both_reveal = false;
            hand_both_reveal_finish = true;
        }
    }
    if (knife_reveal)
    {
        knife_alpha = lerp(knife_alpha, 1, scr_fps_lerp_rate(0.2));
        knife_ypos = lerp(knife_ypos, 10, scr_fps_lerp_rate(0.2));
        if (knife_ypos >= 9)
        {
            knife_reveal = false;
            knife_hover = true;
        }
    }
    if (knife_hover)
    {
        knife_siner += (0.075 / global.fps_scale);
        knife_ypos = 10 + (sin(knife_siner / 0.65) * 5);
    }
    if (knife_stab)
    {
        knife_hover = false;
        stab_timer += (0.05 / global.fps_scale);
        knife_ypos = lerp_ease_ext(knife_ypos, 200, true, false, stab_timer, -1);
        if (stab_timer >= 0.5 && !hand_retreat)
        {
            hand_retreat = true;
        }
        if (stab_timer >= 1)
        {
            stab_timer = 0;
            knife_stab = false;
            show_laser_beam = true;
        }
    }
    if (hand_retreat)
    {
        retreat_timer += (0.05 / global.fps_scale);
        hand_right_xpos = lerp_ease_ext(hand_right_xpos, camerax() + view_wport[0], true, false, retreat_timer, 4);
        if (retreat_timer >= 1)
        {
            retreat_timer = 0;
            hand_retreat = false;
            show_hands = false;
        }
    }
}
");

Apply("gml_Object_obj_ch2_scene26_gigaqueen_Step_0", @"if (release)
{
    if (!head_init)
    {
        head_init = true;
    }
    if (head_x_pos < 0)
    {
        head_x_pos = (camerax() + (view_wport[0] / 2)) - sprite_get_width(spr_cutscene_26_queen_giga_head);
    }
    if (head_y_pos == -1)
    {
        head_y_pos = cameray() + view_hport[0] + 100;
    }
    head_y_pos = clamp(head_y_pos - (10 / global.fps_scale), cameray() - 15, cameray() + view_hport[0] + 100);
    if (head_y_pos <= (cameray() - 15))
    {
        release = false;
    }
}
if (release_fast)
{
    head_y_pos = clamp(head_y_pos - (35 / global.fps_scale), cameray() - 15, cameray() + view_hport[0] + 100);
    if (head_y_pos <= (cameray() - 15))
    {
        release_fast = false;
    }
}
if (leave)
{
    head_y_pos = clamp(head_y_pos + (10 / global.fps_scale), cameray() - 15, cameray() + view_hport[0] + 100);
    if (head_y_pos >= (cameray() + view_hport[0] + 100))
    {
        leave = false;
    }
}
if (leave_fast)
{
    head_y_pos = clamp(head_y_pos + (30 / global.fps_scale), cameray() - 15, cameray() + view_hport[0] + 100);
    if (head_y_pos >= (cameray() + view_hport[0] + 100))
    {
        leave = false;
    }
}
if (laugh)
{
    animsiner += (1 / global.fps_scale);
    if (pilot_alpha == 0)
    {
        pilot_alpha = 1;
    }
    head_sprite = damaged ? spr_cutscene_27_queen_laugh_damaged : spr_cutscene_26_queen_giga_head_laugh;
    anim_index = animsiner / 4;
}
else
{
    animsiner = 0;
    anim_index = 0;
}
if (surprised)
{
    surprised = false;
    head_sprite = spr_cutscene_27_queen_shock_damaged;
    pilot_alpha = 0;
    if (!damaged)
    {
        head_sprite = spr_cutscene_27_queen_giga_surprise;
    }
}
if (unhappy)
{
    unhappy = false;
    head_sprite = spr_cutscene_26_queen_giga_head_unhappy;
    pilot_sprite = spr_cutscene_26_queen_pilot;
    pilot_alpha = 1;
}
if (static_start)
{
    static_start = false;
    head_sprite = spr_cutscene_27_queen_look_down_damaged;
    pilot_alpha = 0;
    static_happened = true;
    my_static = instance_create(252, 123, obj_ch2_queen_static);
    with (my_static)
    {
        scr_depth();
    }
    crack = scr_dark_marker(my_static.x, my_static.y, spr_cutscene_27_queen_static_googles_crack);
    crack.depth = my_static.depth - 100;
}
if (static_stop)
{
    static_stop = false;
    static_start = false;
    static_happened = false;
    pilot_alpha = 1;
    if (i_ex(obj_ch2_queen_static))
    {
        instance_destroy(obj_ch2_queen_static);
        instance_destroy(crack);
    }
}
if (damagedfx)
{
    smoketimer += (1 / global.fps_scale);
    if (smoketimer >= 3)
    {
        smoke = instance_create(head_x_pos + 300, head_y_pos + 120, obj_afterimage_grow);
        smoke.depth = depth + 200;
        smoke.sprite_index = spr_cakesmoke;
        smoke.gravity = -0.5 / (global.fps_scale * global.fps_scale);
        smoke.image_alpha = 2;
        smoke.hspeed = random(2) / global.fps_scale;
        smoke.image_xscale = 2;
        smoke.image_yscale = 2;
        smoke.visible = 1;
        smoke = instance_create(head_x_pos + 330, head_y_pos + 180, obj_afterimage_grow);
        smoke.depth = depth + 200;
        smoke.sprite_index = spr_cakesmoke;
        smoke.gravity = -0.5 / (global.fps_scale * global.fps_scale);
        smoke.image_alpha = 1.6;
        smoke.hspeed = (random(2) + 2) / global.fps_scale;
        smoke.image_xscale = 0;
        smoke.image_yscale = 0;
        smoke.visible = 1;
        smoketimer = 0;
    }
    if (climb > 0)
    {
        shaketimer = 0;
    }
    else
    {
        shaketimer += (1 / global.fps_scale);
    }
    if (shaketimer == 53)
    {
        smoke = instance_create(head_x_pos + 240, head_y_pos + 180, obj_afterimage_grow);
        smoke.depth = depth - 10;
        smoke.sprite_index = spr_plugboy_spare_electricity;
        smoke.hspeed = -2 / global.fps_scale;
        smoke.gravity = -0.5 / (global.fps_scale * global.fps_scale);
        smoke.image_alpha = 1.6;
        smoke.hspeed = 0;
        smoke.image_xscale = 0;
        smoke.image_yscale = 0;
        smoke.visible = 1;
    }
    if (shaketimer >= 55 && shaketimer <= 60)
    {
        head_x_pos = rem_head_x_pos + random_range(2, -2);
        head_y_pos = rem_head_y_pos + random_range(1, -1);
    }
    if (shaketimer == 61)
    {
        shaketimer = 0;
    }
}
if (climb == 1)
{
    if (!head_init)
    {
        head_init = true;
    }
    climbtimer += (1 / global.fps_scale);
    if (climbtimer == 1)
    {
        rem_head_y_pos = head_y_pos;
    }
    if (climbtimer == 2)
    {
        scr_lerpvar_instance(id, ""head_y_pos"", rem_head_y_pos, rem_head_y_pos - 120, 30, -3, ""out"");
    }
    if (climbtimer == 10)
    {
        var deepsnd = snd_play(snd_closet_impact);
        snd_pitch(deepsnd, 0.5);
        instance_create(0, 0, obj_shake);
    }
    if (climbtimer == 40)
    {
        climbtimer = 0;
        climb = 0;
        rem_head_y_pos = head_y_pos;
    }
}
");

Apply("gml_Object_obj_ch2_scene26_henshin_flash_Draw_0", @"siner += (1 / global.fps_scale);
orb_sin = sin(siner) * 2;
var _duration = 75;
if (siner <= _duration)
{
    beam_size = lerp(2, 20, scr_ease_out(siner / _duration, 5));
    beam_speed = lerp(0, 550, scr_ease_out(siner / _duration, 4));
    orb_size = lerp(0, 60, scr_ease_out(siner / _duration, 5));
}
else
{
    orb_size += (0.5 / global.fps_scale);
}
for (i = 0; i < 4; i++)
{
    var _beam_final_dir = beam_dir[i] + (beam_rot[i] * beam_speed);
    scr_draw_beam(x, y, 600, beam_size, _beam_final_dir, c_white, 1, 0);
}
draw_circle(x, y, orb_size + orb_sin, 0);
");

