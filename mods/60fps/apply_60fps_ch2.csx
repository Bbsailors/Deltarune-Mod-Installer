    global.flag[36] = 0;
    global.flag[37] = 0;
    global.flag[38] = 0;
    global.flag[39] = 0;
    global.flag[60] = 0;
    global.flag[61] = 0;
    con = 0;
    global.interact = 0;
    global.facing = 0;
}
");

