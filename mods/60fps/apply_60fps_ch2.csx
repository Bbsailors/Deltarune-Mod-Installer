    firstwave = 2;
}
else if (firstwave == 2)
{
    speed = 0;
    fadetimer = 50;
    firstwave = -1;
}
else if (timer >= 0)
{
    speed = -(-3.5 + (sin((timer + 15.707963267948966) / 10) * 3.5)) / global.fps_scale;
    if (middespawn && traveldistance < 110)
    {
        speed /= 2;
    }
}
traveldistance += speed;
timer += (1 / global.fps_scale);
");

Apply("gml_Object_obj_berdlyb_tornado_old_Draw_0", @"if (init && image_alpha < 1)
{
    if (middespawn)
