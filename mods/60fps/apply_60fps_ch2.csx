        scr_anyface_next(""susie"", 17);
        msgnextloc(""\\EH* The hell would I want this for!?/%"", ""obj_npc_room_slash_Other_10_gml_2628_0"");
    }
    if (global.flag[325] == 2)
    {
        scr_anyface_next(""ralsei"", 2);
