    }
    DRAWNAME = 1;
    FIXY = 0;
    EVENT = 74;
    global.choice = -1;
    CHOICE = instance_create(100, 100, DEVICE_CHOICE);
    CHOICE.depth = -100;
}
if (EVENT == 74)
{
    if (FIXY < 100)
    {
        FIXY += (2 / global.fps_scale);
    }
    if (global.choice == 0)
    {
        CANCELMENU = 1;
    }
    if (global.choice == 1)
    {
        snd_free_all();
        snd_play(snd_dtrans_lw);
