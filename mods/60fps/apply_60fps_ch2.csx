Apply("gml_Object_obj_clovertail_Step_0", @"if (con == 0)
{
    if (y < (cameray() + 40))
    {
        y = lerp(y, cameray() + 60, scr_fps_lerp_rate(0.2));
    }
    else
    {
        con = 1;
        timer = 0;
    }
}
if (con == 1)
{
    siner += (sineradd / global.fps_scale);
    x = xstart + (sin(siner / 10) * 70);
    image_angle = sin(siner / 6) * 20;
    vspeed = (sin(siner / 4) * 8) / global.fps_scale;
    timer += (1 / global.fps_scale);
    if (timer >= 8)
    {
        timer = 0;
        shot = instance_create(x, y, obj_regularbullet);
        if (i_ex(shot))
        {
            shot.sprite_index = spr_clubsbullet_dark;
            shot.image_angle = -90;
            shot.speed = (6 / global.fps_scale) + (vspeed / 4);
            shot.active = 1;
            shot.image_angle = image_angle - 90;
            shot.direction = image_angle - 90;
            shot.target = target;
            shot.damage = damage;
            shot.grazepoints = 6;
        }
        scr_bullet_inherit(shot);
    }
}
if (con == 2)
{
    if (y > (cameray() - 30))
    {
        y = lerp(y, cameray() - 30, scr_fps_lerp_rate(0.3));
    }
    destroytimer += (1 / global.fps_scale);
    if (destroytimer == 30)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_clovertail_intro_Step_0", @"if (con == 0)
{
    image_xscale += (0.5 / global.fps_scale);
    timer += (1 / global.fps_scale);
    if (timer == 10)
    {
        tail = instance_create(camerax() + 320, 0, obj_clovertail);
        tail.damage = damage;
        tail.target = target;
        con = 1;
        timer = 0;
    }
}
if (global.turntimer <= 5 && instance_exists(obj_clovertail) && obj_clovertail.con == 1)
{
    obj_clovertail.con = 2;
}
if (global.turntimer <= 0 && con == 1)
{
    con = 2;
}
if (con == 2)
{
    image_xscale -= (0.5 / global.fps_scale);
    timer += (1 / global.fps_scale);
    if (timer == 10)
    {
        instance_destroy();
        obj_clubsenemy.notail = 0;
    }
}
");

