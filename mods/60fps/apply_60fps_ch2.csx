Apply("gml_Object_obj_rotationController_track_Step_0", @"if (buffer > -5)
{
    buffer--;
}
if (timer < 999)
{
    timer += (1 / global.fps_scale);
}
if (mytimer > 0)
{
    mytimer--;
}
left = false;
right = false;
down = false;
if (rotate == true)
{
    global.interact = 1;
    if (down_p() && controlled.moving == 0 && !d_ex() && mytimer <= 0 && !i_ex(obj_holemouse) && buffer < 0)
    {
        mytimer = 20;
        buffer = 3;
        with (obj_holemouse_generator)
        {
            cooldown = 10;
            other.controlled.move = 0;
            other.down = true;
            mousecreate = 1;
            gentimer = 20;
        }
    }
    if (obj_holemouse_generator.image_index == 5 && !d_ex() && mytimer <= 0)
    {
        if (left_h())
        {
            buffer = 3;
            controlled.move = -1;
        }
        if (right_h())
        {
            buffer = 3;
            controlled.move = 1;
        }
    }
    if (instance_exists(obj_holemouse) || d_ex() || mytimer > 0)
    {
        controlled.move = 0;
    }
    if ((left_h() && right_h()) || (!left_h() && !right_h()))
    {
        left = false;
        right = false;
        controlled.move = 0;
    }
    if ((button1_p() || button2_p()) && timer > 1 && mytimer <= 0 && !i_ex(obj_holemouse) && !d_ex() && buffer < 0)
    {
        buffer = 3;
        rotate = false;
        controlled.move = 0;
        global.interact = 0;
    }
}
if (controlled.move == 1)
{
    right = true;
}
if (controlled.move == -1)
{
    left = true;
}
controlled.image_index = rotate;
with (obj_holemouse_generator)
{
    if (gentimer > 0)
    {
        other.down = true;
    }
}
");

Apply("gml_Object_obj_rotationTile_track1_Step_0", @"if (init == 0)
{
    tiletype[0] = obj_marker;
    tiletype[1] = obj_holemouse_block_counterclockwise;
    tiletype[2] = obj_marker;
    tiletype[3] = obj_marker;
    tiletype[4] = obj_marker;
    tiletype[5] = obj_holemouse_block_counterclockwise;
    tiletype[6] = obj_marker;
    tiletype[7] = obj_marker;
    tiletype[8] = obj_holemouse_block_counterclockwise;
    tiletype[9] = obj_marker;
    rottype = 0;
    hole = instance_create(x + 40, y + 0, obj_marker);
    tilemax = 9;
    randomseed = floor(random(tilemax));
    for (i = 0; i <= tilemax; i++)
    {
        tile[i] = instance_create(x, y, tiletype[i]);
        with (tile[i])
        {
            scr_mouse_tile_rotation_init();
        }
        randompos = i + randomseed;
        if (randompos > tilemax)
        {
            randompos -= (tilemax + 1);
        }
        tile[i].__currentposition = randompos;
        tile[i].__positionmax = 9;
        with (tile[i])
        {
            __positionx[0] = 0;
            __positiony[0] = 0;
            __positionx[1] = 40;
            __positiony[1] = 0;
            __positionx[2] = 80;
            __positiony[2] = 0;
            __positionx[3] = 80;
            __positiony[3] = 40;
            __positionx[4] = 80;
            __positiony[4] = 80;
            __positionx[5] = 80;
            __positiony[5] = 120;
            __positionx[6] = 40;
            __positiony[6] = 120;
            __positionx[7] = 0;
            __positiony[7] = 120;
            __positionx[8] = 0;
            __positiony[8] = 80;
            __positionx[9] = 0;
            __positiony[9] = 40;
        }
    }
    tilemax++;
    tile[tilemax] = instance_create(x + 40, y, obj_marker);
    ishole[tilemax] = 1;
    with (obj_marker)
    {
        visible = 0;
    }
    visible = 1;
    init = 1;
}
for (i = 0; i <= tilemax; i++)
{
    if (ishole[i] == 0)
    {
        with (tile[i])
        {
            scr_mouse_tile_rotation_step();
        }
    }
}
if (phase == 0)
{
    phase = 1;
}
if (phase == 1)
{
}
if (phase == 2)
{
    if (x > lx)
    {
        x -= (max(4, 10 - (timer / 2)) / global.fps_scale);
    }
    else
    {
        x = lx;
        phase = 3;
    }
}
if (phase == 3)
{
    if (instance_exists(obj_noelle_scared))
    {
        if (obj_noelle_scared.waiting == true)
        {
            falltimer += (1 / global.fps_scale);
        }
    }
}
for (i = 0; i <= tilemax; i++)
{
    if (ishole[i] == 0)
    {
        if (i_ex(tile[i]))
        {
            tile[i].__move = move;
        }
        if (i_ex(tile[i]))
        {
            with (tile[i])
            {
                scr_mouse_tile_rotation_step();
            }
        }
        if (i_ex(tile[i]))
        {
            tilecon = tile[i].__con;
        }
    }
}
if (i_ex(tile[0]))
{
    if (tile[0].__con == 0)
    {
        moving = false;
    }
    else
    {
        moving = true;
    }
}
");

