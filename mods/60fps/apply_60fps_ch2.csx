Apply("gml_Object_obj_npc_dumpster_Step_0", @"if (con == -1)
{
    event_inherited();
}
if (con == 0 && !d_ex())
{
    con = 1;
    event_user(0);
}
if (con == 1 && !d_ex())
{
    con = -1;
}
if (moss_con == 1 && !d_ex())
{
    moss_con = 2;
    alarm[0] = round(30 * global.fps_scale);
    if (shine != -1)
    {
        instance_destroy(shine);
    }
    global.msc = 0;
    global.typer = 6;
    global.fc = 0;
    global.fe = 0;
    global.interact = 1;
    global.flag[920] = 1;
    scr_speaker(""no_name"");
    msgsetloc(0, ""\\s0* You found the \\cG[Moss]\\cW^8! %%"", ""obj_npc_dumpster_slash_Step_0_gml_40_0"");
    d_make();
    snd_play(snd_moss_fanfare);
    snd_pause(global.currentsong[1]);
    scr_script_delayed(snd_resume, 100, global.currentsong[1]);
    with (obj_readable_room1)
    {
        instance_destroy();
    }
}
if (moss_con == 3 && !d_ex())
{
    moss_con = 4;
    alarm[0] = round(30 * global.fps_scale);
    var ateMoss = global.flag[106] == 1;
    var haveSusie = scr_havechar(2);
    var haveNoelle = scr_havechar(4);
    var sentenceEnd = (ateMoss || haveSusie || haveNoelle) ? ""/"" : ""/%"";
    if (ateMoss)
    {
        sentenceEnd = haveNoelle ? ""/"" : ""/%"";
        scr_speaker(""no_name"");
        msgsetsubloc(0, ""* Your title was upgraded to [Moss Finder].~1"", sentenceEnd, ""obj_npc_dumpster_slash_Step_0_gml_63_0"");
        read += 1;
        myinteract = 3;
        mydialoguer = instance_create(0, 0, obj_dialoguer);
    }
    if (haveSusie)
    {
        con = 10;
    }
    if (haveNoelle)
    {
        global.flag[921] = 1;
        var text = stringsetloc(""\\E1* (Why do they look so pleased?)/%"", ""obj_npc_dumpster_slash_Step_0_gml_78_0"");
        if (ateMoss)
        {
            scr_anyface_next(""noelle"", 1);
            msgnext(text);
        }
        else
        {
            scr_speaker(""noelle"");
            msgset(0, text);
        }
        read += 1;
        myinteract = 3;
        mydialoguer = instance_create(0, 0, obj_dialoguer);
    }
}
if (con == 10 && !d_ex())
{
    con = -1;
    if (scr_havechar(2))
    {
        global.flag[922] = 1;
        if (instance_exists(obj_ch2_room_city_moss))
        {
            with (obj_ch2_room_city_moss)
            {
                con = 0;
            }
            read++;
            exit;
        }
    }
}
if (moss_con == 5)
{
    moss_con = 99;
    if (!scr_havechar(2))
    {
        instance_activate_object(obj_readable_room1);
    }
}
");

Apply("gml_Object_obj_npc_facing_Other_10", @"global.msc = 0;
global.typer = 5;
if (global.darkzone == 1)
{
    global.typer = 6;
}
global.fc = 0;
global.fe = 0;
global.interact = 1;
