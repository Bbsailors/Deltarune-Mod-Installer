Apply("gml_Object_obj_npc_rudy_Step_0", @"if (coughcon < 0)
{
    event_inherited();
}
if (coughcon == 0 && !d_ex())
{
    coughcon = 1;
    snd_play(snd_rudycough);
    sprite_index = spr_rudy_cough;
