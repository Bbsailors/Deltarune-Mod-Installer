Apply("gml_Object_obj_rocketpunch_bhero_Draw_0", @"if (drawwhite == 1)
{
    draw_set_color(c_white);
    draw_rectangle(-10, -10, 999, 999, false);
}
if (split == 0)
{
    draw_self();
}
if (split == 1)
{
    splity += ((0.6 - splitfriction) / global.fps_scale);
    if (splitfriction < 0.5)
    {
        splitfriction += (0.01 / global.fps_scale);
    }
    draw_sprite_ext(sprite_index, 16, x + splity, y - splity, image_xscale, image_yscale, 0, c_white, image_alpha);
    draw_sprite_ext(sprite_index, 15, x - splity, y + splity, image_xscale, image_yscale, 0, c_white, image_alpha);
    draw_sprite_ext(headsprite, image_index, x + splity, y - splity, image_xscale, image_yscale, 0, image_blend, image_alpha);
    draw_set_blend_mode(bm_normal);
    draw_sprite_ext_glow(headsprite, image_index, x + splity, y - splity, image_xscale, image_yscale, 0, c_white, image_alpha, c_white);
    draw_set_blend_mode(bm_add);
    draw_sprite_ext_glow(headsprite, image_index, x + splity, y - splity, image_xscale, image_yscale, 0, headcolor, image_alpha, c_white);
    draw_set_blend_mode(bm_normal);
}
");

Apply("gml_Object_obj_rocketpunch_bhero_Step_0", @"if (y <= (((room_height / 2) + 180) - 620) && con == 0)
{
    with (obj_rocketpunch_fist)
    {
        instance_destroy();
    }
    con = 1;
    vspeed = 0;
    image_index = 8;
    shakeamt = 18;
    remx = x;
    remy = y;
    fade = instance_create(x, y, o_bq_whitefade);
    fade.dont_fade_out = 1;
    fade.depth = 800;
    alarm[0] = round(60 * global.fps_scale);
}
if (con == 1)
{
    split = 1;
    image_xscale += (shakeamt / 100 / global.fps_scale);
    image_yscale += (shakeamt / 100 / global.fps_scale);
    drawwhite = 1;
    x = remx + random_range(-shakeamt, shakeamt);
    y = remy + random_range(-shakeamt, shakeamt);
    if (shakeamt > 0)
    {
        shakeamt -= (0.8 / global.fps_scale);
    }
    else
    {
        shakeamt = 0;
    }
}
");

Apply("gml_Object_obj_rocketpunch_fist_Step_0", @"if (con >= 1 && timer < 4)
{
    timer = 4;
}
timer += (1 / global.fps_scale);
if (timer == 5)
{
    timer = 0;
    gas = instance_create(x, y, obj_rocketpunch_afterimage);
    if (con >= 1)
    {
        gas.vspeed = -16 / global.fps_scale;
    }
}
if (con == 1)
{
    con = 2;
    timerb = 0;
    snd_play(snd_rocket_long);
    snd_play(snd_bomb);
}
if (con == 2)
{
    timerb += (1 / global.fps_scale);
    x = lerp(x, (320 - (sprite_width / 2)) + 50 + 10, scr_fps_lerp_rate(0.2));
    y = lerp(y, -420 + timerb, scr_fps_lerp_rate(0.2));
    x += (random_range(-4, 4) / global.fps_scale);
    y += (random_range(-4, 4) / global.fps_scale);
    if (timerb == 60)
    {
        instance_create((320 - (sprite_width / 2)) + 10, 100, obj_rocketpunch_bhero);
    }
    if (timerb == 74)
    {
        snd_play(snd_explosion);
    }
    if (timerb >= 10)
    {
        image_xscale = lerp(image_xscale, 4, scr_fps_lerp_rate(0.04));
        image_yscale = lerp(image_yscale, 4, scr_fps_lerp_rate(0.04));
    }
}
");

