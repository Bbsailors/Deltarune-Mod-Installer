    c_facenext(""lancer"", ""3"");
    c_msgnextloc(""\\E3* Don't cry^1, chicken-nugget-man./"", ""obj_ch2_scene19c_slash_Step_0_gml_427_0"");
    c_msgnextloc(""\\E2* All of us are idiots^1, too./%"", ""obj_ch2_scene19c_slash_Step_0_gml_428_0"");
