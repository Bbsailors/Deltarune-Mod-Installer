                        image_yscale = other.image_yscale + 0.2;
                        image_alpha = other.image_alpha;
                        image_blend = other.image_blend;
                        spriteWidthRoot = other.spriteWidthRoot;
                        spriteHeightRoot = other.spriteHeightRoot;
                        cutOff = other.cutOff;
                        master = other.master;
                        posY = y - master.y;
                    }
                    instance_destroy();
                }
            }
        }
    }
}
