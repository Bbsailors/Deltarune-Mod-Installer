            stop_custom_effect();
        }
    }
}
if (con == 2)
{
    timer += (1 / global.fps_scale);
    if (timer == 15)
    {
        scr_lerpvar(""fadeamt"", 1, 0, 60);
        snd_volume(whitenoise, 0, 60);
