                shakex += (1 / global.fps_scale);
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(spr_enemy1_hurt, 0, x + shakex, y, 2, 2, turnt, image_blend, 1);
    }
}
if (state == 0)
{
