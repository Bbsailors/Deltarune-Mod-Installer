Apply("gml_Object_obj_credits_ch3_Step_0", @"if (scr_debug())
{
}
if (timer == 0)
{
    snd_free_all();
    song0 = snd_init(""ch2_credits.ogg"");
    song1 = mus_play(song0);
}
if (!paused)
{
    timer += (1 / global.fps_scale);
}
if (timer == 100)
{
    credit_index++;
}
if (timer == 201)
{
