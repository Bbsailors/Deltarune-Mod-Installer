        draw_sprite_part(spr_gameshow_stage_fire, 0, 0, i * thickness, 400, thickness + 2, 255 + (sin((wave_siner + (i * 8)) / 30) * 12), (i * thickness) + flameya + (sin(flamesiner / 16) * 3));
