Apply("gml_Object_obj_dozer_parts_Step_0", @"if (!immune)
{
    with (obj_susiezilla_gamecontroller)
    {
        if (gameover)
        {
            exit;
        }
    }
}
timer += (1 / global.fps_scale);
v_speed += (personal_gravity / global.fps_scale);
h_speed *= power(0.99, 1 / global.fps_scale);
y += (v_speed / global.fps_scale);
x += (h_speed / global.fps_scale);
if (y >= ground)
{
    v_speed *= -0.5;
    y = ground;
}
if (timer > flash_start)
{
    flash = true;
}
if (timer > endme)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_dummyenemy_Draw_0", @"if (state == 3)
{
    global.monsterstatus[myself] = 1;
    if (global.monstercomment[myself] == "" "")
    {
        global.monstercomment[myself] = ""(Tired)"";
    }
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        if (global.monster[myself] == 0)
        {
        }
        hurtshake += 1;
        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= (1 / global.fps_scale);
            }
            if (shakex < 0)
            {
                shakex += (1 / global.fps_scale);
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(sprite_index, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
    }
}
if (state == 0)
{
    siner += (1 / global.fps_scale);
    thissprite = sprite_index;
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        thissprite = sprite_index;
    }
    draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
        d3d_set_fog(true, c_white, 0, 1);
        draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
        d3d_set_fog(false, c_black, 0, 0);
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_dummyenemy_Step_0", @"if (ambushed == 0)
