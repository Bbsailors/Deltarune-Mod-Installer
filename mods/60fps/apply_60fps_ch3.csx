            global.flag[1110] = block.y - byoff;
            debug_message(""block x/y="" + string(global.flag[1109]) + ""|"" + string(global.flag[1110]));
        }
    }
}
if (endcon == 1)
{
    if (obj_b3bs_console.swordinteract == 1)
    {
        endcon = 2;
        global.interact = 1;
        global.msc = 1411;
