            var _subfinalx = screenx() + lengthdir_x(_len, gravity_direction);
            var _subfinaly = screeny() + lengthdir_y(_len, gravity_direction);
            finalx = _subfinalx - (_subfinaly / 2);
        }
    }
    timer += (1 / global.fps_scale);
    if (timer >= 40 && !split)
    {
        timer = 0;
