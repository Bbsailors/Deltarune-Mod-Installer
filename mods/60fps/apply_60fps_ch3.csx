            scr_delay_var(""bombgrab"", 3, 12);
        }
    }
    if (bombgrab == 3)
    {
        scr_play_recording(""susie"", ""01010101010101010101"");
        bombgrab = 4;
    }
    if (con < 99 && con > 4)
    {
        if (global.flag[1190] == 0)
        {
            if (obj_board_camera.con != 0)
            {
                con = 99;
            }
        }
    }
    if (con == 6)
    {
        with (obj_mainchara_board)
        {
            if (iframes > 0)
            {
                other.con = 7;
            }
        }
    }
    if (con == 7)
    {
