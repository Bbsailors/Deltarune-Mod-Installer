                scr_pathfind_to_point(""susie"", 9, 5, 2);
            }
            else
            {
                scr_pathfind_to_point(""susie"", 7, 6, 0);
                ralsei.follow = true;
            }
            suwalk = 1;
        }
        if (tetalker == 0)
        {
            tetalker = 1;
            var tetalk = stringsetloc(""Oh, a camera!"", ""obj_b2camera_slash_Step_0_gml_322_0"");
            scr_couchtalk(tetalk, ""ralsei"", 2, 60);
        }
    }
    if (con == 1)
    {
        if (!i_ex(key))
        {
            kris.camera = false;
            con = 2;
        }
    }
}
else
{
