    }
    if (swordbuffer == 7)
    {
        image_index = 0;
    }
    if (swordbuffer == 6)
    {
        image_index = 0;
    }
    if (swordbuffer == 5)
    {
        image_index = 1;
    }
    if (swordbuffer == 4)
    {
        image_index = 1;
    }
    if (swordbuffer == 3)
    {
        image_index = 1;
    }
    if (swordbuffer == 2)
