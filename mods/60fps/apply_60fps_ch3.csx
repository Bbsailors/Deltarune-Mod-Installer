                    ralsei.follow = true;
                }
                if (suwalktimer == 8)
                {
                    scr_pathfind_to_point(""susie"", irandom_range(4, 6), 1, 0);
                    suwalk = 1;
                    susie.sleepy = true;
                }
            }
