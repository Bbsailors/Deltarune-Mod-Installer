draw_sprite_ext(spr_shine_white, shine_anim_b + 0.25, 962, 60, 2, 2, 0, #E8FFC8, 1);
draw_sprite_ext(spr_shine_white, shine_anim_a, 1088, 40, 2, 2, 0, #E8FFC8, 1);
