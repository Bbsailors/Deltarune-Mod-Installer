Apply("gml_Object_obj_shakeobj_Step_0", @"if (active == 0)
{
    instance_destroy();
}
if (active == 1)
{
    if (i_ex(target))
    {
        shakeamt -= (shakereduct / global.fps_scale);
        on *= -1;
        target.x = nowx + (shakeamt * on);
        if (shakeamt <= 0)
        {
            instance_destroy();
        }
    }
    else
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shakeobj_ext_Step_0", @"if (active == 0)
{
    instance_destroy();
}
if (active == 1)
{
    if (i_ex(target))
    {
        timer += (1 / global.fps_scale);
        if (timer >= shakespeed)
        {
            shakexamt -= shakereduct;
            shakeyamt -= shakereduct;
            on *= -1;
            if (shakexamt < 0)
            {
                shakexamt = 0;
            }
            if (shakeyamt < 0)
            {
                shakeyamt = 0;
            }
            target.x = nowx + (shakexamt * on);
            target.y = nowy + (shakeyamt * on);
            if (shakexamt <= 0 && shakeyamt <= 0)
            {
                instance_destroy();
            }
            timer = 0;
        }
    }
    else
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shakeobj_susiezilla_Step_0", @"if (active == 0)
{
    instance_destroy();
}
if (active == 1)
{
    timer += (1 / global.fps_scale);
    if (timepershake == timer)
    {
        timer = 0;
        if (instance_exists(target))
        {
            shakeamt -= shakereduct;
            on *= -1;
            target.x = nowx + (shakespeed * on);
            if (shakeamt <= 0)
            {
                instance_destroy();
            }
        }
        else
        {
            instance_destroy();
        }
    }
}
");

