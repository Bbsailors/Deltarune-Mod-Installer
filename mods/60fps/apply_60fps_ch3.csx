{
    instance_destroy();
}
if (con == 0)
{
    timer += (1 / global.fps_scale);
    image_xscale = lerp(image_xscale, 0.7, scr_fps_lerp_rate(0.2));
    image_yscale = lerp(image_yscale, 0.7, scr_fps_lerp_rate(0.2));
    image_alpha = lerp(image_alpha, 0.5, scr_fps_lerp_rate(0.2));
    if (timer == 30)
    {
        timer = 0;
        con = 1;
