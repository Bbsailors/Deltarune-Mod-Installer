                loss_counter = 0;
                enemy_count = 1;
            }
            snd_play(snd_splat);
            _hit.direction = 0;
            _hit.speed = 24 / global.fps_scale;
            _hit.accel = 0;
            with (obj_susiezilla_gamecontroller)
            {
