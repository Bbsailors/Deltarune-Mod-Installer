Apply("gml_Object_obj_rouxls_laser_pointer_controller_Step_0", @"if (global.turntimer < 1)
{
    instance_destroy();
}
if (con == 1)
{
    recordstring += (""x"" + string(mouse_x) + ""y"" + string(mouse_y) + ""o"");
    recordcount++;
}
if (con == 2)
{
    if (!variable_instance_exists(id, ""__rec_tick""))
    {
        __rec_tick = 0;
    }
    __rec_tick += (1 / global.fps_scale);
    if (__rec_tick >= 1)
    {
        __rec_tick -= 1;
        if (recordcount < string_length(recordstring))
        {
            var setx = false;
            var sety = false;
            var _x = ""0"";
            var _y = ""0"";
            var _end = 0;
            while (_end == 0)
            {
                var _input = string_char_at(recordstring, recordcount);
                recordcount++;
                if (_input == ""x"")
                {
                    setx = true;
                }
                else if (_input == ""y"")
                {
                    setx = false;
                    sety = true;
                }
                else if (_input == ""o"")
                {
                    _end = 1;
                }
                else
                {
                    if (setx == true)
                    {
                        _x += _input;
                    }
                    if (sety == true)
                    {
                        _y += _input;
                    }
                }
                if (recordcount >= string_length(recordstring))
                {
                    _end = 1;
                }
                _mouse_x = real(_x) + camerax();
                _mouse_y = real(_y) + cameray();
            }
        }
        else
        {
            if (recordsave == true && show_question(""Do you want to save the recording?""))
            {
                _string_save = get_string(""Input string file name:"", ""default"");
                ini_open(""laserpointerplayback.ini"");
                ini_write_string(""Laser Pointer Playback Info"", _string_save, recordstring);
                ini_close();
                recordsave = false;
            }
            else
            {
            }
            recordstring = """";
            recordcount = 0;
            con = 0;
        }
    }
}
");

Apply("gml_Object_obj_rouxls_moon_bullet_Step_0", @"if (con == 1)
{
    timer += (1 / global.fps_scale);
    image_alpha += (0.05 / global.fps_scale);
    if (timer == 20)
    {
        timer = 0;
        con = 2;
    }
}
if (con == 2)
{
    timer += (1 / global.fps_scale);
    x = lerp(start_x, target_x, timer / 30);
    y = lerp(start_y, target_y, timer / 30);
    if (timer == 30)
    {
        timer = 0;
        con = 3;
        move_count++;
        start_x = x;
        start_y = y;
        if (move_count == 1)
        {
            target_x = x - 79;
            target_y = y;
        }
        if (move_count == 2)
        {
            target_x = x + 79;
            target_y = y;
        }
        if (move_count == 3)
        {
            target_x = x;
            target_y = y - 79;
        }
    }
}
if (con == 3)
{
    timer += (1 / global.fps_scale);
    if (timer == 26)
    {
        timer = 0;
        con = 2;
    }
}
if (con == 4)
{
    if (i_ex(obj_rouxls_laser_pointer_controller))
    {
        var xx = real(obj_rouxls_laser_pointer_controller._mouse_x);
        var yy = real(obj_rouxls_laser_pointer_controller._mouse_y);
        if (point_distance(x, y, xx, yy) > 10)
        {
            move_towards_point(xx, yy, 2 / global.fps_scale);
        }
        else
        {
            speed = 0;
            alarm[0] = round(30 * global.fps_scale);
        }
    }
    else
    {
        speed = 0;
    }
    if (alarm[0] > 0)
    {
        speed = 0;
    }
}
if (sun == 1 && con > 1)
{
    suntimer += (1 / global.fps_scale);
    var interval = 18;
    if (interval > 0)
    {
        if ((suntimer % interval) == 0)
        {
            if (i_ex(obj_rouxls_laser_pointer_controller))
            {
                var xx = real(obj_rouxls_laser_pointer_controller._mouse_x);
                var yy = real(obj_rouxls_laser_pointer_controller._mouse_y);
                for (n = 3; n < 6; n++)
                {
                    with (scr_fire_bullet(x, y, obj_rouxls_suncloud_bullets, point_direction(x, y, xx, yy), 0.1, spr_sunbolt))
                    {
                        updateimageangle = 1;
                        image_angle = direction;
                        friction = -0.15 / (global.fps_scale * global.fps_scale);
                    }
                }
            }
            else
            {
                var basedir = irandom(360);
                for (n = 3; n < 6; n++)
                {
                    with (scr_fire_bullet(x, y, obj_rouxls_suncloud_bullets, basedir + (120 * (n + (suntimer / interval))) + random(10), 0.1, spr_sunbolt))
                    {
                        updateimageangle = 1;
                        image_angle = direction;
                        friction = -0.15 / (global.fps_scale * global.fps_scale);
                    }
                }
            }
        }
    }
}
if (sun == 0 && con > 1)
{
    if ((timer % 4) == 0)
    {
        grazed = false;
    }
    tilt += (0.2 / global.fps_scale);
    image_angle = sin(tilt) * 18;
    if (timer == 201)
    {
        with (obj_regularbullet)
        {
            if (sprite_index == spr_lanino_moon)
            {
                active = false;
            }
        }
    }
}
");

Apply("gml_Object_obj_rouxls_power_up_orb_Draw_0", @"if (parenttarget != -1 && !i_ex(parenttarget))
{
    instance_destroy();
    exit;
}
if (parenttarget != -1 && i_ex(parenttarget))
{
    xstart = parenttarget.x;
    ystart = parenttarget.y;
}
if (init == 0)
{
    init = 1;
    if (thin)
    {
        lifetime /= 2;
    }
    if (track_target != -4)
    {
        xstart = 0;
        ystart = 0;
    }
    var _distance = random_range(70, 90) * distance_multiplier;
    if (_type == 1)
    {
        _distance = random_range(40, 45);
    }
    xx = xstart + lengthdir_x(_distance, direction);
    x = xx;
    yy = ystart + lengthdir_y(_distance, direction);
    y = yy;
}
if (track_target != -4)
{
    xoff = track_target.x;
    yoff = track_target.y;
}
timer += (1 / global.fps_scale);
if (timer > lifetime)
{
    instance_destroy();
    exit;
}
var _progress = timer / lifetime;
image_alpha = 1;
if (thin)
{
    image_blend = c_white;
    image_yscale = 0.25;
    image_angle = direction;
    draw_self();
    x = lerp(xx, xstart, scr_ease_in(_progress, 2)) + xoff;
    y = lerp(yy, ystart, scr_ease_in(_progress, 2)) + yoff;
}
else
{
    var _drawalpha = draw_get_alpha();
    draw_set_color(image_blend);
    draw_circle(x, y, radius - 2, 0);
    draw_set_alpha(image_alpha);
    x = lerp(xx, xstart, scr_ease_in(_progress, 2)) + xoff;
    y = lerp(yy, ystart, scr_ease_in(_progress, 2)) + yoff;
    draw_circle(x, y, radius, 0);
    if ((radius - 3) > 0)
    {
        draw_set_color(c_white);
        draw_circle(x, y, radius - 2, 0);
    }
    draw_set_alpha(_drawalpha);
    radius = lerp(max_radius, 1, _progress);
}
");

