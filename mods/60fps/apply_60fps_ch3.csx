        if (timerc > 3 && timerc < 19)
        {
            armangle = lerp(armangle, -10, (timerc - 3) / 15);
        }
        if ((i_ex(obj_tenna_minigame_ui) && obj_tenna_minigame_ui.timer > 254) || (i_ex(obj_tenna_zoom) && obj_tenna_zoom.con != 1 && obj_tenna_zoom.minigameinsanity == false))
        {
