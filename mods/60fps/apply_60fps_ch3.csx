pr = daddy.rsprite;
pl = daddy.lsprite;
pu = daddy.usprite;
facing = 0;
allowup = true;
allowdown = true;
allowleft = true;
allowright = true;
memory = 75;
for (i = 0; i < memory; i += 1)
{
    remx[i] = daddy.x;
    remy[i] = daddy.y;
    sliding[i] = 0;
    special[i] = 0;
}
init = 0;
forget = 0;
ignoredepth = 0;
