Apply("gml_Object_obj_funnytext_Step_0", @"if (init == 0)
{
    var playsound = false;
    if (settingb == 0)
    {
        var text_sound = scr_funnytext_get_sound(sprite_index);
        if (text_sound != -4)
        {
            playsound = true;
            typingnoise = text_sound;
        }
    }
