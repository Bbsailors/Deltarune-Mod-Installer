            {
                global.fe = 8;
                global.msg[0] = stringsetloc(""* You've got an item^1!&* That's^1, um^1, great^1, Kris.../%"", ""obj_ralseienemy_slash_Step_0_gml_96_0"");
            }
            if (dial == 1)
            {
                if (plot == 2 && hitdum == 0)
