    if (alarmamt < 5)
    {
        alarmamt = 5;
    }
    with (sidespade[side])
    {
        speed = 11 / global.fps_scale;
    }
    alarm[0] = round(alarmamt * global.fps_scale);
    if (side == 0)
    {
        radius = 80;
    }
    else
    {
