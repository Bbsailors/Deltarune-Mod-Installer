sparedsprite = spr_elnina_idle;
custom_draw_example = 1;
skiptext = false;
con = 0;
animsiner = 0;
talking = false;
talkingframe = 0;
pose = 0;
poseindex = 0;
laughtimer = 0;
hairtufts = 4565;
waist = 930;
rightarm = 1641;
rightarmindex = 0;
head = 4846;
leftarm = 1465;
lefthand = 1660;
skirt = 1715;
