            for (var i = 0; i < 6; i++)
            {
                var fireball = instance_create(mantle.x + centerx(mantle), mantle.y + centery(mantle), obj_shadowmantleFireball_example);
                fireball.speed = 7;
                fireball.direction = i * 60;
