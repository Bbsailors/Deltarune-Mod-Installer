                    }
                    if (sunkus_kb_check_pressed(8))
                    {
                        new_key = 8;
                        control_select_con = 2;
                    }
                    if (sunkus_kb_check_pressed(18))
                    {
                        new_key = 18;
                        control_select_con = 2;
                    }
                    if (os_type == os_windows)
                    {
                        if (string(keyboard_key) == ""91"" || string(keyboard_key) == ""92"")
                        {
                            new_key = -1;
                            control_select_con = 0;
                        }
                    }
                    if (sunkus_kb_check_pressed(13))
                    {
