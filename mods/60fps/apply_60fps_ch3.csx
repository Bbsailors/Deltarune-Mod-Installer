    c_tenna_sprite(spr_tenna_laugh_pose);
    c_wait_box(6);
    c_snd_play(snd_jump);
    c_tenna_preset(0);
    c_sprite(spr_tenna_attack);
    c_var_instance(te_actor, ""x"", 407);
