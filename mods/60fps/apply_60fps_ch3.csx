Apply("gml_Object_obj_board_transition_Step_0", @"if (prefill == 1)
{
    for (i = 0; i < 24; i += 1)
    {
        for (j = 0; j < 16; j += 1)
        {
            tile[i][j] = 1;
        }
    }
    prefill = 0;
}
if (con == 0)
{
    timer = 0;
    con = 1;
}
if (type == 0)
{
    if (con == 1)
    {
        timer += (1 / global.fps_scale);
        if (i_ex(obj_gameshow_swordroute))
        {
            var amt = merge_color(s_curcol, c_black, (tilescovered + 1) / 8);
            obj_gameshow_swordroute.screencolor = amt;
        }
        if (timer >= transitionspeed)
        {
            timer = 0;
            tilescovered += 1;
        }
        if (tilescovered >= 0)
        {
            for (i = 0; i < 24; i += 1)
            {
                tile[i][tilescovered] = 1;
                tile[i][15 - tilescovered] = 1;
                tile[tilescovered][i] = 1;
                tile[23 - tilescovered][i] = 1;
            }
        }
        if (tilescovered >= 8)
        {
            con = 2;
            timer = 0;
        }
    }
    if (con == 2)
    {
        timer += (1 / global.fps_scale);
        if (timer == 1)
        {
            triggered = 1;
        }
        if (timer >= pausetime)
        {
            tilescovered = 8;
            timer = 0;
            con = 3;
        }
    }
    if (con == 3)
    {
        timer += (1 / global.fps_scale);
        if (timer >= transitionspeed)
        {
            timer = 0;
            tilescovered -= 1;
        }
        if (tilescovered >= 0)
        {
            for (i = 13; i >= (tilescovered * 2); i -= 1)
            {
                for (j = 7; j >= tilescovered; j -= 1)
                {
                    tile[i][j] = 0;
                    tile[i][15 - j] = 0;
                    tile[23 - i][j] = 0;
                    tile[23 - i][15 - j] = 0;
                }
            }
        }
        if (tilescovered <= 0)
        {
            con = 4;
            timer = 0;
        }
        var amt = tilescovered / 8;
        if (i_ex(obj_gameshow_swordroute))
        {
            var mynewcolor = -4;
            with (obj_board_screenColorChanger)
            {
                if (distance_to_point(160, 96) < 32)
                {
                    mynewcolor = id;
                    init = 1;
                }
            }
            if (i_ex(mynewcolor))
            {
                obj_gameshow_swordroute.screencolor = merge_color(mynewcolor.image_blend, c_black, amt);
            }
        }
    }
    if (con == 4)
    {
        if (interactResetter == true)
        {
            global.interact = 0;
        }
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_board_treeEnemy_example_Step_0", @"image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.125));
timer += (1 / global.fps_scale);
if (timer >= timertarg)
{
    if (i_ex(obj_heart))
    {
        bul = instance_create(x + 6, y + 14, obj_board_collidebullet);
        bul.sprite_index = spr_board_treeEnemyBullet;
        bul.direction = point_direction(x, y, obj_heart.x + 2, obj_heart.y + 2);
        bul.speed = 2 / global.fps_scale;
        bul.friction = -0.25 / (global.fps_scale * global.fps_scale);
        bul.depth = depth - 10;
        scr_doom(bul, 90);
        timer = 0;
        timertarg = random(30) + 15;
    }
}
if (timer > (timertarg - 5))
{
    image_index = 1;
}
else
{
    image_index = 0;
