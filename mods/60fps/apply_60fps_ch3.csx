}
if (bg_speed_y > -480)
{
    bg_speed_y -= 480;
}
if (!surface_exists(frame_surf))
{
    frame_surf = surface_create(camerawidth(), cameraheight());
}
surface_set_target(frame_surf);
draw_clear_alpha(c_black, 0);
draw_set_blend_mode(bm_normal);
