Apply("gml_Object_obj_deathanim_Step_0", @"if (t == 0)
{
    truew = sprite_get_width(sprite_index);
    trueh = sprite_get_width(sprite_index);
    imgx = image_xscale;
    imgy = image_yscale;
    if (truew >= 50 || trueh >= 50)
    {
        bsize = 8;
    }
    if (truew >= 100 || truew >= 100)
    {
        bsize = 16;
    }
    xs = ceil(truew / bsize);
    ys = ceil(trueh / bsize);
    for (i = 0; i <= xs; i += 1)
    {
        for (j = 0; j <= ys; j += 1)
        {
            bl[i][j] = i * bsize;
            bh[i][j] = j * bsize;
            bx[i][j] = x + (i * bsize * imgx);
            bspeed[i][j] = 0;
            bsin[i][j] = (4 + (j * 3)) - i;
        }
    }
}
if (t >= 1)
{
    if (redup < 10)
    {
        redup += (1 / global.fps_scale);
    }
    image_blend = merge_color(c_white, c_red, redup / 10);
    for (i = 0; i <= xs; i += 1)
    {
        for (j = 0; j <= ys; j += 1)
        {
            if (bsin[i][j] <= 0)
            {
                bspeed[i][j] += (1 / global.fps_scale);
            }
            bx[i][j] += (bspeed[i][j] / global.fps_scale);
            bsin[i][j] -= (1 / global.fps_scale);
        }
    }
}
t += (1 / global.fps_scale);
");

Apply("gml_Object_obj_defeatanim_Step_0", @"g += (1 / global.fps_scale);
if (g >= 15)
{
    t += (1 / global.fps_scale);
}
");

Apply("gml_Object_obj_diagonal_bullet_Step_0", @"timer += (1 / global.fps_scale);
var a = clamp(abs(x - obj_growtangle.x) / 300, 0, 1);
var maxalpha = lerp(1.3, 0, a);
image_alpha = lerp(maxalpha, 0, abs(y - obj_growtangle.y) / 200);
if (timer > 260)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_diagonal_bullet_manager_Step_0", @"timer += (1 / global.fps_scale);
if (timer == rate)
{
    timer = 0;
    var _vspeed = choose(verticalspeed, verticalspeed * -1);
    for (var i = 0; i < bulletcount; i++)
    {
        inst = instance_create(obj_growtangle.x + 300, (obj_growtangle.y - 100) + (gapsize * i), obj_diagonal_bullet);
        inst.hspeed = horizontalspeed / global.fps_scale;
        inst.vspeed = _vspeed / global.fps_scale;
        if (_vspeed > 0)
        {
            inst.y = (inst.y - (bulletcount * gapsize)) + 300;
        }
    }
    rate -= 4;
    if (rate < 8)
    {
        rate = 8;
    }
}
");

