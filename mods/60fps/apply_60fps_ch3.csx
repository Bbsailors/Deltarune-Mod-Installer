            ra_real.y -= 8;
            scr_shakeobj(ra_real);
            snd_play(snd_wing);
            tenna.bounce = 1;
            var tetalk = stringsetloc(""What may be their final words!!"", ""obj_b1_finale_slash_Step_0_gml_141_0"");
            scr_couchtalk(tetalk, ""tenna"", 2, 90);
