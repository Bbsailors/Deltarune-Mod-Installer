Apply("gml_Object_obj_gameover_heart_effect_Step_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
    snd_free_all();
}
if (timer == 30)
{
    image_alpha = 1;
    x = global.heartx;
    y = global.hearty;
    drawbg = true;
}
if (timer == 31)
{
    safe_delete(bg);
}
if (timer == 50)
{
    snd_play(snd_break1);
    sprite_index = spr_heartbreak;
    x -= 2;
}
if (timer == 90)
{
    snd_play(snd_break2);
    image_alpha = 0;
    sh[0] = instance_create(x - 2, y, obj_marker);
    sh[1] = instance_create(x, y + 3, obj_marker);
    sh[2] = instance_create(x + 2, y + 6, obj_marker);
    sh[3] = instance_create(x + 8, y, obj_marker);
    sh[4] = instance_create(x + 10, y + 3, obj_marker);
    sh[5] = instance_create(x + 12, y + 6, obj_marker);
    for (i = 0; i < 6; i += 1)
    {
        with (sh[i])
        {
            direction = random(360);
            speed = 7 / global.fps_scale;
            gravity_direction = 270;
            gravity = 0.2 / (global.fps_scale * global.fps_scale);
            sprite_index = spr_heartshards;
            image_speed = 0.2 / global.fps_scale;
            depth = other.depth - 10;
        }
    }
    if (global.tempflag[3] >= 1)
    {
        timer += (15 / global.fps_scale);
    }
}
if (timer == 140)
{
    instance_create(0, 0, obj_fadeout);
}
if (timer >= 80)
{
    if (button1_p())
    {
        timer += (18 / global.fps_scale);
    }
}
if (timer >= 150)
{
}
if (special == 1)
{
    if (timer >= 210)
    {
        room_goto(room_board_sword_intro);
        instance_create(0, 0, obj_persistentfadein);
    }
}
");

Apply("gml_Object_obj_gameover_init_Step_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
    snd_free_all();
}
if (timer == 30)
{
    with (bg)
    {
        instance_destroy();
    }
    visible = 1;
    x = global.heartx;
    y = global.hearty;
}
if (timer == 31)
{
    sprite_delete(global.screenshot);
}
if (!knight_mode)
{
    if (timer == 50)
    {
        snd_play(snd_break1);
        sprite_index = spr_heartbreak;
        x -= 2;
    }
    if (timer == 90)
    {
        snd_play(snd_break2);
        visible = 0;
        sh[0] = instance_create(x - 2, y, obj_marker);
        sh[1] = instance_create(x, y + 3, obj_marker);
        sh[2] = instance_create(x + 2, y + 6, obj_marker);
        sh[3] = instance_create(x + 8, y, obj_marker);
        sh[4] = instance_create(x + 10, y + 3, obj_marker);
        sh[5] = instance_create(x + 12, y + 6, obj_marker);
        for (i = 0; i < 6; i += 1)
        {
            with (sh[i])
            {
                direction = random(360);
                speed = 7 / global.fps_scale;
                gravity_direction = 270;
                gravity = 0.2 / (global.fps_scale * global.fps_scale);
                sprite_index = spr_heartshards;
                image_speed = 0.2 / global.fps_scale;
            }
        }
        if (global.tempflag[3] >= 1)
        {
            timer += 15;
        }
    }
    if (timer == 140)
    {
        instance_create(0, 0, obj_fadeout);
    }
    if (timer >= 80 && timer < 150)
    {
        if (button1_p())
        {
            Z_COUNT += 1;
        }
        if (Z_COUNT >= 4)
        {
            timer = -999;
            timerb += (1 / global.fps_scale);
            var fade_out = scr_fadeout(30);
            with (fade_out)
            {
                image_blend = c_white;
                depth = -99999999;
            }
            snd_play_x(snd_dtrans_lw, 0.7, 1);
            if (Z_COUNT == 4)
            {
                with (obj_event_manager)
                {
                    trigger_event(UnknownEnum.Value_0, UnknownEnum.Value_13);
                }
            }
        }
    }
}
else if (timer == 80)
{
    scr_lerpvar(""x"", x, 312, 30, 2, ""out"");
    scr_lerpvar(""y"", y, cameray() + 80, 30, 2, ""out"");
}
if (timerb > 0)
{
    timerb += (1 / global.fps_scale);
    if (timerb == 40)
    {
        scr_tempload();
    }
}
if (timer == 150)
{
    if (special == 0)
    {
        room_goto(PLACE_FAILURE);
    }
}

enum UnknownEnum
{
    Value_0,
    Value_13 = 13
}
");

Apply("gml_Object_obj_gameover_minigame_Draw_0", @"with (obj_chefs_scoretxt)
{
    if (room == room_board_1 || room == room_board_2)
    {
        global.interact = 1;
    }
}
if (drawblackbg)
{
    draw_sprite_ext(spr_pxwhite, 0, 0, 0, 640, 480, 0, c_black, drawblackbg);
}
if (init == 0)
{
    instance_deactivate_layer(""OBJECTS_MAIN"");
    global.interact = 1;
    init = 1;
    if (replayversion == true && quitversion == false && replaywin == true)
    {
        if (room == room_dw_susiezilla && scr_flag_get(1220) != 0)
        {
        }
        else
        {
            minigametext = instance_create(x, y - 150, obj_tenna_enemy_minigametext);
            minigametext.mystring = ""GAME CLEAR!"";
            snd_play(snd_crowd_cheer_single);
        }
    }
}
if (con == 0)
{
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        scr_lerpvar(""tone_saturation"", 1, 0.1, 30, 2, ""out"");
        scr_lerpvar(""tone_factor"", 0, 0.5, 30, 2, ""out"");
    }
    if (timer == 2)
    {
        scr_lerpvar(""staticalpha"", 0, 0.015, 15);
    }
    if (timer == 3)
    {
        scr_lerpvar(""grayalpha"", 0, 0.35, 15);
    }
    if (timer == 5 && quitversion == false && replayversion == false)
    {
        tenna = instance_create(camerax() + 320, cameray() + 480 + 280, obj_actor_tenna);
        tenna.depth = depth - 10;
        tenna.auto_depth = 0;
        tenna.dropshadow = true;
        tenna.preset = 2;
    }
    if ((timer == 30 && !i_ex(obj_rhythmgame)) || (timer == 90 && i_ex(obj_rhythmgame)))
    {
        var gameover_state = 0;
        if (room == room_shootout)
        {
            gameover_state = 2;
        }
        else if (room == room_dw_rhythm)
        {
            gameover_state = 1;
        }
        else if (room == room_dw_susiezilla)
        {
            gameover_state = 3;
        }
        else if (room == room_board_1 || room == room_board_2 || room == room_board_3)
        {
            gameover_state = 4;
        }
        if (scr_debug())
        {
        }
        if (replayversion && replaywin == true)
        {
            con = 1;
            timer = 0;
            instance_create(0, 0, obj_round_evaluation);
        }
        if ((replayversion && quitversion) || (replayversion && replaywin == false))
        {
            con = 1;
            timer = 0;
            quitcon = 1;
            mus_volume(global.currentsong[1], 0, 30);
            scr_fadeout(30);
            with (obj_fadeout)
            {
                depth = -9999;
            }
        }
        else if (gameover_state == 0)
        {
            var chef_fail = instance_create_depth(0, 0, 0, obj_gameover_chef);
            chef_fail.gameover_sequence = (scr_flag_get(1089) == 1) ? 1 : 2;
        }
        else if (gameover_state == 1)
        {
            var band_fail = instance_create(0, 0, obj_gameover_band);
            band_fail.gameover_sequence = (scr_flag_get(1096) == 1) ? 1 : 2;
        }
        else if (gameover_state == 2)
        {
            instance_create(0, 0, obj_gameover_cowboy);
        }
        else if (gameover_state == 3)
        {
            instance_create(0, 0, obj_gameover_susiezilla);
        }
        else if (gameover_state == 4)
        {
            with (instance_create(0, 0, obj_gameover_board))
            {
                inbattle = other.inbattle;
            }
        }
    }
}
if (scr_debug())
{
    if (keyboard_check_pressed(vk_numpad0))
    {
        con = 1;
        timer = 0;
    }
}
if (tenna_arrive)
{
    tenna_arrive_timer += (1 / global.fps_scale);
    if (tenna_arrive_timer == 1 && replaywin == false)
    {
        tenna.gravity = -1.5 / (global.fps_scale * global.fps_scale);
    }
    if (tenna_arrive_timer == 19 && replaywin == false)
    {
        tenna.bounce = 1;
        tenna.gravity = 0;
        tenna.vspeed = 0;
    }
    if (tenna_arrive_timer == 30)
    {
        tenna_arrive = false;
        tenna_arrive_timer = 0;
    }
}
if (con == 1 && replayversion && !i_ex(obj_round_evaluation) && quitcon == 0)
{
    mus_volume(global.currentsong[1], 0, 30);
    scr_fadeout(30);
    with (obj_fadeout)
    {
        depth = -9999;
    }
    quitcon = 1;
}
if (con == 1 && !replayversion)
{
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        if (!boardfail)
        {
            scr_lerpvar(""staticalpha"", staticalpha, 1, 60, 2, ""in"");
        }
    }
    if (timer == 8)
    {
        if (!boardfail)
        {
            if (replayversion == false)
            {
                tenna.gravity = 1.5 / (global.fps_scale * global.fps_scale);
            }
            scr_lerpvar(""blackalpha"", 0, 1, 30);
        }
    }
    if (boardfail && timer == 37)
    {
        obj_board_deathevent.con = 9999;
    }
    if (timer == 38)
    {
        if (boardfail)
        {
            instance_destroy();
        }
        else
        {
            countdown = true;
            countdown_timer = 0;
            countdown_text = 3;
            if (room == room_dw_chef)
            {
                countdown_text = 0;
            }
            else
            {
                snd_play_pitch(snd_orchhit, 1);
            }
        }
    }
}
if (sprite_exists(global.screenshot))
{
    var lightColor = 13088418;
    var darkColor = 6242121;
    var is_rhythm_replaywin = room == room_dw_rhythm && replaywin;
    if (!quitversion && !replaywin)
    {
        tone_on(tone_saturation, tone_brightness, tone_factor, darkColor, lightColor);
    }
    if (!is_rhythm_replaywin)
    {
        draw_sprite_ext(global.screenshot, 0, camerax(), cameray(), 1, 1, 0, c_white, 1);
    }
    if (!quitversion && !replaywin)
    {
        tone_off();
    }
    if (!quitversion && !replaywin)
    {
        draw_set_alpha(grayalpha);
        draw_set_color(c_gray);
        ossafe_fill_rectangle(camerax(), cameray(), camerax() + 640, cameray() + 480, 0);
        draw_set_color(c_white);
        draw_set_alpha(1);
        staticindex += (0.25 / global.fps_scale);
        draw_sprite_tiled_ext(spr_static_effect, staticindex - 0.5, 0, 0, 2, 2, c_white, staticalpha);
        draw_sprite_tiled_ext(spr_static_effect, staticindex, 0, 0, 2, 2, c_white, staticalpha);
        draw_set_alpha(blackalpha);
        draw_set_color(c_black);
        ossafe_fill_rectangle(camerax(), cameray(), camerax() + 640, cameray() + 480, 0);
        draw_set_color(c_white);
        draw_set_alpha(1);
    }
    if (countdown)
    {
        countdown_timer += (1 / global.fps_scale);
        if ((countdown_timer % 30) == 0)
        {
            countdown_text--;
            if (countdown_text <= 0)
            {
                if (room != room_dw_chef)
                {
                    snd_play(snd_bell);
                }
                countdown = false;
                retry_game = true;
                exit;
            }
            else
            {
                snd_play_pitch(snd_orchhit, 1 + (orchhit_pitch / 16));
                orchhit_pitch++;
            }
        }
        draw_set_halign(fa_center);
        if (room != room_dw_chef)
        {
            draw_text_ext_transformed(camerax() + (view_wport[0] / 2), (cameray() + (view_hport[0] / 2)) - 50, string(countdown_text), 4, 9999, 6, 6, 0);
        }
        draw_set_halign(fa_left);
    }
    if (retry_game)
    {
        retry_timer += (1 / global.fps_scale);
        if (retry_timer >= 30)
        {
            room_restart();
            global.interact = 0;
            instance_destroy();
            exit;
        }
    }
}
if (quitcon == 1)
{
    quittimer += (1 / global.fps_scale);
    var timetoquit = 32;
    if (os_type == os_macosx)
    {
        if (quittimer >= (timetoquit - 2))
        {
            scr_marker_ext(0, 0, spr_pxwhite, room_width, room_height, undefined, undefined, c_black, -99999);
        }
    }
    if (quittimer == timetoquit)
    {
        snd_free_all();
        inst = instance_create(0, 0, obj_persistentfadein);
        global.interact = 3;
        global.facing = 0;
        if (room == room_dw_susiezilla)
        {
            global.entrance = 2;
        }
        if (room == room_dw_chef)
        {
            global.entrance = 3;
        }
        if (room == room_dw_rhythm)
        {
            global.entrance = 4;
        }
        room_goto(room_dw_ranking_a);
    }
}
");

