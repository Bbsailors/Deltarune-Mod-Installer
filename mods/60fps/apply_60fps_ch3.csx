    with (pippins_block)
    {
        image_xscale = 2;
        image_yscale = 2;
    }
}

unlock_susiezilla = function()
{
    var can_afford = global.flag[1044] >= 500;
    if (can_afford)
    {
        con = 50;
        global.flag[1044] -= 500;
    }
    else
    {
        con = 10;
    }
    with (pippins_marker)
    {
        image_index = 0;
        image_speed = 0;
    }
};
");

