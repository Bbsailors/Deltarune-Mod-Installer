    c_msgnextloc(""* MIKE^1! Show the results OF THE BOARD!!!/%"", ""obj_victory_chef_slash_Step_0_gml_200_0"");
    c_talk();
    c_wait_box(1);
    c_tenna_preset(22);
    c_var_lerp_to_instance(te_actor, ""x"", 407, 8, 2, ""out"");
    c_wait_box(5);
