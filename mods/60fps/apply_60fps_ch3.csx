    {
        snd_stop(snd_board_splash);
        snd_play_x(snd_board_splash, 0.6, 1.4);
    }
    if (tearbuff > 0)
    {
        tearbuff -= (1 / global.fps_scale);
    }
    if (tearbuff <= 0)
    {
        if ((timer % 6) == 0)
        {
            amt--;
        }
    }
    amt = clamp(amt, 0, 42);
    if (amt >= 42)
    {
