            else
            {
                scr_pathfind_to_point(""ralsei"", 8, 1, 0);
            }
        }
    }
    if (rawalk == 2 && kris.iframes <= 0)
    {
        if (scr_board_checklocation(""ralsei"", board_tilex(3), board_tiley(2), 2) || scr_board_checklocation(""ralsei"", board_tilex(8), board_tiley(1), 2))
        {
