    if (y > 700)
    {
        y -= (900 / global.fps_scale);
    }
}
if (movetype == 3)
{
    y = (wally - 60) + (sin(timer / rate) * movespeed);
    x = xstart + (sin(timer / rate / 2) * movespeed * 2);
}
if (movetype == 4)
{
    x = xstart - (sin(timer / amplitude) * xrange);
