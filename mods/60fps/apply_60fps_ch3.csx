if (susie_knight_slash)
{
    susie_knight_slash_timer += (1 / global.fps_scale);
    if (susie_knight_slash_timer >= 1 && susie_knight_slash_timer < (1 + (1 / global.fps_scale)))
    {
        snd_play(snd_jump);
        su_actor.depth = 6000;
        with (su_actor)
        {
            scr_lerpvar(""hspeed"", 0, 20 / global.fps_scale, 5);
            vspeed = -14 / global.fps_scale;
            gravity = 2 / (global.fps_scale * global.fps_scale);
