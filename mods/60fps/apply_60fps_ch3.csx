                movestep = 999;
            }
        }
        else
        {
            endcon = 1;
            movestep = 42069;
        }
    }
    if (shift == ""up"")
    {
        movespeed = 24;
        if (moving != 480)
        {
            moving += (movespeed / global.fps_scale);
            for (var i = 0; i < movealllength; i++)
            {
                with (moveall[i].object_index)
                {
                    y += (other.movespeed / global.fps_scale);
                }
            }
            with (obj_mainchara)
            {
                y += (20 / global.fps_scale);
