    msgset(0, mystring);
    d = d_make();
    d.boxheight = myboxsize;
    d.side = side;
    d.skippable = 1;
    d.zurasu = 0;
    init = 1;
}
timer += (1 / global.fps_scale);
if (timer >= boxlife)
{
    instance_destroy();
}
