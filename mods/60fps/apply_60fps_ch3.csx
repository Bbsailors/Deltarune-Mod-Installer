                mus_volume(global.currentsong[1], getmusvol * global.flag[16], 0);
            }
        }
        if (audchange == 1 && sndbuffer < 0)
        {
            snd_play(snd_noise);
            sndbuffer = round(3 * global.fps_scale) - 1;
            audio_set_master_gain(0, global.flag[17]);
        }
        if (button1_p() && onebuffer < 0)
        {
            se_select = 1;
        }
        if (button2_p() && twobuffer < 0)
        {
            se_select = 1;
        }
        if (se_select == 1)
        {
            selectnoise = 1;
            onebuffer = 2;
            twobuffer = 2;
            global.submenu = 30;
        }
    }
    if (global.submenu == 50)
    {
        if (up_p())
        {
            movenoise = 1;
            global.submenucoord[50] -= 1;
            if (global.submenucoord[50] < 0)
            {
                global.submenucoord[50] = 0;
            }
        }
        if (down_p())
        {
            movenoise = 1;
            global.submenucoord[50] += 1;
            if (global.submenucoord[50] > 5)
            {
                global.submenucoord[50] = 5;
            }
        }
        if (button1_p() && onebuffer < 0)
        {
            onebuffer = 2;
            selectnoise = 1;
            if (global.submenucoord[50] == 0)
            {
                global.flag[960] = (global.flag[960] + 1) % 3;
            }
            if (global.submenucoord[50] == 1)
            {
                global.flag[964] = (global.flag[964] + 1) % 3;
            }
            if (global.submenucoord[50] == 2)
            {
                global.fps_debug = (global.fps_debug == 1) ? 0 : 1;
            }
            if (global.submenucoord[50] == 3)
            {
                global.fps_speed_mode = (global.fps_speed_mode + 1) % 3;
                global.fps_speed_active = 0;
            }
            if (global.submenucoord[50] == 4)
            {
                global.flag[965] = (global.flag[965] == 1) ? 0 : 1;
            }
            if (global.submenucoord[50] == 5)
            {
                global.submenu = 30;
                cancelnoise = 1;
            }
        }
        if (button2_p() && twobuffer < 0)
        {
            twobuffer = 2;
            global.submenu = 30;
            cancelnoise = 1;
        }
    }
    if (global.submenu == 34)
    {
        global.submenucoord[34] += 1 / global.fps_scale;
        if (global.submenucoord[34] == 1)
        {
            snd_free_all();
            var lastfade = instance_create(camerax(), cameray(), obj_fadeout);
            lastfade.fadespeed = 0.05;
            lastfade.x = camerax() - 20;
            lastfade.y = cameray() - 20;
            lastfade.image_xscale *= 3;
            lastfade.image_yscale *= 2;
            lastfade.depth = -900000;
            with (obj_border_controller)
            {
                hide_border(0.05);
            }
        }
        if (global.submenucoord[34] >= 50)
        {
            game_restart_true();
        }
    }
    if (global.submenu == 35)
    {
        control_select_timer = 0;
        control_flash_timer -= (1 / global.fps_scale);
        controls_quitmenu = 0;
        if (!global.is_console)
        {
            gamepad_exists = obj_gamecontroller.gamepad_active;
            gamepad_id = 0;
        }
        if (control_select_con == 1)
        {
            gamepad_accept = -1;
            new_gamepad_key = -1;
            key_accept = -1;
            new_key = -1;
            if (!global.is_console)
