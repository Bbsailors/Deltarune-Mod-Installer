        snd_play_x(snd_board_mantle_dash, 0.4, 1.4);
        with (q2)
        {
            scr_lerpvar(""x"", x, 320, 10, 2, ""out"");
            scr_lerpvar(""y"", y, 150, 10, 2, ""in"");
