                    {
                        kris.cantleave = true;
                        suwalktimer = 0;
                        con = 0.1;
                        timer = 0;
                        susolve = 1;
                    }
                }
            }
            else
            {
                suwalktimer += (1 / global.fps_scale);
                if (suwalktimer == 16)
                {
                    var rand = choose(0, 1, 2);
                    rand = 0;
                    switch (rand)
                    {
                        case 0:
                            scr_pathfind_to_point(""susie"", choose(2, 3, 4), 2, 0);
                            break;
                        case 1:
                            scr_pathfind_to_point(""susie"", choose(8, 9, 10), 5, 0);
                            break;
                        case 2:
                            scr_pathfind_to_point(""susie"", choose(8, 9, 10), 1, 0);
                            break;
                    }
                    susie.sleepy = true;
                }
            }
