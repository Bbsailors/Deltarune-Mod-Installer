                    global.fe = 2;
                    global.msg[0] = stringsetloc(""* .../"", ""obj_ralseienemy_slash_Step_0_gml_195_0"");
                    global.msg[1] = stringsetloc(""* Kris^1, it's um.../"", ""obj_ralseienemy_slash_Step_0_gml_196_0"");
