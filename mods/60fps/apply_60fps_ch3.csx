{
    if (pressinit == 0)
    {
        snd_play_pitch(snd_noise, 1.4);
    }
    pressinit = 1;
    var a = 0;
    for (var i = 0; i < instance_number(obj_board_dungeon3_switch); i++)
    {
        button[i] = instance_find(obj_board_dungeon3_switch, i);
        if (button[i].pressed == true)
