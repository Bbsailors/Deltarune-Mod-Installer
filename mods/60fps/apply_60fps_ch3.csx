        _t.image_xscale = 0.5;
        _t.image_yscale = 0.5;
        _t.fadeSpeed = 0.01;
        _t.depth = depth - count;
        count++;
    }
    if (timer >= 120)
    {
        timer = 0;
        count = 0;
    }
}
