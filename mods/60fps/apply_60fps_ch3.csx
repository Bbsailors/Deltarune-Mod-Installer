                    snd_play(snd_board_splash);
                    instance_destroy();
                }
            }
            global.interact = 0;
            safe_delete(obj_board_writer);
            safe_delete(obj_writer);
            con = 4;
            timer = 0;
        }
    }
    if (suwalk == 0)
