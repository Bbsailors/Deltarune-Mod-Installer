        }
        if (suwalktimer == round(8 * global.fps_scale))
        {
            scr_pathfind_to_point(""susie"", choose(1, 10), 1, 0);
            suwalk = 1;
            susie.sleepy = true;
        }
    }
    if (con == 0 && obj_board_camera.con == 0)
    {
        if (!made)
        {
