    }
}
");

Apply("gml_Object_obj_excblcon_Create_0", @"alarm[0] = round(20 * global.fps_scale);
image_speed = 0.1 / global.fps_scale;
if (global.darkzone == 1)
{
    image_xscale = 2;
    image_yscale = 2;
}
");

Apply("gml_Object_obj_face_Step_0", @"buffer -= 1;
if (buffer < 0)
{
    if (mouthmove == 1 && mouthtimer == 0)
    {
        mouthtimer = 1;
        face_index = 1;
    }
}
if (mouthtimer > 0)
{
    mouthtimer += (rate / global.fps_scale);
}
if (mouthtimer >= 1 && mouthtimer <= 5)
{
    face_index = 1;
}
else
{
    face_index = 0;
}
if (mouthtimer >= 9)
{
    mouthtimer = 0;
    mouthmove = 0;
}
battletimer += (1 / global.fps_scale);
");

