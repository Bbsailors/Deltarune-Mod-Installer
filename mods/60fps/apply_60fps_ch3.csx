        var steps = 12;
        for (var i = 1; i < (steps + 1); i++)
        {
            scr_delay_var(""image_blend"", merge_color(#D8EEC2, c_white, (1 / steps) * i), round(60 / steps) * i);
            scr_delay_var(""fadeamt"", (1 / steps) * i, round(60 / steps) * i);
        }
    }
    if (timer == 92)
    {
        room_goto(room_dw_green_room);
        setinplace = 1;
