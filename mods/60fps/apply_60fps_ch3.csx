}
if (dashcon == 2)
{
    dashtimer += (1 / global.fps_scale);
    if (dashtimer >= 30 && (dashtimer % 2) == 0 && i_ex(obj_shadow_mantle_enemy))
    {
        if (global.shadow_mantle_losses < 7)
        {
            gravity += (0.03 / (global.fps_scale * global.fps_scale));
        }
        else if (global.shadow_mantle_losses < 14)
        {
            gravity += (0.023 / (global.fps_scale * global.fps_scale));
        }
        else
        {
            gravity += (0.017 / (global.fps_scale * global.fps_scale));
        }
        instance_create_depth(x + 16, y + 16, depth + 1, obj_shadow_mantle_groundfire);
    }
    instance_create_depth(x + 16 + lengthdir_x(speed, direction), y + 16 + lengthdir_y(speed, direction), depth - 1, obj_shadow_mantle_dash_hitbox);
    if (y > (cameray() + cameraheight()) || y < (cameray() - 100) || x < (camerax() + 32) || x > (camerax() + camerawidth()))
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shadow_mantle_cloud_Step_0", @"scr_depth_board();
if (i_ex(obj_board_camera))
{
    if (obj_board_camera.con != 0)
    {
        instance_destroy();
    }
}
if (con == 0)
{
    if (frac(timer) == 0)
    {
        if (visible == true)
        {
            visible = false;
        }
        else
        {
            visible = true;
        }
    }
    timer += (1 / global.fps_scale);
    if (timer == 12)
    {
        con = 1;
    }
}
if (con == 1)
{
