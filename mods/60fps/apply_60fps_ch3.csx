if (con == 3)
{
    timer += (1 / global.fps_scale);
    var jumptime = 20;
    var bouncedelay = 10;
    var targx = x + 24;
    var targy = y - 22;
    if (timer == 1)
    {
        snd_play(snd_jump);
        snd_play_delay(snd_noise, jumptime);
        scr_delay_var(""image_index"", 1, jumptime);
        with (obj_mainchara)
        {
            fun = 1;
            cutscene = true;
            sprite_index = spr_kris_jump_ball_fixed;
            image_speed = 0.25 / global.fps_scale;
