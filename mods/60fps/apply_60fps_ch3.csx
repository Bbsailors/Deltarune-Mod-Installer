            msgnextloc(""\\m1\t\t*We used to work the sound in&\tthis town.&\\m3\t... until Queen came around.&\\m2\t(K_K is short for Cakes.)/"", ""obj_shop_ch2_music_slash_Draw_0_gml_547_0"");
