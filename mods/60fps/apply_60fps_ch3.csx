Apply("gml_Object_obj_gameshow_nameentry_Step_0", @"var controller_connected = global.is_console || obj_gamecontroller.gamepad_active;
if (!controller_connected && controller_active)
{
    controls_init = true;
    controller_active = false;
}
if (controller_connected && !controller_active)
{
    controls_init = true;
    controller_active = true;
}
