    c_talk_wait();
    c_speaker(""tenna"");
    c_msgsetloc(0, ""* Wh-what's wrong with ME having the car!? THEY weren't gonna win it!!/%"", ""obj_room_teevie_bonus_zone_slash_Step_0_gml_115_0"");
    c_talk_wait();
