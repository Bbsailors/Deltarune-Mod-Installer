        c_msgnextloc(""\\E8* It..^1. reflects fire attacks./"", ""obj_ch2_room_town_hospital_slash_Step_0_gml_84_0"");
        c_facenext(""rudy"", ""7"");
        c_msgnextloc(""\\E7* Hahaha^1! Whoops - hey^1, you gotta heal!/"", ""obj_ch2_room_town_hospital_slash_Step_0_gml_86_0"");
        c_facenext(""noelle"", 4);
