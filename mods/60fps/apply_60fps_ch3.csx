        sound_play_x(snd_laz_c, 1, 0.7);
        snd_play(snd_heavyswing);
        sound_play_x(snd_closet_impact, 1, 0.9);
        sound_play_x(snd_impact, 1, 0.7);
        with (su_actor)
        {
            friction = 0;
            vspeed = 0;
            gravity = 0;
            hspeed = 0;
