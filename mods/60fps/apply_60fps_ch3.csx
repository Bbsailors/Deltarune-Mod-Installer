    {
        if (name == ""susie"")
        {
            other.susie = id;
            other.susmemsprite = sprite_index;
            sprite_index = spr_susie_quiz_down;
            auto_walk = 0;
        }
    }
}
if (ralsei == 0)
{
    with (obj_actor)
    {
        if (name == ""ralsei"")
        {
            other.ralsei = id;
            other.ralmemsprite = sprite_index;
            sprite_index = spr_ralsei_quiz_down;
            auto_walk = 0;
        }
    }
}
if (kris == 0)
{
