Apply("gml_Object_obj_shadowmantleExample_Step_0", @"timer += (1 / global.fps_scale);
if (move != 0)
{
    mantle.x = round((320 + (sin(timer / 15) * 48)) / 2) * 2;
}
else
{
    mantle.x = 320;
}
