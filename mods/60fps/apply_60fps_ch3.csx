            {
                x += (30 / global.fps_scale);
            }
            layer_x(tileLayer, layer_get_x(tileLayer) + (movespeed / global.fps_scale));
            moving += (movespeed / global.fps_scale);
        }
        else
        {
            movestep = 999;
        }
    }
    if (shift == ""left"")
    {
        if (!checkend)
        {
            movespeed = 32;
            if (moving != 640)
            {
                for (var i = 0; i < movealllength; i++)
                {
                    with (moveall[i].object_index)
                    {
                        x -= (other.movespeed / global.fps_scale);
                    }
                }
                with (obj_mainchara)
                {
                    x -= (30 / global.fps_scale);
                }
                layer_x(tileLayer, layer_get_x(tileLayer) - (movespeed / global.fps_scale));
                moving += (movespeed / global.fps_scale);
            }
            else
