Apply("gml_Object_obj_pacifyspell_Create_0", @"target = 439493;
con = 1;
siner = 0;
xx = __view_get(e__VW.XView, 0);
yy = __view_get(e__VW.YView, 0);
alarm[4] = round(50 * global.fps_scale);
fail = 0;
flashcolor = c_blue;
timer = 0;
zcounter = 0;

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_pacifyspell_Step_0", @"if (!i_ex(target) && con < 20)
{
    debug_message(""target does not exist"");
    con = 99;
    instance_destroy();
    exit;
}
if (con == 1)
{
    if (fail == 0)
    {
        siner += (1 / global.fps_scale);
        target.image_blend = merge_color(target.image_blend, flashcolor, 0.1);
        if ((siner % 2) == 0)
        {
            ai = instance_create(target.x + random(target.sprite_width), (target.y + target.sprite_height) - 20, obj_afterimage);
            ai.gravity = 0.5 / (global.fps_scale * global.fps_scale);
            ai.sprite_index = spr_savepoint;
            ai.image_speed = 0.2 / global.fps_scale;
        }
        target.x += ((siner / 4) + (sin(siner / 8) * 10)) / global.fps_scale;
        target.y -= siner / 5 / global.fps_scale;
    }
    else
    {
        siner = 0;
        con = 5;
    }
}
if (con == 2)
{
    with (target)
    {
        instance_destroy();
    }
    instance_destroy();
}
if (con == 5)
{
    con = 6;
    alarm[4] = round(8 * global.fps_scale);
}
if (con == 6)
{
    target.image_blend = merge_color(target.image_blend, flashcolor, 0.12);
}
if (con == 7)
{
    con = 8;
    alarm[4] = round(8 * global.fps_scale);
}
if (con == 8)
{
    target.image_blend = merge_color(target.image_blend, c_white, 0.16);
}
if (con == 9)
{
    target.image_blend = c_white;
    instance_destroy();
}
if (con == 20)
{
    if (timer == 0 && zcounter == 0)
    {
        snd_play(snd_pacify);
    }
    timer -= (1 / global.fps_scale);
    if (timer <= 0)
    {
        var zobj = instance_create(x, y, obj_afterimage_grow);
        zobj.sprite_index = spr_spare_z;
        zobj.speed = 12 / global.fps_scale;
        zobj.direction = zcounter * 40;
        zobj.friction = 1 / (global.fps_scale * global.fps_scale);
        timer = 2;
        zcounter++;
    }
    if (zcounter >= 9)
    {
        con++;
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_particle_effect_Create_0", @"lifetime = 0;
fadeondeath = false;
destroyoffscreen = true;
autodepth = false;
rotation = 0;
image_speed = 1 / global.fps_scale;
random_image = false;
init = 0;
height = 0;
psuedo_gravity = 0;
");

Apply("gml_Object_obj_particle_effect_Step_0", @"if (init == 0)
{
    if (random_image)
    {
        image_speed = 0;
        image_index = irandom(image_number - 1);
    }
    init = 1;
}
if (rotation != 0)
{
    image_angle += (rotation / global.fps_scale);
}
if (destroyoffscreen && (x < (camerax() - 50) || x > (camerax() + 680) || y < (cameray() - 50) || y > (cameray() + 510)))
{
    instance_destroy();
}
else if (lifetime > 0)
{
    lifetime -= (1 / global.fps_scale);
    if (lifetime <= 0)
    {
        instance_destroy();
    }
    else if (fadeondeath && lifetime < 10)
    {
        image_alpha = lifetime / 10;
    }
}
");

Apply("gml_Object_obj_particle_generic_Step_0", @"image_alpha = scr_approach(image_alpha, 0, fade_rate);
image_xscale = scr_approach(image_xscale, 0, shrink_rate);
image_yscale = scr_approach(image_yscale, 0, shrink_rate);
if (image_xscale == 0 || image_yscale == 0)
{
    instance_destroy();
}
if (image_alpha == 0)
{
    instance_destroy();
}
timer -= (1 / global.fps_scale);
if (timer == 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_pc3_room1_Step_0", @"with (block)
{
    reset--;
    if (reset == 0)
    {
        debug_print(""global.interact=0 set by reset tile"");
        global.interact = 0;
    }
}
if (con == 0)
{
    if (resettile.pt == 1)
    {
        resettile.pt = 2;
        with (block)
        {
            var doreset = true;
            with (obj_board_grabobject)
            {
                if (grabbedid == other.id)
                {
                    doreset = false;
                }
            }
            if (doreset == true)
            {
                var __tileLayer = layer_get_id(""BOARD_Tiles"");
                var __originX = layer_get_x(__tileLayer);
                var __originY = layer_get_y(__tileLayer);
                global.interact = 1;
                scr_lerpvar(""x"", x, xstart + __originX, 10, 1, ""in"");
                scr_lerpvar(""y"", y, ystart + __originY, 10, 1, ""out"");
                reset = 10;
            }
        }
    }
    var count = 0;
    with (trig1)
    {
        if (place_meeting(x, y, obj_pushableblock_board))
        {
            count++;
        }
    }
    if (count == 1 && resettile.pressed == false)
    {
        safe_delete(trig1);
        timer = -10;
        snd_play(snd_board_secret_normal);
        global.interact = 1;
        con = 1;
    }
}
if (con == 1)
{
    var timedelay = 6;
    timer += (1 / global.fps_scale);
    if (timer == (timedelay * 1))
    {
        with (tree1)
        {
            snd_play(snd_board_splash);
            instance_create_depth(x, y, depth - 1, obj_board_smokepuff);
            instance_destroy();
        }
    }
    if (timer == (timedelay * 2))
    {
        with (tree2)
        {
            snd_play(snd_board_splash);
            instance_create_depth(x, y, depth - 1, obj_board_smokepuff);
            instance_destroy();
        }
    }
    if (timer == (timedelay * 3))
    {
        with (block)
        {
            snd_play(snd_board_splash);
            instance_create_depth(x, y, depth - 1, obj_board_smokepuff);
            instance_destroy();
        }
    }
    if (timer == (timedelay * 4))
    {
        with (resettile)
        {
            snd_play(snd_board_splash);
            instance_create_depth(x, y, depth - 1, obj_board_smokepuff);
            instance_destroy();
        }
        global.interact = 0;
        with (obj_board_nothrow)
        {
            if (image_blend == #FF9999)
            {
                instance_destroy();
            }
        }
        with (obj_board_solidenemy)
        {
            if (image_blend == #FFFF75)
            {
                instance_destroy();
            }
        }
        global.flag[1150] = 2;
        timer = 0;
        con++;
    }
}
");

Apply("gml_Object_obj_persistentfadein_Draw_0", @"if (view_current == 0)
{
