else if (angle < target_angle)
{
    angle_lerp = scr_movetowards(angle_lerp, 1, 0.025 / global.fps_scale);
    angle = lerp(0, target_angle, scr_ease_out(angle_lerp, 6));
}
else
{
    x += (0.25 / global.fps_scale);
}
if (knockback != 0)
{
