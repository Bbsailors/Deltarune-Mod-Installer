        if (speaker == ""tenna"" || speaker == ""Tenna"" || speaker == ""te"" || speaker == ""t"")
        {
            specialtalk = ""tenna"";
            dropColor = 65535;
            talksnd = 128;
        }
        if (speaker == ""lancer"" || speaker == ""Lancer"" || speaker == ""la"" || speaker == ""l"")
        {
            dropColor = 12420437;
            talksnd = 134;
        }
    }
    else
    {
        speaker = ""tenna"";
        specialtalk = ""tenna"";
        dropColor = 65535;
        talksnd = 128;
        talkrate = 3;
        talkcount = 5;
    }
    if (talk == true)
    {
        if (specialtalk == ""none"")
        {
            for (var i = 0; i < talkcount; i++)
            {
                snd_play_delay(talksnd, talkdelay + (i * talkrate), 1, 1 + (i * pitchmod));
            }
