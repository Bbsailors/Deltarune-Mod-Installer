Apply("gml_Object_obj_bullet_rain_Step_0", @"if (global.turntimer < 1)
{
    instance_destroy();
    exit;
}
event_inherited();
if (overpower)
{
    with (obj_bullet_homing)
    {
        if (point_distance(x, y, other.x, other.y) < (10 * other.overpower))
        {
            instance_destroy();
            with (instance_create(x, y, obj_regularbullet))
            {
                active = false;
                spin = 1;
                spinspeed = random(5) - 0.25;
                direction = 70 + random(40);
                speed = (1 + random(1)) / global.fps_scale;
                image_xscale = 0.5;
                image_yscale = 0.5;
                sprite_index = spr_cakesmoke;
                scr_lerpvar(""image_alpha"", 1, 0, 30);
                scr_script_delayed(instance_destroy, 30);
            }
        }
    }
}
if (slowdown == true)
{
    if (gotopointer == false)
    {
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        gravity = 0;
        destroyonhit = false;
    }
    else if (i_ex(obj_rouxls_laser_pointer_controller))
    {
        friction = 0;
        var aa = randx + obj_rouxls_laser_pointer_controller._mouse_x;
        var bb = randy + obj_rouxls_laser_pointer_controller._mouse_y;
        var _dir = point_direction(x, y, aa, bb);
        var _diff = angle_difference(_dir, direction);
        direction += ((_diff * 0.2) / global.fps_scale);
        gravity_direction = direction;
        if (speed < 4)
        {
            speed += (0.2 / global.fps_scale);
        }
        updateimageangle = true;
    }
}
if (i_ex(obj_growtangle) && y > (obj_growtangle.y + 75) && updateimageangle == false)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_bullet_submoon_Step_0", @"event_inherited();
if (y > (obj_growtangle.y + 86))
{
    image_alpha -= (0.1 / global.fps_scale);
    if (image_alpha <= 0)
    {
        instance_destroy();
    }
}
slowed = scr_approach(slowed, 1 + sqrt(slow_factor), 9);
slow_factor = scr_approach(slow_factor, 0, 1);
mydir += (rotspd / slowed / global.fps_scale);
image_angle += (turnrate / slowed / (1 + (3 * touched_water)) / global.fps_scale);
if (push)
{
    y += (push / (1 + touched_water) / global.fps_scale);
}
push = scr_approach_curve(push, 0, 12 - (touched_water * 4));
if (touched_water)
{
    hspeed = scr_approach(hspeed, 0, max(0.1 / global.fps_scale, abs(0 - hspeed) / 15));
    vspeed = scr_approach(vspeed, 1 / global.fps_scale, max(0.1 / global.fps_scale, abs((1 / global.fps_scale) - vspeed) / 12));
    image_xscale *= power(0.99, 1 / global.fps_scale);
    image_yscale *= power(0.99, 1 / global.fps_scale);
    if (image_xscale < 0.1)
    {
        instance_destroy();
    }
}
if (instance_exists(master))
{
    disttarg = scr_approach_curve(disttarg, metadisttarg, 18);
    mydist = scr_approach_curve(mydist, disttarg, 20);
    x = master.x + lengthdir_x(mydist, mydir);
    y = master.y + lengthdir_y(mydist, mydir);
    if ((master.timer % 4) == 0)
    {
        grazed = false;
    }
    image_alpha = master.image_alpha;
    if (master.timer == 200)
    {
        metadisttarg = 0;
    }
}
else if (master != noone)
{
    instance_destroy();
}
if (slowdown == true)
{
    if (gotopointer == false)
    {
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        gravity = 0;
        if (turnrate > 0)
        {
            turnrate -= (0.1 / global.fps_scale);
        }
        if (turnrate < 0)
        {
            turnrate = 0;
        }
    }
    else if (i_ex(obj_rouxls_laser_pointer_controller))
    {
        direction = point_direction(x, y, obj_rouxls_laser_pointer_controller._mouse_x, obj_rouxls_laser_pointer_controller._mouse_y);
        if (speed < 3)
        {
            speed += (0.2 / global.fps_scale);
        }
        if (turnrate < 2)
        {
            turnrate += (0.1 / global.fps_scale);
        }
    }
}
");

Apply("gml_Object_obj_bullet_sun_Step_0", @"event_inherited();
timer += (1 / global.fps_scale);
if (timer == 180)
{
    instance_destroy();
    exit;
}
if (interval > 0)
{
    if ((timer % (36 - (4 * overpower))) == 0)
    {
        scr_lerpvar(""image_xscale"", image_xscale * 2, image_xscale, 9);
        scr_lerpvar(""image_yscale"", image_xscale * 2, image_xscale, 9);
