        scr_lerpvar_instance(keycard, ""vspeed"", 0, 2 / global.fps_scale, 15, 2, ""out"");
    }
    if (timer == 80)
    {
        keycard.yamt = 4;
        keycard.vspeed = -2 / global.fps_scale;
        keycard.gravity = 0.45 / (global.fps_scale * global.fps_scale);
        snd_play(snd_fall);
        timer = 0;
