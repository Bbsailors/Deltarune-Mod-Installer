Apply("gml_Object_obj_spareanim_Draw_0", @"if (t >= 6 && t <= 26)
{
    afterimage += (1 / global.fps_scale);
    d3d_set_fog(true, c_white, 0, 1);
    draw_sprite_ext(sprite_index, image_index, x + (afterimage * 4), y, image_xscale, image_yscale, 0, image_blend, 0.7 - (afterimage / 25));
    draw_sprite_ext(sprite_index, image_index, x + (afterimage * 8), y, image_xscale, image_yscale, 0, image_blend, 0.4 - (afterimage / 30));
    d3d_set_fog(false, c_black, 0, 0);
}
if (t < 6)
{
    if (t < 5)
    {
        draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, 1 - (neotone / 4));
    }
    d3d_set_fog(true, c_white, 0, 1);
    maxwhite = t / 5;
    if (maxwhite > 1)
    {
        maxwhite = 1;
    }
    draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, maxwhite - (tone / 5));
    d3d_set_fog(false, c_black, 0, 0);
}
if (t >= 1 && t <= 5)
{
    for (i = 0; i < 2; i += 1)
    {
        var range_width = x + random(sprite_width);
        var range_height = y + random(sprite_height);
        if (global.chapter == 3 && sprite_index == spr_ribbick_small)
        {
            range_width = x + 40 + random(28);
            range_height = y + 60 + random(22);
        }
        star[starcount] = instance_create(range_width, range_height, obj_marker);
        with (star[starcount])
        {
            image_xscale = 2;
            image_yscale = 2;
            sprite_index = spr_sparestar_anim;
            image_alpha = 2;
            image_speed = 0.25 / global.fps_scale;
            hspeed = -3 / global.fps_scale;
            gravity = 0.5 / (global.fps_scale * global.fps_scale);
            gravity_direction = 0;
        }
        starcount += 1;
    }
}
if (t >= 5 && t <= 30)
{
    for (i = 0; i < starcount; i += 1)
    {
        with (star[i])
        {
            image_angle += (10 / global.fps_scale);
            image_alpha -= (0.1 / global.fps_scale);
            if (image_alpha <= 0)
            {
                instance_destroy();
            }
        }
    }
}
if (t >= 5 && t < 10)
{
    tone += (1 / global.fps_scale);
}
if (t >= 9)
{
    neotone += (1 / global.fps_scale);
    if (neotone >= 30)
    {
        for (i = 0; i < starcount; i += 1)
        {
            with (star[i])
            {
                instance_destroy();
            }
        }
        instance_destroy();
    }
}
t += (1 / global.fps_scale);
");

Apply("gml_Object_obj_spell_mist_Draw_0", @"if (init == 0)
{
    if (myself >= 0)
    {
        if (global.monster[myself] == 1)
        {
            if (global.monsterstatus[myself] == 1)
            {
                success = 1;
            }
        }
    }
}
if (initdelay == 0)
{
    audio_play_sound(snd_ghostappear, 50, 0);
    if (success == 1)
    {
        audio_play_sound(snd_spell_pacify, 50, 0);
    }
}
initdelay -= (1 / global.fps_scale);
if (initdelay <= 0)
{
    siner += (1 / global.fps_scale);
    image_alpha = (sin(siner / 9) - 0.3) + (success * 0.3);
    amp = sin(siner / 9) * 30;
    draw_sprite_ext(sprite_index, image_index, x + (sin(siner / 6) * amp), y + ((cos(siner / 6) * amp) / 2), image_xscale, image_yscale, image_angle, image_blend, image_alpha * 0.8);
    draw_sprite_ext(sprite_index, image_index, x - (sin(siner / 6) * amp), y - ((cos(siner / 6) * amp) / 2), image_xscale, image_yscale, image_angle, image_blend, image_alpha * 0.8);
    stimer += (1 / global.fps_scale);
    if (siner == 12)
    {
        if (success == 1)
        {
            with (target)
            {
                global.flag[51 + myself] = 3;
                event_user(10);
                scr_monsterdefeat();
            }
        }
    }
    if (stimer >= 3 && siner <= 24)
    {
        stimer = 0;
        if (success == 1)
        {
            hex = instance_create((x - (sprite_width / 2)) + random(sprite_width), (y - (sprite_height / 2)) + random(sprite_height), obj_icespell_hexagon);
            hex.image_xscale = 0.5;
            hex.image_yscale = 0.5;
            hex.con = 1;
            hex.rotspeed = random(5);
            hex.sprite_index = spr_icespell_snowflake;
        }
    }
    if (siner >= 40)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_spell_snowgrave_Draw_0", @"xx = __view_get(e__VW.XView, 0);
yy = __view_get(e__VW.YView, 0);
if (init == 0)
{
    init = 1;
    fncon = 0;
    siner = 0;
    if (altpath == 1)
    {
        timer = -270;
        with (obj_heronoelle)
        {
            visible = 0;
        }
        fn = scr_dark_marker(obj_heronoelle.x, obj_heronoelle.y, spr_noelleb_spell);
        fn.depth = obj_heronoelle.depth;
        fn.image_index = 0;
        fncon = 0;
    }
}
timer += (1 / global.fps_scale);
if (altpath == 1)
{
    if (fncon == 0)
    {
        fn.image_index += 0.25 / global.fps_scale;
        if (fn.image_index >= 8)
        {
            fntimer = 0;
            fncon = 0.5;
            mus_volume(global.batmusic[1], 0, 90);
        }
    }
    if (fncon == 0.5)
    {
        fntimer += (1 / global.fps_scale);
        if (fntimer >= 120)
        {
            with (fn)
            {
                scr_oflash();
            }
            fn.sprite_index = spr_noelleb_spell_special;
            fn.image_speed = 0.5 / global.fps_scale;
            fncon = 0.8;
            fntimer = 0;
            amplitude = 0;
            with (obj_berdlyb2_enemy)
            {
                visible = 0;
            }
            fb = scr_dark_marker(obj_berdlyb2_enemy.x, obj_berdlyb2_enemy.y, spr_berdlyb_idle_shocked);
            fb.depth = obj_berdlyb2_enemy.depth;
        }
    }
    if (fncon == 0.8)
    {
        fntimer += (1 / global.fps_scale);
        if (fntimer >= 30)
        {
            fntimer = 0;
            fncon = 1;
        }
    }
    if (fncon == 1 || fncon == 2)
    {
        if (amplitude < 1)
        {
            amplitude += (0.03 / global.fps_scale);
        }
        if (fn.y > (fn.ystart - 70))
        {
            fn.y -= amplitude / global.fps_scale;
            fn.x += (amplitude * 2.94) / global.fps_scale;
        }
        fn.x += (sin(timer / 3) * amplitude) / global.fps_scale;
        fn.y += (cos(timer / 3) * amplitude) / global.fps_scale;
        if ((timer % 4) == 0 && timer < 70)
        {
            dustsnd = snd_play(snd_bell);
            snd_volume(dustsnd, 0.5, 0);
            snd_pitch(dustsnd, 0.5 + random(0.3));
            dust = instance_create(fn.x + 50, fn.y + 10 + 10, obj_afterimage_grow);
            dust.speed = (random(2) + 1) / global.fps_scale;
            dust.direction = random_range(0, 180);
            dust.gravity = (0.2 + random(0.3)) / (global.fps_scale * global.fps_scale);
            dust.gravity_direction = random_range(70, 110);
            dust.image_xscale = 1;
            dust.image_yscale = 1;
            dust.sprite_index = spr_shine;
            dust.image_speed = 0.5 / global.fps_scale;
            dust.image_alpha = 3;
        }
        if (timer >= 210)
        {
            fn.sprite_index = spr_noelleb_spell;
            fn.image_index = 2;
            fn.image_speed = 0;
            fn.gravity = 1 / (global.fps_scale * global.fps_scale);
            fncon = 3;
        }
    }
    if (fncon == 3)
    {
        if (fn.y >= (ystart - 6))
        {
            fn.y = ystart;
            fn.sprite_index = spr_noelleb_defeat;
            fn.speed = 0;
            fn.gravity = 0;
            with (fn)
            {
                scr_shakeobj();
            }
            fncon = 4;
        }
    }
}
if (timer > 0)
{
    draw_set_alpha(bgalpha);
    draw_rectangle_colour(xx - 10, yy - 10, xx + 700, yy + 500, c_white, c_white, c_blue, c_blue, false);
}
draw_background_tiled_ext(bg_snowfall, snowspeed / 1.5, timer * 6, 2, 2, c_white, bgalpha);
draw_background_tiled_ext(bg_snowfall, snowspeed, timer * 8, 2, 2, c_white, bgalpha * 2);
if (timer <= 10 && timer >= 0)
{
    if (bgalpha < 0.5)
    {
        bgalpha += (0.05 / global.fps_scale);
    }
}
if (timer >= 0)
{
    snowspeed += (20 + (timer / 5));
}
if (timer == 1)
{
    audio_play_sound(snd_snowgrave, 50, 0);
}
if (timer >= 20 && timer <= (75 + (altpath * 30)))
{
    stimer += (1 / global.fps_scale);
    snowflake[0] = instance_create(xx + 455, yy + 560, obj_spell_snowgrave_snowflake);
    snowflake[1] = instance_create(xx + 500, yy + 600, obj_spell_snowgrave_snowflake);
    snowflake[2] = instance_create(xx + 545, yy + 520, obj_spell_snowgrave_snowflake);
    for (i = 0; i < 3; i++)
    {
        snowflake[i].gravity = -2 / (global.fps_scale * global.fps_scale);
        snowflake[i].vspeed = (sin(timer / 2) * 0.5) / global.fps_scale;
        snowflake[i].siner = timer / 2;
    }
    if (stimer >= 8)
    {
        stimer = 0;
    }
}
if (timer == 70 && altpath == 1)
{
    fb.sprite_index = spr_berdly_ice;
    fb.x -= 22;
    fb.y -= 48;
}
if (timer == (95 + (altpath * 30)) && damage > 0 && global.fighting == 1)
{
    for (i = 0; i < 3; i++)
    {
        if (global.monster[i])
        {
            if (i_ex(global.monsterinstance[i]))
            {
                global.hittarget[i] = 0;
                global.monsterinstance[i].fatal = 1;
                if (altpath == 0)
                {
                    scr_damage_enemy(i, damage + round(random(100)));
                }
                else
                {
                    global.hittarget[i] = 0;
                    dm = instance_create(global.monsterx[i], (global.monstery[i] + 20) - (global.hittarget[i] * 20), obj_dmgwriter);
                    dm.damage = damage + round(random(100));
                    dm.type = 6;
                }
                if (global.monsterhp[i] > 0 && altpath == 0)
                {
                    global.monsterinstance[i].fatal = 0;
                    with (global.monsterinstance[i])
                    {
                        __of = scr_oflash();
                    }
                }
                if (altpath)
                {
                    with (fb)
                    {
                        scr_oflash();
                    }
                }
            }
        }
    }
}
if (timer >= (90 + (altpath * 30)))
{
    if (altpath == 0)
    {
        if (bgalpha > 0)
        {
            bgalpha -= (0.02 / global.fps_scale);
        }
    }
    if (altpath == 1)
    {
        bgalpha -= (0.005 / global.fps_scale);
    }
}
if (timer == (120 + (altpath * 150)))
{
    if (altpath)
    {
        with (obj_berdlyb2_enemy)
        {
            sidebcon = 1;
        }
        obj_berdlyb2_enemy.fn = fn;
        obj_berdlyb2_enemy.fb = fb;
    }
    instance_destroy();
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
