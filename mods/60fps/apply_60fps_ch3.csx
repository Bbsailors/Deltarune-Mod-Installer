            cs_wait_box_end = true;
            breakme = 1;
        }
    }
    if (_c == ""waitif"")
    {
        cs_wait_if = 1;
        cs_wait_if_objectid = command_arg1[i];
        cs_wait_if_varname = command_arg2[i];
        cs_wait_if_operator = command_arg3[i];
        cs_wait_if_varvalue = command_arg4[i];
        waiting = 1;
        breakme = 1;
