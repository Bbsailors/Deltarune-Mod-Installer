        {
            sucleanup = true;
        }
        if (instance_exists(block))
        {
            if ((block.x != 256 || block.y != 192) && block.x != 999999)
            {
                if (sucleanup)
                {
                    with (obj_board_grabobject)
                    {
                        if (i_ex(marker))
