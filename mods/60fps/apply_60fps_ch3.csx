                        }
                        con = 99;
                        timer = 0;
                        other.createphoto = true;
                        other.flagtoset = 1227;
                        var memspeed = speed;
                        speed = 0;
                    }
                    else if (!photod)
                    {
                        var pointsDisplay = instance_create(centerx(), centery(), obj_board_pointsGetDisplay);
                        pointsDisplay.amount = photopoints;
                        photod = true;
                    }
                }
            }
            if (object_index == obj_chaseenemy_board)
