Apply("gml_Object_obj_tenna_object_falls2_Step_0", @"if (i_ex(obj_tenna_zoom) && obj_tenna_zoom.con >= 2)
{
    instance_destroy();
}
if ((y + speed) >= (ystart + 20) && con == 0)
{
    vspeed = 0;
    gravity = 0;
    snd_play(snd_screenshake);
    scr_shakescreen();
    con = 1;
}
if (con == 1)
{
    timer += (1 / global.fps_scale);
    if (timer == 16)
    {
        instance_destroy();
    }
    if (frac(timer) == 0)
    {
        if (image_alpha == 0)
        {
            image_alpha = 1;
        }
        else
        {
            image_alpha = 0;
        }
    }
}
");

Apply("gml_Object_obj_tenna_object_falls_Step_0", @"if (type == 0)
{
    if (x < (camerax() + 40))
    {
        x = cameray() + 40;
    }
    if (x > (cameray() + 600))
    {
        x = cameray() + 600;
    }
}
if (y < (cameray() + 240))
{
    y = cameray() + 240;
}
