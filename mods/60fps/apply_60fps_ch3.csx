        DV.OBSPEED = 0.01 * OBM;
        if (OB_DEPTH >= 60000)
        {
            OB_DEPTH = 0;
        }
        obacktimer = 0;
    }
}
SKIPBUFFER -= 1;
if (ALREADY == 1)
{
    if (button2_h() == 1 && SKIPBUFFER < 0 && EVENT <= 75)
    {
        with (obj_writer)
        {
            if (pos < (length - 3))
            {
                pos += 2;
            }
            if (alarm[0] >= 10)
            {
                alarm[0] = round(10 * global.fps_scale);
            }
            if (specfade <= 0.9)
            {
                specfade -= 0.1;
            }
            if (rate <= 1)
            {
                rate = 1;
            }
        }
        if (EVENT >= 15)
        {
            if (alarm[4] >= 6)
            {
                alarm[4] = round(6 * global.fps_scale);
            }
        }
        SKIPBUFFER = 1;
    }
}
if (scr_debug())
{
    if (sunkus_kb_check_pressed(8))
    {
        global.flag[6] = 0;
        snd_free_all();
        room_goto(room_krisroom);
    }
}
");

