                    }
                }
            }
            if (obj_gamecontroller.gamepad_active && control_select_con == 1)
            {
                for (var i = 0; i < array_length_1d(gamepad_controls); i++)
                {
                    if (gamepad_button_check_pressed(obj_gamecontroller.gamepad_id, gamepad_controls[i]))
                    {
