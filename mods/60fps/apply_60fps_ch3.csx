Apply("gml_Object_obj_title_placeholder_Create_0", @"if (os_type == os_macosx)
{
    snd_play(snd_txtsans);
}
choice[0] = ""Go to Main Menu"";
choice[1] = ""Go to Debug Room"";
choice[2] = ""Quick Load"";
