                        movenoise = 1;
                        global.bmenucoord[global.bmenuno][global.charturn] = 1;
                    }
                    else if (ht[0] == 1)
                    {
                        movenoise = 1;
                        global.bmenucoord[global.bmenuno][global.charturn] = 0;
                    }
                }
            }
            if (button1_p() && onebuffer < 0)
