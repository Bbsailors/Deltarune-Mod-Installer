                event_user(1);
                break;
            case ""enemyjump"":
                event_user(2);
                break;
            case ""pipes"":
                event_user(4);
                break;
            case ""palms"":
                event_user(5);
                break;
            case ""free"":
                event_user(6);
                break;
            case ""lancer"":
                event_user(7);
                break;
            case ""rotation"":
                event_user(8);
                break;
            case ""ralsei"":
                event_user(9);
                break;
            case ""tvs"":
                event_user(10);
                break;
            case ""bullets"":
                event_user(11);
                break;
        }
        if (tookaphoto == true)
        {
            if (mercygained > 100)
