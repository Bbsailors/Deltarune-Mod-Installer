        if (timerb == 42)
        {
            enemy.sprite_index = spr_shutta_pose_return;
            enemy.image_index = 0;
            enemy.image_speed = 0.5 / global.fps_scale;
        }
        if (timerb == 51)
        {
            subact_state = ""posewait"";
