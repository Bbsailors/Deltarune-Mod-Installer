    fake_gt.yoffset = random_range(-1, 1) * (_knockback / 10);
}
else
{
    gt_x -= (angle / target_angle / 2 / global.fps_scale);
    fake_gt.xoffset = random_range(-1, 1) * (angle / target_angle);
    fake_gt.yoffset = random_range(-1, 1) * (angle / target_angle);
}
