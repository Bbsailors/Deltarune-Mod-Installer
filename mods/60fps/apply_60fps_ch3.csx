    draw_sprite_ext(spr_thrash_star, 0, (x + 6) - 14, (1 + sprite_height) - ((global.rank1tp / global.maxtension) * sprite_height), 0.5, 0.5, 0, col2, 1);
    draw_set_color(c_white);
}
