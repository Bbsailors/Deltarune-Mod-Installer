    {
        con = 3;
        global.interact = 0;
    }
}
if (honkcon == 1)
{
    honkcount += (1 / global.fps_scale);
    if (honkcount >= 30)
    {
        honkcon = 2;
    }
    else
    {
        snd_play(snd_cantselect);
    }
    with (su_actor)
