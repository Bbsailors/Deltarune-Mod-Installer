            setxy(x + moveX, y + moveY);
        }
        for (var i = 0; i < movealllength; i++)
        {
            with (moveall[i].object_index)
            {
                setxy(x + moveX, y + moveY);
            }
        }
        layer_x(tileLayer, layer_get_x(tileLayer) + moveX);
        layer_y(tileLayer, layer_get_y(tileLayer) + moveY);
    }
    if (camtimer == 35)
    {
        movestep = 999;
    }
}
if (movestep == 999)
{
    global.interact = 0;
    movestep = 0;
    shift = 0;
    moving = 0;
}
if (endcon == 1)
{
