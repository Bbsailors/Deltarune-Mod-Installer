    scr_script_delayed(scr_lerpvar_instance, 3, afterimage, ""image_yscale"", 1, 0, 16, 2, ""in"");
    afterimage.friction = 0.334 / (global.fps_scale * global.fps_scale);
    afterimage.fadeSpeed = 0.04;
    i++;
}
