                var ratalk = stringsetloc(""You've, um, \""got this,\"" Susie!"", ""obj_b1susiedig_slash_Step_0_gml_239_0"");
                scr_couchtalk(ratalk, ""ralsei"", 2, 60);
                realralsei.sprite_index = realralsei.lsprite;
