                onebuffer = 1;
                selnoise = 1;
                if (global.bmenuno == 1)
                {
                    global.chartarget[global.charturn] = global.bmenucoord[global.bmenuno][global.charturn];
                    global.faceaction[global.charturn] = 1;
                    global.charaction[global.charturn] = 1;
                    scr_nexthero();
