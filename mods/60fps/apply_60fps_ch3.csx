Apply("gml_Object_obj_shutta_photo_controller_Draw_0", @"siner += (1 / global.fps_scale);
if (state == ""intro"" || state == ""aiming"")
{
    if (i_ex(obj_shutta_nobyacttest) && obj_shutta_nobyacttest.photocooldowntimer > 0)
    {
