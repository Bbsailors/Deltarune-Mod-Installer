    hitstop = -1;
}
if (hitstop > 0)
{
    kickactive = false;
    flash = 0;
}
if (abs(hspeed) > fastestspeed)
{
    fastestspeed = abs(hspeed);
}
myxcenter = x - 6;
myycenter = (y - 34) + fakeheight;
");

