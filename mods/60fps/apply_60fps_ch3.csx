    {
        global.interact = 0;
    }
}
if (charcon == 1)
{
    drawchar = 1;
    bpy = 60;
    tpy = 80;
    if (global.interact == 5)
    {
        if (tp < (tpy - 1))
        {
            if ((tpy - tp) <= 40)
            {
                tp += round((tpy - tp) / 2.5);
            }
            else
            {
                tp += 30;
            }
        }
        else
        {
            tp = tpy;
        }
    }
    if (bp < (bpy - 1) && charcon == 1)
    {
        if ((bpy - bp) <= 40)
        {
            bp += round((bpy - bp) / 2.5);
        }
        else
        {
            bp += 30;
        }
    }
    else
    {
        bp = bpy;
    }
}
if (charcon == 0)
{
    if (tp > 0)
    {
        if (tp >= 80)
        {
            tp -= round(tp / 2.5);
        }
        else
        {
            tp -= 30;
        }
    }
    else
    {
        tp = 0;
    }
    if (bp > 0)
    {
        if (bp >= 40)
        {
            bp -= round(bp / 2.5);
        }
        else
        {
            bp -= 30;
        }
    }
    else
    {
        bp = 0;
    }
    if (bp == 0)
    {
        drawchar = 0;
    }
}
if (movenoise == 1)
{
    snd_play(snd_menumove);
    movenoise = 0;
}
if (selectnoise == 1)
{
    snd_play(snd_select);
    selectnoise = 0;
}
if (cancelnoise == 1)
{
    snd_play(snd_smallswing);
    cancelnoise = 0;
}
onebuffer -= 1;
twobuffer -= 1;
threebuffer -= 1;
upbuffer -= 1;
downbuffer -= 1;
if (scr_debug())
{
    if (sunkus_kb_check_pressed(83))
    {
        instance_create(0, 0, obj_savemenu);
    }
    if (sunkus_kb_check_pressed(76))
    {
        scr_load();
    }
    if (sunkus_kb_check_pressed(82) && sunkus_kb_check(8))
    {
        game_restart_true();
    }
    if (sunkus_kb_check_pressed(82) && !sunkus_kb_check(8))
    {
        snd_free_all();
        room_restart();
        global.interact = 0;
    }
}
if (global.chapter == 3)
{
    var pipistracker = 0;
    if (scr_itemcheck(35))
    {
        pipistracker = 1;
    }
    if (room == room_dw_snow_zone)
    {
        pipistracker = 0;
    }
    if (room == room_dw_puzzlecloset_3)
    {
        pipistracker = 0;
    }
    if (global.darkzone == 0)
    {
        pipistracker = 0;
    }
    if (global.interact != 0)
    {
        pipistracker = 0;
    }
    if (!scr_havechar(""susie""))
    {
        pipistracker = 0;
    }
    if (room == room_dw_ranking_z)
    {
        if (scr_itemcheck(35))
        {
            pipistracker = 1;
        }
    }
    if (pipistracker)
    {
        if (global.flag[1038] < 2)
        {
            global.tempflag[50] += 1 / global.fps_scale;
            if (global.flag[1038] == 1 && global.tempflag[50] < 27000)
            {
                global.tempflag[50] = 27000;
            }
            if (global.tempflag[50] >= 27000)
            {
                if (global.flag[1038] == 0)
                {
                    global.flag[1038] = 1;
                }
            }
            if (global.tempflag[50] >= 54000)
            {
                if (global.flag[1038] == 1)
                {
                    global.flag[1038] = 2;
                }
            }
        }
        if (global.flag[1038] > 0)
        {
            global.tempflag[51] += 1 / global.fps_scale;
            var tweetthreshold = 150;
            var tweetchance = 2;
            if (room == room_dw_ranking_z)
            {
                tweetthreshold = 6;
                tweetchance = 50;
            }
            if (global.tempflag[51] >= tweetthreshold && global.tempflag[51] < 1000)
            {
                var tweet_rand = random(100);
                if (tweet_rand < tweetchance)
                {
                    global.tempflag[51] = 1000;
                    var tweet_volume = 0.5;
                    if (global.plot >= 280)
                    {
                        if (room == room_dw_teevie_preview || room == room_dw_green_room || room == room_dw_ranking_hub || room == room_dw_ranking_b)
                        {
                            tweet_volume = 0.3;
                        }
                    }
                    if (global.flag[1038] == 1)
                    {
                        snd_play_x(snd_pipis_chirp, tweet_volume, 0.3 + random(0.3));
                    }
                    if (global.flag[1038] == 2)
                    {
                        snd_play_x(snd_pipis_cluck, tweet_volume, 0.2 + random(0.3));
                    }
                }
            }
            if (global.tempflag[51] >= 1000)
            {
                snd_pitch(snd_pipis_chirp, random_range(0.8, 1.8));
                snd_pitch(snd_pipis_cluck, random_range(0.2, 1.3));
                if (global.tempflag[51] >= 1025)
                {
                    snd_stop(snd_pipis_chirp);
                    snd_stop(snd_pipis_cluck);
                    global.tempflag[51] = 0 - random(30);
                }
            }
        }
    }
}

