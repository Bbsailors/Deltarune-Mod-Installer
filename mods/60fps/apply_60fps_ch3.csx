Apply("gml_Object_obj_chefs_evilguest_Step_0", @"if (obj_chefs_game.gameover)
{
    if (!hit)
    {
        speed = 0;
    }
    exit;
}
if (hit)
{
    if (y > (room_height + 20))
    {
        instance_destroy();
    }
    image_angle += (50 / global.fps_scale);
    exit;
}
