Apply("gml_Object_obj_shadowmantle_crtcontroller_Step_0", @"if (crt == 0)
{
    crt = 631;
}
if (boss == 0)
{
    boss = 586;
}
if (i_ex(crt))
{
    if (i_ex(boss))
    {
        if (boss.phase == 1)
        {
            with (crt)
            {
                chromStrength = lerp(chromStrength, 4, scr_fps_lerp_rate(0.01));
            }
            siner = 0;
        }
        if (boss.phase == 2)
        {
            with (crt)
            {
                chromStrength = lerp(chromStrength, 6, scr_fps_lerp_rate(0.01));
            }
            siner = 0;
        }
        if (boss.phase == 3)
        {
            siner += (1 / global.fps_scale);
            var sinmod = sin(siner / 15) * 2;
            with (crt)
            {
                chromStrength = lerp(chromStrength, 6 + sinmod, scr_fps_lerp_rate(0.5));
            }
        }
        if (boss.phase == 4)
        {
            siner += (1 / global.fps_scale);
            var sinmod = sin(siner / 10) * 4;
            with (crt)
            {
                chromStrength = lerp(chromStrength, 6 + sinmod, scr_fps_lerp_rate(0.5));
            }
        }
    }
    else
    {
        siner = lerp(siner, 0, scr_fps_lerp_rate(0.05));
        var sinmod = sin(siner / 15) * 4;
        with (crt)
        {
            chromStrength = lerp(chromStrength, 0.5 + (sinmod * 2), scr_fps_lerp_rate(0.5));
        }
    }
}
");

Apply("gml_Object_obj_shake_Alarm_0", @"if (global.flag[12] == 0)
{
    __view_set(e__VW.XView, camera, mycamerax + (shakex * shakesign));
    __view_set(e__VW.YView, camera, mycameray + (shakey * shakesign));
}
if (permashake == 0)
{
    if (shakex > 0)
    {
        shakex -= 1;
    }
    if (shakey > 0)
    {
        shakey -= 1;
    }
}
shakesign = -shakesign;
alarm[0] = ceil(shakespeed * global.fps_scale);
if (shakex == 0 && shakey == 0)
{
    instance_destroy();
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
