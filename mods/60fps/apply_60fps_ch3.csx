}
if (timer == 8)
{
    scale = 0.8;
}
if (timer == 9)
{
    scale = 0.6;
}
if (timer == 10)
{
    scale = 0.5;
}
if (timer > 3)
{
    draw_sprite_ext(spr_rude_orb, 0, (x + 200) - 38, (y + 37) - 10, 0.6 * scale, 0.9 * scale, image_angle - (timer * 80), c_white, image_alpha);
}
if (timer < 7 && frac(timer) == 0)
{
