                        instance_create_depth(clamp(other.x + 20, xorig + 160, (xorig + width) - 160), other.y + 30, depth - 900000, obj_susiezilla_perfect_chain);
                        with (obj_susiezilla_singlescreen_hud_score)
                        {
                            score_change(50);
                        }
                        scr_tenna_add_score(20);
                    }
                }
            }
