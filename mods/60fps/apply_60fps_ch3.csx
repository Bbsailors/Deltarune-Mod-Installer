    case ""preoutro"":
        timerc += (1 / global.fps_scale);
        char_y = lerp(char_y, _ystart + 90, timerc / 10);
        if (image_index > 0.4)
        {
            image_index -= ((1/3) / global.fps_scale);
        }
        else
        {
            image_index = 0;
        }
        drawinfront = false;
        if (timerc == 10)
        {
            char_state = ""outro"";
            char_timer = -1;
            timerc = 0;
        }
        break;
    case ""outro"":
        state = ""closing"";
        timer = 0;
        timerc = 0;
        break;
