Apply("gml_Object_obj_lancerSPIN_Step_0", @"spintimer += (1 / global.fps_scale);
if (spintimer == 20)
{
    spintimer = 0;
}
if (spintimer == 0)
{
    sprite_index = spr_lancer_dt;
}
else if (spintimer == 5)
{
    sprite_index = spr_lancer_lt;
}
else if (spintimer == 10)
{
    sprite_index = spr_lancer_ut;
}
else if (spintimer == 15)
{
    sprite_index = spr_lancer_rt;
}
switch (mode)
{
    case 0:
        scr_fixedorbit((obj_heart.x + 8) - (sprite_width / 2), (obj_heart.y + 8) - (sprite_height / 2), (direction - 90) + 6, 50);
        direction += (6 / global.fps_scale);
        break;
    case 1:
        scr_pivotoncenter(6);
        break;
    case 2:
        scr_rotatearoundpoint(obj_heart.x + 8, obj_heart.y + 8, 6);
        break;
    case 3:
        scr_orbitaroundpoint((obj_heart.x + 8) - (sprite_width / 2), (obj_heart.y + 8) - (sprite_height / 2), 6);
        break;
}
if (mode != 0)
{
    image_angle = direction;
}
");

Apply("gml_Object_obj_lancer_card_Draw_0", @"if (con == 0)
{
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        snd_play_pitch(snd_spellcast, 1.4);
    }
    y = lerp(y, ystart - 45, scr_fps_lerp_rate(0.16));
    if (timer > 14)
    {
        circlealpha -= (0.2 / global.fps_scale);
    }
    if (timer == 20)
    {
        timer = 0;
        con = 1;
        snd_play(snd_stardrop);
    }
}
if (con == 1)
{
    timer += (1 / global.fps_scale);
    if (timer < 11)
    {
        whitefgalpha += (0.1 / global.fps_scale);
    }
    if (timer >= 14)
    {
        whitefgalpha -= (0.1 / global.fps_scale);
        circlealpha = 0;
        image_alpha = 0;
        splatsoundtimer += (1 / global.fps_scale);
        if (splatsoundtimer == 1)
        {
            snd_play_x(snd_splat, 1, 0.9);
        }
        if (splatsoundtimer == 12)
        {
            snd_play_x(snd_splat, 0.6, 0.9);
        }
        if (splatsoundtimer == 24)
        {
            snd_play_x(snd_splat, 0.3, 0.9);
        }
        if (splatsoundtimer == 36)
        {
            snd_play_x(snd_splat, 0.1, 0.9);
        }
        if (splatsoundtimer == 48)
        {
            snd_play_x(snd_splat, 0.05, 0.9);
        }
    }
    if (timer >= 64)
    {
        instance_destroy();
        audio_resume_sound(global.batmusic[1]);
    }
}
