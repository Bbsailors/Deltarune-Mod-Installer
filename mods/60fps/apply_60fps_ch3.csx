Apply("gml_Object_obj_board_splattered_ralsei_Step_0", @"scr_depth_board();
if (y != 224)
{
    y = lerp(y, 224, scr_fps_lerp_rate(0.25));
    y = scr_even(y);
}
if (x >= 480)
{
    x = 480;
    stuck = true;
}
if (x <= 128)
{
    x = 128;
    stuck = true;
}
if (stuck == false)
{
    var kris = -4;
    var susie = -4;
    with (obj_mainchara_board)
    {
        if (name == ""kris"")
        {
            kris = id;
        }
        if (name == ""susie"")
        {
            susie = id;
        }
    }
    if (place_meeting(x, y, kris) || place_meeting(x, y, susie))
    {
        if (splatside == 1)
        {
            x += (4 / global.fps_scale);
        }
        else
        {
            x -= (4 / global.fps_scale);
        }
    }
}
if (obj_board_camera.con != 0 || instance_exists(obj_gameover_minigame))
{
    scr_play_recording(""ralsei"", ""0W"");
    with (obj_mainchara_board)
    {
        if (name == ""ralsei"")
        {
            x = other.x;
            y = other.y;
            visible = true;
        }
    }
    instance_destroy();
}
");

Apply("gml_Object_obj_board_squaretransition_Draw_0", @"timer += (1 / global.fps_scale);
if (frac(timer) == 0 && (floor(timer) % 15) == 0)
{
    baramount--;
}
if (baramount > 0)
{
    for (var i = 0; i < baramount; i++)
    {
        draw_sprite_ext(spr_pxwhite, 0, board_tilex(0), board_tiley(7 - i), 640, 32, 0, merge_color(c_black, c_black, i / baramount), 1);
        var heartsize = 1;
        if (heartsize == 1)
        {
            if (i == 4)
            {
                draw_sprite_ext(obj_board_squaretransition_heart, 0, 312, 182, 1, 1, 0, c_white, 1);
            }
            if (i == 3)
            {
                draw_sprite_ext(obj_board_squaretransition_heart, 1, 312, 192, 1, 1, 0, c_white, 1);
            }
        }
        if (heartsize == 2)
        {
            if (i == 4)
            {
                draw_sprite_ext(obj_board_squaretransition_heart, 0, 302, 172, 2, 2, 0, c_white, 1);
            }
            if (i == 3)
            {
                draw_sprite_ext(obj_board_squaretransition_heart, 1, 302, 192, 2, 2, 0, c_white, 1);
            }
        }
    }
}
else
{
    completed = true;
    if (doom == false)
    {
        doom = true;
        scr_doom(id, 10);
    }
}
");

Apply("gml_Object_obj_board_startransition_Draw_0", @"rotation += (12 / global.fps_scale);
if (con == 0)
{
    scr_lerpvar(""x"", xstart, targx, 8);
    scr_lerpvar(""y"", ystart, targy, 8);
    scr_lerpvar(""distance"", distance, 0, transitiontime);
