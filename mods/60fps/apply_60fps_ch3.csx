                {
                    var _facing = point_direction(xprevious, yprevious, x, y);
                    _facing += 90;
                    if (_facing > 360)
                    {
                        _facing -= 360;
                    }
                    _facing = round(_facing / 90);
                    if (_facing == 4)
                    {
