    {
        depth = obj_moveheart.depth + 2;
        xx = obj_moveheart.x + 10;
        yy = obj_moveheart.y + 4;
    }
    var idealangle = 0;
    var idealimagealpha = 0.7;
    if (right_h())
    {
        idealangle = -20;
        xx += 8;
    }
    if (left_h())
    {
        idealangle = 20;
        xx -= 8;
    }
    image_angle = lerp(image_angle, idealangle, scr_fps_lerp_rate(0.25));
    x = lerp(x, xx, scr_fps_lerp_rate(0.6));
    y = lerp(y, yy, scr_fps_lerp_rate(0.6));
    if (image_alpha < 0.7)
    {
        image_alpha += (0.1 / global.fps_scale);
    }
    if (i_ex(obj_dmgwriter_boogie))
