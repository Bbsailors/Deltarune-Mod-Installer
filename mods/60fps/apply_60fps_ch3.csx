    {
        scr_lerpvar(""y"", y, 600, time, 2, ""in"");
        image_index = 0;
        scr_lerpvar(""image_speed"", 0.5 / global.fps_scale, 0, time * 0.5);
    }
    zoomcon = 2;
}
