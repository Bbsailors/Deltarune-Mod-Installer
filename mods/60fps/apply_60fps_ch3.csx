Apply("gml_Object_obj_shadow_mantle_clone_Step_0", @"if (dashcon == 1)
{
    direction = point_direction(x, y + 16, 170 + irandom(295), 270);
    if (global.shadow_mantle_losses < 7)
    {
        gravity = 0.24 / (global.fps_scale * global.fps_scale);
    }
    else
    {
        gravity = 0.2 / (global.fps_scale * global.fps_scale);
