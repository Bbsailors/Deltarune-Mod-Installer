            scr_delay_var(""gravity"", 0, 58);
            scr_delay_var(""vspeed"", 0, 58);
        }
        with (ralsei)
        {
            vspeed = 8 / global.fps_scale;
            depth = 100000 - ((other.ray * 10) + (sprite_height * 10));
            x = other.rax;
