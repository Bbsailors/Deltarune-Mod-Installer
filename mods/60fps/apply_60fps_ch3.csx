            layer_y(tileLayer, layer_get_y(tileLayer) + (movespeed / global.fps_scale));
        }
        else
        {
            movestep = 999;
        }
    }
    if (shift == ""down"")
    {
        movespeed = 24;
        if (moving != 480)
        {
            moving += (movespeed / global.fps_scale);
            for (var i = 0; i < movealllength; i++)
            {
                with (moveall[i].object_index)
                {
                    y -= (other.movespeed / global.fps_scale);
                }
            }
            with (obj_mainchara)
            {
                y -= (20 / global.fps_scale);
            }
            layer_y(tileLayer, layer_get_y(tileLayer) - (movespeed / global.fps_scale));
        }
        else
        {
            movestep = 999;
        }
    }
    if (shift == ""warp"")
    {
        global.interact = 1;
        movestep = 90;
        camtimer = 0;
    }
}
if (movestep == 90)
{
    camtimer += (1 / global.fps_scale);
    if (camtimer == 15)
    {
        var moveX = -warpx - originX;
        var moveY = -warpy - originY;
        with (obj_mainchara)
        {
            setxy(other.playerx + other.originX, other.playery + other.originY);
        }
        with (obj_mainchara)
