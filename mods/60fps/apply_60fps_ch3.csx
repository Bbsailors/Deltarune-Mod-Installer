        {
            run_timer += (1 / global.fps_scale);
        }
        if (run_timer >= 60)
        {
            if (obj_mainchara.runcounter <= 5)
            {
                run_con = 0;
            }
            else
            {
                run_timer = 0;
                run_check = false;
