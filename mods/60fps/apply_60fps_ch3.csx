    {
        timer = 0;
        con = 2;
    }
}
if (con == 2)
{
    timer += (1 / global.fps_scale);
    x = lerp(start_x, target_x, timer / 30);
    y = lerp(start_y, target_y, timer / 30);
    if (timer == 30)
    {
        timer = 0;
        con = 3;
        move_count++;
        start_x = x;
        start_y = y;
        if (move_count == 1)
        {
            target_x = x + 79;
            target_y = y;
        }
        if (move_count == 2)
        {
            target_x = x - 79;
            target_y = y;
        }
        if (move_count == 3)
        {
            target_x = x;
            target_y = y + 79;
        }
    }
}
if (con == 3)
{
    timer += (1 / global.fps_scale);
    if (timer == 26)
    {
        timer = 0;
        con = 2;
