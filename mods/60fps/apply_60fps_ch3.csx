global.flag[20] = 0;
sparedsprite = spr_npc_puzzlepiece_shaved_frown;
hurtsprite = spr_npc_puzzlepiece_shock2_shaved;
var _yy = y + ((siner % 1) * 2);
instance_create(x + 22, _yy + 32, obj_dojo_shaveeffect);
