                mus_fade(global.currentsong[1], 60);
                var tetalk = stringsetloc(""* PHEW!!! YOU GUYS SAVED TV!!! YOU HAVE WON!!!"", ""obj_susiezilla_singlescreen_shadowguy_laser_machine_slash_Collision_obj_susiezilla_player_gml_147_0"");
