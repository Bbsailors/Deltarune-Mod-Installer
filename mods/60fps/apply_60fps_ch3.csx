        break;
}
image_xscale = width / 32;
image_yscale = height / 32;
if (state == ""aiming"")
{
    x += (((right_h() - left_h()) * 10) / global.fps_scale);
    y += (((down_h() - up_h()) * 10) / global.fps_scale);
