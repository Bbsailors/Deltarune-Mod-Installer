        if (dir == ""up"")
        {
            _yy = -32;
        }
        x += _xx;
        y += _yy;
        var checker = instance_place(x, y, obj_board_solid);
        if (checker == -4)
        {
            checker = collision_rectangle(132, 68, 508, 92, object_index, true, false);
        }
        if (checker == -4)
        {
            checker = collision_rectangle(132, 292, 508, 316, object_index, true, false);
        }
        if (checker == -4)
