        msgnextloc(""To watch me./"", ""obj_ch3_BTB05_slash_Step_0_gml_207_0"");
        msgnextloc(""I..^1. was so happy./"", ""obj_ch3_BTB05_slash_Step_0_gml_208_0"");
        msgnextloc(""Then.../%"", ""obj_ch3_BTB05_slash_Step_0_gml_209_0"");
