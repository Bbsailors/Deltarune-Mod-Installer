                playyround = round(playyround / 32) * 32;
                mycam = instance_create(playxround, playyround, obj_board_playercamera);
                mycam.camwidth = camwidth;
                mycam.camheight = camheight;
                mycam.controllable = false;
            }
            con = 1.4;
            timer = 0;
