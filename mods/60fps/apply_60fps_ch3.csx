        if (i < 3)
        {
            my_blend_mode = merge_color(#132246, my_blend_mode, i / 3);
        }
        if (i > (count - 4))
        {
            my_blend_mode = merge_color(#132246, my_blend_mode, (count - i - 1) / 4);
