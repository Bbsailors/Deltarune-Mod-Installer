                dc.type = 73.1;
                dc = scr_bulletspawner(x, y, obj_dbulletcontroller);
                dc.type = 69;
                dc.special = 0;
                dc = scr_bulletspawner(x, y, obj_dbulletcontroller);
                dc.type = 71;
                dc.special = 2;
                scr_turntimer(450);
            }
