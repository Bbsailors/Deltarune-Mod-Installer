        snd_play_pitch(snd_board_door_close, 1.2);
        scr_board_instawarp(128, 320, kris.x, kris.y + 224 + 32, ""none"", 119);
        mus_fade(global.currentsong[1], 30);
        instance_destroy();
    }
}
if (afterimage == 1)
{
    afterimage = 0;
    scr_board_afterimage(0, 10);
}
scr_depth_board();
");

