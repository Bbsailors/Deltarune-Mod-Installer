Apply("gml_Object_obj_board_photoparent_Step_0", @"if (frozen == true)
{
    if (frozemem == false)
    {
        frozemem = true;
        mem_speed = speed;
        mem_image_speed = image_speed;
        mem_sprite_index = sprite_index;
        mem_image_index = image_index;
        mem_direction = direction;
        mem_hspeed = hspeed;
        mem_vspeed = vspeed;
        mem_friction = friction;
        speed = 0;
        image_speed = 0;
        if (freezesprite != 0)
        {
            sprite_index = freezesprite;
        }
        direction = 0;
        hspeed = 0;
        vspeed = 0;
        friction = 0;
    }
}
else if (frozemem == true)
{
    frozemem = false;
    speed = mem_speed / global.fps_scale;
    image_speed = mem_image_speed / global.fps_scale;
    sprite_index = mem_sprite_index;
    direction = mem_direction;
    hspeed = mem_hspeed / global.fps_scale;
    vspeed = mem_vspeed / global.fps_scale;
    friction = mem_friction / (global.fps_scale * global.fps_scale);
    image_index = mem_image_index;
}
");

