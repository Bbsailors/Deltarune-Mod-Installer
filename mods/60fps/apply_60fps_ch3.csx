        if (muted == false)
        {
            closedcaptioncon = 1;
        }
        else
        {
            alarm[4] = round(1 * global.fps_scale);
        }
    }
    if (actconral == 3 && con == 1)
    {
        con = 0;
        actcon = 1;
        actconral = 0;
        closedcaptioncon = 0;
    }
    if (actcon == 20 || actconsus == 20 || actconral == 20)
    {
        if (scr_terminate_writer())
        {
            actconsus = -1;
            actconral = -1;
            actcon = 1;
        }
    }
    if (actcon == 1 && !instance_exists(obj_writer))
    {
        scr_nextact();
    }
}
