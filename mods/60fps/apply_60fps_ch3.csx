Apply("gml_Object_obj_dw_ch3_lancer_spin_Draw_0", @"if (!lancer_visible)
{
    exit;
}
siner += (1 / global.fps_scale);
image_index = round((siner / 3) * 0.3183098861837907);
var addx = cos(siner / 3) * 16;
var addy = sin(siner / 3) * 8;
x = xstart + addx;
y = ystart + addy;
if (addx <= -8)
{
    image_index = 0;
}
if (addy <= -4)
{
    image_index = 1;
}
if (addx >= 8)
{
    image_index = 2;
}
if (addy >= 4)
{
    image_index = 3;
}
draw_self();
");

