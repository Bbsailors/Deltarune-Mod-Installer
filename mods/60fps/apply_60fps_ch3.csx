        scr_lerpvar(""y"", y, cameray() - 100, 15, 2, ""out"");
        scr_doom(id, 16);
    }
    with (obj_chefs_food)
    {
        scr_lerpvar(""y"", y, cameray() - 100, 15, 2, ""out"");
        scr_doom(id, 16);
    }
