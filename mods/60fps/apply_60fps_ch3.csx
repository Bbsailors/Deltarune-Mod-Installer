    if (image_alpha == 0)
    {
        instance_destroy();
    }
}
if (updateangle == 1)
{
    image_angle = direction;
}
");

Apply("gml_Object_obj_board_controller_Draw_0", @"with (obj_gameshow_swordroute)
{
    event_user(0);
}
if (scr_debug() && view_current == 0)
{
    if (keyboard_check_pressed(vk_backspace) || gamepad_button_check_pressed(0, gp_shoulderl))
    {
        drawcrt = !drawcrt;
    }
}
if (drawcrt)
{
    draw_set_alpha(1);
    var screenleft = 128;
    var screentop = i_ex(obj_gameshow_swordroute) ? 32 : 64;
    var screenwidth = 384;
    var screenheight = 256 + (i_ex(obj_gameshow_swordroute) * 32);
    if (room == room_dw_b3bstest)
    {
        screenleft = 128;
        screentop = 64;
        screenwidth = 384;
        screenheight = 160;
    }
