    with (obj_chefs_fire)
    {
        vspeed = 0;
        hspeed = 0;
        gravity = 0;
    }
    with (obj_chefs_food)
    {
        vspeed = 0;
        hspeed = 0;
        gravity = 0;
    }
    c_waitcustom();
}
if (con == 2 && customcon == 1)
{
