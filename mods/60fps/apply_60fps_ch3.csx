            scr_resetgameshowcharacter_delay(""susie"", 90);
            tenna.bounce = 1;
            var tetalk = stringsetloc(""Hey hey!! We've got a budget!"", ""obj_b1bonuszone_slash_Step_0_gml_91_0"");
            scr_couchtalk(tetalk, ""tenna"", 2, 90);
        }
        if (timer == 185)
        {
