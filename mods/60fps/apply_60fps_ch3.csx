        repeat (2)
        {
            with (instance_create(x, y, obj_bulletparent))
            {
                hspeed = (-2 + random(3)) / global.fps_scale;
                vspeed = (-3 - random(2)) / global.fps_scale;
                gravity = 0.25 / (global.fps_scale * global.fps_scale);
                sprite_index = spr_ball;
                image_speed = 0;
                image_blend = c_gray;
                image_xscale = 0.1;
                image_yscale = 0.1;
                scr_lerpvar(""image_alpha"", 1, 0, 30);
            }
        }
    }
}
with (obj_bullet_submoon)
{
    if (!touched_water)
    {
        if (place_meeting(x, y, other.id))
        {
            image_xscale *= power(0.96, 1 / global.fps_scale);
            image_yscale *= power(0.96, 1 / global.fps_scale);
            repeat (9)
            {
                with (instance_create((x + random(16)) - 8, other.y, obj_bulletparent))
                {
                    hspeed = (-2 + random(3) + other.hspeed) / global.fps_scale;
                    vspeed = (-3 - random(2)) / global.fps_scale;
                    gravity = 0.25 / (global.fps_scale * global.fps_scale);
                    sprite_index = spr_ball;
                    image_speed = 0;
                    image_blend = c_gray;
                    image_xscale = 0.1;
                    image_yscale = 0.1;
                    scr_lerpvar(""image_alpha"", 1, 0, 30);
                    scr_script_delayed(instance_destroy, 30);
                }
            }
            touched_water = true;
        }
    }
}
");

