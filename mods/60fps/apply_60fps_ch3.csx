    if (movecon == 1)
    {
        movetimer += (1 / global.fps_scale);
        if (movetimer == 60)
        {
            movecon = 0;
            movetimer = 0;
        }
    }
}
if (movestyle == ""cardinal"")
{
    if (movecon == 0)
    {
        speed = 0;
        var spd = 5;
        if (hp <= 13)
        {
            spd = 7;
        }
        var rand = choose(0, 1, 2, 3);
        if (rand == 0)
        {
            hspeed = spd / global.fps_scale;
            vspeed = 0;
        }
        if (rand == 1)
        {
            vspeed = -spd / global.fps_scale;
            hspeed = 0;
        }
        if (rand == 2)
        {
            hspeed = -spd / global.fps_scale;
            vspeed = 0;
        }
        if (rand == 3)
        {
            vspeed = spd / global.fps_scale;
            hspeed = 0;
        }
        if ((y + 16) < 150)
        {
            vspeed = spd / global.fps_scale;
            hspeed = 0;
        }
        if ((y + 16) > 228)
        {
            vspeed = -spd / global.fps_scale;
            hspeed = 0;
        }
        if ((x + 16) < 215)
        {
            vspeed = 0;
            hspeed = spd / global.fps_scale;
        }
        if ((x + 16) > 420)
        {
            vspeed = 0;
            hspeed = -spd / global.fps_scale;
        }
        movecon = 1;
    }
    if (movecon == 1)
    {
        movetimer += (1 / global.fps_scale);
        if (movetimer == 20)
        {
            movecon = 0;
            movetimer = 0;
        }
    }
    if (x > (camerax() + camerawidth()))
    {
        hspeed = -5 / global.fps_scale;
        vspeed = 0;
        movetimer = 0;
        movecon = 0;
    }
    if (x < (camerax() + 32))
    {
        hspeed = 5 / global.fps_scale;
        vspeed = 0;
        movetimer = 0;
        movecon = 0;
    }
    if (y > (cameray() + cameraheight() + 32))
    {
        hspeed = 0;
        vspeed = -5 / global.fps_scale;
        movetimer = 0;
        movecon = 0;
    }
    if (y < cameray())
    {
        hspeed = 0;
        vspeed = 5 / global.fps_scale;
        movetimer = 0;
        movecon = 0;
    }
}
if (movestyle == ""path"")
