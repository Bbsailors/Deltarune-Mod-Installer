        wall.sprite_index = spr_board_door_right;
        wall.image_xscale = 2;
        wall.image_yscale = 2;
        wall.image_speed = 0.5 / global.fps_scale;
        wall = instance_create(board_tilex(0), board_tiley(4), obj_board_puzzle_wall);
        wall.sprite_index = spr_board_door_right;
        wall.image_xscale = 2;
        wall.image_yscale = 2;
        wall.image_speed = 0.5 / global.fps_scale;
