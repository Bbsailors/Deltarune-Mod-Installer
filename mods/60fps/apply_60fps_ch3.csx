    }
    else
    {
        draw_sprite_ext(sprite_index, 0, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
    }
    if (flash_alpha > 0 && (state == ""capture"" || state == ""result""))
    {
    }
