    draw_set_color(c_purple);
    draw_triangle(trix, triy, camerax() - 100, triy + triheight, camerax() - 80, triy - triheight, false);
    draw_set_alpha(1);
    draw_set_blend_mode(bm_normal);
    if (con >= 4 && con < 7 && frac(timer) == 0)
    {
