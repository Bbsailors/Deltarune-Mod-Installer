    if (i_ex(lancer))
    {
        var _cost = 999;
        var leftnine = false;
        var rightnine = false;
        with (obj_board_trigger)
        {
            if (extflag == ""9-1"")
            {
                if (place_meeting(x, y, obj_board_grayregion))
                {
                    leftnine = true;
                }
            }
            if (extflag == ""9-2"")
            {
                if (place_meeting(x, y, obj_board_grayregion))
                {
                    rightnine = true;
                }
            }
        }
        if (leftnine && rightnine)
        {
            _cost = 9;
        }
        if ((leftnine && !rightnine) || (!leftnine && rightnine))
        {
            _cost = 99;
        }
        lancer.cost = _cost;
    }
}
else
{
    suwalk = 0;
    timer = 0;
    texttimer = 0;
    visitinit = 0;
    textcomplete = false;
    if (sutalk == 7)
    {
        sutalk = 999;
    }
}
