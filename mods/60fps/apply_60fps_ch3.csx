        event_user(0);
    }
    with (throwmarker)
    {
        vspeed = -6 / global.fps_scale;
        gravity = 0.9 / (global.fps_scale * global.fps_scale);
        friction = 0.1 / (global.fps_scale * global.fps_scale);
    }
    if (dir == 1)
    {
        throwmarker.hspeed = (6 + (right_h() * 2)) / global.fps_scale;
    }
    if (dir == 3)
