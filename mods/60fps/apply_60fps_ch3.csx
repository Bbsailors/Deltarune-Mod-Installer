        smokefx.gravity = (2 - random(0.4)) / (global.fps_scale * global.fps_scale);
        smokefx.image_speed = 0.2 / global.fps_scale;
        smokefx.hspeed = -6 / global.fps_scale;
        smokefx.image_xscale = 1;
        smokefx.image_yscale = 1;
        smokefx.vspeed = random_range(-8, -4) / global.fps_scale;
        smokefx.image_angle = random(360);
        scr_lerpvar_instance(smokefx, ""image_alpha"", 2, 0, 8);
        scr_doom(smokefx, 8);
        snd_play_x(snd_metal_hit_guard, 1, 1);
