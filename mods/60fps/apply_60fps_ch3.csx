    {
        texttimer++;
        if (texttimer < string_length(shopstring))
        {
            if (string_char_at(shopstring, texttimer) != "" "" && string_char_at(shopstring, texttimer) != ""#"")
            {
                snd_play(snd_board_text_main);
            }
        }
        if (texttimer == string_length(shopstring))
