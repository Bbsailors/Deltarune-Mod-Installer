            {
                scr_pathfind_to_point(""susie"", 10, choose(1, 2, 5, 6), 0);
            }
            if (go == 2)
            {
                scr_pathfind_to_point(""susie"", choose(3, 4, 7), 1, 0);
            }
            susiewalkcon = 2;
        }
