Apply("gml_Object_obj_board_movingEnemy_Step_0", @"if (tilecon == 0)
{
    if (moving == 1)
    {
        if (dir == 0)
        {
            y += (2 / global.fps_scale);
            if (y >= (obj_board_anchor.y + 32))
            {
                dir = 1;
            }
        }
        else
        {
            y -= (2 / global.fps_scale);
            if (y <= (obj_board_anchor.y - 32))
            {
                dir = 0;
            }
        }
    }
}
if (tilecon == 1)
{
    remmoving = obj_mainchara_board.movingnow;
    obj_mainchara_board.movingnow = 0;
