        with (particle)
        {
            sprite_index = spr_ball_small_nooutline;
            image_xscale = 0.2;
            image_yscale = 2;
            image_alpha = 0.5;
            scr_doom(id, 30);
            scr_lerpvar(""x"", x, trix, 30, 2, ""in"");
            scr_lerpvar(""y"", y, triy, 30, 2, ""in"");
            scr_lerpvar(""image_xscale"", image_xscale, 2, 30, ""in"");
            scr_lerpvar(""image_yscale"", image_yscale, 0.2, 30, ""in"");
