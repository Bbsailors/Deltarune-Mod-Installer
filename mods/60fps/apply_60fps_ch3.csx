            draw_text_shadow(BOX_X1 + 125, BOX_Y1 + 22, SELTEXT_B);
        }
        else
        {
            var NOWPLACE = PLACE[i];
            if (MENU_NO == 10 || MENU_NO == 11)
            {
                if (COMPLETEFILE_PREV[i] == 1)
                {
