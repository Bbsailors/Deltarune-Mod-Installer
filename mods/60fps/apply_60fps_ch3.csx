    if (battle_end)
    {
        with (lava_screen)
        {
            runner_active = false;
        }
        with (lava_screen)
        {
            set_tenna(0);
        }
        battle_active = false;
        con = 19;
        alarm[0] = round(30 * global.fps_scale);
        snd_volume(global.batmusic[1], 0, 25);
    }
}
if (con == 20)
{
    con = 21;
    alarm[0] = round(30 * global.fps_scale);
    snd_free(global.batmusic[0]);
    snd_volume(global.currentsong[1], 0, 0);
    snd_resume(global.currentsong[1]);
    snd_volume(global.currentsong[1], 1, 20);
