        var sprite = ((i % 2) == 1) ? 4281 : 4715;
        draw_sprite_ext(sprite, siner + (i + 0.1), scr_even(xx + 50 + (i * 180) + (sin(siner + (i * 10)) * 4)), scr_even((base_y_pos - 12) + (sin((siner + (i * 10 * 4)) / 10) * 8)), base_x_scale, base_y_scale, 0, my_blend_mode, 1);
