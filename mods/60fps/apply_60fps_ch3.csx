global.cinstance[0] = 4343434343;
global.cinstance[1] = 343434343434;
var car = scr_dark_marker((camerax() + (view_wport[0] / 2)) - 40, 320, spr_dogcar);
car.image_speed = 0.15 / global.fps_scale;
