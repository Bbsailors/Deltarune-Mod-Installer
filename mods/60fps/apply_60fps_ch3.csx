    if (battimer >= 5 && !i_ex(obj_battleback))
    {
        batcon++;
        global.interact = 0;
        with (obj_mainchara_board)
        {
            canfreemove = true;
        }
        kris.canfreemove = true;
        madewriter = 0;
        makewriter = 1;
        ralsei.follow = true;
        scr_board_caterpillar_interpolate_ralsei();
    }
}
