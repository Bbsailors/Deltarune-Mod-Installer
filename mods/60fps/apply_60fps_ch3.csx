Apply("gml_Object_obj_numberentry_Draw_0", @"cur_jewel += (1 / global.fps_scale);
var ymod = 0;
if (side == 1)
{
    ymod = 155;
}
var cxx = camerax() + xoff;
var cyy = cameray() + yoff;
