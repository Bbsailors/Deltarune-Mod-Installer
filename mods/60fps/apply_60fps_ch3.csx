Apply("gml_Object_obj_ralseienemy_Draw_0", @"if (state == 3)
{
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    hurtshake += 1;
    if (hurtshake > 1)
    {
        if (shakex > 0)
        {
            shakex -= (1 / global.fps_scale);
        }
        if (shakex < 0)
        {
            shakex += (1 / global.fps_scale);
        }
        shakex = -shakex;
        hurtshake = 0;
    }
    draw_sprite_ext(spr_ralseib_shock_enemy, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
}
if (state == 0)
{
    siner += (1 / global.fps_scale);
    thissprite = sprite_index;
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        thissprite = sprite_index;
    }
    draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
        d3d_set_fog(true, c_white, 0, 1);
        draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
        d3d_set_fog(false, c_black, 0, 0);
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_ralseienemy_Step_0", @"if (ambushed == 0)
{
    scr_ambush();
    ambushed = 1;
}
if (global.monster[myself] == 1)
{
    global.flag[51 + myself] = 4;
    if (global.mnfight == 1 && talked == 0)
    {
        if (attackcon == 0)
        {
            scr_moveheart();
            abletotarget = 1;
            if (global.charcantarget[0] == 0 && global.charcantarget[1] == 0 && global.charcantarget[2] == 0)
            {
                abletotarget = 0;
            }
            mytarget = choose(0, 1, 2);
            if (abletotarget == 1)
            {
                while (global.charcantarget[mytarget] == 0)
                {
                    mytarget = choose(0, 1, 2);
                }
            }
            else
            {
                target = 3;
            }
