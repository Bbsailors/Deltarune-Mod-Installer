Apply("gml_Object_obj_quizroom_bg_Draw_0", @"star_anim += (star_anim_speed / global.fps_scale);
bg_speed -= (bg_speed_max / global.fps_scale);
bg_speed_y += (bg_speed_y_max / global.fps_scale);
