    {
        if (sprite_index == scr_84_get_sprite(""spr_funnytext_fun_o_meter""))
        {
            if (i_ex(obj_ch3_GSA01G))
            {
                playsound = true;
                typingnoise = 84;
            }
        }
    }
    if (settinga == 0)
    {
        typingstyle = 0;
    }
    if (settinga == 1)
    {
        typingstyle = 1;
