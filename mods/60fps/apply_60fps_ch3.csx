Apply("gml_Object_obj_shutta_photo_tenna_Step_0", @"_timer += (1 / global.fps_scale);
if (_timer < 30)
{
    y -= (8 / global.fps_scale);
}
if (auto_walk == 1)
{
    if (walk == 1)
    {
        v_speed = 0;
        if (fake_speed != 0)
        {
            v_speed = fake_speed;
        }
        if (speed != 0)
        {
            v_speed = speed;
        }
    }
    if (auto_facing == 1)
    {
        v_vspeed = 0;
        v_hspeed = 0;
        if (fake_speed != 0)
        {
            v_vspeed = lengthdir_y(fake_speed, fake_direction);
            v_hspeed = lengthdir_x(fake_speed, fake_direction);
        }
        if (hspeed != 0)
        {
            v_hspeed = hspeed;
        }
        if (vspeed != 0)
        {
            v_vspeed = vspeed;
        }
    }
    if (spinspeed != 0)
    {
        spintimer += (1 / spinspeed / global.fps_scale);
        if (spintimer >= 1)
        {
            if (facing == ""d"")
            {
                facing = ""l"";
            }
            else if (facing == ""l"")
            {
                facing = ""u"";
            }
            else if (facing == ""u"")
            {
                facing = ""r"";
            }
            else if (facing == ""r"")
            {
                facing = ""d"";
            }
            spintimer = 0;
        }
        if (spintimer <= -1)
        {
            if (facing == ""d"")
            {
                facing = ""r"";
            }
            else if (facing == ""l"")
            {
                facing = ""d"";
            }
            else if (facing == ""u"")
            {
                facing = ""l"";
            }
            else if (facing == ""r"")
            {
                facing = ""u"";
            }
            spintimer = 0;
        }
    }
    else
    {
        spintimer = 0;
    }
    if (debug_killtimer > 0)
    {
        debug_killtimer -= (1 / global.fps_scale);
        if (debug_killtimer <= 0)
        {
            instance_destroy();
        }
    }
    if (auto_depth == 1)
    {
        scr_depth_alt();
        depth += depthbonus;
    }
    sinerx = 0;
    sinery = 0;
    if (siner_add0 != 0)
    {
        siner0 += (siner_add0 / global.fps_scale);
        if (siner_type0 == ""sin"")
        {
            sinmove = sin(siner0) * siner_amplitude0;
        }
        else
        {
            sinmove = cos(siner0) * siner_amplitude0;
        }
        if (siner_visual0 == 1)
        {
            sinerx += lengthdir_x(sinmove, siner_direction0);
            sinery += lengthdir_y(sinmove, siner_direction0);
        }
        else
        {
            x += (lengthdir_x(sinmove, siner_direction0) / global.fps_scale);
            y += (lengthdir_y(sinmove, siner_direction0) / global.fps_scale);
        }
    }
    if (siner_add1 != 0)
    {
        siner1 += (siner_add1 / global.fps_scale);
        if (siner_type1 == ""sin"")
        {
            sinmove = sin(siner1) * siner_amplitude1;
        }
        else
        {
            sinmove = cos(siner1) * siner_amplitude1;
        }
        if (siner_visual1 == 1)
        {
            sinerx += lengthdir_x(sinmove, siner_direction1);
            sinery += lengthdir_y(sinmove, siner_direction1);
        }
        else
        {
            x += (lengthdir_x(sinmove, siner_direction1) / global.fps_scale);
            y += (lengthdir_y(sinmove, siner_direction1) / global.fps_scale);
        }
    }
    if (shakeamt > 0)
    {
        shaketimer -= (1 / global.fps_scale);
        if (shaketimer <= 0)
        {
            shakex = random_range(-shakeamt, shakeamt);
            shakey = random_range(-shakeamt, shakeamt);
            shaketimer = shaketime;
        }
    }
    else
    {
        shakex = 0;
        shakey = 0;
    }
}
");

Apply("gml_Object_obj_shutta_photobullet_Step_0", @"if (disappear)
{
    if (!init)
    {
        active = false;
        init = true;
        gravity = 0.5 / (global.fps_scale * global.fps_scale);
        rotation_spd = random_range(-5, 5);
        var _launch_angle = 90 + random_range(-45, 45);
        var _launch_power = random_range(2, 5);
        hspeed = lengthdir_x(_launch_power, _launch_angle) / global.fps_scale;
        vspeed = lengthdir_y(_launch_power, _launch_angle) / global.fps_scale;
    }
    if (vspeed >= 0)
    {
        image_alpha -= (0.05 / global.fps_scale);
    }
    image_angle += (rotation_spd / global.fps_scale);
    if (image_alpha <= 0)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shutta_pipe_Step_0", @"if (con == 0)
{
    timer += (1 / global.fps_scale);
    var duration = 8;
    var targetxscale = lerp(4, 1.3, timer / duration);
    var targetyscale = lerp(3, 1, timer / duration);
    image_xscale = lerp(0, targetxscale, scr_ease_in(timer / duration, 1));
    image_yscale = lerp(0, targetyscale, scr_ease_in(timer / duration, 1));
    if (timer == duration)
    {
        con = 1;
        timer = 0;
    }
}
if (con == 1 && !i_ex(obj_shutta_pipehand))
{
    timberb += (1 / global.fps_scale);
    var a = 4;
    var b = 40;
    if (type == 1)
    {
        if (timberb > 0)
        {
            siner += (1 / global.fps_scale);
        }
        y = ystart + (sin(siner / a) * b);
    }
    if (type == 2)
    {
        if (timberb > 0)
        {
            siner += (1 / global.fps_scale);
        }
        y = ystart - (sin(siner / a) * b);
    }
}
if (con == 2 && !i_ex(obj_shutta_pipehand))
{
    timer += (1 / global.fps_scale);
    image_xscale = lerp(1.3, 0, scr_ease_in(timer / 6, 1));
    image_yscale = lerp(1, 0, scr_ease_in(timer / 6, 1));
    if (timer == 6)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shutta_pipehand_Step_0", @"if (target_pipe != -1)
{
    x = target_pipe.x;
}
var pipeoutspeed = 6;
var waittime = 7;
if (type == 1)
{
    pipeoutspeed = 6;
    waittime = 12;
}
if (type == 2 || type == 3)
{
    pipeoutspeed = 8;
    waittime = 26;
}
if (type == 5)
{
    pipeoutspeed = 3;
    waittime = 3;
}
if (type == 6)
{
    pipeoutspeed = 6;
    waittime = 11;
}
if (con == 0)
{
    timer += (1 / global.fps_scale);
    if (timer == 15)
    {
        con = 1;
        timer = 0;
        visible = true;
        if (type == 3 || type == 4 || type == 6)
        {
            sprite_index = spr_shutta_jump;
            image_speed = 0.16666666666666666 / global.fps_scale;
            image_xscale = 0.2;
            image_yscale = 2;
            if (type == 3)
            {
                snd_play(snd_knight_jump_quick);
            }
            else
            {
                snd_play(snd_snd_motor_upper_quick_high);
            }
        }
    }
}
if (con == 1)
{
    timer += (1 / global.fps_scale);
    y = lerp(target_pipe.y, target_pipe.y - 60, timer / pipeoutspeed);
    if (type == 3 && timer == 3)
    {
        expand = 1;
    }
    if (type == 4 && timer == 2)
    {
        expand = 1;
    }
    if (type == 6 && timer == 2)
    {
        expand = 1;
    }
    if ((timer / pipeoutspeed) >= 0.6)
    {
        goodshot = true;
    }
    if (timer == pipeoutspeed)
    {
        con = 2;
        timer = 0;
        visible = true;
    }
}
if (con == 2)
{
    timer += (1 / global.fps_scale);
    if (timer == round(waittime / 2) && sprite_index != spr_shutta_jump)
    {
        image_xscale *= -1;
    }
    if (timer == waittime)
    {
        con = 3;
        timer = 0;
        if (type == 3 || type == 4 || type == 6)
        {
            compress = 1;
        }
        snd_play(snd_motor_swing_down);
    }
}
if (con == 3)
{
    timer += (1 / global.fps_scale);
    y = lerp(target_pipe.y - 60, target_pipe.y, timer / pipeoutspeed);
    if (type == 3 || type == 4 || type == 6)
    {
        image_yscale = lerp(2, 1, timer / pipeoutspeed);
    }
    if ((timer / pipeoutspeed) >= 0.8)
    {
        goodshot = false;
    }
    if (timer == pipeoutspeed)
    {
        instance_destroy();
        if (type == 3 || type == 4 || type == 6)
        {
            with (instance_nearest(x, y, obj_shutta_pipe))
            {
                scr_shakeobj();
                snd_play(snd_bump);
            }
        }
    }
}
if (expand == 1)
{
    expandtimer += (1 / global.fps_scale);
    var duration = 8;
    var targetxscale = lerp(8, 2, expandtimer / duration);
    image_xscale = lerp(0, targetxscale, scr_ease_in(expandtimer / duration, 1));
    if (expandtimer >= duration)
    {
        expand = 0;
    }
}
if (compress == 1)
{
    compresstimer += (1 / global.fps_scale);
    image_xscale = lerp(2, 0.4, compresstimer / 5);
    if (compresstimer >= 5)
    {
        compress = 0;
    }
}
");

Apply("gml_Object_obj_shutta_reticle_Step_0", @"if (con == 0 && i_ex(obj_growtangle))
{
    if (image_alpha < 1)
    {
        image_alpha += (0.1 / global.fps_scale);
    }
}
if (con == 1 || !i_ex(obj_growtangle))
{
    if (image_alpha > 0)
    {
        image_alpha -= (0.1 / global.fps_scale);
    }
    if (image_alpha == 0)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_shutta_reticle_bullet2_Step_0", @"image_angle = direction;
var a = 115;
if (i_ex(obj_growtangle))
{
    if (x < (obj_growtangle.x - a) || x > (obj_growtangle.x + a) || y < (obj_growtangle.y - a) || y > (obj_growtangle.y + a))
    {
        image_alpha -= (0.1 / global.fps_scale);
        if (image_alpha < 0)
        {
            instance_destroy();
        }
    }
}
else
{
    instance_destroy();
}
");

Apply("gml_Object_obj_shutta_reticle_bullet_Step_0", @"image_angle = direction;
depth = obj_growtangle.depth - 1;
var _x = obj_shutta_photo_controller.secrettargetx;
var _y = obj_shutta_photo_controller.secrettargety;
timer += (1 / global.fps_scale);
x = lerp(xstart, targetx, timer / timermax);
y = lerp(ystart, targety, timer / timermax);
if (timer >= timermax)
{
    var dir = 180;
    var dir2 = 0;
    repeat (6)
    {
        dir2 = -15 + irandom(30);
        var dox = x + lengthdir_x(5, dir + dir2);
        var doy = y + lengthdir_y(5, dir + dir2);
        bullet = scr_fire_bullet(dox, doy, obj_shutta_reticle_bullet2, dir + dir2, 1, spr_smallbullet, false, id, depth);
        bullet.image_angle = dir + dir2;
        bullet.friction = -0.2 / (global.fps_scale * global.fps_scale);
        bullet.depth = obj_growtangle.depth - 2;
        bullet.image_xscale = 0.5;
        bullet.image_yscale = 0.5;
        dir += 60;
    }
    repeat (6)
    {
        dir2 = (point_direction(x, y, _x, _y) - 15) + irandom(30);
        var dox = x + lengthdir_x(5, dir2);
        var doy = y + lengthdir_y(5, dir2);
        bullet = scr_fire_bullet(dox, doy, obj_shutta_reticle_bullet2, dir2, 1, spr_smallbullet, false, id, depth);
        bullet.friction = -0.2 / (global.fps_scale * global.fps_scale);
        bullet.image_angle = dir2;
        bullet.depth = obj_growtangle.depth - 2;
        bullet.image_xscale = 0.5;
        bullet.image_yscale = 0.5;
        dir += 36;
    }
    instance_destroy();
}
");

Apply("gml_Object_obj_shutta_rotation_attack_Alarm_0", @"if (con == 0 && motion_blur && afterimage_index < afterimage_count)
{
    with (obj_collidebullet)
    {
        var _afim = instance_create(x, y, obj_bulletparent);
        scr_image_copy(_afim, self);
        _afim.image_alpha = 0;
        _afim.saved_alpha = ((other.afterimage_index + 1) / other.afterimage_count) * 0.4;
        afterimage[other.afterimage_index] = _afim;
        afterimage[other.afterimage_index].image_speed = 0;
    }
    afterimage_index++;
    alarm[0] = round(afterimage_interval * global.fps_scale);
}
else
{
    con++;
}
if (con == 1)
{
    take_photo = true;
    if (multiple)
    {
        alarm[0] = round(10 * global.fps_scale);
    }
    else
    {
        alarm[0] = round(15 * global.fps_scale);
    }
}
if (con == 2 && difficulty >= 1)
{
    if (difficulty >= 4)
    {
        lerp_time = edit_time;
    }
    if (difficulty >= 3)
    {
        alarm[0] = round(edit_time * global.fps_scale);
    }
    else
    {
        alarm[0] = round(random_range(20, 50) * global.fps_scale);
    }
}
if (con == 3)
{
    alarm[0] = round(wait_time * global.fps_scale);
}
if (con == 4)
{
    event_user(1);
}
");

