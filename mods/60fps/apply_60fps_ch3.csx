Apply("gml_Object_obj_zapper_cannon_manager_Alarm_2", @"aim_y = obj_growtangle.y + irandom_range(-40, 40);
aim_angle = point_direction(x + 40, y + 82, aim_x, aim_y);
snd_play_x(snd_explosion_firework, 1, 1.2);
