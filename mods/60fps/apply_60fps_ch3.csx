Apply("gml_Object_obj_dw_leave_Draw_0", @"pillarsiner += (1 / global.fps_scale);
dist = 0;
if (instance_exists(obj_mainchara))
{
    dist = point_distance(x, y, obj_mainchara.x + 20, obj_mainchara.y + 30) - 30;
}
if (dist < 0)
{
    dist = 0;
}
alphadist = dist / 1500;
if (alphadist >= 0.3)
{
    alphadist = 0.3;
}
for (i = 0; i < 3; i++)
{
    sinoff = sin((i / 4) + (pillarsiner / 10));
    if (bottom == 1)
    {
        draw_sprite_ext(sprite_index, 0, x, y, (image_xscale - (0.3 * i)) + (sin(sinoff) * 0.1), image_yscale, 0, c_white, ((0.7 - alphadist) + (sin(sinoff) * 0.01) + pillaralpha) / 2);
    }
    if (top == 1)
    {
        draw_sprite_ext(sprite_index, 1, x, y, (pillarscale - (0.3 * i)) + (sin(sinoff) * 0.1), image_yscale, 0, c_white, ((0.4 - alphadist) + (sin(sinoff) * 0.01) + pillaralpha) / 3);
    }
}
draw_set_blend_mode(bm_normal);
if (top == 1)
{
    particletimer += (1 / global.fps_scale);
    if (particletimer >= 2)
    {
        instance_create(random_range(x - (sprite_width / 2), x + (sprite_width / 2)), y - random(sprite_height), obj_dw_transition_particle);
        particletimer = 0;
    }
    if (con == 1)
    {
        snd_play(snd_dtrans_lw);
        with (obj_dw_leave)
        {
            if (bottom == 1)
            {
                draw_kris = 1;
                fake_v = 1;
            }
        }
        con = 2;
        alphab = 0;
        fake_v = -10;
    }
    if (con == 2)
    {
        alphab += (0.001 / global.fps_scale);
        fake_v += ((0.5 + (alphab * 20)) / global.fps_scale);
        draw_set_blend_mode(bm_add);
        draw_sprite_ext(sprite_index, 1, x, y, 99, 99, 0, c_white, fake_v / 80);
        draw_set_blend_mode(bm_normal);
        if ((fake_v / 80) >= 1.2)
        {
            pers = instance_create(0, 0, obj_persistentfadein);
            pers.image_blend = c_white;
            global.interact = 3;
            global.entrance = 24;
            snd_free(global.currentsong[0]);
            scr_become_light();
            if (global.plot == 16 && global.chapter == 2)
            {
                scr_losechar();
            }
            room_goto(nextroom);
        }
    }
}
if (bottom == 1)
{
    if (draw_kris == 1)
    {
        fake_v -= (0.2 / global.fps_scale);
        kris_y += (fake_v / global.fps_scale);
        sus_y += (fake_v / global.fps_scale);
        siner += ((1 + (siner / 60)) / global.fps_scale);
        if (kris_only == 0)
        {
            draw_sprite_ext(spr_susie_dw_fall_d, siner / 6, sus_x, sus_y, 2, 2, 0, c_white, 1);
        }
        draw_sprite_ext(spr_kris_fall_d_dw, siner / 6, kris_x, kris_y, 2, 2, 0, c_white, 1);
    }
}
");

Apply("gml_Object_obj_dw_leave_Step_0", @"if (con == 10)
{
    mus_volume(global.currentsong[1], 0, 30);
    if (instance_exists(obj_mainchara))
    {
        obj_mainchara.visible = 0;
        kr_actor = instance_create_depth(obj_mainchara.x, obj_mainchara.y, obj_mainchara.depth, obj_actor);
        kr_actor.sprite_index = obj_mainchara.sprite_index;
        kr_actor.__x = kris_x + 6;
        kr_actor.__y = kris_y + 20;
        with (kr_actor)
        {
            scr_set_facing_sprites(""kris"");
            fun = 1;
            image_speed = 0.25 / global.fps_scale;
            scr_move_to_point_over_time(__x, __y, 10);
        }
    }
    if (instance_exists(obj_caterpillarchara) && scr_havechar(2))
    {
        su_actor = instance_create_depth(global.cinstance[0].x, global.cinstance[0].y, global.cinstance[0].depth, obj_actor);
        su_actor.__x = sus_x;
        su_actor.__y = sus_y + 8;
        with (su_actor)
        {
            sprite_index = global.cinstance[0].sprite_index;
            scr_set_facing_sprites(""susie"");
            scr_move_to_point_over_time(__x, __y, 10);
        }
        with (global.cinstance[0])
        {
            visible = 0;
        }
    }
    with (obj_caterpillarchara)
    {
        if (visible == 1)
        {
            me = scr_dark_marker_depth(x, y, 510000, sprite_index);
            visible = 0;
            if (name == ""ralsei"")
            {
                me.sprite_index = spr_ralsei_wave_start;
                me.image_speed = 0.2 / global.fps_scale;
                with (me)
                {
                    scr_script_delayed(scr_var, 15, ""sprite_index"", spr_ralsei_wave_down);
                }
            }
        }
    }
    contimer = 0;
    con = 11;
}
if (con == 11)
{
    contimer += (1 / global.fps_scale);
    if (contimer >= 11)
    {
        con = 1;
        with (obj_actor)
        {
            visible = 0;
        }
        with (obj_dw_leave)
        {
            if (bottom == 1)
            {
                draw_kris = 1;
            }
        }
        with (obj_dw_leave)
        {
            if (bottom == 1)
            {
                con = 15;
            }
            else
            {
                con = 1;
            }
        }
    }
}
if (stopcon == 1)
{
    if (global.interact == 0 && obj_mainchara.y <= (obj_markerX.y - 8))
    {
        global.interact = 1;
        stopcon = 2;
        obj_mainchara.y = obj_markerX.y - 4;
        global.facing = 0;
        scr_speaker(""ralsei"");
        msgsetloc(0, ""\\EN* Come back when you've finished your homework!/"", ""obj_dw_leave_slash_Step_0_gml_71_0"");
        scr_anyface_next(""susie"", ""K"");
        msgnextloc(""\\EK* (What's the point of having a room if you can't slack off in it?)/%"", ""obj_dw_leave_slash_Step_0_gml_73_0"");
        d_make();
    }
}
if (stopcon == 2 && !d_ex())
{
    stopcon = 1;
    global.interact = 0;
}
");

Apply("gml_Object_obj_dw_pippins_large_treasure_Step_0", @"if (myinteract == 3)
{
    if (is_opened)
    {
        scr_flag_set(1162, 1);
        global.interact = 0;
        myinteract = 0;
        with (obj_mainchara)
        {
            onebuffer = 5;
        }
    }
}
if (is_running)
{
    jump_timer -= (1 / global.fps_scale);
    if (jump_timer <= 0)
    {
        jump_timer = jump_time + irandom(6);
        pippins_sprite = 2047;
        pippins_anim = 4;
        snd_play(snd_jump);
        var target_y_offset = irandom_range(-10, 20);
        scr_lerpvar(""pippins_y"", pippins_y, pippins_y - (80 + target_y_offset), 6, 3, ""out"");
        scr_script_delayed(scr_lerpvar, 7, ""pippins_y"", pippins_y - (80 + target_y_offset), pippins_y, 10, 3, ""in"");
        scr_var_delay(""pippins_sprite"", 1540, 18);
    }
}
");

