Apply("gml_Object_obj_npc_cafe_Draw_0", @"image_index_fake += image_speed_fake;
if (mode == 1)
{
    fsiner += (1 / global.fps_scale);
}
else
{
    fsiner = 0;
    _sprite = remsprite;
}
recruitspriteheight = sprite_get_height(_sprite);
recruitspritewidth = sprite_get_width(_sprite);
rx = ((sprite_get_xoffset(_sprite) * 2) - recruitspritewidth) + (_spritex * 2);
ry = ((sprite_get_yoffset(_sprite) * 2) - (recruitspriteheight * 2)) + (_spritey * 2);
if (seat == 1 || seat == 3)
{
    draw_sprite_ext(_sprite, image_index_fake, x + rx + 35, y + ry + 80, 2, 2, 0, c_white, 1);
    if (mode == 1)
    {
        draw_sprite_ext_flash(_sprite, image_index_fake, x + rx + 35, y + ry + 80, 2, 2, 0, c_white, sin(fsiner / 8));
    }
}
else
{
    rx = ((-sprite_get_xoffset(_sprite) * 2) + recruitspritewidth) - (_spritex * 2);
    draw_sprite_ext(_sprite, image_index_fake, x + rx + 35, y + ry + 80, -2, 2, 0, c_white, 1);
    if (mode == 1)
    {
        draw_sprite_ext_flash(_sprite, image_index_fake, x + rx + 35, y + ry + 80, -2, 2, 0, c_white, sin(fsiner / 8));
    }
}
");

Apply("gml_Object_obj_npc_castle_cliff_Create_0", @"con = -1;
sinerx = 0;
sinery = 0;
siner0 = 0;
siner_add0 = 0.2;
siner_amplitude0 = 0;
siner_direction0 = 0;
siner1 = 0;
siner_add1 = 0.2;
siner_amplitude1 = 5;
siner_direction1 = 90;
sfx = false;
shine = -4;
remove_shine = false;
if (global.chapter == 2 && global.plot >= 10)
{
    if (scr_armorcheck_equipped_party(7) == 0 && scr_armorcheck_inventory(7) == 0 && scr_weaponcheck_inventory(7) == 0 && global.charweapon[2] != 7)
    {
        if (global.tempflag[35] == 0)
        {
            global.tempflag[35] = 1;
            scr_jevil_check();
        }
    }
    var show_shine = global.tempflag[36] == 1 || global.tempflag[36] == 2;
    if (show_shine && global.plot >= 200 && global.flag[309] < 9)
    {
        show_shine = false;
    }
    var hole = scr_marker(281, 200, spr_darkwest_hole);
    with (hole)
    {
        scr_depth();
    }
    if (show_shine)
    {
        shine = scr_marker(320, 235, spr_shine);
        shine.image_speed = 0.1 / global.fps_scale;
        shine.image_xscale = 2;
        shine.image_yscale = 2;
        shine.depth = hole.depth - 10;
    }
}
if (global.chapter != 2 || global.flag[314] == 1)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_npc_castle_cliff_Step_0", @"if (con == 1 && !d_ex() && i_ex(obj_npc_room))
{
    if (!sfx)
    {
        sfx = true;
        snd_play(snd_hypnosis);
    }
    sinerx = 0;
    sinery = 0;
    siner_amplitude0 += (0.2 / global.fps_scale);
    siner0 += (0.2 / global.fps_scale);
    var sinmove_x = sin(siner0) * siner_amplitude0;
    sinerx += lengthdir_x(sinmove_x, siner_direction0);
    sinery += lengthdir_y(sinmove_x, siner_direction0);
    var xpos = sinerx;
    var ypos = sinery;
    siner1 += (siner_add1 / global.fps_scale);
    var sinmove_y = cos(siner1) * siner_amplitude1;
    sinerx += lengthdir_x(sinmove_y, siner_direction1);
    sinery += lengthdir_y(sinmove_y, siner_direction1);
    xpos = sinerx;
    ypos = sinery;
    with (obj_npc_room)
    {
        x += (xpos / global.fps_scale);
        y = (y + (ypos / global.fps_scale)) - (6 / global.fps_scale);
    }
    if (obj_npc_room.y <= -100)
    {
        con = 99;
    }
}
if (remove_shine)
{
    remove_shine = false;
    if (shine != -4)
    {
        with (shine)
        {
            instance_destroy();
        }
    }
}
");

