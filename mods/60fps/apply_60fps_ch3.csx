draw_sprite_ext(sprite_index, image_index, x, y, length, height, 0, image_blend, image_alpha);
if (image_alpha <= 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_fadeout_Draw_0", @"if (view_current == 0)
{
