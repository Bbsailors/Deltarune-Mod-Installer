                global.battlemsg[0] = stringsetsubloc(""* The crown is \\cY~1-percent\\cW loose!"", string(crown), ""obj_checkers_enemy_slash_Step_0_gml_82_0"");
            }
        }
        else
        {
            global.turntimer = 120;
        }
    }
    if (global.mnfight == 2)
    {
        if (global.turntimer <= 1)
