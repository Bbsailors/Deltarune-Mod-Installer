        }
        fo = instance_create(0, 0, obj_fadeout);
        with (fo)
        {
            image_blend = c_white;
            fadespeed = 0.01;
        }
    }
    if (slidetimer == 540)
    {
        snd_stop(slidesfx);
        snd_free(global.currentsong[0]);
        global.interact = 1;
        room_goto_next();
    }
}

