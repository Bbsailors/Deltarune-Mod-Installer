Apply("gml_Object_obj_b2greenx_Step_0", @"scr_board_populatevars();
scr_gameshow_populatevars();
if (active == 1)
{
    if (solved == 1 && !i_ex(solvedblock))
    {
        snd_play(snd_board_door_close);
        var xloc = 0;
        var yloc = 0;
        with (obj_board_b2greenblock)
        {
