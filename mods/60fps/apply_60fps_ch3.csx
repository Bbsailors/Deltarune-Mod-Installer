    {
        lx = xorig;
        rx = xorig + width;
        ly = yorig;
    }
    if (x <= (lx + 10))
    {
        x = lx + 10;
        hspeed = -(hspeed / 2);
    }
    if (x >= (rx - 10))
    {
        x = rx - 10;
        hspeed = -(hspeed / 2);
    }
    if (y <= (ly + 200))
    {
        y = ly + 200;
        vspeed = -(vspeed / 2);
    }
    hitdir = direction;
    hitspeed = speed;
}
hitstop -= (1 / global.fps_scale);
if (hitstop == 0)
{
