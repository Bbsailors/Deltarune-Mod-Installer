Apply("gml_Object_obj_blocktree_bg_Step_0", @"oo = 0;
if (spec < 2)
{
    blocktimer += (1 / global.fps_scale);
}
if (blocktimer == 20)
{
    xv = x + (sprite_width / 4) + random(sprite_width / 2);
    yv = y + (sprite_height / 4) + random(sprite_height / 4);
    block = scr_dark_marker(xv, yv, spr_blocktree_block);
    with (block)
    {
        hspeed = (0.4 + random(1)) / global.fps_scale;
        vspeed = (0.7 + random(1.5)) / global.fps_scale;
        gravity_direction = 0;
        gravity = 0.1 / (global.fps_scale * global.fps_scale);
        image_alpha = 0;
        friction = -0.1 / (global.fps_scale * global.fps_scale);
    }
    block.depth = depth - 1;
    block.image_blend = merge_color(c_white, c_black, oo);
    if (oo >= 0.8)
    {
        with (block)
        {
            instance_destroy();
        }
    }
}
if (blocktimer >= 20 && blocktimer <= 30)
{
    with (block)
    {
        if (image_alpha < 1)
        {
            image_alpha += (0.2 / global.fps_scale);
        }
    }
}
if (blocktimer >= 38)
{
    with (block)
    {
        image_alpha -= (0.1 / global.fps_scale);
    }
}
if (blocktimer >= 48)
{
    blocktimer = 0;
    with (block)
    {
        instance_destroy();
    }
}
");

