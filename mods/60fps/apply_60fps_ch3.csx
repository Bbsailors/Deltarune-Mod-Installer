                inst.weathersprite = 2124;
                inst.temp = 110;
                inst.vspeed = 2 / global.fps_scale;
                inst = instance_create_depth(camerax() + 80, cameray() - 160, depth + 10, obj_umbrella_tv);
                inst.weathersprite = 2124;
