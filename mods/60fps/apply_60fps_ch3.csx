                susiewalkcon = 99;
                susie.sleepy = true;
                scr_play_susie_recording(""0W"");
            }
        }
        susietime = 0;
        susiewalkcon = 11;
    }
    if (susiewalkcon == 11)
    {
        if (i_ex(targ))
        {
            if (scr_board_checklocation(""susie"", targ.x, targ.y, 2))
            {
