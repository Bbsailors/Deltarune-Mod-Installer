}
if (con == 4)
{
    camerax_set(camdesx);
    timer = 0;
    con = 5;
}
if (con == 5)
{
    var halttime = 60;
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        global.facing = 0;
        with (kris)
        {
            depth = 100000 - ((other.kry * 10) + (sprite_height * 10));
            x = other.krx;
