    depth = -999999999;
}
tpoff = (tp - tpy) + yy;
bpoff = -bp + bpy + yy;
var spell_offset = langopt(500, 496);
if (intro == 1)
{
    if (bp < (bpy - 1))
    {
        if ((bpy - bp) < 40)
        {
            bp += max(1, round((bpy - bp) / 2.5 / global.fps_scale));
        }
        else
        {
            bp += (30 / global.fps_scale);
        }
    }
    else
    {
        bp = bpy;
    }
    if (bp == bpy)
    {
        intro = 0;
    }
}
if (intro == 2)
{
    if (bp > 0)
    {
        if (round((bpy - bp) / 5) > 15)
        {
            bp -= max(1, round((bpy - bp) / 2.5 / global.fps_scale));
        }
        else
        {
            bp -= (30 / global.fps_scale);
        }
    }
    else
