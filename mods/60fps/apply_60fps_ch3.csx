        if (suwalk == 0 && obj_board_camera.con == 0 && obj_board_camera.shift == ""none"")
        {
            suwalktimer++;
            if (suwalktimer == 8)
            {
                susie.sleepy = true;
                scr_pathfind_to_point(""susie"", irandom_range(2, 9), 4, 0);
            }
        }
    }
}
else
{
