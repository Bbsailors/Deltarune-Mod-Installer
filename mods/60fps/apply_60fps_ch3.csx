    }
    if (sprite_index == spr_board_flower_telegraph)
    {
        image_index += ((1/3) / global.fps_scale);
    }
    else if (sprite_index == spr_board_flower_telegraph_alt)
    {
        image_index += ((1/3) / global.fps_scale);
    }
    else
    {
        image_index += (irandom(3) / 20 / global.fps_scale);
    }
    image_speed = 0.05 / global.fps_scale;
}
else
{
    image_speed = 0;
}
if (room == room_board_2_sword)
{
