				{
					var tx = 28;
					var ty = 2;
					var xloop = screenwidth / 64;
					draw_sprite(bg_building_townhall, 0, -40, -90);
					draw_sprite_ext(spr_rainbow, 0, animindex % screenwidth, -3, xloop, 1, 0, c_white, 1);
					draw_sprite_ext(spr_rainbow, 0, (animindex % screenwidth) - screenwidth, -3, xloop, 1, 0, c_white, 1);
					draw_sprite_ext(spr_tenna_dance_cabbage_smol, danceindex, tx, ty, 1, 1, 0, c_white, 1);
				}
				if (draw == ""pushing"")
				{
					draw_sprite_ext(spr_dw_ranking_doors, 0, -40, -12, 2, 2, 0, c_white, 1);
					var pushing = 8054;
					if (global.lang == ""ja"")
					{
