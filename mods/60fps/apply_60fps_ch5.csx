		with (obj_castlereflect_manager)
		{
			if (instance_exists(other.npc_shi_l))
			{
				add_reflection(other.npc_shi_l.marker);
			}
			if (instance_exists(other.npc_shino_r))
			{
				add_reflection(other.npc_shino_r.marker);
			}
			add_sprite_offset(4513, 0, -6);
		}
