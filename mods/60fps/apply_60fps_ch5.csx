Apply("gml_Object_obj_credits_ch5_transition_Draw_0", @"index += (1 / global.fps_scale);
if (con == 16)
{
	scr_lerpvar(""overlay_alpha"", 1, 0, 90);
	sus_index += (0.25 / global.fps_scale);
	if (sus_v >= 0)
	{
		sus_f = 0;
