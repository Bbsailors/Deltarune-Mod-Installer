	{
		x = target.x;
		y = target.y;
	}
	else if (global.chapter == 5 && i_ex(obj_flowery_enemy) && obj_flowery_enemy.state == 3)
	{
		image_index = target.image_index;
		sprite_index = spr_flowery_hurt;
		image_angle = target.image_angle;
	}
	else if (global.chapter == 5 && i_ex(obj_green_enemy) && orange_green_target == ""green"")
	{
		image_index = target.image_index;
		sprite_index = target.sprite_index;
		image_angle = target.image_angle;
		x = target.x;
		y = target.y;
	}
	else if (global.chapter == 5 && i_ex(obj_orange_enemy) && target == obj_orange_enemy.id && obj_orange_enemy.state == 3)
	{
		sprite_index = spr_orange_surprised;
		x = target.x;
		y = target.y;
	}
	else if (global.chapter == 5 && i_ex(obj_green_egg_heal))
	{
		sprite_index = spr_enemy_orange_idle_base;
		x = target.x;
		y = target.y;
	}
	else if (global.chapter == 5 && i_ex(obj_pink_enemy) && obj_pink_enemy.idlesprite == spr_pink_front_sweat && object_get_name(target.object_index) == ""obj_pink_enemy"")
	{
		sprite_index = spr_pink_front_sweat;
		x = target.x + 52;
		y = target.y + 38;
	}
	else if (global.chapter == 5 && i_ex(obj_pink_enemy) && obj_pink_enemy.idlesprite == spr_pink_front_angry && object_get_name(target.object_index) == ""obj_pink_enemy"")
	{
		sprite_index = spr_pink_front_angry;
		x = target.x + 52;
		y = target.y + 38;
	}
	else if (global.chapter == 5 && i_ex(obj_pink_enemy) && obj_pink_enemy.idlesprite == spr_pink_very_hurt && object_get_name(target.object_index) == ""obj_pink_enemy"")
	{
		sprite_index = spr_pink_very_hurt;
		x = target.x;
		y = target.y + 6;
	}
	else
	{
		image_index = target.image_index;
		sprite_index = target.sprite_index;
		image_angle = target.image_angle;
	}
	if (follow)
	{
		x = target.x;
		y = target.y;
		image_xscale = target.image_xscale;
		image_yscale = target.image_yscale;
	}
	if (target && object_is_ancestor(target.object_index, obj_flower_enmparent))
	{
		image_angle = target.image_angle;
		image_xscale = target.image_xscale;
		image_yscale = target.image_yscale;
	}
	if (global.chapter == 5 && i_ex(obj_netskie_enemy))
	{
		x = target.x;
		y = target.y;
	}
}
siner += (flashspeed / global.fps_scale);
if (instance_exists(target) && instance_exists(obj_flowery_hero_flower) && object_get_name(target.object_index) == ""obj_herosusie"")
{
}
else
{
	d3d_set_fog(true, flashcolor, 0, 1);
	draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, sin(siner / 3));
	d3d_set_fog(false, c_black, 0, 0);
}
if (siner > 4 && sin(siner / 3) < 0)
{
	instance_destroy();
}
");

