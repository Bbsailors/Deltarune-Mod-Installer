Apply("gml_Object_obj_ch5_DW45_darkfountain_event_Draw_0", @"siner += (1.5 / global.fps_scale);
if (t >= 400)
{
	rs += (0.5 / global.fps_scale);
	draw_set_color(c_white);
	for (i = 1; i < 12; i += 1)
	{
		draw_set_alpha((rs / 16) - (i / 12));
		draw_rectangle(320 - (i * i) - (rs * i), 0, 320 + (i * i) + (rs * i), 500, 0);
	}
	draw_set_alpha(1);
}
draw_sprite_ext(sprite_index, image_index, x, y, 1, 1, 0, c_white, siner / 8);
draw_sprite_ext(sprite_index, image_index, x, y, siner / 4, siner / 4, 0, c_white, 1.6 - (siner / 16));
draw_sprite_ext(sprite_index, image_index, x, y, siner / 8, siner / 8, 0, c_white, 1.6 - (siner / 24));
t += (1 / global.fps_scale);
if (t >= 20)
{
	if (soundcon == 0)
	{
		soundcon = 1;
		if (scr_sideb_get_phase() < 3)
		{
			snd_play(snd_usefountain);
		}
	}
}
if (t >= 70 && t <= 240)
{
	with (obj_ch5_DW45_fountain)
	{
		adjust = 1;
		eyebody *= power(0.98, 1 / global.fps_scale);
	}
	y -= (1 / global.fps_scale);
}
if (t >= 240 && t < 245)
{
	with (obj_ch5_DW45_fountain)
	{
		adjust = 2;
	}
	t = 300;
}
if (t >= 390 && t < 395)
{
	t = 400;
	siner = 3;
	if (soundcon == 1)
	{
		soundcon = 2;
		audio_play_sound(snd_revival, 50, 0);
	}
}
if (t == 440)
{
	if (!border_show)
	{
		border_show = true;
		with (obj_border_controller)
		{
			hide_border(1, c_black);
			add_overlay_layer(16777215, 0, 1, 50);
		}
	}
}
if (t >= 450)
{
	ds2 += (0.02 / global.fps_scale);
	draw_set_alpha(ds2);
	draw_set_color(c_white);
	draw_rectangle(-10, -10, 999, 999, false);
	draw_set_alpha(1);
}
if (t >= 520)
{
	global.entrance = 0;
	global.interact = 1;
	global.fighting = 0;
	snd_free_all();
	room_goto(room_dw_post_fountain_close);
}
");

Apply("gml_Object_obj_ch5_DW45_fountain_Draw_0", @"siner += (1 / global.fps_scale);
hscroll += (1 / global.fps_scale);
if (hscroll > 240)
{
	hscroll -= 240;
}
if (adjust == 0)
{
	colcol = scr_make_color_hsv(siner / 4, 160 + (sin(siner / 32) * 60), 255);
	change_fountain_color(scr_make_color_hsv(siner / 4, 255, (sin(siner / 16) * 40) + 60));
}
if (adjust == 1)
{
	colcol = merge_color(colcol, c_white, scr_fps_lerp_rate(0.06));
	change_fountain_color(merge_color(nowcolor, c_black, scr_fps_lerp_rate(0.06)));
}
if (adjust == 2)
{
	if (slowdown < 1)
	{
		slowdown += (0.02 / global.fps_scale);
	}
	siner -= (slowdown / global.fps_scale);
	bgsiner -= (slowdown / (16 * global.fps_scale));
	change_fountain_color(merge_color(nowcolor, c_white, scr_fps_lerp_rate(0.03)));
}
if (adjust == 3)
{
	if (slowdown < 1)
	{
		slowdown += (0.01 / global.fps_scale);
	}
	siner -= ((slowdown * 0.5) / global.fps_scale);
	bgsiner -= (slowdown / 24 / global.fps_scale);
	hscroll -= ((slowdown * 0.8) / global.fps_scale);
	colcol = merge_color(nowcolor, scr_make_color_hsv(siner / 16, 160 + (sin(siner / 128) * 60), 255), slowdown);
	change_fountain_color(merge_color(nowcolor, scr_make_color_hsv(siner / 16, 255, (sin(siner / 64) * 40) + 60), slowdown));
}
bgsiner += (0.0625 / global.fps_scale);
if (bgsiner > 7)
{
	bgsiner -= 7;
}
bg = 5180;
draw_background_tiled_ext(bg, 0 - siner, 0 - siner - 40, 2, 2, colcol, 0.7 * eyebody);
draw_background_tiled_ext(bg, -240 + hscroll, (0 + siner) - 40, 2, 2, colcol, 0.3 * eyebody);
draw_set_color(c_black);
d_rectangle(0, 0, (room_width / 2) - (sprite_width / 2), 240, 0);
d_rectangle((room_width / 2) + (sprite_width / 2), 0, 999, 240, 0);
draw_sprite_ext(sprite_index, 0, (room_width / 2) - (sprite_width / 2), 0 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 1);
draw_sprite_ext(sprite_index, 0, (room_width / 2) - (sprite_width / 2), 240 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 1);
draw_sprite_ext(sprite_index, 0, ((room_width / 2) - (sprite_width / 2)) + (sin(siner / 16) * 12), 0 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 0.5);
draw_sprite_ext(sprite_index, 0, ((room_width / 2) - (sprite_width / 2)) + (sin(siner / 16) * 12), 240 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 0.5);
draw_sprite_ext(sprite_index, 0, (room_width / 2) - (sprite_width / 2) - (sin(siner / 16) * 12), 0 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 0.5);
draw_sprite_ext(sprite_index, 0, (room_width / 2) - (sprite_width / 2) - (sin(siner / 16) * 12), 240 - ((bgsiner * 240) / 7), 2, 2, 0, colcol, 0.5);
draw_sprite_ext(spr_fountainbottom, 0, (room_width / 2) - (sprite_width / 2), (-8 + (sin(siner / 16) * 8)) - 40, 2, 2, 0, colcol, 0.3);
draw_sprite_ext(spr_fountainbottom, 0, (room_width / 2) - (sprite_width / 2), (-4 + (sin(siner / 16) * 4)) - 40, 2, 2, 0, colcol, 0.5);
draw_sprite_ext(spr_fountainbottom, 0, (room_width / 2) - (sprite_width / 2), -40, 2, 2, 0, colcol, 1);
draw_set_color(nowcolor);
d_rectangle(0, 240, 640, 480, 0);
");

Apply("gml_Object_obj_ch5_DW50_Step_0", @"if (songplay == 2)
{
	global.currentsong[0] = snd_init(""wind_highplace.ogg"");
	global.currentsong[1] = mus_loop_ext(global.currentsong[0], 0.8, 0.9);
	songplay = 3;
}
if (songplay == 1)
{
	snd_free_all();
	songplay = 2;
}
if (songplay == 0)
{
	with (obj_mainchara)
	{
		visible = 0;
	}
	songplay = 1;
}
if (con == 0)
{
	JA_XOFF = 0;
	con = 1;
	alarm[0] = round(110 * global.fps_scale);
}
if (con == 1)
{
	y -= (2 / global.fps_scale);
	image_index = susindex;
	susindex += (0.2 / global.fps_scale);
	susy -= (2 / global.fps_scale);
	global.interact = 1;
}
if (con == 2)
{
	image_speed = 0;
	image_index = 0;
	susindex = 0;
	con = 3;
	alarm[0] = round(60 * global.fps_scale);
}
if (con == 4)
{
	con = 5;
	alarm[0] = round(40 * global.fps_scale);
	JA_XOFF = langopt(0, 50);
	global.typer = 99;
	global.msg[0] = stringsetloc(""..^1. Kris..^1./"", ""obj_ch5_DW50_slash_Step_0_gml_55_0"");
	global.msg[1] = stringsetloc(""..^1./"", ""obj_ch5_DW50_slash_Step_0_gml_56_0"");
	global.msg[2] = stringsetloc(""..^1. just..^1. seal it./%"", ""obj_ch5_DW50_slash_Step_0_gml_57_0"");
	instance_create(100 + JA_XOFF, 80, obj_writer);
}
if (con == 6 && !instance_exists(obj_writer))
{
	con = 7;
	alarm[0] = round(30 * global.fps_scale);
}
if (con == 8)
{
	con = 99;
	snd_free_all();
	made = 1;
	global.plot = 550;
	instance_create(x + (sprite_width / 2), y + (sprite_width / 2) + 20, obj_darkfountain_event);
}
");

Apply("gml_Object_obj_ch5_DWCL00_Step_0", @"if (!init)
{
	init = 1;
