	{
		other.con = 1;
	}
	if (scr_getmsgno() == 7)
	{
		other.con = 2;
	}
	if (scr_getmsgno() == 8)
	{
		other.con = 3;
	}
}
if (con < 0)
{
	if (wascon != con)
	{
		constart();
	}
	wascon = con;
	yelcol = 0;
	enddist = 300;
}
if (con == 0)
{
	if (wascon != con)
	{
		constart();
	}
	wascon = con;
	transitiontimer += (1 / global.fps_scale);
	var targdist = 290;
	enddist = lerp(transitiondist, targdist, clamp01(transitiontimer / 300));
	targyelcol = 4369;
	yelcol = merge_color(wasyelcol, targyelcol, clamp01(transitiontimer / 300));
}
if (con == 1)
{
	if (wascon != con)
	{
		constart();
	}
	wascon = con;
	transitiontimer += (1 / global.fps_scale);
