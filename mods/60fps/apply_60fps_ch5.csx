			scr_flag_set(1847, 1);
			scr_speaker(""asgore"");
			msgsetloc(0, ""\\E0* Kris..^1. don't worry^1. After we get back.../"", ""obj_ch5_DW45_slash_Step_0_gml_80_0"");
			msgnextloc(""\\E2* We can tell the mayor about everything we saw./"", ""obj_ch5_DW45_slash_Step_0_gml_81_0"");
			msgnextloc(""\\E3* I know she'll do everything she can to help./"", ""obj_ch5_DW45_slash_Step_0_gml_82_0"");
