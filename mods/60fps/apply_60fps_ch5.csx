		scr_speaker(""tenna"");
		msgsetloc(0, ""* Well^1, what are you doing!? Go and \\O0 again!/%"", ""obj_gameover_band_slash_Step_0_gml_125_0"");
		var d = d_make();
		d.stay = 5;
		d.side = 0;
	}
	if (con == 12 && !d_ex())
	{
		con = 13;
		alarm[0] = round(30 * global.fps_scale);
		gameover_parent.con = 1;
		gameover_parent.timer = 0;
	}
	if (con == 14 && !d_ex())
	{
		con = 99;
		instance_destroy();
