Apply("gml_GlobalScript_scr_get_inputs", @"function scr_get_inputs(arg0)
{
	if (arg0)
	{
		key_left = left_h();
		key_right = right_h();
		key_up = up_h();
		key_down = down_h();
		press_left = left_p();
		press_right = right_p();
		press_up = up_p();
		press_down = down_p();
		stick_hmag = 1;
		stick_vmag = 1;
		if (i_ex(obj_gamecontroller) && obj_gamecontroller.gamepad_active == 1 && global.stick_mag > 0 && global.flag[960] >= 1)
		{
			if (abs(global.stick_lx) >= abs(global.stick_ly))
			{
				key_left = key_left || global.stick_lx < 0;
				key_right = key_right || global.stick_lx > 0;
				if (global.flag[960] == 1)
				{
					stick_hmag = global.stick_mag;
				}
			}
			if (abs(global.stick_ly) >= abs(global.stick_lx))
			{
				key_up = key_up || global.stick_ly < 0;
				key_down = key_down || global.stick_ly > 0;
				if (global.flag[960] == 1)
				{
					stick_vmag = global.stick_mag;
				}
			}
		}
		vinput = key_down - key_up;
		hinput = key_right - key_left;
		var _xfree = global.input_g[6] != gp_face3;
		if (global.flag[25] == 0)
		{
			press_jump = button2_p() || (_xfree && button4_p());
			key_jump = button2_h() || (_xfree && button4_h());
			press_attack = button1_p() || (!_xfree && button4_p());
			key_attack = button1_h() || (!_xfree && button4_h());
		}
		else
		{
			press_jump = button1_p() || (!_xfree && button4_p());
			key_jump = button1_h() || (!_xfree && button4_h());
			press_attack = button2_p() || (_xfree && button4_p());
			key_attack = button2_h() || (_xfree && button4_h());
		}
	}
	else
	{
		key_left = false;
		key_right = false;
		key_up = false;
		key_down = false;
		press_left = false;
		press_right = false;
		press_up = false;
		press_down = false;
		vinput = 0;
		hinput = 0;
		stick_hmag = 1;
		stick_vmag = 1;
		press_jump = false;
		key_jump = false;
		press_attack = false;
		key_attack = false;
	}
}
