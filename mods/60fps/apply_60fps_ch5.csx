Apply("gml_Object_obj_flowery_act_menu_controller_Draw_0", @"if (button2_p() && i_ex(obj_flowery_act_menu_heart) && obj_flowery_act_menu_heart.chargecon == 0 && con != 2)
{
	with (obj_battlecontroller)
	{
		global.bmenucoord[9][global.charturn] = 0;
		global.tensionselect = 0;
		global.bmenuno = 11;
		twobuffer = 1;
		movenoise = 1;
	}
	with (obj_flowery_act_menu_heart)
	{
		instance_destroy();
	}
	with (obj_flowery_act_menu_choice)
	{
		instance_destroy();
	}
	instance_destroy();
}
if (con == 0 && !i_ex(obj_moveheart) && i_ex(obj_flowery_enemy))
{
	act_choice[0] = instance_create(camerax() + 370, (cameray() + 400) - 60, obj_flowery_act_menu_choice);
	act_choice[1] = instance_create(camerax() + 370, (cameray() + 400) - 30, obj_flowery_act_menu_choice);
	act_choice[2] = instance_create(camerax() + 370, cameray() + 400, obj_flowery_act_menu_choice);
	act_choice[3] = instance_create(camerax() + 370, cameray() + 400 + 30, obj_flowery_act_menu_choice);
	act_choice[4] = instance_create(camerax() + 370, cameray() + 400 + 60, obj_flowery_act_menu_choice);
	if (obj_flowery_enemy.phase == 2)
	{
		act_choice[0].act_text = ""BlowAwayZ"";
		act_choice[0].correct_answer = true;
		act_choice[1].act_text = ""BlowAwayF"";
		act_choice[2].act_text = ""BlowAwayF"";
		act_choice[3].act_text = ""BlowAwayF"";
		act_choice[4].act_text = ""BlowAwayF"";
	}
	if (obj_flowery_enemy.phase == 3)
	{
		act_choice[0].act_text = ""SpinF"";
		act_choice[1].act_text = ""SpinF"";
		act_choice[2].act_text = ""SpinZ"";
		act_choice[2].correct_answer = true;
		act_choice[3].act_text = ""SpinF"";
		act_choice[4].act_text = ""SpinF"";
	}
	if (obj_flowery_enemy.phase == 4)
	{
		act_choice[0].act_text = ""PraiseF"";
		act_choice[1].act_text = ""PraiseF"";
		act_choice[2].act_text = ""PraiseF"";
		act_choice[3].act_text = ""PraiseF"";
		act_choice[4].act_text = ""PraiseZ"";
		act_choice[4].correct_answer = true;
	}
	con = 1;
}
if (con == 2)
{
	timer += (1 / global.fps_scale);
	if (timer == 20)
	{
		with (obj_battlecontroller)
		{
			onebuffer = 2;
			selnoise = 1;
			global.bmenuno = 0;
			global.actingchoice[global.charturn] = 2;
			global.tensionselect = 0;
			scr_actselect(obj_flowery_enemy.myself, 2);
			global.bmenucoord[9][global.charturn] = 0;
			scr_endturn();
		}
		with (obj_flowery_act_menu_heart)
		{
			instance_destroy();
		}
		with (obj_flowery_act_menu_choice)
		{
			instance_destroy();
		}
		instance_destroy();
	}
}
if (!surface_exists(my_surface))
{
	my_surface = surface_create(300, 200);
}
surface_set_target(my_surface);
draw_clear_alpha(c_black, 0);
scr_84_set_draw_font(""mainbig"");
with (obj_flowery_act_menu_choice)
{
	if (con == 0 || con == 2)
	{
		draw_text_ext_transformed_color(x - camerax() - 190, y - cameray() - 367 - (string_height(act_text) / 4), act_text, 9999, 9999, 1, 1, 0, image_blend, image_blend, image_blend, image_blend, 1);
	}
}
surface_reset_target();
draw_surface(my_surface, camerax() + 190, cameray() + 366);
");

Apply("gml_Object_obj_flowery_act_menu_heart_Draw_0", @"siner++;
image_blend = c_orange;
for (var a = 9; a >= 0; a--)
{
	if (a > 0)
	{
		if (!(abs(prev_coord[a][0] - prev_coord[a - 1][0]) < 1))
		{
			draw_sprite_ext(sprite_index, image_index, prev_coord[a][0], prev_coord[a][1], image_xscale, image_yscale, image_angle, image_blend, 0.55 - (a * 0.05));
		}
	}
	else
	{
		draw_sprite_ext(sprite_index, image_index, prev_coord[a][0], prev_coord[a][1], image_xscale, image_yscale, image_angle, image_blend, 0.55 - (a * 0.05));
	}
}
if (dashstate == 1 && chargetimer < 16)
{
	var z_charge = (chargetimer * 2) % 35;
	for (var i = 0; i < 4; i += 1)
	{
		var alf = (chargetimer / 10) - 0.2;
		var rotx = (i * 90) + (z_charge * 5);
		var xx = sin(degtorad(rotx)) * (35 - z_charge);
		var yy = cos(degtorad(rotx)) * (35 - z_charge);
		draw_sprite_ext(spr_yheart_charge, 0, (x + 9) - xx, (y + 10) - yy, 4 - ((z_charge * 2) / 35), 4 - ((z_charge * 2) / 35), 0, c_white, alf);
	}
}
if (shakeheart)
{
	shakeheart--;
}
draw_sprite_ext(sprite_index, image_index, x + (choose(-1, 0, 1) * sign(shakeheart)), y + (choose(-1, 0, 1) * sign(shakeheart)), image_xscale, image_yscale, image_angle, image_blend, image_alpha);
if (dashstate == 1 && chargetimer == 16)
{
	glowtimer += (0.5 / global.fps_scale);
	draw_sprite_ext(spr_orangeheart_white, 0, x, y, image_xscale, image_yscale, image_angle, c_white, 0.5 + (sin(glowtimer) * 0.5));
}
if (dashstate == 2)
{
	draw_sprite_ext(spr_orangeheart_dash, global.time / global.fps_scale, x - 2, y, (image_xscale * 1.25) - (0.45 + (sin((global.time / global.fps_scale) * 1.5) * 0.2)), image_yscale, image_angle, image_blend, 0.45 + (sin((global.time / global.fps_scale) * 1.5) * 0.2));
	gpu_set_fog(true, c_yellow, 0, 0);
	draw_sprite_ext(spr_orangeheart_dash, global.time / global.fps_scale, x - 2, y, (image_xscale * 1.25) - (0.225 + (sin((global.time / global.fps_scale) * 1.5) * 0.1)), image_yscale, image_angle, image_blend, 0.225 + (sin((global.time / global.fps_scale) * 1.5) * 0.1));
	draw_sprite_ext(spr_orangeheart_white, 0, x, y, image_xscale, image_yscale, image_angle, c_white, 0.45 + (sin((global.time / global.fps_scale) * 1.5) * 0.2));
	gpu_set_fog(false, c_white, 0, 0);
}
");

Apply("gml_Object_obj_flowery_act_menu_heart_Step_0", @"if (chargecon == 0 && !shakeheart)
{
	if (button1_h())
	{
		chargecon = 1;
		loop_sound = snd_loop(snd_chargeshot_charge);
		snd_pitch(loop_sound, 0.25);
		snd_volume(loop_sound, 0.5, 0);
		chargetimer = 0;
		glowtimer = 0;
	}
}
if (chargecon == 1)
{
	if (button1_h())
	{
		dashstate = 1;
		chargetimer = scr_approach(chargetimer, 16, 1);
		snd_pitch(loop_sound, min(0.5 + (chargetimer * 0.05), 1));
	}
	else if (chargetimer == 16)
	{
		snd_stop(loop_sound);
		snd_play(snd_explosion_mmx3, 0.5, 2);
		chargecon = 2;
		dashtimer = 0;
	}
	else
	{
		chargetimer = 8 + (chargetimer * 0.5);
		snd_stop(loop_sound);
		snd_play(snd_explosion_mmx3, 0.5, 2);
		chargecon = 2;
		dashtimer = 0;
	}
}
if (chargecon == 2)
{
	x = basex + chargedistance;
	chargecon = 3;
}
if (chargecon == 3)
{
	chargetimer = 0;
	dashtimer += (1 / global.fps_scale);
	x = lerp_ease_out(x, basex, dashtimer / 15, 2);
	if (dashtimer >= 15)
	{
		x = basex;
		chargecon = 0;
		dashtimer = 0;
	}
}
");

Apply("gml_Object_obj_flowery_battle_transition_Step_0", @"var _delay = quick ? 30 : 80;
if (fightcon == 0 && i_ex(obj_encounterbasic))
{
	if (obj_encounterbasic.counttimer < 9 && obj_encounterbasic.fightcon == 1)
	{
		obj_encounterbasic.counttimer = 9;
	}
	if (quick)
	{
		scr_debug_print(""Quick transition"");
	}
	with (obj_towery_orbiter)
	{
		if (hero == 0)
		{
			sprite_index = spr_krisb_intro;
			image_speed = 0.5 / global.fps_scale;
			scr_var_delayed(""sprite_index"", 2190, 35);
		}
		if (hero == 1)
		{
			sprite_index = spr_susieb_attack;
			image_speed = 0.5 / global.fps_scale;
			scr_var_delayed(""image_speed"", 0, 10);
		}
		if (hero == 2)
		{
			xoff = xoffset[hero];
			yoff = yoffset[hero];
			sprite_index = spr_ralsei_begin_battle_serious;
			image_speed = 0.5 / global.fps_scale;
			scr_var_delayed(""sprite_index"", 2450, 32);
		}
	}
	fightcon = 1;
}
if (con >= 0)
{
	with (obj_flowery_towery_pillars)
	{
		if (!visible)
		{
			visible = true;
		}
		active = true;
	}
	var _tower = 921;
	var _towerscroll = 3600;
	if (!i_ex(obj_towery_orbiter))
	{
		with (instance_create(0, 0, obj_towery_orbiter))
		{
			visible = false;
		}
		with (instance_create(0, 0, obj_towery_orbiter))
		{
			sprite_index = spr_susieb_idle_serious;
			hero = 1;
			rotation += 60;
			visible = false;
		}
		with (instance_create(0, 0, obj_towery_orbiter))
		{
			sprite_index = spr_ralsei_idle_mad;
			hero = 2;
			rotation += 120;
			visible = false;
		}
		with (obj_towery_orbiter)
		{
			duration = _delay;
		}
	}
	if (con == 0)
	{
		with (obj_towery_orbiter)
		{
			height = 0;
			con = 0;
			prog = 0;
		}
	}
	if (con == 1)
	{
		with (obj_towery_orbiter)
		{
			con = 1;
			_tower.height = -_towerscroll;
			_tower.spin = 0;
			prog = 0;
			_tower.petals = true;
			_tower.rotation = 0;
			with (obj_towery_particle)
			{
				instance_destroy();
			}
			if (hero == 0)
			{
				xoff = xoffset[hero] - 1;
				yoff = yoffset[hero] - 4;
				sprite_index = spr_kris_idleu_windr;
			}
			if (hero == 1)
			{
				xoff = xoffset[hero] - 7;
				yoff = yoffset[hero] + 1;
				sprite_index = spr_susie_idleu_windr;
			}
			if (hero == 2)
			{
				xoff = xoffset[hero] - 13;
				yoff = yoffset[hero] - 7;
				sprite_index = spr_ralsei_idleu_windr;
			}
		}
	}
	if (con == 2)
	{
		var _quickly = other.quick;
		with (_tower)
		{
			height = -_towerscroll;
			if (other.quick)
			{
				scr_lerpvar(""spin"", 0, 1, 80, 2, ""inout"");
			}
			else
			{
				scr_lerpvar(""spin"", 0, 4, 80, 2, ""inout"");
			}
			scr_lerpvar(""height"", -_towerscroll, 0, _delay + 80, 2, ""inout"");
			petals = true;
			scr_var_delay(""petals"", false, _delay + 80);
		}
		with (obj_towery_orbiter)
		{
			scr_var_delayed(""visible"", true, 1);
			var _hold = _quickly ? 10 : 40;
			if (hero == 0)
			{
				sprite_index = spr_kris_idleu_windr;
				scr_var_delayed(""sprite_index"", 2158, _hold);
			}
			else if (hero == 1)
			{
				sprite_index = spr_susie_idleu_windr;
				scr_var_delayed(""sprite_index"", 2260, _hold);
			}
			else if (hero == 2)
			{
				sprite_index = spr_ralsei_idleu_windr;
				scr_var_delayed(""xoff"", 0, _hold);
				scr_var_delayed(""yoff"", -6, _hold);
				scr_var_delayed(""sprite_index"", 6503, _hold);
			}
			if (other.quick)
			{
				quick = true;
				scr_delay_var(""con"", 2, 20);
			}
			else
			{
				scr_delay_var(""con"", 2, 40);
			}
			con = 1;
			prog = hero * -4;
		}
	}
	if (con == 3)
	{
		_tower.height = 0;
		_tower.spin = 1;
		with (obj_towery_orbiter)
		{
			prog = 120;
			con = 2;
			distance = 300;
			init = false;
		}
	}
	con = -1;
}
with (obj_encounterbasic)
{
	for (var i = 0; i < array_length(c); i++)
	{
		with (c[i])
		{
			visible = 0;
		}
	}
}
");

