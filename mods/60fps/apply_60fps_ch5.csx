Apply("gml_Object_obj_dw_fcastle_obscured_bullets_Step_0", @"if (!init)
{
	with (obj_plat_fusumawall)
	{
		if (extflag == ""lastfusuma"")
		{
			parallax = 0;
		}
	}
	with (obj_plat_coin)
	{
		scr_plat_depthcast();
	}
	with (obj_castlereflect_manager)
	{
		add_reflection(other.npc_sign.marker);
		if (instance_exists(other.npc_seth_atstart))
		{
			add_reflection(other.npc_seth_atstart.marker);
		}
		if (instance_exists(other.npc_netskie_left))
		{
			add_reflection(other.npc_netskie_left.marker);
			add_reflection(other.npc_netskie_right.marker);
			add_reflection(other.npc_orange_backtrack.marker);
		}
	}
	if (global.flag[1455] == 100)
	{
		with (obj_plat_fusumawall)
		{
			if (extflag == ""lastfusuma"")
			{
				instance_destroy();
			}
			if (extflag == ""breakafter"")
			{
				con = 1;
				destroyed = true;
				var li = ds_list_create();
				instance_place_list(x, y, 708, li, false);
				if (ds_list_size(li) > 0)
				{
					var i = ds_list_size(li) - 1;
					while (i >= 0)
					{
						if (ds_list_find_value(li, i).extflag == ""shadowplatform"")
						{
							instance_destroy(ds_list_find_value(li, i));
						}
						i--;
					}
				}
				ds_list_destroy(li);
			}
		}
	}
	init = 1;
	scr_miniface_init_flowers();
	with (obj_orange_puppet)
	{
		if (follow_mode == 0)
		{
			image_alpha = 0;
		}
		if (other.talkstartcon == 0)
		{
			image_alpha = 0;
			with (puppet)
			{
				x = 20;
				y = 15;
				image_xscale = 0.4;
				image_yscale = 0.4;
				angle = 0;
			}
			animinit = 0;
			puppetmovement = 0;
			preset = 0;
		}
	}
	if (talkstartcon == 2)
	{
		with (obj_orange_puppet)
