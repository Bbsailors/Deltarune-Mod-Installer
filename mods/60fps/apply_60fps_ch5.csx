get_fadecolor = function()
{
	var basecolor = c_black;
	switch (pal_index)
	{
		case 0:
			basecolor = #CD4451;
			break;
		case 1:
			basecolor = #422464;
			break;
		case 2:
			basecolor = #458E6C;
			break;
		case 3:
			basecolor = #8F3DC6;
			break;
		case 4:
			basecolor = #FC4435;
			break;
		case 5:
			basecolor = #4A85D3;
			break;
		case 6:
			basecolor = #FFA58A;
			break;
		case 7:
			basecolor = #BC4491;
			break;
	}
	return merge_color(basecolor, c_black, 1 - (0.25 * suny));
};

if (music_mode || non_music_shade_mode)
