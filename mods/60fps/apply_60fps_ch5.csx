	{
		x: kr2.x - 6,
		y: kr2.y + 32
	};
	var ra3 = 
	{
		x: kr2.x - 2,
		y: kr2.y + 84
	};
	var suwait2 = scr_returnwait_instance(su2, su3, 4);
	var rawait2 = scr_returnwait_instance(ra2, ra3, 4);
	c_sel(su);
	c_walkto(su3, suwait2, ""u"");
	c_sel(ra);
	c_walkto(ra3, rawait2, ""u"");
	var dawait2 = max(suwait2, rawait2);
	c_panobj_fancy(kr_actor, dawait2);
	c_wait(dawait2);
	c_wait(1);
	c_pannable(0);
	c_actortoparty();
	c_terminatekillactors();
}
