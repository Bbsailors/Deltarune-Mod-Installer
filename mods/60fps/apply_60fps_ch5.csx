pink_battle_dialogue28 = stringsetloc(""Let's date,&mew!"", ""obj_pink_enemy_slash_Create_0_gml_190_0"");
pink_battle_dialogue29 = stringsetloc(""I like&them^1, mew!"", ""obj_pink_enemy_slash_Create_0_gml_191_0"");
pink_battle_dialogue30 = stringsetloc(""I want a&new hat,&mew!"", ""obj_pink_enemy_slash_Create_0_gml_192_0"");
pink_battle_dialogue31 = stringsetloc(""I want to&go to&Planetarium!!"", ""obj_pink_enemy_slash_Create_0_gml_193_0"");
pink_battle_dialogue32 = stringsetloc(""I want&Stinky&Fish!"", ""obj_pink_enemy_slash_Create_0_gml_194_0"");
pink_battle_dialogue32b = stringsetloc(""I want&Yogurt Mushroom!"", ""obj_pink_enemy_slash_Create_0_gml_195_0"");
pink_battle_dialogue32c = stringsetloc(""I want to&be a normal girl!"", ""obj_pink_enemy_slash_Create_0_gml_196_0"");
pink_battle_dialogue32d = stringsetloc(""Let's go&back to school,&mew!"", ""obj_pink_enemy_slash_Create_0_gml_197_0"");
pink_battle_dialogue32e = stringsetloc(""Listen^1, BODY!!!&WE^1! Are PINK!/%"", ""obj_pink_enemy_slash_Create_0_gml_198_0"");
pink_battle_dialogue32f = stringsetloc(""And we're NEVER&going on a DATE&AGAIN^1, got it!?/%"", ""obj_pink_enemy_slash_Create_0_gml_199_0"");
pink_battle_dialogue32g = stringsetloc(""Doki meter&MAX, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_201_0"");
pink_battle_dialogue32h = stringsetloc(""NO!!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_202_0"");
pink_battle_dialogue32i = stringsetloc(""Time for&special&sequence.../%"", ""obj_pink_enemy_slash_Create_0_gml_203_0"");
pink_battle_dialogue32j = stringsetloc(""NO!^1! STOP!^1! &GET THIS STUFF&OUT OF HERE!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_205_0"");
pink_battle_dialogue32k = stringsetloc(""WHY DO YOU EVEN&NEED A DOG RADAR!?/%"", ""obj_pink_enemy_slash_Create_0_gml_206_0"");
pink_battle_dialogue33 = stringsetloc(""Look what you&did, you stupid&BODY! Now we're&not even together!/%"", ""obj_pink_enemy_slash_Create_0_gml_210_0"");
pink_battle_dialogue34 = stringsetloc(""Mew!!! Let's&date, mew!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_211_0"");
pink_battle_dialogue35 = stringsetloc(""It's YOU! You&guys are making&her act funny&Die. Die! DIE!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_212_0"");
pink_battle_dialogue36 = stringsetloc(""I want Yogurt&Mushroom, mew!!/%"", ""obj_pink_enemy_slash_Create_0_gml_214_0"");
pink_battle_dialogue37 = stringsetloc(""What the heck&is happening!?&Why are we SPLIT!?/%"", ""obj_pink_enemy_slash_Create_0_gml_215_0"");
pink_battle_dialogue38 = stringsetloc(""Umm... you're a&GHOST LIGHTNER...&and that \""body\""&you found.../%"", ""obj_pink_enemy_slash_Create_0_gml_216_0"");
pink_battle_dialogue39 = stringsetloc(""Seems to have&become a DARKNER&of its own./%"", ""obj_pink_enemy_slash_Create_0_gml_217_0"");
pink_battle_dialogue40 = stringsetloc(""What!?/%"", ""obj_pink_enemy_slash_Create_0_gml_218_0"");
pink_battle_dialogue41 = stringsetloc(""Pink, your BODY...&it's...&its own person,&too./%"", ""obj_pink_enemy_slash_Create_0_gml_220_0"");
pink_battle_dialogue41b = stringsetloc(""It has its own&likes... its&own dislikes./%"", ""obj_pink_enemy_slash_Create_0_gml_221_0"");
pink_battle_dialogue41c = stringsetloc(""No.../%"", ""obj_pink_enemy_slash_Create_0_gml_222_0"");
pink_battle_dialogue41d = stringsetloc(""No... NO, it&can't be! It's&ME! It needs to do&what I SAY!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_224_0"");
pink_battle_dialogue41e = stringsetloc(""Because what it&WANTS, is STUPID!/%"", ""obj_pink_enemy_slash_Create_0_gml_225_0"");
pink_battle_dialogue41f = stringsetloc(""I want to eat&sand on the&beach with you,&mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_226_0"");
pink_battle_dialogue_new_p3_1 = stringsetloc(""No... no!&NO!!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_257_0_b"");
pink_battle_dialogue_new_p3_2 = stringsetloc(""You can't DOKI!!!&You're not allowed!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_258_0_b"");
pink_battle_dialogue_new_p3_3 = stringsetloc(""I... I'll&stop you.../%"", ""obj_pink_enemy_slash_Create_0_gml_259_0_b"");
pink_battle_dialogue_new_p3_4 = stringsetloc(""NO MATTER WHAT!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_260_0"");
pink_battle_dialogue41g = stringsetloc(""Doki level&MAX, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_228_0"");
pink_battle_dialogue41h = stringsetloc(""No, no, NO!!&Not this AGAIN!!/%"", ""obj_pink_enemy_slash_Create_0_gml_229_0"");
pink_battle_dialogue41i = stringsetloc(""STOP!!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_231_0"");
pink_battle_dialogue42 = stringsetloc(""Want to...&date... mew.../%"", ""obj_pink_enemy_slash_Create_0_gml_237_0"");
pink_battle_dialogue43 = stringsetloc(""Wh... what's &happening&to her!?&To... to me!?/%"", ""obj_pink_enemy_slash_Create_0_gml_238_0"");
pink_battle_dialogue44 = stringsetloc(""Her heart...&it can't take&doing the dates&alone!/%"", ""obj_pink_enemy_slash_Create_0_gml_239_0"");
pink_battle_dialogue45 = stringsetloc(""The body...&it needs you&to survive!/%"", ""obj_pink_enemy_slash_Create_0_gml_240_0"");
pink_battle_dialogue46 = stringsetloc(""Then... if I&don't hurry&and get rid&of you guys.../%"", ""obj_pink_enemy_slash_Create_0_gml_241_0"");
pink_battle_dialogue47 = stringsetloc(""... don't you.../%"", ""obj_pink_enemy_slash_Create_0_gml_242_0"");
pink_battle_dialogue48 = stringsetloc(""Don't you think&your body&deserves a say,&too!?/%"", ""obj_pink_enemy_slash_Create_0_gml_243_0"");
pink_battle_dialogue49 = stringsetloc(""Date...&mew.../%"", ""obj_pink_enemy_slash_Create_0_gml_245_0"");
pink_battle_dialogue50 = stringsetloc(""Go... back&to school...&mew.../%"", ""obj_pink_enemy_slash_Create_0_gml_246_0"");
pink_battle_dialogue51 = stringsetloc(""Have friends...&mew.../%"", ""obj_pink_enemy_slash_Create_0_gml_247_0"");
pink_battle_dialogue52 = stringsetloc(""Why can't...&it just be us?/%"", ""obj_pink_enemy_slash_Create_0_gml_249_0"");
