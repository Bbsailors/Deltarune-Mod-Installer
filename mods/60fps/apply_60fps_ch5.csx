		with (obj_dmgwriter)
		{
			if (typeb == 1)
			{
				killamount = 1;
				killtimer = 35;
			}
		}
		global.typer = 6;
		global.fc = 0;
		if (obj_orange_enemy.uppercut_life == uppercut_life_previous)
		{
			have_catched_all_food_each_turn++;
		}
		else
		{
			have_catched_all_food_each_turn = 0;
		}
		if (have_catched_all_food_each_turn == 1)
		{
			heroes_shake = 1;
		}
		else if (have_catched_all_food_each_turn == 2)
		{
			heroes_shake = 2;
		}
		else if (have_catched_all_food_each_turn >= 3)
		{
			heroes_shake = 3;
		}
		else
		{
			heroes_shake = 0;
		}
		rr = choose(0, 1, 2);
		if (heroes_shake > 0)
		{
			if (still_battlemsg == 0)
			{
				global.battlemsg[0] = stringsetloc(""* It's getting very hard to stay still!"", ""obj_orange_green_controller_slash_Step_0_gml_295_0"");
				still_battlemsg = 1;
			}
		}
		else if (i_ex(obj_orange_enemy) && obj_orange_enemy.uppercut_life <= 0)
		{
			if (rr == 0)
			{
				global.battlemsg[0] = stringsetloc(""* ORANGE has acquired all yummies!"", ""obj_orange_green_controller_slash_Step_0_gml_301_0"");
			}
			if (rr == 1)
			{
				global.battlemsg[0] = stringsetloc(""* ORANGE's power has gone from OMEGA-1 to OMEGA-3! "", ""obj_orange_green_controller_slash_Step_0_gml_302_0"");
			}
			if (rr == 2)
			{
				global.battlemsg[0] = stringsetloc(""* ORANGE's gloves are bursting with limited time flavors!"", ""obj_orange_green_controller_slash_Step_0_gml_303_0"");
			}
		}
		else if (irandom(100) < 3)
		{
			global.battlemsg[0] = stringsetloc(""* Smells like flowers."", ""obj_orange_green_controller_slash_Step_0_gml_307_0"");
		}
		else
		{
			if (rr == 0)
			{
				global.battlemsg[0] = stringsetloc(""* Green waves at Susie^1. Susie waves back^1. Green waves again^1. Ralsei waves back."", ""obj_orange_green_controller_slash_Step_0_gml_310_0"");
			}
			if (rr == 1)
			{
				global.battlemsg[0] = stringsetloc(""* Ralsei makes heart hands at Green!&* Green gives a thumbs up!&* Ralsei changes to a thumbs up!"", ""obj_orange_green_controller_slash_Step_0_gml_311_0"");
			}
			if (rr == 2)
			{
				global.battlemsg[0] = stringsetloc(""* Susie shows off her apron from the cooking game!&* Green claps pleasantly!"", ""obj_orange_green_controller_slash_Step_0_gml_312_0"");
			}
		}
		setbattlemsg = true;
		with (obj_orange_enemy)
		{
			obj_orange_enemy.x = xstart;
			obj_orange_enemy.y = ystart;
			state = 0;
			show_uppercut_life = false;
		}
		with (obj_omelet_marker)
		{
			instance_destroy();
		}
		with (obj_regularbullet)
		{
			instance_destroy();
		}
		with (obj_bullet_healing)
		{
			instance_destroy();
		}
		with (obj_orange_enemy)
		{
			show_omelet_ring = true;
		}
		if (global.mercymod[obj_orange_enemy.myself] >= 100 || global.mercymod[obj_green_enemy.myself] >= 100)
		{
			endcon = 1;
			with (obj_orange_enemy)
			{
				show_omelet_ring = false;
			}
			with (obj_dmgwriter)
			{
				if (delaytimer >= 1)
				{
					killactive = 1;
				}
			}
			for (i = 0; i < 3; i++)
			{
				if (global.hp[i + 1] <= 0)
				{
					var _hltarget = global.char[i];
					var _curhp = global.hp[_hltarget];
					var _healpower;
					if (_curhp <= 0)
					{
						_healpower = -_curhp + 5;
					}
					else
					{
						_healpower = 1;
					}
					scr_heal(i, _healpower);
					with (global.charinstance[i])
					{
						ha = instance_create(x, y, obj_healanim);
						ha.target = id;
						dmgwr = scr_dmgwriter_selfchar();
						with (dmgwr)
						{
							delay = 8;
							type = 3;
							damage = _healpower;
						}
						if (global.hp[global.char[myself]] >= global.maxhp[global.char[myself]])
						{
							with (dmgwr)
							{
								specialmessage = 3;
							}
						}
						tu += 1;
					}
				}
			}
			for (i = 0; i < 3; i++)
			{
				with (global.charinstance[i])
				{
					tu--;
				}
			}
		}
		if (obj_orange_enemy.uppercut_life < uppercut_life_previous)
		{
		}
	}
