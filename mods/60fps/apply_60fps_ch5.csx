		image_speed = 0.25;
		timer = 0;
		custom_behaviour(function()
		{
			depth = 1394300;
			timer++;
			if (animstate < 2)
			{
				x = aqua_anchor_x;
				y = aqua_anchor_y + (sin(degtorad(timer * 45 * image_speed)) * 8);
			}
			if ((timer % (4 * global.fps_scale)) == 0 && scr_onscreen_tolerance(self, 50))
			{
