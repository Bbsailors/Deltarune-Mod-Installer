Apply("gml_Object_obj_draw_at_depth_Create_0", @"if (!boss)
{
	exit;
}
copy_surface = -4;
startdepth = depth;
depth = startdepth - 1;
helper_marker = instance_create(0, 0, obj_marker_fancy);
helper_marker.owner = id;
helper_marker.depth = depth + 1;
with (helper_marker)
{
	draw_func = function()
	{
		with (owner)
		{
			if (!surface_exists(copy_surface))
			{
				copy_surface = surface_create(640, 480);
			}
			if (surface_exists(application_surface))
			{
				surface_set_target(copy_surface);
				gpu_set_blendenable(false);
				draw_surface_ext(application_surface, 0, 0, 640 / surface_get_width(application_surface), 480 / surface_get_height(application_surface), 0, c_white, 1);
				gpu_set_blendenable(true);
				surface_reset_target();
			}
		}
	};
}
");

Apply("gml_Object_obj_dummyenemy_Draw_0", @"if (state == 3)
{
	global.monsterstatus[myself] = 1;
	if (global.monstercomment[myself] == "" "")
	{
		global.monstercomment[myself] = ""(Tired)"";
	}
	hurttimer -= (1 / global.fps_scale);
	if (hurttimer < 0)
	{
		state = 0;
	}
	else
	{
		if (global.monster[myself] == 0)
		{
		}
		hurtshake += 1;
		if (hurtshake > 1)
		{
			if (shakex > 0)
			{
				shakex -= (1 / global.fps_scale);
			}
			if (shakex < 0)
			{
				shakex += (1 / global.fps_scale);
			}
			shakex = -shakex;
			hurtshake = 0;
		}
		draw_sprite_ext(sprite_index, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
	}
}
if (state == 0)
{
	siner += (1 / global.fps_scale);
	thissprite = sprite_index;
	if (global.mercymod[myself] >= global.mercymax[myself])
	{
		thissprite = sprite_index;
	}
	draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
	if (flash == 1)
	{
		fsiner += (1 / global.fps_scale);
		d3d_set_fog(true, c_white, 0, 1);
		draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
		d3d_set_fog(false, c_black, 0, 0);
	}
}
if (becomeflash == 0)
{
	flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_dummyenemy_Step_0", @"if (ambushed == 0)
{
	scr_ambush();
	ambushed = 1;
}
if (plot != 3)
{
	global.charmove[0] = 1;
	global.charmove[1] = 0;
	if (global.charspecial[0] == 100)
	{
		spare_used = 1;
	}
