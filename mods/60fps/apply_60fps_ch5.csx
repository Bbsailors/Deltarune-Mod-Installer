parallax_distance = 1 / (parallax_distance * parallax_distance);
speedX = parallax_distance;
speedY = parallax_distance;
sun_visible = true;
cliff_layer = layer_get_id(""CLIFFS"");

turn_sun_into_fox = function()
{
	var xx = camerax() + 320 + (sunx * 200);
	var yy = (((cameray() + 280) - 40) + extra_y_offset) - (suny * 80);
	var fox = instance_create(xx, yy, obj_dw_garden_secretfox);
	fox.fromsun = true;
	with (fox)
	{
		appear(false);
	}
};

restore_sun_from_fox = function(arg0)
{
	suny = 0;
	with (arg0)
	{
		instance_destroy();
	}
};

hidden_by_battle = false;

set_visible = function(arg0)
{
	visible = arg0;
	with (lay_sun)
	{
		visible = arg0;
	}
	if (arg0)
	{
		for (var i = 0; i < array_length(cliff_layers); i++)
		{
			if (layer_exists(cliff_layers[i]))
			{
				layer_script_begin(cliff_layers[i], scr_cliffcolour_start);
				layer_script_end(cliff_layers[i], scr_cliffcolour_end);
			}
		}
	}
	else
	{
		var empty_function = function()
		{
		};
		
		for (var i = 0; i < array_length(cliff_layers); i++)
		{
			if (layer_exists(cliff_layers[i]))
			{
				layer_script_begin(cliff_layers[i], empty_function);
				layer_script_end(cliff_layers[i], empty_function);
			}
		}
	}
	with (moving_layers)
	{
		visible = arg0;
	}
	for (var i = 0; i < layercount; i++)
	{
		if (layers[i] != -4)
		{
			layers[i].visible = arg0;
			layer_set_visible(layers[i].layerid, arg0);
		}
	}
	if (has_cave_walls)
	{
		layer_set_visible(sky.layerid, arg0);
		sky.visible = arg0;
	}
	if (has_fountain)
	{
		layer_set_visible(fountain.layerid, arg0);
		fountain.visible = arg0;
	}
	if (has_moving_sky)
	{
		layer_set_visible(sky.layerid, arg0);
		layer_set_visible(sky2.layerid, arg0);
		sky.visible = arg0;
		sky2.visible = arg0;
	}
};

layercount = array_length(layers);
autoscroll_amt = 0;
autoscroll_speed = 0;
");

Apply("gml_Object_obj_parallax_cliffs_Draw_76", @"if (!visible)
{
	exit;
}
var cx = 0;
var cy = 0;
struct_layer_count = array_length(struct_bgs);
if (instance_exists(obj_plat_camera))
{
	cx = obj_plat_camera.x - 320;
	cy = obj_plat_camera.y - 240;
}
else
{
	cx = camerax();
	cy = cameray();
}
var ys = array_get(scr_platswap_yscale(), 0);
if (!global.pause_plat)
{
	autoscroll_amt += (autoscroll_speed / global.fps_scale);
}
if (cliff_layer != -1)
{
	x = (cx * speedX) + xstart;
	y = (cy * speedY) + ystart;
	var newx = round(x);
	var newy = round(y);
	layer_x(cliff_layer, newx);
	layer_y(cliff_layer, newy);
}
if (has_fountain)
{
	fountain.x = cx + 454;
	fountain.y = cy;
}
if (cx != last_camerax)
{
	var dashchar = 1662;
	if (!instance_exists(dashchar))
	{
		dashchar = 912;
		with (obj_plat_player)
		{
			if (dashing)
			{
				other.flowerx += ((other.flowerspeed * (hspeed / dashspeed) * -other.dash_speed_multiplier) / global.fps_scale);
			}
		}
	}
	else
	{
		with (obj_mainchara_dash)
		{
			other.flowerx += ((other.flowerspeed * (hspeed / runspeed_max) * -other.dash_speed_multiplier) / global.fps_scale);
		}
	}
	for (var i = 0; i < layercount; i++)
	{
		layers[i].xoffset += (flowerx - last_flowerx) * -(1 - layers[i].xpara);
	}
	var field_layer_count = array_length(struct_bgs);
	for (var i = 0; i < field_layer_count; i++)
	{
		struct_bgs[i].xoffset += (flowerx - last_flowerx) * -(1 - struct_bgs[i].xpara);
	}
}
cx = floor(cx);
cy += ((835 - horizon_offset_default) * ys);
for (var i = 0; i < struct_layer_count; i++)
{
	var lay = struct_bgs[i];
	var yoff = (ys * -560) + (-235 + horizon_offset_default);
	var y_orig_offset = (160 + horizon_offset_platswap) * ys;
	var diff = ((cx - last_camerax) * lay.xpara) - ((autoscroll_speed / global.fps_scale) * (1 - lay.xpara));
	lay.x += diff;
	lay.x += lay.xoffset;
	lay.xoffset = 0;
	lay.y = floor(cy * lay.ypara) + lay.yorig + (y_orig_offset * (1 - lay.ypara)) + lay.yoffset + yoff;
	if (lay.x < (cx - lay.swidth))
	{
		lay.x += lay.swidth;
	}
	if (lay.x < (cx - lay.swidth))
	{
		lay.x += lay.swidth;
	}
	if (lay.x > cx)
	{
		lay.x -= lay.swidth;
	}
	if (lay.x > cx)
	{
		lay.x -= lay.swidth;
	}
}
for (var i = 0; i < sun_glow_markers_arraysize; i++)
{
	var siner = sin((other.timer / 32) + (0.7853981633974483 * i)) * 0.05 * other.suny;
	var siner2 = sin((other.timer / 32) + (1.5707963267948966 * i)) * 0.05;
	with (sun_glow_markers[i])
	{
		image_xscale = start_xscale + siner;
		image_yscale = start_yscale + siner;
		image_alpha = (start_alpha + siner2) * other.suny;
	}
}
last_camerax = cx;
last_flowerx = flowerx;
");

Apply("gml_Object_obj_parallax_cliffs_Step_2", @"var _bg = scr_battlebg_fullalpha();
if (!hidden_by_battle && _bg)
{
	hidden_by_battle = true;
	if (visible)
	{
		set_visible(false);
	}
}
else if (hidden_by_battle && !_bg)
{
	hidden_by_battle = false;
	if (!visible)
	{
		set_visible(true);
	}
}
if (!visible)
{
	exit;
}
if (!global.pause_plat)
{
	timer += (1 / global.fps_scale);
}
if (music_mode && sun_visible)
{
	if (music_cache != global.currentsong[1])
	{
		musname = mus_get_name();
		music_cache = global.currentsong[1];
	}
	if (musname == ""cliff.ogg"")
	{
		trackpos = audio_sound_get_track_position(global.currentsong[1]);
		if (trackpos >= 0 && trackpos < track_segment_1 && suny > music_sun_y_min)
		{
			suny = lerp(suny, music_sun_y_min, music_sun_lerpspeed);
		}
		else if (trackpos >= track_segment_1 && trackpos < track_segment_2 && suny < 1)
		{
			suny = lerp(suny, 1, music_sun_lerpspeed);
		}
		else if (trackpos >= track_segment_2 && trackpos < track_segment_3 && suny > music_sun_y_min)
		{
			suny = lerp(suny, music_sun_y_min, music_sun_lerpspeed);
		}
		else if (trackpos >= track_segment_3 && suny < 1)
		{
			suny = lerp(suny, 1, music_sun_lerpspeed);
		}
		pal_index = 1 - suny;
	}
	else if (musname == ""rudebuster_boss.ogg"" || musname == ""meeting_flower.ogg"" || musname == ""Flowerman_Arrangement.ogg"")
	{
		suny = lerp(suny, 1, music_sun_lerpspeed);
		pal_index = 1 - suny;
	}
	else
	{
		suny = lerp(suny, music_sun_y_min, music_sun_lerpspeed);
		pal_index = 1 - suny;
	}
}
if (!sun_visible)
{
	suny = scr_approach(suny, 0, 0.1);
}
if (non_music_shade_mode)
{
	pal_index = 1 - suny;
}
if (has_moving_sky)
{
	sky.xoffset -= 0.6 / global.fps_scale;
	sky3.xoffset -= 0.6 / global.fps_scale;
	sky2.xoffset -= 1 / global.fps_scale;
	layer_background_alpha(sky3.bgid, 4 * suny);
}
");

