			{
				block = id;
			}
		}
		npc.inst = instance_create(block.x, block.y, obj_trigger_interact);
		scr_sizeexact(block.sprite_width, block.sprite_height, npc.inst);
		with (npc.inst)
		{
			strict = true;
			issolid = true;
			talked = 0;
		}
		npc.inst.marker = scr_marker_fromasset(findsprite(npc.sprite, ""NPC_TABLEGUESTS""));
