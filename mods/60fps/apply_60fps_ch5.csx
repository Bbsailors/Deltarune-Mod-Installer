		msgnextloc(""\\E2* I kept taking care of them all this time^1, but.../"", ""obj_ch5_DW45_slash_Step_0_gml_54_0"");
		msgnextloc(""\\E0* From now on^1, I'm going to do it for my own sake./"", ""obj_ch5_DW45_slash_Step_0_gml_55_0"");
		msgnextloc(""\\E3* ..^1. did you want to say something?/"", ""obj_ch5_DW45_slash_Step_0_gml_56_0"");
