						sprite_index = spr_smokepuff;
						image_speed = 2;
					}
					var _impacty = y - wall.y;
					with (wall)
					{
						break_wall(_impacty, other.image_angle);
					}
					with (instance_create(x, y, obj_animation))
					{
						depth = wall.depth - 5;
						sprite_index = spr_plat_orangewall_break;
						image_speed = 0.5 / global.fps_scale;
						scr_darksize();
						image_angle = other.image_angle;
						scr_lerpvar(""image_alpha"", 1, 0, 10);
					}
					var _radius = max(_impacty - wall.bbox_top, wall.bbox_bottom - _impacty);
					for (var i = 0; i < 16; i++)
					{
						var xx = wall.x;
						var yy = random_range(wall.bbox_top, wall.bbox_bottom);
						var paperscraps = instance_create_depth(xx, yy, wall.depth + 1, obj_marker_fancy);
						with (paperscraps)
						{
							sprite_index = choose(spr_plat_paperscraps_1, spr_plat_paperscraps_2, spr_plat_paperscraps_3, spr_plat_paperscraps_4, spr_plat_paperscraps_5);
							image_speed = random_range(0.2, 0.25) / global.fps_scale;
							var dir = 1;
							if (other.hit_angle >= 90 && other.hit_angle <= 270)
							{
								dir = -1;
							}
							var _dist = abs(yy - other.y);
							var _delay = round(scr_ease_out(_dist / _radius, 2) * 6);
							if (_delay > 0)
							{
								visible = false;
								scr_var_delay(""hspeed"", (random_range(6, 16) * dir) / global.fps_scale, _delay);
								scr_var_delay(""vspeed"", random_range(-3, 1) / global.fps_scale, _delay);
								scr_var_delay(""visible"", true, _delay);
							}
							else
							{
								hspeed = (random_range(6, 16) * dir) / global.fps_scale;
								vspeed = random_range(-3, 1) / global.fps_scale;
							}
							
							step_func = function()
							{
								if (!global.pause_plat)
								{
									hspeed *= power(0.92, 1 / global.fps_scale);
									if (abs(hspeed) < (6 / global.fps_scale))
									{
										vspeed = min(vspeed + (0.2 / (global.fps_scale * global.fps_scale)), 2 / global.fps_scale);
									}
								}
							};
							
							var doomtime = random_range(16, 34) + _delay;
							scr_lerpvar(""image_alpha"", 2 + (_delay / doomtime), 0, doomtime);
							scr_doom(self, doomtime);
						}
					}
					instance_destroy();
					if (other.superstrong)
					{
						destroy_self = true;
					}
				}
			}
			if (destroy_self)
			{
				instance_destroy();
			}
			else
			{
				bounces++;
				event_user(9);
				hit_angle = image_angle;
				snd_stop(snd_jump);
				snd_stop(snd_whack_absurdlyloud);
				snd_play(snd_jump, 0.4, 1.3);
				snd_play(snd_whack_absurdlyloud, 0.1, 1.3);
				repeat (4)
				{
					with (instance_create(x, y, obj_animation))
					{
						sprite_index = spr_plat_impact_splash;
						direction = lastdir + 180 + random_range(45, -45);
						speed = random_range(3, 12) / global.fps_scale;
						friction = 0.8 / (global.fps_scale * global.fps_scale);
						image_speed = 0.6 / global.fps_scale;
						image_angle = direction;
						image_blend = c_orange;
					}
				}
			}
		}
	}
}
if (instance_exists(obj_plat_player))
{
	if (point_distance(x, y, obj_plat_player.x, obj_plat_player.y) > 800)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_plat_enm_wallet_Create_0", @"event_inherited();
