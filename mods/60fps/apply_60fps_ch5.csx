bullets = 0;
hp = 9999;
hits = 0;
con = 0;
timer = 0;
rotation_speed = choose(-3, 3);
windimmune = true;
su_act.blocked = true;
petal_color = 16711935;

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	if (hit > 0)
	{
		exit;
	}
	hit = 10;
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	with (arg0)
	{
		do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
	}
	spawn_hit_petals(3, point_direction(arg0.x, arg0.y, x, y), 1);
	con = 1;
	timer = 0;
	gravity = 0;
	gravity_direction = 270;
	vspeed = (-12 / global.fps_scale) + obj_plat_player.vspeed;
	hspeed = (random_range(3, 6) * -sign(obj_plat_player.x - x)) / global.fps_scale;
	rotation_speed = random_range(55, 75) * sign(hspeed);
	scr_plat_vfx(3359);
	hits++;
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_hit_vfx;
		image_speed = 1;
	}
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_smokepuff;
		image_speed = 2;
	}
	if (hits == 2)
	{
		scr_plat_makecoins(x, y, -20, 90, 45, 8, 4);
		with (instance_create_depth(x, y, depth, obj_flowerdie))
		{
			speed = 5;
		}
		instance_destroy();
	}
};
");

Apply("gml_Object_obj_plat_enm_wallet_Step_0", @"if (!instance_exists(obj_plat_player))
{
	scr_flower_despwn();
}
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (con == 0)
{
	vspeed = -5 / global.fps_scale;
	image_angle += (rotation_speed / global.fps_scale);
}
if (x < (camerax() + (0.05 * camerawidth())))
{
	if (hspeed < 0)
	{
		rotation_speed *= -0.9;
		hspeed = -hspeed;
	}
}
if (x > (camerax() + (0.95 * camerawidth())))
{
	if (hspeed > 0)
	{
		rotation_speed *= -0.9;
		hspeed = -hspeed;
	}
}
hit -= (1 / global.fps_scale);
if (con == 1)
{
	image_index = 1;
	timer += (1 / global.fps_scale);
	vspeed += (0.3 / (global.fps_scale * global.fps_scale));
	image_angle += (rotation_speed / global.fps_scale);
	rotation_speed *= power(0.98, 1 / global.fps_scale);
	if (timer < 60 && (timer % 4) == 0)
	{
		scr_plat_makecoins(x, y, 1, 90, 45, 8, 4);
	}
}
if (y > (cameray() + cameraheight() + 60))
{
	instance_destroy();
}
");

