	c_msgnextloc(""* Everyone..^1. has spent their whole lives as flowers./"", ""obj_ch5_DW25_slash_Step_0_gml_123_0"");
	c_msgnextloc(""* Orange^1, Yellow^1, Blue^1, Green^1, Aqua^1, Seth.../"", ""obj_ch5_DW25_slash_Step_0_gml_124_0"");
	c_msgnextloc(""* Today^1, all of them^1, for the first time.../"", ""obj_ch5_DW25_slash_Step_0_gml_125_0"");
	c_msgnextloc(""* ..^1. have been able to know their own smiles./"", ""obj_ch5_DW25_slash_Step_0_gml_126_0"");
	c_msgnextloc(""* And you three still want to seal that away?/"", ""obj_ch5_DW25_slash_Step_0_gml_127_0"");
	c_facenext(""ralsei"", ""i"");
