{
	scr_copy(tempblockloc);
}

doClouds = function(arg0 = false)
{
	with (tempblock)
	{
		instance_destroy();
	}
	for (var i = 0; i < array_length(floatingclouds); i++)
	{
		with (floatingclouds[i])
		{
			show = true;
			if (arg0)
			{
				y = ystart;
				image_alpha = 1;
			}
		}
	}
};

layer_set_visible(""WALKABLE_CLOUDS"", false);
var clouds = findsprite_layer(""WALKABLE_CLOUDS"");
floatingclouds = [];
for (var i = 0; i < array_length(clouds); i++)
{
	var thiscloud = scr_marker_fromasset(clouds[i], undefined, 1, true);
	with (thiscloud)
	{
		xstart = scr_even(x);
		ystart = scr_even(y);
		x = xstart;
		y = ystart;
		count = i;
		depth += 10000;
		siner = i * 8;
		show = false;
		
		hide = function()
		{
			y = (ystart + 60) - (count * 10);
			image_alpha = 0;
		};
		
		hide();
		
		step_func = function()
		{
			siner += (1 / global.fps_scale);
			if (show)
			{
				y = lerp(y, ystart, scr_fps_lerp_rate(1/15));
				image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.16666666666666666));
			}
		};
		
		draw_func = function()
		{
			var yoff = round(sin(siner / 6) * 2);
			draw_sprite_ext(sprite_index, image_index, x, y + yoff, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
		};
	}
	array_push(floatingclouds, thiscloud);
}
