	var jumbospot = findspriteinfo(spr_dw_ralsei_castle_basketball_jumbo, ""CUT_TennaCutscene"");
	jumbotron = instance_create(jumbospot.x, jumbospot.y, obj_object);
	with (jumbotron)
	{
		depth = 10000;
		crttimer = 0;
		crt_glitch = 0;
		chromStrength = 0.25;
		screenwidth = 86;
		screenheight = 74;
		draw = ""none"";
		animindex = 0;
		change = -1;
		staticsnd = -4;
		dancespeed = 1 / global.fps_scale;
		danceindex = 0;
		surf = -4;
		sprite_index = spr_dw_ralsei_castle_basketball_jumbo;
		image_xscale = 2;
		image_yscale = 2;
		
		clean_step = function()
		{
			if (surface_exists(surf))
			{
				surface_free(surf);
			}
		};
		
		dochange = function(arg0 = 6)
		{
			change = arg0;
			snd_stop(staticsnd);
			staticsnd = snd_play(snd_tv_static);
			delay_function(function()
			{
				snd_stop(staticsnd);
			}, arg0);
		};
		
		draw_func = function()
		{
			animindex += (1 / global.fps_scale);
			danceindex += dancespeed;
			if (!surface_exists(surf))
			{
				change -= (1 / global.fps_scale);
				surf = surface_create(screenwidth, screenheight);
				surface_set_target(surf);
				crttimer = (crttimer + (0.5 / global.fps_scale)) % 3;
				var _vig = crt_glitch ? (0.2 + random(clamp(crt_glitch / 200, 0, 0.1))) : 0;
				var _vigint = power(1.5, 1.5 - _vig) * 18;
				var _chrom_scale = crt_glitch ? (irandom_range(-4, 4) * clamp(crt_glitch / 5, 1, 5)) : chromStrength;
				if (_chrom_scale == 0)
				{
					_chrom_scale = 1;
				}
				var _filteramount = 0.1 + min(crt_glitch / 100, 0.1);
				if (!change)
				{
					if (draw == ""pushing"")
					{
						_chrom_scale = 0;
					}
				}
				shader_replace_simple_set_hook(5);
				shader_set_uniform_f(shader_get_uniform(shd_crt, ""texel""), 0.0005208333333333333, 0.000925925925925926);
				shader_set_uniform_f(shader_get_uniform(shd_crt, ""vignette_scale""), _vig);
				shader_set_uniform_f(shader_get_uniform(shd_crt, ""vignette_intensity""), _vigint);
