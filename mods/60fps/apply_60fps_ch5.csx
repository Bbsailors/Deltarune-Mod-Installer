	shuriken_target_x = x + (40 * image_xscale);
	shuriken_target_y = y + 40;
	if (__floortex != -4)
	{
		shuriken_target_y = __floortex.y_plat;
	}
	init = true;
}
if (con == 0)
{
	if (timer == throw_interval)
