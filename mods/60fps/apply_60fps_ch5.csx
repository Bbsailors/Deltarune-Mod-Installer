quistring = stringsetsubloc(""Hold ~1 : Quit"", scr_get_input_name(6), ""obj_minigame_quit_ui_slash_Draw_0_gml_18_0"");
quistring2 = stringsetsubloc(""Hold ~1 : Quit"", _space, ""obj_minigame_quit_ui_slash_Draw_0_gml_18_0"");
