if (con == 0)
{
	if (contimer == 25)
	{
		con = 1;
		contimer = 0;
	}
}
else if (con == 1)
{
	if (contimer == 2)
	{
		snd_play(snd_wing);
		flash_hurt(16777215);
		last_bullet = -4;
	}
	y = ystart + (sin(contimer * 0.1) * 12);
	var timermax = 1;
	if (pattern == 0)
	{
		bullet_speed = 6;
		ring_scale = 4;
		timermax = 210;
		var amp = sin(degtorad(contimer * (180 / timermax)));
		x = xstart + (sin(contimer * 0.045) * amp * 200);
	}
	else if (pattern == 1)
	{
		timermax = 280;
		bullet_speed = 6;
		ring_scale = lerp(4, 3, contimer / timermax);
		var amp = clamp(sin(degtorad(contimer * (180 / timermax))) * 1.75, -1, 1);
		x = xstart + (sin(contimer * 0.045) * sin(contimer * 0.065) * amp * 200);
	}
	else if (pattern == 2)
	{
		timermax = 280;
		bullet_speed = 4;
		ring_scale = lerp(5, 4, contimer / timermax);
		var amp = clamp(sin(degtorad(contimer * (180 / timermax))) * 1.75, -1, 1);
		x = xstart - (sin(contimer * 0.055) * sin(contimer * 0.065) * (amp * ((0.1 * sin(amp)) + 1)) * 200);
	}
	else if (pattern == 3)
	{
		timermax = 210;
		bullet_speed = 12;
		ring_scale = lerp(8, 1, contimer / timermax);
		var amp = sin(degtorad(contimer * (180 / timermax)));
		x = xstart + (sin(contimer * 0.085) * amp * 140);
	}
	if ((contimer % 4) == 3)
	{
		var pitch = 1.3 + (1 * (contimer / timermax));
		var snd = snd_play(snd_board_lift, 1, pitch);
		snd_pitch_time(snd, 2, pitch + 0.5);
		image_speed = 0.5 / global.fps_scale;
		with (instance_create(x, y, obj_plat_bulletred_ring))
		{
			vspeed = other.bullet_speed / global.fps_scale;
			init = true;
			previous_bullet = other.last_bullet;
			other.last_bullet = self;
			spawn_bullets = true;
			original_damage = 35;
			visible = 0;
			damage = 0;
			image_xscale = 1;
			image_yscale = 2;
			idx = other.bullet_index;
			scr_lerpvar(""image_xscale"", image_xscale, other.ring_scale, 16, 1, ""out"");
			lifetime = 115;
			other.bullet_index++;
		}
	}
	if (contimer == timermax)
	{
		image_speed = 0.25 / global.fps_scale;
		con = 2;
		contimer = 0;
	}
}
else if (con == 2)
{
	if (contimer == 1)
	{
		scr_lerpvar(""auraalph"", 1, 0, 12);
		scr_lerpvar(""y"", y, ystart + 60, 30, -1, ""inout"");
	}
	if (contimer < 111)
	{
		x = xstart + (sin(contimer * 0.06) * 20);
		if (contimer > 30)
		{
			y = ystart + 60 + (sin((contimer - 30) * 0.1) * 12);
		}
	}
	if (contimer == 111)
	{
		scr_lerpvar(""y"", y, ystart, 10, 2, ""inout"");
		scr_lerpvar(""x"", x, xstart, 10, 2, ""inout"");
		auraalph = 1;
	}
	if (contimer == 121)
	{
		con = 1;
		contimer = 0;
		pattern++;
		damage_multiplier = min(damage_multiplier + 1, 7);
		if (pattern >= 4)
		{
			pattern = 0;
		}
	}
}
if (auraalph > 0)
{
	su_act.blocked = 2;
}
else
{
	su_act.blocked = 0;
}
");

