with (zenlooker)
{
	if (myinteract == 3)
	{
		global.interact = 1;
		if (!talked)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* I'm Zenlooker/"", ""obj_dw_fcastle_zenlooker_slash_Step_0_gml_38_0"");
			msgnextloc(""* I look at Zen/"", ""obj_dw_fcastle_zenlooker_slash_Step_0_gml_39_0"");
			msgnextloc(""* I've patterned myself after the world's greaterst looker/"", ""obj_dw_fcastle_zenlooker_slash_Step_0_gml_40_0"");
