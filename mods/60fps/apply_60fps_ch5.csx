Apply("gml_Object_obj_ch5_LW07_thrashfit_sprite_Step_0", @"if (_print_mode)
{
	_print_timer += (1 / global.fps_scale);
	if (!_print_reverse)
	{
		if (_print_timer == 1)
		{
			_y_pos = y - (sprite_get_height(_sprite) * 2);
			_x_scale = 0.4;
			scr_lerpvar(""_y_pos"", _y_pos, y, 60, 2, ""out"");
		}
		if (_print_timer == 90)
		{
			snd_play(snd_wing);
			scr_lerpvar(""_x_scale"", _x_scale, 2, 8, -2, ""out"");
			_print_timer = 0;
			_print_mode = false;
		}
	}
	else
	{
		if (_print_timer == 1)
		{
			_y_pos = y;
			_x_scale = 2;
			snd_play(snd_wing);
			scr_lerpvar(""_x_scale"", _x_scale, 0.4, 8, -2, ""out"");
		}
		if (_print_timer == 10)
		{
			scr_lerpvar(""_y_pos"", _y_pos, y - (sprite_get_height(_sprite) * 2), 60, 2, ""in"");
		}
		if (_print_timer == 90)
		{
			_print_timer = 0;
			_print_mode = false;
			_enabled = false;
		}
	}
}
");

