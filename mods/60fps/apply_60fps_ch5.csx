	{
		image_blend = c_white;
		xstart = x;
		ystart = y;
	}
}
table = scr_marker_fromasset(findsprite(spr_dw_fcastle_green_checkpoint_greencounter), undefined, 1, true);
menuMarker = menu.dinermenu.marker;
table.reflect_jump_y = 999;
fakemenu = -4;
trig = scr_marker_fromasset(findsprite(spr_trig, ""CUT""));
trig.visible = false;

makesave = function(arg0 = false)
{
	var loc = findspriteinfo(spr_savepoint);
	with (instance_create(loc.x, loc.y, obj_savepoint))
	{
		if (arg0)
		{
			image_alpha = 0;
			scr_lerpvar(""image_alpha"", 0, 1, 30);
		}
	}
};

if (con == 0)
{
	fakemenu = scr_marker_fromasset(findsprite(spr_dw_garden_diner_interactableMenu), undefined, undefined, true);
	fakemenu.depth = table.depth - 1;
	fakemenu.y = -99;
	menuMarker.visible = false;
	with (menu.dinermenu)
	{
		shine.x = room_width * 4;
	}
	table.y = -900;
	with (greennpc)
	{
		x += room_width;
		with (marker)
		{
			x += room_width;
		}
	}
	var loc = findspriteinfo(spr_krisd_dark, ""CUT"", #FFFF3B);
	with (obj_mainchara)
	{
		setxy(loc.x, loc.y);
	}
	with (obj_caterpillarchara)
	{
		if (name == ""ralsei"")
		{
			setxy(loc.x - 2, loc.y - 12);
		}
		else
		{
			setxy(loc.x - 6, loc.y - 16);
		}
		scr_caterpillar_interpolate(name);
		scr_caterpillar_facing(1);
	}
}
else
{
	makesave(0);
}

dropTable = function()
{
	with (table)
	{
		timer = 0;
		y = cameray() - 120;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		vspeed = 4 / global.fps_scale;
		bounce_count = 0;
		
		end_step_func = function()
		{
			timer++;
			if (y >= ystart && bounce_count < 3)
			{
				y = ystart;
				bounce_count++;
				if (bounce_count == 1)
				{
					vspeed = -vspeed * 0.4;
					snd_play(snd_impact);
				}
				if (bounce_count == 2)
				{
					vspeed = -vspeed * 0.4;
					snd_play(snd_impact, 0.5);
				}
				if (bounce_count == 3)
				{
					vspeed = 0;
					gravity = 0;
					snd_play(snd_impact, 0.2);
				}
			}
		};
	}
	with (fakemenu)
	{
		timer = 0;
		y = cameray() - 120;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		vspeed = -8 / global.fps_scale;
		bounce_count = 0;
		
		end_step_func = function()
		{
			timer++;
			if (y >= ystart || (y >= obj_dw_fcastle_green_checkpoint.table.y && bounce_count < 3))
			{
				y = min(obj_dw_fcastle_green_checkpoint.table.y, ystart);
				bounce_count++;
				if (bounce_count == 1)
				{
					vspeed = -vspeed * 0.2;
					snd_play(snd_wing);
				}
				if (bounce_count == 2)
				{
					vspeed = -vspeed * 0.2;
					snd_play(snd_wing, 0.5);
				}
				if (bounce_count == 3)
				{
					vspeed = 0;
					gravity = 0;
					snd_play(snd_wing, 0.2);
					with (obj_garden_diner_menu)
					{
						with (dinermenu.marker)
						{
							visible = true;
							setxy(xstart, ystart);
						}
					}
					instance_destroy();
				}
			}
		};
	}
};

checkRecruits = function()
{
	anyonelost = false;
	everyonerecruited = true;
	for (var i = 0; i < 8; i++)
	{
		if (global.flag[670 + i] != 1)
		{
			everyonerecruited = false;
		}
		if (global.flag[670 + i] == -1)
		{
			anyonelost = true;
		}
	}
};

checkRecruits();
");

