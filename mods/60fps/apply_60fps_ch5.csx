if (image_yscale == 2 && !instance_exists(obj_plat_enm_seth_book))
{
	x = xstart + (sin(contimer * 0.15) * 16);
	vspeed -= (0.5 / (global.fps_scale * global.fps_scale));
	if (y <= (cameray() - 300))
	{
		instance_destroy(self);
	}
	exit;
}
if (con == 0)
{
