max_speed = 0;
if (!variable_instance_exists(id, ""catchup_lerp""))
{
	catchup_lerp = 0;
}
su_act.blocked = true;
is_yellow_hat_gun = false;
ral_hook = -4;
if (!is_flower_gun && !no_act)
{
	ral_hook = instance_create(x, y, obj_ralsei_hook);
	ral_hook.owner = self;
	with (ral_hook)
	{
		hookscale = 0;
		sprite_index = other.sprite_index;
		depth = other.depth + 1;
		image_index = 2;
		image_speed = 0;
		menu_name = stringsetloc(""Trigger"", ""obj_plat_enm_gun_slash_Create_0_gml_82_0"");
		image_angle = other.image_angle;
		image_xscale = other.image_xscale;
		image_yscale = other.image_yscale;
		can_cut_down = true;
	}
}

shoot_bullet = function()
{
	catchup_lerp = 0;
	var _len = 30;
	var _dir = image_angle;
	var _x = x + (lengthdir_x(_len, _dir) * sign(image_xscale));
	var _y = y + lengthdir_y(_len, _dir);
	if (instance_exists(obj_plat_player))
	{
		var falloff = clamp01((point_distance(x, y, obj_plat_player.x, obj_plat_player.y) - 250) / 400);
		if (falloff < 0.9)
		{
			snd_stop(snd_gunshot_b);
			snd_play(snd_gunshot_b, 1 - falloff, 1.3);
		}
	}
	var bi = bullet_index;
	var type = volleys[volley_index][bullet_index];
	if (type > 0)
	{
		image_index = 1;
		anim_cooldown = 4;
	}
	var vol_len = array_length(volleys[volley_index]);
	if (bullet_index < (vol_len - 1))
	{
		shottimer += rapiddelay;
		bullet_index++;
	}
	else
	{
		shottimer = shotdelay;
		bullet_index = 0;
		volley_index = (volley_index + 1) % array_length(volleys);
	}
	if (type > 0)
	{
		yellow_shoot = false;
		if (is_flower_gun)
		{
			var obj = 123;
			var bul = instance_create(_x, _y, obj);
			with (bul)
			{
				depth = other.depth + 1;
				image_xscale = 2;
				image_yscale = 2;
				direction = other.image_angle;
				speed = other.bullet_speed / global.fps_scale;
				image_angle = other.pusher_angle;
				strength = other.pusher_strength;
				move_mode = true;
				lifetime = other.bullet_lifetime;
			}
		}
		else
		{
			var obj = 38;
			if (type == 2)
			{
				obj = 900;
			}
			if (type == 3)
			{
				obj = 698;
			}
			if (type == 4)
			{
				obj = 174;
			}
			var bul = instance_create(_x, _y, obj);
			with (bul)
			{
				if (type == 3)
				{
					image_angle_offset = 0;
					direction = other.image_angle + image_angle_offset;
					image_angle = direction;
					anchor = other;
					stick = false;
					lifetime = 9;
					friendly = other.con == 2;
					mycolor = c_yellow;
					other.mycolor = mycolor;
					if (scr_onscreen_tolerance(other, 60))
					{
						snd_play(snd_heavyswing);
					}
				}
				else if (type == 4)
				{
					depth = 5100;
					lifetime = other.bullet_lifetime;
					direction = other.image_angle;
					speed = 8 / global.fps_scale;
					image_angle = 90 - (90 * sign(other.image_xscale));
					image_xscale = 1;
					image_yscale = 2;
					scr_lerpvar(""image_xscale"", image_xscale, 2.5, 16, -1, ""out"");
					damage = 0;
					scr_delay_var(""original_damage"", 25, 5);
					image_speed = 0;
				}
				else
				{
					sprite_index = spr_bullet_red_bullet;
					depth = other.depth + 1;
					align_to_direction = object_index == obj_plat_bulletred;
					image_xscale = 2;
					image_yscale = 2;
					direction = other.image_angle;
					speed = 8 / global.fps_scale;
					damage = 25;
					image_speed = 0.25 / global.fps_scale;
					if (other.is_yellow_hat_gun)
					{
						sprite_index = spr_yellow_hat;
						speed = 16 / global.fps_scale;
					}
					lifetime = other.bullet_lifetime + 1 + (other.rapiddelay * (vol_len - (bi + 1)));
					if (other.flowertarget != -4)
					{
						speed = point_distance(x, y, other.flowertarget.x, other.flowertarget.y) / 10 / global.fps_scale;
						other.flowertarget.targeted = self;
						turn_duration = 0;
						turn_timer = 0;
						turn_amount = 0;
						damage = 0;
					}
					else if (other.aiming && !other.is_yellow_hat_gun)
					{
						turn_duration = 0;
						turn_timer = 0;
						turn_amount = 0;
						create_trajectory_preview();
					}
					else if (!other.is_yellow_hat_gun)
					{
						turn_duration = other.bullet_turn_speed;
						turn_timer = 1 + (other.rapiddelay * (vol_len - (bi + 1)));
						turn_amount = other.bullet_turn_amount;
						create_trajectory_preview();
					}
				}
			}
		}
	}
};

orig_get_hit = get_hurt;
petal_color = 65535;

get_hurt = function(arg0)
{
	if (hp <= 0)
	{
		exit;
	}
	if (paused || custom_paused)
	{
		exit;
	}
	orig_get_hit(arg0);
	if (hp > 0)
	{
		flash_hurt(255);
	}
	else
	{
		with (ral_hook)
		{
			image_alpha = 0;
		}
	}
	if (con == 0)
	{
		shottimer = shotdelay;
		bullet_index = 0;
		volley_index = (volley_index + 1) % array_length(volleys);
		image_xscale = 2.5;
		image_yscale = 1.5;
	}
	else
	{
		shottimer = shotdelay;
		bullet_index = 0;
		volley_index = (volley_index + 1) % array_length(volleys);
		image_xscale = 2.5;
		image_yscale = 1.5;
	}
};

spawn_cakesmoke = function(arg0)
{
	var xx = x + lengthdir_x(28, image_angle);
	var yy = y + lengthdir_y(28, image_angle);
	var amp = 1;
	repeat (arg0)
	{
		var dist = random_range(-10, 10);
		var xxx = xx + lengthdir_y(dist, image_angle);
		var yyy = yy + lengthdir_x(dist, image_angle);
		var smoke = instance_create(xxx, yyy, obj_marker);
		with (smoke)
		{
			depth = other.depth + 10;
			sprite_index = spr_cakesmoke;
			scr_darksize();
			direction = point_direction(other.x, other.y, x, y) + (random_range(-12, 12) * amp);
			speed = (random_range(6, 12) * amp) / global.fps_scale;
			friction = (0.3 + (0.2 * amp)) / (global.fps_scale * global.fps_scale);
			gravity = -0.3 / (global.fps_scale * global.fps_scale);
			image_angle = random_range(0, 360);
			scr_lerpvar(""image_alpha"", 1, 0, random_range(30, 60));
			scr_doom(self, 60);
		}
	}
};
");

Apply("gml_Object_obj_plat_enm_gun_Step_0", @"event_inherited();
if (!instance_exists(obj_plat_player))
{
	exit;
}
if (!init2)
{
	init2 = true;
	with (obj_slashpusher_anchor)
	{
		if (index == other.index)
		{
			other.leaves = self;
			flower = other;
			depth = other.depth;
			break;
		}
	}
}
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (hp <= 0)
{
	exit;
}
if (con == 0 || con == 1)
{
	if (con == 0 && y > ystart)
	{
		con = 1;
	}
	anim_cooldown -= (1 / global.fps_scale);
	var t = volleys[volley_index][bullet_index];
	if (t == 3 && !scr_onscreen_tolerance(self, 100))
	{
		shottimer = shotdelay;
	}
	if (anim_cooldown <= 0)
	{
		image_index = 0;
	}
	if (!is_yellow_hat_gun)
	{
		shottimer -= (1 / global.fps_scale);
		if (shottimer == (shotdelay - 1))
		{
			if (movemarker != """")
			{
				with (obj_plat_movemarker)
				{
					if (extflag == other.movemarker)
					{
						other.anchorx = other.x;
						other.anchory = other.y;
						other.targetx = x;
						other.targety = y;
						other.movemarker = next_extflag;
						break;
					}
				}
			}
		}
	}
	if (shottimer > rapiddelay)
	{
		if (con == 0)
		{
			if (!is_culled)
			{
				if (t != 3)
				{
					image_angle = lerp(target_angle, target_angle + 360, ease_inout_quad(clamp01((shottimer - rapiddelay) / (shotdelay - 16)), 0, 1, 1));
				}
				else if (shottimer < (shotdelay - 8))
				{
					image_angle = target_angle;
				}
			}
			else
			{
				image_angle = target_angle;
			}
		}
		else
		{
			image_angle = target_angle;
		}
	}
	else
	{
	}
	if (!is_culled && t > 0 && shottimer > 0)
	{
		var wobble_strength = lerp(1, 0, min(shottimer / 15, 1));
		image_xscale = (sin(shottimer / 4) * 0.5 * wobble_strength) + 1.5 + (0.5 * (1 - wobble_strength));
		image_yscale = (cos(shottimer / 4) * 0.5 * wobble_strength) + 1.5 + (0.5 * (1 - wobble_strength));
	}
	else
	{
		image_xscale = 2;
		image_yscale = 2;
	}
	if (shottimer == (rapiddelay - 1))
	{
		flowertarget = -4;
	}
	if (shottimer < (shotdelay - 8))
	{
		catchup_lerp = min(catchup_lerp + (0.2 / global.fps_scale), 1);
	}
	if (con == 1)
	{
		with (ral_hook)
		{
			if (!ralsei_ready)
			{
				other.y = scr_approach(other.y, other.ystart, 2);
				other.vspeed *= power(0.9, 1 / global.fps_scale);
				if (other.y == other.ystart)
				{
					other.con = 0;
				}
			}
			else
			{
				other.vspeed *= power(0.9, 1 / global.fps_scale);
			}
		}
	}
	if (shottimer <= 0)
	{
		catchup_lerp = 1;
	}
	var adjust = 0;
	var target = 912;
	var no_shoot = false;
	var has_master = instance_exists(obj_cutscene_master);
	if (has_master)
	{
		no_shoot = true;
		with (obj_plat_npc)
		{
			if (name == ""kris"")
			{
				target = self;
				adjust -= 10;
			}
		}
	}
	if ((targetindex % 3) == 0)
	{
		with (obj_plat_npc)
		{
			if (name == ""susie"")
			{
				target = self;
			}
		}
	}
	if ((targetindex % 3) == 2)
	{
		with (obj_plat_npc)
		{
			if (name == ""ralsei"")
			{
				target = self;
			}
		}
	}
	if (flowertarget != -4 && instance_exists(flowertarget))
	{
		target_angle = lerp(target_angle, point_direction(x, y, flowertarget.x, flowertarget.y), catchup_lerp);
	}
	else if (aiming && instance_exists(obj_plat_player))
	{
		target_angle = lerp(target_angle, point_direction(x, y, target.x + adjust, target.y), catchup_lerp);
	}
	else
	{
		target_angle = lerp(target_angle, target_angle_memory, catchup_lerp);
	}
	if ((shottimer <= 0 && !is_yellow_hat_gun) || (is_yellow_hat_gun && yellow_shoot))
	{
		if (t != 3 || has_master)
		{
			image_angle = target_angle;
		}
		if (inactive_time <= 0 && !has_master)
		{
			shoot_bullet();
		}
	}
}
else if (con == 1)
{
	contimer += (1 / global.fps_scale);
	if (contimer == 1)
	{
		vspeed = 6 / global.fps_scale;
	}
	vspeed *= power(0.9, 1 / global.fps_scale);
}
else if (con == 2)
{
	contimer += (1 / global.fps_scale);
	if ((contimer % 4) == 0 && contimer < 61)
	{
		image_angle -= (angle_difference(image_angle, 0) * 0.1);
		if (contimer >= 40)
		{
			image_angle = random_range(-5, 5);
			shoot_bullet();
		}
		else
		{
			spawn_cakesmoke(2);
		}
	}
	if (contimer < 61)
	{
		var amp = min(contimer / 80, 0.5);
		image_xscale = ((sin(contimer * 2) * amp) + 2) - amp;
		image_yscale = ((cos(contimer * 2) * amp) + 2) - amp;
	}
	else
	{
		shottimer += (1 / global.fps_scale);
		var wobble_strength = lerp(1, 0, clamp01(shottimer / 15));
		image_xscale = (sin(shottimer / 4) * 0.5 * wobble_strength) + 1.5 + (0.5 * (1 - wobble_strength));
		image_yscale = (cos(shottimer / 4) * 0.5 * wobble_strength) + 1.5 + (0.5 * (1 - wobble_strength));
		image_angle = 0;
		image_index = 0;
	}
}
");

Apply("gml_Object_obj_plat_enm_gun_Step_2", @"event_inherited();
if (hp <= 0)
{
	exit;
