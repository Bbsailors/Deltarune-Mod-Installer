	c_actortocaterpillar();
	c_terminatekillactors();
}
if (con == 14 && !i_ex(obj_cutscene_master))
{
	global.interact = 0;
	global.facing = 0;
	obj_mainchara.climb_with_caterpillars = false;
	scr_flag_set(1889, 2);
	con = 0;
}
if (!susietalked && i_ex(obj_climb_susie))
{
	susietalked = true;
	with (obj_climb_susie)
	{
		if (!collision_rectangle(x - 1, y - 10, x + 1, y - 10, obj_solidenemy, false, false))
		{
			other.susietalked = false;
			break;
		}
	}
	if (susietalked)
	{
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\E5* Stop messing around^1, idiot!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_slash_Step_0_gml_559_0"");
		d_make_plat(0, 10);
	}
}
if (i_ex(obj_plat_player))
{
	if (obj_plat_player.y < music_switch_y)
	{
		if (music_state == 0)
		{
			music_state = 1;
			snd_free(global.currentsong[0]);
			global.currentsong[0] = snd_init(""cliff_jump_ambience.ogg"");
			global.currentsong[1] = mus_loop_ext(global.currentsong[0], 1, 1);
		}
		snd_volume(global.currentsong[1], clamp01(inverselerp(music_switch_y, music_top_y, obj_plat_player.y)), 0);
	}
	else
	{
		if (music_state == 1)
		{
			music_state = 0;
			snd_free(global.currentsong[0]);
			global.currentsong[0] = snd_init(""piano_ambience.ogg"");
			global.currentsong[1] = mus_loop_ext(global.currentsong[0], 1, 1);
		}
		snd_volume(global.currentsong[1], clamp01(inverselerp(music_switch_y, music_bottom_y, obj_plat_player.y)), 0);
	}
}
if (music_state == 1)
{
	with (obj_leafpetals)
	{
		if (wind_direction >= 195)
		{
			wind_direction -= (0.2 / global.fps_scale);
		}
		if (wind_speed <= 450)
		{
			wind_speed += (0.6 / global.fps_scale);
		}
	}
	with (obj_cliff_wind_animator)
	{
		speed_up = true;
	}
}
else
{
	with (obj_leafpetals)
	{
		if (wind_direction < 265)
		{
			wind_direction += (0.2 / global.fps_scale);
		}
		if (wind_speed > 16)
		{
			wind_speed -= (0.6 / global.fps_scale);
		}
	}
	with (obj_cliff_wind_animator)
	{
		speed_up = false;
	}
}
if (i_ex(obj_mainchara) && obj_mainchara.y < 4000)
{
	obj_mainchara.climb_with_caterpillars = false;
}
if (i_ex(obj_climb_kris) && obj_climb_kris.y < 4000)
{
	obj_climb_kris.input_locked = false;
}
