			delay_function(function()
			{
				snd_play(snd_helicopter);
				sprite_index = spr_npc_umbrellayokai_flyaway_garden;
				image_speed = 0.5 / global.fps_scale;
			}, waittime);
			scr_doom(id, 180);
		}
		myinteract = 99;
		global.interact = 0;
		instance_destroy();
	}
}
