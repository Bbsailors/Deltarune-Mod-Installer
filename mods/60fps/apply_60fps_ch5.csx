Apply("gml_Object_obj_sourdough_Collision_obj_plat_hbx", @"slashes++;
if (slashes >= 1 && image_index == 0)
{
	event_user(1);
	exit;
}
if (image_index == 2)
{
	snd_play(snd_metal_hit_strong);
	var xx = mean(other.x, x) + random_range(-20, 20);
	var yy = y + random_range(20, 60);
	var dmg = instance_create(xx, yy, obj_dmgwriter);
	dmg.damage = 0;
	dmg.showzeroes = 1;
	dmg.noextend = 1;
	scr_make_ripple(xx, yy, 4, 16777215, 30, 30, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
	with (other)
	{
		instance_destroy();
	}
	exit;
}
for (var i = 0; i < 4; i++)
{
	var splash = instance_create_depth(x + (0.5 * sprite_width), y + (0.5 * sprite_height), depth - 600, obj_marker_fancy);
	with (splash)
	{
		sprite_index = spr_bread_chunk;
		image_speed = 0;
		image_xscale = random_range(1, 3);
		image_yscale = random_range(1, 3);
		image_index = choose(0, 1);
		direction = random_range(0, 360);
		speed = random_range(5, 12) / global.fps_scale;
		gravity = 0.5 / (global.fps_scale * global.fps_scale);
		image_angle = direction;
		var doom = random_range(30, 90);
		scr_doom(self, doom);
		scr_lerpvar(""image_alpha"", 1 + random_range(0, 3), 0, doom);
		
		step_func = function()
		{
			image_angle = direction;
		};
	}
}
with (other)
{
	instance_destroy();
}
snd_play(snd_splat, 0.1, 3);
");

Apply("gml_Object_obj_sourdough_Create_0", @"init = 0;
scr_platswap_init();
scr_depth();
image_speed = 0;
slashes = 0;
siner = 0;
darker = 0;
enhanced = false;
if (scr_flag_get_ext(1399, 0, 2) == 2)
{
	image_index = 2;
}

enhance = function()
{
	snd_play(snd_power);
	var xx = 0.5 * (bbox_left + bbox_right);
	var yy = (0.5 * (bbox_top + bbox_bottom)) + 20;
	scr_oflash();
	var col = 65535;
	alarm[11] = -1;
	scr_make_ripple(xx, yy, 40, col, 160, 2, 20, depth + 100, 0, 0, 0, 1, 1.5);
	for (i = 0; i < 6; i += 1)
	{
		var star = instance_create(xx + random_range(-80, 80), yy + random_range(-20, 20), obj_marker_fancy);
		with (star)
		{
			image_angle = random(360);
			depth = other.depth - 100;
			
			step_func = function()
			{
				image_angle -= (10 / global.fps_scale);
				image_alpha -= (0.05 / global.fps_scale);
			};
			
			image_xscale = 2;
			image_yscale = 2;
			image_alpha = 2;
			image_speed = 0.25 / global.fps_scale;
			hspeed = random_range(-3, 3) / global.fps_scale;
			vspeed = (-1 - random(2)) / global.fps_scale;
			friction = 0.1 / (global.fps_scale * global.fps_scale);
			image_blend = col;
			sprite_index = spr_sparestar_anim;
		}
	}
};

recover = function()
{
	image_index = 0;
	scr_shakeobj();
	alarm[11] = -1;
	with (obj_dw_garden_hopschef)
	{
		bread.smashed = false;
		bread.enhanced = false;
		bread.cake = false;
		alarm[10] = -1;
		alarm[11] = -1;
	}
};
");

