		else if (speed < (4 / global.fps_scale))
		{
			image_index = 0;
		}
		else if (speed < (8 / global.fps_scale))
		{
			image_index = 3;
		}
	}
	y += (1 / global.fps_scale);
	direction = _dir;
}
if (state == 10)
{
}
