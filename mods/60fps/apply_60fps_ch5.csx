		}
		else
		{
			scr_anyface_next(""ralsei"", ""o"");
			msgnextloc(""\\Eo* Umm..^1. do you guys realize you kissed each other...?/%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1498_0"");
		}
	}
	else
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* My first kiss..^1. I'm glad it was with Master Flowery^1. He was so gentle.../"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1504_0"");
		if (global.flag[1311] == 1)
		{
			scr_anyface_next(""ralsei"", ""J"");
			msgnextloc(""\\EJ* Guys?/%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1508_0"");
		}
		else
		{
			scr_anyface_next(""ralsei"", ""o"");
			msgnextloc(""\\Eo* Guys?/%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1511_0"");
		}
	}
	if (watered)
	{
		with (obj_dw_garden_enemyrush.kissedfloradinn)
		{
			watertalk = 1;
		}
		with (obj_dw_garden_enemyrush.kissedfloradinn2)
