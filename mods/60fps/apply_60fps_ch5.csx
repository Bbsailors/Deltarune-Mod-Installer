	c_var_instance(drip_marker, ""y"", cameray() + (view_hport[0] / 4));
	c_var_lerp_instance(drip_marker, ""image_alpha"", 0, 1, 300);
	c_wait(300);
	c_wait(60);
	c_customfunc(function()
	{
		scr_speaker(""noelle"");
		global.fe = 0;
		global.fc = 0;
		msgsetloc(0, "" T H A N K   Y O U"", ""obj_ch5_LW01W_slash_Step_0_gml_29_0"");
