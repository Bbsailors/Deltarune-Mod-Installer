{
	xs = image_xscale;
	ys = 2 * platb;
	draw_sprite_ext(spr_plat_orangewall_broken_back, 0, xx, (yy + 40) - (40 * (1 - plata)), xs, ys, image_angle, image_blend, image_alpha);
	xx += (lengthdir_y(ys + plata, image_angle) * 40);
	yy += (lengthdir_x(ys + plata, image_angle) * 40);
	xs = image_xscale;
	ys = image_yscale - (4 * platb);
	draw_sprite_ext(spr_plat_orangewall_broken_loop_back, 1, xx, yy, xs, (ys * 0.5) - (2 * plata), image_angle, image_blend, image_alpha);
	xx += (lengthdir_y(ys, image_angle) * 40);
