Apply("gml_Object_obj_flowery_hero_flower_Draw_0", @"if (timer_on)
{
	timer += (1 / global.fps_scale);
	if (timer > 10)
	{
		timer = 0;
		if (hero == 1)
		{
			flower_particle = instance_create_depth((x - 4) + irandom(50), y + 5, depth + 1, obj_marker);
		}
		if (hero == 2)
		{
			flower_particle = instance_create_depth((x - 32) + irandom(50), y + 5, depth + 1, obj_marker);
		}
		if (hero == 3)
		{
			flower_particle = instance_create_depth((x - 30) + irandom(50), y + 5, depth + 1, obj_marker);
		}
		flower_particle.sprite_index = spr_sparestar_anim;
		flower_particle.image_index = 3;
		flower_particle.image_speed = choose(1/3, 0.25, 0.2) / 2 / global.fps_scale;
		flower_particle.image_xscale = 2;
		flower_particle.image_yscale = 2;
		flower_particle.vspeed = 2 / global.fps_scale;
		flower_particle.gravity = 0.1 / (global.fps_scale * global.fps_scale);
		flower_particle.gravity_direction = 190;
		if (hero == 1)
		{
			flower_particle.image_blend = krisflowercolor;
		}
		if (hero == 2)
		{
			flower_particle.image_blend = susieflowercolor;
		}
		if (hero == 3)
		{
			flower_particle.image_blend = ralseiflowercolor;
		}
		with (flower_particle)
		{
			scr_script_delayed(scr_lerp_var_instance, (3 / image_speed / global.fps_scale) - 9, id, ""image_alpha"", 1, 0, 9);
			scr_script_delayed(instance_destroy, 3 / image_speed / global.fps_scale);
		}
	}
	sintimer += (1 / global.fps_scale);
}
