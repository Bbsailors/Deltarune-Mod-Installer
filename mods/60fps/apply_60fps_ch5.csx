Apply("gml_Object_obj_dw_fcastle_terracotta_bonus_Step_0", @"if (init == 0)
{
	init = 1;
	with (obj_castlereflect_manager)
	{
		add_reflection(1247);
		substitute_sprite(1115, 6827);
		substitute_sprite(2144, 1489);
		add_sprite_offset(2144, 2, 0);
	}
	if (has_yellow)
	{
		var spr = findspriteinfo(spr_yellow_sock, ""NPCs"", c_red);
		npc_shadowguy = instance_create(spr.x, spr.y, obj_marker_fusuma);
		npc_shadowguy.image_blend = c_white;
		with (obj_castlereflect_manager)
		{
			add_reflection(other.npc_shadowguy);
		}
		with (npc_shadowguy)
		{
			sprite_index = spr.sprite_index;
			image_speed = 1 / global.fps_scale;
			image_xscale = spr.image_xscale;
			image_yscale = spr.image_yscale;
			__silhouette = 112;
			__sil_image_speed = 0.02;
			__sil_image_index = 0;
			scr_depth();
		}
		var genmarker = scr_genmarker(""slide_fusuma"");
		if (instance_exists(genmarker))
		{
			var interact = instance_create(genmarker.x, genmarker.y, obj_interactablesolid);
			interact.image_xscale = 4;
			interact.image_yscale = 2;
			with (interact)
			{
				on_interact = function()
				{
					obj_dw_fcastle_terracotta_bonus.con = 1;
					obj_dw_fcastle_terracotta_bonus.timer = 0;
					global.interact = 1;
				};
			}
		}
	}
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	var opentime = ceil(max(5 - (0.1 * sockspeed), 2));
	var screamtime = opentime + ceil(max(25 - sockspeed, 5));
	var closetime = screamtime + ceil(max(15 - (sockspeed * 0.5), 3));
	var restoretime = closetime + ceil(max(10 - (sockspeed * 0.5), 2));
	if (timer == 1)
	{
		with (obj_plat_fusumawall)
		{
			if (extflag == ""sliding_fusuma"")
			{
				scr_lerpvar(""x"", xstart, xstart + 160, opentime, 1, ""out"");
			}
		}
		snd_play(snd_wing);
		with (npc_shadowguy)
		{
			scr_animate(0, 2, 2 / (closetime - screamtime));
		}
	}
	if (timer == screamtime)
	{
		snd_play(snd_scream, 1, 1 + (0.01 * sockspeed));
		with (npc_shadowguy)
		{
			sprite_index = spr_yellow_sockshock;
			scr_shakeobj();
		}
	}
	if (timer == closetime)
	{
		if (sockspeed >= 5)
		{
			snd_stop(snd_scream);
		}
		with (obj_plat_fusumawall)
		{
			if (extflag == ""sliding_fusuma"")
			{
				scr_lerpvar(""x"", xstart + 160, xstart, opentime, 1, ""out"");
			}
		}
		snd_play(snd_wing);
		with (npc_shadowguy)
		{
			if (other.sockspeed < 20)
			{
				__sil_image_speed += 0.02;
			}
			scr_delay_var(""sprite_index"", 8091, restoretime - closetime);
			scr_delay_var(""image_index"", 0, restoretime - closetime);
		}
		sockspeed = min(sockspeed + 1, 20);
	}
	if (timer >= restoretime)
	{
		global.interact = 0;
		con = 0;
		timer = 0;
	}
}
");

Apply("gml_Object_obj_dw_fcastle_terracotta_puzzle_Step_0", @"if (init == 0)
{
