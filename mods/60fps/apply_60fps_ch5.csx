	scr_rudface(6, 4);
	global.msg[7] = stringsetloc(""\\E4* ...&* Noelle.../"", ""obj_rudy_slash_Step_0_gml_60_0"");
	global.msg[8] = stringsetloc(""\\E5* Maybe..^1.&* Maybe you shouldn't wait./"", ""obj_rudy_slash_Step_0_gml_61_0"");
	scr_noeface(9, 7);
