		d3d_set_fog(true, c_white, 0, 1);
		draw_sprite_ext(thissprite, this_index, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
		d3d_set_fog(false, c_black, 0, 0);
