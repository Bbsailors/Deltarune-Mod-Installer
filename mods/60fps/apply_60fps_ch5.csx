right_blue = function()
{
	var perp_aqua = self.perp_aqua;
	var perp_seth = self.perp_seth;
	var perp_green = self.perp_green;
	var perp_blue = self.perp_blue;
	var perp_yellow = self.perp_yellow;
	with (obj_writer)
	{
		instance_destroy();
	}
	with (obj_yellow_trial_manager.perp_yellow)
	{
		x = (camerax() + (camerawidth() * 0.5) + 50) - 50;
		y = cameray() + (cameraheight() * 0.5);
		xstart = x;
		ystart = y;
		var w = (sprite_get_width(sprite_index) - sprite_get_xoffset(sprite_index)) * 2;
		var h = (sprite_get_height(sprite_index) - sprite_get_yoffset(sprite_index)) * 2;
		x -= (w * 0.5);
		y -= h;
		anchor_x = x;
		anchor_y = y;
	}
	with (obj_yellow_trial_manager.perp_blue)
	{
		x = camerax() + (camerawidth() * 0.5) + 50 + 50;
		y = cameray() + (cameraheight() * 0.5);
		xstart = x;
		ystart = y;
		var w = (sprite_get_width(sprite_index) - sprite_get_xoffset(sprite_index)) * 2;
		var h = (sprite_get_height(sprite_index) - sprite_get_yoffset(sprite_index)) * 2;
		x -= (w * 0.5);
		y -= h;
		anchor_x = x;
		anchor_y = y;
	}
	with (obj_blue_enemy)
	{
		msgset_add_func(function()
		{
			talked = -1;
			scr_var_delay(""talked"", 1, 60);
			snd_volume(global.batmusic[3], 0, 60);
			scr_script_delayed(snd_play_x, 10, 537, 0.8, 1);
			scr_script_delayed(snd_play_x, 20, 537, 0.6, 1);
			scr_script_delayed(snd_play_x, 30, 537, 0.4, 1);
			scr_script_delayed(snd_play_x, 40, 537, 0.2, 1);
			with (obj_trial_perp)
			{
				if (perp_index != UnknownEnum.Value_3 && perp_index != UnknownEnum.Value_4)
				{
					visible = false;
				}
			}
			with (obj_yellow_trial_manager.perp_blue)
			{
				sprite_index = spr_blue_unhappy_shock;
				y -= 4;
			}
			with (scr_fadein(60))
			{
				image_blend = c_white;
				depth = -1000;
			}
		});
		msgset_add(other.right_blue_1, perp_yellow.xstart, perp_yellow.ystart - perph(perp_yellow) - 5, 13, 50, function()
		{
			with (obj_battleblcon)
			{
				depth = -500;
			}
			with (obj_yellow_trial_manager.perp_yellow)
			{
				sprite_index = spr_yellow_hat_down;
			}
