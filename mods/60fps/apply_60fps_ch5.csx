				}
			}
			with (trashy_marker)
			{
				depth = obj_heroralsei.depth + 0.1;
				scr_lerpvar(""x"", x, x - 360, 80);
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 100);
		});
		msgset_add_func(function()
		{
			with (obj_marker_fancy)
			{
				if (sprite_index == spr_mike_smoke)
				{
					snd_play(snd_jump);
					other.jongler_marker.image_xscale *= -1;
					other.jongler_marker.x = x + 62;
					other.pluey_marker.x = x - 44;
					other.pippins_marker.x = x - 35;
					other.pippins_marker.y += 30;
					other.pippins_marker.visible = true;
					other.jongler_marker.visible = true;
					other.pluey_marker.visible = true;
					with (other.pippins_marker)
					{
						sprite_index = spr_pippins_scuffled;
						image_index = 0;
						image_speed = 0;
					}
					with (other.jongler_marker)
					{
						scr_lerpvar(""x"", x, x - 60, 12, 1, ""out"");
					}
					with (other.pluey_marker)
					{
						scr_lerpvar(""x"", x, x + 60, 12, 1, ""out"");
					}
					volume = 0;
					scr_lerpvar(""image_alpha"", 1, 0, 30);
					scr_doom(id, 30);
				}
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 32);
