{
	var _trackname = [];
	_trackname[0] = stringsetloc(""Rude Buster"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_597_0"");
	_trackname[1] = stringsetloc(""Field of Hopes and Dreams"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_598_0"");
	_trackname[2] = stringsetloc(""Knock You Down!!"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_599_0"");
	_trackname[3] = stringsetloc(""Raise Up Your Bat"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_600_0"");
	_trackname[4] = stringsetloc(""It's TV Time!"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_601_0"");
	if (global.chapter >= 5)
	{
		_trackname[5] = stringsetloc(""Third Sanctuary"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_588_0"");
		_trackname[6] = stringsetloc(""A DARK ZONE"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_589_0"");
		_trackname[7] = stringsetloc(""Flower Man"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_590_0"");
		_trackname[8] = stringsetloc(""reserved"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_592_0"");
		_trackname[9] = stringsetloc(""4rd Sanctuary"", ""scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_593_0"");
	}
	return _trackname;
}
