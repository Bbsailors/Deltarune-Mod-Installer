part_system_automatic_draw(ps, true);
part_system_automatic_update(ps, false);
part_system_automatic_update(ps2, false);
part_system_depth(ps, depth);
whirl_accel = 0.1;
whirl_accel_angle = 160;
whirl_speed_avg = 5.5;
surf_view1 = -4;
transition_clock = 0;
pt_petal = part_type_create();
part_type_sprite(pt_petal, 6127, true, true, true);
part_type_life(pt_petal, round(280 * global.fps_scale), round(320 * global.fps_scale));
part_type_direction(pt_petal, 225, 225, 0, 0);
part_type_speed(pt_petal, 5 / global.fps_scale, 6 / global.fps_scale, 0, 0.5 / global.fps_scale);
part_type_gravity(pt_petal, 0.1 / (global.fps_scale * global.fps_scale), 160);
part_type_scale(pt_petal, 2, 2);
pt_petal_whirl = part_type_create();
part_type_sprite(pt_petal_whirl, 6127, true, true, true);
part_type_life(pt_petal_whirl, round(140 * global.fps_scale), round(160 * global.fps_scale));
part_type_direction(pt_petal_whirl, 225, 225, 0, 0);
part_type_speed(pt_petal_whirl, 7.5 / global.fps_scale, 9 / global.fps_scale, 0, 3 / global.fps_scale);
part_type_gravity(pt_petal_whirl, whirl_accel / (global.fps_scale * global.fps_scale), whirl_accel_angle);
part_type_scale(pt_petal_whirl, 2, 2);
transition_stage = 0;
transition_percent = 0;
transition_line_speed = whirl_speed_avg;
u_line_bottom = shader_get_uniform(shd_petalcut, ""lineBottom"");
u_line_top = shader_get_uniform(shd_petalcut, ""lineTop"");
line_x = 0;
line_x2 = 0;

finish_transition = function()
{
	with (obj_marker)
	{
		if (sprite_index == spr_blocktree_block)
		{
			instance_destroy();
		}
	}
	with (obj_grassanim_new)
	{
		instance_destroy();
	}
	instance_create_depth(0, 0, 0, obj_grassanim_new, 
	{
		layername: ""TILES_GRASS_PINK""
	});
};
");

Apply("gml_Object_obj_sakurafubuki_new_Draw_72", @"if (!surface_exists(surf_view1) && transition_stage != 2)
{
	surf_view1 = surface_create(surface_get_width(application_surface), surface_get_height(application_surface));
	view_surface_id[1] = surf_view1;
}
if (view_current == 1 && transition_stage < 2)
{
	surface_set_target(surf_view1);
	draw_clear_alpha(c_white, 0);
	surface_reset_target();
	var _cx = camerax();
	var _cy = cameray();
	layer_set_visible(layer_get_id(""TILES_GRASS""), true);
	with (obj_blocktree_bg)
	{
		sprite_index = spr_blocktree_parts;
	}
	with (obj_marker)
	{
		if (sprite_index == spr_blocktree_block_pink)
		{
			sprite_index = spr_blocktree_block;
		}
	}
	shader_replace_simple_set_hook(12);
	var _view_scale_x = surface_get_width(surf_view1) / camera_get_view_width(view_camera[1]);
	var _view_scale_y = surface_get_height(surf_view1) / camera_get_view_height(view_camera[1]);
	shader_set_uniform_f(u_line_top, (line_x - (transition_percent * 640) - 50) * _view_scale_x, 0);
	shader_set_uniform_f(u_line_bottom, (line_x2 - (transition_percent * 640) - 110) * _view_scale_x, 480 * _view_scale_y);
}
else
{
	layer_set_visible(layer_get_id(""TILES_GRASS""), false);
	with (obj_blocktree_bg)
	{
		sprite_index = spr_blocktree_parts_pink;
	}
	with (obj_marker)
	{
		if (sprite_index == spr_blocktree_block)
