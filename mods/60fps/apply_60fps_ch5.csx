Apply("gml_Object_obj_fishingboat_Step_0", @"if (con == 1)
{
	snd_play(snd_noise, 0.4, 1.2);
	as.image_index = 0;
	fl.image_index = 0;
	as.image_speed = 0;
	fl.image_speed = 0;
	as.sprite_index = spr_fishingboat_asgore_right_surprise;
	fl.sprite_index = spr_fishingboat_flowery_reeling;
	fl.image_speed = 0.25 / global.fps_scale;
	fl.drawline = false;
	scr_shakeobj();
	con = 0;
}
if (con == 2)
{
	timer += (1 / global.fps_scale);
	var pieloc = [xstart + 168, ystart + 14];
	if (timer == 1)
	{
		fl.drawline = 0;
		fl.sprite_index = spr_fishingboat_flowery_pullrodback;
		fl.image_speed = 0;
		fl.image_index = 0;
	}
	if (timer == 3)
	{
		fl.image_index = 1;
	}
	var pulltime = 7;
	if (timer == pulltime)
	{
		fl.image_index = 2;
	}
	if (timer == (pulltime + 2))
	{
		fl.image_index = 3;
	}
	if (timer == (pulltime + 4))
	{
		fl.image_index = 4;
	}
	if (timer == (pulltime - 2))
	{
		instance_create_depth(x + 190, y + 28 + 4, depth - 1, obj_utwaterpillar);
		snd_play(snd_splash);
		snd_play(snd_splash, 0.7, 0.6);
	}
	if (timer == pulltime)
	{
		with (pie)
		{
			instance_destroy();
		}
		pie = scr_marker_ext(pieloc[0], pieloc[1], spr_fishingboat_pie, 2, 2, undefined, undefined, undefined, depth - 1);
		pie.vspeed = -38 / global.fps_scale;
		pie.hspeed = -3 / global.fps_scale;
		pie.friction = 0.25 / (global.fps_scale * global.fps_scale);
		pie.gravity = 2 / (global.fps_scale * global.fps_scale);
	}
	if (timer >= 16)
	{
		if (pie.y < (camerax() - 48))
		{
			pie.hspeed = 0;
			pie.friction = 0;
			pie.x = xstart + 112;
			pie.gravity = 2 / (global.fps_scale * global.fps_scale);
			scr_limitval_upper(pie, ""y"", ystart - 78);
			con = 2.1;
		}
	}
}
if (con == 2.1)
{
	if (pie.y > (ystart - 78 - 4 - 120))
	{
		fl.sprite_index = spr_fishingboat_flowery_presentpie;
		fl.image_speed = 0;
		fl.image_index = 0;
	}
	if (pie.y > (ystart - 78 - 4))
	{
		snd_play(snd_item);
		safe_delete(pie);
		fl.image_index = 1;
		con = 2.2;
		timer = 1 - (1 / global.fps_scale);
		piewet = true;
	}
}
if (con == 2.2)
{
	timer += (1 / global.fps_scale);
	var delaytime = 30;
	if (timer == 2)
	{
		fl.image_index = 2;
	}
	if (timer == (2 + delaytime))
	{
		fl.x += 2;
		snd_play(snd_wing);
		fl.image_index = 3;
	}
	if (timer == (2 + delaytime + 2))
	{
		as.sprite_index = spr_fishingboat_asgore_right;
		fl.image_index = 4;
		con = 2.3;
	}
}
");

