									y = start_y;
								}
								else if (image_angle == 0)
								{
									x = start_x;
									y = start_y - abs(lengthdir_y(_jump, audience_y)) - _popout;
								}
								else if (image_angle == 90)
								{
									x = start_x - abs(lengthdir_y(_jump, audience_y)) - _popout;
									y = start_y;
								}
							}
						}
					}
					i++;
				}
				if (ds_list_size(l_timings) > 0)
				{
					pattern_time = ds_list_find_value(l_timings, 0);
					ds_list_delete(l_timings, 0);
				}
				phase++;
			}
		}
		break;
	case 1:
		audience_popout = -0.1;
		phase++;
		break;
	case 2:
		pattern_time -= (1 / global.fps_scale);
		if (pattern_time <= 0)
		{
			ds_list_clear(l_audience_showup);
			ds_list_clear(l_audience_hater);
			ds_list_clear(l_audience_shoottime);
			pattern_time = 1;
			phase = 0;
			pattern_repeat++;
		}
		break;
}
");

Apply("gml_Object_obj_pink_dummy_Draw_0", @"if (!i_ex(obj_pink_enemy))
{
	exit;
}
if (i_ex(obj_date_controller))
{
	exit;
}
x -= (2 / global.fps_scale);
if (shocktimer > 0)
{
	shocktimer -= (1 / global.fps_scale);
	obj_pink_enemy.dummy_pattern = ""shocked"";
	obj_pink_enemy.dummy_pattern_timer = 118;
}
if (type == ""bg"")
{
	if (x < (camx - 110))
	{
		x = camx + camwidth + 60;
	}
	if (shocktimer > 0)
	{
		sprite_index = spr_pink_bg_dummy_shocked;
	}
	else
	{
		sprite_index = spr_pink_bg_dummy;
	}
	draw_sprite_ext(sprite_index, image_index, x, y + yoffset, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
	draw_sprite_ext(spr_pink_bg_dummy_glowstick, 0, glowstick_x, glowstick_y + yoffset, 2, 2, glowstick_angle + 20, c_white, 1);
	glowstick_x = x + 8;
	if (obj_pink_enemy.dummy_pattern != ""glowstick up and down"")
	{
		glowstick_y = lerp(glowstick_y, glowstick_ystart, scr_fps_lerp_rate(0.3));
	}
	if (obj_pink_enemy.dummy_pattern == ""every other jump"")
	{
		glowstick_y = lerp(glowstick_y, y - 20, scr_fps_lerp_rate(0.3));
	}
	if (obj_pink_enemy.dummy_pattern == ""wave"")
	{
		glowstick_y = lerp(glowstick_y, y - 20, scr_fps_lerp_rate(0.3));
	}
}
if (type == ""fg"")
{
	if (x < (camx - 100 - 121))
	{
		x = camx + camwidth + 100;
	}
	if (shocktimer > 0)
	{
		sprite_index = spr_pink_fg_dummy_shocked;
	}
	else
	{
		sprite_index = spr_pink_fg_dummy;
	}
	if (x < (camx + (camwidth / 5)))
	{
		image_index = 4;
	}
	if (x > (camx + ((camwidth / 5) * 1)) && x < (camx + ((camwidth / 5) * 2)))
	{
		image_index = 3;
	}
	if (x > (camx + ((camwidth / 5) * 2)) && x < (camx + ((camwidth / 5) * 3)))
	{
		image_index = 2;
	}
	if (x > (camx + ((camwidth / 5) * 3)) && x < (camx + ((camwidth / 5) * 4)))
	{
		image_index = 1;
	}
	if (x > (camx + ((camwidth / 5) * 4)))
	{
		image_index = 0;
	}
	var _glowstick_index = 1;
	if (image_index == 4)
	{
		_glowstick_index = 0;
	}
	if (image_index == 3)
	{
		_glowstick_index = 0;
	}
	if (image_index == 1)
	{
		_glowstick_index = 2;
	}
	if (image_index == 0)
	{
		_glowstick_index = 2;
	}
	draw_sprite_ext(spr_pink_fg_dummy_hlowstick, _glowstick_index, glowstick_x, glowstick_y + yoffset, 2, 2, glowstick_angle, c_white, 1);
	draw_sprite_ext(sprite_index, image_index, x, y + yoffset, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
	glowstick_x = x + 23;
	if (obj_pink_enemy.dummy_pattern != ""glowstick up and down"")
	{
		glowstick_y = lerp(glowstick_y, glowstick_ystart, scr_fps_lerp_rate(0.3));
	}
	if (obj_pink_enemy.dummy_pattern == ""every other jump"")
	{
		glowstick_y = lerp(glowstick_y, y + 20, scr_fps_lerp_rate(0.3));
	}
	if (obj_pink_enemy.dummy_pattern == ""wave"")
	{
		glowstick_y = lerp(glowstick_y, y + 20, scr_fps_lerp_rate(0.3));
	}
}
if (init == false)
{
	init = true;
	if (type == ""bg"")
	{
		glowstick_ystart = y - 20;
	}
	if (type == ""fg"")
	{
		glowstick_ystart = y + 20;
	}
}
if (obj_pink_enemy.dummy_pattern == ""wave"")
{
	if (wavetimer < 0)
	{
		glowstick_angle = lerp(glowstick_angle, 0, scr_fps_lerp_rate(0.3));
	}
	wavetimer += (1 / global.fps_scale);
	if (wavetimer > 60)
	{
		wavetimer = 0;
		vspeed = -8 / global.fps_scale;
		gravity = 1 / (global.fps_scale * global.fps_scale);
	}
	if (con == 0)
	{
		glowstick_angle += (9 / global.fps_scale);
		if (glowstick_angle > 30)
		{
			con = 1;
		}
	}
	else if (con == 1)
	{
		glowstick_angle -= (9 / global.fps_scale);
		if (glowstick_angle < -30)
		{
			con = 0;
		}
	}
}
if (obj_pink_enemy.dummy_pattern == ""every other jump"")
{
	wavetimer += (1 / global.fps_scale);
	if (wavetimer >= 30 && (wavecon % 2) != 0)
	{
		wavetimer = 0;
		vspeed = -8 / global.fps_scale;
		gravity = 0.8 / (global.fps_scale * global.fps_scale);
	}
	if (wavetimer >= 45 && (wavecon % 2) == 0)
	{
		wavetimer = 15;
		vspeed = -8 / global.fps_scale;
		gravity = 0.8 / (global.fps_scale * global.fps_scale);
	}
}
if (obj_pink_enemy.dummy_pattern == ""glowstick wave"")
{
	wavetimer += (1 / global.fps_scale);
	var _ang = 0;
	var _ang2 = 0;
	if (type == ""bg"")
	{
		_ang = 30;
	}
	if (wavetimer >= 20 && wavetimer < 40 && glowstick_angle > (-60 + _ang))
	{
		glowstick_angle -= (10 / global.fps_scale);
	}
	if (wavetimer >= 60 && wavetimer < 80 && glowstick_angle < (50 + _ang))
	{
		glowstick_angle += (10 / global.fps_scale);
	}
	if (wavetimer >= 80)
	{
		wavetimer = 0;
	}
}
if (obj_pink_enemy.dummy_pattern == ""glowstick up and down"")
{
	wavetimer += (1 / global.fps_scale);
	if (type == ""bg"" && wavetimer < 10)
	{
		glowstick_y = lerp(glowstick_y, glowstick_ystart, scr_fps_lerp_rate(0.3));
	}
	if (type == ""fg"" && wavetimer < 10)
	{
		glowstick_y = lerp(glowstick_y, glowstick_ystart + 24, scr_fps_lerp_rate(0.3));
	}
	if (type == ""bg"")
	{
		glowstick_angle = lerp(glowstick_angle, 10, scr_fps_lerp_rate(0.3));
	}
	if (type == ""fg"")
	{
		glowstick_angle = lerp(glowstick_angle, 0, scr_fps_lerp_rate(0.3));
	}
	if (type == ""bg"")
	{
		if (wavetimer >= 10 && wavetimer < 15)
		{
			glowstick_y -= (3 / global.fps_scale);
		}
		if (wavetimer >= 15 && wavetimer < 20)
		{
			glowstick_y += (3 / global.fps_scale);
		}
		if (wavetimer >= 20 && wavetimer < 25)
		{
			glowstick_y -= (3 / global.fps_scale);
		}
		if (wavetimer >= 25 && wavetimer < 30)
		{
			glowstick_y += (3 / global.fps_scale);
		}
		if (wavetimer >= 30)
		{
			wavetimer = -14;
		}
	}
	if (type == ""fg"")
	{
		if (wavetimer >= 10 && wavetimer < 15)
		{
			glowstick_y -= (8 / global.fps_scale);
		}
		if (wavetimer >= 15 && wavetimer < 20)
		{
			glowstick_y += (8 / global.fps_scale);
		}
		if (wavetimer >= 20 && wavetimer < 25)
		{
			glowstick_y -= (8 / global.fps_scale);
		}
		if (wavetimer >= 25 && wavetimer < 30)
		{
			glowstick_y += (8 / global.fps_scale);
		}
		if (wavetimer >= 30)
		{
			wavetimer = -14;
		}
	}
}
if ((y + vspeed) > ystart)
{
	vspeed = 0;
	gravity = 0;
	y = ystart;
}
");

