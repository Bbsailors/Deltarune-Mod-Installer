	{
		image_speed = 0;
		image_index = 0;
	}
	npc_animate = true;
	npc_animate_target = _rudinn_ranger_marker;
	if (times_talked == 0)
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* Haha^1! I love throwing^1! One crazy night^1, I cut loose and even threw a \""b-a-l-l\"".../%"", ""obj_npc_castle_town_mizzle_slash_Step_0_gml_255_0"");
	}
	else
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* It was..^1. yay big^1. (Big enough that when I threw it everyone said yay)/%"", ""obj_npc_castle_town_mizzle_slash_Step_0_gml_259_0"");
	}
	var d = d_make();
