		}
		instance_destroy();
	}
}
if (con == 2)
{
	if (x < (xx - 40) || y > (yy + 520))
	{
		timer = 0;
		gravity = 0;
		speed = 0;
		x = xx - 40;
		y = obj_heroralsei.y;
