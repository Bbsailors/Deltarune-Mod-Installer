drop_petal = function(arg0, arg1, arg2 = false, arg3 = -4, arg4 = 0.2, arg5 = false)
{
	if (i_ex(obj_battlecontroller))
	{
		var _scale = 2;
		var _petal = instance_create_depth(arg0, arg1, obj_battlecontroller.depth + 1, obj_marker_doomed, 
		{
			image_xscale: _scale,
			image_yscale: _scale,
			sprite_index: spr_spin_petal,
			image_speed: (random(0.2) + 0.1) / global.fps_scale,
			gravity_direction: 175 + random(10),
			vspeed: 5 / global.fps_scale,
			hspeed: -2 / global.fps_scale,
			gravity: 0.06 / (global.fps_scale * global.fps_scale),
			image_blend: merge_color(c_white, c_black, random(0.25))
		});
		_petal.alarm[0] = round(120 * global.fps_scale);
	}
};
");

Apply("gml_Object_obj_pink_enemy_Draw_0", @"if (saturation_effect_enabled)
{
	shader_replace_simple_set_hook(57);
	shader_set_uniform_f(pos_uni, pos);
}
if (idlesprite == spr_pink_very_hurt)
{
