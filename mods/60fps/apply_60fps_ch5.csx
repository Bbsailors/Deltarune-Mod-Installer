");

Apply("gml_Object_obj_glove_manager_Step_0", @"event_inherited();
if (i_ex(obj_heart))
{
	vspeed = scr_approach(vspeed, (0.7 / global.fps_scale) + (obj_heart.wspeed / 2), 0.041666666666666664 / global.fps_scale);
}
else
{
	vspeed = scr_approach(vspeed, 3 / global.fps_scale, 0.041666666666666664 / global.fps_scale);
}
if (alarm[1] != -1)
{
	exit;
}
expand += (0.07 / global.fps_scale);
for (var i = 0; i < bullets; i++)
{
	with (bullet[i])
	{
		image_xscale = 1 + sqrt(other.grow);
		image_yscale = 1 + sqrt(other.grow);
		dist = (90 + (33 * sin(other.expand))) * other.grow;
		angle += (other.turn / dist / global.fps_scale);
		image_angle = angle;
		x = other.x + lengthdir_x(dist, angle);
		y = other.y + lengthdir_y(dist, angle);
		if (y > (obj_growtangle.y + 100))
		{
			depth = obj_battlecontroller.depth + 1;
		}
		else
		{
			depth = 0;
		}
		if ((abs(x - obj_growtangle.x) > 75 || abs(y - obj_growtangle.y) > 75) && !place_meeting(x, y, obj_growtangle))
		{
			color = scr_approach(color, 127, 8);
		}
		else
		{
			color = scr_approach(color, 255, 8);
		}
		image_blend = make_color_rgb(color, color, color);
	}
}
if (y > (obj_growtangle.y + 170) && alarm[0] == -1)
{
	alarm[0] = round(15 * global.fps_scale);
	for (var i = 0; i < bullets; i++)
	{
		with (bullet[i])
		{
			scr_lerpvar(""image_alpha"", 1, 0, 15);
		}
	}
	scr_lerpvar(""alpha"", 1, 0, 15);
}
");

Apply("gml_Object_obj_glow_flower_Step_0", @"if (fade_state == 1 && opacity_value < 1)
{
	opacity_value += (0.05 / global.fps_scale);
}
else if (fade_state == 2 && opacity_value > 0)
{
	opacity_value -= (0.05 / global.fps_scale);
}
");

Apply("gml_Object_obj_glowtile_new_Step_0", @"if (in_phase)
{
	var attracting = attractlist[clamp(currentphase - 1, 0, array_length(attractlist) - 1)];
	if (attracting != ""nobody"")
	{
		var _char_exists = -1;
		if (global.interact != 1)
		{
			with (obj_caterpillarchara)
			{
				if (name == attracting)
				{
					_char_exists = id;
					image_alpha = 0;
					follow = 1;
					fun = 0;
				}
			}
		}
		if (_char_exists != -1)
		{
			if (active_marker == -1)
			{
				with (obj_marker_z)
				{
					if (variable_instance_exists(id, ""name"") && name == (""attract_"" + attracting))
					{
						other.active_marker = id;
					}
				}
				if (active_marker == -1)
				{
					active_marker = scr_dark_marker(_char_exists.x, _char_exists.y, _char_exists.sprite_index);
					with (active_marker)
					{
						alerted = false;
						readytogo = 0;
						instance_change(obj_marker_z, true);
						movedthisframe = false;
						name = ""attract_"" + attracting;
						stepper = true;
						puzzle_id = other.puzzle_id;
						returnmode = false;
						mycaterpillar = _char_exists;
						tx = other.x;
						ty = (other.y - sprite_height) + 16;
						dir = 0;
						walktimer = 0;
						jumping = false;
						usprite = _char_exists.usprite;
						dsprite = _char_exists.dsprite;
						lsprite = _char_exists.lsprite;
						rsprite = _char_exists.rsprite;
						if (attracting == ""susie"")
						{
							walkspeed = 5;
						}
						if (attracting == ""ralsei"")
						{
							walkspeed = 8;
							if (global.flag[1311] == 1)
							{
								ty += 4;
							}
						}
					}
				}
			}
			else
			{
				with (active_marker)
				{
					if (alerted == false)
					{
						alerted = true;
						scr_emote(""!"", 10);
					}
					else if (readytogo < 15)
					{
						readytogo += (1 / global.fps_scale);
					}
					else
					{
						returnmode = false;
						tx = other.x;
						ty = (other.y - sprite_height) + 16;
						jumping = false;
						if (name == ""attract_ralsei"" && global.flag[1311] == 1)
						{
							ty += 4;
						}
					}
				}
			}
		}
	}
	if (stepbuffer > 0)
	{
		stepbuffer -= (1 / global.fps_scale);
	}
	else if (pressed)
	{
		pressed = false;
		sprite_index = spr_glowtile_step;
	}
}
else
{
	if (cutscene_mode == 0)
	{
		sprite_index = spr_glowtile_off;
	}
	pressed = false;
	is_targeted = false;
	active_marker = -1;
}
if (cutscene_mode != 0)
{
	mask_index = spr_glowtile_on_w;
	if (cutscene_mode == 1)
	{
		sprite_index = spr_glowtile_step;
	}
	if (cutscene_mode == 2)
	{
		sprite_index = spr_glowtile_on_w;
		image_index = 0;
		image_speed = 0;
	}
}
else
{
	mask_index = sprite_index;
}
con = in_phase;
");

Apply("gml_Object_obj_glowtile_puzzle_new_Draw_0", @"if ((follow_mode && state == 1) || stillflying || (takeoff_mode == true && state == 2))
{
	tick += (1 / global.fps_scale);
	if (tick > 3)
	{
		tick = 0;
		if (frame == 4)
		{
			frame = 3;
		}
		else
		{
			frame = 4;
		}
	}
	draw_sprite_ext(mainsprite, frame, x, y, image_xscale, image_yscale, image_angle, c_white, image_alpha);
}
else
{
	draw_sprite_ext(mainsprite, 0, x, y, image_xscale, image_yscale, image_angle, c_white, image_alpha);
}
if (simple_mode)
{
	draw_sprite_ext(spr_glowpuzzletimer_button, (cutscene_mode == 0 && state == 0) ? 0 : 1, x, y, image_xscale, image_yscale, image_angle, c_white, image_alpha);
}
var _failtimer_in_seconds = failtimer / 30;
var _ones = floor(_failtimer_in_seconds % 10);
var _tens = _failtimer_in_seconds div 10;
var _failtimer_ms = frac(_failtimer_in_seconds) * 100;
var _frac1 = _failtimer_ms div 10;
var _frac2 = _failtimer_ms % 10;
if (state == 0.5)
{
	var _alpha = 1;
	var _digitcol = 16777215;
	draw_sprite_ext(spr_timer_digits, 10 + startuptime, x + (20 * image_xscale), y - (5 * image_yscale), image_xscale, image_yscale, image_angle, _digitcol, _alpha);
}
if (state == 1 || showfinaltime > 0 || cutscene_mode == 1)
{
	var _alpha = (showfinaltime > 0) ? (1 - floor((showfinaltime / 15) % 2)) : 1;
	var _digitcol = 16777215;
	draw_sprite_ext(mainsprite, 1, x, y, image_xscale, image_yscale, image_angle, _digitcol, _alpha);
	draw_sprite_ext(spr_timer_digits, _ones, x - (2 * image_xscale), y - (5 * image_yscale), image_xscale, image_yscale, image_angle, _digitcol, _alpha);
	if (_tens > 0)
	{
		draw_sprite_ext(spr_timer_digits, 10 + _tens, x - (2 * image_xscale), y - (5 * image_yscale), image_xscale, image_yscale, image_angle, _digitcol, _alpha);
	}
	draw_sprite_ext(spr_timer_digits, 10 + _frac1, x + (20 * image_xscale), y - (5 * image_yscale), image_xscale, image_yscale, image_angle, _digitcol, _alpha);
	if (cutscene_mode == 0)
	{
		showfinaltime -= (1 / global.fps_scale);
	}
}
if (bonus_alpha > 0 && !simple_mode)
{
	_ones = floor(bonus_time % 10);
	_tens = bonus_time div 10;
	var _ms = frac(bonus_time) * 100;
	_frac1 = _ms div 10;
	_frac2 = _ms % 10;
	draw_sprite_ext(mainsprite, 2, x, y, image_xscale, image_yscale, image_angle, bonus_col, bonus_alpha);
	draw_sprite_ext(spr_timer_smalldigits, _ones, x, y, image_xscale, image_yscale, image_angle, bonus_col, bonus_alpha);
	if (_tens > 0)
	{
		draw_sprite_ext(spr_timer_smalldigits, _tens, x - (image_xscale * 4), y, image_xscale, image_yscale, image_angle, bonus_col, bonus_alpha);
	}
	draw_sprite_ext(spr_timer_smalldigits, _frac1, x + (image_xscale * 6), y, image_xscale, image_yscale, image_angle, bonus_col, bonus_alpha);
	bonus_alpha -= (0.025 / global.fps_scale);
}
");

