Apply("gml_Object_obj_particle_effect_Step_0", @"if (init == 0)
{
	if (random_image)
	{
		image_speed = 0;
		image_index = irandom(image_number - 1);
	}
	init = 1;
}
if (speed_animate > 0)
{
	image_speed = clamp01(speed / speed_animate);
}
if (rotation != 0 && global.pause_plat == 0)
{
	image_angle += (rotation / global.fps_scale);
}
if (dir_rotation != 0)
{
	direction += rotation;
}
if (destroyoffscreen && (x < (camerax() - 50) || x > (camerax() + 680) || y < (cameray() - 50) || y > (cameray() + 510)))
{
	instance_destroy();
}
else if (lifetime > 0)
{
	lifetime -= (1 / global.fps_scale);
	if (lifetime <= 0)
	{
		instance_destroy();
	}
	else if (fadeondeath && lifetime < 10)
	{
		image_alpha = lifetime / 10;
	}
}
");

Apply("gml_Object_obj_particle_generic_Step_0", @"image_alpha = scr_approach(image_alpha, 0, fade_rate);
image_xscale = scr_approach(image_xscale, 0, shrink_rate);
image_yscale = scr_approach(image_yscale, 0, shrink_rate);
if (acceleration_rate != 0)
{
	switch (acceleration_type)
	{
		case 0:
			speed = scr_approach(speed, acceleration_goal / global.fps_scale, acceleration_rate / global.fps_scale);
			break;
		case 1:
			speed *= power(acceleration_rate, 1 / global.fps_scale);
			break;
	}
}
if (image_xscale == 0 || image_yscale == 0)
{
	instance_destroy();
}
if (image_alpha == 0)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_pathbox_Step_0", @"if (instance_number(obj_heart) == 1)
{
	wait -= (1 / global.fps_scale);
	image_xscale = _xs;
	image_yscale = _ys;
	with (c_top)
	{
		image_xscale = other._xs;
		x = other.x;
		y = (other.y - other._ys) + 2;
	}
	with (c_bot)
	{
		image_xscale = other._xs;
		x = other.x;
		y = (other.y + other._ys) - 2;
	}
	fade = scr_approach(fade, 0, 0.1);
	if (wait < -100)
	{
		max_spd = scr_approach(max_spd, 0, 0.005);
	}
	if (wait < 0)
	{
		h_spd = scr_approach(h_spd, -max_spd, 1);
		_h = 0;
		if (flowers < 2)
		{
			with (obj_heart)
			{
				if (dash_fail_x < x)
				{
					dash_fail_x += (other.max_spd / global.fps_scale);
					dash_reset_x += (other.max_spd / global.fps_scale);
				}
			}
		}
		_xs = scr_approach(_xs, 2400, 100);
		x = scr_approach(x, xstart + 1200, 50);
		alpha = scr_approach(alpha, 0.5, 0.1);
		with (obj_flower_wall)
		{
			if (wait <= 0)
			{
				if (x < obj_heart.x)
				{
					x += (abs(other.h_spd) / global.fps_scale);
				}
			}
		}
		if (!flowers && x == (xstart + 1200))
		{
			random_set_seed(1);
			for (i = 0; i < 15; i++)
			{
				var o = instance_create(64 + irandom_range(-5, 5), (i * 12.5) + irandom_range(-5, 5), obj_flower_wall);
				o.timer = i * 5;
				o = instance_create(64 + irandom_range(-5, 5), (320 - (i * 12.5)) + irandom_range(-5, 5), obj_flower_wall);
				o.timer = i * 5;
			}
			randomize();
			with (obj_heart)
			{
				dash_fail_x = 64;
			}
			flowers = true;
		}
	}
	if (obj_heart.dash_h > 0)
	{
		if (collision_rectangle(x - _xs, y - _ys, (x - _xs) + 4, y + _ys, obj_heart, 0, 0))
		{
			ripple_left = 5;
			ripple_spd = 100;
		}
		if (collision_rectangle(x + _xs, y - _ys, (x + _xs) - 4, y + _ys, obj_heart, 0, 0))
		{
			ripple_right = 5;
			ripple_spd = 100;
		}
	}
	ripple_left = scr_approach(ripple_left, 0, 0.2);
	ripple_right = scr_approach(ripple_right, 0, 0.2);
	if (wait < 0)
	{
		while (abs(_h) >= 1)
		{
			if (place_meeting(x + sign(h_spd), y, obj_heart) && obj_heart.dash_act == 0)
			{
				obj_heart.x += sign(h_spd);
			}
			_h -= sign(_h);
		}
		while (abs(_v) >= 1)
		{
			if (place_meeting(x, y + sign(v_spd), obj_heart) && obj_heart.dash_act == 0)
			{
				obj_heart.y += sign(v_spd);
			}
			_v -= sign(_v);
		}
	}
}
else
{
	alpha2 -= (0.2 / global.fps_scale);
	if (alpha2 <= 0)
	{
		with (obj_growtangle)
		{
			y = ystart;
		}
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_persistentfadein_Draw_0", @"image_alpha += (fadespeed / global.fps_scale);
draw_sprite_ext(sprite_index, image_index, x, y, length, height, 0, image_blend, image_alpha);
if (image_alpha <= 0)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_petal_Step_0", @"t += (tt / global.fps_scale);
wait = max(wait - 1, 0);
if (border_fixate)
{
	exit;
}
if (!scaling)
{
	exit;
}
if (instance_exists(owner) && !dispersed)
{
	x = owner.x + (sin(t * fx) * ax);
	y = owner.y + (cos(t * fy) * ay);
	depth = owner.depth;
	if (instance_exists(obj_plat_player))
	{
		if (sign(x == xprevious) == sign(bg_side))
		{
			depth = obj_plat_player.depth + (bg_side * 10);
		}
		else
		{
			depth = obj_plat_player.depth - (bg_side * 10);
		}
	}
}
image_xscale = cos(t * ff) * scale;
image_yscale = sin(t * ff) * scale;
image_angle += (rspd / global.fps_scale);
if (dispersed)
{
	speed *= power(0.95, 1 / global.fps_scale);
}
");

Apply("gml_Object_obj_petal_burst_Step_0", @"if (!init)
{
	init = true;
	var _sprite_count = array_length(sprites);
	var _theta = spread / (count - 1);
	for (i = 0; i < count; i++)
	{
		var _data = scr_copy_struct(default_particle_data);
		_data.direction = (direction - (spread / 2)) + (_theta * i) + irandom_range(-deviation, deviation);
		_data.speed = random_range(min_speed, max_speed) * 1.5;
		_data.friction = 1.5;
		_data.siner = random(94.24777960769379);
		_data.image_blend = image_blend;
		_data.sprite_index = sprites[irandom(_sprite_count - 1)];
		_data.image_index = irandom(3);
		_data.image_blend = c_white;
		_data.x = x;
		_data.y = y;
		array_push(particle_data, _data);
	}
}
var num_particles = array_length(particle_data);
var _cam_bottom = camera_get_view_y(view_camera[0]) + 500;
var i = num_particles - 1;
while (i >= 0)
{
	with (particle_data[i])
	{
		if (speed < 5)
		{
			friction = 0.4;
		}
		if (speed < 2)
		{
			fallspeed = scr_movetowards(fallspeed, 2, 0.1 / global.fps_scale);
		}
		y += (fallspeed / global.fps_scale);
		x += ((sin(siner / 15) * (fallspeed / 2)) / global.fps_scale);
		siner += (1 / global.fps_scale);
		image_speed = 1 + (speed / 15);
		image_index += (image_speed / 3 / global.fps_scale);
		speed = scr_movetowards(speed, 0, friction / global.fps_scale);
		x += (lengthdir_x(speed, direction) / global.fps_scale);
		y += (lengthdir_y(speed, direction) / global.fps_scale);
		if (y > _cam_bottom)
		{
			array_delete(other.particle_data, i, 1);
		}
	}
	i--;
}
");

Apply("gml_Object_obj_petal_whirlwind_Step_0", @"if (!active)
{
	exit;
}
if (global.pause_plat)
{
	exit;
}
timer += (1 / global.fps_scale);
if (strength > 1)
{
	strength = scr_movetowards(strength, 3, 0.2 / global.fps_scale);
}
if (strength > 1.4)
{
	trail_strength = scr_movetowards(trail_strength, 1, 0.016666666666666666 / global.fps_scale);
}
ys = scr_platswap_yscale();
if (!scr_onscreen_tolerance(id, 100))
{
	exit;
}
if (timer >= rate)
{
	var _leaf = ((count % 3) == 0) ? instance_create(x, y + (ys[0] * 30), obj_whirlwind_particle) : instance_create(x, y, obj_leaf_storm);
	_leaf.siner = random(62.83185307179586);
	_leaf.lifetime = lifetime;
	_leaf.style = style;
	_leaf.owner = id;
	timer = 0;
	_leaf.depth = depth;
	if ((count % 9) == 0)
	{
		var _windtrail = instance_create(x, y, obj_wind_trail);
		_windtrail.direction = (trailcount * 30) + irandom_range(-30, 30);
		_windtrail.owner = id;
		_windtrail.depth = depth;
		_windtrail.rising = true;
		trailcount++;
	}
	count++;
}
");

Apply("gml_Object_obj_petalwing_Step_0", @"if (instance_exists(fixate))
{
	x = fixate.x;
	y = fixate.y;
}
if (in_use && instance_exists(obj_plat_player))
{
	x = obj_plat_player.x;
	y = obj_plat_player.y;
	depth = obj_plat_player.depth;
	if (!timerstart)
	{
		snd_play(snd_petaldrain, 1, 1.2);
		timerstart = 1;
		var _petals = array_length(petal);
		for (var i = 0; i < _petals; i++)
		{
			if (instance_exists(petal[i]))
			{
				with (petal[i])
				{
					dispersed = 1;
					direction = point_direction(owner.x, owner.y, x, y);
					speed = 12 / global.fps_scale;
					friction = 0.2 / (global.fps_scale * global.fps_scale);
					scr_doom(id, 15);
					scr_lerpvar(""image_alpha"", 1, 0, 15);
				}
			}
		}
		array_delete(petal, 0, array_length(petal));
	}
	unequip = 0;
	recovering = 0;
	if (timer >= timermax && !got_new_petal)
	{
		time_idling += (1 / global.fps_scale);
		if (time_idling >= 60 && border.letterbox_h == border.letterbox_hmax)
		{
			with (border)
			{
				scr_lerpvar(""letterbox_h"", letterbox_h, letterbox_hmin, 10, 3, ""inout"");
			}
		}
	}
	else
	{
		time_idling = 0;
		got_new_petal = false;
		if (border.letterbox_h <= border.letterbox_hmin)
		{
			with (border)
			{
				scr_lerpvar(""letterbox_h"", letterbox_h, letterbox_hmax, 10, 3, ""inout"");
			}
		}
	}
	time_since_drain += (1 / global.fps_scale);
	var _drain = 0;
	if (_drain > 0)
	{
		time_since_drain = 0;
	}
	if (time_since_drain > 60 && timer < timermax)
	{
		if (timer < timermax)
		{
			timer = clamp(timer + (2 / global.fps_scale), timer, timermax);
			if (timer == timermax)
			{
				snd_play_pitch(snd_ominous_cancel, 1.1);
			}
		}
		if ((global.time % round(4 * global.fps_scale)) == 0)
		{
			flash_white = flash_whitemax;
		}
		if (timer < timermax && (global.time % round(2 * global.fps_scale)) == 0)
		{
			var _pitch = lerp(0.5, 3, timer / timermax);
			audio_stop_sound(snd_petal_recover);
			snd_play_pitch(snd_petal_recover, _pitch);
		}
	}
	if (timerstart && ((!recovering && timer_toggle) || _drain))
	{
		_drain = max(_drain, 1);
		timer = clamp(timer - (_drain / global.fps_scale), 0, timermax);
	}
}
");

Apply("gml_Object_obj_pine_tree_telegraph_Draw_0", @"if (global.turntimer < 1)
{
	instance_destroy();
}
if (con == 0)
{
	image_alpha += (0.2 / global.fps_scale);
	if (image_alpha == 0)
	{
		snd_play_x(snd_bell_bounce_short, 0.8, 1);
	}
	if (image_alpha >= 1.2)
	{
		con = 1;
	}
}
if (con == 1)
{
	image_alpha -= (0.2 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
var _x1 = x1;
var _x2 = x2;
for (var i = 0; i < instance_number(obj_pine_tree_telegraph); i++)
{
	tele[i] = instance_find(obj_pine_tree_telegraph, i);
	if (tele[i] != id)
	{
		if (x1 < tele[i].x2 && x2 > tele[i].x2)
		{
			x1 = tele[i].x2 + 1;
		}
		if (x2 > tele[i].x1 && x1 < tele[i].x1)
		{
			x2 = tele[i].x1 - 1;
		}
	}
}
draw_set_alpha(image_alpha);
draw_set_color(c_gray);
d_rectangle(x1, y1, x2, y2, false);
draw_set_alpha(1);
");

Apply("gml_Object_obj_pink3durgenter_Step_0", @"event_inherited();
life_time += (1 / global.fps_scale);
if (life_time == 20)
{
	snd_play(snd_electroshock);
}
if (life_time == 30)
{
	active = 1;
}
if (pattern_time > 0)
{
	pattern_time -= ((1/15) / global.fps_scale);
}
var i = 0;
do
{
	array_frame[i] += 1 / global.fps_scale;
	if (array_frame[i] >= 2 && array_frame[i] < 3)
	{
		if (irandom(59) != 0)
		{
			array_frame[i] -= 2;
		}
	}
	if (array_frame[i] >= image_number)
	{
		array_frame[i] -= image_number;
	}
	i++;
}
until ((i * dir_add) >= 360);
");

Apply("gml_Object_obj_pink_battlemovement_Create_0", @"with (obj_pink_enemy)
{
	visible = false;
}
image_xscale = 2;
image_yscale = 2;
image_speed = 0.334 / global.fps_scale;
mode = 0;
anim_subtick = 0;
anim_tick = true;
phase = 0;
pattern_time = 0;
animation_time = 0;
grid_x = irandom(3);
grid_y = irandom(3);
pattern_variant = irandom(3);
ammo = 0;
ammo_b = 0;
ammo_max = 0;
shots = 0;
shots_total = 0;
pattern_repeat = 0;
list_bomb = ds_list_create();
list_bomb_xy = ds_list_create();
bigbomb_id = -4;
ammo_doki = 3;
list_burnt = ds_list_create();
start_x = x;
start_y = y;
dest_x = x;
dest_y = y;
wave_angle = 90;
wave_speed = 0;
shake_x = 0;
shake_y = 0;
flash_amount = 0;
on_the_box = false;
box_y_original = 0;
with (obj_growtangle)
{
	other.box_y_original = y;
}
box_pushdown_dest = 0;
box_pushdown_real = 0;
air_time = 1;
air_height = 90;
");

Apply("gml_Object_obj_pink_battlemovement_Step_0", @"anim_subtick += (1 / global.fps_scale);
anim_tick = anim_subtick >= 1;
if (anim_tick)
{
	anim_subtick -= 1;
}
shake_x = scr_approach(shake_x, 0, 2);
shake_y = scr_approach(shake_y, 0, 2);
flash_amount = scr_approach(flash_amount, 0, 0.1);
switch (mode)
{
	case 0:
		if (sprite_index == spr_pink_front_ohoho)
		{
			animation_time += (1 / global.fps_scale);
			if (animation_time == 1)
			{
				image_index = 0;
				image_speed = 0.5 / global.fps_scale;
			}
			if (animation_time == 5)
			{
				image_speed = 0.334 / global.fps_scale;
			}
			if (animation_time == 17)
			{
				image_speed = 0.25 / global.fps_scale;
			}
		}
		break;
	case 1:
		if (global.turntimer <= 0)
		{
			with (obj_growtangle)
			{
				image_xscale = (image_xscale * 0.75) + (maxxscale * 0.25);
				if (image_xscale > (maxxscale - 1) && image_xscale < (maxxscale + 1))
				{
					image_xscale = maxxscale;
				}
				image_yscale = (image_yscale * 0.75) + (maxyscale * 0.25);
				if (image_yscale > (maxyscale - 1) && image_yscale < (maxyscale + 1))
				{
					image_yscale = maxyscale;
				}
			}
		}
		if (air_time > 0)
		{
			air_time = max(0, air_time - (5.12 / air_height / global.fps_scale));
			if (air_time <= 0)
			{
				x = dest_x;
				y = dest_y;
				mode = 0;
				if (!instance_exists(obj_pink_curtains))
				{
					sprite_index = spr_pink_idle;
					image_speed = 0.334 / global.fps_scale;
				}
				else
				{
					depth += 5;
					sprite_index = spr_pink_sing;
					image_xscale = -image_xscale;
					image_index = 0;
					image_speed = 0;
					image_xscale = -image_xscale;
					pattern_time = -20;
					mode = 7;
				}
				if (global.turntimer > 0)
				{
					on_the_box = true;
					box_pushdown_dest = 56;
					with (obj_purplecontrols)
					{
						can_spin = true;
					}
				}
				else
				{
					instance_destroy();
				}
			}
		}
		break;
	case 2:
	case 3:
	case 4:
		switch (phase)
		{
			case 0:
				sprite_index = spr_pink_front_throw_bomb;
				image_index = 0;
				image_speed = 0;
				pattern_time = 0;
				if (mode == 2)
				{
					ammo = 4;
				}
				if (mode == 3)
				{
					ammo = 2;
				}
				if (mode == 4)
				{
					ammo = 7;
				}
				ds_list_clear(list_bomb);
				switch (mode)
				{
					case 3:
						switch (irandom(8))
						{
							case 0:
								ds_list_add(list_bomb, 0, 1.5);
								break;
							case 1:
								ds_list_add(list_bomb, 0, 2);
								break;
							case 2:
								ds_list_add(list_bomb, 0, 2.5);
								break;
							case 3:
								ds_list_add(list_bomb, 0.5, 2);
								break;
							case 4:
								ds_list_add(list_bomb, 0.5, 2.5);
								break;
							case 5:
								ds_list_add(list_bomb, 0.5, 3);
								break;
							case 6:
								ds_list_add(list_bomb, 1, 2.5);
								break;
							case 7:
								ds_list_add(list_bomb, 1, 3);
								break;
							default:
								ds_list_add(list_bomb, 1.5, 3);
								break;
						}
						ds_list_shuffle(list_bomb);
						break;
					case 4:
						switch (irandom(8))
						{
							case 0:
								ds_list_add(list_bomb, 0, 1.5);
								break;
							case 1:
								ds_list_add(list_bomb, 0, 2);
								break;
							case 2:
								ds_list_add(list_bomb, 0, 2.5);
								break;
							case 3:
								ds_list_add(list_bomb, 0.5, 2);
								break;
							case 4:
								ds_list_add(list_bomb, 0.5, 2.5);
								break;
							case 5:
								ds_list_add(list_bomb, 0.5, 3);
								break;
							case 6:
								ds_list_add(list_bomb, 1, 2.5);
								break;
							case 7:
								ds_list_add(list_bomb, 1, 3);
								break;
							default:
								ds_list_add(list_bomb, 1.5, 3);
								break;
						}
						ds_list_shuffle(list_bomb);
						ds_list_insert(list_bomb, 0, 0);
						ds_list_add(list_bomb, 0);
						break;
					default:
						ds_list_add(list_bomb, 0, 1, 2, 3);
						ds_list_shuffle(list_bomb);
				}
				shots = 0;
				phase++;
			case 1:
				if (anim_tick)
				{
					switch (floor(image_index))
					{
						case 0:
							image_index += 0.125;
							break;
						case 1:
							image_index += 0.334;
							break;
						case 2:
							image_index += 0.334;
							break;
						case 3:
							image_index += 0.5;
							break;
						case 4:
							image_index += 0.5;
							break;
						case 5:
							image_index += 0.25;
							break;
						case 6:
							image_index += 0.5;
							break;
						case 7:
							image_index += 1;
							break;
						case 8:
							image_index += 1;
							break;
						case 9:
							image_index += 1;
							break;
						case 10:
							image_index += 1;
							if (mode == 4)
							{
								if (image_index >= 11)
								{
									if (ammo_b > 0)
									{
										image_index = 7;
										if (!instance_exists(bigbomb_id))
										{
											bigbomb_id = instance_create_depth(x + 4, y - 88, depth - 1, obj_fusebomb);
											with (bigbomb_id)
											{
												fuse_time = 60;
												air_time = 0;
												air_height = 0;
												mode = 1;
												inside_the_grid = false;
												x = dest_x;
												y = dest_y;
												grid_x = 1.5;
											}
										}
										else
										{
											with (bigbomb_id)
											{
												grow += min(other.ammo_b, 0.3);
												other.ammo_b = max(0, other.ammo_b - 0.3);
											}
										}
									}
								}
							}
							break;
						case 11:
							image_index += 1;
							break;
						case 12:
							if (instance_exists(bigbomb_id))
							{
								pattern_time++;
								if (pattern_time == 20)
								{
									snd_play(snd_pink_huh);
								}
								if (pattern_time >= 20)
								{
									if ((pattern_time % 4) == 0)
									{
										shake_x = -2;
									}
									if ((pattern_time % 4) == 2)
									{
										shake_x = 2;
									}
								}
							}
							else if (mode != 4 || ammo >= 7 || ammo <= 1)
							{
								image_index += 0.167;
							}
							else
							{
								image_index += 0.5;
							}
							break;
						default:
							image_index += 0.334;
							if (image_index >= 14)
							{
								y -= 24;
								phase++;
							}
					}
				}
				break;
			case 2:
				if (anim_tick)
				{
					switch (floor(image_index))
					{
						case 14:
							image_index += 1;
							if (image_index >= 15)
							{
								var _bulk = 1;
								repeat (_bulk)
								{
									ammo--;
									shots++;
									shots_total++;
									if (!instance_exists(bigbomb_id))
									{
										snd_play(choose(snd_pink_throw, snd_pink_throw2));
										snd_play(snd_whip_throw_only);
										snd_play(snd_bump);
										var _bom = instance_create_depth((x - 60) + (ds_list_find_value(list_bomb, ammo % 4) * 40), y + 58, depth - 1, obj_fusebomb);
										with (_bom)
										{
											fuse_time = 40;
											air_height = 110;
											mode = 1;
											inside_the_grid = false;
											x = other.x;
											y = dest_y + 16;
											grid_x = ds_list_find_value(other.list_bomb, other.ammo % 4);
										}
									}
									else
									{
										with (bigbomb_id)
										{
											fuse_time = 45;
											air_time = 1;
											air_height = 20;
											mode = 1;
											x = other.x;
											dest_y += 106;
										}
									}
								}
							}
							break;
						case 15:
							if ((mode != 4 && ammo > 0) || (ammo > 0 && ammo != 1 && ammo != 5))
							{
								image_index += 1;
							}
							else
							{
								image_index += 0.5;
							}
							break;
						case 16:
						case 17:
							if ((mode != 4 && ammo > 0) || (ammo > 0 && ammo != 1 && ammo != 5))
							{
								image_index += 2;
								if (image_index >= 17)
								{
									image_index = 3;
									y += 24;
