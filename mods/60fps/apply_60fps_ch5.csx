		repeat (1)
		{
			petals_particle_system.x = x;
			petals_particle_system.y = y;
			petals_particle_system.depth = depth + 10;
			var lifetime = irandom_range(30, 60);
			var spd = (8 + (random_range(3, 8) * 2)) / 2;
			var _dir = dir + random_range(-60, 60);
			petals_particle_struct.fadeout_speed = 2 / lifetime;
			petals_particle_struct.hspeed = lengthdir_x(spd, _dir);
			petals_particle_struct.vspeed = lengthdir_y(spd, _dir);
			petals_particle_struct.image_speed = random_range(0.2, 0.3);
			petals_particle_struct.image_index = random_range(0, 10);
			petals_particle_system.emit(petals_particle_struct);
			if ((timer % 4) == 0)
			{
				if (timer % 8)
				{
					snd_stop(mini_soundB);
					mini_soundB = snd_play(snd_enemy_defeat_quick, 1, 0.8);
				}
				else
				{
					if (timer > 0)
					{
						snd_stop(mini_soundA);
					}
					if (timer < 22)
					{
						mini_soundA = snd_play(snd_enemy_defeat_quick, 1, 0.8);
					}
