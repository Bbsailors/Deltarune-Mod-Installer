Apply("gml_Object_obj_pinklanebullet_Step_0", @"event_inherited();
if (friction > 0)
{
	var _minspeed = (2/3) / global.fps_scale;
	friction = clamp((speed - _minspeed) / 4 / global.fps_scale, 0, friction);
	if (friction <= 0)
	{
		speed = _minspeed;
	}
}
if (gravity > 0)
{
	if (speed >= (12 / global.fps_scale))
	{
		gravity = min(gravity, 1 / (global.fps_scale * global.fps_scale));
	}
}
life_time += 1;
var _limit = max(80 * global.fps_scale, 720 / max(speed, 0.1));
if (life_time == 1)
{
	var _highest_id = -1;
	var _amount = 0;
	with (obj_pinklanebullet)
	{
		if (life_time == 1 || life_time == 0)
		{
			_amount++;
			if (id > _highest_id)
			{
				_highest_id = id;
			}
		}
	}
	if (id == _highest_id)
	{
		if (_amount < 2)
		{
			snd_play(snd_heartshot_dr, 1, 0.65);
		}
		else
		{
			snd_play(snd_heartshot_dr, 1, 0.4);
			snd_play(snd_heartshot_dr, 1, 0.9);
		}
	}
}
if (life_time < _limit)
{
	image_alpha = clamp(image_alpha + (0.25 / global.fps_scale), 0, 1);
}
else if (life_time >= _limit)
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0.001)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_pinkmeteor_Step_0", @"event_inherited();
var _freeze = false;
if (!_freeze)
{
	life_time += (1 / global.fps_scale);
	switch (phase)
	{
		case 0:
			phase++;
			life_time = 0;
			break;
		case 1:
			var _pre_boom_frames = 15;
			var _speedoflight = ((((_pre_boom_frames + 2) - life_time) / (_pre_boom_frames + 2)) * 2.5) / global.fps_scale;
			var i = 0;
			repeat (5)
			{
				lightray_dir[i] += (3 + i) * (1 - (2 * (i % 2))) * _speedoflight * 2;
				lightray_dist[i] += (7 + i) * _speedoflight * 2;
				i++;
			}
			if (life_time > _pre_boom_frames)
			{
				phase++;
				life_time = 0;
				snd_play(snd_explosion);
				scr_shakescreen();
				with (obj_shake)
				{
					shakex = 30;
					shakey = 30;
					shakesign = 0.5;
				}
				heat_alpha += 0.1;
				var _dir = 55;
				var _spd = 7 + random(15);
				repeat (16)
				{
					var _boombit = instance_create_depth(x, y - 48, depth + 3, obj_explosion_flamingbit);
					_boombit.direction = (_dir - 1) + random(2);
					_boombit.speed = _spd / global.fps_scale;
					_dir += 4.666666666666667;
					_spd += (5 + random(5));
					if (_spd > 22)
					{
						_spd -= 15;
					}
				}
				mother = -4;
				global.turntimer = min(global.turntimer, 1);
			}
			break;
		case 2:
			x = max(camera_get_view_x(view_camera[0]) + 16, x);
			if (life_time <= 10 && frac(life_time) == 0)
			{
				var _boom = instance_create_depth(x + lengthdir_x(life_time * 12, pattern_dir), (y - 80) + lengthdir_y(life_time * 9, pattern_dir), depth + 2, obj_slidedust);
				pattern_dir = scr_wrap(pattern_dir + 60 + random(90), 0, 360);
				_boom.image_xscale = 2;
				_boom.image_yscale = _boom.image_xscale;
				_boom.x -= 25 * _boom.image_xscale;
				_boom.y -= 33 * _boom.image_yscale;
				_boom.sprite_index = spr_explosion_round;
				_boom.image_speed = 0.5 / global.fps_scale;
				_boom.alarm[5] = _boom.image_number * (1 / _boom.image_speed);
			}
			if (life_time == 11)
			{
				with (obj_slidedust)
				{
					if (sprite_index == spr_explosion_round)
					{
						image_speed = 0.334 / global.fps_scale;
						alarm[5] = floor(alarm[5] * 1.5);
					}
				}
			}
			heat_alpha -= (0.005 / global.fps_scale);
			if (heat_alpha <= 0)
			{
				instance_destroy();
			}
			break;
	}
}
else
{
	x -= hspeed;
	y -= vspeed;
	if (radius > 128)
	{
		radius = 128;
	}
	else
	{
		radius = max(48, (48 + ((radius - 48) / 2)) - 1);
	}
}
");

Apply("gml_Object_obj_pinkmeteorfire_Step_0", @"var _freeze = false;
if (!_freeze)
{
	image_angle += ((spin_dir * 30) / global.fps_scale);
	image_xscale -= (0.3 / global.fps_scale);
	image_yscale = image_xscale;
	if (image_xscale <= 0.001)
	{
		instance_destroy();
	}
}
else
{
	x -= hspeed;
	y -= vspeed;
}
");

Apply("gml_Object_obj_pinknode_Step_0", @"if (pulse >= 0)
{
	pulse += (26 / global.fps_scale);
	var i = 0;
	repeat (4)
	{
		if (instance_exists(child[i]) && draw_connection[i])
		{
			var _dist = point_distance(dest_x, dest_y, child[i].dest_x, child[i].dest_y);
			if (pulse >= _dist && child[i].pulse < 0)
			{
				child[i].pulse = pulse - _dist;
			}
			if (pulse >= (_dist + pulse_length))
			{
				pulse = -1;
			}
			break;
		}
		i++;
	}
	if (i >= 4)
	{
		pulse = -1;
	}
}
if (doki_delay > 0)
{
	doki_delay -= (1 / global.fps_scale);
	if (doki_delay <= 0)
	{
		var _doki_x = x;
		var _doki_y = y;
		var _doki_mother = id;
		var _backup_activated = false;
		if (instance_exists(doki_backup_node))
		{
			with (obj_purplecontrols)
			{
				if (node_id == other.id)
				{
					_backup_activated = true;
				}
				else
				{
					var i = 0;
					repeat (4)
					{
						if (other.child[i] == node_id)
						{
							_backup_activated = true;
							break;
						}
						i++;
					}
				}
			}
		}
		if (_backup_activated)
		{
			_doki_x = doki_backup_node.x;
			_doki_y = doki_backup_node.y;
			_doki_mother = doki_backup_node.id;
		}
		with (instance_create_depth(_doki_x, _doki_y, 5, obj_dokiheart))
		{
			visible = 0;
			mother = _doki_mother;
			act_to_change = other.act_to_change;
			image_alpha = 0;
			maxlifetime = -1;
		}
	}
}
if (speed > 0)
{
	var _steer = 10 / global.fps_scale;
	if (point_distance(x, y, dest_x, dest_y) >= (speed * 6))
	{
		var _dest_dir = point_direction(x, y, dest_x, dest_y);
		if (_dest_dir > (direction + 180))
		{
			_dest_dir -= 360;
		}
		else if (_dest_dir < (direction - 180))
		{
			_dest_dir += 360;
		}
		if (direction > _dest_dir)
		{
			direction -= _steer;
		}
		else if (direction < _dest_dir)
		{
			direction += _steer;
		}
	}
	else
	{
		direction += (choose(-1, 1) * _steer);
	}
}
");

Apply("gml_Object_obj_pinknodeact_Step_0", @"dialogueboxcolorcurrent = dialogueboxcolorstart;
choiceselectioncolorcurrent = choiceselectioncolorstart;
if (whiteflash > 0)
{
	whiteflash = max(0, whiteflash - (0.25 / global.fps_scale));
}
switch (pattern)
{
	case 1:
		var _node_dist = 54;
		if (timer < 0)
		{
			x = dest_x;
			y = dest_y + lengthdir_y(_node_dist + 8, pattern_dir);
		}
		pattern_dir += (4 / global.fps_scale);
		if (pattern_dir >= 360)
		{
			pattern_dir -= 360;
		}
		break;
	case 2:
		if (timer < 0)
		{
			if (pattern_dir > 90 && pattern_dir < 270)
			{
				x = camerax() + 640 + 64;
			}
			else
			{
				x = camerax() - 64;
			}
			x += lengthdir_x(288, pattern_dir);
			y = dest_y;
		}
		pattern_dir += (1.5 / global.fps_scale);
		if (pattern_dir >= 360)
		{
			pattern_dir -= 360;
		}
		break;
	case 3:
		if (timer < 0 && instance_exists(node_id))
		{
			var _hits = 0;
			with (obj_purplecontrols)
			{
				_hits = hits;
			}
			var _travel_speed = min(4 + (life_time / 2), clamp(15 - ((_hits - 1) * 0.75), 12, 15)) / global.fps_scale;
			var _move_amount = min(_travel_speed, max(1, point_distance(x, y, node_id.dest_x, node_id.dest_y)));
			var _dir = point_direction(x, y, node_id.dest_x, node_id.dest_y);
			x += lengthdir_x(_move_amount, _dir);
			y += lengthdir_y(_move_amount, _dir);
			var _overtravel = _travel_speed - heart_travel;
			heart_travel -= _move_amount;
			if (heart_travel <= 0)
			{
				heart_travel = 0;
				var i = 0;
				var _found_it = false;
				with (node_id)
				{
					repeat (4)
					{
						if (instance_exists(child[i]) && draw_connection[i] == true)
						{
							_found_it = true;
							other.node_id = child[i];
							break;
						}
						i++;
						if (i >= 4)
						{
							i -= 4;
						}
					}
				}
				if (_found_it)
				{
					if (instance_exists(node_id))
					{
						heart_travel = point_distance(x, y, node_id.dest_x, node_id.dest_y);
						if (_overtravel > 0)
						{
							_move_amount = min(_overtravel, max(1, point_distance(x, y, node_id.dest_x, node_id.dest_y)));
							_dir = point_direction(x, y, node_id.dest_x, node_id.dest_y);
							x += lengthdir_x(_move_amount, _dir);
							y += lengthdir_y(_move_amount, _dir);
							heart_travel -= _move_amount;
						}
					}
				}
				else
				{
					instance_destroy();
				}
			}
		}
		break;
}
if (timer >= 0)
{
	timer += (1 / global.fps_scale);
	var _questiondowntime = 10;
	var _nextpatterntime = 50;
	if (timer >= 3 && timer < _nextpatterntime)
	{
		with (obj_heart)
		{
			other.x = lerp(other.x, x + 9, scr_fps_lerp_rate(0.5));
			other.y = lerp(other.y, y + 9, scr_fps_lerp_rate(0.5));
		}
	}
	if (mode == 1)
	{
		timer += (1 / global.fps_scale);
		var c_lime2 = merge_color(darkpink, c_white, 0.5);
		if (timer < 4)
		{
			dialogueboxcolor = merge_color(dialogueboxcolorcurrent, c_lime2, timer / 4);
			choiceselectioncolor = merge_color(choiceselectioncolorcurrent, darkpink, timer / 4);
		}
		if (timer >= 4 && timer < 8)
		{
			dialogueboxcolor = merge_color(c_lime2, dialogueboxcolorcurrent, (timer - 3) / 4);
			choiceselectioncolor = merge_color(darkpink, choiceselectioncolorcurrent, (timer - 3) / 4);
		}
		if (timer >= _nextpatterntime)
		{
			with (obj_pinknode)
			{
				instance_destroy();
			}
			with (obj_dokiheart)
			{
				instance_destroy();
			}
			with (obj_dbulletcontroller)
			{
				difficulty++;
			}
			with (obj_purplecontrols)
			{
				hits = 0;
				difficulty++;
				can_move = true;
				made = 0;
			}
			instance_destroy();
		}
	}
	else if (mode == 0)
	{
		timer += (1 / global.fps_scale);
		if (timer == 1)
		{
			show_circle1 = 2;
			if (obj_pink_enemy.datecount > 1)
			{
				show_circle2 = 2;
			}
			hero_state = ""choose"";
		}
		if (timer < 4)
		{
			dialogueboxcolor = merge_color(dialogueboxcolorcurrent, c_red, timer / 4);
			choiceselectioncolor = merge_color(choiceselectioncolorcurrent, c_red, timer / 4);
		}
		if (timer >= 4 && timer < 7)
		{
			dialogueboxcolor = merge_color(c_red, dialogueboxcolorcurrent, (timer - 3) / 4);
			choiceselectioncolor = merge_color(c_red, choiceselectioncolorcurrent, (timer - 3) / 4);
		}
		if (timer == (10 + _questiondowntime))
		{
			if (instance_exists(obj_date_controller))
			{
				with (obj_date_controller)
				{
					event_user(0);
				}
			}
			else
			{
				scr_shakescreen();
				snd_stop(snd_hurt1);
				snd_play(snd_hurt1);
				global.inv = global.invc * 40;
			}
			var _checkpoint_node = -4;
			with (obj_pinknode)
			{
				if (checkpoint == 2)
				{
					_checkpoint_node = id;
					break;
				}
			}
			if (_checkpoint_node != -4)
			{
				timer = -1;
				var _checkpoint_is_free = true;
				with (obj_pinknodeact)
				{
					if (_checkpoint_node.darkify == 0)
					{
						if (pattern == 3)
						{
							instance_destroy();
						}
					}
					active = 1;
					if (mode == 1)
					{
						if (mother == _checkpoint_node)
						{
							_checkpoint_is_free = false;
						}
					}
				}
				with (obj_purplecontrols)
				{
					hits++;
					if (_checkpoint_is_free)
					{
						node_id = _checkpoint_node;
					}
					can_move = true;
				}
				if (_checkpoint_is_free)
				{
					with (obj_heart)
					{
						var _dir = point_direction(x + 9, y + 9, _checkpoint_node.x, _checkpoint_node.y);
						var _dist = point_distance(x + 9, y + 9, _checkpoint_node.x, _checkpoint_node.y);
						do
						{
							var _trail = instance_create_depth(_checkpoint_node.x - lengthdir_x(_dist, _dir) - 9, _checkpoint_node.y - lengthdir_y(_dist, _dir) - 9, 0, obj_pinktrail);
							_trail.direction = _dir;
							_trail.speed = 1 / global.fps_scale;
							_dist -= 22;
						}
						until (_dist <= 2);
						x = _checkpoint_node.x - 9;
						y = _checkpoint_node.y - 9;
					}
				}
				if (pattern == 3)
				{
					active = 0;
					instance_destroy();
				}
			}
			else
			{
				with (obj_pinknode)
				{
					instance_destroy();
				}
				with (obj_pinknodeact)
				{
					instance_destroy();
				}
				with (obj_dokiheart)
				{
					instance_destroy();
				}
				with (obj_purplecontrols)
				{
					hits++;
					can_move = true;
					made = 0;
				}
			}
		}
	}
}
if (active == 1)
{
	var _boxw = 48;
	var _boxh = 32;
	var _heart = collision_rectangle(x - (_boxw / 2), y - (_boxh / 2), x + (_boxw / 2), y + (_boxh / 2), obj_heart, 1, 1);
	if (_heart >= 0 && (global.inv < 0 || mode == 1))
	{
		with (obj_purplecontrols)
		{
			can_move = false;
		}
		switch (mode)
		{
			case 0:
				snd_stop(snd_coin);
				snd_stop(snd_error);
				snd_play(snd_error);
				whiteflash = 1;
				break;
			case 1:
				snd_stop(snd_coin);
				snd_stop(snd_error);
				snd_play(snd_coin);
				whiteflash = 1;
				with (obj_pinknodeact)
				{
					mother = -4;
					node_id = -4;
					pattern = 0;
					fading_away = 0;
				}
				with (obj_date_controller)
				{
					changecolorcon = 1;
				}
				break;
		}
		with (obj_pinknodeact)
		{
			active = 0;
		}
		timer = 0;
	}
}
life_time += (1 / global.fps_scale);
switch (mode)
{
	case 1:
		image_alpha = min(image_alpha + (0.5 / global.fps_scale), 1);
		break;
	default:
		image_alpha = min(image_alpha + (0.2 / global.fps_scale), 1);
}
if (fading_away >= 0)
{
	fading_away += (1 / global.fps_scale);
	if (fading_away < 4)
	{
		image_alpha = 1;
	}
	else
	{
		image_alpha = clamp((1 / (1 + ((fading_away - 4) * 0.1))) - ((fading_away - 4) * 0.01), 0, 1);
	}
	if (fading_away >= 40 && mode != 1)
	{
		instance_destroy();
	}
}
");

