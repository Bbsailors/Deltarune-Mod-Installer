			}
			if (global.monsterhp[myself] <= (global.monstermaxhp[myself] / 3))
			{
				global.battlemsg[0] = stringsetloc(""* Rudinn Ranger's luster begins to fade."", ""obj_rudinnranger_slash_Step_0_gml_87_0"");
			}
