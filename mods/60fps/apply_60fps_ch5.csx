Apply("gml_Object_obj_dw_church_sideclimb_glowclimb_Draw_0", @"if (view_current == 0)
{
	siner += (1 / global.fps_scale);
}
var ind = 1;
with (obj_dw_castle_church_climb)
{
	ind = clamp(timber / 250, 0, 1);
}
var colind = ease_out_quart(ind, 0, 1, 1);
var col = merge_color(c_red, #4E4E73, colind);
draw_set_blend_mode(bm_add);
for (var i = 0; i < (image_xscale / 2); i++)
{
	for (var j = 0; j < (image_yscale / 2); j++)
	{
		var amt = abs(sin((siner + (-j * 60)) / 40)) + 0.5;
		draw_sprite_ext(sprite_index, image_index, x + (i * 40) + (sin((siner + (i * 40)) / 5) * 2), y + (j * 40) + (cos((siner + (j * 40)) / 5) * 2), 2, 2, 0, col, image_alpha * amt * 0.125);
		draw_sprite_ext(sprite_index, image_index, (x + (i * 40)) - (cos((siner + (i * 40)) / 5) * 2), (y + (j * 40)) - (sin((siner + (j * 40)) / 5) * 2), 2, 2, 0, col, image_alpha * amt * 0.125);
		draw_sprite_ext(sprite_index, image_index, x + (i * 40), y + (j * 40), 2, 2, 0, col, image_alpha * amt);
	}
}
draw_set_blend_mode(bm_normal);
");

Apply("gml_Object_obj_dw_cliff_bonuscombat_Step_2", @"if (!init)
{
	init = 1;
	if (global.flag[1899] == 1)
	{
		with (obj_plat_asset)
		{
			if (sprite_index == spr_mazecheese)
			{
				sprite_index = spr_cheese_smallening;
				image_index = 2;
			}
		}
	}
}
if (global.pause_plat)
{
	exit;
}
timer += (1 / global.fps_scale);
if (!instance_exists(npc_struggler))
{
	with (obj_plat_hbx)
	{
		with (instance_place(x, y, obj_plat_asset))
		{
			if (sprite_index == spr_mazecheese)
			{
				sprite_index = spr_cheese_smallening;
				image_index = 2;
				snd_play(snd_splat, 0.8, 2);
				global.flag[1899] = 1;
			}
		}
	}
}
with (npc_struggler)
{
	if ((other.timer % 120) < 60)
	{
		if (marker.image_angle != 0)
		{
			marker.image_angle = scr_approach(other.image_angle, 0, 2);
			y = y_plat;
		}
		marker.depth = depth;
		marker.sprite_index = spr_npc_windstruggler_walk;
		marker.image_speed = 0.25 / global.fps_scale;
		y = scr_approach(y, y_plat, 2);
		marker.image_angle = scr_approach(marker.image_angle, 0, 2);
		if ((other.timer % 8) == 4)
		{
			scr_lerpvar(""x"", x, x + 8, 3);
		}
	}
	else
	{
		var tt = ((other.timer % 120) - 60) / 30;
		x = scr_approach(x, marker.xstart, tt);
		y = scr_approach(y, y_plat + 5, 0.5);
		marker.image_angle = scr_approach(marker.image_angle, 5, 0.5);
		marker.image_speed = 0.5 / global.fps_scale;
		marker.sprite_index = spr_npc_windstruggler_struggle;
	}
}
");

Apply("gml_Object_obj_dw_cliff_bunnyfarm_Create_0", @"con = 0;
timer = 0;
init = 0;
siner = 0;
roomphase = 0;
turnofflayers(""CUT"");
turnofflayers(""DEBUG"");
turnofflayers(""NPCs"");
scr_setup_wind(-1, 180);
var makeGrass = true;
layer_set_visible(""grassSpawner"", false);
if (makeGrass)
{
	var gs = findspriteinfo_all(6500, ""grassSpawner"");
	for (var i = 0; i < array_length(gs); i++)
	{
		for (var j = 0; j < (gs[i].image_xscale / 40); j++)
		{
			for (var k = 0; k < (gs[i].image_yscale / 40); k++)
			{
				with (instance_create(gs[i].x + (j * 40), gs[i].y + (k * 40), obj_dw_cliffs_tallgrass))
				{
					image_xscale = choose(-2, 2);
					if (image_xscale == -2)
					{
						x += 40;
					}
					image_yscale = 2;
					sprite_index = choose(spr_dw_cliffs_tallgrass_nolight, spr_dw_cliffs_tallgrass_nolight2);
				}
				with (instance_create(gs[i].x + (j * 40), gs[i].y + (k * 40) + 20, obj_dw_cliffs_tallgrass))
				{
					image_xscale = choose(-2, 2);
					if (image_xscale == -2)
					{
						x += 40;
					}
					image_yscale = 2;
					sprite_index = choose(spr_dw_cliffs_tallgrass_nolight, spr_dw_cliffs_tallgrass_nolight2);
				}
			}
		}
	}
}
farmer = scr_makenpc_fromasset(findsprite(spr_scarecrow_idle_farmer, ""NPCs""), true);
if (global.plot >= 390)
{
	with (farmer)
	{
		ears = scr_marker_fromasset(findsprite(spr_dw_cliff_bunnyfarm_farmerears), marker.depth - 1, undefined, 1);
		with (ears)
		{
			dad = other.marker;
			timer = 0;
			memind = 0;
			image_speed = 0;
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				image_index = timer / 60;
			};
			
			scr_addtoselfshadows(true);
		}
	}
}
with (farmer.marker)
{
	scr_addtoselfshadows(true);
}
farmer.marker.image_speed = 0.25 / global.fps_scale;
farmer.sawheadfriend = 0;
peachessign = scr_makenpc_fromasset(findsprite(spr_npc_sign, ""NPCs"", c_white));
netskiInit = 0;
netskiFlag = 1387;
netski = -4;

hideStuff = function()
{
	netski = scr_marker_fromasset(findsprite(spr_dw_cliff_bunnyfarm_netskipop, ""DEBUG_ASSETS""), 0, 1);
	with (netski)
	{
		timer = 0;
		netsk = -4;
		mysolid = instance_create(x, y, obj_solidblocksized);
		mysolid.x -= 2;
		mysolid.y -= 2;
		scr_sizeexact(32, 20, mysolid);
		image_speed = 0;
		con = 0;
		myint = instance_create(x, y, obj_trigger_interact);
	}
	layer_set_visible(""TILES_VINES_1"", false);
	var moveem = [""c"", ""e"", ""d""];
	with (obj_climbstartertrig)
	{
		if (exitmarkerflag == moveem[0] || exitmarkerflag == moveem[1] || exitmarkerflag == moveem[2])
		{
			x = room_width * 4;
		}
	}
};

showStuff = function(arg0 = false)
{
	var cam = scr_getcam();
	var moveem = [""c"", ""e"", ""d""];
	with (obj_climbstartertrig)
	{
		if (exitmarkerflag == moveem[0] || exitmarkerflag == moveem[1] || exitmarkerflag == moveem[2])
		{
			x = xstart;
		}
	}
	if (arg0)
	{
		var locs = findspriteinfo_all(6500, ""DEBUG_ASSETS"", 10420223, undefined);
		for (var i = 0; i < array_length(locs); i++)
		{
			for (var ii = 0; ii < (locs[i].sprite_height / 40); ii++)
			{
				var _x = locs[i].x + 20;
				var _y = locs[i].y + (40 * ii) + 20;
				if (point_in_rectangle(_x, _y, cam.x - 40, cam.y - 40, cam.x + cam.w + 40, cam.y + cam.h + 40))
				{
					smokepuff(_x, _y);
				}
			}
		}
		delay_function(function()
		{
			layer_set_visible(""TILES_VINES_1"", true);
		}, 4);
	}
	else
	{
		layer_set_visible(""TILES_VINES_1"", true);
	}
};

smokepuff = function(arg0, arg1)
{
	with (instance_create(arg0, arg1, obj_marker_fancy))
	{
		depth = 90000;
		scr_marker_ext(arg0, arg1, spr_smokepuff, 1, 1, 1, undefined, #EFF0C7, depth - 1, undefined, 6);
		angle = random_range(15, 35);
		smokes = [];
		count = choose(3, 4, 5);
		var _cnt = count;
		for (var i = 0; i < count; i++)
		{
			array_push(smokes, 
			{
				x: arg0,
				xstart: arg0,
				y: arg1,
				ystart: arg1,
				dir: ((i / _cnt) * 360) + random_range(-8, 8) + angle,
				spd: random_range(0.6, 2.2),
				angle: random(360),
				size: 2,
				startsize: random_range(2.4, 2.6)
			});
		}
		timer = 0;
		endtime = irandom_range(12, 20);
		
		step_func = function()
		{
			timer += (1 / global.fps_scale);
			for (var i = 0; i < count; i++)
			{
				with (smokes[i])
				{
					x = lerp(xstart, xstart + lengthdir_x(other.endtime * spd, dir), ease_out_cubic(clamp(other.timer / other.endtime, 0, 1), 0, 1, 1));
					y = lerp(ystart, ystart + lengthdir_y(other.endtime * spd, dir), ease_out_cubic(clamp(other.timer / other.endtime, 0, 1), 0, 1, 1));
					size = lerp(startsize, 0, ease_inout_cubic(clamp(other.timer / other.endtime, 0, 1), 0, 1, 1));
				}
			}
			if (timer >= endtime)
			{
				instance_destroy();
			}
		};
		
		draw_func = function()
		{
			for (var i = 0; i < count; i++)
			{
				with (smokes[i])
				{
					gpu_set_fog(true, #EFF0C7, 0, 0);
					draw_sprite_ext(spr_launchsmoke, 0, x, y, size, size, angle + ((other.timer * spd) / 4), #EFF0C7, 1);
					gpu_set_fog(false, c_white, 0, 0);
				}
			}
			for (var i = 0; i < count; i++)
			{
				with (smokes[i])
				{
					draw_sprite_ext(spr_launchsmoke, 0, x, y, size, size, angle + ((other.timer * spd) / 4), #EFF0C7, 0.5);
				}
			}
		};
	}
};
");

Apply("gml_Object_obj_dw_cliff_bunnyfarm_Step_0", @"scr_populatechars();
if (!init)
{
	init = 1;
}
if (!netskiInit)
{
	netskiInit = true;
	if (global.flag[netskiFlag] == 0)
	{
		hideStuff();
	}
	else
	{
		showStuff(false);
	}
}
event_user(1);
event_user(5);
with (netski)
{
	if (con == 0)
	{
		if (myint.myinteract == 3)
		{
			global.flag[other.netskiFlag] = 1;
			snd_play(snd_noise);
			snd_play_delay(snd_wing, 6, undefined, 1.2);
			con = 1;
			global.interact = 1;
			scr_animate_time(12);
			con = 1.5;
			with (mysolid)
			{
				instance_destroy();
			}
			with (myint)
			{
				instance_destroy();
			}
		}
	}
	if (con == 1.5)
	{
		if (image_index >= 4)
		{
			netsk = scr_marker_ext(x + 10 + 6, (y - 28) + 24, spr_bunnyfarm_netski, 1.5, 1.5, undefined, undefined, undefined, depth - 1);
			with (netsk)
			{
				depth = other.depth - 1;
				scr_lerpvar(""image_xscale"", image_xscale, 2, 2, 2, ""out"");
				scr_lerpvar(""image_yscale"", image_yscale, 2, 2, 2, ""out"");
				delay_function(function()
				{
					var targx = obj_mainchara.x + 6 + 14;
					var targy = (obj_mainchara.y - 14 - 26) + 28;
					var targdepth = obj_mainchara.depth - 1;
					scr_lerpvar(""x"", x, targx, 4, 1, ""in"");
					scr_lerpvar(""y"", y, targy, 4, 2, ""out"");
					scr_lerpvar(""depth"", depth, targdepth, 4, 2, ""out"");
				}, 1);
			}
			con = 1.6;
			scr_delay_var(""con"", 2, 5);
			scr_delay_var(""x"", room_width * 8, 2);
		}
	}
	if (con == 2)
	{
		timer += (1 / global.fps_scale);
		if (timer == 1)
		{
			snd_play(snd_item);
		}
		if (timer >= 15 || button3_h())
		{
			with (other)
			{
				showStuff(true);
			}
			snd_stop(snd_wing);
			snd_play(snd_wing);
			con = 3;
			with (scr_marker_ext(netsk.x - 80, netsk.y - 124, spr_poof, 2, 2, undefined, undefined, undefined, netsk.depth - 1))
			{
				image_speed = 0.5 / global.fps_scale;
				scr_doom(id, 16);
			}
			scr_doom(netsk, 4);
			global.interact = 0;
			global.facing = 0;
			instance_destroy();
		}
	}
}
");

Apply("gml_Object_obj_dw_cliff_bunnyfarm_bunny_Step_0", @"if (!init)
{
	init = true;
	if (global.plot < 390)
	{
		if (scr_trigcheck_ext(""notbunny"", id))
		{
			with (scr_marker_ext(x, y, spr_dw_cliff_bunnyfarm_bunnyharvest, 2, 2, undefined, undefined))
			{
				depth = 100000 - ((y * 10) + 540);
				if ((instance_number(object_index) % 3) == 0)
				{
					x += 26;
					image_xscale = -2;
				}
			}
			instance_destroy();
			exit;
		}
	}
}
if (con == 0)
{
	var cantgo = false;
	with (object_index)
	{
		if (held || buffer)
		{
			cantgo = true;
		}
	}
	if (!cantgo && myint.myinteract >= 3)
	{
		snd_play(snd_noise);
		snd_play_delay(snd_wing, 6, undefined, 1.2);
		con = 1;
		global.interact = 1;
		scr_animate_time(12);
		con = 1.5;
		depth = obj_mainchara.depth - 1;
	}
	if (cantgo)
	{
		myint.myinteract = 0;
	}
}
if (con == 1.5)
{
	if (image_index >= 4)
	{
		var targx = obj_mainchara.x + 6;
		var targy = obj_mainchara.y - 14 - 26;
		scr_lerpvar(""x"", x, targx, 4, 1, ""in"");
		scr_lerpvar(""y"", y, targy, 4, 2, ""out"");
		con = 1.6;
		scr_delay_var(""con"", 2, 4);
	}
}
if (con == 2)
{
	snd_play(snd_item);
	with (myint)
	{
		instance_destroy();
	}
	global.interact = 0;
	held = true;
	con = 3;
	timer = 0;
}
if (con == 4)
{
	buffer -= (1 / global.fps_scale);
	if (y > (cameray() + 480 + 10))
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_dw_cliff_bunnyfarm_bunny_Step_2", @"if (held)
{
	sprite_index = spr_dw_cliff_bunnyfarm_bunnyidle;
	image_index += (0.16666666666666666 / global.fps_scale);
	x = obj_mainchara.x + 6;
	var off = 0;
	if (obj_mainchara.image_index == 1 || obj_mainchara.image_index == 3)
	{
		off = 2;
	}
	y = (obj_mainchara.y - 18) + off;
	depth = obj_mainchara.depth - 1;
	var climbtrigged = false;
	with (obj_climbstarter)
	{
		if (con != 0)
		{
			climbtrigged = true;
		}
	}
	if ((button1_p() && global.interact == 0) || climbtrigged)
	{
		var canthrow = true;
		with (obj_dw_cliff_bunnyfarm)
		{
			with (farmer)
			{
				if (myinteract != 0)
				{
					canthrow = false;
				}
			}
			with (peachessign)
			{
				if (myinteract != 0)
				{
					canthrow = false;
				}
			}
		}
		if (canthrow)
		{
			with (scr_marker_centered_frominstance(id))
			{
				snd_play(snd_wing, undefined, 1.2);
				var snd = snd_play(snd_fall, 0.7, 0.8);
				snd_volume(snd, 0, 12);
				vspeed = -4 / global.fps_scale;
				if (global.facing == 1)
				{
					hspeed = (4 + (right_h() * 4)) / global.fps_scale;
				}
				if (global.facing == 3)
				{
					hspeed = (-4 - (left_h() * 4)) / global.fps_scale;
				}
				if (global.facing == 0)
				{
					vspeed = -6 / global.fps_scale;
				}
				image_speed = 0.25 / global.fps_scale;
				gravity = 1 / (global.fps_scale * global.fps_scale);
				depth = 5000;
				amdoom = false;
				upwards = false;
				if (global.facing == 2)
				{
					upwards = true;
					image_alpha = 2;
					scr_depth();
					ymax = obj_mainchara.bbox_bottom - 20;
				}
				
				step_func = function()
				{
					if (upwards)
					{
						if (y > (ymax - 4))
						{
							if (!amdoom)
							{
								amdoom = true;
								y = ymax;
								hspeed = 0;
								vspeed = 0;
								gravity = 0;
								snd_play(snd_wing);
								scr_lerpvar(""image_alpha"", image_alpha, 0, 15);
								scr_doom(id, 15);
							}
						}
					}
					image_angle -= ((abs(vspeed) + abs(hspeed)) * sign(hspeed) * 2);
					if (y > (cameray() + 480 + 60))
					{
						instance_destroy();
					}
				};
			}
			scr_doom(id, 2);
			x = room_width * 4;
			held = false;
			con = 4;
			buffer = 4;
		}
	}
}
");

Apply("gml_Object_obj_dw_cliff_climbrefresher_Step_2", @"if (instance_exists(obj_climb_kris))
{
	if (i_ex(monologue_writer))
	{
		scr_speaker(susie_monologue[last_monologue][1]);
		monologue_writer.originalcharline = 16;
		monologue_writer.charline = 16;
		monologue_writer.writingx = camerax() + 40;
		monologue_writer.writingy = cameray() + 200;
	}
}
else if (i_ex(monologue_writer))
{
	monologue_writer.writingx = camerax() + 40;
	if (global.interact == 0 && !obj_mainchara.cutscene)
	{
		scr_speaker(susie_monologue[last_monologue][1]);
		monologue_writer.originalcharline = 16;
		monologue_writer.charline = 16;
		monologue_writer.writingy = min(room_height - 280, obj_mainchara.y - 2);
	}
	else if (!obj_mainchara.cutscene)
	{
		monologue_writer.writingy = cameray() + 200;
	}
	else
	{
	}
}
if (monocon == 0)
{
	if (i_ex(monologue_writer))
	{
		monocon = 1;
		monotime = 0;
	}
}
if (monocon == 1)
{
	if (i_ex(monologue_writer))
	{
		if (monologue_writer.halt > 0)
		{
			monotime += (1 / global.fps_scale);
			var max_timer = (global.lang == ""ja"") ? 100 : 70;
			if (!i_ex(obj_climb_kris) && global.interact > 0)
			{
				monotime -= (1 / global.fps_scale);
			}
			if (monotime >= max_timer)
			{
				with (obj_writer)
				{
					forcebutton1 = 1;
				}
				monotime = 0;
				monocon = 0;
				monologue_writer.halt = 0;
				monodelaytimer = susie_monologue[last_monologue][2];
			}
		}
	}
}
if (waiting_next_monologue && !instance_exists(monologue_writer) && monodelaytimer <= 0)
{
	monodelaytimer = susie_monologue[last_monologue][2];
	monocon = 0;
}
if ((!i_ex(obj_climb_kris) && global.interact > 0) || scr_trigcheck(""dont_advance_monologue""))
{
	exit;
}
with (obj_cliff_crater)
{
	if (con > 0)
	{
		exit;
	}
}
if (monodelaytimer > 0 && !instance_exists(monologue_writer))
{
	monodelaytimer -= (1 / global.fps_scale);
	if (monodelaytimer == 0)
	{
		monologuecon = last_monologue + 1;
		event_user(10);
	}
}
");

Apply("gml_Object_obj_dw_cliff_cutdown_tutorial_Step_0", @"if (!init)
