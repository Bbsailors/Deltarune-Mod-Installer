kk = scr_makenpc_fromasset(findsprite(spr_dw_npc_k_k_box_left, ""NPCs""), true);
with (sweet.marker)
{
	con = 0;
	timer = 0;
	
	dance = function()
	{
		timer = 0;
		con = 1;
	};
	
	step_func = function()
	{
		if (con == 1)
		{
			timer += (1 / global.fps_scale);
			if (frac(timer) == 0)
			{
				image_index += (((1 - (timer / 15)) * 1) / 2);
			}
			if (timer >= 15)
			{
				con = 0;
				timer = 0;
				image_index = 0;
			}
		}
	};
}
with (kk.marker)
{
	con = 0;
