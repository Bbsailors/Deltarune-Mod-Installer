function loadtext(arg0)
{
	if (watered)
	{
		if (watertalk == 0)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* Wow^1, I can't believe I was watered by Master Flowery's kiss.../"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1466_0"");
			if (global.flag[1311] == 1)
			{
				scr_anyface_next(""ralsei"", ""9"");
				msgnextloc(""\\E9* That's not what that was.../%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1469_0"");
			}
			else
			{
				scr_anyface_next(""ralsei"", ""X"");
				msgnextloc(""\\EX* That's not what that was.../%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1472_0"");
			}
		}
		else
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* This moisture..^1. it must be from my tears.../"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1478_0"");
			msgnextloc(""* After getting a great Kiss from Master Flowery.../"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1479_0"");
			if (global.flag[1311] == 1)
			{
				scr_anyface_next(""ralsei"", ""H"");
				msgnextloc(""\\EH* Is anyone listening?/%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1482_0"");
			}
			else
			{
				scr_anyface_next(""ralsei"", ""U"");
				msgnextloc(""\\EU* Is anyone listening?/%"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1485_0"");
			}
		}
	}
	else if (arg0 == 0)
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* A k-kiss from Master Flowery..^1. I'm so happy I can't believe it.../"", ""obj_dw_garden_enemyrush_slash_Step_0_gml_1492_0"");
		if (global.flag[1311] == 1)
		{
			scr_anyface_next(""ralsei"", ""G"");
