		scr_speaker(""seth"");
		msgsetsubloc(0, ""~1* My other wallet!!!!"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_knifewall_generator_slash_Step_0_gml_165_0"");
		d_make_plat(0, 5, undefined, undefined, 1);
