extra = 0;
if (i_ex(obj_gigaheart))
{
	extra = 1.6;
}
extra2 = 0;
image_alpha = 1;
image_xscale = 2;
image_yscale = 2;
image_index = 0;
image_blend = make_color_rgb(255, 138, 144);
direction = 180;
speed = 1 / global.fps_scale;
