		msgnextloc(""* Give me anything^1, and I'll show you my GREAT STRENGTH./"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_153_0"");
		var opt1 = stringsetloc(""#Give $50"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_154_0"");
		var opt2 = stringsetloc(""#Massage"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_155_0"");
		var opt3 = stringsetloc(""Nothing"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_156_0"");
