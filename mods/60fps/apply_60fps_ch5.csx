Apply("gml_Object_obj_screen_loading_Create_0", @"_target_chapter = -1;
_init = false;
_callback = -4;
_initialize_text = """";
_y_offset = -16;
_font = 5;

show_loading_screen = function(arg0, arg1)
{
	_target_chapter = arg0;
	_callback = arg1;
	_initialize_text = get_text(_target_chapter);
	_font = get_font();
	_init = true;
	alarm[0] = round(1 * global.fps_scale);
};

get_text = function(arg0)
{
	var _text = ""INITIALIZING\nCHAPTER "" + string(arg0);
	if (global.lang == ""ja"")
	{
		_text = ""CHAPTER "" + string(arg0) + ""ã‚’\nã¯ã˜ã‚ã¾ã™"";
	}
	if (arg0 == 0)
	{
		_text = ""LOADING\nCHAPTER\nSELECT"";
		if (global.lang == ""ja"")
		{
			_text = ""ãƒãƒ£ãƒ—ã‚¿ãƒ¼\né¸æŠžç”»é¢\nã‚ˆã¿ã“ã¿ä¸­"";
		}
	}
	return _text;
};

get_font = function()
{
	if (room == room_chapter_continue)
	{
		return (global.lang == ""en"") ? 5 : 11;
	}
	else
	{
		return (global.lang == ""en"") ? 6 : 14;
	}
};
");

Apply("gml_Object_obj_screen_zoom_Draw_0", @"if (!surface_exists(app_surf))
{
	app_surf = surface_create(surface_get_width(application_surface), surface_get_height(application_surface));
}
surface_copy(app_surf, 0, 0, application_surface);
var cx = camerax();
var cy = cameray();
var cw = camerawidth();
var ch = cameraheight();
draw_sprite_ext(spr_pxwhite, 0, cx, cy, cw, ch, 0, c_black, 1);
var __sc_r = 640 / surface_get_width(app_surf);
if (track_camera)
{
	x = (cx + (0.5 * cw)) - (0.5 * surface_get_width(app_surf) * image_xscale * __sc_r);
	y = (cy + (0.5 * ch)) - (0.5 * surface_get_height(app_surf) * image_yscale * __sc_r);
}
draw_surface_ext(app_surf, x, y, image_xscale * __sc_r, image_yscale * __sc_r, image_angle, image_blend, image_alpha);
");

