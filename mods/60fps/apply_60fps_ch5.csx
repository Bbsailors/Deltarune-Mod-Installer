	}
	if (global.flag[20] == 2)
	{
		sprite_index = spr_npc_puzzlepiece_shock2;
		image_speed = 0.334 / global.fps_scale;
	}
	if (i_ex(mydialoguer) == false)
	{
		if (!instance_exists(obj_fusionmenu))
		{
			global.interact = 0;
			with (obj_mainchara)
			{
				onebuffer = 5;
			}
		}
		myinteract = 0;
	}
}
if (con == 10)
{
	con = 11;
	alarm[4] = round(40 * global.fps_scale);
}
if (con == 12 && global.fighting == 0)
{
	con = 13;
	alarm[4] = round(15 * global.fps_scale);
}
if (con == 14)
{
	scr_speaker(""noone"");
	if (global.flag[36] == 0)
	{
		if (global.flag[dojoFlag] == 0)
		{
			if (dojoFlag == 816)
			{
				global.flag[dojoFlag] = 1;
				with (obj_npc_castle_bakery)
				{
					if (_nubert_npc != -4)
					{
						_nubert_npc.sprite_index = spr_npc_nubert;
						_nubert_npc.y += 26;
						scr_depth();
					}
				}
				scr_speaker(""no_name"");
				msgsetloc(0, ""* You^1, uh..^1. won.../"", ""obj_npc_dojo_slash_Step_0_gml_69_0"");
				msgnextloc(""* .../"", ""obj_npc_dojo_slash_Step_0_gml_70_0"");
				msgnextloc(""* Hope you had fun^1, boss./%"", ""obj_npc_dojo_slash_Step_0_gml_71_0"");
			}
		}
	}
	else
	{
		msgsetloc(0, ""* You beefed it! Better luck next time^1, boss!/%"", ""obj_npc_dojo_slash_Step_0_gml_61_0"");
	}
	d_make();
	con = 15;
}
