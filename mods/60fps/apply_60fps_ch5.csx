		c_msgnextsubloc(""~1* An anythin' that hurts ol' BLUE..^1.~2THAT's the ultimate crime./"", (global.lang == ""ja"") ? ""\\m4\t\t\t"" : ""\\m4\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_ch5_DWCL01_slash_Step_0_gml_209_0"");
