Apply("gml_Object_obj_dw_garden_secretfox_Create_0", @"event_inherited();
can_interact = false;
con = 0;
timer = 0;
bromide_muted = false;
__silhouette = 5463;
anchor_x = xstart;
anchor_y = ystart;
offsetx = 0;
offsety = 0;
showtail = false;
canshowtail = true;
yoffset = -10;
fromsun = false;
eatspeed = 1;
image_xscale = 2;
image_yscale = 2;
image_speed = 0.25 / global.fps_scale;
watering_cans = false;
pickup_cooldown = 0;
startx = 0;
starty = 0;
target_object = -4;
fromtile = -4;
tile_layer = -4;
fromasset = -4;

assign_target = function(arg0)
{
	target_object = arg0;
	offsetx = 0.5 * (target_object.bbox_right - target_object.bbox_left);
	offsety = 0.5 * (target_object.bbox_bottom - target_object.bbox_top);
	anchor_x = xstart + offsetx;
	anchor_y = ystart + offsety;
};

x_lerp = -4;
y_lerp = -4;
had_manual_check = -1;

on_press = function()
{
	if (!held)
	{
		exit;
	}
	if (pickup_cooldown > 0)
	{
		exit;
	}
	scr_debug_print(string(global.facing));
	if (global.facing == 3 && scr_trigcheck(""no_throw_left""))
	{
		exit;
	}
	if (global.facing == 1 && scr_trigcheck(""no_throw_right""))
	{
		exit;
	}
	if (global.facing == 2 && scr_trigcheck(""no_throw_up""))
	{
		exit;
	}
	if (global.facing == 0 && scr_trigcheck(""no_throw_down""))
	{
		exit;
	}
	pickup_cooldown = 2;
	event_user(1);
	if (global.facing == 1)
	{
		anchor_x = obj_mainchara.bbox_right + 32;
		anchor_y = obj_mainchara.bbox_bottom - 20;
	}
	if (global.facing == 0)
	{
		anchor_x = obj_mainchara.x + (0.5 * obj_mainchara.sprite_width);
		anchor_y = obj_mainchara.bbox_bottom;
	}
	if (global.facing == 3)
	{
		anchor_x = obj_mainchara.bbox_left - 32;
		anchor_y = obj_mainchara.bbox_bottom - 20;
	}
	if (global.facing == 2)
	{
		anchor_x = obj_mainchara.x + (0.5 * obj_mainchara.sprite_width);
		anchor_y = obj_mainchara.bbox_bottom - 60;
	}
	scr_jump_to_point(anchor_x, anchor_y, 12, 6);
	con = 100;
	timer = 2;
};

shroom = -4;

appear = function(arg0)
{
	if (con != 0)
	{
		exit;
	}
	var nearest_shroom = -4;
	var nearest_dist = mushroom_detection_range;
	var target = 713;
	if (watering_cans)
	{
		target = 358;
	}
	if (x < -200)
	{
		x += 10000;
	}
	with (target)
	{
		if (!targeted || other.manual_check)
		{
			var dist = point_distance(x, y, other.x, other.y);
			if (dist < nearest_dist)
			{
				nearest_shroom = id;
				nearest_dist = dist;
			}
		}
	}
	if (x >= -200)
	{
		x -= 10000;
	}
	if (nearest_shroom)
	{
		con = 1;
		timer = 0;
		if (arg0)
		{
			timer = 15;
		}
		anchor_x = xstart + offsetx;
		anchor_y = ystart + offsety;
		if (nearest_shroom.targeted)
		{
			with (nearest_shroom.targeted)
			{
				find_new_shroom();
			}
		}
		nearest_shroom.targeted = self;
		shroom = nearest_shroom;
	}
	else if (anchor_x != (xstart + offsetx) || anchor_y != (ystart + offsety))
	{
		anchor_x = xstart + offsetx;
		anchor_y = ystart + offsety;
		con = 1;
		timer = 0;
		if (arg0)
		{
			timer = 15;
		}
	}
	else if (arg0)
	{
		con = 1;
		timer = 15;
	}
};

find_new_shroom = function()
{
	var nearest_shroom = -4;
	var nearest_dist = mushroom_detection_range;
	var target = 713;
	if (watering_cans)
	{
		target = 1010;
	}
	with (target)
	{
		if (!targeted)
		{
			var dist = point_distance(x, y, other.x, other.y);
			if (dist < nearest_dist)
			{
				nearest_shroom = self;
				nearest_dist = dist;
			}
		}
	}
	if (nearest_shroom)
	{
		if (con >= 2 && con <= 4)
		{
			con = 2;
			timer = 0;
		}
		anchor_x = xstart + offsetx;
		anchor_y = ystart + offsety;
		nearest_shroom.targeted = id;
		shroom = nearest_shroom;
	}
	else
	{
		anchor_x = xstart + offsetx;
		anchor_y = ystart + offsety;
		if (con >= 2 && con <= 4)
		{
			con = 100;
			timer = 0;
		}
	}
};

poofframe = -1;
lastx = x;
lasty = y;
fromsun_sound = -4;
fromsun_visible = 0;
parallax_anchor = camerax();
parallaxer = 1;

get_real_x = function()
{
	return x + ((camerax() - parallax_anchor) * parallaxer);
};

get_real_y = function()
{
	return y + (cameray() * parallaxer);
};
");

Apply("gml_Object_obj_dw_garden_secretfox_Step_0", @"if (instance_exists(obj_dw_bromide) || instance_exists(obj_battlecontroller))
{
	bromide_muted = true;
}
else if (bromide_muted)
{
	bromide_muted = false;
}
pickup_cooldown -= (1 / global.fps_scale);
if (held)
{
	if (had_manual_check == -1)
	{
		had_manual_check = manual_check;
		manual_check = false;
	}
	sprite_index = spr_dw_garden_fox_held;
	image_speed = 0;
	if (global.facing == 1)
	{
		image_xscale = 2;
	}
	else if (global.facing == 3)
	{
		image_xscale = -2;
	}
	if (x != lastx || y != lasty)
	{
		image_speed = lerp(0.15, 0.3, clamp01((abs(point_distance(lastx, lasty, x, y)) * global.fps_scale) / 8)) / global.fps_scale;
	}
	lastx = x;
	lasty = y;
	with (obj_dw_garden_shroomstack)
	{
		if (array_length(stack) > 0)
		{
			stack = [];
		}
	}
	if (instance_exists(shroom))
	{
		shroom.targeted = false;
	}
	shroom = -4;
	exit;
}
timer += (1 / global.fps_scale);
if (fromsun)
{
	visible = true;
	if (con == 0)
	{
		if (timer == 16)
		{
			sprite_index = spr_dw_garden_fox_idle;
			image_speed = 0.25 / global.fps_scale;
			poofframe = 0;
			scr_lerpvar(""poofframe"", 0, 7, 10);
			snd_stop(snd_wing);
			if (x < -200)
			{
				x += 10000;
			}
			if (!bromide_muted)
			{
				snd_play(snd_wing, 0.7);
			}
		}
		if (poofframe == 7)
		{
			poofframe = -1;
		}
		if (timer == 20)
		{
			x += offsetx;
			y += offsety;
			anchor_x = x;
			anchor_y = y;
			fromsun_sound = snd_loop(snd_cartoon_pitterpatter);
			snd_volume(fromsun_sound, 0, 0);
		}
		if (timer == 22)
		{
			image_xscale = 0.1;
			image_yscale = 0.1;
			sprite_index = spr_dw_garden_fox_run;
			image_speed = 0.5 / global.fps_scale;
			image_blend = c_black;
		}
		if (timer >= 22)
		{
			var t = clamp01((timer - 22) / 150);
			var inlerp = ease_in_quad(t, 0, 1, 1);
			image_xscale = lerp(0.1, 2, inlerp);
			var targ = -4;
			with (obj_held_mushroom)
			{
				if (has_summoned_the_sun)
				{
					targ = self;
				}
			}
			if (x > targ.x)
			{
				image_xscale *= -1;
			}
			image_yscale = lerp(0.1, 2, inlerp);
			image_blend = merge_color(c_lime, c_white, inlerp);
			parallaxer = 1 - inlerp;
			vspeed = (1 * inlerp) / global.fps_scale;
			hspeed = (((targ.x - x) / 10) * inlerp) / global.fps_scale;
			snd_volume(fromsun_sound, t * (1 - bromide_muted), 1);
			if (parallaxer == 0)
			{
				con = 1;
				timer = 0;
				snd_stop(fromsun_sound);
				if (!bromide_muted)
				{
					snd_play(snd_jump);
				}
				sprite_index = spr_dw_garden_fox_held;
			}
			if (targ.frozen)
			{
				con = 3;
				timer = 0;
				exit;
			}
		}
		depth = 20000;
		fromsun_visible = con != 0 || timer >= 22;
	}
	else if (con == 1)
	{
		var targ = -4;
		with (obj_held_mushroom)
		{
			if (has_summoned_the_sun)
			{
				targ = self;
			}
		}
		if (timer == 1)
		{
			if (x > targ.x)
			{
				image_xscale = -2;
			}
		}
		if (timer == 1)
		{
			startx = x;
			starty = y;
		}
		x = lerp(startx, targ.x, timer / 30);
		y = lerp(starty, targ.y, timer / 30) + (sin(degtorad(timer * 6)) * -80);
		if (timer >= 15)
		{
		}
		if (timer == 30)
		{
			with (targ)
			{
				if (object_index == obj_held_mushroom && frozen)
				{
					break;
				}
				con = 1;
				timer = 0;
			}
			visible = 0;
			hspeed = 0;
			vspeed = 0;
			fromsun_visible = 0;
			con = 2;
			timer = 0;
		}
	}
	if (con == 3)
	{
		fromsun_visible = true;
		if (timer == 1)
		{
			fromsun_sound = snd_loop(snd_cartoon_rettaprettip);
			snd_volume(fromsun_sound, 1 - bromide_muted, 0);
			sprite_index = spr_dw_garden_fox_run;
			image_speed = 1 / global.fps_scale;
			startx = x;
			starty = y;
		}
		var inlerp = ease_out_quad(timer / 30, 0, 1, 1);
		parallaxer = inlerp;
		image_xscale = lerp(2, 0.1, inlerp);
		image_yscale = lerp(2, 0.1, inlerp);
		image_blend = merge_color(c_white, c_lime, inlerp);
		x = lerp(startx, xstart, inlerp);
		y = lerp(starty, ystart, inlerp);
		snd_volume(fromsun_sound, (1 - (parallaxer * 0.5)) * (1 - bromide_muted), 1);
		if (timer == 30)
		{
			con = 4;
			timer = 0;
			poofframe = 0;
			fromsun_visible = 0;
			snd_stop(fromsun_sound);
			scr_lerpvar(""poofframe"", 0, 7, 10);
			if (!bromide_muted)
			{
				snd_stop(snd_wing);
				snd_play(snd_wing, 0.7);
			}
			scr_doom(self, 10);
			with (obj_parallax_cliffs)
			{
				sun_visible = true;
				suny = music_sun_y_min;
			}
		}
	}
	if (fromsun_visible)
	{
		with (obj_parallax_cliffs)
		{
			sun_visible = false;
		}
	}
	exit;
}
if (con == 0)
{
	sprite_index = spr_dw_garden_fox_idle;
