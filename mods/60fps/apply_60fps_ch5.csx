			{
				cutscene = 1;
			}
			with (obj_trigger)
			{
				instance_destroy();
			}
			exit;
		}
	}
	if (zorgon_controller.is_paused())
	{
		if (!d_ex())
		{
			zorgon_controller.resume();
		}
	}
}
if (zorgon_exit_active)
{
	var triggered = false;
	var flag = """";
	with (obj_trigger)
	{
		if (place_meeting(x, y, obj_mainchara))
		{
			triggered = true;
			flag = extflag;
		}
	}
	if (triggered && global.interact == 0)
	{
