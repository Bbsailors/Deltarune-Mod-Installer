			dashsign = 1;
			static_dash = true;
			static_dash_fake_speed = other.dashspeed / global.fps_scale;
			other.playerinit = true;
		}
	}
	if (!global.pause_plat)
	{
		with (obj_plat_floortex_FLOOR)
		{
			x -= (other.dashspeed / global.fps_scale);
			front_x -= (other.dashspeed / global.fps_scale);
			if (x <= -80)
			{
				x += 80;
				front_x += 80;
			}
		}
	}
}
flower_angle += (flower_accel / global.fps_scale);
if (floweryanim)
{
	fl_actor.image_index = (flower_angle * 0.1) % 2;
}
var manager = id;
with (fl_actor)
{
	for (var i = 0; i < array_length(other.flower_instances); i++)
	{
		var xx = x + 26;
		var yy = y + 40;
		with (other.flower_instances[i])
		{
			var xoffset = (sprite_get_xoffset(sprite_index) * 2) - (0.5 * sprite_width);
			var yoffset = (sprite_get_yoffset(sprite_index) * 2) - (0.5 * sprite_height);
			x = xx + lengthdir_x(manager.flower_radius, manager.flower_angle + (index * 60)) + xoffset;
			y = yy + lengthdir_y(manager.flower_radius * 0.7, manager.flower_angle + (index * 60)) + yoffset;
			y += (sin(sinertimer * 0.2) * 4);
			sinertimer += (1 / global.fps_scale);
			depth = depthanchor - (mean(bbox_top, bbox_bottom) - (yy + 30));
			if ((sinertimer % 3) == (i % 3))
			{
				with (scr_afterimage_monochrome(color, false))
				{
					image_alpha = 0.2 * other.image_alpha;
					depth = other.depth + 26;
				}
			}
		}
	}
	if (sway != 0)
	{
		y = sway + (other.fl_actor_amp * sin(current_time * 0.002));
	}
}
");

Apply("gml_Object_obj_dw_garden_aqua_Create_0", @"show_debug_message_concat(""global.entrance="", global.entrance);
turnofflayers(""CUT"");
turnofflayers(""DEBUG"");
