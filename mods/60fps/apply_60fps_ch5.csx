	{
		scr_doom(id, 15);
	}
};

fade_end_cutscene = function()
{
	c_customfunc(function()
	{
		with (instance_create(0, 0, obj_fadeout))
		{
			fadespeed = 1/15;
		}
	});
	c_wait(30);
	c_actortokris();
	c_actortocaterpillar();
	c_terminatekillactors();
};

