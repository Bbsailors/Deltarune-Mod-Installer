	c_msgnextsubloc(""~1* The shape of love may change./"", (global.lang == ""ja"") ? ""\\m5\t\t\t"" : ""\\m5\t\t"", ""obj_dw_fcastle_cafe_slash_Other_13_gml_3661_0"");
