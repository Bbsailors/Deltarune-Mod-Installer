Apply("gml_Object_obj_yellow_guided_bullet_Step_0", @"olddir = image_angle;
with (obj_blue_guidelines)
{
	if (point_distance(other.x, other.y, ds_list_find_value(line_list, 0).x, ds_list_find_value(line_list, 0).y) < 8)
	{
		if (ds_list_find_value(line_list, 0).sprite_index == spr_enemy_blue_flower_reticle)
		{
			snd_play_pitch(snd_bump, 1.35);
			var randangle = choose(0, 22.5, -22.5);
			grazepoints = 12;
			for (var a = 0; a < 8; a++)
			{
				with (scr_fire_bullet(ds_list_find_value(line_list, 0).x, ds_list_find_value(line_list, 0).y, obj_regularbullet, (45 * a) + randangle, 9, spr_enemy_blue_bullet_petal, 0, true))
				{
					speed -= (((a % 2) * 3) / global.fps_scale);
					image_xscale = 1;
					image_yscale = 4;
					image_angle = direction;
					gravity_direction = direction;
					friction = -0.3 / (global.fps_scale * global.fps_scale);
					scr_lerpvar(""speed"", speed, 1 / global.fps_scale, 8);
					scr_lerpvar(""image_xscale"", 1, 2, 8);
					scr_lerpvar(""image_yscale"", 4, 2, 8);
				}
			}
		}
		with (ds_list_find_value(line_list, 0))
		{
			instance_destroy();
		}
		ds_list_delete(line_list, 0);
		other.direction = point_direction(other.x, other.y, ds_list_find_value(line_list, 0).x, ds_list_find_value(line_list, 0).y);
		var whodat = other.id;
		with (obj_lerpvar)
		{
			if (target == whodat)
			{
				instance_destroy();
			}
		}
		var diff = angle_difference(ds_list_find_value(line_list, 0).image_angle, whodat.image_angle);
		var modify = 0;
		if (diff > 180)
		{
			modify -= 360;
		}
		if (diff < -180)
		{
			modify += 360;
		}
		with (whodat)
		{
			scr_lerpvar(""image_angle"", image_angle, ds_list_find_value(other.line_list, 0).image_angle + modify, floor(point_distance(x, y, ds_list_find_value(other.line_list, 0).x, ds_list_find_value(other.line_list, 0).y) / (speed * global.fps_scale)) - 1);
		}
	}
}
speed = scr_approach(speed, 5.65 / global.fps_scale, 0.03 / global.fps_scale);
");

Apply("gml_Object_obj_yellow_reticle_drawer_Draw_0", @"with (obj_regularbullet)
{
	if (sprite_index == spr_enemy_blue_flower_reticle)
	{
		if (reticle)
		{
			draw_sprite_ext(spr_enemy_yellow_reticle, 0, x, y, image_xscale, image_yscale, 0, ((floor(global.time / global.fps_scale) % 4) < 2) ? c_white : c_red, 1);
		}
	}
}
");

