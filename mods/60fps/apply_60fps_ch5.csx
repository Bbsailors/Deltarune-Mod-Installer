if (i_ex(punishgun))
{
	if (flower_moves)
	{
		flower_amp = scr_approach(flower_amp, 140, 3);
	}
	else
	{
		flower_amp = scr_approach(flower_amp, 0, 3);
	}
	if (flower_amp > 0 || flower_timer > 0)
	{
		flower_timer += (1 / global.fps_scale);
		if (bounceflower.lerptimer > 0)
		{
			bounceflower.anchorx = bounceflower.xstart + (sin(flower_timer / 30) * flower_amp);
		}
		else
		{
			bounceflower.x = bounceflower.xstart + (sin(flower_timer / 30) * flower_amp);
		}
		bounceflower.leaves.x = bounceflower.leaves.xstart + (sin((flower_timer + 5) / 30) * flower_amp);
	}
	if (gun_moves)
	{
		gun_amp = scr_approach(gun_amp, 200, 3);
	}
	else if (punishgun.movetype > 0)
	{
		if (gun_amp > 0)
		{
			gun_amp = 9999;
		}
	}
	else
	{
		gun_amp = scr_approach(gun_amp, 0, 3);
	}
	if (gun_amp > 0 || gun_timer > 0)
	{
		if (punishgun.movetype == 0)
		{
			gun_timer += (1 / global.fps_scale);
			punishgun.x = punishgun.xstart + (sin(gun_timer / 20) * gun_amp);
			punishgun.target_angle = 180 + point_direction(punishgun.x, punishgun.y, bounceflower.anchorx, bounceflower.anchory);
		}
		else if (!punishgun.is_stunned)
		{
			if (gun_amp >= 9999)
			{
				var inc = 1 - ((punishgun.hp + 1) / punishgun.__max_hp);
				punishgun.x = scr_approach(punishgun.x, punishgun.xstart, inc * 15);
			}
			else
			{
				var gtlast = gun_timer % 120;
				var inc = 1 - ((punishgun.hp + 1) / punishgun.__max_hp);
				gun_timer += (inc / global.fps_scale);
				var gt = gun_timer % 120;
				if (gt < 60)
				{
					if (gtlast >= 60)
					{
						snd_play(snd_chain_extend, 1, 1.5);
					}
					var xx = punishgun.x;
					punishgun.x = scr_approach(punishgun.x, punishgun.xstart - 200, inc * 15);
					if (xx != punishgun.x && punishgun.x == (punishgun.xstart - 200))
					{
						punishgun.shake = 4;
						snd_play(snd_chain_extend, 1, 1.5);
					}
				}
				else
				{
					if (gtlast < 60)
					{
						snd_play(snd_chain_extend, 1, 1.5);
					}
					var xx = punishgun.x;
					punishgun.x = scr_approach(punishgun.x, punishgun.xstart + 200, inc * 15);
					if (xx != punishgun.x && punishgun.x == (punishgun.xstart + 200))
					{
						punishgun.shake = 4;
						snd_play(snd_chain_extend, 1, 1.5);
					}
				}
			}
			punishgun.target_angle -= angle_difference(punishgun.target_angle, lerp(270, point_direction(punishgun.x, punishgun.y, bounceflower.anchorx, bounceflower.anchory) + 180, 0.5) + 90) * scr_fps_lerp_rate(0.2);
		}
		else
		{
			punishgun.target_angle -= angle_difference(punishgun.target_angle, 90) * scr_fps_lerp_rate(0.2);
		}
	}
}
var aqua_shoot = false;
