Apply("gml_Object_obj_room_castle_front_racer_Create_0", @"_marker = -4;
_name = """";
_race_active = false;
_triggers = [];
_start_x_pos = 580;
_target_index = 0;
_targeted = false;
_y_offset = 0;
_x_offset = 0;
_parent = -4;
_race_speed = 4;
_speed_min = 0;
_speed_max = 0;
_sprite = -4;
_interactable = -4;
var trigger_flags = [""start"", ""se"", ""ne"", ""nw"", ""sw"", ""goal""];
_race_points = [new Vector2(_start_x_pos, 490), new Vector2(750, 490), new Vector2(750, 340), new Vector2(240, 340), new Vector2(240, 490), new Vector2(440, 490)];

init = function(arg0, arg1, arg2, arg3, arg4)
{
	_parent = arg2;
	_name = arg4;
	_y_offset = arg1;
	_speed_min = arg3.x;
	_speed_max = arg3.y;
	_sprite = arg0;
	_x_offset = arg1;
	_race_points = [new Vector2(_start_x_pos, 520 + _y_offset), new Vector2(750 + _x_offset, 520 + _y_offset), new Vector2(750 + _x_offset, 420 - _y_offset), new Vector2(300 - _x_offset, 420 - _y_offset), new Vector2(300 - _x_offset, 520 + _y_offset), new Vector2(440, 520 + _y_offset)];
	_marker = scr_dark_marker(_start_x_pos, y + arg1, _sprite);
	with (_marker)
	{
		image_speed = 0.2 / global.fps_scale;
		scr_depth();
	}
	_interactable = instance_create(_start_x_pos - sprite_get_width(arg0), (y + arg1) - sprite_get_height(arg0), obj_readable_room1);
	_interactable.extflag = ""racer_"" + arg4;
	with (_interactable)
	{
		image_xscale = 2;
		image_yscale = 2;
		if (extflag == ""racer_mauswheel"")
		{
			image_xscale = 2.2;
			image_yscale = 2.2;
		}
	}
	change_target();
};

start_race = function()
{
	_target_index = 0;
	_race_speed = random_range(_speed_min, _speed_max) / global.fps_scale;
	change_target();
	_race_active = true;
	_marker.image_speed = 0.2 / global.fps_scale;
};

win = function()
{
	switch (_name)
	{
		case ""poppup"":
			with (_marker)
			{
				sprite_index = spr_poppup_racer_win;
				scr_lerp_var_instance(id, ""image_index"", 0, 10, 20);
			}
			break;
		case ""winglade"":
			with (_marker)
			{
				sprite_index = spr_npc_halo_racer_win;
			}
			break;
		case ""mauswheel"":
			with (_marker)
			{
				image_speed = 1.4 / global.fps_scale;
				scr_delay_var(""image_speed"", 0, 30);
			}
			break;
		case ""car"":
			with (_marker)
			{
				sprite_index = spr_car_small_racer_win;
			}
			break;
	}
};

play_sound = function()
{
	switch (_name)
	{
		case ""poppup"":
			snd_play_x(snd_inst_steel_drum, 0.7, 1);
			break;
		case ""winglade"":
			snd_play(snd_smallswing, 0.7, 1);
			break;
		case ""mauswheel"":
			snd_play(snd_mouse, 0.7, 1);
			break;
		case ""car"":
			snd_play(snd_smallcar_yelp, 0.4, 1);
			break;
	}
};

stop = function()
{
	_race_active = false;
	_marker.image_speed = 0;
	_marker.image_index = 0;
};

is_stopped = function()
{
	return !_race_active;
};

restart = function()
{
	var sprite = _sprite;
	with (_marker)
	{
		scr_delay_var(""sprite_index"", sprite, 60);
		scr_delay_var(""image_speed"", 0.2 / global.fps_scale, 60);
		scr_delay_var(""image_speed"", 0, 90);
		scr_delay_var(""image_index"", 0, 90);
	}
	scr_script_delayed(function()
	{
		scr_lerp_var_instance(_marker, ""x"", _marker.x, _start_x_pos, 30);
	}, 60);
	scr_script_delayed(start_race, 150);
};

change_target = function()
{
	_target_index++;
	if (_target_index >= array_length(_race_points))
	{
		stop();
		var racer_name = _name;
		with (_parent)
		{
			trigger_event(""stopped"", [racer_name]);
		}
	}
	else if (_name == ""car"")
	{
		_marker.image_xscale = ((_marker.x - _race_points[_target_index].x) > 0) ? 2 : -2;
	}
};
");

