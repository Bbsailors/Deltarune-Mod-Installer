		{
			eligible_for_standing_ending = 1;
		}
	}
	if (hp_thereshold_reached && bullet_pattern_endstate == 0 && i_ex(obj_dw_cliff_seth_miniboss))
	{
		if (con == 10 || con == 11 || con == 12)
		{
