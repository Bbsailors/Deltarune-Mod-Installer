		used_input = this_frame_directions[0];
		cancelled_slip = used_input == previous_bump;
	}
	else if (currentdir != previous_bump && currentdir != recently_bumped)
	{
		used_input = currentdir;
		cancelled_slip = false;
	}
	else
	{
		used_input = currentdir;
		cancelled_slip = true;
	}
}
