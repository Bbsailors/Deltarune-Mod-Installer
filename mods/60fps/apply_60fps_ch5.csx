Apply("gml_Object_obj_pinwheel_windspeed_Create_0", @"scr_plat_set_depth_offset(40);
scr_plat_set_group(UnknownEnum.Value_0, true);
scr_platswap_init(self, 2);
boostdir = -1;

boost_left = function()
{
	boostdir = -1;
	scr_plat_susie_attack_fast(self, true);
	with (obj_plat_player)
	{
		if (dashing)
		{
			dashing = false;
			dashing_end = round(15 * global.fps_scale);
			snd_play(snd_wing);
		}
	}
};

boost_right = function()
{
	boostdir = 1;
	scr_plat_susie_attack_fast(self, true);
	with (obj_plat_player)
	{
		if (dashing)
		{
			dashing = false;
			dashing_end = round(15 * global.fps_scale);
			snd_play(snd_wing);
		}
	}
};

act_l = scr_configure_platmode_act(boost_right, ""su"", stringsetloc(""Spin Right"", ""obj_pinwheel_windspeed_slash_Create_0_gml_19_0""), stringsetloc(""Lemme spin it to the right."", ""obj_pinwheel_windspeed_slash_Create_0_gml_20_0""));
act_r = scr_configure_platmode_act(boost_left, ""su"", stringsetloc(""Spin Left"", ""obj_pinwheel_windspeed_slash_Create_0_gml_23_0""), stringsetloc(""Lemme spin it to the left."", ""obj_pinwheel_windspeed_slash_Create_0_gml_24_0""));
y_ow = ystart;
y_plat = 0;
stem_x = xstart;
stem_y = y_ow;
if (targetdirection == 1)
{
	act_l.blocked = true;
}
if (targetdirection == -1)
{
	act_r.blocked = true;
}
linger_speed = 0;
windloop_sound = -4;
boosting_up = false;
boost_timer = 0;
stem_bend_level = 0;
stem_bend_direction = 1;
emitter = audio_emitter_create();
emitter_pan = 0;
audio_emitter_falloff(emitter, 100, 300, 1);
head_offsets = [[0, -74], [5, -73], [20, -66], [36, -54], [38, -52]];
head_offsets_up = [[0, -74], [0, -91], [0, -112], [0, -116]];

enum UnknownEnum
{
	Value_0
}
");

Apply("gml_Object_obj_pinwheel_windspeed_Draw_0", @"stem_bend_level = clamp(stem_bend_level, 0, 4);
var sbd = stem_bend_direction;
var boost_frame = floor(boost_timer);
if (boost_frame > (boost_duration + 8))
{
	sbd = -sbd;
}
var stem_level_offset = 0;
var stemsprite = 2816;
if (boosting_up)
{
	stemsprite = 8015;
	stem_level_offset = -1;
}
draw_sprite_ext(stemsprite, stem_bend_level + stem_level_offset, stem_x, stem_y, image_xscale * sbd, image_yscale, 0, image_blend, image_alpha);
if (boost_frame > 0)
{
	sprite_index = spr_pinwheel_head_spin;
}
else
{
	sprite_index = spr_pinwheel_head;
}
draw_self();
");

Apply("gml_Object_obj_pinwheel_windspeed_Step_2", @"if (global.pause_plat)
{
	exit;
}
boost_timer -= (1 / global.fps_scale);
var boost_frame = floor(boost_timer);
x = xstart;
y = lerp(y_ow, y_plat + (sprite_height * 0.9), array_get(scr_platswap_yscale(), 0));
stem_y = y;
var sbd = stem_bend_direction;
if (boost_frame > (boost_duration + 8))
{
	sbd = -sbd;
}
var offset = head_offsets[stem_bend_level];
if (boosting_up && stem_bend_level > 0)
{
	offset = head_offsets_up[stem_bend_level - 1];
}
x += (offset[0] * image_xscale * sbd);
y += (offset[1] * image_yscale);
if (boost_frame > 0)
{
	linger_speed = 1;
	if (boost_frame > (boost_duration + 11))
	{
		stem_bend_level = 2;
	}
	if (boost_frame > (boost_duration + 10))
	{
		stem_bend_level = 1;
	}
	if (boost_frame > (boost_duration + 9))
	{
		stem_bend_level = 0;
	}
	if (boost_frame > (boost_duration + 6) || boost_frame <= 4)
	{
		stem_bend_level = 1;
	}
	else if (boost_frame > (boost_duration + 4) || boost_frame <= 8)
	{
		stem_bend_level = 2;
	}
	else if (boost_frame > boost_duration)
	{
		stem_bend_level = 4;
	}
	else
	{
		stem_bend_level = 3 + (floor(boost_frame / 2) % 2);
	}
}
else
{
	linger_speed = max(linger_speed - (0.02 / global.fps_scale), 0);
	stem_bend_level = 0;
}
var head_rotation_speed = linger_speed;
if (boost_frame <= 0)
{
	head_rotation_speed = max(linger_speed - (0.02 * (boost_timer - floor(boost_timer))), 0);
}
if (i_ex(obj_plat_windcontroller_new))
{
	if (obj_plat_windcontroller_new.winddirection < 90 || obj_plat_windcontroller_new.winddirection > 270)
	{
		image_angle -= ((0.5 + (head_rotation_speed * 12)) / global.fps_scale);
	}
	else
	{
		image_angle += ((0.5 + (head_rotation_speed * 12)) / global.fps_scale);
	}
}
if (windloop_sound != -4)
{
	snd_volume(windloop_sound, (sin(boost_timer * 0.01) * 0.1) + 0.2, 0);
	snd_pitch(windloop_sound, lerp(2.5, 1.5, (sin(boost_timer * 0.008) * 0.5) + 0.5));
}
if (windloop_sound != -4 && boost_frame <= 0)
{
	snd_volume(windloop_sound, 0, 30);
	scr_script_delayed(snd_stop, 30, windloop_sound);
	windloop_sound = -4;
}
emitter_pan = scr_approach(emitter_pan, stem_bend_direction, 0.1);
audio_emitter_position(emitter, camerax() + 320 + (1212500 * emitter_pan), cameray() + 240, 0);
audio_listener_position(camerax() + 320, cameray() + 240, 0);
act_l.blocked = act_l.blocked || boosting_up;
act_r.blocked = act_r.blocked || boosting_up;
debug_print_persistent(string(id), ""L:"" + string(act_l.blocked));
debug_print_persistent(string(id) + ""r"", ""R:"" + string(act_r.blocked));
");

