					msgset_add(stringsetloc(""How could that be!?&I done never told&nobody 'bout those!/%"", ""obj_yellow_enemy_slash_Step_0_gml_375_0""), x - 20, y + 40, 10, 50, function()
					{
						idlesprite = spr_yellow_embarassed;
