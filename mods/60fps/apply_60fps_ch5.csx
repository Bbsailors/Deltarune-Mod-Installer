			var face = [""L"", ""K""];
			scr_anyface_next(""ralsei"", face[hat]);
			msgnextsubloc(""\\E~1* (At least it doesn't talk!)/%"", face[hat], ""obj_dw_garden_susiechase_slash_Step_0_gml_2260_0"");
		}
		d_make();
		myinteract = 999;
	}
	if (myinteract == 999 && !d_ex())
	{
		myinteract = 0;
		global.interact = 0;
	}
}
var movespeed = 3 / global.fps_scale;
if (failcon == 1)
{
	ftimer = 0;
	failnpc = scr_marker_frominstance(fakeralsei);
	failnpc.hspeed = movespeed;
	with (ralsei_npc)
	{
		x = room_width * 4;
		marker.visible = false;
	}
	with (fakeralsei)
	{
		visible = false;
	}
	failcon = 2;
}
if (failcon == 2)
{
	if (failnpc.x >= rlox[0].x)
	{
		failnpc.x = rlox[0].x;
		failnpc.hspeed = 0;
		failnpc.vspeed = movespeed;
		failcon++;
	}
}
if (failcon == 3)
{
	if (failnpc.y >= rlox[1].y)
	{
		failnpc.y = rlox[1].y;
		failnpc.hspeed = movespeed;
		failnpc.vspeed = 0;
		failcon++;
	}
}
if (failcon == 4)
{
	if (failnpc.x >= rlox[1].x)
	{
		failnpc.x = rlox[1].x;
		failnpc.hspeed = 0;
		failnpc.vspeed = 0;
		failcon++;
		with (pathblock)
		{
			y += 80;
		}
	}
}
if (failcon == 5)
{
	if (obj_mainchara.x >= rlox[2].x)
	{
		con = 20;
		failcon = 6;
		var loc = rlox[3];
		failnpc.visible = false;
		with (obj_caterpillarchara)
		{
			if (name == ""ralsei"")
			{
				setxy(loc.x, loc.y);
				visible = true;
				scr_caterpillar_interpolate(name);
			}
		}
		with (pathblock)
		{
			y -= 80;
		}
		with (obj_solidblocksized_alt)
		{
			instance_destroy();
		}
	}
}
if (failcon == 6)
{
	if (obj_mainchara.y <= rlox[4].y)
	{
		failcon = 7;
		with (obj_starwalker_offswitch)
		{
			instance_destroy();
		}
		clearPath();
	}
}
");

Apply("gml_Object_obj_dw_garden_susiechase_darknessexplanation_new_Step_0", @"global.interact = 1;
cam = scr_getcam();
x = cam.x;
y = cam.y;
with (obj_writer)
{
