					face = spr_face_blue_butterfly_blush;
					imgindex = siner * 0.4166666666666667;
				}
			}
		}
		if (global.fe == 59)
		{
			face = spr_face_blank;
		}
		if (global.fe == 60)
		{
			scale = 1;
			face = spr_face_blue_butterfly;
			siner += (1 / global.fps_scale);
			__xoff = -58;
			__yoff = -5;
			imgindex = (sin(siner / 9) * 3.5) + 3.5;
		}
		if (global.fe == 61)
		{
			face = spr_face_placeholder;
			face_index = 0;
			timer = 0;
		}
		draw_sprite_ext(face, imgindex, (x - 12) + __xoff, (y - 1) + __yoff, scale, scale, 0, c_white, 1);
	}
}
nowface = global.fc;
");

Apply("gml_Object_obj_face_Step_0", @"buffer -= (1 / global.fps_scale);
if (buffer < 0)
{
	if (mouthmove == 1 && mouthtimer == 0)
	{
		mouthtimer = 1;
		face_index = 1;
	}
}
if (mouthtimer > 0)
{
