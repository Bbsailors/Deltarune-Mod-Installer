			post_cam_pos2 = findspriteinfo(spr_debug_cameraregionpreview, ""CUTSCENE_POST_ELEMENTS"", c_red);
			battlesetup = true;
			with (darkness)
			{
				instance_destroy();
			}
			with (obj_spotlight)
			{
				instance_destroy();
			}
			blue_actor.visible = true;
			yellow_actor.visible = true;
			blue_actor.x1 = blue_actor.x;
			blue_actor.y1 = blue_actor.y;
			yellow_actor.x1 = yellow_actor.x + 10;
			yellow_actor.y1 = yellow_actor.y;
			blue_actor.x = post_blue_pos1.x;
			blue_actor.y = post_blue_pos1.y;
			blue_actor.sprite_index = spr_blue_turn_head_concerned;
			blue_actor.image_speed = 0;
			blue_actor.image_index = 0;
			yellow_actor.x = post_yellow_pos1.x + 10;
