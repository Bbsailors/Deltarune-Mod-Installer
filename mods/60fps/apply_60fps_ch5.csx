Apply("gml_Object_obj_plat_tomebullet_Step_0", @"if (!init)
{
	init = true;
	mystring = chr(65 + mystring);
	textmarker.mystring = mystring;
	textmarkerback.mystring = mystring;
}
if (!global.pause_plat)
{
	timer += (1 / global.fps_scale);
	drawtimer += (1 / global.fps_scale);
	if (con == 0)
	{
		originposx = x;
		originposy = y;
		if (fadein == 0)
		{
			targetalpha = ease_out_quad(min(1, timer / 20), 0, 1, 1);
			if (targetalpha == 1)
			{
				fadein = 1;
			}
		}
		if (timer >= 30)
		{
			damage = 30;
		}
	}
	else if (con == 1)
	{
		if (timer > 20)
		{
			var t = timer - 20;
			if (timer == 21 && i_ex(obj_plat_player))
			{
				snd_play(snd_heavyswing);
				targetposx = x + ((obj_plat_player.x - x) * 1.1);
				targetposy = y + ((obj_plat_player.y - y) * 1.1);
			}
			x = lerp(originposx, targetposx, 0.5 - (0.5 * cos(degtorad(t * 8))));
			y = lerp(originposy, targetposy, 0.5 - (0.5 * cos(degtorad(t * 8))));
			if (t >= 45)
			{
				con = 0;
				timer = 0;
			}
		}
		else
		{
			x = originposx;
			y = originposy;
		}
	}
	else
	{
		var t = timer - 20;
		if (timer == 21 && i_ex(obj_plat_player))
		{
			snd_play(snd_heavyswing);
			direction = point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
			speed = 5 / global.fps_scale;
		}
		if (speed > 0)
		{
			speed += (0.5 / (global.fps_scale * global.fps_scale));
		}
		if (!scr_onscreen_tolerance(self, 50) || place_meeting(x, y, obj_plat_block))
		{
			instance_destroy();
		}
	}
}
if (damage > 0)
{
	image_alpha = scr_approach(image_alpha, targetalpha, 0.05);
}
else
{
	image_alpha = scr_approach(image_alpha, targetalpha * 0.5, 0.05);
}
with (textmarker)
{
	alpha = other.image_alpha;
}
with (textmarkerback)
{
	alpha = other.image_alpha;
}
");

Apply("gml_Object_obj_plat_toyrope_Draw_0", @"event_inherited();
if (is_culled)
{
	exit;
}
draw_set_color(ropecolor);
var steplen = 0;
var maxval = nodecount - 2;
var size = sprite_height;
if (swaying)
{
	for (var i = maxval; i >= 0; i--)
	{
		var _ii = i * 2;
		var alph = 1;
		var x1 = dnodes[_ii];
		var y1 = dnodes[_ii + 1];
		var x2 = dnodes[_ii + 2];
		var y2 = dnodes[_ii + 3];
		var angle = point_direction(x1, y1, x2, y2);
		var dist = point_distance(x1, y1, x2, y2);
		size -= dist;
		var xx = x1 + lengthdir_x(0.5 * sprite_width, angle - 90);
		var yy = y1 + lengthdir_y(0.5 * sprite_width, angle - 90);
		var yscale = dist / 5;
		draw_sprite_general(sprite_index, image_index, 0, size / yscale, sprite_width / image_xscale, dist - 1, xx, yy, image_xscale, yscale, angle + 90, image_blend, image_blend, image_blend, image_blend, alph);
		if (size <= 0)
		{
			exit;
		}
	}
}
else
{
	draw_self();
}
");

Apply("gml_Object_obj_plat_twirlflower_Step_0", @"if (!init)
{
	init = true;
	scr_plat_wallcast();
	hook = instance_create(x, y, obj_ralsei_hook);
	depth -= 350;
	with (hook)
	{
		sprite_index = other.sprite_index;
		image_index = 2;
		image_speed = 0;
		depth = other.depth - 1;
		menu_name = stringsetloc(""Hookflower"", ""obj_plat_twirlflower_slash_Step_0_gml_14_0"");
		owner = other;
		can_cut_down = other.can_cut_down;
		stick = true;
		hang_xoffset = 24;
		hang_yoffset = 120 * other.image_yscale;
		if (other.short)
		{
			sprite_index = spr_plat_twirlflower_short;
			hang_yoffset = 52 * other.image_yscale;
		}
		image_xscale = other.image_xscale;
		image_yscale = other.image_yscale;
		visible = array_get(scr_platswap_yscale(), 0) > 0.99;
	}
	startdepth = depth;
	if (place_meeting(x, y, obj_plat_action_blocker))
	{
		blockedlerp = 1;
		depth += 1000;
	}
	controller = instance_find(obj_plat_windcontroller_new, 0);
	true_winddir = controller.winddirection;
	true_windspeed = (controller.strength - 1) * 2;
}
vspeed = 0;
if (can_loop)
{
	var exitpos = -4;
	var enterpos = -4;
	var loop = false;
	with (obj_plat_loopboundary)
	{
		if (abs(y - other.y) < 400)
		{
			if (extflag == ""leftedge"")
			{
				enterpos = x;
				loop = loop || other.bbox_left < bbox_left;
			}
			else if (extflag == ""rightedge"")
			{
				exitpos = x;
				loop = loop || other.bbox_left > bbox_left;
			}
		}
	}
	if (loop)
	{
		var rw = abs(exitpos - enterpos);
		if (bbox_left > exitpos)
		{
			x -= rw;
		}
		else if (bbox_left < enterpos)
		{
			x += rw;
		}
	}
}
if (min_x != -1)
{
	x = max(x, min_x);
}
if (max_x != -1)
{
	x = min(x, max_x);
}
if (global.pause_plat)
{
	exit;
}
weighed_down = hook.ralsei_ready;
weighing_lerp = scr_approach(weighing_lerp, weighed_down, 4 / ralsei_yoffset);
var wind_hspeed = 0;
var wind_vspeed = 0;
var hang_speed = drop_speed;
if (wind_influenced && controller != -4 && controller.winddirection != -1)
{
	true_winddir = scr_approach(true_winddir, controller.winddirection, 2);
	true_windspeed = scr_approach(true_windspeed, (controller.strength - 1) * 2, 0.05);
	var dir = true_winddir;
	var spd = true_windspeed * 2;
	wind_hspeed = lengthdir_x(spd, dir);
	wind_vspeed = 0;
	var wind_vspeed_modless = 0;
	wind_vspeed_modless = 0;
	if (wind_vspeed_modless < 0)
	{
		hang_speed = -0.5 * wind_vspeed_modless;
	}
	if (true_windspeed == 0)
	{
		true_winddir = 90;
	}
}
x += (wind_hspeed / global.fps_scale);
reference_y += wind_vspeed;
anchor_y += wind_vspeed;
var now_reference = lerp(reference_y, reference_y + ralsei_yoffset, ease_inout_quad(weighing_lerp, 0, 1, 1));
if (weighed_down)
{
	targetheight = 0;
	if (!is_culled)
	{
		var ral = -4;
		with (obj_plat_follower)
		{
			if (name == ""ralsei"")
			{
				ral = self;
				break;
			}
		}
		if (scr_plat_standing_on(""kr"", ral.platform) || scr_plat_standing_on(""kr"", plat))
		{
			targetheight = 1;
		}
	}
	if (targetheight == 0)
	{
		drop_speed = scr_approach(drop_speed, -5 / global.fps_scale, 0.1);
	}
	else
	{
		drop_speed = scr_approach(drop_speed, 5 / global.fps_scale, 1);
	}
}
else
{
	drop_speed = lerp(drop_speed, -5 / global.fps_scale, scr_fps_lerp_rate(0.1));
}
if (anchor_y < (now_reference - (20 * global.fps_scale * drop_speed)))
{
	drop_speed = max(drop_speed, (anchor_y - now_reference) * (-0.05 / global.fps_scale));
}
else if (anchor_y > ((now_reference + max_yoffset) - (20 * global.fps_scale * drop_speed)))
{
	drop_speed = min(drop_speed, (anchor_y - (now_reference + max_yoffset)) * (-0.05 / global.fps_scale));
}
anchor_y = clamp(anchor_y + drop_speed, now_reference, now_reference + max_yoffset);
if (weighed_down && anchor_y < (now_reference + 20))
{
	anchor_y = lerp(anchor_y, now_reference + 20, scr_fps_lerp_rate(0.1));
}
var slump_siner = 0;
if (!is_culled && !weighed_down && scr_plat_standing_on(""kr"", plat))
{
	if (!was_slumped)
	{
		was_slumped = true;
		slump_timer = 0;
	}
	slump_y_off = scr_approach(slump_y_off, 8, 1);
	if (obj_plat_player.depth < startdepth)
	{
		obj_plat_player.depth = startdepth - 400;
	}
}
else
{
	was_slumped = false;
	slump_y_off = scr_approach(slump_y_off, 0, 1);
}
if (slump_timer >= 0)
{
	slump_siner = sin(slump_timer / 2) * max(0, 4 - (0.1 * slump_timer));
	slump_timer += (1 / global.fps_scale);
}
vspeed = clamp((anchor_y + slump_y_off + slump_siner) - y, -4 / global.fps_scale, 4 / global.fps_scale);
hook.newx = x;
hook.newy = y + (120 * image_yscale);
if (short)
{
	hook.newy = y + (67 * image_yscale);
}
image_index = floor((anchor_y - reference_y) / 5);
if (can_hook)
{
	if (hook._act != -4 && hook._act.blocked)
	{
		blockedlerp += (0.1 / global.fps_scale);
	}
	else
	{
		blockedlerp -= (0.1 / global.fps_scale);
	}
}
if (!hook_depth_init)
{
	if (place_meeting(x, y, obj_plat_action_blocker))
	{
		blockedlerp = 1;
	}
	hook_depth_init = true;
}
if (hook._act != -4 && !can_hook)
{
	hook._act.blocked = true;
}
blockedlerp = clamp01(blockedlerp);
");

Apply("gml_Object_obj_plat_umbrella_Step_0", @"event_inherited();
if (!init)
{
	init = true;
	scr_plat_wallcast();
	hook = instance_create(x, y, obj_ralsei_hook);
	depth -= 350;
	with (hook)
	{
		sprite_index = other.sprite_index;
		image_index = 1;
		image_speed = 0;
		depth = other.depth - 1;
		menu_name = stringsetloc(""Hang (Umbrella)"", ""obj_plat_umbrella_slash_Step_0_gml_17_0"");
		owner = other;
		can_cut_down = other.can_cut_down;
		stick = true;
		hang_xoffset = 64;
		hang_yoffset = 80;
		image_xscale = other.image_xscale;
		image_yscale = other.image_yscale;
	}
	startdepth = depth;
	controller = instance_find(obj_plat_windcontroller_new, 0);
	true_winddir = controller.winddirection;
	true_windspeed = controller.strength;
}
if (x <= 0 || x >= room_width)
{
	instance_destroy();
	exit;
}
if (y <= 0 || y >= room_height)
{
	instance_destroy();
	exit;
}
var margin = 140;
if (x > (room_width + margin))
{
	x -= (room_width + (margin * 2));
}
else if (x < -margin)
{
	x += (room_width + (margin * 2));
}
if (min_x != -1)
{
	x = max(x, min_x);
}
if (max_x != -1)
{
	x = min(x, max_x);
}
if (global.pause_plat)
{
	exit;
}
weighed_down = hook.ralsei_ready;
var wind_hspeed = 0;
var wind_vspeed = 0;
var hang_speed = drop_speed;
if (wind_influenced && controller != -4 && controller.winddirection != -1)
{
	true_winddir = scr_approach(true_winddir, controller.winddirection, 2);
	true_windspeed = scr_approach(true_windspeed, controller.strength, 0.05);
	var dir = true_winddir;
	var spd = true_windspeed * 2;
	wind_hspeed = lengthdir_x(spd, dir);
	wind_vspeed = 0;
	var wind_vspeed_modless = 0;
	wind_vspeed_modless = 0;
	if (wind_vspeed_modless < 0)
	{
		hang_speed = -0.5 * wind_vspeed_modless;
	}
}
timer += (1 / global.fps_scale);
if (behaviour_mode == 0)
{
	if (con == 0)
	{
		x = xstart + (sin((timer * 0.07) + (phase * 4)) * 40);
		vspeed = max(vspeed * power(1.05, 1 / global.fps_scale), -16 / global.fps_scale);
		reference_y += wind_vspeed;
		anchor_y += wind_vspeed;
		if (scr_trigcheck_ext(""umbrella_fly_in_bg"", self))
		{
			con = 1;
			if (hook.ralsei_ready)
			{
				with (obj_plat_follower)
				{
					drop_off_platform_mode(true);
					vspeed = other.vspeed;
					with (obj_plat_player)
					{
						vspeed = other.vspeed;
					}
				}
			}
			hook._act.blocked = true;
			hook.visible = 0;
			scr_lerpvar(""hspeed"", 0, random_range(4, 6), 90, 1, ""in"");
			scr_lerpvar(""vspeed"", vspeed, 0, 120, 1, ""in"");
			scr_lerpvar(""parallaxer"", 0, 1, 90);
			scr_doom(self, 90);
		}
	}
}
else if (behaviour_mode == 1)
{
	var xsin = sin((timer * siner_freq * 0.03) + degtorad(siner_phase_offset_degrees)) * siner_amp;
	var ysin = (cos((timer * siner_freq * 0.03) + degtorad(siner_phase_offset_degrees)) * siner_amp * siner_circle_ratio) + (4 * sin(timer * 0.1));
	x = xstart + lengthdir_x(xsin, siner_angle) + lengthdir_y(ysin, siner_angle);
	y = ystart + lengthdir_y(xsin, siner_angle) + lengthdir_x(ysin, siner_angle);
}
hook.active = !is_background;
if (weighed_down)
{
	targetheight = 0;
	var ral = -4;
	with (obj_plat_follower)
	{
		if (name == ""ralsei"")
		{
			ral = self;
			break;
		}
	}
	if (scr_plat_standing_on(""kr"", ral.platform))
	{
		targetheight = 1;
	}
	if (targetheight == 0)
	{
		drop_speed = scr_approach(drop_speed, -5 / global.fps_scale, 0.2);
	}
	else
	{
		drop_speed = scr_approach(drop_speed, 5 / global.fps_scale, 0.2);
	}
}
else
{
	drop_speed = lerp(drop_speed, -5 / global.fps_scale, scr_fps_lerp_rate(0.1));
}
if (anchor_y < (reference_y - (20 * global.fps_scale * drop_speed)))
{
	drop_speed = max(drop_speed, (anchor_y - reference_y) * (-0.05 / global.fps_scale));
}
else if (anchor_y > ((reference_y + max_yoffset) - (20 * global.fps_scale * drop_speed)))
{
	drop_speed = min(drop_speed, (anchor_y - (reference_y + max_yoffset)) * (-0.05 / global.fps_scale));
}
anchor_y = clamp(anchor_y + drop_speed, reference_y, reference_y + max_yoffset);
if (weighed_down && anchor_y < (reference_y + 20))
{
	anchor_y = lerp(anchor_y, reference_y + 20, scr_fps_lerp_rate(0.1));
}
hook.newx = x + 40;
hook.newy = y + 80;
if (instance_exists(bullet_instance) && instance_exists(hook))
{
	can_hook = false;
	if (hook._act != -4)
	{
		hook._act.blocked = true;
		hook._actsu.blocked = true;
	}
}
if (can_hook)
{
	if (hook._act != -4 && hook._act.blocked)
	{
		blockedlerp += (0.1 / global.fps_scale);
	}
	else
	{
		blockedlerp -= (0.1 / global.fps_scale);
	}
}
if (!hook_depth_init)
{
	if (place_meeting(x, y, obj_plat_action_blocker))
	{
		blockedlerp = 1;
	}
	hook_depth_init = true;
}
if (hook._act != -4 && !can_hook)
{
	hook._act.blocked = true;
}
blockedlerp = clamp01(blockedlerp);
with (bullet_instance)
{
	x = other.x + 40;
	y = other.y + 80;
	depth = other.depth - 2;
	if ((other.timer % 4) == 0 && scr_onscreen(self))
	{
		with (scr_afterimage_monochrome(255, true))
		{
			scr_lerpvar(""image_xscale"", image_xscale, image_xscale + 0.4, 4);
			scr_lerpvar(""image_yscale"", image_yscale, image_yscale + 0.4, 4);
			image_alpha = 0.5;
		}
	}
}
");

Apply("gml_Object_obj_plat_umbrellaplatform_Step_0", @"if (!init)
{
	scr_plat_depthcast();
	init = 1;
	if (can_hook)
	{
		hook = instance_create(x, y, obj_ralsei_hook);
		with (hook)
		{
			sprite_index = spr_npc_umbrellayokai_center_green;
			image_speed = 0;
			depth = other.depth - 1;
			menu_name = stringsetloc(""Hang (Umbrella)"", ""obj_plat_umbrellaplatform_slash_Step_0_gml_14_0"");
			menu_desc = stringsetloc(""If it hooks, I can hang!"", ""obj_plat_umbrellaplatform_slash_Step_0_gml_15_0"");
			owner = other;
			can_cut_down = other.can_cut_down;
			stick = true;
			hang_xoffset = 30;
			hang_yoffset = -14;
			image_xscale = other.image_xscale;
			image_yscale = other.image_yscale;
		}
	}
}
if (global.pause_plat)
{
	exit;
}
if (con == 0)
{
	image_index = 1;
}
if (wobble_timer > 0)
{
	var angle = degtorad(wobble_timer * 20);
	image_xscale = xscale + (0.2 * sin(angle));
	image_yscale = yscale - (0.2 * sin(angle));
	messagecon = 2;
	with (messagebubble)
	{
		instance_destroy();
	}
	wobble_timer += (2 / global.fps_scale);
	if (is_standing_on)
	{
		with (obj_plat_player)
		{
			can_jump = false;
			state = 1;
			attacking = 0;
			hspeed = 0;
			sprite_index = spr_kris_plat_land;
			land_anim = true;
			jumpbuffer = -1;
			image_speed = 0;
			jumpsquat = 0;
			key_jump = false;
			press_jump = false;
		}
	}
	if (is_standing_on)
	{
		with (obj_plat_player)
		{
			scr_get_inputs(true);
			if (press_jump || key_jump)
			{
				other.high_jump = true;
			}
		}
		if (angle >= 3.9269908169872414)
		{
			con = 1;
			timer = 0;
			with (obj_plat_player)
			{
				other.spawn_player_particles = true;
				if (dashing)
				{
					dashing = false;
				}
				state = 0;
				if (other.high_jump)
				{
					vspeed = -30 / global.fps_scale;
					with (other)
					{
						play_wing_snd(10);
					}
					other.intense = true;
				}
				else
				{
					vspeed = -20 / global.fps_scale;
					with (other)
					{
						play_wing_snd(5);
					}
					other.intense = false;
				}
				can_jump = true;
				snd_play(snd_petaldrain, 1, 1.25);
			}
		}
	}
	if (angle >= (2 * pi))
	{
		wobble_timer = 0;
		image_xscale = xscale;
		image_yscale = yscale;
	}
}
else if (is_standing_on && !was_standing_on)
{
	wobble_timer = 1;
	was_standing_on = true;
}
if (i_ex(obj_plat_player))
{
	if (is_standing_on)
	{
		obj_plat_player.hspeed = 0;
	}
	else
	{
		high_jump = 0;
	}
}
if (instance_exists(hook))
{
	var weighed_down = hook.ralsei_ready;
	if (weighed_down && can_be_overwhelmed)
	{
		stressed_timer += (1 / global.fps_scale);
		if (stressed_timer == 1)
		{
			sprite_index = spr_npc_umbrellayokai_concerned_green;
		}
		if (stressed_timer == 120)
		{
			con = 1;
			on_umbrella_hit();
			timer = 0;
		}
	}
	else
	{
		if (con == 0 && sprite_index == spr_npc_umbrellayokai_concerned_green)
		{
			sprite_index = spr_npc_umbrellayokai_center_green;
		}
		stressed_timer = 0;
	}
	if (con == 1)
	{
		with (obj_plat_follower)
		{
			if (name == ""ralsei"" && weighed_down)
			{
				ralsei_fall_down(60);
			}
		}
	}
}
if (!is_standing_on && was_standing_on)
{
	with (obj_plat_player)
	{
		state = 0;
		can_jump = true;
	}
}
if (con > 0 && con < 1)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		sprite_index = spr_npc_umbrellayokai_laugh;
		image_speed = 0.25 / global.fps_scale;
	}
	if (timer >= 60)
	{
		sprite_index = spr_npc_umbrellayokai_center;
		image_speed = 0;
		image_index = 1;
		con = 0;
	}
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		sprite_index = spr_npc_umbrellayokai_flyaway_center;
		image_speed = 0.5 / global.fps_scale;
	}
	if (timer >= max(10, 15 + (30 * intense)))
	{
		sprite_index = spr_npc_umbrellayokai_center;
		image_speed = 0;
		image_index = 1;
		con = 0;
	}
}
if (spawn_player_particles)
{
	with (obj_plat_player)
	{
		var angle = point_direction(0, 0, hspeed, vspeed);
		for (var i = 1; i < 4; i++)
		{
			with (instance_create(other.x, bbox_bottom, obj_animation))
			{
				sprite_index = spr_plat_cloudplatform_fx;
				image_speed = (0.75 - (0.1 * i)) / global.fps_scale;
				depth = other.depth - 1;
				image_angle = 90 + angle;
				scr_lerpvar(""image_xscale"", i, i + 1, 6 + i, 1, ""out"");
			}
		}
		other.spawn_player_particles = false;
	}
}
if (con == 0 && place_meeting(x, y, obj_plat_hbx))
{
	con = 1;
	intense = -1;
	timer = 0;
	on_umbrella_hit(self);
	var ptch = 1.5;
	with (instance_create(x, y - 40, obj_animation))
	{
		sprite_index = spr_plat_cloudplatform_fx;
		image_speed = 0.5 / global.fps_scale;
		depth = other.depth - 1;
		image_angle = 0;
		direction = 0;
		image_alpha = 0.5;
		image_blend = make_color_hsv((255 * other.pitch) / 6, 255, 255);
		scr_lerpvar(""image_xscale"", 1, 2, 8, 1, ""out"");
	}
	repeat (pitch)
	{
		ptch *= 1.059;
		ptch *= 1.059;
	}
	snd_play(snd_sparkle_glock, 1, ptch);
}
");

Apply("gml_Object_obj_plat_umbrellaplatform_Step_2", @"if (instance_exists(hook))
{
	hook.depth = depth - 1;
	hook.image_blend = image_blend;
	hook.image_xscale = image_xscale;
	hook.image_yscale = image_yscale;
	hook.visible = con == 0 && !hook.ralsei_ready;
	hook.blocked = con != 0;
	visible = con != 0 || hook.ralsei_ready;
	if (con == 1)
	{
		sprite_index = spr_npc_umbrellayokai_flyaway_green;
	}
	else if (con == 0.5)
	{
		sprite_index = spr_npc_umbrellayokai_laugh_green;
	}
	else if (!hook.ralsei_ready)
	{
		sprite_index = spr_npc_umbrellayokai_center_green;
	}
}
if (global.pause_plat)
{
	exit;
}
was_standing_on = is_standing_on;
is_standing_on = scr_plat_standing_on(""kr"", platform);
var xp = x;
platform.y = y - 64;
if (airborne && !is_standing_on && y_plat != 0)
{
	sinetimer += (1 / global.fps_scale);
	x = xstart + (horizontal_range * sin(sinetimer * horizontal_amp));
	y = y_plat + (sin(sinetimer * 0.1) * 4);
}
if (wobble_timer > 0 && !is_standing_on)
{
	var angle = degtorad(wobble_timer * 20);
	platform.y += sin(angle) * 6;
}
platform.x = x - (sprite_get_width(sprite_index) * 2 * 0.5);
if (abs(x - xp) > (10 / global.fps_scale) && (global.time % global.fps_scale) == 0)
{
	scr_afterimage().image_alpha = 0.3;
}
");

Apply("gml_Object_obj_plat_vfx_Create_0", @"image_xscale = 2;
image_yscale = 2;
die_to_solids = false;
die_anim_end = true;
vfx_scaled = false;
");

Apply("gml_Object_obj_plat_vfx_Step_0", @"if (!vfx_scaled)
{
	image_speed /= global.fps_scale;
	vfx_scaled = true;
}
if (die_to_solids)
{
