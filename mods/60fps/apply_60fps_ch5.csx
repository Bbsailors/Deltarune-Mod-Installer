			{
				x = other.ralsei.x;
				y = other.ralsei.y;
			}
			follow = true;
			scr_caterpillar_interpolate();
			visible = true;
		}
		for (var i = 0; i < array_length(actualcat); i++)
		{
			if (i_ex(actualcat[i]))
			{
				catmarker[i].visible = false;
				actualcat[i].visible = true;
				switch (i)
				{
					case 1:
						myxoff = -10;
						myyoff = -2;
						if (dir == 1)
						{
							myxoff = 50;
						}
						break;
					case 2:
						myxoff = -20;
						myyoff = -30;
						if (dir == 1)
						{
							myxoff = 60;
						}
						break;
