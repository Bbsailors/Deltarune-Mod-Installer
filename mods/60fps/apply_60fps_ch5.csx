Apply("gml_Object_obj_gameover_init_Step_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
	snd_free_all();
}
if (timer == 30)
{
	with (bg)
	{
		instance_destroy();
	}
	visible = 1;
	x = global.heartx;
	y = global.hearty;
}
if (timer == 31)
{
	sprite_delete(global.screenshot);
}
if (timer == 50)
{
	var prev_room = -4;
	if (variable_global_exists(""gameover_room""))
	{
		prev_room = global.gameover_room;
	}
	if (global.chapter == 5 && global.plot < 280 && variable_global_exists(""pre_hospital_room""))
	{
		con = 1;
		instance_create(0, 0, obj_fadeout);
	}
	else if (global.chapter == 5 && global.tempflag[98] == 1 && (prev_room == 226 || prev_room == 217))
	{
		con = 2;
		instance_create(0, 0, obj_fadeout);
	}
	else
	{
		snd_play(snd_break1);
		sprite_index = spr_heartbreak;
		x -= 2;
	}
}
if (con == 0)
{
	if (timer == 90)
	{
		snd_play(snd_break2);
		visible = 0;
		sh[0] = instance_create(x - 2, y, obj_marker);
		sh[1] = instance_create(x, y + 3, obj_marker);
		sh[2] = instance_create(x + 2, y + 6, obj_marker);
		sh[3] = instance_create(x + 8, y, obj_marker);
		sh[4] = instance_create(x + 10, y + 3, obj_marker);
		sh[5] = instance_create(x + 12, y + 6, obj_marker);
		for (var i = 0; i < 6; i += 1)
		{
			with (sh[i])
			{
				direction = random(360);
				speed = 7 / global.fps_scale;
				gravity_direction = 270;
				gravity = 0.2 / (global.fps_scale * global.fps_scale);
				sprite_index = spr_heartshards;
				image_speed = 0.2 / global.fps_scale;
			}
		}
		if (global.tempflag[3] >= 1)
		{
			timer += 15;
		}
	}
	if (timer == 140)
	{
		instance_create(0, 0, obj_fadeout);
	}
	if (timer >= 80 && timer < 150)
	{
		if (button1_p())
		{
			Z_COUNT += 1;
		}
		if (Z_COUNT >= 4)
		{
			timer = -999;
			timerb += (1 / global.fps_scale);
			var fade_out = scr_fadeout(30);
			with (fade_out)
			{
				image_blend = c_white;
				depth = -99999999;
			}
			snd_play_x(snd_dtrans_lw, 0.7, 1);
		}
	}
	if (timerb > 0)
	{
		timerb += (1 / global.fps_scale);
		if (timerb == 40)
		{
			scr_tempload();
		}
	}
	if (timer == 150)
	{
		room_goto(PLACE_FAILURE);
	}
}
else if (con == 1)
{
	if (timer == 90)
	{
		with (instance_create(0, 0, obj_persistentfadein))
		{
			image_alpha = 1.2;
		}
		if (global.plot < 280)
		{
			global.interact = 0;
			room_goto(room_dw_garden_hospital);
		}
	}
}
else if (con == 2)
{
	if (timer == 90)
	{
		with (instance_create(0, 0, obj_persistentfadein))
		{
			image_alpha = 1.2;
		}
		if (variable_global_exists(""flowery_battle_items""))
		{
			var item_used = false;
			for (var i = 0; i < array_length(global.flowery_battle_items); i++)
			{
				if (global.item[i] == global.flowery_battle_items[i])
				{
					continue;
				}
				item_used = true;
				break;
			}
			global.flowery_battle_items_used = item_used;
		}
		scr_tempload();
		room_goto(room_dw_fcastle_flowery);
	}
}
");

