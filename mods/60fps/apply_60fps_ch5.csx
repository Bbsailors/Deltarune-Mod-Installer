	{
		npc_crowd[i].y = npc_crowd[i].ystart + sin((crown_bounce_timer / 14) * (i + 4));
	}
}
if (crowd_bounce_stop)
{
	crowd_bounce_stop = false;
	crowd_bounce = false;
	for (var i = 0; i < array_length(npc_crowd); i++)
	{
		scr_lerpvar_instance(npc_crowd[i], ""y"", npc_crowd[i].y, npc_crowd[i].ystart, 12);
	}
}
