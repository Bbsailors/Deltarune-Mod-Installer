		finish_transition();
		rate = -4;
		pregen = true;
		view_visible[1] = false;
		exit;
	}
	rate = clamp(-5 + ((obj_mainchara.x - 300) / 100), -5, 4);
	if (rate > -1 && rate < 1)
	{
		rate = 1;
	}
	show_debug_message_concat(rate);
	if (rate >= 4)
	{
		transition_stage = 1;
		whirl_rate = 300;
		rate = -4;
	}
}
if (transition_stage == 1)
{
	whirl_rate = scr_approach(whirl_rate, 0, 60);
	var _line_accel = abs(lengthdir_x(whirl_accel, whirl_accel_angle));
	transition_line_speed += (_line_accel / global.fps_scale);
	var _endpoint_correction = (_line_accel * (global.fps_scale - 1)) / (2 * global.fps_scale);
	var _perc_prog_amount = (transition_line_speed + _endpoint_correction) / 440;
	if (transition_percent < 2)
	{
		transition_percent += (_perc_prog_amount / global.fps_scale);
	}
	if (transition_percent >= 2)
	{
		transition_stage = 2;
		scr_flag_set(1410, 1);
		finish_transition();
		view_visible[1] = false;
		surface_free(surf_view1);
	}
}
if (transition_stage == 2)
{
}
var _cx = camera_get_view_x(view_camera[0]);
var _cy = camera_get_view_y(view_camera[0]);
var _spread = 500;
var _spreadhalf = _spread * 0.5;
var _random = random(_spread);
part_emitter_region(ps, pe, (_cx + 740) - _spreadhalf, _cx + 740 + _spreadhalf, _cy - _spreadhalf, _cy + _spreadhalf + 50, 3, 0);
part_emitter_region(ps2, pe2, 740 - _spreadhalf, 740 + _spreadhalf, 0 - _spreadhalf, 0 + _spreadhalf + 50, 3, 0);
if (_logical_tick)
{
	part_emitter_stream(ps, pe, pt_petal, rate);
	part_emitter_stream(ps2, pe2, pt_petal_whirl, whirl_rate);
}
if (pregen)
{
	pregen = false;
	repeat (round(240 * global.fps_scale))
	{
		part_system_update(ps);
	}
}
line_x = 740;
line_x2 = 740 + _spread;
part_system_update(ps);
part_system_update(ps2);
transition_clock += (1 / global.fps_scale);
");

Apply("gml_Object_obj_savemenu_Step_0", @"buffer -= 1;
if (menuno == 0)
{
	if (xcoord == 2 && buffer < 0)
	{
		if (button1_p())
		{
			xcoord = 99;
			endme = 1;
		}
	}
	if (xcoord < 2)
	{
		if (left_p() || right_p())
		{
			xcoord = !xcoord;
		}
	}
	if (type == 1)
	{
		if (up_p() || down_p())
		{
			if (ycoord == 1)
			{
				ycoord = 0;
			}
			else
			{
				ycoord = 1;
			}
		}
	}
	if (global.darkzone == 0)
	{
		if (ycoord == 1)
		{
			xcoord = 0;
		}
	}
	if (xcoord == 0 && ycoord == 0 && buffer < 0)
	{
		if (button1_p())
		{
			menuno = 1;
			buffer = 3;
			snd_play(snd_select);
		}
	}
	if (button1_p() && xcoord == 1 && ycoord == 0 && buffer < 0)
	{
		endme = 1;
	}
	if (global.darkzone == 1)
	{
		if (button1_p() && xcoord == 0 && ycoord == 1 && buffer < 0)
		{
			global.interact = 1;
			menu = instance_create(0, 0, obj_fusionmenu);
			menu.type = 4;
			endme = 2;
		}
		if (button1_p() && xcoord == 1 && ycoord == 1 && buffer < 0 && haverecruited)
		{
			global.interact = 1;
			menu = instance_create(0, 0, obj_fusionmenu);
			menu.type = 3;
			menu.subtype = recruitsubtype;
			endme = 2;
		}
	}
	else if (button1_p() && ycoord == 1 && buffer < 0)
	{
		snd_play(snd_select);
		menuno = 10;
		buffer = 3;
	}
	if (button2_p() && buffer < 0 && endme == 0)
	{
		endme = 1;
	}
	if (endme == 1)
	{
		global.interact = 0;
		with (obj_mainchara)
		{
			onebuffer = 3;
		}
		instance_destroy();
	}
	if (endme == 2)
	{
		with (obj_mainchara)
		{
			onebuffer = 3;
		}
		instance_destroy();
	}
}
if (menuno == 10)
{
	if (left_p() || right_p())
	{
		quitxcoord = !quitxcoord;
	}
	if (button1_p() && buffer < 0)
	{
		if (quitxcoord == 0)
		{
			snd_play(snd_select);
			menuno = 11;
			quittimer = 0;
		}
		else if (quitxcoord == 1)
		{
			menuno = 0;
			buffer = 3;
			quitxcoord = 0;
		}
	}
	if (button2_p() && buffer < 0)
	{
		menuno = 0;
		buffer = 3;
		quitxcoord = 0;
	}
}
if (menuno == 11)
{
	quittimer += (1 / global.fps_scale);
	if (quittimer == 1)
	{
		snd_free_all();
		var lastfade = instance_create(camerax(), cameray(), obj_fadeout);
		lastfade.fadespeed = 0.05;
		lastfade.x = camerax() - 20;
		lastfade.y = cameray() - 20;
		lastfade.image_xscale *= 3;
		lastfade.image_yscale *= 2;
		lastfade.depth = -900000;
		with (obj_border_controller)
		{
			hide_border(0.05);
		}
	}
	if (quittimer >= 50)
	{
		game_restart_true();
	}
}
");

