		{
			_target_angle -= 360;
		}
		angle = _target_angle;
	}
	time += (0.25 / global.fps_scale);
	if (max_segments >= 1)
	{
		alpha_1 = min(alpha_1 + (0.02 / global.fps_scale), 1);
	}
	if (max_segments >= 2)
	{
		alpha_2 = min(alpha_2 + (0.02 / global.fps_scale), 1);
	}
	if (max_segments >= 3)
	{
		alpha_3 = min(alpha_3 + (0.02 / global.fps_scale), 1);
	}
	w1 = min(w1 + (_wave_modifier / global.fps_scale), 1);
}
");

Apply("gml_Object_obj_ch5_LW20W_vfx_Step_0", @"if (fadecon < 1)
{
	exit;
}
fademarksin += (1 / global.fps_scale);
ominousfademarker1.image_yscale = abs(sin(fademarksin / 60) * 0.05) + 0.85;
ominousfademarker2.image_xscale = abs(sin(fademarksin / 90) * 0.05) + 0.85;
ominousfademarker3.image_xscale = abs(sin(fademarksin / 90) * 0.05) + 0.85;
ominousfademarker3.image_yscale = abs(cos(fademarksin / 90) * 0.05) + 0.85;
");

Apply("gml_Object_obj_ch5_LW20W_white_Step_0", @"_opacity = scr_movetowards(_opacity, _opacity_target, 0.002 / global.fps_scale);
if (!_finished)
{
	if (_opacity >= 1)
	{
