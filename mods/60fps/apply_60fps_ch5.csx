Apply("gml_Object_obj_growtangle_Step_0", @"if (!init)
{
	if ((visible && (maxxscale != 2 || maxyscale != 2) && sprite_index == spr_battlebg_0) || box_function)
	{
		customBox = true;
		sprite_index = spr_battlebg_stretch_hitbox;
		if ((maxxscale % 2) != 0)
		{
			maxxscale = round(maxxscale * 37.5) / 37.5;
		}
		if ((maxyscale % 2) != 0)
		{
			maxyscale = round(maxyscale * 37.5) / 37.5;
		}
		image_xscale = maxxscale / 2;
		image_yscale = maxyscale / 2;
		var _tempxscale = sprite_width;
		var _tempyscale = sprite_height;
		if (box_function)
		{
			box_function();
		}
		else
		{
			var surf = surface_create(sprite_width, sprite_height);
			surface_set_target(surf);
			draw_clear_alpha(c_black, 0);
			draw_sprite_ext(spr_battlebg_stretch, 0, sprite_xoffset, sprite_yoffset, image_xscale, image_yscale, 0, c_white, 1);
			spr_custom_box = sprite_create_from_surface(surf, 0, 0, sprite_width, sprite_height, false, false, sprite_xoffset, sprite_yoffset);
			sprite_index = spr_battlebg_stretch_hitbox;
			surface_reset_target();
			surface_free(surf);
		}
	}
	init = 1;
}
growth = 0;
if (timer < maxtimer && growcon == 1)
{
	growth = 1;
}
if (timer > 0 && growcon == 3)
{
	growth = 1;
}
if (growth == 1)
{
	if (growcon == 1)
	{
		timer += (1 / global.fps_scale);
	}
	if (growcon == 3)
	{
		timer -= (1 / global.fps_scale);
	}
	sizer = timer / maxtimer;
	image_xscale = maxxscale * sizer;
	image_yscale = maxyscale * sizer;
	image_angle = 180 + (180 * (timer / maxtimer)) + target_angle;
	image_alpha = 0.5 + ((timer / maxtimer) * 0.5);
	if (visible && frac(timer) == 0)
	{
		d = instance_create(x, y, obj_afterimage);
		d.sprite_index = spr_custom_box;
		var _scale = sizer * growscale;
		d.image_xscale = _scale;
		d.image_yscale = _scale;
		d.image_angle = image_angle;
		d.depth = depth - 1;
		d.image_blend = image_blend;
		d.image_alpha = (1 - image_alpha) + 0.1;
		d.image_speed = 0;
	}
	if (timer >= maxtimer && growcon == 1)
	{
		growcon = 2;
		image_angle = target_angle;
	}
	if (timer <= 0 && growcon == 3)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_healanim_Step_0", @"t += (1 / global.fps_scale);
if (i_ex(target))
{
	if (t == 1)
	{
		x = target.x;
		y = target.y;
		image_xscale = target.image_xscale;
		image_yscale = target.image_yscale;
		sprite_index = target.sprite_index;
		sw = sprite_width;
		sh = sprite_height;
		herocheck = 0;
		if (target.object_index == obj_herokris)
		{
			herocheck = 1;
		}
		if (target.object_index == obj_herosusie)
		{
			herocheck = 1;
		}
		if (target.object_index == obj_heroralsei)
		{
			herocheck = 1;
		}
		if (target.object_index == obj_flowery_enemy)
		{
			if (target.state == 3 || target.force_hurt_sprite == true)
			{
				sprite_index = spr_flowery_hurt;
			}
		}
		if (herocheck == 1)
		{
			sw = target.mywidth;
			sh = target.myheight;
		}
		with (target)
		{
			flash = scr_oflash();
			if (i_ex(obj_green_egg_heal) && obj_green_egg_heal.target_enemy == ""green"")
			{
				with (flash)
				{
					orange_green_target = ""green"";
				}
			}
			if (object_index == obj_flowery_enemy)
			{
				if (state == 3 || force_hurt_sprite == true)
				{
					sprite_index = spr_flowery_hurt;
				}
			}
		}
	}
	if (t >= 1 && t <= 5 && frac(t) == 0)
	{
		for (i = 0; i < 2; i += 1)
		{
			star[starcount] = instance_create(x + random(sw), y + random(sh), obj_marker);
			with (star[starcount])
			{
				image_angle = random(360);
				depth = -10;
				image_xscale = 2;
				image_yscale = 2;
				image_alpha = 2;
				image_speed = 0.25 / global.fps_scale;
				hspeed = (2 - random(2)) / global.fps_scale;
				vspeed = (-3 - random(2)) / global.fps_scale;
				friction = 0.2 / (global.fps_scale * global.fps_scale);
			}
			star[starcount].sprite_index = particlesprite;
			star[starcount].image_blend = particlecolor;
			starcount += 1;
		}
	}
	if (t >= 5 && t <= 30)
	{
		for (i = 0; i < starcount; i += 1)
		{
			with (star[i])
			{
				image_angle -= (10 / global.fps_scale);
				image_alpha -= (0.1 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy();
				}
			}
		}
		if (t >= 30)
		{
			instance_destroy();
		}
	}
}
else
{
	for (i = 0; i < starcount; i += 1)
	{
		with (star[i])
		{
			instance_destroy();
		}
	}
	instance_destroy();
}
");

