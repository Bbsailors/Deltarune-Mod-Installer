				image_index = random_range(0, 10);
				image_alpha = 2;
				image_xscale = 2;
				image_yscale = 2;
				fadeout_speed = 2 / doomtime;
			}
		};
	}
	with (instance_create_depth(x, y, depth, obj_flowerdie))
	{
		speed = 8;
		amount = 8;
		if (other.wall_smash)
		{
			wall_smash = true;
			spread = 180;
			direction = _wall;
		}
	}
	with (instance_create_depth(x, y, depth, obj_flowerdie))
	{
		speed = 16;
		amount = 32;
		flower_pattern = true;
		if (other.wall_smash)
		{
			wall_smash = true;
			spread = 180;
			direction = _wall;
		}
	}
	instance_destroy();
}
if (!use_image_speed)
{
	image_speed = 0;
	image_index = 0;
}
