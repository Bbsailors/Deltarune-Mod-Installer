	c_var_instance(497, ""aquasprite"", 6800);
	c_var_instance(497, ""aqua_image_speed"", 0.25);
	c_speaker(""aqua"");
	c_msgsetsubloc(0, ""~1* Uuu^1, look^1! They're following^1,~2they're following!/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_verticalwind_slash_Step_0_gml_75_0"");
	c_facenext(""seth"", 0);
	c_msgnextsubloc(""~1* We've got it this time^1, Aqua!/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_verticalwind_slash_Step_0_gml_77_0"");
	c_msgvar_instance(497, ""sethsprite"", 6632);
	c_msgnextsubloc(""~1* Just..^1. use the wind to your~2advantage!/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_verticalwind_slash_Step_0_gml_79_0"");
	c_facenext(""aqua"", 0);
	c_msgnextsubloc(""~1* Uuu^1, okay!/%"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_verticalwind_slash_Step_0_gml_81_0"");
	c_msgvar_instance(497, ""aquasprite"", 2817);
	c_talk_wait();
	c_var_instance(497, ""sethsprite"", 2003);
	c_var_instance(497, ""seth_image_speed"", 0.25);
