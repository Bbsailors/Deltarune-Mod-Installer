Apply("gml_Object_obj_dw_ralsei_castle_basketball_ball_Create_0", @"kick = 0;
autodepth = 0;
fakey = 0;
fakevsp = -16 / global.fps_scale;
grav = 1 / (global.fps_scale * global.fps_scale);
_angle = 0;
solidcheck = 0;
fakeinit = round(120 * global.fps_scale);
depth = 90000;
spd = 8 / global.fps_scale;
direction = 188;

solidMeeting = function(arg0, arg1)
{
	if (!solidcheck)
	{
		return false;
	}
	return place_meeting(arg0, arg1, obj_solidblock) || place_meeting(arg0, arg1, obj_solidenemy);
};
");

Apply("gml_Object_obj_dw_ralsei_castle_basketball_ball_Step_0", @"fakeinit--;
if (fakeinit == 0)
{
	solidcheck = 1;
	autodepth = 1;
}
fakevsp += grav;
fakey += fakevsp;
if (fakey > 0)
{
	kick = 0;
	fakey = 0;
	fakevsp = -abs(fakevsp * 0.8);
}
if (autodepth)
{
	scr_depth();
}
spd = max(spd - (0.05 / (global.fps_scale * global.fps_scale)), 0);
if (spd > 0)
{
	var hsp = lengthdir_x(spd, direction);
	var vsp = lengthdir_y(spd, direction);
	var didbounce = false;
	if (solidMeeting(x + hsp, y))
	{
		while (!solidMeeting(x + sign(hsp), y))
		{
			x += sign(hsp);
		}
		hsp = -hsp;
		didbounce = true;
	}
	else
	{
		x += hsp;
	}
	if (solidMeeting(x, y + vsp))
	{
		while (!solidMeeting(x, y + sign(vsp)))
		{
			y += sign(vsp);
		}
		vsp = -vsp;
		didbounce = true;
	}
	else
	{
		y += vsp;
	}
	if (didbounce)
	{
		direction = point_direction(0, 0, hsp, vsp);
		spd *= 0.8;
	}
}
");

Apply("gml_Object_obj_dw_ralsei_castle_basketball_ball_Step_2", @"if (x < xprevious)
{
	_angle += abs(x - xprevious);
}
if (x > xprevious)
{
	_angle -= abs(x - xprevious);
}
if (!kick)
{
	if (place_meeting(x, y, obj_mainchara))
	{
		var movespd = 0;
		with (obj_mainchara)
		{
			movespd = point_distance(x, y, xprevious, yprevious);
		}
		direction = point_direction(x, y, obj_mainchara.x + 19, obj_mainchara.y + 66) + 180;
		kick = 1;
		var mult = clamp(up_h() + down_h() + right_h() + left_h(), 0, 1);
		fakevsp = (-4 * (mult * 2)) / global.fps_scale;
		spd += movespd;
	}
}
");

Apply("gml_Object_obj_dw_rhythm_scroller_Draw_0", @"if (!init)
{
	exit;
}
draw_set_alpha(banner_alpha);
yy = cameray() + target_ypos;
ossafe_fill_rectangle_color(camerax(), yy - 2, camerax() + view_wport[0], yy, c_yellow, c_yellow, c_yellow, c_yellow, 0);
ossafe_fill_rectangle_color(camerax(), yy, camerax() + view_wport[0], yy + margin_top + 40, c_black, c_black, c_black, c_black, 0);
ossafe_fill_rectangle_color(camerax(), yy + margin_top + 40, camerax() + view_wport[0], yy + margin_top + 40 + 1, c_yellow, c_yellow, c_yellow, c_yellow, 0);
draw_set_color(c_yellow);
draw_set_font(scr_84_get_font(""mainbig""));
text_x_pos[0] += text_speed / global.fps_scale;
if (text_x_pos[0] < -_string_width)
{
	text_x_pos[0] = text_x_pos[1] + _string_width;
}
text_x_pos[1] += text_speed / global.fps_scale;
if (text_x_pos[1] < -_string_width)
{
	text_x_pos[1] = text_x_pos[0] + _string_width;
}
draw_text_ext_transformed(camerax() + text_x_pos[0], yy + margin_top, scrolling_text, 999, 9999, 1, 1, 0);
draw_text_ext_transformed(camerax() + text_x_pos[1], yy + margin_top, scrolling_text, 999, 9999, 1, 1, 0);
draw_set_color(c_white);
draw_set_alpha(1);
");

Apply("gml_Object_obj_dw_rhythm_speakers_Step_0", @"if (!init)
{
	exit;
}
if (buffer < 3)
{
	buffer++;
}
var _bpm_time = (60 / bpm) * 30;
if (_bpm_time < 8)
{
	_bpm_time *= 2;
}
if (song_id == 9)
{
	timer++;
	var _bpm_check = _bpm_time;
	_bpm_time *= 1.5;
	if (timer < (_bpm_check / 2) && (beat == 7 || beat == 19))
	{
		bpm_shift = -_bpm_check / 2;
	}
	if (timer > _bpm_check)
	{
		beat++;
		timer -= _bpm_check;
		if (beat > beat_count)
		{
			beat = 1;
		}
	}
}
var in_zone = point_in_rectangle(obj_mainchara.x + 14, obj_mainchara.y, x - 20 - 14, y + 180, x + 166 + 14, y + 340);
if (!in_zone)
{
	if (symbol.in_range())
	{
		symbol.exit_range();
		_speaker_timer = beat_start;
		scr_lerpvar_instance(id, ""_speaker_x_scale"", _speaker_x_scale, 2, 12, 2, ""out"");
		scr_lerpvar_instance(id, ""_speaker_y_scale"", _speaker_y_scale, 2, 12, 2, ""out"");
		mus_volume(global.currentsong[1], 1, 12);
	}
	if (song_id == 9)
	{
		speaker_con = 2;
	}
	exit;
}
else if (!symbol.in_range())
{
	symbol.enter_range();
	if (buffer <= 2)
	{
		mus_volume(global.currentsong[1], 0, 0);
		scr_debug_print(""funny spawn."");
	}
	else
	{
		mus_volume(global.currentsong[1], 0, 12);
	}
	if (song_id == 9)
	{
		_speaker_timer = timer;
	}
}
debug_print_persistent(id, ""BPM:"" + string(bpm) + "" ("" + string(_bpm_time) + "" frames per beat)"");
_speaker_timer += (1 / global.fps_scale);
if (_speaker_timer >= 1 && speaker_con == 0)
{
	speaker_con = 1;
	_speaker_anim = 0;
	scr_lerpvar_instance(id, ""_speaker_x_scale"", 2.2, 2, 12, 2, ""out"");
	scr_lerpvar_instance(id, ""_speaker_y_scale"", 2.2, 2, 12, 2, ""out"");
}
if (_speaker_timer >= (_bpm_time / 4) && speaker_con == 1)
{
	speaker_con = 2;
	_speaker_anim = 1;
}
if (bpm_shift != 0)
{
	_bpm_time += bpm_shift;
}
if (_speaker_timer >= _bpm_time)
{
	bpm_shift = 0;
	speaker_con = 0;
	_speaker_timer -= _bpm_time;
}
var center_point = (x - 20) + 90;
var player_pos = abs((obj_mainchara.x + 14) - center_point);
var _max_vol = remap(100, 0, 0, 1, player_pos);
_max_vol = clamp01(_max_vol);
if (i_ex(obj_darkphone_event) && (obj_darkphone_event.con >= 2 && obj_darkphone_event.con < 5))
{
	if (!paused)
	{
		paused = true;
	}
	_max_vol = 0;
}
else if (paused)
{
	paused = false;
}
snd_volume(audio_file, _max_vol, 0);
spawn = false;
");

Apply("gml_Object_obj_dw_rhythm_symbol_Draw_0", @"if (_symbol_sprite == -4)
{
	exit;
}
draw_self();
_symbol_anim += (_symbol_anim_speed / global.fps_scale);
draw_sprite_ext(_symbol_sprite, _symbol_anim, x + _symbol_x_offset, y + _symbol_y_offset, _symbol_x_scale, _symbol_y_scale, _symbol_angle, c_white, 1);
draw_set_font(fnt_main);
draw_set_color(c_black);
draw_text_ext_transformed((x - 32) + 2, (y - 6) + 2, _highscore_rank, 999, 999, 3, 3, 0);
draw_set_color(c_yellow);
draw_text_ext_transformed(x - 32, y - 6, _highscore_rank, 999, 999, 3, 3, 0);
draw_set_color(c_black);
draw_text_ext_transformed(x + 62 + 2, (y - 6) + 2, _highscore_rank_hard, 999, 999, 3, 3, 0);
draw_set_color(c_orange);
draw_text_ext_transformed(x + 62, y - 6, _highscore_rank_hard, 999, 999, 3, 3, 0);
");

Apply("gml_Object_obj_dw_rhythm_symbol_Step_0", @"if (_in_range)
{
	_anim_timer += (1 / global.fps_scale);
	if (_assigned_song == UnknownEnum.Value_3)
	{
		if (_anim_timer >= 1 && _anim_timer < 2)
		{
			scr_lerpvar_instance(id, ""_symbol_x_scale"", 3, 2, 12, 2, ""out"");
			scr_lerpvar_instance(id, ""_symbol_y_scale"", 3, 2, 12, 2, ""out"");
		}
		if (_anim_timer >= 15.652173913043478)
		{
			_anim_timer -= 15.652173913043478;
		}
	}
	if (_assigned_song == UnknownEnum.Value_4)
	{
		_symbol_angle += ((sin(_anim_timer / 3.870648215994895) * 8) / global.fps_scale);
	}
}

enum UnknownEnum
{
	Value_3 = 3,
	Value_4
}
");

Apply("gml_Object_obj_dw_transition_Draw_0", @"index += (1 / global.fps_scale);
if (rect_draw == 1)
{
	rs += (1 / global.fps_scale);
	for (i = 0; i < rect_amount; i += 1)
	{
		rsize[i] += 0.25 / global.fps_scale;
		if (quick_mode == 1)
		{
			rsize[i] += 0.25 / global.fps_scale;
		}
		if (rsize[i] > 0)
		{
			r_darkest = 5 - (rsize[i] * 0.8);
			if (rs < 20)
			{
				r_darkest *= (rs / 20);
			}
			if (r_darkest < 0)
			{
				r_darkest = 0;
			}
			if (r_darkest > 1)
			{
				r_darkest = 1;
			}
			r_color = merge_color(c_black, c_white, r_darkest);
			draw_sprite_ext(spr_doorblack, 0, rx + camerax(), ry + cameray(), rw * rsize[i], rh * rsize[i], rsize[i], r_color, 1);
		}
	}
}
if (con == 8)
{
	mus_volume(global.currentsong[1], 0, 30);
	with (obj_mainchara)
	{
		cutscene = 1;
	}
	with (obj_kris_headobj)
	{
		follow = 0;
		depth = obj_dw_transition.depth - 10;
	}
	sus_draw = 1;
	sus_sprite = spr_susieu;
	sus_index = 0;
	kris_sprite = spr_krisu;
	kris_index = 0;
	sus_v = 1.2 / global.fps_scale;
	if (quick_mode == 1)
	{
		sus_v = 2 / global.fps_scale;
	}
	timer = 0;
	con = 9;
	doorblack = 0;
}
if (con == 9)
{
	timer += (1 / global.fps_scale);
	if (quick_mode == 1 || skiprunback == 1)
	{
		if (timer < 40)
		{
			snd_free_all();
			if (skiprunback == 0)
			{
				if (i_ex(obj_darkdoor))
				{
					if (obj_darkdoor.image_index != 1)
					{
						snd_play(snd_locker);
					}
				}
				doorblack = 1;
			}
