	table_marker = scr_marker_fromasset(findsprite(spr_dw_fcastle_shinobeetle_encounter_table, ""NPCs""));
	with (table_marker)
	{
		scr_depth();
	}
	with (obj_castlereflect_manager)
	{
		add_reflection(other.table_marker);
		add_sprite_offset(2129, 2, 0);
		substitute_sprite(2129, 7942);
	}
	with (obj_custom_interactable_solid)
	{
		if (extflag == ""table"")
		{
			trigger_event = function()
			{
				scr_speaker(""yellow"");
				msgsetloc(0, ""* Asgore always shares dirts^1, soils^1, and loams with us./"", ""obj_dw_fcastle_shinobeetle_encounter_slash_Step_0_gml_32_0"");
				msgnextloc(""* Today..^1. we'll return the favor^1. A garden of finest sand.../"", ""obj_dw_fcastle_shinobeetle_encounter_slash_Step_0_gml_33_0"");
				msgnextloc(""* The perfect day-byu for a Cowboy's show./%"", ""obj_dw_fcastle_shinobeetle_encounter_slash_Step_0_gml_34_0"");
				myinteract = 3;
				global.interact = 1;
				mydialoguer = instance_create(0, 0, obj_dialoguer);
			};
			
			shine = scr_dark_marker(x + 20, y + 20, spr_shine_white);
			shine.image_speed = 0.08 / global.fps_scale;
			with (shine)
			{
				scr_depth(self, 30);
			}
		}
	}
}
");

Apply("gml_Object_obj_dw_fcastle_sidepuzzle_Step_0", @"if (!init)
{
	init = 1;
	with (obj_castlereflect_manager)
	{
		add_reflection(other.npc_sign_right.marker);
	}
	with (obj_plat_antisoftlock_zone)
	{
		conversation = 1;
		
		on_softlock_detected = function()
		{
			with (obj_dw_fcastle_sidepuzzle)
			{
				if (stuckcon == 0)
				{
					stuckcon = 1;
					stucktimer = 0;
				}
			}
		};
		
		on_exit_softlock_zone = function()
		{
			with (obj_dw_fcastle_sidepuzzle)
			{
				if (stuckcon == 2)
				{
					stuckcon = 3;
					stucktimer = 0;
				}
			}
		};
	}
	with (obj_plat_stringed_object)
	{
		if (extflag == ""signery"")
		{
			on_hit = function()
			{
				snd_play_flowery(679);
				obj_dw_fcastle_sidepuzzle.signcon = 1;
				obj_dw_fcastle_sidepuzzle.sign_x = x;
				obj_dw_fcastle_sidepuzzle.sign_y = y;
				broken = true;
				with (attached_object)
				{
					instance_destroy();
				}
			};
		}
	}
	var signery_state = 0;
	if (scr_flag_get_ext(_ROOM_FLAG, _BIT_SIGNERY, 1))
	{
		signery_state = 1;
	}
	if (signery_state != 0)
	{
		with (obj_plat_stringed_object)
		{
			if (extflag == ""signery"")
			{
				broken = true;
				with (attached_object)
				{
					instance_destroy();
				}
			}
		}
		if (!scr_flag_get_ext(_ROOM_FLAG, _BIT_SIGN_EXPLODED))
		{
			with (npc_sign_right)
			{
				marker.visible = true;
				scr_delay_var(""x"", x, 3);
			}
		}
	}
}
if (stuckcon == 1)
{
	if (!global.pause_plat)
	{
		stucktimer++;
		if (stucktimer == round(60 * global.fps_scale))
		{
			stuckcon = 2;
			stucktimer = 0;
			with (obj_plat_block)
			{
				if (extflag == ""shadowplatform"" || extflag == ""shadowplatform_malleable"")
				{
					mask_index = spr_plat_blankmask;
				}
			}
			with (obj_shadowplatformController)
			{
				scr_lerpvar(""plat_alpha"", 1, 0.3, 5);
