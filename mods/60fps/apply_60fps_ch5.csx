	point_foot_left = [120 + lengthdir_x(90, 255), 120 + lengthdir_y(90, 255)];
	point_foot_right = [120 + lengthdir_x(90, 285), 120 + lengthdir_y(90, 285)];
	point_knee_left = [0, 0];
	point_knee_right = [0, 0];
	point_torso = [point_center[0], point_center[1] - 30];
	point_head = [point_torso[0], point_torso[1]];
	point_shoulder_right = [point_torso[0], point_torso[1]];
	point_shoulder_left = [point_torso[0], point_torso[1]];
	point_hand_right = [0, 0];
	point_hand_left = [0, 0];
	point_ass_right = [0, 0];
	point_ass_left = [0, 0];
