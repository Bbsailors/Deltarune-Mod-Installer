Apply("gml_Object_obj_writer_Draw_0", @"if (image_alpha == 0)
{
	exit;
}
button1 = 0;
button2 = 0;
button3 = 0;
miniface_drawn = -1;
if (button1_p() == 1 && prevent_mash_buffer <= 0)
{
	button1 = 1;
}
if (button2_h() == 1 && prevent_mash_buffer <= 0)
{
	button2 = 1;
}
if (global.flag[10] == 1 || scr_debug())
{
	var noskip = preventcskip;
	if (button3_p())
	{
		noskip = false;
	}
	if (!noskip)
	{
		if (button3_h() == 1)
		{
			prevent_mash_buffer = 3;
			if (automash_timer == 0)
			{
				automash_timer = 1;
			}
			else
			{
				automash_timer = 0;
			}
			if (automash_timer == 0)
			{
				button1 = 1;
			}
			if (automash_timer == 1)
			{
				button2 = 1;
			}
		}
	}
}
rainbowtimer += (1 / global.fps_scale);
if (disablebutton1)
{
	button1 = 0;
}
if (disablebutton2)
{
	button2 = 0;
}
if (forcebutton1)
{
	button1 = 1;
}
prevent_mash_buffer--;
if (pinkballoonid != -1 && pinkballoonid.sprite_index == spr_pink_balloon2)
{
	writingx = pinkballoonid.extrax + 8;
	writingy = pinkballoonid.extray + 5;
}
if (dialoguer == 1 && formatted == 0)
{
	if (global.fc == 0)
	{
		charline = originalcharline;
		writingx = x;
	}
	else
	{
		charline = 26;
		writingx = x + (58 * f);
	}
	charline += charline_bonus;
	if (instance_exists(obj_dialoguer))
	{
		if (obj_dialoguer.zurasucon == 2)
		{
			var _camerax = camerax();
			writingx = _camerax + obj_dialoguer.remwriterx;
			if (global.fc > 0)
			{
				writingx = _camerax + obj_dialoguer.remwriterx + (58 * f);
			}
		}
	}
	if (instance_exists(obj_dialoguer_plat))
	{
		if (obj_dialoguer_plat.zurasucon == 2)
		{
			var _camerax = camerax();
			writingx = _camerax + obj_dialoguer_plat.remwriterx;
			if (global.fc > 0)
			{
				writingx = _camerax + obj_dialoguer_plat.remwriterx + (58 * f);
			}
		}
	}
}
if (formatted == 0)
{
	event_user(5);
}
accept = 0;
wx = writingx;
wy = writingy;
colorchange = 0;
draw_set_font(myfont);
draw_set_color(mycolor);
if (fadeonend != 0)
{
	if (reachedend == 1)
	{
		textalphagain = -abs(fadeonend);
		if (textalpha <= 0)
		{
			instance_destroy();
		}
	}
}
if (textalphagain != 0)
{
	textalpha = clamp(textalpha + textalphagain, 0, 1);
}
if (textalpha != 1)
{
	draw_set_alpha(textalpha);
}
if (runcheck)
{
	if ((!button2_h() && !button2_p()) || button3_h() || button3_p())
	{
		runcheck = false;
	}
}
if (halt == 0 && button2 == 1 && pos < length && skippable == 1 && !runcheck)
{
	skipme = 1;
}
if (i_ex(obj_battlecontroller))
{
	charline = 37;
}
if (i_ex(obj_battlecontroller) && i_ex(obj_face))
{
	charline = 29;
}
if (skipme == 1 && (global.flag[965] == 1 || (global.time % global.fps_scale) == 0))
{
	pos = string_length(mystring) + 1;
	reachedend = 1;
	alarm[0] = -1;
	alarm[1] = -1;
}
for (n = 1; n < pos; n += 1)
{
	accept = 1;
	mychar = string_char_at(mystring, n);
	if (mychar == ""`"")
	{
		n++;
		mychar = string_char_at(mystring, n);
	}
	else if (mychar == ""&"" || mychar == ""\n"")
	{
		accept = 0;
		wx = writingx;
		if (wxskip == 1)
		{
			wx = writingx + 58;
		}
		wy += vspace;
	}
	else if (mychar == ""|"")
	{
		accept = 0;
		wx += hspace;
	}
	else if (mychar == ""^"")
	{
		accept = 0;
		n += 1;
	}
	else if (mychar == ""/"")
	{
		halt = 1;
		if (string_char_at(mystring, n + 1) == ""%"")
		{
			halt = 2;
		}
		reachedend = 1;
		accept = 0;
	}
	else if (mychar == ""%"")
	{
		accept = 0;
		if (string_char_at(mystring, n - 1) == ""/"")
		{
			halt = 2;
		}
		if (string_char_at(mystring, n + 1) == ""%"")
		{
			instance_destroy();
		}
		else if (halt != 2)
		{
			global.voiceclipmode = 0;
			scr_nextmsg();
			scr_set_floweryvoicemode(mystring);
		}
	}
	else if (mychar == ""\\"")
	{
		nextchar = string_char_at(mystring, n + 1);
		nextchar2 = string_char_at(mystring, n + 2);
		if (nextchar == ""E"")
		{
			__nextface = ord(nextchar2);
			if (__nextface >= 48 && __nextface <= 57)
			{
				global.fe = real(nextchar2);
			}
			else if (__nextface >= 65 && __nextface <= 90)
			{
				global.fe = __nextface - 55;
			}
			else if (__nextface >= 97 && __nextface <= 122)
			{
				global.fe = __nextface - 61;
			}
		}
		if (nextchar == ""F"")
		{
			if (nextchar2 == ""0"")
			{
				global.fc = 0;
			}
			if (nextchar2 == ""S"")
			{
				global.fc = 1;
			}
			if (nextchar2 == ""R"")
			{
				global.fc = 2;
			}
			if (nextchar2 == ""N"")
			{
				global.fc = 3;
			}
			if (nextchar2 == ""T"")
			{
				global.fc = 4;
			}
			if (nextchar2 == ""L"")
			{
				global.fc = 5;
			}
			if (nextchar2 == ""s"")
			{
				global.fc = 6;
			}
			if (nextchar2 == ""A"")
			{
				global.fc = 10;
			}
			if (nextchar2 == ""a"")
			{
				global.fc = 11;
			}
			if (nextchar2 == ""B"")
			{
				global.fc = 12;
			}
			if (nextchar2 == ""b"")
			{
				global.fc = 19;
			}
			if (nextchar2 == ""r"")
			{
				global.fc = 15;
			}
			if (nextchar2 == ""u"")
			{
				global.fc = 18;
			}
			if (nextchar2 == ""U"")
			{
				global.fc = 9;
			}
			if (nextchar2 == ""K"")
			{
				global.fc = 20;
			}
			if (nextchar2 == ""Q"")
			{
				global.fc = 21;
			}
			if (nextchar2 == ""C"")
			{
				global.fc = 22;
			}
			if (nextchar2 == ""F"")
			{
				global.fc = 23;
			}
			if (nextchar2 == ""f"")
			{
				global.fc = 24;
			}
			if (nextchar2 == ""J"")
			{
				global.fc = 14;
			}
			if (nextchar2 == ""y"")
			{
				global.fc = 17;
			}
			if (nextchar2 == ""i"")
			{
				global.fc = 13;
			}
			if (nextchar2 == ""k"")
			{
				global.fc = 16;
			}
			if (dialoguer == 1)
			{
				if (global.fc == 0)
				{
					charline = originalcharline;
					wx = x;
				}
				else
				{
					charline = 26;
					wx = x + (58 * f);
				}
			}
			charline += charline_bonus;
		}
		if (nextchar == ""f"" && faced == 0)
		{
			fam = 0;
			fam = real(nextchar2);
			if (!i_ex(global.sminstance[fam]))
			{
				global.sminstance[fam] = instance_create(global.smxx[fam], global.smyy[fam], obj_smallface);
				smallface = global.sminstance[fam];
				if (i_ex(smallface))
				{
					smallface.remx = smallface.x;
					smallface.remy = smallface.y;
					smallface.x += x;
					smallface.y += y;
					smallface.speed = global.smspeed[fam] / global.fps_scale;
					smallface.direction = global.smdir[fam];
					smallface.type = global.smtype[fam];
					smallface.sprite_index = global.smsprite[fam];
					smallface.image_speed = global.smimagespeed[fam] / global.fps_scale;
					smallface.image_index = global.smimage[fam];
					smallface.alarm[0] = round(global.smalarm[fam] * global.fps_scale);
					smallface.mystring = global.smstring[fam];
					smallface.mycolor = global.smcolor[fam];
					smallface.shake = global.smshake[fam];
					smallface.writergod = id;
				}
			}
		}
		if (nextchar == ""*"")
		{
			if (replace_round_with_floor)
			{
				wx = floor(wx);
			}
			else
			{
				wx = round(wx);
			}
			var _sprite = scr_getbuttonsprite(nextchar2, true);
			var y_offset = 0;
			var x_offset = 0;
			if (global.typer == 50 || global.typer == 70 || global.typer == 71)
			{
				x_offset = -3;
				y_offset = -9;
			}
			var __y = 0;
			if (global.chapter == 5 && i_ex(obj_flowery_enemy) && i_ex(obj_battleblcon) && obj_battleblcon.flowery_float == true)
			{
				__y = sin(obj_flowery_enemy.float_siner * 0.33) * 5;
