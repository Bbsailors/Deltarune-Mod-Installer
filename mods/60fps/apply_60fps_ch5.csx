	}
	if (scr_flag_get_ext(_ROOM_STATE_FLAG, _PUZZLE_SOLVED_BIT))
	{
		with (obj_floorswitch)
		{
			pressed = true;
			image_index = 1;
		}
		with (obj_terracotta_stationary_overworld)
		{
			y -= 60;
			puzzle_locked = true;
			image_blend = c_gray;
			block.y -= 60;
			interact.y -= 60;
			scr_depth(id, -80);
		}
		with (obj_solidblocksized_alt)
		{
			instance_destroy();
		}
		with (obj_spotlight_blocker)
		{
			if (x >= 1000)
			{
				instance_destroy();
			}
		}
		with (obj_castlereflect_manager)
		{
			refresh_masking_surf();
		}
		layer_set_visible(layer_get_id(""TILES_Shortcut""), true);
		con = 2;
	}
	with (obj_mainchara)
	{
		if (x > 600)
		{
			with (obj_doorAny)
			{
				if (x < 600)
				{
					doorFadeMusic = true;
				}
			}
		}
		else
		{
			with (obj_doorAny)
			{
				if (x > 600)
				{
					doorFadeMusic = true;
				}
			}
		}
	}
}
if (con == 0)
{
	var allpressed = true;
	with (obj_floorswitch)
	{
		if (!pressed)
		{
			allpressed = false;
			break;
		}
	}
	if (allpressed)
	{
		con = 1;
	}
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer == 30)
	{
		con = 2;
		snd_play(snd_locker);
		scr_shakescreen();
		with (obj_solidblocksized_alt)
		{
			instance_destroy();
		}
		with (obj_spotlight_blocker)
		{
			if (x >= 1000)
			{
				instance_destroy();
			}
		}
		with (obj_castlereflect_manager)
		{
			refresh_masking_surf();
		}
		layer_set_visible(layer_get_id(""TILES_Shortcut""), true);
		scr_flag_set_ext(_ROOM_STATE_FLAG, _PUZZLE_SOLVED_BIT, 1);
	}
}
