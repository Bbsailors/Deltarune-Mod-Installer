attack_override = function()
{
	if (!obj_plat_player.grounded)
	{
		return true;
	}
	if (obj_plat_player.image_xscale > 2)
	{
		return true;
	}
	global.interact = 1;
	if (fistbumpcon == 0)
	{
		fistbumpcon = 1;
		fistbumptimer = 0;
	}
	return false;
};

seth_bubble = -4;

make_seth_bubble = function(arg0, arg1, arg2, arg3)
{
	with (seth_bubble)
	{
		instance_destroy();
	}
	seth_bubble = scr_messagebubble(arg0, arg1, arg2, arg3, -2);
	seth_bubble.tx = seth_bubble.x;
	seth_bubble.ty = seth_bubble.y;
	seth_bubble.depth = 50000;
	seth_bubble.parallax_depth = 0;
	seth_bubble.dropColor = merge_color(c_fuchsia, c_black, 0.25);
	seth_bubble.textbubbleColor = merge_color(c_fuchsia, c_white, 0.75);
};

make_orange_bubble = function(arg0, arg1 = true, arg2 = -4)
{
	var target = -4;
	with (obj_orange_puppet)
	{
		if (image_alpha > 0.1)
		{
			target = self;
			break;
		}
	}
	if (target == -4 && arg2 == -4)
	{
		exit;
	}
	with (orange_bubble)
	{
		instance_destroy();
	}
	orange_bubble = scr_messagebubble(arg0, target.x, target.y, target, -2);
	orange_bubble.depth = target.depth - 1000;
	orange_bubble.parallax_depth = target.parallax * 0.25 * arg1;
	orange_bubble.dropColor = merge_color(c_orange, c_black, 0.25);
	orange_bubble.textbubbleColor = merge_color(c_orange, c_white, 0.75);
	if (arg2 != -4)
	{
		with (orange_bubble)
		{
			x = arg2.x;
			y = arg2.y;
			tx = arg2.x;
			ty = arg2.y;
		}
	}
};

orangebub = function(arg0, arg1 = 
{
	x: x,
	y: y
}, arg2 = false)
{
	with (orange_bubble)
	{
		instance_destroy();
	}
	orange_bubble = scr_messagebubble(arg0, arg1.x, arg1.y, id, -2);
	orange_bubble.depth = arg2 ? (obj_orange_puppet.depth - 1000) : 5000;
	orange_bubble.dropColor = merge_color(c_orange, c_black, 0.25);
	orange_bubble.textbubbleColor = merge_color(c_orange, c_white, 0.75);
	with (orange_bubble)
	{
		tx = x;
		ty = y;
	}
};

spawn_aqua_petals = function(arg0, arg1, arg2, arg3 = 1)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = (0.125 / global.fps_scale) * choose(1, 0.5, 0.75);
		if (obj_dw_fcastle_obscured_bullets.npc_aqua.con == 3)
		{
			image_blend = merge_color(c_aqua, c_black, 0.5);
		}
		else
		{
			image_blend = c_aqua;
		}
		scr_darksize();
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		gravity_direction = 270;
		ys = random_range(0.15, 0.25) * arg3;
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

blast_seth_aqua_offscreen = function()
{
	with (npc_seth)
	{
		con = 10;
		hspeed = 7 / global.fps_scale;
		vspeed = -4 / global.fps_scale;
		scr_doom(self, 60);
		entity_gravity = 1;
		wallcollision = 0;
		physics = 0;
		force_animation(3890);
	}
	with (npc_aqua)
	{
		con = 10;
		hspeed = 5 / global.fps_scale;
		vspeed = -6 / global.fps_scale;
		scr_doom(self, 60);
		entity_gravity = 1;
		wallcollision = 0;
		physics = 0;
		force_animation(4562);
	}
};

