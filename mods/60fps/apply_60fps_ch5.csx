	gpu_set_fog(false, c_black, 0, 1);
}
var _flowerframe = flowerspin + (scr_loop(rotation, 360) / 10);
draw_sprite_ext(flower[hero], _flowerframe, x, y + _yoff, image_xscale, image_yscale, 0, c_white, 1);
draw_self_offset((-xoff * image_xscale) / 2, (-yoff * image_yscale) / 2);
