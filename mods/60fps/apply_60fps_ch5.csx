			with (obj_multiboss_enemy2)
			{
				global.actsimulsus[myself][2] = 1;
			}
			with (obj_multiboss_enemy3)
			{
				global.actsimulsus[myself][2] = 1;
			}
			actcon = 1;
			actconsus = 0;
		}
		else
		{
			if (simultotal == 1)
			{
				msgset(0, ""* Susie made an offensive flatter!/%"");
				scr_battletext_default();
			}
			else
			{
