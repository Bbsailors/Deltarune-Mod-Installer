	if (room == room_dw_teevie_stealth_d && global.flag[1230] == 2)
	{
		stealthspeed = 24;
	}
	stealthtimer += (1 / global.fps_scale);
	if (stealthtimer > 6)
	{
		stealthtimer = 6;
	}
	kris.bwspeed = max(2, (stealthspeed * stealthtimer) / 6) / global.fps_scale;
	kris.wspeed = max(2, (stealthspeed * stealthtimer) / 6) / global.fps_scale;
	lerpstrength = lerp(lerpstrength, 0.5, scr_fps_lerp_rate(0.2));
	if (global.interact == 0 || alert)
	{
