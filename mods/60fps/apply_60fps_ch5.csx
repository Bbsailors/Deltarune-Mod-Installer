Apply("gml_Object_obj_dw_garden_finalplatforming_right_Step_0", @"if (!init)
{
	init = 1;
	var musname = mus_get_name();
	if (musname != ""piano_ambience.ogg"")
	{
		if (musname != """")
		{
			snd_free(global.currentsong[0]);
		}
		global.currentsong[0] = snd_init(""piano_ambience.ogg"");
		global.currentsong[1] = mus_loop_ext(global.currentsong[0], 1, 1);
	}
	else
	{
		snd_volume(global.currentsong[1], 1, 0);
	}
}
if (!instance_exists(obj_plat_player))
{
	exit;
}
if (do_plat_dialogue)
{
	platcon = 1;
	do_plat_dialogue = false;
	scr_flag_set_ext(roomflag, platformtransformed_bit, 1);
}
if (global.pause_plat)
{
	exit;
}
if (platcon == 1 && scr_trigcheck_ext(""plat_dialogue"", 912))
{
	platcon = 2;
}
if (platcon == 2)
{
	if (!obj_plat_player.grounded)
	{
		plattimer += (1 / global.fps_scale);
	}
	if (plattimer == 8)
	{
		scr_speaker(""ralsei"");
		msgsetsubloc(0, ""\\EH* Now we can jump up that room to the LEFT!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_38_0"");
		d_make_plat(0, 1);
		plattimer = 9;
		with (obj_plat_follower)
		{
			if (name == ""ralsei"")
			{
				caterpillarmode = 0;
				state = 1;
				followtarget = ""ramove1"";
			}
		}
	}
	if (plattimer >= 200 && !d_plat_exists(1))
	{
		platcon = 3;
		scr_speaker(""ralsei"");
		msgsetsubloc(0, ""\\EK* Guys?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_54_0"");
		scr_anyface_next(""susie"", ""L"");
		msgnextsubloc(""\\EL* Dude^1, we're doing our jumps."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_56_0"");
		scr_anyface_next(""ralsei"", ""X"");
		msgnextsubloc(""\\EX* We can do that in the left room..."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_58_0"");
		scr_anyface_next(""susie"", ""L"");
		msgnextsubloc(""\\EL* Yeah but we're in this room."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_60_0"");
		scr_anyface_next(""ralsei"", ""J"");
		msgnextsubloc(""\\EJ* Good point?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_finalplatforming_right_slash_Step_0_gml_62_0"");
		d_make_plat(0, 1);
	}
}
