	var cy = clamp((pos[1] - 240) + 160, 0, room_height - 480);
	scr_pan_lerp(cx, cy, walktime);
	snd_play(snd_wing);
	var jumpstrength = 24;
	with (obj_caterpillarchara)
	{
		visible = 0;
		if (name == ""susie"")
		{
			var pos2 = [pos[0] - 30, pos[1]];
			scr_delay_var(""x"", pos2[0], 16);
