on_wave_end = function()
{
	current_wave_index++;
	cutscenecon = 3;
};

start_next_wave = function()
{
	with (obj_enemy_wave)
	{
		if (extflag == other.waves[other.current_wave_index])
		{
			start_wave();
			on_wave_end = other.on_wave_end;
		}
	}
};

spawn_aqua_petals = function(arg0, arg1, arg2, arg3 = 1, arg4 = 0)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = (0.125 / global.fps_scale) * choose(1, 0.5, 0.75);
		image_blend = merge_color(c_aqua, c_black, 0.5 + (0.5 * arg4));
		scr_darksize();
		image_xscale *= lerp(1, 0.5, arg4);
		image_yscale *= lerp(1, 0.5, arg4);
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		gravity_direction = 270;
		ys = random_range(0.15, 0.25) * arg3;
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

