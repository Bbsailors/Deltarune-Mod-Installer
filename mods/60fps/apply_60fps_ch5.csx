with (obj_plat_sinerbullet)
{
	if (move_pattern == 2 && amp == 140)
	{
		if (!variable_instance_exists(id, ""cooldown""))
		{
			cooldown = 0;
		}
		cooldown--;
		if (cooldown < 0 && (y < (ystart - 130) || y > (ystart + 130)) && scr_onscreen(self))
		{
			cooldown = round(3 * global.fps_scale) - 1;
			with (other)
			{
				cut_grass_particle_system.x = other.x;
				cut_grass_particle_system.y = other.y;
				cut_grass_particle_system.depth = other.depth;
				cut_grass_struct.hspeed = random_range(-4, 4);
				cut_grass_struct.vspeed = random_range(-1, -5);
				cut_grass_struct.image_angle = random_range(-135, -45);
				cut_grass_particle_system.emit(cut_grass_struct);
			}
		}
	}
}
");

Apply("gml_Object_obj_dw_fcastle_gloves_tower_Step_0", @"if (!init)
{
	init = 1;
	if (global.flag[1455] >= 30)
	{
		with (obj_doorAny)
		{
			if (doorRoom == room_dw_fcastle_second_diner)
			{
				doorEntrance = 9;
			}
		}
	}
	if (global.flag[1455] >= 29)
	{
		with (obj_orange_puppet)
		{
			instance_destroy();
		}
	}
	if (bubble_con == 0)
	{
		with (obj_orange_puppet)
		{
			visible = false;
		}
	}
	else if (is_proud)
	{
		with (obj_orange_puppet)
		{
			visible = true;
			image_alpha = 0;
			with (puppet)
			{
				x = 108;
				y = 150;
				image_xscale = 0.28;
				image_yscale = 0.2;
				angle = 8;
				targx = 108;
				targy = 126;
				targxscale = 0.25;
				targyscale = 0.25;
				targangle = 0;
				xscalelerp = 0.12;
				yscalelerp = 0.5;
			}
			animinit = 0;
			puppetmovement = 2;
			preset = 11;
		}
	}
	else
	{
		with (obj_orange_puppet)
		{
			visible = true;
			image_alpha = 0;
			with (puppet)
			{
				x = 20;
				y = 220;
				targx = 120;
				targy = 84;
				targxscale = 0.35;
				targyscale = 0.4;
				targangle = -20;
				xscalelerp = 0.2;
				yscalelerp = 0.2;
			}
			animinit = 0;
			puppetmovement = 2;
			preset = 8;
		}
	}
	with (obj_plat_lantern)
	{
		on_destroy = function()
		{
			with (obj_dw_fcastle_gloves_tower)
			{
				if (other.y < 1500)
				{
					top_lanterns_destroyed++;
					scr_flag_set_ext(1320, TOP_LANTERNS_BIT, top_lanterns_destroyed, 3);
				}
			}
		};
	}
}
