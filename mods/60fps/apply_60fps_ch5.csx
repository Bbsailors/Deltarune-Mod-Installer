Apply("gml_Object_obj_enemy_blue_boxspin_Step_2", @"if (timer >= 24)
{
	if (mode == 0 || sin_counter < (wobble_speed + 1))
	{
		if (mode == 0)
		{
			x = obj_growtangle.x - 50;
		}
		y = scr_get_box(1) - 132;
	}
	if (sin_counter < (wobble_speed + 1))
	{
		var old_tangy = obj_growtangle.y;
		obj_growtangle.y = grow_y + (sin(sin_counter * (pi / wobble_speed)) * sin_multiplier * wobble_speed);
		var cur_tangy = obj_growtangle.y;
		with (obj_heart)
		{
			y += (cur_tangy - old_tangy);
			x = clamp(x, scr_get_box(2) + 10, scr_get_box(0) - 30);
			y = clamp(y, scr_get_box(1) + 10, scr_get_box(3) - 30);
		}
		with (obj_attack_blue_dancer_bullet)
		{
			y += (cur_tangy - old_tangy);
		}
		sin_counter += (1 / global.fps_scale);
		sin_multiplier = scr_approach(sin_multiplier, 0, 1 / wobble_speed);
	}
}
");

