		anchorx = x;
		anchory = y;
		movedir = other.image_xscale;
		start_angle = 360 + ((idx / count) * 360);
		radius = other.custom_prop1;
		radius_mult = 1;
		if ((direction % 180) == 0)
		{
			y = anchory + lengthdir_y(radius * radius_mult, start_angle);
		}
		else
		{
			x = anchorx + (lengthdir_x(radius * radius_mult, start_angle) * movedir);
		}
	}
	else if (other.bullet_step_type == 9)
	{
		grav = other.custom_prop1 / (global.fps_scale * global.fps_scale);
		timer = 0;
		
		step_func = function()
		{
			vspeed += grav;
		};
	}
}
if (axis_flip_limit > 0 && (bullet_count % axis_flip_limit) == 0)
{
	image_xscale *= -1;
}
");

