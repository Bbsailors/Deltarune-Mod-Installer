draw_prev = false;
scr_size(16, 40);
bbox = 
{
	x1: bbox_left,
	x2: bbox_right,
	y1: bbox_top,
	y2: bbox_bottom
};
siner = 0;
breakable = false;
boxbot = obj_debug_orangeheartcontroller.boxbot;
boxtop = obj_debug_orangeheartcontroller.boxtop;

doparts = function()
{
	var cnt = 8;
	for (var i = 0; i < cnt; i++)
	{
		with (scr_marker_centered_frominstance(id))
		{
			sprite_index = spr_circle_256_aa;
			scr_sizeexact(random_range(4, 16), random_range(8, 16));
			hspeed = random_range(-16, 6) / global.fps_scale;
			vspeed = (random(8) * choose(-1, 1) * 2) / global.fps_scale;
			friction = 0.5 / (global.fps_scale * global.fps_scale);
			orangeheartControlled = true;
			image_angle = random(360);
			scr_doom(id, 8);
			scr_lerpvar(""image_alpha"", 1, 0, 8);
		}
	}
};

breakup = function()
{
	var cnt = 4;
	for (var i = 0; i < cnt; i++)
	{
		with (scr_marker_centered_frominstance(id))
		{
			sprite_index = spr_circle_256_aa;
			scr_sizeexact(random_range(4, 16), random_range(8, 16));
			image_xscale *= 0.5;
			image_yscale *= 0.5;
			hspeed = random_range(-8, 3) / global.fps_scale;
			vspeed = (random(8) * choose(-1, 1) * 1) / global.fps_scale;
			friction = 0.5 / (global.fps_scale * global.fps_scale);
			orangeheartControlled = true;
			image_angle = random(360);
			var lifetime = 6;
			scr_doom(id, lifetime);
			scr_lerpvar(""image_alpha"", 1, 0, lifetime);
		}
	}
};

do_hit_event = function()
{
	var hit_length = obj_orangeheart.y - y;
	var a1 = hit_length;
	var a2 = image_yscale - a1;
	if (i_ex(obj_flowery_enemy))
	{
		scr_tensionheal(3.75 * obj_flowery_enemy.moar_tension);
	}
	with (instance_create(x, y, obj_marker))
	{
		hspeed = (7 + random(2)) / global.fps_scale;
		sprite_index = spr_pxwhite;
		depth = other.depth - 1;
		image_blend = merge_color(c_aqua, c_blue, 0.5);
		scr_size(other.image_xscale, a1);
		image_angle = 0;
		orangeheartControlled = true;
		gravity_direction = 270;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		vspeed = (-6 - random(4)) / global.fps_scale;
		scr_lerpvar(""image_xscale"", image_xscale, image_xscale * (0.75 + random(0.25)), 12);
		scr_lerpvar(""image_angle"", 0, 30 + random(20), 12, 1, ""out"");
		scr_doom(id, 12);
		scr_lerpvar(""image_alpha"", 1, 0, 12);
	}
	with (instance_create(x, y + image_yscale, obj_marker))
	{
		hspeed = (7 + random(2)) / global.fps_scale;
		sprite_index = spr_pxwhite;
		depth = other.depth - 1;
		image_blend = merge_color(c_aqua, c_blue, 0.5);
		scr_size(other.image_xscale, a2);
		image_angle = 180;
		orangeheartControlled = true;
		gravity_direction = 270;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		vspeed = (-6 - random(4)) / global.fps_scale;
		scr_lerpvar(""image_xscale"", image_xscale, image_xscale * (0.75 + random(0.25)), 12);
		scr_lerpvar(""image_angle"", 180, 150 - random(20), 12, 1, ""out"");
		scr_doom(id, 12);
		scr_lerpvar(""image_alpha"", 1, 0, 12);
	}
	if (do_bullets)
	{
		var cnt = 6;
		var _rand = random_range(-4, 4);
		var _which = irandom(2);
		for (var i = 5; i < cnt; i++)
		{
			var xloc = x + 15;
			var yloc = y + (image_yscale * 0.5);
			with (instance_create_depth(xloc, yloc + irandom_range(-20, 20), other.depth - 1, obj_orangeheart_wall))
			{
				sprite_index = spr_spinning_petal;
				image_speed = 1 / global.fps_scale;
				image_xscale = 1.5;
				image_yscale = 2;
				draw_prev = true;
				hsp = (26 + (i * 3)) / global.fps_scale;
				fakehgrav = -0.75 / (global.fps_scale * global.fps_scale);
				if (irandom(1))
				{
					vsp = (_rand * 20 * choose(-1, 1)) / global.fps_scale;
				}
				else
				{
					vsp = (_rand * 20 * choose(-1, 1)) / global.fps_scale;
				}
				scr_lerpvar(""vsp"", vsp * 0.25, 0, 60);
				inboundsonly = true;
			}
		}
	}
	with (obj_debug_orangeheartcontroller)
	{
		if (difficulty == 0 && attacktype == 0 && wall_tutorial_counter < 4)
		{
			wall_tutorial_counter += 2;
			if (wall_tutorial_counter == 4)
			{
				global.turntimer = 9999;
				timer = 14;
			}
			else
			{
				timer = 30;
			}
		}
	}
};

if (i_ex(obj_flowery_enemy))
{
	target = obj_flowery_enemy.target;
	damage = obj_flowery_enemy.damage;
}
");

Apply("gml_Object_obj_orangeheart_wall_Step_0", @"if (orangeheartControlled)
{
	if (x > (camerax() + camerawidth() + 32))
	{
		exit;
	}
}
var controller = 745;
siner += (1 / global.fps_scale);
bouncebuffer -= (1 / global.fps_scale);
if (deathcon == 0 && !controller.hitstop)
{
	bbox = 
	{
		x1: bbox_left,
		x2: bbox_right,
		y1: bbox_top,
		y2: bbox_bottom
	};
	var dashing = obj_orangeheart.dashing;
	var collide = -4;
	if (isball)
	{
		collide = collision_ellipse(bbox.x1, bbox.y1, bbox.x2, bbox.y2, obj_orangeheart, false, true);
	}
	else
	{
		collide = collision_rectangle(bbox.x1, bbox.y1, bbox.x2, bbox.y2, obj_orangeheart, false, true);
	}
	collide_timer += (1 / global.fps_scale);
	if (sprite_index == spr_spinning_petal)
	{
		if (can_collide)
		{
			image_blend = c_white;
		}
		else
		{
			image_blend = c_gray;
		}
	}
	if (collide_timer >= 10 && !can_collide)
	{
		can_collide = true;
	}
	var _height = 0;
	with (obj_orangeheart)
	{
		_height = height;
	}
	if (!_height)
	{
		if (can_collide)
		{
			if (instance_exists(collide))
			{
				if (obj_orangeheart.dashing && breakable)
				{
					do_hit_event();
					do_hitstop(1);
					if (i_ex(obj_flowery_enemy))
					{
						scr_tensionheal(tensionvalue * obj_flowery_enemy.moar_tension);
					}
					deathcon = 1;
					deathtimer = 0;
					with (obj_orangeheart)
					{
						dashtimer = clamp(dashtimer - 16, 0, dashtimer);
						if (chargecon == 0 || chargecon == 3)
						{
							chargecon = 2;
						}
					}
					snd_play(snd_damage, 0.6, 1.4);
					snd_play(snd_paper_rise, 1, 1.75);
					with (obj_afterimage)
					{
						if (variable_instance_exists(id, ""daddy""))
						{
							if (daddy == other.id)
							{
								instance_destroy();
							}
						}
					}
				}
				else if (obj_orangeheart.dashing && bounceable)
				{
					if (bouncebuffer <= 0)
					{
						hsp = 40 / global.fps_scale;
						bounced = 1;
						if (up_h())
						{
							additionalvsp -= (8 / global.fps_scale);
							if (additionalvsp > 0)
							{
								additionalvsp = 0;
							}
						}
						if (down_h())
						{
							additionalvsp += (8 / global.fps_scale);
							if (additionalvsp < 0)
							{
								additionalvsp = 0;
							}
						}
						bouncebuffer = 16;
						obj_debug_orangeheartcontroller.hitstop = 1;
						obj_orangeheart.hitstop = 1;
						delay_function(doparts, 1);
						with (obj_orangeheart)
						{
							dashtimer = clamp(dashtimer - 16, 0, dashtimer);
							if (chargecon == 0 || chargecon == 3)
							{
								chargecon = 2;
							}
						}
						snd_play(snd_damage, 0.6, 1.4);
						snd_play(snd_punchweak, undefined, random_range(0.7, 0.85));
						with (obj_afterimage)
						{
							if (variable_instance_exists(id, ""daddy""))
							{
								if (daddy == other.id)
								{
									instance_destroy();
								}
							}
						}
					}
				}
				else
				{
					with (obj_orangeheart)
					{
						hurt(other.id);
					}
					instance_destroy();
				}
			}
		}
	}
}
if (deathcon == 1)
{
	deathtimer += (1 / global.fps_scale);
	if (deathtimer == 3)
	{
		doparts();
		instance_destroy();
	}
}
if (inboundsonly)
{
	if (y > boxbot)
	{
		y = boxbot;
		vertical_direction *= -1;
		additionalvsp = -abs(additionalvsp);
	}
	if (y < boxtop)
	{
		y = boxtop;
		vertical_direction *= -1;
		additionalvsp = abs(additionalvsp);
	}
}
if (!controller.hitstop)
{
	y += ((vsp * vertical_direction) + additionalvsp);
	x += (hsp + additionalhsp);
	if (bounceable)
	{
		if (hsp > basehsp)
		{
			hsp -= (0.4 / (global.fps_scale * global.fps_scale));
		}
		additionalvsp = lerp(additionalvsp, 0, scr_fps_lerp_rate(0.05));
		if (bounced && !staybounced)
		{
			if (abs(hsp - basehsp) < 0.5)
			{
				bounced = 0;
			}
		}
	}
	hsp += fakehgrav;
}
if (bounceable)
{
	if (bounced)
	{
		var didbreak = false;
		var _list = ds_list_create();
		var _num = collision_rectangle_list(bbox.x1, bbox.y1, bbox.x2, bbox.y2, obj_orangeheart_wall, false, true, _list, false);
		if (_num > 0)
		{
			for (var i = 0; i < _num; i++)
			{
				with (ds_list_find_value(_list, i))
				{
					if (!isball && !breakable)
					{
						breakup();
						didbreak = true;
						instance_destroy();
					}
				}
			}
		}
		ds_list_destroy(_list);
		if (didbreak)
		{
			snd_play(snd_break1);
		}
	}
}
if (x < (camerax() - 40))
{
	instance_destroy();
}
");

Apply("gml_Object_obj_orangeheart_wallflower_Draw_0", @"draw_self();
if (reticle)
{
	draw_sprite_ext(spr_enemy_yellow_reticle, 0, x, y, image_xscale, image_yscale, 0, ((floor(global.time / global.fps_scale) % 4) < 2) ? c_white : c_red, 1);
}
");

Apply("gml_Object_obj_orangeheart_word_manager_Create_0", @"timer_goal = 24;
timer = irandom(timer_goal - 1);
b_speed = 6;
dir = 1;
if (y > scr_get_box(5))
{
	image_angle = 90;
}
else
{
	image_angle = -90;
}
depth = obj_growtangle.depth - 1;

init = function()
{
	for (var a = 0; a < 5; a++)
	{
		with (instance_create(x, y + (timer_goal * b_speed * a * dir), obj_orangeheart_bullet_word))
		{
			direction = 270;
			image_angle = direction;
			speed = (other.b_speed * other.dir) / global.fps_scale;
			y += (other.timer * other.dir * other.b_speed);
			wordtroller = other.id;
		}
	}
};

align_words = function()
{
	with (obj_orangeheart_bullet_word)
	{
		if (wordtroller == other.id)
		{
			x = other.x;
		}
	}
};
");

Apply("gml_Object_obj_orangeheart_word_manager_Step_0", @"if (!i_ex(obj_debug_orangeheartcontroller))
{
	instance_destroy();
	exit;
}
timer += (1 / global.fps_scale);
if (timer >= timer_goal)
{
	timer -= timer_goal;
	with (instance_create(x, y, obj_orangeheart_bullet_word))
	{
		direction = 270;
		image_angle = direction;
		speed = (other.b_speed * other.dir) / global.fps_scale;
		wordtroller = other.id;
	}
}
if (x < (camerax() - 40))
{
	instance_destroy();
}
");

Apply("gml_Object_obj_orbitparticle_Create_0", @"x_center = xstart;
y_center = ystart;
x_target = x_center;
y_target = y_center;
x_target_new = x_target;
grav = 0;
yspeed = 0;
orbit_angle = random(360);
orbit_dist_start = 150;
orbit_dist = orbit_dist_start;
orbit_dist_target = 50;
orbit_speed = 4;
orbit = true;
orbit_height = 0;
orbit_maxheight = -10;
orbit_target = -4;
orbit_target_follow = true;
risespeed = 0.25;
risedir = -1;
offset_x = 0;
offset_y = random_range(0, 10);
stop_orbit = false;
orbit_eject = false;
orbit_eject_angle = 90;
orbit_eject_angle_range = 10;
orbit_eject_soon = false;
image_speed = 0.25 / global.fps_scale;
image_alpha = 0;
alive = 1;
sparkling = false;
sparkle_timer = 15;
sparkle_timer_max = 15;
step_func = -1;
do_movement = true;
");

Apply("gml_Object_obj_orbitparticle_Step_0", @"if (orbit)
{
	var _have_orbit_target = orbit_target != -4 && i_ex(orbit_target);
	if (do_movement)
	{
		if (orbit_target_follow && _have_orbit_target)
		{
			x_center = lerp(x_center, x_target, scr_fps_lerp_rate(0.05));
			y_center = lerp(y_center, y_target, scr_fps_lerp_rate(0.1));
		}
		else
		{
			x_center = lerp(x_center, x_target, scr_fps_lerp_rate(0.05));
			y_center = lerp(y_center, y_target, scr_fps_lerp_rate(0.1));
		}
	}
	yspeed += (grav / (global.fps_scale * global.fps_scale));
	if (yspeed != 0)
	{
		y_target += yspeed;
		y_center = y_target;
	}
	orbit_dist = lerp(orbit_dist, orbit_dist_target, scr_fps_lerp_rate(0.2));
	orbit_angle += (orbit_speed / global.fps_scale);
	orbit_height += ((risespeed * risedir * (orbit_speed / 4)) / global.fps_scale);
	if (orbit_height <= orbit_maxheight)
	{
		risedir = 1;
	}
	if (orbit_height >= 0)
	{
		risedir = -1;
	}
	x = x_center + (cos(degtorad(orbit_angle)) * orbit_dist);
	y = y_center + (sin(degtorad(orbit_angle)) * orbit_dist * 0.2) + offset_y + orbit_height;
	orbit_z = sin(degtorad(orbit_angle)) * -1;
	image_blend = merge_color(c_white, c_gray, clamp01(orbit_z));
	if (_have_orbit_target)
	{
		orbit_depth = orbit_target.depth;
	}
	depth = orbit_depth + (orbit_z * 100);
	if (orbit_z > 0)
	{
		image_xscale = 1.75;
		image_yscale = 1.75;
	}
	else
	{
		image_xscale = 2;
		image_yscale = 2;
	}
	if (stop_orbit)
	{
		orbit = false;
	}
}
if (sparkling)
{
	sparkle_timer -= (1 / global.fps_scale);
	if (sparkle_timer <= 0)
	{
		sparkle_timer = sparkle_timer_max;
		with (instance_create_depth(x, y, depth + 1, obj_sparkle_fake_particle))
		{
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.25 / global.fps_scale;
		}
	}
}
image_alpha = scr_approach(image_alpha, alive, 1/15);
if (!alive && image_alpha <= 0)
{
	instance_destroy();
}
if (orbit_eject)
{
	var _angle = orbit_angle % 360;
	if (_angle > (orbit_eject_angle - orbit_eject_angle_range) && _angle < (orbit_eject_angle + orbit_eject_angle_range))
	{
		orbit = false;
		direction = _angle + 90;
		speed = orbit_speed / global.fps_scale;
	}
}
if (step_func != -1)
{
	step_func();
}
");

Apply("gml_Object_obj_overworld_bulletarea_Step_0", @"if (instance_exists(obj_mainchara) && ignorebuffer < 0)
{
	obj_mainchara.battlemode = 0;
	cancel = 0;
	if (onlyActiveIfBulletsExist && !instance_exists(obj_overworldbulletparent))
	{
		cancel = 1;
	}
	if (onlyActiveIfSpecialObjectExists && !i_ex(specialObject))
	{
		cancel = 1;
	}
	if (cancel == 0)
	{
		if (obj_mainchara.bbox_right >= x && obj_mainchara.bbox_left <= (x + sprite_width) && obj_mainchara.bbox_bottom >= y && obj_mainchara.bbox_top <= (y + sprite_height))
		{
			obj_overworld_bulletarea.checkid = id;
			with (obj_overworld_bulletarea)
			{
				if (id != checkid)
				{
					ignorebuffer = 2;
				}
			}
			obj_mainchara.battlemode = 1;
			if (keepHidden == 0)
			{
				with (obj_overworld_bulletarea)
				{
					if (scr_debug())
					{
						showArea = 1;
					}
				}
			}
		}
	}
}
ignorebuffer--;
if (obj_mainchara.battlemode == 0)
{
	timer += (1 / global.fps_scale);
}
else
{
	timer = 0;
}
if (timer >= 60)
{
	with (obj_darkcontroller)
	{
		charcon = 0;
	}
}
image_alpha = 0;
");

Apply("gml_Object_obj_overworld_dashbullet_Step_0", @"if (init == 0)
{
	y = ystart + 30;
	init = 1;
	with (instance_create(x, y, obj_animation))
	{
		sprite_index = spr_splash;
		image_speed = 0.2 / global.fps_scale;
	}
	scr_lerpvar(""y"", y, ystart, 15, 3, ""out"");
	snd_stop(snd_grab);
	snd_play(snd_grab);
	hspeed_start = hspeed;
	vspeed_start = vspeed;
}
if (x < (camerax() - 40))
{
	instance_destroy();
	exit;
}
var stopped = 0;
with (obj_mainchara_dash)
{
	stopped = hitstop > 0;
}
if (stopped)
{
	hspeed = 0;
	vspeed = 0;
	exit;
}
timer += (1 / global.fps_scale);
var cx = camerax();
var cw = camerawidth() * 0.5;
if (con == 0)
{
	image_angle = direction;
	x = lerp(x, cx + cw + lengthdir_x(cw, 180 + direction), scr_fps_lerp_rate(0.8));
	if (timer >= timermax)
	{
		hspeed = lengthdir_x(4, direction) / global.fps_scale;
		con = 1;
		scr_doom(self, 80);
		snd_stop(snd_swing);
		snd_play(snd_swing);
	}
}
else if (con == 1)
{
	if ((global.time % global.fps_scale) == 0)
	{
		scr_afterimage().image_alpha = 0.5;
	}
}
else if (con == 2)
{
	if (targeting_delay > 0)
	{
		targeting_lerp += (1 / global.fps_scale);
		hspeed = lerp(hspeed_start, target_hspeed, clamp01((targeting_lerp - (targeting_delay * 0.5)) / 30));
		vspeed = lerp(vspeed_start, target_vspeed, clamp01(targeting_lerp / targeting_delay));
	}
}
");

Apply("gml_Object_obj_overworld_foxbullet_Create_0", @"event_inherited();
destroyoffscreen = false;
tolerance = 0;
__silhouette = 5463;
active = 1;
image_alpha = 0;
timer = 0;
damage = 18;
target = 3;
performs_culling_checks = true;
cull_buffer_left = -4;
cull_buffer_right = -4;
cull_buffer_top = -4;
cull_buffer_bottom = -4;
cull_buffer = 10;
is_culled = false;
reflection_anchor = y;
if (!instance_exists(obj_culling_manager))
{
	instance_create(0, 0, obj_culling_manager);
}
lastx = 0;
timer_inc = 1;
lasty = 0;
pickup_cooldown = 0;
can_drop = true;
reflect_jump_y = 0;
reflection_enabled = false;
idling = false;
dialoguecon = 0;
deposited = false;
override_facing = true;
can_transform = false;
t = 6;
if (fox_index >= 10 && flag >= 0)
{
	if (scr_get_bitmask_value(global.flag[flag], fox_index, 1) == 1)
	{
		instance_destroy();
	}
}

on_press = function()
{
	if (!held)
	{
		exit;
	}
	if (!can_drop)
	{
		exit;
	}
	if (pickup_cooldown > 0)
	{
		exit;
	}
	if ((global.facing == 2 && scr_trigcheck(""no_throw_up"")) || (global.facing == 0 && scr_trigcheck(""no_throw_down"")))
	{
		exit;
	}
	pickup_cooldown = 2;
	t = 0;
	event_user(1);
	idling = 1;
	timer = 0;
	var anchor_x = 0;
	var anchor_y = 0;
	if (global.facing == 1)
	{
		anchor_x = obj_mainchara.bbox_right + 32;
		anchor_y = obj_mainchara.bbox_bottom - 20;
	}
	if (global.facing == 0)
	{
		anchor_x = obj_mainchara.x + (0.5 * obj_mainchara.sprite_width);
		anchor_y = obj_mainchara.bbox_bottom + 20;
		depth = obj_mainchara.depth - 20;
	}
	if (global.facing == 3)
	{
		anchor_x = obj_mainchara.bbox_left - 32;
