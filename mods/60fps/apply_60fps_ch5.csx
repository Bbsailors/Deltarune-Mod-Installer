				direction -= 90;
			}
		};
	}
	else if (other.bullet_step_type == 3)
	{
		step_func = function()
		{
			if (!variable_instance_exists(self, ""normalspeed""))
			{
				normalspeed = speed;
				timer = 0;
			}
			timer += (1 / global.fps_scale);
			direction -= (((360 / lifetime) * movedir) / global.fps_scale);
