	{
		image_alpha -= (0.3 / global.fps_scale);
		neutralized = 999;
		if (image_alpha <= 0)
		{
			instance_destroy();
		}
	}
	if (is_method(step_func))
	{
		step_func();
	}
	if (t > lifetime && lifetime != -1)
	{
		scr_afterimagefast();
		instance_destroy();
	}
}
");

