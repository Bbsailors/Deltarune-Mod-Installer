Apply("gml_Object_obj_leafpile_Other_21", @"if (bust == 0)
{
	global.flag[flag] = scr_set_bitmask_value(global.flag[flag], flagbit, 1, 1);
	switch (contents)
	{
		case 1:
			var treasure = instance_create((x + (0.5 * sprite_width)) - 20, y, obj_treasure_room);
			break;
		case 2:
			var npc = instance_create(x - 20, y - 20, obj_npc_room);
			scr_dashreact_init(sprite_index, 0, false, 0);
			break;
		case 3:
			for (var i = 0; i < 3; i++)
			{
				var npc = instance_create(x - 20, y - 20, obj_plat_coin);
				if (i_ex(obj_mainchara_dash))
				{
					npc.hspeed = (6 * obj_mainchara_dash.image_xscale) / global.fps_scale;
				}
				else
				{
					npc.hspeed = random_range(-6, 6) / global.fps_scale;
				}
				npc.vspeed = random_range(-4, -6) / global.fps_scale;
			}
			break;
	}
	instance_destroy();
	bust = 1;
	snd_play(snd_wing);
	for (var i = 0; i < 12; i += 1)
	{
		var marker = instance_create(x + random_range(0, sprite_width), y + 20 + random(25), obj_marker);
		with (marker)
		{
			sprite_index = spr_spin_petal_alt;
			if (other.palette == 2)
			{
				sprite_index = other.effectsprites[floor(random_range(0, array_length(other.effectsprites) - 0.01))];
			}
			vspeed = random_range(-12, 2) / global.fps_scale;
			if (i_ex(obj_mainchara_dash))
			{
				hspeed = (random_range(16, 34) * obj_mainchara_dash.image_xscale) / global.fps_scale;
			}
			else
			{
				hspeed = random_range(-6, 6) / global.fps_scale;
			}
			scr_lerpvar(""vspeed"", vspeed, vspeed * 0.2, 30, 1, ""out"");
			scr_darksize();
			image_speed = random_range(0.2, 0.35) / global.fps_scale;
			depth = other.depth;
			scr_doom(self, 45);
			scr_lerpvar(""image_alpha"", 1, 0, 45);
		}
	}
}
");

