	if (timer == 10)
	{
		sound_play(snd_wing);
		var dir = scr_at_player();
		var step = 30;
		var off = -step;
		while (off <= step)
		{
			with (scr_fire_bullet(x, y, obj_bullet_shuriken, dir + off + randomized, shotspd - (((off != 0) * shotspd) / 5), spr_shuriken_small, false, true, depth - 1))
