			timer = 0;
		}
		else
		{
			con = 0;
			timer = 0;
			sprite_index = spr_shinobeetle_pose;
		}
	}
}
if (con == 2)
{
	if (timer == 1)
	{
		with (instance_create(x - 40, y - 10, obj_animation))
		{
			sprite_index = spr_poof;
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
			depth = other.depth - 1;
		}
		snd_stop(snd_wing);
		snd_play(snd_wing);
	}
	if (timer == 7)
	{
		instance_destroy();
	}
}
if (con == 3)
{
