    foreach (var __raw in __spec.Split('\n'))
    {
        var __line = __raw.Trim();
        if (__line.Length == 0 || __line.StartsWith("#")) continue;
        var __f = __line.Split('|');
        if (__f[0] == "ASSET")
        {
            if (__f.Length != 8 && __f.Length != 9) throw new Exception("bad ASSET row: " + __line);
            int __want = __f.Length == 9 ? int.Parse(__f[8], __ic) : 1;
            var __r = Data.Rooms.ByName(__f[1]);
            if (__r == null) throw new Exception("non-code spec: room not found: " + __f[1]);
            double __ox = double.Parse(__f[4], __ic), __oy = double.Parse(__f[5], __ic);
            double __os = double.Parse(__f[6], __ic), __ns = double.Parse(__f[7], __ic);
            int __hit = 0;
            foreach (var __ly in __r.Layers)
            {
                if (__ly.LayerType != UndertaleRoom.LayerType.Assets) continue;
                if ((__ly.LayerName?.Content ?? "") != __f[2]) continue;
                var __sprites = __ly.AssetsData?.Sprites;
                if (__sprites == null) continue;
                foreach (var __si in __sprites)
                {
                    if ((__si.Sprite?.Name?.Content ?? "") != __f[3]) continue;
                    if (Math.Abs(__si.X - __ox) > __eps || Math.Abs(__si.Y - __oy) > __eps) continue;
                    if (Math.Abs(__si.AnimationSpeed - __os) > __eps) continue;
                    __si.AnimationSpeed = (float)__ns;
                    __hit++;
                }
            }
            if (__hit != __want) throw new Exception("non-code spec ASSET: expected " + __want + " match(es), got " + __hit + ": " + __line);
            __assets += __hit;
        }
        else if (__f[0] == "INST")
        {
            if (__f.Length != 7) throw new Exception("bad INST row: " + __line);
            var __r = Data.Rooms.ByName(__f[1]);
            if (__r == null) throw new Exception("non-code spec: room not found: " + __f[1]);
            double __ox = double.Parse(__f[3], __ic), __oy = double.Parse(__f[4], __ic);
            double __nx = double.Parse(__f[5], __ic), __ny = double.Parse(__f[6], __ic);
            int __hit = 0;
            foreach (var __go in __r.GameObjects)
            {
                if ((__go.ObjectDefinition?.Name?.Content ?? "") != __f[2]) continue;
                if (Math.Abs(__go.X - __ox) > __eps || Math.Abs(__go.Y - __oy) > __eps) continue;
                __go.X = (int)__nx; __go.Y = (int)__ny;
                __hit++;
            }
            if (__hit != 1) throw new Exception("non-code spec INST: expected 1 match, got " + __hit + ": " + __line);
            __insts++;
        }
        else throw new Exception("non-code spec: unknown row kind: " + __line);
        __rows++;
    }
    if (__rows != 1279 || __assets != 1281 || __insts != 0)
        throw new Exception("non-code spec: expected 1279 rows / 1281 asset speeds / 0 instance moves, got "
            + __rows + " / " + __assets + " / " + __insts);
    Console.WriteLine("non-code spec: " + __assets + " asset-layer speed(s), " + __insts + " instance move(s), all count-asserted.");
}
