	c_facenext(""flowery"", ""5"");
	c_msgnextloc(""\\E5* ..^1. once you find them.../"", ""obj_ch5_DWCL00_slash_Step_0_gml_193_0"");
	c_sel_spritenext(fl, 781, 1);
	c_msgnextloc(""\\E7* ..^1. what will you do?/%"", ""obj_ch5_DWCL00_slash_Step_0_gml_195_0"");
	c_talk_wait();
	c_wait(20);
	c_sel_spriteimage(asg, 8444, 0, 0);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\EU* .../%"", ""obj_ch5_DWCL00_slash_Step_0_gml_203_0"");
