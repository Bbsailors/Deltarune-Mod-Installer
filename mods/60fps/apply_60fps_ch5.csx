		c_msgnextsubloc(""* I may give other FROIDERPRASENTS for a FAST TIME...!/%"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_hopschef_slash_Step_0_gml_713_0"");
