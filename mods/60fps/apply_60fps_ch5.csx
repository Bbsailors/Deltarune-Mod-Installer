	}
}
");

Apply("gml_Object_obj_plat_pumpkin_Step_0", @"if (!init)
{
	scr_plat_wallcast();
	alternate_mode = instance_exists(obj_dw_fcastle_top_ascent) || instance_exists(obj_dw_garden_aquahole_left);
	if (!alternate_mode)
	{
		depth += 10000;
	}
	else
	{
		depth += 1000;
	}
	init = true;
}
if (global.pause_plat)
{
	exit;
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer == 1 && alternate_mode)
	{
		image_xscale = 1 + (0.5 * global.flag[1903]);
	}
	vspeed = scr_approach(vspeed, 5 / global.fps_scale, 0.2 / global.fps_scale);
	if (vspeed == (5 / global.fps_scale))
	{
		if (alternate_mode)
		{
			if (global.lang == ""ja"")
			{
				snd_play(snd_your_jp);
			}
			else
			{
				snd_play(snd_your);
			}
			con = 10;
			vspeed = 0;
			timer = 0;
		}
		else
		{
			instance_create(x - 140, y, obj_yourlong);
			if (global.lang == ""ja"")
			{
				snd_play(snd_your_long_jp);
			}
			else
			{
				snd_play(snd_your_long);
			}
			scr_shakeobj();
			vspeed = 0;
			con = 2;
			timer = 0;
		}
	}
}
if (con == 2)
{
	timer += (1 / global.fps_scale);
	if (timer == 20)
	{
		timer = 0;
		con = 3;
		image_xscale = 2;
	}
}
if (con == 3)
{
	if (branch.ralsei_ready)
	{
		timer += (1 / global.fps_scale);
		if (timer == 60)
		{
			scr_speaker(""ralsei"");
			msgsetsubloc(0, ""\\EU* ..."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_plat_pumpkin_slash_Step_0_gml_36_0"");
			d_make_plat(0, 1);
		}
		if (timer == 1)
		{
			with (obj_plat_follower)
			{
				if (name == ""ralsei"")
				{
					scr_lerpvar(""long"", 0, 2, 12, -1, ""out"");
				}
			}
		}
	}
	else
	{
		scr_lerpvar(""y"", y, ystart, 10);
		scr_lerpvar(""image_xscale"", image_xscale, 1, 10);
		timer = 0;
		con = 0;
	}
}
if (con == 10)
{
	timer += (1 / global.fps_scale);
	if (timer == 30)
	{
		timer = 0;
		con = 11;
		if (global.flag[1903] == 1)
		{
			timer = 30;
		}
	}
}
if (con == 11)
{
	if (branch.ralsei_ready)
	{
		timer += (1 / global.fps_scale);
		if (timer == 1)
		{
			if (global.lang == ""ja"")
			{
				snd_play(snd_lo_jp);
			}
			else
			{
				snd_play(snd_lo);
			}
		}
		if (timer >= 1 && timer <= 12)
		{
			var t = timer / 12;
			with (obj_plat_follower)
			{
				if (name == ""ralsei"")
				{
					long = ease_inout_quad(t, 0, 1, 1);
				}
			}
			image_xscale = (ease_inout_quad(t, 0, 1, 1) * 0.5) + 1;
		}
		if (timer == 31)
		{
			if (global.lang == ""ja"")
			{
				snd_play(snd_ol_jp);
			}
			else
			{
				snd_play(snd_ol);
			}
		}
		if (timer >= 31 && timer <= 42)
		{
			var t = 1 - ((timer - 30) / 12);
			with (obj_plat_follower)
			{
				if (name == ""ralsei"")
				{
					long = ease_inout_quad(t, 0, 1, 1);
				}
			}
			image_xscale = (ease_inout_quad(t, 0, 1, 1) * 0.5) + 1;
		}
		if (timer == 5)
		{
			global.flag[1903] = 1;
		}
		else if (timer == 35)
		{
			global.flag[1903] = 0;
		}
		if (timer == 60)
		{
			timer = 0;
		}
	}
	else
	{
		if (timer > 0)
		{
			if (global.lang == ""ja"")
			{
				snd_play(snd_ruoy_jp);
			}
			else
			{
				snd_play(snd_ruoy);
			}
		}
		with (obj_lerpvar)
		{
			if (target == other.id)
			{
				instance_destroy();
			}
		}
		scr_lerpvar(""y"", y, ystart, 10);
		scr_lerpvar(""image_xscale"", image_xscale, 1, 10);
		timer = 0;
		con = 0;
	}
}
");

