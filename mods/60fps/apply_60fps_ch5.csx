		{
			var ball = instance_create(x, y, obj_titan_fight_explosion_ball);
			ball.vspeed = random_range(-15, -2) / global.fps_scale;
			ball.hspeed = random_range(minh, maxh) / global.fps_scale;
			ball.depth = depth;
		}
	}
	if (!endless && timer > 30)
	{
		con = 1;
	}
	if (timer > 15 && (timer % 2) == 0)
	{
		var ball = instance_create(x, y, obj_titan_fight_explosion_ball);
		ball.vspeed = random_range(-20, -2) / global.fps_scale;
		ball.hspeed = random_range(minh, maxh) / global.fps_scale;
		ball.depth = depth;
	}
}
if (con == 1)
{
	instance_destroy();
}
");

