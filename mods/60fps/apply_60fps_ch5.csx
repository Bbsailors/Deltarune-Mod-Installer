Apply("gml_Object_obj_dw_fcastle_sandtrap_shijoke_Draw_0", @"var spr = 41;
var wid = sprite_get_width(spr_shinobeetle_hurt) * 2;
var hei = sprite_get_height(spr_shinobeetle_hurt) * 2;
var anc = 
{
