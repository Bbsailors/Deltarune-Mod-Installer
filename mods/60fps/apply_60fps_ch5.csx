				image_yscale = 480;
				snd_play(snd_explosion_mmx);
				image_alpha = 0.1;
				scr_lerpvar(""image_alpha"", 0.1, 0, 20);
				scr_doom(self, 10);
			}
			hspeed = 0;
			vspeed = 0;
			switch_con(3);
		}
	}
	else if (subcon == 9)
	{
		var time = ceil(24 - (0.5 * attack_speed));
		if (subcontimer == 1)
		{
			with (dashbullet)
