killbell = function(arg0 = false)
{
	with (obj_starwalker_offswitch)
	{
		if (!arg0)
		{
			with (scr_marker_frominstance(id, true))
			{
				vspeed = 4 / global.fps_scale;
				gravity = -1.5 / (global.fps_scale * global.fps_scale);
				
				step_func = function()
				{
					if (y < (cameray() - 120))
					{
						instance_destroy();
					}
				};
			}
		}
		else
		{
			with (scr_marker_fancy(x + 19, y + 14, 4220))
			{
				snd_play(snd_badexplosion);
				scr_size(2, 2);
				image_speed = 1 / global.fps_scale;
				timer = 0;
				
				step_func = function()
				{
					timer += (1 / global.fps_scale);
					if (timer >= 16)
					{
						instance_destroy();
					}
				};
			}
		}
		instance_destroy();
	}
};

quicksolve = function()
{
	_ralseisolve = true;
	snd_play(snd_bump, 1, 1);
	snd_play(snd_grab, 0.5, 1.2);
	var timeline = 18;
	var blockarray = [];
	var solvearray = [];
	with (obj_pushable_block)
	{
		array_push(blockarray, id);
	}
	with (obj_floorswitch)
	{
		array_push(solvearray, id);
	}
	for (var i = 0; i < array_length(blockarray); i++)
	{
		with (blockarray[i])
		{
			var point = 
			{
				x: 0,
				y: 0
			};
			var closest = -4;
			for (var k = 0; k < array_length(solvearray); k++)
			{
				if (closest == -4)
				{
					closest = solvearray[k];
				}
				else if (distance_to_object_bbox(undefined, solvearray[k]) < distance_to_object_bbox(undefined, closest))
				{
					closest = solvearray[k];
				}
			}
			image_index = 0;
			image_speed = 0;
			scr_jump_to_point(closest.x, closest.y, 32, timeline, true);
		}
	}
	
	var endsound = function()
	{
		snd_play(snd_noise, 0.6);
	};
	
	delay_function(endsound, timeline);
};

if (puzcon == 0)
{
	var trig = false;
	with (obj_pushable_block)
