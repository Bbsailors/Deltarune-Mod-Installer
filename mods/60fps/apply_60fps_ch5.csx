Apply("gml_Object_obj_npc_dojo_Step_0", @"scr_depth();
if (myinteract == 3)
{
	if (global.flag[20] == 0)
	{
		sprite_index = spr_npc_puzzlepiece;
		image_speed = 0.2 / global.fps_scale;
	}
	if (global.flag[20] == 1)
	{
