Apply("gml_Object_obj_dw_garden_shroomstack_Create_0", @"stack = [];
xdist = [];
ydist = [];
size = [];
mytarget = ""kris"";

disappear = function()
{
	var stacklength = array_length(stack);
	var order = [];
	for (var i = 0; i < stacklength; i++)
	{
		array_push(order, i);
	}
	for (var i = 0; i < stacklength; i++)
	{
		var throwidx = irandom(array_length(order) - 1);
		var throworder = order[throwidx];
		array_delete(order, throwidx, 1);
		var xdiff = clamp((x - xprevious) * global.fps_scale, -6, 6);
		var ydiff = clamp(((y - yprevious) * global.fps_scale) / 2, -6, 6);
		stacksize = 14;
		xdist[i] = lerp(xdist[i], xdiff * (0.5 * i), 0.15);
		ydist[i] = lerp(ydist[i], ydiff * (0.5 * i), 0.15);
		var xloc = x - (sprite_get_width(stack[i]) / 2) - xdist[i];
		var yloc = (y - sprite_get_height(stack[i]) - (i * stacksize) - ydist[i]) + abs(xdist[i] / 5);
		var s = stack[i];
		var shroom = instance_create(xloc, yloc, obj_marker);
		shroom.sprite_index = spr_facade_diner_stool_center_align;
		shroom.y = yloc;
		shroom.depth = depth;
		shroom.direction = random_range(0, 180);
		shroom.speed = random_range(4, 6) / global.fps_scale;
		shroom.gravity = 1 / (global.fps_scale * global.fps_scale);
		scr_doom(shroom, 100);
	}
	stack = [];
};
");

Apply("gml_Object_obj_dw_garden_shroomstack_Draw_0", @"var xdiff = clamp((x - xprevious) * global.fps_scale, -6, 6);
var ydiff = clamp(((y - yprevious) * global.fps_scale) / 2, -6, 6);
stacksize = 14;
for (var i = 0; i < array_length(stack); i++)
{
	size[i] = lerp(size[i], 1, scr_fps_lerp_rate(0.5));
	xdist[i] = lerp(xdist[i], xdiff * (0.5 * i), scr_fps_lerp_rate(0.15));
	ydist[i] = lerp(ydist[i], ydiff * (0.5 * i), scr_fps_lerp_rate(0.15));
	var xloc = x - (sprite_get_width(stack[i]) / 2) - xdist[i];
	var yloc = (y - sprite_get_height(stack[i]) - (i * stacksize) - ydist[i]) + abs(xdist[i] / 5);
	draw_sprite_ext(stack[i], 0, xloc, yloc, size[i], size[i], 0, c_white, size[i] * 2 * image_alpha);
}
