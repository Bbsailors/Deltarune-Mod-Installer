Apply("gml_Object_obj_plat_movingblock_Step_1", @"var _paused = false;
if (global.pause_plat)
{
	_paused = true;
}
if (!_paused)
{
	t += (1 / global.fps_scale);
	switch (movetype)
	{
		case 1:
			x = xstart + (sin(fx * t) * ax);
			y = ystart + (sin(fy * t) * ay);
			break;
		case 2:
			x = xstart + (sin(fx * t) * ax);
			y += (2 / global.fps_scale);
			if (y > (room_height + 100))
			{
				instance_destroy();
			}
			break;
	}
}
with (obj_plat_entity)
{
	if (ground == other.id)
	{
		scr_plat_snap_to_ground();
	}
}
");

