Apply("gml_Object_obj_plat_bulletred_shuriken3d_Create_0", @"event_inherited();
performs_culling_checks = true;
cull_buffer = 100;
image_angle = 45;
_dir = 45;
sprite_index = spr_plat_enm_shuriken_3d;
image_speed = 1 / global.fps_scale;
timer = 0;
con = 0;
init = 0;
startdepth = 0;
image_xscale = 0.2;
image_yscale = 0.2;
throwheight = 0;
damage = 0;
neutralized = 99999;
neutralizable = true;
fadecolor = c_black;
image_blend = merge_color(fadecolor, c_white, 0.2);
shuriken_target_x = x + 100;
shuriken_target_y = y + 100;
target_depth = depth;
throw_direction = 1;
shuriken_targetflag = """";
swingsound = -4;
parallaxer = 1;
timerlerp = 0;

get_real_x = function()
{
	return x + (camerax() * parallaxer * 0.6);
};

get_real_y = function()
{
	return y + (cameray() * parallaxer * 0.6);
};
");

Apply("gml_Object_obj_plat_bulletred_shuriken3d_Step_0", @"if (global.pause_plat)
{
	exit;
}
if (!init)
{
	init = true;
	startdepth = depth;
	image_blend = merge_color(fadecolor, c_white, 0.2);
	var Mark = scr_genmarker(shuriken_targetflag);
	if (Mark != -4)
	{
		target_x = Mark.x;
	}
}
timer += (1 / global.fps_scale);
if (con == 0)
{
	var phase1 = 35;
	var phase2 = 2;
	var phase3 = ceil(abs(ystart - throwheight - target_y) / 10);
	var total = phase1 + phase2 + phase3;
	var damagetime = phase1 + phase2 + floor(0.8 * phase3);
	timerlerp = clamp01(timer / total);
	var squared_lerp = ease_in_quad(timerlerp, 0, 1, 1);
	var depth_lerp = 0.2 + (0.8 * squared_lerp);
	parallaxer = 1 - squared_lerp;
	image_xscale = depth_lerp * throw_direction;
	image_yscale = depth_lerp;
	depth = lerp(startdepth, target_depth, squared_lerp);
	var rest_spot = lerp(xstart, target_x, timerlerp);
	if (timer < phase1)
	{
		x = lerp(xstart, target_x, squared_lerp);
		y = lerp(ystart, ystart - throwheight, ease_out_sine(timer / phase1, 0, 1, 1));
		image_blend = merge_color(fadecolor, c_white, depth_lerp * 0.05);
	}
	else if (timer < (phase1 + phase2))
	{
		x = lerp(xstart, target_x, squared_lerp);
		y = ystart - throwheight;
	}
	else
	{
		neutralized = false;
		if (timer == damagetime)
		{
			damage = 60;
		}
		image_blend = merge_color(image_blend, c_white, 1 - power(0.9, 1 / global.fps_scale));
		x = lerp(xstart, target_x, squared_lerp);
		y = lerp(ystart - throwheight, target_y - 60, ease_in_quart((timer - phase1 - phase2) / phase3, 0, 1, 1));
	}
	x = get_real_x();
	y = get_real_y();
	if (!is_culled)
	{
		if (frac(timer) == 0)
		{
			with (scr_afterimage_monochrome(255, true))
			{
				image_alpha = 0.1;
				image_blend = c_red;
			}
		}
	}
	if ((timer % 8) == 0 && !is_culled)
	{
		snd_stop(swingsound);
		swingsound = snd_play(motor_upper_quick_bc, depth_lerp * 0.3, 0.4 + (0.3 * timerlerp));
	}
	_dir += ((throw_direction * (0.1 + (1.15 * (45 - phase3) * 0.001 * timer))) / global.fps_scale);
	image_angle = _dir + 180;
	if (timer == total)
	{
		if (!is_culled)
		{
			snd_stop(swingsound);
			snd_play(motor_upper_quick_bc, 1, 0.9);
			snd_play(snd_bomb, 0.4, 1.6);
		}
		damage = 0;
		neutralized = 9999;
		con = 1;
		timer = 0;
		image_speed = 0;
		var anim = instance_create(target_x, target_y, obj_animation);
		with (anim)
		{
			sprite_index = spr_plat_impact_shatter;
			image_speed = 1 / global.fps_scale;
			image_xscale = -2 * other.throw_direction;
			depth = other.depth + 1;
			image_blend = c_red;
		}
		anim = instance_create(target_x, target_y, obj_animation);
		with (anim)
		{
			sprite_index = spr_plat_impact_shatter;
			image_speed = 1 / global.fps_scale;
			image_xscale = other.throw_direction;
			depth = other.depth + 1;
			image_blend = c_red;
		}
	}
}
if (con == 1)
{
	if (timer >= 1)
	{
		vspeed = -6 / global.fps_scale;
		image_speed = -1 / global.fps_scale;
		_dir += ((1.9 * throw_direction) / global.fps_scale);
		image_angle = _dir + 180;
		image_alpha -= (0.1 / global.fps_scale);
		image_xscale -= (0.02 / global.fps_scale);
		image_yscale -= (0.02 / global.fps_scale);
		if (image_alpha <= 0)
		{
			instance_destroy();
		}
	}
}
");

