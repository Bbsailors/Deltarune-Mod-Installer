	{
		image_xscale = -2;
	}
	if (x != lastx || y != lasty)
	{
		image_speed = lerp(0.15, 0.3, clamp01((abs(point_distance(lastx, lasty, x, y)) * global.fps_scale) / 8)) / global.fps_scale;
	}
	lastx = x;
	lasty = y;
	exit;
}
if (init == 0)
{
	with (obj_mainchara)
	{
		battle_menu_block = false;
	}
	if (encounterflag > 0 && global.flag[encounterflag] == 1)
	{
		instance_destroy();
	}
	find_next_position(startdirection);
	init = 1;
}
if (idling)
{
	exit;
}
last_imageangle = ceil((image_angle - 45) / 90);
if (con == 1)
{
	image_index += (0.5 / global.fps_scale);
}
else if (con > 0)
{
	image_index = 0;
}
if (con >= 0)
{
	scr_depth();
}
if (con == 1)
{
	x = lerp(last_x, target_x, timer / (stepsize / startspeed));
	y = lerp(last_y, target_y, timer / (stepsize / startspeed));
	if (timer >= (stepsize / startspeed))
	{
		x = target_x;
		y = target_y;
		con = 0.5;
		timer = 0;
		con = 0;
		find_next_position(nowdirection);
	}
}
if (con == 0)
{
	var right = 0;
	var down = 270;
	var left = 180;
	var up = 90;
	var success = find_next_position(nowdirection % 4);
	if (!success)
	{
		success = find_next_position(((nowdirection + 4) - 1) % 4);
	}
	if (!success)
	{
		success = find_next_position((nowdirection + 4 + 1) % 4);
	}
	if (!success)
	{
		success = find_next_position((nowdirection + 4 + 2) % 4);
	}
	if (!success)
	{
		con = 2;
		timer = 0;
	}
}
if (con == 2)
{
	if (timer == 20)
	{
		if (despawn_when_stuck)
		{
			con = 3;
			timer = 0;
		}
		else
		{
			con = 0;
			timer = 0;
		}
	}
}
if (con == 3)
{
	if (timer >= 20)
	{
		bullet.x = -9999;
		if ((timer % 40) == 20)
		{
			var success = find_next_position(nowdirection % 4);
			if (!success)
			{
				success = find_next_position(((nowdirection + 4) - 1) % 4);
			}
			if (!success)
			{
				success = find_next_position((nowdirection + 4 + 1) % 4);
			}
			if (!success)
			{
				success = find_next_position((nowdirection + 4 + 2) % 4);
			}
		}
		if (timer >= ((20 * despawn_leniency) + 1))
		{
			if (despawn_when_stuck == 2)
			{
				instance_destroy();
			}
			else
			{
				try_play_sound(301, 1, 1);
				con = 3.5;
				scr_jump_to_point(xstart, ystart, 12, 25, true);
				scr_delay_var(""con"", 4, 40);
				nowdirection = startdirection;
				scr_lerpvar(""image_angle"", image_angle, 90 * nowdirection, 25);
			}
		}
		else
		{
			image_angle -= ((18 + ((timer - 20) * 0.1)) / global.fps_scale);
			soundpitch = 1;
		}
	}
	else if (global.interact == 0)
	{
		image_angle -= (18 / global.fps_scale);
		soundpitch = 1;
	}
}
if (con == 4)
{
	image_blend = c_white;
	x = xstart;
	y = ystart;
	target_x = xstart;
	target_y = ystart;
	soundpitch = 1;
	con = 0;
	timer = 0;
}
if (con == 11 && global.interact == 0)
{
	image_angle -= (18 / global.fps_scale);
	x = target_x;
	y = target_y;
	if (timer >= 0)
	{
		turnpitch = 1;
		last_x = x;
		last_y = y;
		target_x = x;
		target_y = y;
		if (nowdirection == 0)
		{
			stepsize = 40;
			target_x += stepsize;
		}
		else if (nowdirection == 1)
		{
			stepsize = 40;
			target_y -= stepsize;
		}
		else if (nowdirection == 2)
		{
			stepsize = 40;
			target_x -= stepsize;
		}
		else
		{
			stepsize = 40;
			target_y += stepsize;
		}
		image_angle = nowdirection * 90;
		con = 1;
		timer = 0;
		try_play_sound(172, 0.3, 0.35 + soundpitch);
		soundpitch *= 1.059;
	}
	else
	{
		soundpitch = 1;
	}
}
if (ceil((image_angle - 45) / 90) != last_imageangle)
{
	try_play_sound(301, 0.3, 1 + turnpitch);
	turnpitch *= 1.059;
}
if (global.interact == 0 || con > 50)
{
	timer += (1 / global.fps_scale);
}
if (i_ex(obj_dw_garden_shearyguide) && obj_dw_garden_shearyguide.cutscenecon == 0)
{
	if (scr_trigcheck_ext(""shearyguide_cutaway"", self) && con < 99)
	{
		con = 99;
		with (obj_dw_garden_shearyguide)
		{
			scissor_cut(other);
		}
	}
}
if (con == 100)
{
	if (timer >= 0)
	{
		vspeed = -2 / global.fps_scale;
	}
	if (timer == 0)
	{
		_leaf_spawner = instance_create(x, y, obj_leaf_confetti);
		with (_leaf_spawner)
		{
			sprite_index = other.sprite_index;
			image_xscale = 8;
		}
		_leaf_spawner.direction = 270;
		_leaf_spawner.spread = 360;
		_leaf_spawner.count = 1;
		_leaf_spawner.visible = false;
		_leaf_spawner.strength = 1;
	}
	with (_leaf_spawner)
	{
		active = true;
		count = (frac(other.timer) == 0) ? 1 : 0;
		y = other.y;
		scr_depth();
	}
	if ((timer % 8) == 0)
	{
		scr_shakeobj();
	}
	image_index = timer / 2;
	if (timer >= 100)
	{
		con = 101;
		vspeed = -8 / global.fps_scale;
		timer = 0;
	}
}
if (con == 101)
{
	image_index = timer / 2;
	if (timer >= 40)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_scissor_flower_chaser_scissor_Step_2", @"event_inherited();
if (con < 3 || con == 11)
{
	with (bullet)
	{
		x = other.x;
		y = other.y;
		image_xscale = 2;
		image_yscale = 2;
	}
}
if (global.interact != 0 && con == 1)
{
	image_index = 0;
}
if (con == -1 || global.interact != 0)
{
	bullet.x = -9999;
	bullet_moved = 4;
}
else if (bullet_moved > 3 && (place_meeting(x, y, obj_mainchara) || place_meeting(x, y, obj_overworldheart)))
{
	bullet.x = -9999;
	bullet_moved = 4;
}
else if (bullet_moved > 0)
{
	bullet.x = -9999;
	bullet_moved -= (1 / global.fps_scale);
}
if (i_ex(bulletzone))
{
	bulletzone.x = (x + (0.5 * sprite_width)) - (0.5 * bulletzone.sprite_width);
	bulletzone.y = (y + (0.5 * sprite_height)) - (0.5 * bulletzone.sprite_height);
	if ((con >= 3 && con != 11) || !bulletzone_active)
	{
		bulletzone.x = -99999;
	}
}
");

Apply("gml_Object_obj_scissordancer_Step_0", @"dancetimer += (1 / global.fps_scale);
if (init == 0)
{
	init = 1;
}
if (dancetimer >= 30 && dancetimer <= 75)
{
	image_index += (0.25 / global.fps_scale);
}
if (dancetimer >= 112 && dancetimer <= 157)
{
	image_index -= (0.25 / global.fps_scale);
}
if (dancetimer >= 166)
{
	dancetimer = 0;
}
if (specturn == 1)
{
	if (x >= (xstart + 170) && y <= (ystart + 10))
	{
		y -= vspeed;
		x -= hspeed;
		direction -= 90;
		x = xstart + 169;
	}
	if (y >= (ystart + 160))
	{
		y -= vspeed;
		x -= hspeed;
		direction -= 90;
		y = ystart + 159;
	}
	if (x <= xstart)
	{
		y -= vspeed;
		x -= hspeed;
		direction -= 90;
		x = xstart + 1;
	}
	if (y <= ystart)
	{
		y -= vspeed;
		x -= hspeed;
		direction -= 90;
		y = ystart + 1;
	}
}
if (myinteract == 1 && sndcon == 0)
{
	sndcon = 1;
	myinteract = 0;
}
else
{
	myinteract = 2;
}
if (sndcon >= 1 && sndcon <= 5)
{
	sndtimer -= (1 / global.fps_scale);
	if (sndtimer <= 0)
	{
		p = 0.5 + random(0.7);
		b = snd_play(snd_scissorbell);
		snd_pitch(b, p);
		sndcon += 1;
		sndtimer = 3;
	}
}
if (sndcon == 6)
{
	sndtimer += (1 / global.fps_scale);
	if (sndtimer >= 15)
	{
		myinteract = 0;
		sndcon = 0;
		sndtimer = 0;
	}
}
scr_depth();
if (special > 0)
{
	specialtimer++;
	if (special == 1)
	{
		dancetimer = 0;
		if (specialcon == 0)
		{
			if (specialtimer < 21)
			{
				hspeed = -4;
				image_index += 0.4;
			}
			if (specialtimer == 21)
			{
				hspeed = 0;
			}
			if (specialtimer == (21 + specialmod))
			{
				specialtimer = 0;
				specialcon = 1;
				vspeed = -12;
				gravity = 0.7;
				x += sprite_width;
				image_xscale = -image_xscale;
			}
		}
		else if (specialcon == 1 || specialcon == 3)
		{
			image_index = 3;
			if ((y + vspeed) >= ystart)
			{
				y = ystart;
				vspeed = 0;
				gravity = 0;
				if ((specialcon == 1 && specialtimer == (specialmod2 + 1)) || (specialcon == 3 && specialtimer == (specialmod + 1)))
				{
					specialtimer = 0;
					specialcon++;
					if (specialcon == 4)
					{
						specialcon = 0;
					}
				}
			}
			else
			{
				specialtimer = 0;
			}
		}
		else if (specialcon == 2)
		{
			if (specialtimer < 21)
			{
				hspeed = 4;
				image_index += 0.4;
			}
			if (specialtimer == 21)
			{
				hspeed = 0;
			}
			if (specialtimer == (21 + specialmod2))
			{
				specialtimer = 0;
				specialcon = 3;
				hspeed = 0;
				vspeed = -12;
				gravity = 0.7;
				x += sprite_width;
				image_xscale = -image_xscale;
			}
		}
	}
	else if (special == 2)
	{
		if ((specialcon % 2) == 0 && specialtimer == 1)
		{
			used_specialmod = specialmod;
			used_specialmod2 = specialmod2;
			if (i_ex(obj_mainchara) && obj_mainchara.x < x)
			{
				used_specialmod = specialmod2;
				used_specialmod2 = specialmod;
			}
		}
		dancetimer = 0;
		if (specialcon == 0)
		{
			if (specialtimer < 21)
			{
				hspeed = -4;
				image_index += 0.4;
			}
			if (specialtimer == 21)
			{
				hspeed = 0;
			}
			if (specialtimer == (21 + used_specialmod))
			{
				specialtimer = 0;
				specialcon = 1;
				vspeed = -12;
				gravity = 0.7;
				x += sprite_width;
				image_xscale = -image_xscale;
			}
		}
		else if (specialcon == 1 || specialcon == 3)
		{
			image_index = 3;
			if ((y + vspeed) >= ystart)
			{
				y = ystart;
				vspeed = 0;
				gravity = 0;
				if (specialtimer == (used_specialmod2 + 1))
				{
					specialtimer = 0;
					specialcon++;
					if (specialcon == 4)
					{
						specialcon = 0;
					}
				}
			}
			else
			{
				specialtimer = 0;
			}
		}
		else if (specialcon == 2)
		{
			if (specialtimer < 21)
			{
				hspeed = 4;
				image_index += 0.4;
			}
			if (specialtimer == 21)
			{
				hspeed = 0;
			}
			if (specialtimer == (21 + used_specialmod))
			{
				specialtimer = 0;
				specialcon = 3;
				hspeed = 0;
				vspeed = -12;
				gravity = 0.7;
				x += sprite_width;
				image_xscale = -image_xscale;
			}
		}
	}
	exit;
}
var _turn = instance_place(x, y, obj_rotator);
if (instance_exists(_turn))
{
	if (walltype != 19)
	{
		direction = (_turn.image_index * 90) - 90;
	}
	else
	{
		var right = 0;
		var down = 270;
		var left = 180;
		var up = 90;
		if (_turn.image_blend == c_red)
		{
			if (_turn.image_index == 0 && direction == right)
			{
				lastdir = direction;
				direction = down;
			}
			else if (_turn.image_index == 3 && direction == down)
			{
				lastdir = direction;
				direction = left;
			}
			else if (_turn.image_index == 2 && direction == left)
			{
				lastdir = direction;
				direction = up;
			}
			else if (_turn.image_index == 3 && direction == up)
			{
				lastdir = direction;
				direction = left;
			}
			else if (_turn.image_index == 0 && direction == left)
			{
				lastdir = direction;
				direction = down;
			}
			else if (_turn.image_index == 1 && direction == down)
			{
				lastdir = direction;
				direction = right;
			}
		}
		if (_turn.image_blend == c_fuchsia)
		{
			if (_turn.image_index == 2 && direction == right)
			{
				lastdir = 15;
				direction = up;
			}
		}
		if (_turn.image_blend == #FAFF0A)
		{
			if (lastdir == 15)
			{
				direction = right;
			}
			else
			{
				direction = left;
			}
		}
		if (_turn.image_blend == c_white)
		{
			lastdir = direction;
			direction = (_turn.image_index * 90) - 90;
		}
	}
}
");

