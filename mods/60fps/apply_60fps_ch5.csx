	{
		find_new_shroom();
	}
}
if (con == 3)
{
	if (instance_exists(shroom))
	{
		var shrinkspeed = (0.15 * eatspeed) / global.fps_scale;
		shroom.image_xscale -= shrinkspeed;
		shroom.image_yscale -= shrinkspeed;
		shroom.hspeed = 0;
		shroom.vspeed = 0;
		shroom.state = 1;
		shroom.fakeheight = 0;
		if (shroom.image_xscale < 0)
