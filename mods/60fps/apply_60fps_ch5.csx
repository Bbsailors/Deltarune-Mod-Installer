			if (true_engaged)
			{
				ds_list_find_value(list2, i).water(false);
				other.show_reticle = false;
			}
		}
	}
}
ds_list_destroy(list2);
ds_list_destroy(list3);
if (!watering)
{
	show_reticle = 0;
}
if (!true_engaged)
{
