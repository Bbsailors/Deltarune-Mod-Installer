Apply("gml_Object_obj_fusuma_door_Create_0", @"scr_depth(self, depth_yoffset);
scr_platswap_init(self, false);
defaultdepth = depth;
image_speed = 0;
door_x = 0.05;
lerper = 1;
last_doorx = 0.05;
state = 0;
__floortex = -4;
door_scale = 1;
fusuma_ignore = false;
cull_buffer_left = 40;
cull_buffer_right = 40;
cull_buffer_top = 110;
cull_buffer_bottom = -4;
cull_buffer = 10;
is_culled = false;
if (!instance_exists(obj_culling_manager))
{
	instance_create(0, 0, obj_culling_manager);
}
con = 0;
far_background = false;
__framesprite = 5945;
__left_door_sprite = 2192;
__left_mask_sprite = 1113;
__right_door_sprite = 2992;
__right_mask_sprite = 897;
elevatorlerp = 0;
left_door_offset = 6;
right_door_offset = 27;

destroy = function()
{
	if (!destroyed)
	{
		snd_stop(snd_wing);
		snd_play(snd_wing);
		for (var i = 0; i < 16; i++)
		{
			var xx = x + random_range(0, 60 * image_xscale);
			var yy = y + random_range(40 * image_yscale, 100 * image_yscale);
			var paperscraps = instance_create_depth(xx, yy, depth - 10000, obj_marker_fancy);
			with (paperscraps)
			{
				sprite_index = choose(spr_plat_paperscraps_1, spr_plat_paperscraps_2, spr_plat_paperscraps_3, spr_plat_paperscraps_4, spr_plat_paperscraps_5);
				image_speed = random_range(0.2, 0.25) / global.fps_scale;
				direction = random_range(180, 360);
				speed = random_range(6, 16) / global.fps_scale;
				
				step_func = function()
				{
					hspeed *= power(0.92, 1 / global.fps_scale);
					if (abs(hspeed) < (6 / global.fps_scale))
					{
						vspeed = min(vspeed + (0.2 / (global.fps_scale * global.fps_scale)), 2 / global.fps_scale);
					}
				};
				
				var doomtime = random_range(60, 90);
				scr_lerpvar(""image_alpha"", 4, 0, doomtime);
				scr_doom(self, doomtime);
			}
		}
	}
	destroyed = true;
	state = 1;
};

destroyed = false;
start_blend = image_blend;
scr_plat_set_depth_offset(-222600);
if (depth_yoffset == 0)
{
	blocks = [];
	blocks[0] = instance_create(x, (y + sprite_height) - (4 * image_yscale), obj_solidblocksized);
	blocks[0].image_xscale = 0.0625 * image_xscale;
	blocks[0].image_yscale = image_yscale / 10;
	blocks[1] = instance_create((x + sprite_width) - (4 * image_xscale), (y + sprite_height) - (4 * image_yscale), obj_solidblocksized);
	blocks[1].image_xscale = 0.0625 * image_xscale;
	blocks[1].image_yscale = image_yscale / 10;
	blocks[2] = instance_create(x + (sprite_width * 0.5), (y + sprite_height) - (4 * image_yscale), obj_solidblocksized);
	blocks[2].image_xscale = 0.75 * image_xscale;
	blocks[2].image_yscale = image_yscale / 10;
	blocks[3] = instance_create(x + (image_xscale * 5), (y + sprite_height) - (4 * image_yscale), obj_solidblocksized);
	blocks[3].image_xscale = 0.75 * image_xscale;
	blocks[3].image_yscale = image_yscale / 10;
}
clip_surface = -1;
mask_surface = -1;
fusuma_offset = 39;
depth_adjusted = false;
init = false;
u_desat = shader_get_uniform(shd_saturation, ""u_desaturation"");
mask = -4;

set_open_state = function(arg0)
{
	if (can_open && state != arg0)
	{
		var x1 = bbox_left + image_xscale;
		var x2 = bbox_right - image_xscale;
		var y1 = bbox_top;
		var y2 = bbox_bottom - (3 * image_yscale);
		if (obj_mainchara.cutscene || !collision_rectangle(x1, y1, x2, y2, obj_mainchara, false, true))
		{
			state = (state + 1) % 2;
			var ll = lerper;
			lerper = 0;
			last_doorx = door_x;
			snd_play(snd_wing, 1, 1 + (0.1 * state));
			if (arg0 == 1)
			{
				with (instance_place(x - sprite_width, y, obj_fusuma_door))
				{
					if (state != 0)
					{
						set_open_state(0);
						other.lerper = -1;
					}
				}
				with (instance_place(x + sprite_width, y, obj_fusuma_door))
				{
					if (state != 0)
					{
						set_open_state(0);
						other.lerper = -1;
					}
				}
				if (ll == 1 && lerper == 0)
				{
					with (mask)
					{
						dirty = other.id;
					}
				}
			}
			if (state == 1)
			{
				on_open();
			}
			else
			{
				on_close();
			}
		}
	}
};

on_open = function()
{
};

on_close = function()
{
};

mask_init = false;

draw_reflection = function(arg0, arg1, arg2)
{
	var xx = x;
	var yy = y;
	rem_color = image_blend;
	var spr_door = __right_door_sprite;
	var spr_door_left = __left_door_sprite;
	sprite_index = __framesprite;
	x = 80;
	x = xx - arg0;
	y = (y - arg1) + sprite_height;
	y += sprite_height;
	shader_set_uniform_f(arg2, (yy + sprite_height) - arg1);
	image_yscale = -image_yscale;
	draw_self();
	if (!destroyed)
	{
		draw_sprite_ext(spr_door_left, image_index, (x + (left_door_offset * image_xscale)) - (door_x * sprite_width), y + (fusuma_offset * image_yscale * door_scale), image_xscale, image_yscale * door_scale, image_angle, image_blend, image_alpha);
		draw_sprite_ext(spr_door, image_index, x + (right_door_offset * image_xscale) + (door_x * sprite_width), y + (fusuma_offset * image_yscale * door_scale), image_xscale, image_yscale * door_scale, image_angle, image_blend, image_alpha);
		if (!can_open)
		{
			draw_sprite_ext(spr_fusuma_door_lock, 0, x + (0.5 * sprite_width), y + (0.5 * sprite_height), image_xscale, image_yscale, 0, image_blend, image_alpha);
		}
	}
	x = xx;
	y = yy;
	image_yscale = -image_yscale;
	image_blend = rem_color;
	exit;
};

myinteract = 0;
darkzone = -4;

add_darkzone = function()
{
	with (instance_create(x, y, obj_marker))
	{
		owner = other.id;
		other.darkzone = id;
		image_blend = c_black;
		sprite_index = spr_pxwhite;
		image_xscale = other.sprite_width;
		image_yscale = other.sprite_height;
		depth = other.depth + 10000;
	}
};
");

Apply("gml_Object_obj_fusuma_door_projectiles_Create_0", @"event_inherited();
can_open = true;

on_open = function()
{
	var angle = 0;
	var amount = 8;
	repeat (amount)
	{
		with (instance_create(x + 60, y + 120, obj_plat_bulletred))
		{
			speed = 9 / global.fps_scale;
			direction = angle;
		}
		angle += (360 / amount);
	}
};

on_close = function()
{
};
");

Apply("gml_Object_obj_fusuma_mask_Draw_0", @"if (scr_battlebg_fullalpha())
{
	exit;
}
if (instance_exists(obj_plat_fusuma_mask))
{
	exit;
}
if (!surface_exists(clip_surface))
{
	clip_surface = surface_create(640, mask_height);
}
if (count > 0)
{
	y = fusuma[0].y;
}
var _cameray = cameray();
if (_cameray > (y + mask_height) || (_cameray + 480) < y)
{
	exit;
}
var _camerax = camerax();
draw_set_color(c_white);
surface_set_target(clip_surface);
draw_clear_alpha(c_black, 0);
var _sx = 0;
var _sy = 0;
var clip_x = 0;
var clip_y = y;
for (var i = 0; i < count; i++)
{
	with (fusuma[i])
	{
		if (object_index == obj_plat_fusumawall)
		{
			if (destroyed)
			{
				continue;
			}
			if (!is_visible)
			{
				continue;
			}
			if (depth != (other.depth + 1))
			{
				continue;
			}
			var fb = false;
			with (obj_plat_fusuma_mask)
			{
				if (far_background == other.far_background)
				{
					fb = true;
					break;
				}
			}
			if (fb)
			{
				continue;
			}
			if (_sx > 640 || (_sx + sprite_width) < 0)
			{
				continue;
			}
			var xx = x - _camerax;
			var yy = y - clip_y;
			var dist_to_cover_x = (20 * image_xscale) / picscale;
			var dist_to_cover_y = (20 * image_yscale) / picscale;
			var wid = sprite_get_width(painting);
			var hei = sprite_get_height(painting);
			var uvx = uv_x;
			var uvy = uv_y;
			while (dist_to_cover_x > 0)
			{
				while (dist_to_cover_y > 0)
				{
					draw_sprite_part_ext(painting, image_index, uvx, uvy, dist_to_cover_x, dist_to_cover_y, xx, yy, picscale, picscale, image_blend, image_alpha);
					yy += ((hei - uvy) * picscale);
					dist_to_cover_y -= (hei - uvy);
					uvy = 0;
				}
				xx += ((wid - uvx) * picscale);
				dist_to_cover_x -= (wid - uvx);
				uvx = 0;
				yy = y - clip_y;
				uvy = uv_y;
				dist_to_cover_y = (20 * image_yscale) / picscale;
			}
			gpu_set_blendmode(bm_normal);
		}
		else if (destroyed)
		{
		}
		else if (is_culled)
		{
		}
		else
		{
			_sx = x - _camerax;
			_sy = y - _cameray;
			if (_sx > 700 || (_sx + sprite_width) < -60)
			{
			}
			else
			{
				gpu_set_colorwriteenable(true, true, true, false);
				draw_sprite_ext(__framesprite, image_index, _sx, 0, image_xscale, image_yscale, image_angle, c_white, image_alpha);
				draw_sprite_ext(__left_door_sprite, image_index, (_sx + (left_door_offset * image_xscale)) - (door_x * sprite_width), fusuma_offset * image_yscale * door_scale, image_xscale, image_yscale * door_scale, image_angle, c_white, image_alpha);
				draw_sprite_ext(__right_door_sprite, image_index, _sx + (right_door_offset * image_xscale) + (door_x * sprite_width), fusuma_offset * image_yscale * door_scale, image_xscale, image_yscale * door_scale, image_angle, c_white, image_alpha);
				gpu_set_colorwriteenable(false, false, false, true);
				gpu_set_blendmode_ext_sepalpha(bm_zero, bm_one, bm_one, bm_zero);
				if (!destroyed)
				{
					draw_sprite_ext(__left_mask_sprite, 0, (_sx + (left_door_offset * image_xscale)) - (door_x * sprite_width), fusuma_offset * image_yscale * door_scale, image_xscale, image_yscale * door_scale, 0, c_white, 1);
					draw_sprite_ext(__right_mask_sprite, 0, _sx + (right_door_offset * image_xscale) + (door_x * sprite_width), fusuma_offset * image_yscale * door_scale, image_xscale, image_yscale * door_scale, 0, c_white, 1);
					if (!can_open)
