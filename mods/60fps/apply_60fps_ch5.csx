	image_xscale = -1;
}
with (obj_omega_book)
{
	x = obj_growtangle.x + (xoff * dsin(other.angle)) + (yoff * dcos(other.angle));
	y = (obj_growtangle.y + (xoff * dcos(other.angle))) - (yoff * dsin(other.angle));
	image_angle = other.angle - 90;
	image_alpha = 0;
}

side_bias = function()
{
	var left = 0;
	var right = 0;
	with (obj_omega_book_word)
	{
		if (side)
		{
			right++;
		}
		else
		{
			left++;
		}
	}
	if (right > 1 && right > left)
	{
		return 0;
	}
	if (left > 1 && left > right)
	{
		return 2;
	}
	return 1;
};
");

Apply("gml_Object_obj_omega_book_manager_Step_0", @"if (variable_instance_exists(id, ""omega_ex_mode""))
{
	if (global.turntimer < 120 && !seth_counter)
	{
		with (obj_purple_enemy)
		{
			seth_sprite(2003, 0, 0);
		}
		seth_counter++;
	}
	if (global.turntimer < 100 && seth_counter < 2)
	{
		with (obj_purple_enemy)
		{
			var dizzytext = stringsetloc(""ST-^1STOP!^2&I'm dizzy!!"", ""obj_omega_book_manager_slash_Step_0_gml_16_0"");
			msgset_add(dizzytext, (x - 20) + 45, (y + 25) - 35, 13, 50, function()
			{
				seth_sprite(8075, 0, 0.16666666666666666);
				myblcon.depth = obj_omega_book_manager.depth - 1;
				myblcon.mywriter.depth = obj_omega_book_manager.depth - 2;
				scr_script_delayed(function()
				{
					with (obj_writer)
					{
						instance_destroy();
					}
				}, 90);
			});
			seth_balloon();
		}
		alarm[0] = -1;
		alarm[1] = -1;
		alarm[2] = -1;
		alarm[3] = -1;
		alarm[4] = -1;
		angle_speed_goal *= 4;
		angle_speed_change *= 8;
		seth_counter++;
	}
	if (global.turntimer < 5 && seth_counter < 3)
	{
		seth_counter++;
	}
	if (seth_counter == 3)
	{
		global.turntimer = 5;
		if (!i_ex(obj_writer))
		{
			with (obj_purple_enemy)
			{
				scr_lerpvar(""image_speed"", image_speed, 0, 15);
			}
			seth_counter++;
		}
	}
}
scroll_speed = scr_approach(scroll_speed, scroll_speed_goal, scroll_speed_change);
angle_speed = scr_approach(angle_speed, angle_speed_goal, angle_speed_change);
angle += (angle_speed / global.fps_scale);
with (obj_growtangle)
{
	image_angle = other.angle;
}
image_angle = obj_growtangle.image_angle;
repeat (6)
{
	with (obj_heart)
	{
		if (place_meeting(x, y, other.id))
		{
			x += lengthdir_x(1, point_direction(x, y, obj_growtangle.x, obj_growtangle.y));
			y += lengthdir_y(1, point_direction(x, y, obj_growtangle.x, obj_growtangle.y));
		}
	}
}
with (obj_omega_book)
{
	yoff += (other.scroll_speed / global.fps_scale);
	if (yoff < -255)
	{
		yoff += 510;
	}
	else if (yoff > 255)
	{
		yoff -= 510;
	}
	if (abs(yoff) > 127.5)
	{
		image_alpha_goal = clamp((1/30) * (30 - (abs(yoff) - 127.5)), 0, 1);
	}
	else
	{
		image_alpha_goal = 1;
	}
	x = obj_growtangle.x + (xoff * dsin(other.angle)) + (yoff * dcos(other.angle));
	y = (obj_growtangle.y + (xoff * dcos(other.angle))) - (yoff * dsin(other.angle));
	image_angle = other.angle - 90;
}
with (obj_omega_book_word)
{
	if (side)
	{
		xoff -= (4 / global.fps_scale);
	}
	else
	{
		xoff += (4 / global.fps_scale);
	}
	x = obj_growtangle.x + (xoff * dsin(other.angle)) + (yoff * dcos(other.angle));
	y = (obj_growtangle.y + (xoff * dcos(other.angle))) - (yoff * dsin(other.angle));
	image_angle = other.angle - 90;
	if (xoff < -150 || xoff > 150)
	{
		instance_destroy();
	}
}
");

