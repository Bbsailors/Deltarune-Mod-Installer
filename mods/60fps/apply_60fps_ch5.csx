{
	target = 1200;
}
if (!instance_exists(target))
{
	exit;
}
if (follow_mode == 1)
{
	var cx = camerax();
	var cy = cameray();
	if (x < (cx + 60))
	{
		x = scr_approach(x, cx + 60, 10);
	}
	if (x > (cx + 580))
	{
		x = scr_approach(x, cx + 580, 10);
	}
	if (abs(x - target.x) < 180)
	{
		if (target.x < (cx + 300))
		{
			target_side = 1;
		}
		else if (target.x > (cx + 340))
		{
			target_side = -1;
		}
	}
	if (target_side == -1)
	{
		x = scr_approach(x, cx + 60, 10);
	}
	else if (target_side == 1)
	{
		x = scr_approach(x, cx + 580, 10);
	}
	y = lerp(y, cy + 360, scr_fps_lerp_rate(0.7));
	if (x < (target.x - 100))
	{
		image_xscale = abs(image_xscale);
	}
	if (x > (target.x + 100))
	{
		image_xscale = -abs(image_xscale);
	}
}
else if (follow_mode == 2)
{
	var _check = false;
	if (instance_exists(obj_plat_player))
	{
		_check = scr_trigcheck_ext(extflag, 912);
	}
	if (!_check)
	{
		_check = scr_trigcheck(extflag);
	}
	if (_check)
	{
		image_alpha = scr_approach(image_alpha, 1, 0.1);
	}
	else
	{
		image_alpha = scr_approach(image_alpha, 0, 0.1);
	}
}
");

