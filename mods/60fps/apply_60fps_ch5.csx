	var yoffset = (-20 * (areasize - 1)) + jy + 10;
	var wx = (floor((x + (-20 * (facing - 2)) + xxx + xoffset) / 40) * 40) + 20;
	var wy = (floor((y + 10 + yy + 60 + yoffset) / 40) * 40) + 20;
