		}
		else
		{
			scr_plat_makecoins(x, y, -coindrops, 90, 90, 8, 4, depth);
		}
		coindrops = 0;
	}
	var _count = 24;
	var _step = 360 / _count;
	with (instance_create_depth(x, y, depth, obj_flowerdie))
	{
		speed = 10;
		sprite_index = spr_falling_petal;
		amount = _count;
		dir = other.dir;
