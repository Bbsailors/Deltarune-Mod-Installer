	scr_rudface(1, 2);
	global.msg[2] = stringsetloc(""\\E2* Anyhow^1, how's Dragon Blazers III^1?&* Beat it yet?/"", ""obj_rudy_slash_Step_0_gml_55_0"");
	scr_noeface(3, 4);
