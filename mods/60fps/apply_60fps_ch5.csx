		if (point_distance(rax, ray, ralsei.x, ralsei.y) > (2 / global.fps_scale))
		{
			ralsei.image_index += 0.0625 / global.fps_scale;
		}
		for (var i = 0; i < 20; i++)
		{
			if (i_ex(catmarker[i]))
