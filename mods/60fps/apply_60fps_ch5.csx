var yy = y;
draw_sprite_ext(timer_mainsprite, timer_frame, xx, yy, timer_scale, timer_scale, image_angle, c_white, image_alpha);
var _failtimer_in_seconds = max(0, timeleft) / 30;
var _ones = floor(_failtimer_in_seconds % 10);
var _tens = _failtimer_in_seconds div 10;
var _failtimer_ms = frac(_failtimer_in_seconds) * 100;
if (_failtimer_in_seconds >= 100)
{
	_ones = 9;
	_tens = 9;
	_failtimer_ms = 99;
}
var _frac1 = _failtimer_ms div 10;
var _frac2 = _failtimer_ms % 10;
if (timer_state == 1 || timer_showfinaltime > 0 || timer_cutscene_mode == 1)
{
	var _alpha = (timer_showfinaltime > 0) ? (1 - floor((timer_showfinaltime / 15) % 2)) : 1;
	var _digitcol = 16777215;
	draw_sprite_ext(timer_mainsprite, 1, xx, yy, timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	draw_sprite_ext(timer_mainsprite, 2, xx, yy, timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	draw_sprite_ext(spr_timer_digits, _ones, xx - (2 * timer_scale), yy - (5 * timer_scale), timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	if (_tens > 0)
	{
		draw_sprite_ext(spr_timer_digits, 10 + _tens, xx - (2 * timer_scale), yy - (5 * timer_scale), timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	}
	draw_sprite_ext(spr_timer_digits, 10 + _frac1, xx + (20 * timer_scale), yy - (5 * timer_scale), timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	if (timer_cutscene_mode == 0)
	{
		timer_showfinaltime--;
	}
	var numtens = remaining_bread div 10;
	var num = remaining_bread % 10;
	draw_sprite_ext(spr_timer_smalldigits, num, xx + 12, yy, timer_scale, timer_scale, image_angle, _digitcol, _alpha);
	draw_sprite_ext(spr_timer_smalldigits, numtens, xx + 4, yy, timer_scale, timer_scale, image_angle, _digitcol, _alpha);
}
if (best_time > 0 && count_up)
{
	var real_length = string_length(floor(best_time / 30));
	var decimal_length = string_length(floor(((best_time % 30) / 30) * 1000));
	var timestring = string_format(best_time / 30, real_length, max(3, decimal_length));
	draw_set_color(c_white);
	draw_set_alpha(1);
	draw_set_font(scr_84_get_font(""mainbig""));
	draw_text(xx, yy + 80, stringsetloc(""BEST: "", ""obj_plat_bread_manager_slash_Draw_0_gml_64_0"") + timestring);
}
");

