	if (timer >= climbrate)
	{
		timer = climbrate;
	}
	var newx = lerp_ease_out(remx, remx + xclimb, timer / climbrate, 1);
	var newy = lerp_ease_out(remy, remy + yclimb, timer / climbrate, 1);
	drawoffsety = -sin((timer / climbrate) * pi) * (2 * (((abs(xclimb) + abs(yclimb)) / 40) - 1));
	if (dir == 2 || dir == 0)
	{
