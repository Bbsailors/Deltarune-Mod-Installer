// Deltarune 60 FPS: applies the Chapter 5 code changes to a clean, unmodified data.win.
// Every edited code entry's finished GML is included below, so no other files are needed.
//
// Expected vanilla base: SHA-256 370dfd141d2955d5a1960122919b16e4092b52ffbb85fda541bc4680c6b3b85c
// The result matches the released 60 FPS build's code. Recompiling can normalize some
// formatting, so it may not be identical byte for byte.
//
// To run: in UndertaleModTool, open a clean vanilla Chapter 5 data.win, choose
// Scripts > Run other script, pick this file, then Save.
//
using System;
using UndertaleModLib;
using UndertaleModLib.Models;
using UndertaleModLib.Compiler;

// ---- base guard: refuse to run unless this looks like the exact expected vanilla ----
if (Data.Code.ByName("gml_Script_scr_fps_lerp_rate") != null)
    throw new Exception("scr_fps_lerp_rate already present -> this data.win looks already-modded. "
        + "Apply to a CLEAN vanilla Chapter 5 data.win (expected SHA-256 370dfd14...).");
// (Code.Count guard relaxed for modding on top)

var __g = new CodeImportGroup(Data);
int __applied = 0;
void Apply(string name, string gml)
{
    var code = Data.Code.ByName(name);
    if (code == null)
        throw new Exception("Entry not found (is this the right vanilla Chapter 5 data.win?): " + name);
    __g.QueueReplace(code, gml);
    __applied++;
}

int __created = 0;
// Creates a NEW object event (gml_Object_<object>_<EventType>_<subtype>) the mod adds and queues its
// GML in the same import group. Object names contain underscores, so the subtype and event name are
// peeled off the END of the entry name.
void Create(string name, string gml)
{
    const string PFX = "gml_Object_";
    if (!name.StartsWith(PFX)) throw new Exception("Create only supports object events: " + name);
    int lastUs = name.LastIndexOf('_');
    int prevUs = lastUs > 0 ? name.LastIndexOf('_', lastUs - 1) : -1;
    if (lastUs < 0 || prevUs < 0) throw new Exception("cannot parse new event name: " + name);
    string subStr = name.Substring(lastUs + 1);
    string evName = name.Substring(prevUs + 1, lastUs - prevUs - 1);
    string objName = name.Substring(PFX.Length, prevUs - PFX.Length);
    if (!uint.TryParse(subStr, out uint subtype)) throw new Exception("cannot parse event subtype in: " + name);
    EventType evType;
    if (!Enum.TryParse<EventType>(evName, out evType)) throw new Exception("unknown event type '" + evName + "' in: " + name);
    var obj = Data.GameObjects.ByName(objName);
    if (obj == null) throw new Exception("Object not found (is this the right vanilla Chapter 5 data.win?): " + objName);
    if (Data.Code.ByName(name) != null)
        throw new Exception("Entry already exists (is this data.win clean vanilla?): " + name);
    var evList = obj.Events[(int)evType];
    foreach (var ev in evList)
        if (ev.EventSubtype == subtype) throw new Exception(objName + " already has event " + evName + "_" + subStr);

    var code = new UndertaleCode();
    code.Name = Data.Strings.MakeString(name);
    Data.Code.Add(code);
    if (Data.CodeLocals != null && Data.CodeLocals.ByName(name) == null)
    {
        var locals = new UndertaleCodeLocals();
        locals.Name = code.Name;
        var argv = new UndertaleCodeLocals.LocalVar();
        argv.Name = Data.Strings.MakeString("arguments");
        argv.Index = 0;
        locals.Locals.Add(argv);
        Data.CodeLocals.Add(locals);
        code.LocalsCount = 1;
    }
    var newEv = new UndertaleGameObject.Event();
    newEv.EventSubtype = subtype;
    var action = new UndertaleGameObject.EventAction();
    action.ActionName = code.Name;
    action.CodeId = code;
    newEv.Actions.Add(action);
    evList.Add(newEv);
    int links = 0;
    foreach (var ev in evList)
        foreach (var act in ev.Actions)
            if (act.CodeId != null && act.CodeId.Name.Content == name) links++;
    if (links != 1) throw new Exception(name + " linked " + links + " times, expected 1");
    __g.QueueReplace(code, gml);
    __created++;
}

Apply("gml_GlobalScript___init_global", @"function __init_global()
{
	layer_force_draw_depth(true, 0);
	draw_set_colour(c_black);
	room_speed = 60;
	global.TARGET_FPS = 60;
	global.fps_scale = global.TARGET_FPS / 30;
	global.fps_debug = 0;
	global.stick_lx = 0;
	global.stick_ly = 0;
	global.stick_mag = 0;
	global.fps_speed_mode = 0;
	global.fps_speed_active = 0;
	global.plat_cam_subx = 0;
	global.plat_cam_suby = 0;
	global.hires_k = 2;
}

function scr_fps_lerp_rate(arg0)
{
	arg0 = clamp(arg0, 0, 0.999);
	return 1 - power(1 - arg0, 1 / global.fps_scale);
}

function scr_smoothcam_on()
{
	return !global.is_console && global.flag[967] != 1;
}
");

Apply("gml_GlobalScript_c_soundplay_wait", @"function c_soundplay_wait(arg0)
{
	c_cmd(""soundplay"", arg0, 0, 0, 0);
	c_wait(round(audio_sound_length(arg0) * 30));
}

function c_playsound_wait(arg0)
{
	c_soundplay_wait(arg0);
}
");

Apply("gml_GlobalScript_c_wait", @"function c_wait(arg0)
{
	c_cmd(""wait"", round(arg0 * global.fps_scale), 0, 0, 0);
}
");

Apply("gml_GlobalScript_c_wait_soundlength", @"function c_wait_soundlength(arg0)
{
	c_wait(round(audio_sound_length(arg0) * 30));
}
");

Apply("gml_GlobalScript_draw_enemyaura", @"function draw_enemyaura(arg0 = true, arg1 = sprite_width / 2, arg2 = 0, arg3 = false, arg4 = true)
{
	if (!sprite_exists(sprite_index))
	{
		exit;
	}
	if (!variable_instance_exists(id, ""drawaura""))
	{
		drawaura = true;
	}
	if (!variable_instance_exists(id, ""facing""))
	{
		facing = 0;
	}
	if (!variable_instance_exists(id, ""drawsiner""))
	{
		drawsiner = 0;
	}
	if (!variable_instance_exists(id, ""auraalph""))
	{
		auraalph = 1;
	}
	if (!variable_instance_exists(id, ""fakescale""))
	{
		fakescale = 2;
	}
	var targ = -1;
	with (obj_mainchara)
	{
		targ = x + 18;
	}
	if (arg0 && targ != -1)
	{
		if (targ > arg1)
		{
			facing = 1;
		}
		else
		{
			facing = 0;
		}
	}
	if (drawaura)
	{
		specialspritecase = 0;
		drawx = 0;
		fakescale = abs(fakescale);
		if (facing == 1)
		{
			fakescale = -abs(fakescale);
			drawx = arg2;
		}
		drawsiner += (0.25 / global.fps_scale);
		var remx = x;
		x += drawx;
		superscalexb = 1;
		drawx = 0;
		drawscale = 1;
		xoff = 0;
		if (facing == 1)
		{
			drawscale = -1;
		}
		drawsiner += (0.25 / global.fps_scale);
		tempx = x;
		x += drawx;
		superscalex = 0;
		superdrawx = 0;
		superscalexb = 1;
		if (facing == 1)
		{
			superscalex = -4;
			superscalexb = -1;
			superdrawx = -sprite_width * 2;
			xoff = 0;
		}
		gpu_set_blendmode(bm_add);
		for (i = 0; i < 5; i++)
		{
			var aura = (i * 9) + ((drawsiner * 3) % 9);
			var aurax = (aura * 0.75) + (sin(aura / 4) * 4);
			var auray = 45 * scr_ease_in(aura / 45, 1);
			var aurayscale = min(80 / sprite_height, 1);
			draw_sprite_ext(sprite_index, image_index, x - xoff - ((aurax / 180) * drawscale * sprite_width), y - ((auray / 82) * sprite_height * aurayscale), (image_xscale + (aurax / 36)) * drawscale, image_yscale + ((auray / 36) * aurayscale), image_angle, c_red, image_alpha * (1 - (auray / 45)) * 0.5 * auraalph);
		}
		gpu_set_blendmode(bm_normal);
		var xmult = min((70 / sprite_width) * 4, 4);
		var ymult = min((80 / sprite_height) * 5, 5);
		var ysmult = min((80 / sprite_height) * 0.2, 0.2);
		draw_sprite_ext_centerscale(sprite_index, image_index, (x - xoff) + superdrawx + (sin(drawsiner / 5) * xmult), y + (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale + (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2 * auraalph);
		draw_sprite_ext_centerscale(sprite_index, image_index, ((x - xoff) + superdrawx) - (sin(drawsiner / 5) * xmult), y - (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale - (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2 * auraalph);
		scr_draw_outline_ext(sprite_index, image_index, x - xoff, y, image_xscale * drawscale, image_yscale, image_angle, c_red, image_alpha * 0.3, 2 * auraalph);
		x = tempx;
		mymidx = x + (sprite_width / 2);
		mymidy = y + ((bbox_bottom - y) / 2);
		x = remx;
	}
	if (!arg4)
	{
		exit;
	}
	if (facing == 0)
	{
		draw_sprite_ext(sprite_index, image_index, x, y, 2, 2, 0, image_blend, image_alpha);
	}
	else
	{
		draw_sprite_ext(sprite_index, image_index, x + arg2, y, -2, 2, 0, image_blend, image_alpha);
	}
}
");

Apply("gml_GlobalScript_mus_fade", @"function mus_fade(arg0, arg1)
{
	audio_sound_gain(arg0, 0, (arg1 * 1000) / 30);
}
");

Apply("gml_GlobalScript_mus_volume", @"function mus_volume(arg0, arg1, arg2)
{
	audio_sound_gain(arg0, arg1 * global.flag[16], (arg2 * 1000) / 30);
}
");

Apply("gml_GlobalScript_scr_84_debug", @"function scr_84_debug(arg0)
{
	if (arg0)
	{
		return 0;
	}
	var _x = 4;
	var _y = 4;
	var _line = 14;
	draw_set_alpha(0.7);
	draw_set_color(c_black);
	if (!variable_global_exists(""dbg_panel_h""))
	{
		global.dbg_panel_h = 80;
	}
	draw_rectangle(_x - 2, _y - 2, 340, global.dbg_panel_h, false);
	draw_set_alpha(1);
	draw_set_font(fnt_main);
	draw_set_halign(fa_left);
	draw_set_color(c_white);
	if (room_speed > 60)
	{
		draw_set_color(c_lime);
		var _spd_label = ""2X"";
		if (room_speed >= 240)
		{
			_spd_label = ""4X"";
		}
		draw_text(_x, _y, ""=== 60FPS DEBUG === ["" + _spd_label + "" SPEED]"");
		draw_set_color(c_white);
	}
	else
	{
		draw_text(_x, _y, ""=== 60FPS DEBUG ==="");
	}
	_y += _line;
	draw_text(_x, _y, ""Room: "" + string(room) + "" ("" + room_get_name(room) + "")"");
	_y += _line;
	draw_text(_x, _y, ""FPS: "" + string(floor(fps_real)) + "" / "" + string(room_speed) + ""  scale:"" + string(global.fps_scale));
	_y += _line;
	draw_set_color(c_aqua);
	if (i_ex(obj_gamecontroller))
	{
		var _gpa = obj_gamecontroller.gamepad_active;
		var _gpi = obj_gamecontroller.gamepad_id;
		var _gpc = gamepad_get_device_count();
		var _gp_conn_str = """";
		for (var _gpi2 = 0; _gpi2 < 8; _gpi2++)
		{
			_gp_conn_str += (gamepad_is_connected(_gpi2) ? ""1"" : ""0"");
		}
		draw_text(_x, _y, ""GP count:"" + string(_gpc) + "" id:"" + string(_gpi) + "" active:"" + string(_gpa) + "" slots:"" + _gp_conn_str);
		_y += _line;
		draw_text(_x, _y, ""GP type: "" + string(global.gamepad_type));
		_y += _line;
	}
	else
	{
		draw_text(_x, _y, ""GP: obj_gamecontroller not found"");
		_y += _line;
	}
	draw_set_color(c_white);
	draw_text(_x, _y, ""interact:"" + string(global.interact) + "" plot:"" + string(global.plot) + "" facing:"" + string(global.facing));
	_y += _line;
	if (instance_exists(obj_cutscene_master))
	{
		draw_set_color(c_yellow);
		var cm = instance_find(obj_cutscene_master, 0);
		draw_text(_x, _y, ""CUTSCENE active id:"" + string(cm));
		_y += _line;
	}
	if (instance_exists(obj_noellehouse_dess))
	{
		draw_set_color(c_fuchsia);
		var nd = instance_find(obj_noellehouse_dess, 0);
		draw_text(_x, _y, ""Dess con:"" + string(variable_instance_get(nd, ""con"", ""?"")) + "" cust:"" + string(variable_instance_get(nd, ""customcon"", ""?"")));
		_y += _line;
		var kft = variable_instance_get(nd, ""kris_fall_timer"", -1);
		var hft = variable_instance_get(nd, ""heart_fall_timer"", -1);
		if (kft >= 0 || hft >= 0)
		{
			draw_text(_x, _y, ""  kft:"" + string_format(kft, 4, 1) + "" hft:"" + string_format(hft, 4, 1));
			_y += _line;
		}
		draw_text(_x, _y, ""  hit_heart:"" + string(variable_instance_get(nd, ""hit_heart"", ""?"")) + "" bed_hide:"" + string(variable_instance_get(nd, ""kris_bed_hide"", ""?"")));
		_y += _line;
	}
	if (instance_exists(obj_anim_custom))
	{
		draw_set_color(c_yellow);
		var ac = instance_find(obj_anim_custom, 0);
		draw_text(_x, _y, ""Anim active:"" + string(variable_instance_get(ac, ""anim_active"", ""?"")) + "" idx:"" + string(variable_instance_get(ac, ""anim_index"", ""?"")) + "" t:"" + string_format(variable_instance_get(ac, ""anim_timer"", 0), 5, 2));
		_y += _line;
	}
	var lv_count = instance_number(obj_lerpvar);
	var sd_count = instance_number(obj_script_delayed);
	if (lv_count > 0 || sd_count > 0)
	{
		draw_set_color(c_white);
		draw_text(_x, _y, ""Lerpvars:"" + string(lv_count) + ""  Delayed:"" + string(sd_count));
		_y += _line;
	}
	draw_set_color(c_gray);
	draw_text(_x, _y, ""Instances: "" + string(instance_count));
	if (variable_global_exists(""rb_debug_timer"") && global.rb_debug_timer > 0)
	{
		draw_set_halign(fa_center);
		draw_set_valign(fa_top);
		draw_set_font(fnt_main);
		var _rb_cx = display_get_gui_width() / 2;
		var _rb_cy = 40;
		draw_set_alpha(0.85);
		draw_set_color(c_black);
		draw_rectangle(_rb_cx - 110, _rb_cy - 6, _rb_cx + 110, _rb_cy + 50, false);
		draw_set_alpha(1);
		draw_set_color(global.rb_debug_color);
		draw_text(_rb_cx, _rb_cy, ""RUDE BUSTER: "" + string(global.rb_debug_text));
		draw_set_color(c_white);
		draw_text(_rb_cx, _rb_cy + 20, ""tier:"" + string(global.rb_debug_tier) + "" "" + string(global.rb_debug_chosen) + ""/"" + string(global.rb_debug_final));
		global.rb_debug_timer -= 1;
		draw_set_halign(fa_left);
		draw_set_valign(fa_top);
	}
	global.dbg_panel_h = _y + _line + 4;
	draw_set_color(c_white);
}
");

Apply("gml_GlobalScript_scr_act_charsprite", @"function scr_act_charsprite(arg0, arg1, arg2, arg3)
{
	_charactor = arg0;
	_charinstance = obj_herokris;
	if (_charactor == ""noelle"")
	{
		_charinstance = obj_heronoelle;
		_charnum = 4;
	}
	if (_charactor == ""ralsei"")
	{
		_charinstance = obj_heroralsei;
		_charnum = 3;
	}
	if (_charactor == ""susie"")
	{
		_charinstance = obj_herosusie;
		_charnum = 2;
	}
	if (_charactor == ""kris"")
	{
		_charinstance = obj_herokris;
		_charnum = 1;
	}
	__returnvalue = _charactsprite[_charnum];
	if (i_ex(_charinstance))
	{
		with (_charinstance)
		{
			image_alpha = 0;
			state = 0;
			global.faceaction[myself] = 0;
		}
		_charactsprite[_charnum] = scr_dark_marker(_charinstance.x, _charinstance.y, arg1);
		with (_charactsprite[_charnum])
		{
			depth = 20 - (__view_get(e__VW.YView, 0) / 40);
			scr_oflash();
			if (arg2 > 0 && arg3 == 0)
			{
				scr_animate(0, 0, arg2);
			}
			if (arg2 > 0 && arg3 == 1)
			{
				image_speed = arg2 / global.fps_scale;
			}
			a = scr_afterimage();
			a.hspeed = 2.5 / global.fps_scale;
			a.depth = depth + 1;
			b = scr_afterimage();
			b.image_alpha = 0.6;
			b.hspeed = 5 / global.fps_scale;
			b.depth = depth + 2;
		}
		__returnvalue = _charactsprite[_charnum];
	}
	return __returnvalue;
}

enum e__VW
{
	XView,
	YView,
	WView,
	HView,
	Angle,
	HBorder,
	VBorder,
	HSpeed,
	VSpeed,
	Object,
	Visible,
	XPort,
	YPort,
	WPort,
	HPort,
	Camera,
	SurfaceID
}
");

