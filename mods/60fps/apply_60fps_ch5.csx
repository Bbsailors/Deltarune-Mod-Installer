Apply("gml_Object_obj_overworld_kawkaw_Step_0", @"alertradius = 60;
if (global.flag[encounterflag] != 0)
{
	alertradius = -1;
}
b1 = [x + 14, y + 20];
b2 = [x + 60, y + 60];
if (!variable_instance_exists(id, ""boundinit""))
{
	if (encounterflag == 1476)
	{
		leftbound = room_width;
		rightbound = 0;
		var bounds = findspriteinfo_all(7121, ""DEBUG_kawkaw"");
		for (var i = 0; i < array_length(bounds); i++)
		{
			leftbound = min(leftbound, bounds[i].x);
			rightbound = max(rightbound, bounds[i].x);
		}
	}
	boundinit = 1;
}
if (con == -1)
{
	var flag = global.flag[encounterflag];
	for (var i = 0; i < 4; i++)
	{
		if (position_index == i)
		{
			continue;
		}
		with (obj_trigger)
		{
			if (extflag2 == ""norepeat"" && flag > 0)
			{
				continue;
			}
			if (place_meeting(x, y, obj_mainchara) && extflag == (""kawkaw_"" + string(i)))
			{
				with (other)
				{
					var gm = scr_genmarker(""kawkaw_"" + string(i));
					x = gm.x;
					y = gm.y;
					xprevious = x;
					position_index = i;
					snd_play(snd_wing, 1, 1.5);
					scr_depth();
				}
			}
		}
	}
}
if (con == 0 && global.interact == 0)
{
	var lerpspeed = 0.0625;
	var slowspeed = 0.25;
	var maxspeed = 12;
	if (dir == 0)
	{
		if (b2[0] >= rightbound)
		{
			hsp = lerp(hsp, 0, slowspeed);
			if (abs(hsp) < 1)
			{
				hsp = 0;
				dir = 1;
			}
		}
		else
		{
			hsp = lerp(hsp, maxspeed, lerpspeed);
		}
	}
	else if (dir == 1)
	{
		if (b1[0] <= leftbound)
		{
			hsp = lerp(hsp, 0, slowspeed);
			if (abs(hsp) < 1)
			{
				hsp = 0;
				dir = 0;
			}
		}
		else
		{
			hsp = lerp(hsp, -maxspeed, lerpspeed);
		}
	}
}
if (con < 10)
{
	var col = collision_rectangle(b1[0], b1[1], b2[0], b2[1], obj_mainchara, false, false);
	if (instance_exists(col))
	{
		global.flag[54] = encounterflag;
		snd_play(snd_tensionhorn);
		snd_play_delay(snd_tensionhorn, 10, undefined, 1.1);
		image_speed = 0;
		emarker = scr_marker_frominstance(id);
		emarker.image_speed = 0;
		emarker.depth = 5000;
		emarker.image_alpha = 0;
		emarker.x += 10;
		emarker.y -= 4;
		y -= 4;
		x += 10;
		image_index = 0;
		emarker.image_index = 0;
		with (emarker)
		{
			scr_lerpvar(""image_alpha"", 0, 1, 10);
		}
		scr_delay_var(""visible"", false, 10);
		scr_lerpvar(""auraalph"", 1, 0, 10);
		con = 10;
		global.interact = 1;
	}
}
if (con == 10)
{
	timer += (1 / global.fps_scale);
	if (timer == 25)
	{
		scr_battle(encounterno, false, emarker);
		instance_destroy();
	}
}
if (global.interact == 0)
{
	x += hsp;
	y += vsp;
}
");

