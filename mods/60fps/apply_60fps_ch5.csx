	}
}
if (target_enemy == ""green"")
{
	if (timer == 57)
	{
		scr_move_to_point_over_time(xstart, ystart, 7);
	}
	if (timer == 65)
	{
		instance_destroy();
	}
}
draw_self();
");

Apply("gml_Object_obj_green_enemy_Draw_0", @"scr_enemy_drawhurt_generic();
if (state == 0)
{
	fsiner += (1 / global.fps_scale);
