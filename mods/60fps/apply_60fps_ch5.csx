Apply("gml_Object_obj_plat_camera_Create_0", @"target = -4;
stop = 0;
lerptime_v = 15;
lerptime_h = 15;
lerptimemax = 15;

reset_all_lerps = function()
{
	lerptime_h = 0;
	lerptime_v = 0;
	lerptimemax = 15;
};

zone_lerpstrength = 1;
zone = -4;
nudgex = 0;
nudgey = 0;
lerpinit = 0;
nudgerate = 999;
last_ideal_y = 0;
last_ideal_y_real = 0;
y_stick = 1;
y_stick_lerp = 1;
wants_ideal_y = false;
shakex = 0;
shakey = 0;
just_started = true;
oldgoalx = -999;
oldgoaly = -999;
cutscene = false;
min_x = -1;
max_x = -1;
scroll_mode = false;
autoscroll_Speed = 3.46;
extra_targets = [];
markers = [];
extra_target_lerp = 1;
__sc_valid = false;
__sc_fracx = 0;
__sc_fracy = 0;
__sc_floorx = 0;
__sc_floory = 0;
__sc_px = 0;
__sc_py = 0;

add_extra_target = function(arg0)
{
	extra_target_lerp = 0;
	if (is_array(arg0))
	{
		for (var i = 0; i < array_length(arg0); i++)
		{
			array_push(extra_targets, arg0[i]);
		}
	}
	else
	{
		array_push(extra_targets, arg0);
	}
};

remove_extra_target = function(arg0)
{
	if (is_array(arg0))
	{
		for (var j = 0; j < array_length(arg0); j++)
		{
			for (var i = 0; i < array_length(extra_targets); i++)
			{
				if (arg0[j].id == extra_targets[i].id)
				{
					remove_extra_target_idx(i, false);
					break;
				}
			}
		}
	}
	else
	{
		for (var i = 0; i < array_length(extra_targets); i++)
		{
			if (arg0.id == extra_targets[i].id)
			{
				remove_extra_target_idx(i);
				break;
			}
		}
	}
};

remove_extra_target_idx = function(arg0)
{
	extra_target_lerp = 0;
	array_delete(extra_targets, arg0, 1);
};

clear_extra_targets = function()
{
	extra_target_lerp = 0;
	extra_targets = [];
};

xoffset = 0;
yoffset = 0;

update_camera = function()
{
	var scroll_x;
	if (cutscene)
	{
		if (global.pause_plat)
		{
			exit;
		}
	}
	else
	{
		scroll_x = x;
		if (!instance_exists(target) && instance_exists(obj_plat_player))
		{
			target = instance_find(obj_plat_player, 0);
			lerptime_h = lerptimemax;
			lerptime_v = lerptimemax;
			camera_set_view_target(view_camera[0], self);
			camera_set_view_border(view_camera[0], 640, 480);
		}
		if (instance_exists(target))
		{
			if (target.visible == 0)
			{
				xoffset = 0;
				yoffset = 0;
				with (obj_plat_npc)
				{
					if (visible == 1 && name == ""kris"")
					{
						other.target = self;
						if (variable_instance_exists(id, ""create_x_diff""))
						{
							other.xoffset = create_x_diff;
							other.yoffset = create_y_diff;
						}
						break;
					}
				}
				with (obj_plat_player)
				{
					if (visible == 1)
					{
						other.target = self;
						break;
					}
				}
			}
			if (target.object_index == obj_plat_player)
			{
				xoffset = 0;
				yoffset = 0;
			}
			var tx = x;
			var ty = y;
			if (global.pause_plat)
			{
				exit;
			}
			lerptime_h = min(lerptime_h + (zone_lerpstrength / global.fps_scale), lerptimemax);
			lerptime_v = min(lerptime_v + (zone_lerpstrength / global.fps_scale), lerptimemax);
			extra_target_lerp = min(extra_target_lerp + (0.05 / global.fps_scale), 1);
			tx = target.x + xoffset;
			ty = target.y + yoffset;
			if (global.fps_scale > 1 && !scr_smoothcam_on() && target.object_index == obj_plat_player)
			{
				tx = floor(target.x + 0.5) + xoffset;
			}
			with (obj_plat_player)
			{
				if (grounded)
				{
					if (place_meeting(x, y, obj_plat_cam_steadyzone))
					{
						other.wants_ideal_y = 1;
						other.y_stick = 2;
						other.y_stick_lerp = 1;
					}
					else
					{
						other.wants_ideal_y = scr_approach(other.wants_ideal_y, 0, 0.05);
					}
				}
				else if (other.wants_ideal_y < 1)
				{
					other.wants_ideal_y = scr_approach(other.wants_ideal_y, 0, 0.05);
				}
			}
			if (array_get(scr_platswap_yscale(), 0) != 1 || !lerpinit)
			{
				last_ideal_y_real = target.y;
				lerpinit = true;
				last_ideal_y = target.y;
				y_stick = 2;
				y_stick_lerp = 1;
			}
			if (wants_ideal_y > 0)
			{
				if (variable_instance_get(target.id, ""grounded""))
				{
					last_ideal_y_real = target.y;
					if (y_stick != 2)
					{
						y_stick_lerp = 0;
						y_stick = 2;
					}
				}
				else if (y_stick == 1)
				{
					last_ideal_y_real = target.y;
				}
				else
				{
					y_stick = 0;
					if (last_ideal_y < (target.y - 20) || last_ideal_y > (target.y + 160))
					{
						y_stick = 1;
						y_stick_lerp = 0;
						last_ideal_y_real = target.y;
					}
					if (variable_instance_get(target.id, ""jump_boost""))
					{
						y_stick = 1;
						y_stick_lerp = 0;
						last_ideal_y_real = target.y;
					}
				}
				last_ideal_y = lerp(last_ideal_y, last_ideal_y_real, 1 - power(1 - ease_inout_quad(min(y_stick_lerp, 1), 0, 1, 1), 1 / global.fps_scale));
				y_stick_lerp += ((scr_smoothcam_on() ? 0.21 : 0.07) / global.fps_scale);
				ty = lerp(ty, last_ideal_y, wants_ideal_y);
			}
			var num = 1;
			var len = array_length(extra_targets);
			for (i = 0; i < len; i++)
			{
				with (extra_targets[i])
				{
					if (!variable_instance_exists(id, ""___camtarget""))
					{
						___camtarget = instance_create(x, y, obj_marker);
						___camtarget.lerp = 0;
						___camtarget.target = id;
						array_push(other.markers, ___camtarget);
					}
				}
			}
			len = array_length(markers);
			var i = len - 1;
			for (; i >= 0; i--)
			{
				var m = markers[i];
				if (instance_exists(m.target))
				{
					m.lerp = scr_approach(m.lerp, 1, 0.05);
					x = m.target.bbox_left + (0.5 * (m.target.bbox_right - m.target.bbox_left));
					y = m.target.bbox_top + (0.5 * (m.target.bbox_bottom - m.target.bbox_top));
				}
				else
				{
					m.lerp = scr_approach(m.lerp, 0, 0.05);
					if (m.lerp <= 0)
					{
						array_delete(markers, i, 1);
						instance_destroy(m);
						continue;
					}
				}
				var falloff = clamp01(((300 - point_distance(target.x, target.y, m.x, m.y)) + 100) / 300) * 0.75;
				falloff *= (ease_inout_sine(m.lerp, 0, 1, 1) * extra_target_lerp);
				tx += (m.x * falloff);
				ty += (m.y * falloff);
				num += falloff;
			}
			tx /= num;
			ty /= num;
			var _goalx = tx + nudgex;
			var _goaly = ty + nudgey;
			if (global.pause_plat)
			{
				_goalx = tx;
				_goaly = ty;
			}
			with (target)
			{
				var _zone = instance_place(x, y, obj_plat_cam_clampzone);
				if (i_ex(_zone))
				{
					var roomw = room_width;
					var roomh = room_height;
					var vieww = view_wport[0];
					var viewh = view_hport[0];
					var lclamp = 0;
					var rclamp = roomw - vieww;
					var uclamp = 0;
					var dclamp = roomh - viewh;
					if (_zone.xmin != -4)
					{
						lclamp = _zone.xmin;
					}
					if (_zone.xmax != -4)
					{
						rclamp = _zone.xmax;
					}
					if (_zone.ymin != -4)
					{
						uclamp = _zone.ymin;
					}
					if (_zone.ymax != -4)
					{
						dclamp = _zone.ymax;
					}
					if (_zone.mode != ""Constant"" && _zone.gradual_extflag != """")
					{
						with (obj_plat_cam_clampzone)
						{
							if (extflag == _zone.gradual_extflag)
							{
								var zonelerp = 0;
								var xx = other.x;
								var yy = other.y;
								if (_zone.mode == ""Gradual - Left"")
								{
									zonelerp = 1 - inverselerp(_zone.bbox_left, _zone.bbox_right, xx);
								}
								else if (_zone.mode == ""Gradual - Up"")
								{
									zonelerp = 1 - inverselerp(_zone.bbox_top, _zone.bbox_bottom, yy);
								}
								else if (_zone.mode == ""Gradual - Right"")
								{
									zonelerp = inverselerp(_zone.bbox_left, _zone.bbox_right, xx);
								}
								else if (_zone.mode == ""Gradual - Down"")
								{
									zonelerp = inverselerp(_zone.bbox_top, _zone.bbox_bottom, yy);
								}
								zonelerp = clamp01(zonelerp);
								if (_zone.xmin != -4 && xmin != -4)
								{
									lclamp = lerp(_zone.xmin, xmin, zonelerp);
								}
								if (_zone.xmax != -4 && xmax != -4)
								{
									rclamp = lerp(_zone.xmax, xmax, zonelerp);
								}
								if (_zone.ymin != -4 && ymin != -4)
								{
									uclamp = lerp(_zone.ymin, ymin, zonelerp);
								}
								if (_zone.ymax != -4 && ymax != -4)
								{
									dclamp = lerp(_zone.ymax, ymax, zonelerp);
								}
								break;
							}
						}
					}
					var owclamp_l = 320;
					var owclamp_r = room_width - 320;
					var owclamp_t = 240;
					var owclamp_b = room_height - 240;
					var ys = array_get(scr_platswap_yscale(), 0);
					if (ys < 1)
					{
						with (obj_platswap_statue)
						{
							if (scr_onscreen(self))
							{
								with (instance_place(x, y, obj_camera_clamper))
								{
									if (xmin != -4)
									{
										owclamp_l = xmin + 320;
									}
									if (xmax != -4)
									{
										owclamp_r = xmax + 320;
									}
									if (ymin != -4)
									{
										owclamp_t = ymin + 240;
									}
									if (ymax != -4)
									{
										owclamp_b = ymax + 240;
									}
								}
							}
						}
					}
					_goalx = lerp(clamp(_goalx, owclamp_l, owclamp_r), clamp(_goalx, lclamp + 320, rclamp + 320), ys);
					_goaly = lerp(clamp(_goaly, owclamp_t, owclamp_b), clamp(_goaly, uclamp + 240, dclamp + 240), ys);
					if (_zone.lerpstrength < 0)
					{
						other.zone_lerpstrength = 1;
					}
					else
					{
						other.zone_lerpstrength = _zone.lerpstrength;
					}
				}
				with (other)
				{
					if (zone != _zone)
					{
						zone = _zone;
						if (oldgoalx != (_goalx - target.x - nudgex))
						{
							if (!just_started)
							{
								lerptime_h = 0;
							}
						}
						if (oldgoaly != (_goaly - target.y - nudgey))
						{
							if (!just_started)
							{
								lerptime_v = 0;
							}
						}
					}
					oldgoalx = _goalx - target.x - nudgex;
					oldgoaly = _goaly - target.y - nudgey;
				}
				_zone = instance_place(x, y, obj_plat_cam_nudgezone);
				var _rate = 8;
				if (i_ex(_zone))
				{
					_rate = _zone.nudgerate;
					if (other.nudgerate == 999)
					{
						_rate = 999;
						other.nudgerate = 8;
					}
					var nx = _zone.nudgex;
					var ny = _zone.nudgey;
					if (_zone.mode == ""Gradual - Left"")
					{
						nx = lerp(0, nx, 1 - clamp01((x - _zone.bbox_left) / (_zone.bbox_right - _zone.bbox_left)));
						ny = lerp(0, ny, 1 - clamp01((x - _zone.bbox_left) / (_zone.bbox_right - _zone.bbox_left)));
					}
					if (_zone.mode == ""Gradual - Right"")
					{
						nx = lerp(0, nx, clamp01((x - _zone.bbox_left) / (_zone.bbox_right - _zone.bbox_left)));
						ny = lerp(0, ny, clamp01((x - _zone.bbox_left) / (_zone.bbox_right - _zone.bbox_left)));
					}
					if (_zone.mode == ""Gradual - Up"")
					{
						nx = lerp(0, nx, 1 - clamp01((y - _zone.bbox_top) / (_zone.bbox_bottom - _zone.bbox_top)));
						ny = lerp(0, ny, 1 - clamp01((y - _zone.bbox_top) / (_zone.bbox_bottom - _zone.bbox_top)));
					}
					if (_zone.mode == ""Gradual - Down"")
					{
						nx = lerp(0, nx, clamp01((y - _zone.bbox_top) / (_zone.bbox_bottom - _zone.bbox_top)));
						ny = lerp(0, ny, clamp01((y - _zone.bbox_top) / (_zone.bbox_bottom - _zone.bbox_top)));
					}
					other.nudgex = scr_approach(other.nudgex, nx, _rate);
					other.nudgey = scr_approach(other.nudgey, ny, _rate);
				}
				else
				{
					if (other.nudgerate == 999)
					{
						_rate = 999;
						other.nudgerate = 8;
					}
					other.nudgex = scr_approach(other.nudgex, 0, _rate);
					other.nudgey = scr_approach(other.nudgey, 0, _rate);
				}
			}
			x = lerp(x, _goalx, 1 - power(1 - (lerptime_h / lerptimemax), 1 / global.fps_scale));
			y = lerp(y, _goaly, 1 - power(1 - (lerptime_v / lerptimemax), 1 / global.fps_scale));
		}
		else if (i_ex(obj_mainchara))
		{
			obj_mainchara.nudgex = nudgex;
			obj_mainchara.nudgey = nudgey;
			instance_destroy();
		}
	}
	if (min_x != -1)
	{
		x = max(x, min_x);
	}
	if (max_x != -1)
	{
		x = min(x, max_x);
	}
	just_started = false;
	x = clamp(x, 320, room_width - 320);
	y = clamp(y, 240, room_height - 240);
	if (instance_exists(obj_plat_player))
	{
		if (obj_plat_player.fallen_in_pit && scroll_mode)
		{
			scroll_mode = false;
		}
	}
	if (scroll_mode && !global.pause_plat)
	{
		x = scroll_x + ((scr_smoothcam_on() ? ceil(autoscroll_Speed) : autoscroll_Speed) / global.fps_scale);
	}
	x += floor(shakex * 0.5);
	y += floor(shakey * 0.5);
	shakex = scr_approach(-shakex, 0, 1);
	shakey = scr_approach(-shakey, 0, 1);
	if (!scr_smoothcam_on())
	{
		x = ceil(x);
		y = ceil(y);
	}
};
");

Apply("gml_Object_obj_plat_camera_Step_2", @"if (stop)
{
	global.plat_cam_subx = 0;
	global.plat_cam_suby = 0;
	__sc_valid = false;
	exit;
}
update_camera();
if (scr_smoothcam_on())
{
	var _dx = (abs(x - __sc_px) < 0.0625) ? round(x) : x;
	var _dy = (abs(y - __sc_py) < 0.0625) ? round(y) : y;
	__sc_px = x;
	__sc_py = y;
	__sc_fracx = x;
	__sc_fracy = y;
	var __sc_q = 640 / surface_get_width(application_surface);
	__sc_floorx = floor(_dx / __sc_q) * __sc_q;
	__sc_floory = floor(_dy / __sc_q) * __sc_q;
	__sc_valid = true;
	global.plat_cam_subx = _dx - __sc_floorx;
	global.plat_cam_suby = _dy - __sc_floory;
	x = __sc_floorx;
	y = __sc_floory;
}
else
{
	__sc_valid = false;
	global.plat_cam_subx = 0;
	global.plat_cam_suby = 0;
}
");

Apply("gml_Object_obj_plat_coin_Create_0", @"event_inherited();
image_speed = 0.2 / global.fps_scale;
image_xscale = 2;
image_yscale = 2;
performs_culling_checks = true;
cull_buffer = 10;
init = 0;
timer = 0;
physics = 0;
wallcollision = 0;
placed_in_room = false;
draw_with_outline = false;
afterimage_struct = 
{
	image_index: image_index,
	image_alpha: 1,
	custom_data: 1
};
landlimit = 5;
collect_cooldown = 10;
homing_on_player = true;
homingtimer = 0;
homing_phase = 0;
homing_phase_set = false;
windimmune = true;
is_pink = false;

make_pink = function()
{
	is_pink = true;
	sprite_index = spr_coin_pink;
	paused_spr = sprite_index;
};

afterimage_particle_system = instance_create_depth(x, y, depth + 1, obj_custom_particle_system);
color = c_gray;
if (flag > 0)
{
	var bust = scr_get_bitmask_value(global.flag[flag], flagbit, 1);
	if (ignore_flag_if_plot_greater > 0 && global.plot >= ignore_flag_if_plot_greater)
	{
		bust = 0;
	}
	if (bust)
	{
		instance_destroy(self);
	}
}
if (!appear_condition)
{
	instance_destroy();
}

collect = function(arg0)
{
	var str = ""F$"";
	if (!instance_exists(arg0))
	{
		arg0 = id;
	}
	if (is_pink)
	{
		str = ""P$"";
		global.flag[1312] += 1;
		snd_stop(snd_pink_coin);
		snd_play(snd_pink_coin);
	}
	else
	{
		global.flag[1411] += coinvalue;
		var p = 1;
		with (obj_plat_player)
		{
			if (coinpitch < 1.3)
			{
				if (current_time < (last_coinsource + 500))
				{
					coinpitch *= 1.059;
				}
				else
				{
					coinpitch = 1;
				}
			}
			last_coinsource = current_time;
			p = coinpitch;
		}
		if (coinvalue > 1)
		{
			snd_stop(snd_flowery_coin_big);
			snd_play(snd_flowery_coin_big);
		}
		else
		{
			snd_stop(snd_flowery_coin);
			snd_play(snd_flowery_coin, 1, p - 0.3);
		}
	}
	var marker = -4;
	with (obj_textmarker)
	{
		if (variable_instance_exists(id, ""value""))
		{
			if (variable_instance_exists(id, ""is_pink"") && other.is_pink)
			{
				marker = id;
				break;
			}
			else if (!other.is_pink)
			{
				marker = id;
				break;
			}
		}
	}
	if (marker == -4)
	{
		marker = instance_create_depth(x + 20, y + 20, 1500, obj_textmarker);
		marker.value = 0;
	}
	with (marker)
	{
		if (value > 0)
		{
			with (doom)
			{
				instance_destroy();
			}
		}
		x = arg0.x + (30 * arg0.image_xscale);
		startcamerax = camerax();
		y = arg0.y + 20;
		if (other.is_pink)
		{
			value += other.coinvalue;
			is_pink = true;
			font = global.damagefontpink;
		}
		else
		{
			value += other.coinvalue;
			font = global.damagefontgold;
		}
		mystring = ""+"" + string(value) + str;
		hscale = other.image_xscale * 0.5;
		follow_camera = arg0.object_index == obj_plat_player && arg0.dashing;
		vspeed = -4 / global.fps_scale;
		friction = 0.25 / (global.fps_scale * global.fps_scale);
		outline = false;
		doom = scr_doom(id, 30);
	}
	spawn_fx();
	if (flag > 0)
	{
		global.flag[flag] = scr_set_bitmask_value(global.flag[flag], flagbit, 1, 1);
	}
	instance_destroy();
};

spawn_fx = function()
{
	with (obj_plat_game)
	{
		if (instance_exists(coin_collection_particle_system) && is_struct(coin_collect_struct))
		{
			coin_collection_particle_system.x = other.x;
			coin_collection_particle_system.y = other.y;
			coin_collect_struct.sprite_index = (other.coinvalue >= 5) ? spr_plat_coin_vfx_big : spr_plat_coin_vfx;
			coin_collect_struct.image_blend = other.is_pink ? c_fuchsia : c_white;
			coin_collect_struct.image_speed = 0.5;
			coin_collection_particle_system.emit(coin_collect_struct);
		}
	}
};
");

Apply("gml_Object_obj_plat_coin_Step_0", @"event_inherited();
if (!init)
{
	init = 1;
	scr_plat_depthcast();
	if (coinvalue == 5)
	{
		sprite_index = spr_plat_coin_large;
	}
	if (is_pink)
	{
		make_pink();
	}
	if (coinvalue == 5)
	{
		color = merge_color(c_orange, c_yellow, 0.25);
	}
	if (is_pink)
	{
		color = c_fuchsia;
	}
	paused_spr = sprite_index;
	afterimage_particle_system.shader = 1;
	afterimage_particle_system.skip_fusuma = 1;
	afterimage_particle_system.blend_mode = 1;
	afterimage_particle_system.default_particle_data.fadeout_speed = 0.05;
	afterimage_particle_system.default_particle_data.sprite_index = sprite_index;
	afterimage_particle_system.default_particle_data.image_alpha = 0.3;
	afterimage_particle_system.image_blend = color;
	
	afterimage_particle_system.particle_step_func = function(arg0)
	{
		if (arg0.custom_data == 1)
		{
			arg0.image_xscale += 0.3 / global.fps_scale;
			arg0.image_yscale += 0.3 / global.fps_scale;
		}
	};
}
if (global.pause_plat)
{
	exit;
}
if (!visible)
{
	exit;
}
afterimage_particle_system.depth = depth + 1;
if (is_culled && !physics && !homing_on_player)
{
	exit;
}
var target = 912;
with (obj_plat_npc)
{
	if (name == ""kris"" && visible)
	{
		target = id;
	}
}
if (instance_exists(obj_mainchara))
{
	target = 1200;
	depth = 50000;
}
if (!instance_exists(target))
{
	exit;
}
if (placed_in_room)
{
	if (instance_exists(target))
	{
		if (point_distance(x, y, target.x, target.y) < 80)
		{
			placed_in_room = false;
			collect_cooldown = 0;
			homingtimer = 20;
			homing_on_player = true;
		}
		timer += (1 / global.fps_scale);
		if ((timer % 4) == 0 && !is_culled)
		{
			afterimage_particle_system.x = x;
			afterimage_particle_system.y = y;
			afterimage_struct.image_index = image_index;
			afterimage_struct.image_alpha = 0.3;
			afterimage_particle_system.emit(afterimage_struct);
		}
	}
	exit;
}
if (homing_on_player)
{
	physics = false;
	if (!homing_phase_set)
	{
		homing_phase = frac(homingtimer);
		homing_phase_set = true;
	}
	homingtimer += (1 / global.fps_scale);
	var _homing_sample = ceil(homingtimer - homing_phase) + homing_phase;
	var _homing_boundary = frac(homingtimer - homing_phase) == 0;
	friction = clamp((_homing_sample + 12) / 4, 0.25, 1) / (global.fps_scale * global.fps_scale);
	gravity = lerp(0.2, 0, min(1, _homing_sample / 160)) / (global.fps_scale * global.fps_scale);
	var t = (_homing_sample - 15) / 12;
	if (_homing_boundary && t >= 1)
	{
		collect(target);
	}
	t = scr_fps_lerp_rate(clamp((_homing_sample - 15) / 12, 0, 0.5));
	if (instance_exists(target))
	{
		var xp = x;
		var yp = y;
		x = lerp(x, mean(target.bbox_left, target.bbox_right), t);
		y = lerp(y, mean(target.bbox_top, target.bbox_bottom), t);
		var pd = point_distance(xp, yp, x, y);
		var pdir = point_direction(xp, yp, x, y);
		if (_homing_boundary)
		{
			for (var i = 0; i < pd; i += 20)
			{
				afterimage_particle_system.x = xp + lengthdir_x(i, pdir);
				afterimage_particle_system.y = yp + lengthdir_y(i, pdir);
				afterimage_struct.image_index = image_index;
				afterimage_struct.image_alpha = 0.2;
				afterimage_particle_system.emit(afterimage_struct);
			}
		}
	}
	var col = 65535;
	if (is_pink)
	{
		col = 16711935;
	}
}
image_speed = 0.5 / global.fps_scale;
if (landspd > (0.25 / global.fps_scale) && landlimit > 0)
{
	vspeed = -abs(landspd / 1.5);
	if (!is_culled)
	{
		snd_stop(snd_metalhit);
		snd_play_pitch(snd_metalhit, 2);
	}
	landlimit--;
}
if (grounded)
{
	hspeed *= power(0.8, 1 / global.fps_scale);
}
collect_cooldown -= (1 / global.fps_scale);
");

Apply("gml_Object_obj_plat_combatstarter_Create_0", @"animtimer = 0;
wingtimer = 0;
con = 0;
chasetimer = -1;
init = 0;
colors = [];
wave_index = 0;
total_waves = array_length(enemy_wave_extflags);
lastmusic = """";
lastmusicpos = 0;
hostile = true;
depth = 50000;
background = -4;

endcombat = function()
{
	if (con == 0 || con == 3)
	{
		exit;
	}
	con = 3;
	snd_play(snd_feather_get);
	with (obj_plat_camera)
	{
		if (cutscene == 1)
		{
			scr_delay_var(""cutscene"", 0, 30);
			scr_delay_var(""lerptime_h"", 0, 30);
			scr_delay_var(""lerptime_v"", 0, 30);
			scr_plat_barrier_disable();
		}
	}
	with (background)
	{
		destroy = 1;
	}
	if (stop_music)
	{
		snd_free(global.currentsong[0]);
		if (lastmusic != """")
		{
			global.currentsong[0] = snd_init(lastmusic);
			global.currentsong[1] = mus_loop(global.currentsong[0]);
			audio_sound_set_track_position(global.currentsong[1], lastmusicpos);
			mus_volume(global.currentsong[1], 0, 0);
			mus_volume(global.currentsong[1], 1, 30);
		}
	}
	scr_script_delayed(function()
	{
		with (obj_platswap_statue)
		{
			can_hit = 1;
		}
	}, 30);
	if (victoryflag > 0)
	{
		scr_flag_set_ext(victoryflag, victoryflagbit, 1);
	}
	on_beaten(false);
};

on_beaten = function(arg0)
{
};

shatter = function()
{
	snd_play_delay(snd_stardrop, 1, 1, 1);
	snd_play_delay(snd_tensionhorn, 11, 1, 1);
	snd_play_delay(snd_tensionhorn, 21, 1, 1.1);
	background = instance_create(camerax(), cameray(), obj_battleback);
	background.depth = 1900000;
	if (battleback_behind_fusuma)
	{
		with (obj_plat_fusuma_mask)
		{
			other.background.depth = depth + 1000;
		}
	}
	var name = """";
	with (obj_astream)
	{
		if (mystream == global.currentsong[0])
		{
			name = songname;
		}
	}
	if (stop_music)
	{
		lastmusic = string_trim_start(name, [""mus/""]);
		lastmusicpos = audio_sound_get_track_position(global.currentsong[1]);
		snd_free(global.currentsong[0]);
		global.currentsong[0] = snd_init(""battle.ogg"");
		global.currentsong[1] = mus_loop(global.currentsong[0]);
		mus_volume(global.currentsong[1], 0, 0);
		scr_script_delayed(mus_volume, 30, global.currentsong[1], 1, 30);
	}
	with (obj_platswap_statue)
	{
		can_hit = 0;
	}
	scr_plat_vfx(3359);
	for (var i = 0; i < 360; i += 30)
	{
		with (instance_create(x, y, obj_animation))
		{
			sprite_index = spr_vfx_twinkle;
			image_speed = 0.25 / global.fps_scale;
			friction = 0.9 / (global.fps_scale * global.fps_scale);
			gravity = random_range(0.2, 0.5) / (global.fps_scale * global.fps_scale);
			scr_darksize();
			direction = i;
			speed = 24 / global.fps_scale;
		}
	}
	var cols = array_length(colors);
	var ii = 0;
	with (instance_create_depth(x, y, depth - 1, obj_flowerdie))
	{
		speed = 8;
		amount = 16;
		colored = true;
		image_blend = other.colors[ii % cols];
	}
};
");

Apply("gml_Object_obj_plat_combatstarter_Step_0", @"if (!global.pause_plat)
{
	animtimer += (1 / global.fps_scale);
	wingtimer += (1 / global.fps_scale);
}
if (init == 0)
{
	init = true;
	for (var i = 0; i < array_length(enemy_wave_extflags); i++)
	{
		var wave = enemy_wave_extflags[i];
		with (obj_flower_spawner)
		{
			if (enemy_wave == wave)
			{
				array_push(other.colors, image_blend);
			}
		}
	}
	if (array_length(colors) == 0)
	{
		array_push(colors, 16777215);
	}
}
if (con == 0 && victoryflag > 0 && scr_flag_get_ext(victoryflag, victoryflagbit) == 1)
{
	on_beaten(true);
	con = 2;
}
if (con == 0 && hostile)
{
	if (i_ex(obj_plat_player))
	{
		if (point_distance(xstart, ystart * 2, obj_plat_player.x, obj_plat_player.y * 2) < 260)
		{
			con = 1;
		}
		else
		{
			chasetimer = lerp(chasetimer, -1, 0.1);
			if (chasetimer > 0)
			{
				speed *= 0.9;
			}
			else
			{
				direction = point_direction(x, y, xstart, ystart);
				if (point_distance(x, y, xstart, ystart) < 16)
				{
					speed = 0;
					x = xstart;
					y = ystart;
					chasetimer = -1;
				}
				else
				{
					speed = lerp(speed, 8 / global.fps_scale, scr_fps_lerp_rate(0.1));
				}
			}
		}
	}
}
if (con == 1)
{
	shatter();
	con = 1.1;
	scr_delay_var(""con"", 1.2, 30);
	var genm = scr_genmarker(camera_target);
	if (genm != -4)
	{
		with (obj_plat_camera)
		{
			cutscene = 1;
			scr_lerpvar(""x"", x, genm.x, 30);
			scr_lerpvar(""y"", y, genm.y, 30);
		}
		scr_plat_barrier_enable();
	}
}
if (con == 1.2)
{
	con = 2;
	if (array_length(enemy_wave_extflags) > 0)
	{
		var extf = enemy_wave_extflags[0];
		var wave_started = false;
		with (obj_enemy_wave)
		{
			if (extflag == extf)
			{
				start_wave();
				wave_started = true;
				break;
			}
		}
		if (!wave_started)
		{
			scr_debug_print(""Enemy wave not found: "" + extf);
		}
	}
	else
	{
		scr_debug_print(""No enemy waves configured for combat encounter."");
	}
}
");

Apply("gml_Object_obj_plat_conspiracy_new_Collision_obj_plat_hbx", @"if (!instance_exists(obj_plat_player))
{
	exit;
}
if (broken)
{
	exit;
}
if (hit_cooldown > 0)
