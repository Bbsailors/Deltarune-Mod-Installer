bounceflower = -4;
chute_bg_marker = -4;
chute_marker = -4;
rebound_sparks_particles = instance_create_depth(x, y, depth + 1, obj_custom_particle_system);
rebound_sparks_particles.default_particle_data.sprite_index = spr_pxwhite;
rebound_sparks_particles.default_particle_data.image_speed = 0;
rebound_sparks_particles.default_particle_data.friction = 0.1;
rebound_sparks_particles.default_particle_data.image_blend = c_red;
rebound_sparks_particles.auto_cleanup = false;
rebound_sparks_particles.depth = 1601;

rebound_sparks_particles.particle_step_func = function(arg0)
{
	if (!global.pause_plat)
	{
		arg0.image_xscale = arg0.image_xscale - (arg0.custom_data / global.fps_scale);
	}
};

rebound_sparks_struct = 
{
	lifetime: 5,
	image_angle: 2,
	hspeed: 0,
	vspeed: 0,
	image_speed: 0,
	custom_data: 2
};

make_rebound_sparks = function(arg0, arg1, arg2, arg3)
{
	rebound_sparks_particles.x = arg0;
	rebound_sparks_particles.y = arg1;
	repeat (5)
	{
		var lifetime = random_range(5, 8);
		var myspeed = arg2 * random_range(1.9, 2.6);
		rebound_sparks_struct.lifetime = lifetime;
		rebound_sparks_struct.image_speed = random_range(0.2, 0.6);
		rebound_sparks_struct.image_angle = arg3 + 180 + random_range(-60, 60);
		rebound_sparks_struct.image_xscale = random_range(40, 60);
		rebound_sparks_struct.hspeed = lengthdir_x(myspeed, rebound_sparks_struct.image_angle);
		rebound_sparks_struct.vspeed = lengthdir_y(myspeed, rebound_sparks_struct.image_angle);
		rebound_sparks_struct.custom_data = rebound_sparks_struct.image_xscale / lifetime;
		rebound_sparks_particles.emit(rebound_sparks_struct);
	}
};

disable = function()
{
	con = -1;
	with (npc_aqua)
	{
		instance_destroy();
	}
	with (obj_slashpusher)
	{
		if (draw_yellow)
		{
			draw_yellow = false;
			if (scr_flag_get_ext(1310, 0) == 0)
			{
				image_index = 0;
				angle = 90;
				directional = false;
				sprite_index = spr_plat_slashpusher;
				petal_sprite = 2677;
			}
		}
	}
};

gun_phase_changed = function(arg0)
{
	if (arg0 == 1)
	{
		con = 4;
		timer = 0;
		aqua_move_in_position(60);
	}
	else if (arg0 == 2)
	{
		con = 5;
		timer = 0;
		gun_moves = true;
	}
	else if (arg0 == 3)
	{
		con = 6;
		timer = 0;
		aqua_move_in_position(60);
	}
	else if (arg0 == 4)
	{
		flower_moves = true;
		con = 7;
		timer = 0;
		with (obj_plat_enm_yellow_punishmentgun)
		{
			talkcon = 10;
			event_user(10);
		}
	}
	else if (arg0 == 5)
	{
		gun_moves = false;
		con = 8;
		timer = 0;
		if (flower_moves)
		{
			with (obj_plat_enm_yellow_punishmentgun)
			{
				talkcon = 11;
				event_user(10);
			}
		}
		flower_moves = false;
	}
};

hurt_version = false;

hurt_too_much = function()
{
	gun_moves = false;
	flower_moves = false;
	hurt_version = 1;
	con = 11;
	timer = 0;
	global.interact = 1;
};

aqua_move_in_position = function(arg0)
{
	aqua_shoot_timer = arg0;
	aqua_shoot_state = 1;
	aqua_anchor_x = 320 + ((con - 5) * 400);
	aqua_anchor_y = -60;
	scr_lerpvar(""aqua_anchor_x"", aqua_anchor_x, 320 + ((con - 5) * 160), 30, 2, ""out"");
	scr_lerpvar(""aqua_anchor_y"", -60, 140, 30, 6, ""out"");
	with (npc_aqua)
	{
		parallax_depth = 0.3;
		scr_lerpvar(""parallax_depth"", 0.3, 0, 30, 2, ""out"");
	}
};

lose = function()
{
	snd_stop_all();
	con = 9;
};

npc_yellow = instance_create(0, 0, obj_plat_npc);
npc_yellow.visible = false;
camanchorx = 0;
camanchory = 0;
aqua_anchor_x = -160;
aqua_anchor_y = -160;
aqua_shoot_state = 0;
aqua_shoot_timer = 0;
npc_aqua = scr_plat_makeactor_fromasset(findspriteinfo(spr_enemy_aqua_spin, undefined));
npc_aqua.force_animation(6131);

spawn_aqua_petals = function(arg0, arg1, arg2, arg3 = 1, arg4 = 0)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = (0.125 / global.fps_scale) * choose(1, 0.5, 0.75);
		image_blend = merge_color(c_aqua, c_black, arg4);
		scr_darksize();
		image_xscale *= lerp(1, 0.5, arg4);
		image_yscale *= lerp(1, 0.5, arg4);
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		gravity_direction = 270;
		ys = random_range(0.15, 0.25) * arg3;
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};
");

