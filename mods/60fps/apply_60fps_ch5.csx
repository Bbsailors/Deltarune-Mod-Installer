						con = 1;
						vspeed = 8 / global.fps_scale;
					}
				}
				else
				{
				}
			}
		}
		_act.blocked = hookscale <= 0.1;
		x = other.x;
		y = other.y;
		image_angle = other.image_angle;
		image_alpha = other.image_alpha;
		visible = other.image_index != 1;
		if (!global.pause_plat)
		{
			depth = other.depth + 1;
		}
		xoffset = lengthdir_x(10, image_angle - 90);
		hang_xoffset = xoffset + 10;
		newx = x + hang_xoffset;
		yoffset = lengthdir_y(20, image_angle - 90);
		hang_yoffset = yoffset - 8;
		newy = y + hang_yoffset;
		if (other.con == 1)
		{
			with (other.flowertarget)
			{
				targeted = -4;
			}
			other.flowertarget = -4;
		}
	}
}
if (con == 8)
{
}
");

