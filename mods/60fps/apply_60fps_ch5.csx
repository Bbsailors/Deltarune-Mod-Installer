		else if (mercy >= 40 && mercy < 80)
		{
			msgsetloc(0, ""* Not bad!/%"", ""obj_sheary_enemy_slash_Step_0_gml_222_0"");
		}
		else if (mercy >= 80 && mercy < 94)
		{
			msgsetloc(0, ""* Great job!/%"", ""obj_sheary_enemy_slash_Step_0_gml_223_0"");
		}
		else if (mercy >= 94)
