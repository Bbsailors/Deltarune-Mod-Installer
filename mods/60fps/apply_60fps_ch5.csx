			{
				anchor_x += random_range(-20, 20);
				anchor_y += random_range(-20, 0);
			}
			timer = 0;
		}
		else if (scr_trigcheck_ext(""foxpanic_right"", id))
		{
			anchor_x += 120;
			while (place_meeting(anchor_x, anchor_y, obj_solidblock))
			{
				anchor_x += random_range(0, 20);
				anchor_y += random_range(-20, 20);
