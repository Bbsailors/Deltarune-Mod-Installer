		scr_anyface_next(""seth"", 0);
		msgnextsubloc(""~1* Umm^1, I think so!"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_knifewall_generator_slash_Step_0_gml_177_0"");
		d_make_plat(0, 2, undefined, undefined, 1);
	}
	if (array_length(arc_knives) > 0)
	{
		if (timer == 27)
		{
			aquasprite = 4001;
			aqua_image_speed = 0;
			scr_lerpvar(""aqua_idx"", 1, 4, 5);
