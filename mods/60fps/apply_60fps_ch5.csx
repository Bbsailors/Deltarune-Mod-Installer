	c_msgnextsubloc(""~1* ..^1. this YELLOW KEY^1, ain't goin'~2to no HUMAN criminells./%"", (global.lang == ""ja"") ? ""\\m4\t\t\t"" : ""\\m4\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_ch5_DWCL01_slash_Step_0_gml_176_0"");
