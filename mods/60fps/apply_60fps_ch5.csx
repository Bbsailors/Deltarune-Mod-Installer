	{
		shuriken_target_x = get_real_x() + (10 * image_xscale);
		sprite_index = spr_shinobeetle;
		with (instance_create(x + (0.5 * sprite_width), y + (0.5 * sprite_height), obj_plat_bulletred_shuriken3d))
		{
			depth = other.depth - 1;
			damage = 0;
			throw_direction = sign(other.image_xscale);
