		msgnextloc(""* (..^1. that's just it^1. The imperfection^1, lent to its sincerity...)/"", ""obj_church_entrance_festival_slash_Step_0_gml_50_0"");
		msgnextloc(""* (...)/"", ""obj_church_entrance_festival_slash_Step_0_gml_51_0"");
		msgnextloc(""* (Next time^1, I would like to write my own sermon^1, Kris.)/%"", ""obj_church_entrance_festival_slash_Step_0_gml_52_0"");
