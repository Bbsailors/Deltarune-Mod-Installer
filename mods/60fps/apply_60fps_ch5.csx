Apply("gml_Object_obj_grassanim_new_Step_0", @"var _cx = camerax();
var _cy = cameray();
var _left = max(0, (_cx - tile_size) div tile_size);
var _top = max(0, (_cy - tile_size) div tile_size);
var _right = min(tmwidth, (_cx + 700) div tile_size);
var _bottom = min(tmheight, (_cy + 520) div tile_size);
var mult = 1;
var last_anim = floor(anim / (anim_speed * mult));
anim += ((anim_speed * mult) / global.fps_scale);
if (anim > anim_length)
{
	anim -= anim_length;
}
if (floor(anim / (anim_speed * mult)) != last_anim)
{
	scr_plat_set_floortex_dirty();
}
for (var xx = _left; xx < _right; xx++)
{
	for (var yy = _top; yy < _bottom; yy++)
	{
		var _data = tilemap_get(tilemap, xx, yy);
		if (_data > 0)
		{
			var _rowStart = (_data div tile_row_length) * tile_row_length;
			var _min = 1 + _rowStart;
			var _max = 1 + anim_length + _rowStart;
			if (_data >= _min && _data <= _max)
			{
				tilemap_set(tilemap, _min + anim_indices[(anim + (xx * 0.125) + (yy * 0.125)) % anim_length], xx, yy);
			}
		}
	}
}
");

Apply("gml_Object_obj_grazebox_Collision_obj_collidebullet", @"if (!other.active)
