Apply("gml_Object_obj_encounterbasic_Create_0", @"global.interact = 2;
if (global.flag[9] == 1)
{
	snd_volume(global.currentsong[1], 0, 20);
}
scr_encountersetup(global.encounterno);
with (obj_mainchara)
{
	visible = 0;
}
with (obj_climb_kris)
{
	visible = 0;
	freeze = true;
}
with (global.cinstance[0])
{
	visible = 0;
}
with (global.cinstance[1])
{
	visible = 0;
}
with (obj_plat_player)
{
	visible = 0;
}
with (obj_plat_follower)
{
	visible = 0;
}
with (obj_plat_game)
{
	paused = true;
}
with (obj_mainchara)
{
	fun = 0;
}
with (obj_caterpillarchara)
{
	fun = 0;
	image_xscale = 2;
	x -= sprite_xoffset;
	y -= sprite_yoffset;
}
var target = 1200;
if (i_ex(obj_plat_player))
{
	target = 912;
}
if (i_ex(obj_climb_kris))
{
	target = 1166;
}
count = 0;
c[0] = scr_dark_marker(target.x, target.y, spr_kris_sword_jump_down);
if (i_ex(global.cinstance[0]))
{
	count += 1;
	c[1] = scr_dark_marker(global.cinstance[0].x, global.cinstance[0].y, global.cinstance[0].rsprite);
	if (i_ex(obj_climb_kris))
	{
		c[1].x = obj_climb_kris.x;
		c[1].y = obj_climb_kris.y;
		c[1].image_alpha = 0;
	}
	if (global.cinstance[0].rsprite == spr_susier_dark)
	{
		c[1].sprite_index = spr_susier_wall;
	}
	if (global.cinstance[0].name == ""noelle"")
	{
		var _sideb = scr_sideb_get_phase();
		c[1].sprite_index = spr_noelleb_battleintro;
		if (_sideb >= 2)
		{
			c[1].sprite_index = spr_noelleb_battleintro_sideb;
		}
		c[1].image_speed = 0.5 / global.fps_scale;
	}
}
if (i_ex(global.cinstance[1]))
{
	count += 1;
	c[2] = scr_dark_marker(global.cinstance[1].x, global.cinstance[1].y, global.cinstance[1].rsprite);
	if (i_ex(obj_climb_kris))
	{
		c[2].x = obj_climb_kris.x;
		c[2].y = obj_climb_kris.y;
		c[2].image_alpha = 0;
	}
	if (global.cinstance[1].rsprite == spr_susier_dark)
	{
		c[2].sprite_index = spr_susier_wall;
	}
	if (global.cinstance[1].name == ""noelle"")
	{
		c[2].sprite_index = spr_noelleb_battleintro;
		c[2].image_speed = 0.5 / global.fps_scale;
	}
}
for (i = 0; i < (count + 1); i += 1)
{
	c[i].direction = point_direction(c[i].x, c[i].y, global.heromakex[i], global.heromakey[i]);
	c[i].speed = point_distance(c[i].x, c[i].y, global.heromakex[i], global.heromakey[i]) / (10 * global.fps_scale);
	c[i].depth = 200 - (i * 20);
}
fightcon = 1;
counttimer = 0;
if (global.encounterno == 230)
{
	with (c[0])
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_encounterbasic_Step_0", @"if (fightcon == 1)
{
	if (global.flag[9] == 1)
	{
		snd_pause(global.currentsong[1]);
	}
	counttimer += (1 / global.fps_scale);
	if (counttimer < 10 && frac(counttimer) == 0)
	{
		for (i = 0; i < (count + 1); i += 1)
		{
			with (c[i])
			{
				af = scr_afterimage();
				af.image_alpha = 0.5;
			}
		}
	}
	if (counttimer >= 10)
	{
		if (global.encounterno != 84 && global.encounterno != 230)
		{
			wp = snd_play(snd_impact);
			snd_volume(wp, 0.7, 0);
			wp2 = snd_play(snd_weaponpull_fast);
			snd_volume(wp2, 0.8, 0);
		}
		if (global.encounterno != 230)
		{
			for (i = 0; i < (count + 1); i += 1)
			{
				c[i].speed = 0;
				if (global.char[i] != 4)
				{
					c[i].image_index = 0;
				}
				if (global.char[i] == 1)
				{
					c[i].sprite_index = spr_krisb_attack;
				}
				if (global.char[i] == 2)
				{
					c[i].sprite_index = spr_susieb_attack;
					if (global.charweapon[global.char[i]] == 0)
					{
						c[i].sprite_index = spr_susieb_attack_unarmed;
					}
				}
				if (global.char[i] == 3)
				{
					c[i].sprite_index = spr_ralsei_battleintro;
					if (global.chapter == 5 && global.encounterno == 225)
					{
						c[i].sprite_index = spr_ralsei_begin_battle_serious;
					}
					if (global.chapter == 5)
					{
						if (scr_flag_get(1311) == 1)
						{
							c[i].sprite_index = spr_ralseib_battleintro;
						}
					}
				}
				c[i].image_speed = 0.5 / global.fps_scale;
				with (c[i])
				{
					scr_lerpvar(""image_alpha"", image_alpha, 1, 10);
				}
			}
		}
		fightcon = 2;
		counttimer = 0;
	}
}
if (fightcon == 2)
{
	counttimer += (1 / global.fps_scale);
	if (counttimer >= 15)
	{
		counttimer = 0;
		fightcon = 3;
		for (i = 0; i < (count + 1); i += 1)
		{
			with (c[i])
			{
				instance_destroy();
			}
		}
		instance_create(0, 0, obj_battlecontroller);
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_endbattle_Create_0", @"alarm[0] = round(15 * global.fps_scale);
con = 0;
with (obj_battleback)
{
	destroy = 1;
}
count = 0;
global.flag[49] = global.tension;
global.tension = 0;
var target = 1200;
if (i_ex(obj_climb_kris))
{
	target = 1166;
}
if (i_ex(obj_plat_player))
{
	target = 912;
}
var becomes_platmode = false;
if (global.specialbattle == 0 || global.specialbattle == 3)
{
	c[0] = scr_dark_marker(global.heromakex[0], global.heromakey[0], spr_krisr_dark);
	if (i_ex(global.cinstance[0]))
	{
		count += 1;
		c[1] = scr_dark_marker(global.heromakex[1], global.heromakey[1], global.cinstance[0].rsprite);
		if (global.cinstance[0].encounter_return_offset != undefined)
		{
			c[1].sprite_index = global.cinstance[0].encounter_return_offset[0];
			c[1].x += global.cinstance[0].encounter_return_offset[1];
			c[1].y += global.cinstance[0].encounter_return_offset[2];
			c[1].image_xscale = global.cinstance[0].encounter_return_offset[3];
			becomes_platmode = true;
			with (obj_mainchara)
			{
				cutscene = 1;
			}
		}
	}
	if (i_ex(global.cinstance[1]))
	{
		count += 1;
		c[2] = scr_dark_marker(global.heromakex[2], global.heromakey[2], global.cinstance[1].rsprite);
		if (global.cinstance[1].encounter_return_offset != undefined)
		{
			c[2].sprite_index = global.cinstance[1].encounter_return_offset[0];
			c[2].x += global.cinstance[1].encounter_return_offset[1];
			c[2].y += global.cinstance[1].encounter_return_offset[2];
			c[2].image_xscale = global.cinstance[1].encounter_return_offset[3];
		}
	}
	for (i = 0; i < (count + 1); i += 1)
	{
		if (i == 0)
		{
			var xoffset = 0;
			var yoffset = 0;
			if (becomes_platmode)
			{
				xoffset -= 19;
				yoffset -= 38;
			}
			c[i].direction = point_direction(c[i].x, c[i].y, target.x + xoffset, target.y + yoffset);
			c[i].speed = point_distance(c[i].x, c[i].y, target.x + xoffset, target.y + yoffset) / (10 * global.fps_scale);
			c[i].depth = 200 - (i * 20);
		}
		if (i == 1 || i == 2)
		{
			if (i_ex(obj_climb_kris))
			{
				with (c[i])
				{
					scr_lerpvar(""image_alpha"", 1, 0, 10);
				}
				c[i].direction = point_direction(c[i].x, c[i].y, obj_climb_kris.x, obj_climb_kris.y);
				c[i].speed = point_distance(c[i].x, c[i].y, obj_climb_kris.x, obj_climb_kris.y) / (10 * global.fps_scale);
				c[i].depth = 200 - (i * 20);
			}
			else
			{
				var xoffset = 0;
				var yoffset = 0;
				c[i].direction = point_direction(c[i].x, c[i].y, global.cinstance[i - 1].x + xoffset, global.cinstance[i - 1].y + yoffset);
				c[i].speed = point_distance(c[i].x, c[i].y, global.cinstance[i - 1].x + xoffset, global.cinstance[i - 1].y + yoffset) / (10 * global.fps_scale);
				c[i].depth = 200 - (i * 20);
			}
		}
	}
	alarm[0] = round(10 * global.fps_scale);
}
if (global.flag[9] == 1)
{
	snd_volume(global.batmusic[1], 0, alarm[0] / global.fps_scale);
}
");

