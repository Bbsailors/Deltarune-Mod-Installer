		if (scale != -4)
		{
			image_xscale = scale;
		}
	}
	if (!instance_exists(shroom))
	{
		con = 2.5;
		timer = 0;
		sprite_index = spr_dw_garden_fox_idle;
		exit;
	}
	x = lerp(startx, shroom.x - (8 * image_xscale), timer / 20);
	y = lerp(starty, shroom.y, timer / 20);
	if (timer >= 20)
	{
		con = 3;
		timer = 0;
		if (!bromide_muted)
		{
			snd_stop(snd_chomp);
			snd_play(snd_chomp, 0.7, 1.5);
		}
		sprite_index = spr_dw_garden_fox_eat;
		image_speed = (1/3) / global.fps_scale;
		var scale = sign(shroom.x - x) * 2;
		if (scale != 0)
		{
			image_xscale = scale;
		}
	}
}
if (con == 2.5)
{
