	{
		var li = ds_list_create();
		instance_place_list(x, y, 1370, li, false);
		for (var i = 0; i < ds_list_size(li); i++)
		{
			with (ds_list_find_value(li, i))
			{
				if (((other.movedir + 2) % 4) == floor(image_angle / 90))
				{
					other.con = -2;
					other.timer = 0;
					other.falldirection = image_angle / 90;
					global.interact = 0;
					if (other.dropflag > 0)
					{
						global.flag[other.dropflag] = scr_set_bitmask_value(global.flag[other.dropflag], other.dropflagbit, 1, 1);
					}
					if (other.falldirection == 2)
					{
						other.depth -= 1000;
					}
					with (other.block)
					{
						instance_destroy();
					}
					with (other.interact)
					{
						instance_destroy();
					}
					exit;
				}
			}
