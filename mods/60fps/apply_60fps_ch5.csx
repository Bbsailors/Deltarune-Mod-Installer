Apply("gml_Object_obj_cherub_feathers_Step_0", @"if (speed < (5 / global.fps_scale))
{
	friction = 0.2 / (global.fps_scale * global.fps_scale);
}
if (speed < (2 / global.fps_scale))
{
	fallspeed = scr_movetowards(fallspeed, 1, 0.05 / global.fps_scale);
}
y += (fallspeed / global.fps_scale);
x += ((sin(siner / 15) * (fallspeed / 2)) / global.fps_scale);
siner += (1 / global.fps_scale);
image_angle = (-cos(siner / 15) * 30) + spin_offset;
if (spinner < 1)
{
	var _spinease = scr_ease_out(spinner, 2);
	spinner += (0.1 / global.fps_scale);
	spin_offset = lerp(spin_start, 0, _spinease);
}
if (fallspeed == 1)
{
	lifetime -= (1 / global.fps_scale);
}
if (lifetime <= 0)
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
");

