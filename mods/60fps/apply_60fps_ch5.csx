Apply("gml_Object_obj_ch5_LW07_Create_0", @"scr_thrashfit_init();
con = -1;
customcon = 0;
blackall = scr_dark_marker(-10, -10, spr_pixel_white);
blackall.image_xscale = 999;
blackall.image_yscale = 999;
blackall.depth = 100;
blackall.image_blend = c_black;
blueprint_marker = scr_dark_marker(-100, -100, spr_thrashdesign);
blueprint_marker.depth = 98000;
blueprint_markershadow = -4;
queen_shake = false;
queen_shake_timer = 0;
queen_x_pos = 0;
queen_y_pos = 0;
_menu = -4;
_spotlight = -4;
_outfit = -4;
_outfit_preview = -4;
_hat_marker = -4;
_printer_noise = [];
queen_npc = scr_dark_marker(0, 0, spr_queen_walk_down);
with (queen_npc)
{
	visible = 0;
	scr_depth();
}
queen_cover = -4;
queen_readable = instance_create(500, 244, obj_readable_room1);
with (queen_readable)
{
	extflag = ""castle_1f_queen"";
	image_xscale = 2;
	image_yscale = 2;
}
queen_collider = instance_create(500, 244, obj_solidblockDark);
with (queen_collider)
{
	image_yscale = 1;
}
lancer_npc = instance_create(0, 0, obj_npc_room);
with (lancer_npc)
{
	sprite_index = spr_lancer_dt;
	extflag = ""castle_1f_lancer"";
	visible = 0;
	scr_depth();
}
tenna_npc = instance_create(980, 248, obj_npc_room_animated);
with (tenna_npc)
{
	sprite_index = spr_tenna_dance_cabbage_smol;
	extflag = ""castle_1f_tenna"";
	image_speed = 1 / global.fps_scale;
	scr_depth();
}

show_menu = function()
{
	if (_menu == -4)
	{
		_menu = instance_create(0, 0, obj_ch5_LW07_thrashfit_menu);
		_menu.init(id);
	}
};

trigger_event = function(arg0)
{
	switch (arg0)
	{
		case ""close_menu"":
			_menu = -4;
			con = 5;
			break;
	}
};

show_convo = function(arg0, arg1 = 0)
{
	switch (arg0)
	{
		case ""castle_1f_lancer"":
			con = (scr_flag_get(1428) == 0) ? 30 : 35;
			break;
		case ""castle_1f_queen"":
			con = (scr_flag_get(1427) == 0) ? 20 : 22;
			if (scr_flag_get(388) == 1)
			{
				con = (scr_flag_get(1427) == 0) ? 24 : 26;
			}
			break;
		case ""castle_1f_tenna"":
			con = (scr_flag_get(1429) == 0) ? 40 : 45;
			break;
		case ""castle_1f_cauldron"":
			con = 50;
			if (arg1 > 1)
			{
				con = 55;
			}
			break;
		case ""castle_1f_blueprint"":
			con = 60;
			break;
	}
};

if (global.plot < 60)
{
	con = 0;
	global.interact = 1;
	blackall.visible = 1;
	scr_setparty(1, 1);
}
else
{
	with (blackall)
	{
		instance_destroy();
	}
	blueprint_marker.x = 583;
	blueprint_marker.y = 150;
	var blueprint_readable = instance_create(blueprint_marker.x, blueprint_marker.y, obj_readable_room1);
	with (blueprint_readable)
	{
		extflag = ""castle_1f_blueprint"";
		image_xscale = 4;
		image_yscale = 4;
	}
	var blueprint_block = instance_create(blueprint_marker.x, blueprint_marker.y, obj_solidblock);
	with (blueprint_block)
	{
		image_xscale = 4;
		image_yscale = 4;
	}
	queen_npc.visible = 1;
	queen_npc.x = 490;
	queen_npc.y = 151;
	with (queen_npc)
	{
		scr_depth();
	}
	queen_readable.y = 230;
	queen_collider.y = 230;
	lancer_npc.visible = 1;
	lancer_npc.x = 676;
	lancer_npc.y = 208;
	with (lancer_npc)
	{
		scr_depth();
	}
	if (!scr_tenna_in_castletown())
	{
		with (tenna_npc)
		{
			instance_destroy();
		}
	}
	else
	{
		tenna_npc.visible = 1;
	}
}
");

