	draw_monster_body_part(spr_green_body, siner * 0.8, x, y);
	draw_monster_body_part(spr_green_front_arm, siner, x, y + (sin(siner * 0.8) * 3));
	draw_monster_body_part(spr_green_head, siner, x, y + (sin(siner * 0.8) * 2));
}
if (state == 8)
{
