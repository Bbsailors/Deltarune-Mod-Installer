				{
					scr_turntimer(245);
				}
				if (global.flag[1916] == 3)
				{
					scr_turntimer(365);
				}
				global.flag[1916]++;
				if (global.flag[1916] > 3)
				{
					global.flag[1916] = 3;
				}
			}
			if (wateringcan)
