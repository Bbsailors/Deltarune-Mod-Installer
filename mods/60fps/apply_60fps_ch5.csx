	timer += (1 / global.fps_scale);
	threshold = 80;
	if (quick_mode == 1)
	{
		threshold = 30;
	}
	if (timer >= threshold)
	{
		timer = (quick_mode == 1) ? (2 - (2 / global.fps_scale)) : (1 - (1 / global.fps_scale));
		con = 17;
		sus_index = 0;
	}
}
if (con == 17)
{
	draw_rect = 0;
