					var res = 
					{
						h: draw_get_halign(),
						v: draw_get_valign()
					};
					draw_set_halign(fa_center);
					draw_set_valign(fa_middle);
					var _x = screenwidth / 2;
					var _y = ((screenheight / 2) - 8) + (sin(animindex / 4) * 4);
					draw_set_color(#06112D);
					for (var i = 1; i < 4; i++)
					{
						ang = animindex * 4;
						draw_text_transformed(_x + i, _y + i, ""?"", 2, 2, ang);
					}
					draw_set_color(c_white);
					var ang = animindex * 4;
					draw_text_transformed(_x, _y, ""?"", 2, 2, ang);
					draw_set_font(memfont);
					draw_set_halign(res.h);
					draw_set_valign(res.v);
				}
				if (change > 0)
				{
					var xloc = -40 + random(20);
					var yloc = -40 + random(20);
					for (var i = 0; i < 7; i++)
					{
						for (var j = 0; j < 6; j++)
						{
