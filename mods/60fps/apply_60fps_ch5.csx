				depth = other.depth + 1;
			}
			xoffset = lengthdir_x(4, image_angle - 90);
			hang_xoffset = xoffset;
			newx = x + hang_xoffset;
			yoffset = lengthdir_y(4, image_angle - 90);
			hang_yoffset = yoffset;
			newy = y + hang_yoffset;
		}
