Apply("gml_Object_obj_plat_enm_seth_book_Create_0", @"event_inherited();
con = 0;
timer = 0;
hp = 16;
use_image_speed = false;
coindrops = 20;
spawntimer = 80;
rude_buster_damage = 2;
stun_duration = round(45 * global.fps_scale);
h_knockback = (image_xscale * -8) / global.fps_scale;
v_knockback = -6 / global.fps_scale;
damage = 0;
kb_strength = 12;
spawn_effect = false;
knockback_on_death = false;
deathmarker_lifetime = round(1 * global.fps_scale);
difficulty_scaling = 0;
y_anchor = ystart;
image_speed = 0.25 / global.fps_scale;
image_index = 0;
sinertimer = 0;
lerptimer = 0;
remx = 0;
remy = 0;
size = 3;
sineamp = 8;
petal_color = 16711935;
small_aqua = -4;

on_stun_recover = function()
{
	with (obj_dw_fcastle_orange_gauntlet)
	{
		with (npc_seth)
		{
			x -= 20;
			force_animation(2003);
		}
	}
};

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	if (hit <= 0 && arg0.is_player_hbx)
	{
		hit = 3;
		scr_make_ripple(x, y, 8, 16777215, 50, 15, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
		with (arg0)
		{
			do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
		}
		hp--;
		spawn_hit_petals(3, point_direction(arg0.x, arg0.y, x, y), 1);
		if (hp <= 0)
		{
			shake = 16;
			h_knockback = (arg0.image_xscale * 5.5) / global.fps_scale;
			v_knockback = -10 / global.fps_scale;
			hspeed = 0;
			vspeed = 0;
			alarm[2] = round(8 * global.fps_scale);
			alarm[3] = round(4 * global.fps_scale);
		}
		else
		{
			flash_hurt(255);
			knocked_back = 1;
			h_knockback = (arg0.image_xscale * 10.5) / global.fps_scale;
			v_knockback = -14 / global.fps_scale;
			hspeed = 0;
			vspeed = 0;
			shake = 4;
			with (instance_create_depth(x, y, depth, obj_plat_vfx))
			{
				sprite_index = spr_hit_vfx;
				image_speed = 1;
			}
		}
	}
};
");

