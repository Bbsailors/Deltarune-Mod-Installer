depth = _tower.depth - 100;
var _dur = 120;
var _zoff = 0.5;
rotation -= (spin / global.fps_scale);
height += (height_speed / global.fps_scale);
if (!simple)
{
	image_speed = spin / 8 / global.fps_scale;
}
var _pos3 = scr_perspective_scale_ext(_xx, _yy, _zz, _tower.x, obj_flowery_towery.camy + 240);
var _scale = _pos3.z * scale;
_scale = round_to_multiple(_scale, 0.05) - _zoff;
image_xscale = _scale;
image_yscale = _scale;
x = _pos3.x;
y = _pos3.y;
depth = obj_flowery_towery.depth + ((1 - _pos3.z) * 50);
if (climb && depth < obj_flowery_towery.depth)
{
	depth = 30000 + ((1 - _pos3.z) * 100);
}
riser += (1 / global.fps_scale);
lifetime -= (1 / global.fps_scale);
if (lifetime <= 0)
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
else if (image_alpha < 1)
