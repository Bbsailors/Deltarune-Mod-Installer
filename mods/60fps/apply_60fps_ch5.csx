	var _my = my + flyoff;
	scr_darkbox_black((mx - 36 - dboxbord) + 14, _my - 8 - dboxbord - 83, ((mx + boxwid) - 14) + dboxbord, my + (space * 2) + maxnum + dboxbord + bonbot);
	var fltextbox = stringsetsubloc(""Flower Tea Time!\nF$: $~1"", string(global.flag[1411]), ""obj_dw_fcastle_cafe_slash_Draw_0_gml_99_0"");
