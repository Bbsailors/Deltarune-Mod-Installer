Apply("gml_Object_obj_dw_castle_church_climb_Other_19", @"if (ccon == 1)
{
	if (fademusic == 0)
	{
		fademusic = 1;
		snd_volume(global.currentsong[1], 0, 30);
	}
	with (obj_mainchara)
	{
		fun = 1;
		sprite_index = spr_krisu_dark;
	}
	if (!instance_exists(obj_climb_kris))
	{
		global.interact = 1;
		ccon = 2;
		if (cutscene == -1)
		{
			var averageLo = 799;
			var averageHi = 750;
			var goodLo = 749;
			var goodHi = 700;
			var fiveMinutes = 9000;
			cutscene = 1;
			if (sawCutscene1)
			{
				cutscene = 2;
			}
			if (thisclimbtime >= fiveMinutes)
			{
				cutscene = 0;
				if (sawCutscene0)
				{
					cutscene = 9;
				}
			}
			else if (thisclimbtime < goodHi)
			{
				cutscene = 5;
				if (sawCutscene5)
				{
					cutscene = 6;
				}
				if (global.flag[254] == 1)
				{
					if (cutscene == 5)
					{
						cutscene = 7;
					}
					else if (cutscene == 6)
					{
						cutscene = 8;
					}
				}
			}
			else if (thisclimbtime <= goodLo)
			{
				cutscene = 4;
			}
			else if (thisclimbtime <= averageLo)
			{
				cutscene = 3;
			}
		}
		scr_debug_print(""CUTSCENE \\#"" + string(cutscene));
	}
}
