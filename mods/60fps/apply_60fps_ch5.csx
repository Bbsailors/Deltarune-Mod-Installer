Apply("gml_Object_obj_plat_enm_book_simple_Collision_obj_plat_player", @"if (!other.hurt && !other.targetmode && !other.invincible && other.sprite_index != spr_kris_plat_slash_ground && other.sprite_index != spr_kris_plat_slash_air)
{
