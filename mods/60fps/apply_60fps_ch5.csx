		c_spritenext(3541, 3);
		c_msgnextloc(""\\EQ* Your fingers just know something that mine don't./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1516_0"");
		c_msgnextloc(""\\EQ* .../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1517_0"");
		c_spritenext(4969, 0);
		c_msgnextloc(""\\EB* You..^1. must be really special^1, Kris./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1519_0"");
		c_spritenext(3541, 3);
		c_msgnextloc(""\\E1* There's a reason why you're the hero./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1521_0"");
		c_msgnextloc(""\\E2* And that's why..^1. I'm putting all my faith in you./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1522_0"");
		c_spritenext(4039, 0);
		c_msgnextloc(""\\EE* That no matter what path we take to get there/"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1524_0"");
		c_spritenext(3541, 3);
		c_msgnextloc(""\\Ee* That even if you do something I disagree with/"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1526_0"");
		c_spritenext(4969, 0);
		c_msgnextloc(""\\EJ* All it means is that I don't understand it yet./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1528_0"");
		c_spritenext(3541, 3);
		c_msgnextloc(""\\E2* ..^1. right?/"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1530_0"");
		c_spritenext(4039, 0);
		c_msgnextloc(""\\EQ* .../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1532_0"");
		c_spritenext(3541, 3);
