heal_orange = function()
{
};

apply_buff = function()
{
	is_buffed = true;
	buff_timer = 0;
	var snd = snd_play(snd_power, 1, 0.2);
	snd_pitch_time(snd, 0.7, 50);
	var _of = scr_oflash();
	_of.flashcolor = c_red;
	for (var i = 0; i < 9; i++)
	{
		var star = instance_create(x + lengthdir_x(45, i * 40), y + lengthdir_y(45, i * 40), obj_marker);
		with (star)
		{
			image_angle = random(360);
			depth = other.depth - 10;
			image_xscale = 2;
			image_yscale = 2;
			image_alpha = 2;
			image_speed = 0.25;
			direction = point_direction(other.x, other.y, x, y);
			speed = 6;
			friction = 0.2;
			sprite_index = spr_sparestar_anim;
			image_blend = c_orange;
			scr_doom(self, 30);
			scr_lerpvar(""image_alpha"", image_alpha, 0, 30, 1, ""out"");
		}
	}
};

get_hurt = function()
{
};

hit_angle = 0;
xscale_mod = 1;
yscale_mod = 1;
queue_sound = false;
stored_speed = 0;

bounce_impact = function(arg0, arg1)
{
	if (con == 150)
	{
		exit;
	}
	with (obj_dw_fcastle_orange_gauntlet)
	{
		with (npc_orange)
		{
			force_animation(1619);
		}
	}
	cancel_stun();
	image_index = 0;
	con = 150;
	contimer = 0;
	remaining_combo = 0;
	if (!arg1)
	{
		scr_plat_cool_zoom();
	}
	scr_plat_hitstop_global(6);
	hit_angle = arg0;
	if (image_xscale < 0)
	{
		hit_angle = 180 - hit_angle;
	}
	timer = 2;
	direction = hit_angle;
	flash_hurt(4235519);
	xscale_mod = 0.5;
	yscale_mod = 1.5;
	snd_stop(snd_smallswing);
	snd_stop(snd_heavyswing);
	snd_stop(snd_ultraswing);
	snd_stop(snd_punchmed);
	snd_play(snd_whack_absurdlyloud, 0.1, 1.5);
	queue_sound = true;
	image_angle = hit_angle;
	with (instance_create(x, y, obj_animation))
	{
		sprite_index = spr_vfx_directional_hit;
		image_xscale = 2;
		image_yscale = 2;
		image_speed = 0.5 / global.fps_scale;
		depth = other.depth + 1;
		image_angle = other.hit_angle;
	}
	var lx = lengthdir_x(1, hit_angle);
	var ly = lengthdir_y(1, hit_angle);
	var inc = 12;
	for (var i = 0; i < inc; i++)
	{
		with (instance_create(x + (lx * ((20 * i) + 2)), y + (ly * ((20 * i) + 2)), obj_marker_fancy))
		{
			sprite_index = spr_plat_targetmode_arrow;
			image_angle = other.hit_angle;
			image_speed = 0;
			image_xscale = 0;
			image_yscale = 0;
			depth = other.depth - 1;
			scr_script_delayed(scr_lerpvar, i + 1, ""image_xscale"", 0, 2, 3, 1, ""out"");
			scr_script_delayed(scr_lerpvar, i + 1, ""image_yscale"", 0, 2, 3, 1, ""out"");
			timer = -i;
			image_blend = c_orange;
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				image_alpha = (sin(timer * 0.2) * 0.7) + 0.4;
				if (timer > 6 && image_alpha <= 0)
				{
					instance_destroy();
				}
			};
		}
	}
};

create_telegraph = function()
{
	var cx = camerax();
	var doomtime = 30;
	var dd = 2000;
	for (var i = -1; i <= 1; i += 2)
	{
		with (instance_create(cx, y + (40 * i), obj_marker_fancy))
		{
			depth = dd;
			image_blend = c_yellow;
			timer = 0;
			sprite_index = spr_pxwhite;
			image_xscale = 640;
			image_yscale = 2;
			scr_lerpvar(""image_alpha"", 1, 0, doomtime, 1, ""in"");
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				if ((timer % 4) == 0)
				{
					image_blend = (image_blend == c_yellow) ? c_red : c_yellow;
				}
			};
			
			scr_doom(self, doomtime);
		}
	}
	with (instance_create(cx + 320 + (220 * image_xscale), y, obj_marker_fancy))
	{
		image_blend = c_yellow;
		timer = 0;
		depth = dd;
		sprite_index = spr_plat_vfx_warn;
		scr_lerpvar(""image_alpha"", 1, 0, doomtime, 1, ""in"");
		scr_lerpvar(""image_xscale"", 1, 0, doomtime, 1, ""in"");
		scr_lerpvar(""image_yscale"", 1, 0, doomtime, 1, ""in"");
		
		step_func = function()
		{
			timer += (1 / global.fps_scale);
			if ((timer % 4) == 0)
			{
				image_blend = (image_blend == c_yellow) ? c_red : c_yellow;
			}
		};
		
		scr_doom(self, doomtime);
	}
	var inc = 6;
	var lendirx = lengthdir_x(1, 90 + (90 * other.image_xscale));
	for (var i = 0; i < inc; i++)
	{
		with (instance_create(cx + 320 + (160 * image_xscale) + (lendirx * ((20 * i) + 2)), y, obj_marker_fancy))
		{
			sprite_index = spr_plat_targetmode_arrow;
			image_angle = 90 + (90 * other.image_xscale);
			image_speed = 0;
			image_xscale = 0;
			depth = dd;
			image_yscale = 0;
			scr_script_delayed(scr_lerpvar, i + 1, ""image_xscale"", 0, 2, 3, 1, ""out"");
			scr_script_delayed(scr_lerpvar, i + 1, ""image_yscale"", 0, 4, 5, 1, ""out"");
			timer = -i;
			image_blend = c_orange;
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				image_alpha = (sin(timer * 0.2) * 0.7) + 0.4;
				if (timer > 6 && image_alpha <= 0)
				{
					instance_destroy();
				}
			};
		}
	}
};

create_telegraph_down = function()
{
	var cx = camerax();
	var cy = cameray();
	var doomtime = 30;
	var dd = 2000;
	for (var i = -1; i <= 1; i += 2)
	{
		with (instance_create(x + (40 * i), cy, obj_marker_fancy))
		{
			depth = dd;
			image_blend = c_yellow;
			image_angle = 0;
			timer = 0;
			sprite_index = spr_pxwhite;
			image_xscale = 2;
			image_yscale = 480;
			scr_lerpvar(""image_alpha"", 1, 0, doomtime, 1, ""in"");
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				if ((timer % 4) == 0)
				{
					image_blend = (image_blend == c_yellow) ? c_red : c_yellow;
				}
			};
			
			scr_doom(self, doomtime);
		}
	}
	with (instance_create(x, cy + 100, obj_marker_fancy))
	{
		image_blend = c_yellow;
		timer = 0;
		depth = dd;
		sprite_index = spr_plat_vfx_warn;
		scr_lerpvar(""image_alpha"", 1, 0, doomtime, 1, ""in"");
		scr_lerpvar(""image_xscale"", 1, 0, doomtime, 1, ""in"");
		scr_lerpvar(""image_yscale"", 1, 0, doomtime, 1, ""in"");
		
		step_func = function()
		{
			timer += (1 / global.fps_scale);
			if ((timer % 4) == 0)
			{
				image_blend = (image_blend == c_yellow) ? c_red : c_yellow;
			}
		};
		
		scr_doom(self, doomtime);
	}
	var inc = 6;
	for (var i = 0; i < inc; i++)
	{
		with (instance_create(x, cy + 160 + ((20 * i) + 2), obj_marker_fancy))
		{
			sprite_index = spr_plat_targetmode_arrow;
			image_angle = 270;
			image_speed = 0;
			image_xscale = 0;
			depth = dd;
			image_yscale = 0;
			scr_script_delayed(scr_lerpvar, i + 1, ""image_xscale"", 0, 2, 3, 1, ""out"");
			scr_script_delayed(scr_lerpvar, i + 1, ""image_yscale"", 0, 4, 5, 1, ""out"");
			timer = -i;
			image_blend = c_orange;
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				image_alpha = (sin(timer * 0.2) * 0.7) + 0.4;
				if (timer > 6 && image_alpha <= 0)
				{
					instance_destroy();
				}
			};
		}
	}
};
");

Apply("gml_Object_obj_plat_enm_orange_miniboss_Destroy_0", @"with (__spawner)
