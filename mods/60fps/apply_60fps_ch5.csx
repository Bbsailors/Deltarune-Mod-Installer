Apply("gml_Object_obj_dw_garden_newdash_Step_0", @"if (!init)
{
	init = 1;
}
if (con == 0)
{
	if (global.flag[netskie_encounterflag] == 1)
	{
		con = 2.1;
	}
	else if (scr_trigcheck(""netskie"") || scr_trigcheck_ext(""netskied"", 1662))
	{
		add_bottom_chest();
	}
}
if (con == 1 && instance_number(obj_treasure_fox) > 0)
{
	if (scr_trigcheck(""netskieattackenable"") && obj_treasure_fox.con == 0)
	{
		con = 2;
		with (obj_treasure_fox)
		{
			evil = true;
			snd_play(snd_spearrise);
			vspeed = -16 / global.fps_scale;
			global.flag[7] = 1;
		}
	}
}
with (obj_treasure_fox)
{
	if (con == 5)
	{
		global.flag[7] = 0;
		with (obj_mainchara)
		{
			freeze = 0;
		}
		instance_destroy();
	}
	else if (con == 9999)
	{
		if (i_ex(obj_battlecontroller))
		{
			global.flag[7] = 0;
			with (obj_mainchara)
			{
				freeze = 0;
			}
			instance_destroy();
		}
	}
}
if (con <= 3 && scr_trigcheck_ext(""tea"", 1662))
{
	con = 4;
	timer = 0;
	var sprites = findsprite_all(4150);
	for (var i = 0; i < array_length(sprites); i++)
	{
		layer_sprite_change(sprites[i], spr_enemy_floradin_spared);
	}
}
if (con == 4)
{
	if (global.interact == 0)
	{
		var _layer = layer_get_id(""Teaparty"");
		if (layer_exists(_layer))
		{
			var _elements = layer_get_all_elements(_layer);
			for (var i = 0; i < array_length(_elements); i++)
			{
				if (layer_sprite_get_x(_elements[i]) < obj_mainchara_dash.bbox_right)
				{
					knock_away(_layer, _elements[i]);
					with (instance_create(obj_mainchara_dash.bbox_right, obj_mainchara_dash.y, obj_animation))
					{
						sprite_index = spr_hit_vfx;
						image_speed = 0.5 / global.fps_scale;
						snd_play(snd_punchmed, 1, 1 + (0.05 * other.timer));
						other.timer++;
						scr_darksize();
					}
				}
			}
		}
	}
}
");

Apply("gml_Object_obj_dw_garden_physicsshroom_Step_0", @"if (state == 0)
{
	fakeyspeed += (fakegrav / global.fps_scale);
	fakeheight += (fakeyspeed / global.fps_scale);
	image_angle += (rotation_speed / global.fps_scale);
	rotation_speed *= power(0.99, 1 / global.fps_scale);
	scr_depth(self, -fakeheight - 8);
	if (fakeheight >= 0)
	{
		bounces++;
		hspeed *= (0.5 + (sign(rotation_speed) * 0.5));
		vspeed *= 0.5;
		rotation_speed *= choose(0.7, 1.3, -0.7, -1.3);
		obj_concurrent_sound_manager.this_frame_sound = 405;
		fakeyspeed *= -0.5;
		fakeheight = 0;
		vspeed = 0;
		hspeed = 0;
		state = 1;
		image_angle = round(image_angle / 45) * 45;
		if (destroy_on_overlap && place_meeting(x, y, obj_solidblock))
		{
			with (instance_create(x, y, obj_animation))
			{
				sprite_index = spr_dustcloud;
				image_xscale = 2;
				image_yscale = 2;
			}
			instance_destroy();
		}
	}
}
else
{
	hspeed = 0;
	vspeed = 0;
	fakeheight = 0;
	gravity = 0;
}
");

