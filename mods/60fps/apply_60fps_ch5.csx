	}
	if (triggered && global.interact == 0 && !d_ex())
	{
		con = 0;
		global.interact = 1;
		enter_active = false;
		with (obj_trigger)
		{
			if (extflag == ""enter_trigger"")
			{
				instance_destroy();
			}
		}
	}
}
