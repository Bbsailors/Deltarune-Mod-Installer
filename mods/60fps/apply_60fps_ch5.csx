if (cutscene == 240)
{
	scr_cutscene_make();
	scr_maincharacters_actors();
	makeFlower(""orange"", tableleft);
	var su_pos = findspriteinfo(spr_susie_walk_left_dw, ""NPC_TABLEFLOWERS_RIGHT"");
	c_sel(su);
	c_facing(""l"");
	c_autodepth(0);
