	{
		pattern_category++;
		if (pattern_category > 5)
		{
			pattern_category = 0;
		}
		pattern_test = 0 + (pattern_category * 10);
		_pressed = true;
		_pattern = "" - 1."";
	}
	if (keyboard_check_pressed(vk_control))
	{
		pattern_category--;
		if (pattern_category < 0)
		{
			pattern_category = 5;
		}
		pattern_test = 0 + (pattern_category * 10);
		_pressed = true;
		_pattern = "" - 1."";
	}
	switch (pattern_category)
	{
		case 0:
			_category = ""No Forced Patterns."";
			category_size = 0;
			break;
		case 1:
			_category = ""Jarona"";
			category_size = 5;
