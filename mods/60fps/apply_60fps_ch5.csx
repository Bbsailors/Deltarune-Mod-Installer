Apply("gml_Object_obj_tommygun_bullet_Step_0", @"if (wall_destroy == 1)
{
	if (x < (__view_get(e__VW.XView, 0) - 80))
	{
		instance_destroy();
	}
	if (x > (__view_get(e__VW.XView, 0) + 760))
	{
		instance_destroy();
	}
	if (y < (__view_get(e__VW.YView, 0) - 80))
	{
		instance_destroy();
	}
	if (y > (__view_get(e__VW.YView, 0) + 580))
	{
		instance_destroy();
	}
}
if (updateimageangle == 1)
{
	image_angle = direction;
}
if (spin == 1)
{
	image_angle += (spinspeed / global.fps_scale);
}
direction += anglechange;
if (bottomfade != 0 && y > (cameray() + bottomfade))
{
	image_alpha *= power(0.8, 1 / global.fps_scale);
}
if (sprite_index == spr_tommygun_bullet_netskie)
{
	if (x < (obj_growtangle.x + 75) && x > (obj_growtangle.x - 75) && y < (obj_growtangle.y + 75) && y > (obj_growtangle.y - 75))
	{
		insidebox = true;
	}
	if (insidebox)
	{
		if (x < (obj_growtangle.x - 75) || x > (obj_growtangle.x + 75) || y < (obj_growtangle.y - 75) || y > (obj_growtangle.y + 75))
		{
			slowcon = 1;
			friction = 0.2 / (global.fps_scale * global.fps_scale);
		}
	}
}

enum e__VW
{
	XView,
	YView,
	WView,
	HView,
