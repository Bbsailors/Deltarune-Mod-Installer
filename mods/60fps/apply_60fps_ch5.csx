Apply("gml_Object_obj_plat_bullet_emitter_Step_0", @"if (global.pause_plat)
{
	exit;
}
if (!instance_exists(obj_plat_player))
{
	exit;
}
if (active)
{
	timer += (attackspeed / global.fps_scale);
	if (patterntype == 0)
	{
		if (timer >= 30)
		{
			timer -= 30;
			if (shoot_once)
			{
				active = 0;
			}
			var next_angle = shoot_angle + (shoot_angle_difference * sign(image_xscale));
			for (var i = 0; i < bullet_burst; i++)
			{
				var j = i - ((0.5 * bullet_burst) - 0.5);
				shoot_angle = next_angle + ((j * bullet_burst_angle) / bullet_burst);
				event_user(0);
			}
			shoot_angle = next_angle;
		}
	}
	else if (patterntype == 1)
	{
		if (timer >= 30)
		{
			timer -= 30;
			if (shoot_once)
			{
				active = 0;
			}
			var next_angle = shoot_angle + (shoot_angle_difference * sign(image_xscale));
			for (var i = 0; i < bullet_burst; i++)
			{
				var j = i - ((0.5 * bullet_burst) - 0.5);
				shoot_angle = next_angle + ((j * bullet_burst_angle) / bullet_burst);
				event_user(0);
				shoot_angle += 180;
				event_user(0);
			}
			shoot_angle = next_angle;
		}
	}
	else if (patterntype == 2)
	{
		if (timer >= 30)
		{
			timer -= 30;
			if (shoot_once)
			{
				active = 0;
			}
			var next_angle = shoot_angle + (shoot_angle_difference * sign(image_xscale));
			for (var i = 0; i < bullet_burst; i++)
			{
				var j = i - ((0.5 * bullet_burst) - 0.5);
				shoot_angle = next_angle + ((j * bullet_burst_angle) / bullet_burst);
				event_user(0);
				shoot_angle += 120;
				event_user(0);
				shoot_angle += 120;
				event_user(0);
			}
			shoot_angle = next_angle;
		}
	}
	else if (patterntype == 3)
	{
		if (timer >= 30)
		{
			timer -= 30;
			if (shoot_once)
			{
				active = 0;
			}
			var next_angle = shoot_angle + (shoot_angle_difference * sign(image_xscale));
			for (var i = 0; i < bullet_burst; i++)
			{
				var j = i - ((0.5 * bullet_burst) - 0.5);
				shoot_angle = next_angle + ((j * bullet_burst_angle) / bullet_burst);
				event_user(0);
				shoot_angle += 90;
				event_user(0);
				shoot_angle += 90;
				event_user(0);
				shoot_angle += 90;
				event_user(0);
			}
			shoot_angle = next_angle;
		}
	}
}
");

Apply("gml_Object_obj_plat_bullet_path_preview_Step_1", @"if (!instance_exists(obj_plat_player) && despawn_in_ow_mode)
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
if (!init)
{
	premult_speed = speed;
	init = true;
}
var _paused = 0;
if (hitstop > 0)
{
	_paused = 1;
}
if (global.pause_plat)
{
	_paused = 1;
}
if (_paused)
{
	if (!paused)
	{
		paused_dir = direction;
		paused_spd = speed;
		paused_spr = sprite_index;
		paused_img = image_index;
		paused_imgspd = image_speed;
		paused_grav = gravity;
		paused = 1;
	}
	speed = 0;
	gravity = 0;
	image_speed = 0;
}
else
{
	if (paused)
	{
		paused = 0;
		direction = paused_dir;
		speed = paused_spd;
		sprite_index = paused_spr;
		gravity = paused_grav;
		image_index = paused_img;
		image_speed = paused_imgspd;
	}
	timer_multiplier = scr_approach(timer_multiplier, 1, 0.15);
	speed = premult_speed * timer_multiplier;
	var tm = timer_multiplier / global.fps_scale;
	while (tm > 0)
	{
		var step = 1;
		if (tm < 1)
		{
			step = tm;
		}
		t += step;
		tm -= 1;
		if (turn_timer >= 900)
		{
			turn_timer += step;
			var tt = (turn_timer - 900) / turn_duration;
			direction = lerp(startdirection, startdirection + turn_amount, clamp01(tt));
			if (tt >= 1)
			{
				direction = startdirection + turn_amount;
				turn_timer = -1;
			}
		}
		else if (turn_timer >= 0)
		{
			turn_timer -= step;
			if (turn_timer <= 0)
			{
				startdirection = direction;
				turn_timer = 900;
			}
		}
		if (timer_multiplier > 1)
		{
			x += lengthdir_x(step * premult_speed * global.fps_scale, direction);
			y += lengthdir_y(step * premult_speed * global.fps_scale, direction);
			speed = 0;
		}
	}
	is_onscreen = scr_onscreen_tolerance(self, 100);
	steptimer += (1 / global.fps_scale);
	if ((steptimer % 2) == 0 && is_onscreen)
	{
		array_insert(trailsx, 0, x);
		array_insert(trailsy, 0, y);
		if (array_length(trailsx) > 4)
		{
			array_delete(trailsx, 4, 1);
			array_delete(trailsy, 4, 1);
		}
	}
	if (t > lifetime && lifetime != -1)
	{
		instance_destroy();
	}
}
");

