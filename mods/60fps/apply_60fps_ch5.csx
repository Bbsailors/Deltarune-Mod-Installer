				other.foxcon = 1;
				other.foxtimer = 0;
				var order = [];
				for (var i = 0; i < stacklength; i++)
				{
					array_push(order, i);
				}
				for (var i = 1; i < stacklength; i++)
				{
					var throwidx = irandom(array_length(order) - 1);
					var throworder = order[throwidx];
					array_delete(order, throwidx, 1);
					var xdiff = clamp(x - xprevious, -6, 6);
					var ydiff = clamp((y - yprevious) / 2, -6, 6);
					stacksize = 14;
					xdist[i] = lerp(xdist[i], xdiff * (0.5 * i), 0.15);
					ydist[i] = lerp(ydist[i], ydiff * (0.5 * i), 0.15);
					var xloc = x - (sprite_get_width(stack[i]) / 2) - xdist[i];
					var yloc = (y - sprite_get_height(stack[i]) - (i * stacksize) - ydist[i]) + abs(xdist[i] / 5);
					var s = stack[i];
					var shroom = instance_create(xloc, yloc, obj_dw_garden_physicsshroom);
					shroom.fakeheight = yloc - obj_mainchara.bbox_bottom;
					shroom.destroy_on_overlap = true;
					shroom.y = obj_mainchara.bbox_bottom;
					shroom.direction = (lerp(applied_direction, 90, 0.5) + 30) - ((60 * throworder) / (stacklength - 1));
					shroom.speed = random_range((4 / global.fps_scale) + (applied_speed * 0.7), (4 / global.fps_scale) + (applied_speed * 1));
					shroom.rotation_speed = random_range(-25, 25);
				}
				stack = [stack[0]];
				break;
			}
		}
	}
}
