		scr_lerpvar(""height"", width, 0, widthtime - irandom(10), choose(1, 2), ""out"");
		con = 1;
	}
	if (con == 1)
	{
		if (width < 1)
		{
			instance_destroy();
		}
		if (height < 1)
		{
			instance_destroy();
		}
	}
}
if (fade == false)
{
