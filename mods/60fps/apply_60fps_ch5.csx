	c_customfunc(function()
	{
		with (_anim)
		{
			start();
		}
	});
	c_wait_if(kr_actor, ""image_index"", ""="", 3);
	c_snd_play(snd_bump);
	c_customfunc(function()
	{
		_anim.pause();
	});
	c_wait(30);
	c_customfunc(function()
	{
		_anim.start();
	});
	c_wait_if(kr_actor, ""image_index"", ""="", 6);
	c_snd_play(snd_bump);
	c_customfunc(function()
	{
		_anim.pause();
	});
