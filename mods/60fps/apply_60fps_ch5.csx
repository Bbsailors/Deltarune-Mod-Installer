	SurfaceID
}
");

Apply("gml_Object_obj_torigate_Step_0", @"if (!platinit)
{
	y += 20;
	platinit = true;
	var _ydistplat = 4;
	var _ydistow = 40;
	var _floor = instance_place(x, y, obj_plat_floortex);
	ground = _floor;
	_floordepth = depth - 10;
	y_plat = ystart + (_ydistplat / 2);
	if (instance_exists(_floor))
	{
		y_plat = _floor.y_plat + 16;
		_ydistow = _floor.sprite_height;
		with (_floor)
		{
			var _scale = image_yscale;
			image_yscale = 0.1;
			_ydistplat = sprite_height;
			image_yscale = _scale;
		}
	}
	depth = 100000;
	depth_ow = 0;
	depth_plat = depth;
	y_ow = y;
	y = y_ow;
	y_plat += 10;
	y_top = y_ow;
	y_top_ow = y_ow;
	y_top_plat = y_plat - 80;
	yscale_top = image_yscale;
	yscale_top_ow = yscale_top;
	yscale_top_plat = yscale_top * 0.5;
	back_spr = instance_create(x, y, obj_torigate_bg);
	with (back_spr)
	{
		image_index = 0;
		image_speed = 0;
		y_plat = other.y_plat + 108;
		y_ow = other.y_ow + 20;
		y = y_ow;
		yadjust = other.yadjust;
		image_yscale = other.image_yscale;
		hspeed = other.hspeed;
		plx_plat = -0.1;
		plx_ow = -0.05;
		plx = plx_ow;
		image_xscale = other.image_xscale;
		image_yscale = 2;
		x = other.x;
	}
}
event_inherited();
if (deathcon == 1)
{
	if (!global.pause_plat)
	{
		timer += (1 / global.fps_scale);
		if (timer == 30)
		{
			with (back_spr)
			{
				scr_afterimage_monochrome(16777215, true);
			}
			scr_afterimage_monochrome(16777215, true);
			instance_destroy();
		}
		if (timer > 5 && (timer % 2) == 0)
		{
			for (var i = 0; i < (1 + floor(0.1 * timer)); i++)
			{
				var m = instance_create(x + (random_range(-0.3, 0.3) * sprite_width), y - (random_range(0, 0.8) * sprite_height), obj_marker);
				with (m)
				{
					sprite_index = spr_leaf_fall;
					scr_plat_make_pauseable();
					image_speed = random_range(0.15, 0.3) / global.fps_scale;
					gravity_direction = 135;
					gravity = 0.2 / (global.fps_scale * global.fps_scale);
					image_xscale = 0;
					image_yscale = 0;
					var size = random_range(1, 2);
					scr_lerpvar(""image_xscale"", 0, size, 9);
					scr_lerpvar(""image_yscale"", 0, size, 9);
					hspeed = random_range(-3, 3) / global.fps_scale;
					vspeed = random_range(-3, 3) / global.fps_scale;
					var delay = random_range(60, 180);
