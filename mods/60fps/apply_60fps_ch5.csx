					msgset_add(stringsetloc(""What!?^1 I'm victum again!?^1&My secretest petals done&was STOLENED?!/%"", ""obj_yellow_enemy_slash_Step_0_gml_372_0""), x - 20, y + 40, 10, 50, function()
					{
						idlesprite = spr_yellow_shock_left;
