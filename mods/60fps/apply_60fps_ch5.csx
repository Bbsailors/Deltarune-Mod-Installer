Apply("gml_Object_obj_plat_enm_aqua_sword_Create_0", @"event_inherited();
throwsign = 1;
knives = 0;
hp = 6;
aim = 0;
aim_error = 0;
x_home = xstart;
y_home = ystart;
attacking = false;
con = 0;
contimer = 0;
knife_angle = 0;
aim_direction = 0;
knife_smear = false;
parried = false;
remx = 0;
remy = 0;
coindrops = 20;
attacktimer = -1;
nextknife = 0;
knifecount = 6;
throwdir = 1;
hit = 0;
image_speed = 0.25 / global.fps_scale;
gtime = 10;
windimmune = true;
stunner = 2.5;
evadecon = 0;
evadetimer = 0;
evadedirection = 0;
priority = irandom(9);
standby = false;
petal_color = 16776960;
protective_bullet = instance_create(x, y, obj_plat_bulletyellow);
with (protective_bullet)
{
	owner = other;
	damage = 0;
	parry = false;
	
	on_collide = function(arg0)
	{
		with (arg0.owner)
		{
			hitstop = 12;
		}
		if (instance_exists(owner))
		{
			with (owner)
			{
				try_clang();
			}
		}
	};
}
hassword = true;

try_clang = function()
{
	scr_debug_print(""clang!"");
	if (con == 1 && contact_damage > 0)
	{
		parried = true;
	}
	aim_direction = point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
	if (parried)
	{
		with (obj_plat_enm_aqua_sword)
		{
			hitstop += 12;
		}
	}
	else
	{
		hitstop = 12;
	}
	knife_smear = true;
	knife_angle = aim_direction;
	con = 3;
	contimer = 0;
	flash_hurt(65535);
	depth = obj_plat_player.depth - 1;
};

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	hp--;
	hit = 1;
	with (arg0)
	{
		do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
	}
	spawn_hit_petals(3, point_direction(arg0.x, arg0.y, x, y), 1);
	if (hp <= 0)
	{
		instance_destroy();
	}
	else
	{
		flash_hurt(255);
		with (instance_create_depth(x, y, depth, obj_plat_vfx))
		{
			sprite_index = spr_hit_vfx;
			image_speed = 1;
		}
		with (instance_create_depth(x, y, depth, obj_plat_vfx))
		{
			sprite_index = spr_smokepuff;
			image_speed = 2;
		}
		if (hp <= 0)
		{
			instance_destroy();
		}
	}
};

lose_sword = function()
{
	if (!hassword)
	{
		exit;
	}
	hassword = false;
	var hbx = other;
	with (instance_create(x, y, obj_plat_friendly_bullet))
	{
		scr_plat_make_pauseable(self);
		direction = point_direction(obj_plat_player.x, obj_plat_player.y, x, y);
		var _sign = sign(lengthdir_x(1, direction));
		sprite_index = spr_faqua_yellowknife_center;
		image_angle = other.knife_angle;
		speed = 16 / global.fps_scale;
		scr_darksize();
		gravity = 1 / (global.fps_scale * global.fps_scale);
		creator = other.id;
		ignore_creator = true;
		hurt_delay = 5;
		friction = 0.5 / (global.fps_scale * global.fps_scale);
		plat_pause = true;
		depth = other.depth + 100;
		vspeed -= (14 / global.fps_scale);
		image_xscale *= _sign;
		rotation = (other.parried ? -50 : -35) * _sign;
		image_index = other.parried ? 1 : 0;
		image_speed = 0;
		scr_doom(self, 60);
	}
};
");

Apply("gml_Object_obj_plat_enm_aqua_sword_Destroy_0", @"if (!initialized)
{
	exit;
}
with (protective_bullet)
{
	instance_destroy();
}
if (!hit)
{
	exit;
}
audio_stop_sound(snd_enemy_defeat_quick);
snd_play(snd_enemy_defeat_quick);
var _col = merge_color(c_gray, other.petal_color, clamp01(other.hp / other.__max_hp));
if (hp > 0)
{
	var _dir = irandom(360);
	var _len = 80 + irandom(120);
	snd_play_pitch(snd_creepylaugh, 0.8);
	var _gx = obj_plat_player.x;
	var _gy = obj_plat_player.y - 40;
	var cx = camerax() + (0.5 * camerawidth());
	if (_gx < cx)
	{
		_gx += 180;
	}
	else
	{
		_gx -= 180;
	}
	var _gtime = round(18 * global.fps_scale);
	var _respawner = instance_create(_gx, _gy, obj_flower_respwn);
	with (_respawner)
	{
		colored = true;
		image_blend = _col;
		obj = other.object_index;
		extflag = other.extflag;
		x_home = other.x_home;
		depth = other.depth;
		y_home = other.y_home;
		__spawner = other.__spawner;
		_memory._hp_init = true;
		_memory.__max_hp = other.__max_hp;
		hp = other.hp;
		special_regroup = true;
		
		regroup_func = function()
		{
			x = obj_plat_player.x;
			y = obj_plat_player.y - 40;
			var px = x;
			var cx = camerax() + (0.5 * camerawidth());
			if (x < cx)
			{
				x += 180;
			}
			else
			{
				x -= 180;
			}
			var _overlap = collision_circle(x, y, 40, obj_flower_spawnblocker, false, true);
			if (_overlap != -4)
			{
				scr_debug_print(""repositioning!"");
				if (abs(cx - px) < 100)
				{
					x += (-sign(cx - px) * 320);
				}
				else
				{
					x -= (sign(x - px) * 100);
					y -= 100;
				}
			}
			with (instance_create(x, y, obj_flower_spawnblocker))
			{
				sprite_index = spr_faqua;
				image_xscale = 2;
				image_yscale = 2;
			}
		};
		
		if (other.wave_manager != -4)
		{
			wave_manager = other.wave_manager;
			group_id = other.group_id;
			wave_manager.enemies[group_id] = id;
		}
		alarm[0] = _gtime;
		alarm[1] = _gtime / 2;
		alarm[3] = (_gtime / 2) - 1;
	}
	with (instance_create_depth(x, y, depth, obj_flowerdie))
	{
		fadewait = 60;
		colored = true;
		image_blend = _col;
		speed = 10;
		gx = _gx;
		gy = _gy;
		regroup_target = _respawner;
		gtime = _gtime * 0.5;
	}
}
else
{
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_hit_vfx;
		image_speed = 1;
	}
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_smokepuff;
		image_speed = 2;
	}
	with (__spawner)
	{
		instance_destroy();
	}
	spawn_death_coins();
	if (wave_manager != -4)
	{
		with (wave_manager)
		{
			enemy_defeat(group_id);
		}
	}
	scr_plat_hitstop_global(8);
	var snd = snd_play_pitch(snd_creepylaugh, 0.8);
	snd_pitch_time(snd, 0.4, 15);
	snd_volume(snd, 0, 30);
	with (instance_create_depth(x, y, depth, obj_flowerdie))
	{
		speed = 12;
		colored = true;
		amount = 12;
		image_blend = _col;
	}
}
");

Apply("gml_Object_obj_plat_enm_aqua_sword_Step_0", @"event_inherited();
if (!instance_exists(obj_plat_player))
{
	scr_flower_despwn();
	exit;
}
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (is_stunned)
{
	exit;
}
if (con == 3)
{
	depth = obj_plat_player.depth - 1;
}
if (hitstop > 0)
{
	exit;
}
contimer += (1 / global.fps_scale);
if (con == 0 && contimer < 10)
{
	with (obj_plat_enm_aqua_sword)
	{
		if (id == other.id || parried)
		{
			continue;
		}
		else if (con >= 3)
		{
			other.contimer += 8;
			break;
		}
	}
}
if (con == 0 && instance_number(obj_flower_respwn) > 0 && contimer > 10)
{
	contimer = 10;
}
if (con == 0)
{
	aim_direction = point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
	knife_angle = aim_direction + (sin(contimer / 6) * 4);
	if (contimer >= 15)
	{
		if (instance_number(obj_plat_enm_aqua_sword) > 1)
		{
			var _self = id;
			with (obj_plat_enm_aqua_sword)
			{
				if (id == _self)
				{
					continue;
				}
				else if (con == 0)
				{
					contimer -= 10;
				}
			}
		}
		if (contimer >= 15)
		{
			con = 1;
			contimer = 0;
		}
	}
}
else if (con == 1)
{
	if (contimer == 2)
	{
		snd_play(snd_wing);
		flash_hurt(16777215);
		direction = aim_direction;
		speed = -5 / global.fps_scale;
		friction = 0.9 / (global.fps_scale * global.fps_scale);
	}
	if (contimer < 10)
	{
		knife_angle = lerp(knife_angle, aim_direction + 90, scr_fps_lerp_rate(0.35));
	}
	if (contimer == 12)
	{
		direction = aim_direction;
		speed = 27 / global.fps_scale;
		friction = 0.9 / (global.fps_scale * global.fps_scale);
		with (protective_bullet)
		{
			parry = true;
		}
		attacking = true;
		knife_angle = aim_direction;
		knife_smear = true;
	}
	if (contimer == 13)
	{
		knife_smear = false;
		knife_angle -= 45;
		contact_damage = 60;
	}
	if (contimer > 13)
	{
		knife_angle -= (max(0, 80 - (contimer * 2)) / global.fps_scale);
		if (place_meeting(x + hspeed, y, obj_plat_block))
		{
			hspeed = 0;
		}
		if (place_meeting(x, y + vspeed, obj_plat_block))
		{
			vspeed = 0;
		}
	}
	if (contimer >= 30)
	{
		contact_damage = 0;
	}
	if (speed > (2 / global.fps_scale) && (contimer % 2) == 0)
	{
		scr_afterimage_monochrome(16776960, true).image_alpha = 0.3;
	}
	if (contimer == 50)
	{
		hit = 1;
		instance_destroy();
	}
}
else if (con == 2)
{
	instance_destroy();
}
else if (con == 3)
{
	contact_damage = 0;
	if (contimer == 1)
	{
		lose_sword();
		direction = 180 + aim_direction;
		speed = 18 / global.fps_scale;
		knife_smear = false;
		knife_angle -= 45;
		friction = 2 / (global.fps_scale * global.fps_scale);
	}
	else if (contimer >= (parried ? 60 : 40) && !standby)
	{
		hit = 1;
		instance_destroy();
	}
}
");

