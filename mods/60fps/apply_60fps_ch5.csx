		var pd = other.parallax_depth;
		if (explodetimer == 5)
		{
			stop_sound();
			scr_lerpvar_instance(other, ""image_index"", 0, 4, 10);
			var spawnx = other.x + 2;
			var spawny = other.y + 50;
			with (instance_create_depth(other.parallax_x + 2, other.parallax_y + 25, other.depth, obj_animation))
			{
				sprite_index = spr_smokepuff;
				image_blend = c_yellow;
				image_xscale = 0.5;
				image_yscale = 0.5;
				image_speed = 0.5 / global.fps_scale;
			}
			with (instance_create_depth(spawnx, spawny, other.depth, obj_marker_parallax))
			{
				_hspeed = ((other.x + (0.5 * other.sprite_width)) - x) / 5 / global.fps_scale;
				_vspeed = ((other.y + (0.5 * other.sprite_height)) - y) / 5 / global.fps_scale;
				sprite_index = spr_smallbullet;
				image_xscale = 1;
				image_yscale = 1;
				parallax_depth = pd;
				image_blend = c_yellow;
				snd_play(snd_whack_absurdlyloud, 0.1, 1);
				snd_play(snd_glove_launch, 1, 1);
				
				step_func = function()
				{
					if (!global.pause_plat)
					{
						var steps = 4;
						repeat (steps)
						{
							parallax_depth -= (0.12 / global.fps_scale / steps);
							image_xscale += (0.2 / global.fps_scale / steps);
							image_yscale += (0.2 / global.fps_scale / steps);
							x += (_hspeed / steps);
							y += (_vspeed / steps);
							scr_afterimage_monochrome_parallax(65535, false, parallax_depth).image_alpha = 0.3;
						}
					}
				};
				
				scr_doom(self, 5);
			}
		}
	}
}
");

Apply("gml_Object_obj_yellow_beam_Create_0", @"origin_x = x;
origin_y = y;
goal_x = x;
goal_y = y;
width = 8;
width_goal = 0;
circle_width = 24;
circle_lifetime = 20;
beam_lifetime = 5;
color = c_black;
size_multiply = 1;
size_counter = 0;
r = 255;
g = 255;
b = 255;
timer = 0;

function setup(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8)
{
	origin_x = arg0;
	origin_y = arg1;
	goal_x = arg2;
	goal_y = arg3;
	width = arg4;
	width_goal = arg5;
	circle_width = arg6;
	beam_lifetime = arg7;
	circle_lifetime = arg8;
	beam_reduce = (width - width_goal) / beam_lifetime;
	color_reduce = 255 / circle_lifetime;
	circle_reduce = circle_width / circle_lifetime;
	alarm[0] = round(circle_lifetime * global.fps_scale);
	exit;
}
");

Apply("gml_Object_obj_yellow_beam_Draw_0", @"d_line_width_color(origin_x, origin_y, goal_x, goal_y, width, color, color);
d_circle_color(goal_x, goal_y, circle_width * size_multiply, color, color, false);
size_counter += (1 / global.fps_scale);
if (frac(size_counter) == 0)
{
	size_multiply = 1 + (sin(1.5707963267948966 + (size_counter * pi)) * 0.05);
}
");

