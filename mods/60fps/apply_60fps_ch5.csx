timer += (1 / global.fps_scale);
if (timer == timermax && i_ex(obj_terracota_enemy) && obj_terracota_enemy.bonsaicon == 0)
{
	var chosenpot = choose(0, 1, 2, 3, 4);
	var chosenplant = choose(0, 1, 2);
	repeat (3)
	{
		if (chosenpot == lastchosenpot || chosenpot == lastlastchosenpot)
		{
			chosenpot++;
		}
		if (chosenpot > 4)
		{
			chosenpot = 0;
		}
	}
	if (chosenplant == lastlastchosenplant)
	{
		chosenplant++;
	}
	if (chosenplant > 2)
	{
		chosenplant = 0;
	}
	if (difficulty == 0)
	{
		if (count == 0)
		{
			chosenpot = 0;
			timermax = 40;
		}
		if (count == 1)
		{
			chosenpot = 2;
			timermax = 65;
			instance_create(x + 135, y, obj_terracota_pine_bullet);
		}
		if (count == 2)
		{
			chosenpot = 0;
			timermax = 61;
			instance_create(x + 45, y, obj_terracota_pine_bullet);
			instance_create(x + 105, y, obj_terracota_pine_bullet);
		}
		chosenplant = 0;
	}
	if (difficulty == 1)
	{
		chosenplant = 1;
		if (count == 0)
		{
			timermax = 10;
		}
		if (count == 2)
		{
			timermax = 30;
		}
	}
	if (difficulty == 2)
	{
		chosenplant = 2;
		if (timermax == 1)
		{
			timermax = 10;
		}
		else if (timermax == 10)
		{
			timermax = 25;
		}
	}
	if (difficulty == 3)
	{
		if (pattern == 0)
		{
			chosenplant = choose(0, 1);
		}
		if (pattern == 1)
		{
			chosenplant = choose(0, 2);
		}
		if (pattern == 2)
		{
			chosenplant = choose(1, 2);
		}
		if (count == 0)
		{
			timermax = 4;
		}
		if (count == 2)
		{
			timermax = 40;
		}
		if (count == 3)
		{
			timermax = 30;
		}
	}
	if (chosenpot == 0)
	{
		xx = 15;
	}
	if (chosenpot == 1)
	{
		xx = 45;
	}
	if (chosenpot == 2)
	{
		xx = 75;
	}
	if (chosenpot == 3)
	{
		xx = 105;
	}
	if (chosenpot == 4)
	{
		xx = 135;
	}
	if (chosenplant == 0)
	{
		instance_create(x + xx, y, obj_terracota_pine_bullet);
	}
	if (chosenplant == 1)
	{
		instance_create(x + xx, y, obj_terracota_leaf_bullet);
	}
	if (chosenplant == 2)
	{
		instance_create(x + xx, y, obj_terracota_flower_bullet);
	}
	if (difficulty == 3 && count == 0)
	{
		with (obj_terracota_pine_bullet)
		{
			fastspawn = true;
		}
		with (obj_terracota_leaf_bullet)
		{
			fastspawn = true;
		}
		with (obj_terracota_flower_bullet)
		{
			fastspawn = true;
		}
	}
	snd_play(snd_swallow);
	timer = 0;
	count++;
	lastlastlastchosenpot = lastlastchosenpot;
	lastlastchosenpot = lastchosenpot;
	lastchosenpot = chosenpot;
	lastlastchosenplant = lastchosenplant;
	lastchosenplant = chosenplant;
}
