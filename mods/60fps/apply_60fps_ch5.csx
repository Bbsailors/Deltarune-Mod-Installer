Apply("gml_Object_obj_dw_fcastle_pinkshop_Step_0", @"scr_populatechars();
for (var i = 0; i < flowercount; i++)
{
	with (flower[i])
	{
		var onstep = false;
		with (trig)
		{
			if (place_meeting(x, y, obj_mainchara))
			{
				onstep = 1;
			}
		}
		var _bought = bought;
		if (bought)
		{
			onstep = false;
		}
		if (onstep)
		{
			vis += (1 / global.fps_scale);
		}
		else
		{
			vis -= (1 / global.fps_scale);
		}
		var maxvis = 20;
		vis = clamp(vis, 0, maxvis);
		marker.image_alpha = lerp_out_cubic(0, 1, vis / maxvis);
		if (floorspotlightinit == false)
		{
			floorspotlight.x = marker.x + floorspotlight.xoff;
			floorspotlight.y = marker.y + floorspotlight.yoff;
			floorspotlightinit = true;
		}
		with (podium)
		{
			if (!_bought)
			{
				siner += (1 / global.fps_scale);
				item.x = x + 20;
				item.y = (y - 48) + (sin(siner / 8) * 2);
			}
			item.image_alpha = lerp(item.image_alpha, !_bought, scr_fps_lerp_rate(1/3));
			glow.x = x + 20;
			glow.y = y - 8 - 14;
			glow.image_xscale = 0.9;
			glow.image_yscale = 0.6;
			var targglow = ((sin(siner / 30) * 0.125) + 0.18 + (onstep * 0.35)) * !_bought;
			glow.image_alpha = lerp(glow.image_alpha, targglow, scr_fps_lerp_rate(0.125));
		}
	}
}
var buythisstring = stringsetsubloc(""* Buy this for ~1 Flowery Dollars and ~2 Pink Coins?/"", flowercost, pinkcost, ""obj_dw_fcastle_pinkshop_slash_Step_0_gml_61_0"");
