Apply("gml_Object_obj_plat_npc_Create_0", @"event_inherited();
windimmune = true;
image_speed = 0;
parallax_depth = 0;
parallax_x = x;
parallax_y = y;
true_image_blend = image_blend;
waiting_initialization = 0;
fog_alpha = 0;
fog_blend = 16777215;

oflash = function(arg0 = 16777215)
{
	fog_blend = arg0;
	fog_alpha = 0;
	scr_lerpvar(""fog_alpha"", 0, 1, 6, 1, ""out"");
	scr_script_delayed(scr_lerpvar, 7, ""fog_alpha"", 1, 0, 6, 1, ""in"");
};

can_jump = false;
sprite_offset_x = 0;
sprite_offset_y = 0;
sprite_image_index = 0;
sprite_draw = sprite_index;

set_sprite_simple = function(arg0, arg1 = false)
{
	if (!arg1)
	{
		sprite_offset_x = 0;
		sprite_offset_y = 0;
		sprite_draw = arg0;
	}
	if (arg0 != spr_idle && arg0 != spr_run && arg0 != spr_halt && arg0 != spr_jump && arg0 != spr_fall && arg0 != spr_turn && arg0 != spr_land)
	{
		if (!arg1)
		{
			force_animation(arg0);
		}
	}
	else if (arg1)
	{
		sprite_draw = arg0;
	}
};

set_sprite = function(arg0)
{
	set_sprite_simple(arg0);
	sprite_offset_x = (0.5 * sprite_get_width(arg0)) - sprite_get_xoffset(arg0);
	sprite_offset_y = ((-0.5 * (sprite_height / image_yscale)) + sprite_get_height(arg0)) - sprite_get_yoffset(arg0);
};

set_image_index = function(arg0)
{
	sprite_image_index = arg0;
};

release_jump = false;
depth = 2050;
entity_gravity = 1.25 / (global.fps_scale * global.fps_scale);
default_gravity = 1.25 / (global.fps_scale * global.fps_scale);
jumpheight = 20 / global.fps_scale;
land_anim = false;
turn_anim = false;
runstop_anim = false;
air_accel = 1.5 / (global.fps_scale * global.fps_scale);
air_decel = 0.85;
ground_accel = 2 / (global.fps_scale * global.fps_scale);
ground_decel = 0.65;
important = false;
important_blend = 1;
jumping = 0;
jump_coyote_time_max = 4;
jump_coyote_time = 0;
jumpsquat = 0;
jumpsquat_max = round(2 * global.fps_scale);
fallen_in_pit = false;
respawn_leap = false;
respawn_leap_wait = 15;
respawn_leap_enabled = 0;
key_left_override = false;
key_right_override = false;
state = 0;
hspeed_max = 9 / global.fps_scale;

turn = function(arg0)
{
	var flipped = (sign(image_xscale) < 0 && arg0) || (sign(image_xscale) > 0 && !arg0);
	if (arg0)
	{
		image_xscale = 2;
	}
	else
	{
		image_xscale = -2;
	}
	if (flipped)
	{
		if (sprite_draw == 8232 || sprite_draw == 2919 || sprite_draw == 7992)
		{
			x -= (10 * image_xscale);
		}
	}
};

force_jump = function()
{
	press_jump = true;
};

character = 1;
name = ""???"";
forced_anim = false;
anim_delayer = -4;

force_animation = function(arg0, arg1)
{
	with (anim_delayer)
	{
		instance_destroy();
	}
	forced_anim = true;
	sprite_offset_x = (0.5 * sprite_get_width(arg0)) - sprite_get_xoffset(arg0);
	sprite_offset_y = ((-0.5 * (sprite_height / image_yscale)) + sprite_get_height(arg0)) - sprite_get_yoffset(arg0);
	sprite_draw = arg0;
	if (is_numeric(arg1) || arg1 == undefined)
	{
		if (arg1 > 0)
		{
			anim_delayer = scr_delay_var(""forced_anim"", false, arg1);
		}
	}
	else
	{
		anim_delayer = scr_delay_var_until(""forced_anim"", false, arg1);
	}
};

restore_animation = function()
{
	with (anim_delayer)
	{
		instance_destroy();
	}
	forced_anim = false;
};

custom_state = undefined;
custom_waiter = undefined;

custom_behaviour = function(arg0, arg1, arg2)
{
	restore_default_behavior(true);
	caterpillarmode = false;
	custom_state = arg0;
	state = -1;
	if (arg2 == undefined)
	{
		arg2 = restore_default_behavior;
	}
	if (is_numeric(arg1) || arg1 == undefined)
	{
		if (arg1 > 0)
		{
			custom_waiter = scr_script_delayed(arg2, arg1);
		}
	}
	else
	{
		custom_waiter = scr_script_delayed_until(arg2, arg1);
	}
};

restore_default_behavior = function(arg0)
{
	with (custom_waiter)
	{
		instance_destroy();
	}
	if (image_speed == 0)
	{
		image_speed = 0.25 / global.fps_scale;
	}
	important = true;
	grounded = true;
	physics = true;
	reachedtarget = false;
	gravity = default_gravity;
	depth = defaultdepth;
	jumpsquat = 0;
	jumping = 0;
	state = 0;
	if (!arg0)
	{
		restore_animation();
	}
};

get_preset = function(arg0)
{
	character = arg0;
	switch (arg0)
	{
		case 0:
