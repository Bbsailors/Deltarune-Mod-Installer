		msgnextloc(""* (The sight set me aghast.)/"", ""obj_church_entrance_festival_slash_Step_0_gml_39_0"");
		msgnextloc(""* (The sanctuary^1, in shambles^1. Candles^1, books^1, torn and strewn about.)/"", ""obj_church_entrance_festival_slash_Step_0_gml_40_0"");
