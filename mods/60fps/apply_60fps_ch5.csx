	var _rapos_blu = findspriteinfo(spr_debug_ramarker, undefined, c_blue);
	c_sel(kr);
	c_walkdirect(_krpos_blu.x, _krpos_blu.y, 30);
	c_sel(su);
	c_walkdirect(_supos_blu.x, _supos_blu.y, 30);
	c_sel(ra);
	c_walkdirect(_rapos_blu.x, _rapos_blu.y, 30);
	c_wait(31);
	c_sel(kr);
	c_facing(""d"");
	c_sel(su);
	c_facing(""d"");
	c_sel(ra);
	c_facing(""d"");
	c_speaker(""ralsei"");
	c_msgsetloc(0, ""\\E0* Look^1! It's like the puzzle from our first adventure!/"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_111_0"");
	c_msgnextloc(""\\E1* The one where everyone has to step on the switches.../"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_112_0"");
	c_facenext(""susie"", ""D"");
	c_msgnextloc(""\\ED* ..^1. yeah^1. The one you^1, uh^1, needed me to help solve^1, right...?/%"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_114_0"");
	c_talk();
	c_wait_box(3);
	c_sel(su);
	c_sprite(spr_susie_down_head_tilted);
	c_wait_talk();
	c_speaker(""ralsei"");
	c_msgsetloc(0, ""\\E1* Right^1. We could only solve it as the three of us together.../%"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_123_0"");
	c_talk_wait();
	c_sel(su);
	c_sprite(spr_susie_pose);
	c_speaker(""susie"");
	c_msgsetloc(0, ""\\E2* ..^1. so^1, hell are we waiting for^1? Let's do it./"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_131_0"");
	c_msgnextloc(""\\E9* I'll get the left^1, Ralsei^1, you get the right!/%"", ""obj_dw_garden_hardpressureplates_slash_Step_0_gml_132_0"");
