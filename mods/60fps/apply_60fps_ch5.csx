	{
		scr_plat_barrier_enable();
		with (obj_knifewall_generator)
		{
			create_knife_arc(8);
		}
	}, []);
	c_wait(5);
	c_actortokris();
	c_actortocaterpillar();
}
if (con == 2 && !i_ex(obj_cutscene_master))
{
	global.interact = 0;
