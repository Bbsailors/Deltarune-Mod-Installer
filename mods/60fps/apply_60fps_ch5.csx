Apply("gml_Object_obj_plat_aquaknife_3d_Create_0", @"event_inherited();
image_xscale = 2;
image_yscale = 2;
con = 0;
timer = 0;
image_alpha = 0;
index = 0;
tx = 0;
ty = 0;
spd = 10 / global.fps_scale;
contimer = 0;
image_blend = c_gray;
image_speed = 0;
image_xscale = 0.5;
image_yscale = 0.5;
damage = 0;

shoot_at = function(arg0, arg1)
{
	tx = arg0;
	ty = arg1;
	con = 1;
	neutralized = 0;
	timer = 0;
	depth = obj_plat_player.depth - 5;
	snd_play(snd_smallswing, 0.6, 1 + (0.05 * index));
	speed = spd * 1.5;
};

image_speed = 0;

do_contact_kill = function()
{
	with (scr_plat_vfx(3614))
	{
		die_animend = 1;
		depth -= 1;
	}
};
");

Apply("gml_Object_obj_plat_aquaknife_3d_Step_0", @"if (global.pause_plat)
{
	exit;
}
timer += (1 / global.fps_scale);
if (con == 0)
{
	if (timer == 1)
	{
		speed = 9 / global.fps_scale;
		with (obj_knifewall_generator)
		{
			randomize_aquasprite();
		}
		snd_play(snd_wing, 0.5, 1 + (0.05 * index));
	}
	if (timer > 1)
	{
		speed = scr_approach(speed, 0, 1.2 / global.fps_scale);
		image_alpha = scr_approach(image_alpha, 1, 0.05);
	}
	neutralized = 100;
	image_angle = direction;
}
if (con == 1)
{
	damage = 25;
	contimer += (1 / global.fps_scale);
	var _ty = ty;
	if (contimer < 60)
	{
		var dir = point_direction(x, y, tx, ty);
		if (direction < 90)
		{
			dir -= 360;
		}
		dir = scr_approach(direction, dir, 5);
		if (contimer < 15 || abs(dir - 270) < 90)
		{
			direction = dir;
		}
	}
	if (contimer < 30)
	{
		image_index = scr_approach(image_index, 6, 0.5);
		speed = scr_approach(speed, 0.5 / global.fps_scale, 0.5 / global.fps_scale);
		if (contimer == 30)
		{
			image_xscale = -image_xscale;
		}
	}
	else
	{
		image_index = scr_approach(image_index, 0, 0.5);
		speed = scr_approach(speed, spd, (0.2 / global.fps_scale) + (0.01 * speed));
	}
	image_xscale = scr_approach(image_xscale, 2 * sign(image_xscale), 0.1);
	image_yscale = scr_approach(image_yscale, 2, 0.1);
	image_blend = merge_color(c_gray, c_white, min(timer / 50, 1));
	if (y > ty && neutralized <= 0)
	{
		neutralized = 100;
		scr_doom(self, 90);
	}
	image_angle = direction;
}
if (con < 3 && scr_wind_direction() == 90)
{
	con = 3;
	gravity = 1 / (global.fps_scale * global.fps_scale);
	image_index = 0;
	gravity_direction = 90;
	scr_doom(self, 200);
}
if (con == 3)
{
	image_angle += (hspeed + vspeed);
}
");

Apply("gml_Object_obj_plat_aquaknife_winddirect_Create_0", @"event_inherited();
speed = 5 / global.fps_scale;
hitstop_value = 0;
direction = 0;
wind_direction = 0;
image_angle = direction;
lifetime = 150;
image_xscale = 2;
image_yscale = 2;
init = 0;
performs_culling_checks = true;
cull_buffer = 20;
particle_struct = -4;
afterimage_system = -4;
blurtimer = 0;
blurry = false;
image_speed = 0.25 / global.fps_scale;
double_swipe = false;
was_onscreen = false;
redirected = false;
force_direction = false;
con = 0;
timer = 0;
wind_spin = random_range(-5, 5) / global.fps_scale;
homing = false;
split = false;
target_player = false;

do_contact_kill = function()
{
	with (scr_plat_vfx(3614))
	{
		die_animend = 1;
		depth -= 1;
	}
};
");

Apply("gml_Object_obj_plat_aquaknife_winddirect_Step_0", @"if (!init)
{
	init = 1;
}
if (global.pause_plat)
{
	exit;
}
blurtimer += (1 / global.fps_scale);
if (is_culled && y > (ystart + 300))
{
	instance_destroy();
	exit;
}
if (wind_direction == 1)
{
	speed = 0;
	hspeed = 0;
	vspeed = -2 / global.fps_scale;
	image_angle += wind_spin;
}
else if (!force_direction)
{
	var wind = scr_wind_direction();
	if (wind != wind_direction)
	{
		wind_direction = wind;
		var _s = speed;
		speed = 0;
		scr_lerpvar(""direction"", direction, wind * 90, 15);
		scr_delay_var(""speed"", _s, 15);
	}
	image_angle = direction;
}
else if (homing)
{
	if (con == 0)
	{
		if (y < (camera_get_view_y(view_camera[0]) + 60))
		{
			image_angle = direction;
		}
		else
		{
			con = 1;
			hspeed = 0;
			vspeed = 0;
			scr_lerpvar(""image_angle"", image_angle, 990, 15, 3, ""out"");
			scr_lerpvar(""x"", x, obj_plat_player.x, 15, 3, ""out"");
			scr_delay_var(""con"", 2, 15);
		}
	}
	else if (con == 2)
	{
		con = 3;
		snd_play(snd_spearrise);
		hspeed = 0;
		scr_lerpvar(""vspeed"", vspeed, 8 / global.fps_scale, 15, -1, ""in"");
	}
}
else
{
	if (target_player)
	{
		target_dir = point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
		direction = clamp(scr_approach(direction, target_dir, 2), 240, 310);
	}
	image_angle = direction;
}
timer += (1 / global.fps_scale);
if ((timer % 4) == 0)
{
	if (instance_exists(afterimage_system))
	{
		afterimage_system.x = x;
		afterimage_system.y = y;
		particle_struct.image_angle = image_angle;
		particle_struct.image_xscale = image_xscale;
		particle_struct.image_yscale = image_yscale;
		particle_struct.image_alpha = image_alpha * 0.3;
		afterimage_system.emit(particle_struct);
	}
}
");

