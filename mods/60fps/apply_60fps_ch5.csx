	};
	
	approach_points = function()
	{
		p_c[0] = scr_approach(p_c[0], point_center[0], abs(p_c[0] - point_center[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_c[1] = scr_approach(p_c[1], point_center[1], abs(p_c[1] - point_center[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_fl[0] = scr_approach(p_fl[0], point_foot_left[0], abs(p_fl[0] - point_foot_left[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_fl[1] = scr_approach(p_fl[1], point_foot_left[1], abs(p_fl[1] - point_foot_left[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_fr[0] = scr_approach(p_fr[0], point_foot_right[0], abs(p_fr[0] - point_foot_right[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_fr[1] = scr_approach(p_fr[1], point_foot_right[1], abs(p_fr[1] - point_foot_right[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_al[0] = scr_approach(p_al[0], point_ass_left[0], abs(p_al[0] - point_ass_left[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_al[1] = scr_approach(p_al[1], point_ass_left[1], abs(p_al[1] - point_ass_left[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_ar[0] = scr_approach(p_ar[0], point_ass_right[0], abs(p_ar[0] - point_ass_right[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_ar[1] = scr_approach(p_ar[1], point_ass_right[1], abs(p_ar[1] - point_ass_right[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_t[0] = scr_approach(p_t[0], point_torso[0], abs(p_t[0] - point_torso[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_t[1] = scr_approach(p_t[1], point_torso[1], abs(p_t[1] - point_torso[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_sl[0] = scr_approach(p_sl[0], point_shoulder_left[0], abs(p_sl[0] - point_shoulder_left[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_sl[1] = scr_approach(p_sl[1], point_shoulder_left[1], abs(p_sl[1] - point_shoulder_left[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_sr[0] = scr_approach(p_sr[0], point_shoulder_right[0], abs(p_sr[0] - point_shoulder_right[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_sr[1] = scr_approach(p_sr[1], point_shoulder_right[1], abs(p_sr[1] - point_shoulder_right[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_hl[0] = scr_approach(p_hl[0], point_hand_left[0], abs(p_hl[0] - point_hand_left[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_hl[1] = scr_approach(p_hl[1], point_hand_left[1], abs(p_hl[1] - point_hand_left[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_hr[0] = scr_approach(p_hr[0], point_hand_right[0], abs(p_hr[0] - point_hand_right[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_hr[1] = scr_approach(p_hr[1], point_hand_right[1], abs(p_hr[1] - point_hand_right[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_h[0] = scr_approach(p_h[0], point_head[0], abs(p_h[0] - point_head[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_h[1] = scr_approach(p_h[1], point_head[1], abs(p_h[1] - point_head[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_kl[0] = scr_approach(p_kl[0], point_knee_left[0], abs(p_kl[0] - point_knee_left[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_kl[1] = scr_approach(p_kl[1], point_knee_left[1], abs(p_kl[1] - point_knee_left[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_kr[0] = scr_approach(p_kr[0], point_knee_right[0], abs(p_kr[0] - point_knee_right[0]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
		p_kr[1] = scr_approach(p_kr[1], point_knee_right[1], abs(p_kr[1] - point_knee_right[1]) * (1 - power(1 - factor, 1 / global.fps_scale)) * global.fps_scale);
	};
	
	set_points();
	approach_points();
	
	step_func = function()
	{
		attack_timer += (1 / global.fps_scale);
		timer += (timer_speed / global.fps_scale);
		set_points();
		approach_points();
	};
	
	draw_func = function()
	{
		if (!surface_exists(my_surface))
		{
			my_surface = surface_create(240, 240);
		}
		surface_set_target(my_surface);
		draw_clear_alpha(c_white, 0);
		var _xoff = -22;
		var _yoff = -18;
		draw_sprite_ext(spr_ballperson_battle, 0, p_hl[0] + _xoff, p_hl[1] + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, p_sl[0] + _xoff, p_sl[1] + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_fl[0] * 0.75) + (p_kl[0] * 0.25) + _xoff, (p_fl[1] * 0.75) + (p_kl[1] * 0.25) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_fl[0] * 0.25) + (p_kl[0] * 0.75) + _xoff, (p_fl[1] * 0.25) + (p_kl[1] * 0.75) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_kl[0] * 0.75) + (p_al[0] * 0.25) + _xoff, (p_kl[1] * 0.75) + (p_al[1] * 0.25) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_kl[0] * 0.25) + (p_al[0] * 0.75) + _xoff, (p_kl[1] * 0.25) + (p_al[1] * 0.75) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, p_c[0] + _xoff, (p_c[1] + _yoff) - 5, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, p_t[0] + _xoff, p_t[1] + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle_wig, 0, p_h[0] + _xoff, p_h[1] + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_ar[0] * 0.75) + (p_kr[0] * 0.25) + _xoff, (p_ar[1] * 0.75) + (p_kr[1] * 0.25) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_ar[0] * 0.25) + (p_kr[0] * 0.75) + _xoff, (p_ar[1] * 0.25) + (p_kr[1] * 0.75) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_kr[0] * 0.75) + (p_fr[0] * 0.25) + _xoff, (p_kr[1] * 0.75) + (p_fr[1] * 0.25) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, (p_kr[0] * 0.25) + (p_fr[0] * 0.75) + _xoff, (p_kr[1] * 0.25) + (p_fr[1] * 0.75) + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, p_sr[0] + _xoff, p_sr[1] + _yoff, 2, 2, 0, c_white, 1);
		draw_sprite_ext(spr_ballperson_battle, 0, p_hr[0] + _xoff, p_hr[1] + _yoff, 2, 2, 0, c_white, 1);
		surface_reset_target();
		var _off = 0;
		if (image_xscale == -1)
		{
			_off = 240;
		}
		draw_surface_ext(my_surface, (x - 120) + _off, y - 120, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
		if (master.flash == 1)
		{
			d3d_set_fog(true, image_blend, 0, 0);
			draw_surface_ext(my_surface, x - 120, y - 120, image_xscale, 1, 0, c_white, (-cos(master.fsiner / 5) * 0.4) + 0.6);
			d3d_set_fog(false, c_black, 0, 0);
		}
	};
	
	clean_func = function()
	{
		if (surface_exists(my_surface))
		{
			surface_free(my_surface);
		}
	};
}
with (trashy_marker)
{
	master = other.id;
	idlesprite = spr_npc_trashy;
	hurtsprite = spr_npc_trashy;
	sparedsprite = spr_npc_trashy;
	image_xscale = 2;
	image_yscale = 2;
	image_alpha = 0;
	scr_lerpvar(""image_alpha"", 0, 1, 15);
	counter = 0;
	super_counter = 0;
	image_speed = 0.16666666666666666;
	siner = 0;
	
	draw_func = function()
	{
		if (!visible)
		{
			exit;
		}
		if (i_ex(master))
		{
			if (master.state == 0 || master.state == 3)
			{
				siner += (image_speed / global.fps_scale);
				var thissprite = idlesprite;
				draw_sprite_ext(thissprite, siner, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
				if (master.flash == 1)
				{
					draw_sprite_ext_flash(thissprite, siner, x, y, image_xscale, image_yscale, image_angle, image_blend, (-cos(master.fsiner / 5) * 0.4) + 0.6);
				}
			}
		}
	};
}
with (nubert_marker)
{
	master = other.id;
	idlesprite = spr_npc_nubert_super_burrow;
	hurtsprite = spr_npc_nubert_super_burrow;
	sparedsprite = spr_npc_nubert_super_burrow;
	image_xscale = 2;
	image_yscale = 2;
	image_alpha = 0;
	scr_lerpvar(""image_alpha"", 0, 1, 15);
	image_speed = 0;
	image_goal = 0;
	siner = 0;
	
	draw_func = function()
	{
		if (idlesprite != spr_npc_nubert_super)
		{
			siner = scr_approach(siner, image_goal, 0.5);
		}
		if (i_ex(master))
		{
			if (master.state == 0 || master.state == 3)
			{
				siner += (image_speed / global.fps_scale);
				var thissprite = idlesprite;
				draw_sprite_ext(thissprite, siner, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
				if (master.flash == 1)
				{
					draw_sprite_ext_flash(thissprite, siner, x, y, image_xscale, image_yscale, image_angle, image_blend, (-cos(master.fsiner / 5) * 0.4) + 0.6);
				}
			}
		}
	};
}
s_trash_attack = stringsetloc(""* The air crackles with something. But it smells bad, so you ignore it..."", ""obj_trashy_trio_slash_Create_0_gml_265_0"");
s_trash_beam = stringsetloc(""* Trashy's hands glow a strange color...^2 seems irrelevant though..."", ""obj_trashy_trio_slash_Create_0_gml_266_0"");
s_ball_attack = stringsetloc(""* You felt lightheaded. You see rhythmically bouncing balls."", ""obj_trashy_trio_slash_Create_0_gml_267_0"");
s_nubert_attack = stringsetloc(""* Your vision expands. The world moves up around you."", ""obj_trashy_trio_slash_Create_0_gml_268_0"");
s_milk_spire = stringsetloc(""* Damage absorbed by Milk Spire."", ""obj_trashy_trio_slash_Create_0_gml_269_0"");
s_trashy_1 = stringsetloc(""The three of us&have been neglected&long enough...!/%"", ""obj_trashy_trio_slash_Create_0_gml_494_0"");
s_trashy_1b = stringsetloc(""It's time for you&to see our true&power.../%"", ""obj_trashy_trio_slash_Create_0_gml_495_0"");
s_trashy_1c = stringsetloc(""... as the most&popular trio in&town!!/%"", ""obj_trashy_trio_slash_Create_0_gml_496_0"");
s_trashy_2 = stringsetloc(""Even though we&never interacted,&our spirit unites&us, hyuk!/%"", ""obj_trashy_trio_slash_Create_0_gml_274_0"");
s_trashy_3 = stringsetloc(""One man's Trashy&is another man's^2&...&Treasurey!/%"", ""obj_trashy_trio_slash_Create_0_gml_275_0"");
s_ball_1 = stringsetloc(""I am more than&just a ball...&I'm THE ball./%"", ""obj_trashy_trio_slash_Create_0_gml_277_0"");
s_ball_2 = stringsetloc(""Imagination&is power!/%"", ""obj_trashy_trio_slash_Create_0_gml_278_0"");
s_ball_3 = stringsetloc(""Ball to the&ground!/%"", ""obj_trashy_trio_slash_Create_0_gml_279_0"");
s_nubert_1 = stringsetloc(""Move up together,&and one day&you'll reach&the peak./%"", ""obj_trashy_trio_slash_Create_0_gml_281_0"");
s_nubert_2 = stringsetloc(""Nubert's goin'&further beyond./%"", ""obj_trashy_trio_slash_Create_0_gml_282_0"");
s_nubert_3 = stringsetloc(""... but Nubert&hasn't even gone&times ten./%"", ""obj_trashy_trio_slash_Create_0_gml_283_0"");
s_cleanup = stringsetloc(""* You used CLEAN UP! Remove trash with BROOM!/%"", ""obj_trashy_trio_slash_Create_0_gml_286_0"");
s_layup = stringsetloc(""* You used LAY UP! Get bullets through the hoop!/%"", ""obj_trashy_trio_slash_Create_0_gml_287_0"");
s_moveup = stringsetloc(""* You used MOVE UP! The battlefield extends!/%"", ""obj_trashy_trio_slash_Create_0_gml_288_0"");
s_post_1 = stringsetloc(""Hey, hey HEY!/%"", ""obj_trashy_trio_slash_Create_0_gml_291_0"");
s_post_2 = stringsetloc(""I THOUGHT I&heard someone&misusing the&BATTAT motif!!/%"", ""obj_trashy_trio_slash_Create_0_gml_292_0"");
if (os_type == os_switch2)
{
	s_post_2 = stringsetloc(""I THOUGHT I&heard someone&misusing the&AIR WAVES motif!!/%"", ""obj_trashy_trio_slash_Create_0_gml_529_0"");
}
s_post_3 = stringsetloc(""What's all this&about being the&most popular trio!?/%"", ""obj_trashy_trio_slash_Create_0_gml_293_0"");
s_post_4 = stringsetloc(""Well, uh.../%"", ""obj_trashy_trio_slash_Create_0_gml_295_0"");
s_post_5 = stringsetloc(""Get 'em,&guys!!!/%"", ""obj_trashy_trio_slash_Create_0_gml_297_0"");
s_post_6 = stringsetloc(""Well, guess&the battle's&over!^1&See ya!/%"", ""obj_trashy_trio_slash_Create_0_gml_299_0"");
s_post_7 = stringsetloc(""We sure showed&dat trio, huh,&boss!?/%"", ""obj_trashy_trio_slash_Create_0_gml_301_0"");
s_post_8 = stringsetloc(""Umm,^1 did someone&say.../%"", ""obj_trashy_trio_slash_Create_0_gml_303_0"");
s_post_9 = stringsetloc(""\""Trio\""?/%"", ""obj_trashy_trio_slash_Create_0_gml_304_0"");
s_post_10 = stringsetloc(""Wh.../%"", ""obj_trashy_trio_slash_Create_0_gml_306_0"");
s_post_11 = stringsetloc(""Because if&you're a throuple/%"", ""obj_trashy_trio_slash_Create_0_gml_531_0_b"");
s_post_11b = stringsetloc(""we'll have to&stop you.../%"", ""obj_trashy_trio_slash_Create_0_gml_532_0_b"");
s_post_12 = stringsetloc(""And I'll Assiste./%"", ""obj_trashy_trio_slash_Create_0_gml_310_0"");
s_post_13 = stringsetloc(""I think...^2&I need some&alone time./%"", ""obj_trashy_trio_slash_Create_0_gml_312_0"");
s_post_14 = stringsetloc(""Me too./%"", ""obj_trashy_trio_slash_Create_0_gml_314_0"");
s_post_15 = stringsetloc(""Yes,&me too./%"", ""obj_trashy_trio_slash_Create_0_gml_315_0"");
s_post_16 = stringsetloc(""Yea, same./%"", ""obj_trashy_trio_slash_Create_0_gml_316_0"");
s_post_17 = stringsetloc("":)/%"", ""obj_trashy_trio_slash_Create_0_gml_317_0"");
s_post_18 = stringsetloc("".../%"", ""obj_trashy_trio_slash_Create_0_gml_319_0"");
s_post_19 = stringsetloc(""Letteth us call&it a \""Tie\""./%"", ""obj_trashy_trio_slash_Create_0_gml_320_0"");
s_sim_sus_1 = stringsetloc(""* Susie licks a chip bag clean!"", ""obj_trashy_trio_slash_Create_0_gml_526_0"");
s_sim_sus_2 = stringsetloc(""* Susie does a biiiig stretch!"", ""obj_trashy_trio_slash_Create_0_gml_527_0"");
s_sim_sus_3 = stringsetloc(""* Susie dribbles!"", ""obj_trashy_trio_slash_Create_0_gml_528_0"");
s_sim_ral_1 = stringsetloc(""* Ralsei cleans a milk carton!"", ""obj_trashy_trio_slash_Create_0_gml_530_0"");
s_sim_ral_2 = stringsetloc(""* Ralsei floats up slightly!"", ""obj_trashy_trio_slash_Create_0_gml_531_0"");
s_sim_ral_3 = stringsetloc(""* Ralsei misses a free throw!"", ""obj_trashy_trio_slash_Create_0_gml_532_0"");
end_turn_action();
");

Apply("gml_Object_obj_trashy_trio_Other_11", @"var do_turn = true;
with (trashy_marker)
{
	if (counter == 2)
	{
		do_turn = false;
	}
}
if (do_turn)
{
	turns++;
}
switch (turns % 3)
{
	case 0:
		trashy_counter = scr_approach(trashy_counter, 2, 1 * global.fps_scale);
		var _beam = false;
		with (trashy_marker)
		{
			if (counter == 2)
			{
				_beam = true;
				counter = 0;
				super_counter++;
			}
			else
			{
				counter++;
			}
		}
		if (_beam)
		{
			with (trashy_marker)
			{
				if (super_counter == 2)
				{
					other.myattackchoice = 4;
				}
				else
				{
					other.myattackchoice = 3;
				}
			}
		}
		else
		{
			myattackchoice = 0;
		}
		break;
	case 1:
		ball_counter = scr_approach(ball_counter, 2, 1 * global.fps_scale);
		myattackchoice = 1;
		break;
	case 2:
		nubert_counter = scr_approach(nubert_counter, 2, 1 * global.fps_scale);
		myattackchoice = 2;
		break;
}
if (variable_instance_exists(id, ""myself""))
{
	if (global.mercymod[myself] >= 99)
	{
		do_postturn = true;
	}
}
");

Apply("gml_Object_obj_trashy_trio_Step_0", @"back = scr_approach(back, 0, 1);
if (scr_debug())
{
	if (keyboard_check_pressed(vk_control))
	{
		with (scr_mercyadd(myself, 98))
		{
			x += 40;
			y -= 20;
			ystart = x;
			ystart = y;
		}
	}
}
if (global.monster[myself] == 1)
{
	if (global.mnfight == 2 && global.turntimer <= -15 && global.mercymod[myself] >= 99 && fight_type != ""over"")
	{
		fight_type = ""over"";
		msgset_add_func(function()
		{
			mus_volume(global.batmusic[1], 0, 60);
			with (trashy_marker)
			{
				idlesprite = spr_npc_trashy_battle;
				x = xstart;
			}
			with (obj_bullet_trash_small)
			{
				scr_lerpvar(""image_alpha"", 1, 0, 15);
				scr_doom(id, 15);
			}
			pippins_marker = instance_create_depth(camerax() + 632 + 10, cameray() + 180, depth - 1, obj_marker);
			pluey_marker = instance_create_depth(camerax() + 646 + 10, cameray() + 150, depth - 1, obj_marker);
			jongler_marker = instance_create_depth(camerax() + 692 + 10, cameray() + 96, depth - 1, obj_marker);
			lanino_marker = instance_create(camerax() + 480 + 200, cameray() + 46, obj_marker_fancy);
			elnina_marker = instance_create(camerax() + 510 + 200, cameray() + 180, obj_marker_fancy);
			rouxls_marker = instance_create(camerax() + 495 + 200, cameray() + 113, obj_marker_fancy);
			with (lanino_marker)
			{
				alpha = 0;
				sprite_index = spr_lanino_idle_left;
				scr_darksize();
				
				draw_func = function()
				{
					draw_self();
					d3d_set_fog(true, c_white, 1, 1);
					draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, alpha);
					d3d_set_fog(false, c_white, 1, 1);
				};
			}
			with (elnina_marker)
			{
				alpha = 0;
				sprite_index = spr_elnina_idle_left;
				scr_darksize();
				
				draw_func = function()
				{
					draw_self();
					d3d_set_fog(true, c_white, 1, 1);
					draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, alpha);
					d3d_set_fog(false, c_white, 1, 1);
				};
			}
			with (rouxls_marker)
			{
				sprite_index = spr_rouxls_lefthandup;
				scr_darksize();
			}
			with (pippins_marker)
			{
				pippin_squad = true;
				sprite_index = spr_pippins_aggravated;
				image_speed = 0;
				scr_darksize();
			}
			with (pluey_marker)
			{
				pippin_squad = true;
				sprite_index = spr_mike_m;
				image_speed = 0.16666666666666666 / global.fps_scale;
				scr_darksize();
			}
			with (jongler_marker)
			{
				pippin_squad = true;
				sprite_index = spr_mike_l;
				image_speed = 0.16666666666666666;
				scr_darksize();
			}
		});
		msgset_add(s_post_1, camerax() + 620, function()
		{
			return pippins_marker.y - 10;
		}, 10, 50, function()
		{
			with (trashy_marker)
			{
				image_xscale *= -1;
				x += 144;
			}
			with (ball_marker)
			{
				image_xscale = -1;
			}
		});
		msgset_add_func(function()
		{
			with (trashy_marker)
			{
				scr_lerpvar(""x"", x, x - 180, 30);
			}
			with (ball_marker)
			{
				scr_lerpvar(""x"", x, x - 180, 30);
			}
			with (nubert_marker)
			{
				scr_lerpvar(""x"", x, x - 180, 30);
			}
			with (obj_marker)
			{
				if (variable_instance_exists(id, ""pippin_squad""))
				{
					scr_lerpvar(""x"", x, x - 190, 30);
				}
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 50);
		});
		msgset_add(s_post_2, function()
		{
			return pippins_marker.x + 36;
		}, function()
		{
			return pippins_marker.y - 10;
		}, 13, 50);
		msgset_add(s_post_3, function()
		{
			return pippins_marker.x + 36;
		}, function()
		{
			return pippins_marker.y - 10;
		}, 13, 50);
		msgset_add(s_post_4, function()
		{
			return trashy_marker.x - 72;
		}, function()
		{
			return trashy_marker.y - 10;
		}, 13, 50);
		msgset_add(s_post_5, function()
		{
			return pippins_marker.x + 36;
		}, function()
		{
			return pippins_marker.y - 10;
		}, 13, 50);
		msgset_add_func(function()
		{
			with (nubert_marker)
			{
				idlesprite = spr_npc_nubert_super_burrow;
				siner = 0;
				image_goal = 6;
			}
			snd_play(snd_jump);
			with (pippins_marker)
			{
				sprite_index = spr_pippins_attack;
				image_index = 0;
				image_speed = 0.5;
				scr_lerpvar(""y"", y, y - 30, 15, 1, ""out"");
				scr_lerpvar(""x"", x, x - 210, 15, 2, ""in"");
			}
			with (jongler_marker)
			{
				scr_lerpvar(""x"", x, x - 210, 15);
			}
			with (pluey_marker)
			{
				scr_script_delayed(scr_lerpvar, 3, ""x"", x, x - 210, 12);
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 15);
		});
		msgset_add_func(function()
		{
			with (obj_marker)
			{
				if (variable_instance_exists(id, ""pippin_squad""))
				{
					visible = false;
				}
			}
			with (trashy_marker)
			{
				visible = false;
			}
			with (ball_marker)
			{
				image_xscale = 1;
				scr_lerpvar(""timer_speed"", timer_speed, 0, 60);
			}
			with (pippins_marker)
			{
				with (instance_create_depth(x + sprite_get_width(sprite_index) + 20, (y + sprite_get_height(sprite_index)) - 8, depth, obj_marker_fancy))
				{
					sprite_index = spr_mike_smoke;
					image_xscale = 1.5;
					image_yscale = 1.5;
					image_blend = #F2F2F2;
					anchor_x = x;
					sound = snd_play(choose(punch_ish_1, snd_punchmed, snd_queen_punched_lower), 0.65, 0.75 + random(0.5));
					timer = audio_sound_length(sound);
					volume = 0.65;
					brawl_radius = 48;
					vfx_timer = 0;
					
					step_func = function()
					{
						timer -= (1 / global.fps_scale);
						vfx_timer += (1 / global.fps_scale);
						x = anchor_x - (sin(vfx_timer * 0.01) * brawl_radius);
						if ((vfx_timer % 2) == 0 && irandom(2) && volume > 0)
						{
							var _vfxangle = -45 + irandom(225);
							var _vfxdistance = 30 + random(50);
							with (instance_create_depth(x + lengthdir_x(_vfxdistance, _vfxangle), y + lengthdir_y(_vfxdistance, _vfxangle), depth - 1, obj_marker))
							{
								sprite_index = spr_plat_vfx_star;
								image_speed = 0;
								direction = _vfxangle + irandom_range(-10, 10);
								speed = 6 / global.fps_scale;
								gravity_direction = 270;
								gravity = 0.5 / (global.fps_scale * global.fps_scale);
								if (irandom(1))
								{
									image_xscale = 0.75;
									image_yscale = 0.75;
								}
								time = 6 + irandom(6);
								scr_script_delayed(scr_lerpvar, 3, ""image_xscale"", image_xscale, 0.25, time - 3);
								scr_script_delayed(scr_lerpvar, 3, ""image_yscale"", image_yscale, 0.25, time - 3);
								scr_doom(id, time);
							}
						}
						if (!timer)
						{
							sound = snd_play(choose(punch_ish_1, snd_queen_punched_lower), volume, 0.5 + random(0.75));
							timer = audio_sound_length(sound) * 3;
						}
					};
				}
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 60);
		});
		msgset_add_func(function()
		{
			with (ball_marker)
			{
				scr_lerpvar(""x"", x, x + 380, 120);
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 140);
		});
		msgset_add_func(function()
		{
			snd_play(snd_swallow);
			with (obj_marker_fancy)
			{
				if (sprite_index == spr_mike_smoke)
				{
					volume = 0.25;
					with (other.trashy_marker)
					{
						x = other.x + 72;
						visible = true;
						image_xscale *= -1;
						x -= 144;
						depth = other.depth - 1;
					}
				}
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 20);
		});
