	}
	yellow_actor.visible = false;
	global.batmusic[0] = snd_init(""miniboss_new_section_idea_wip.ogg"");
	scr_battle(222, 3, bluecopy, yellowcopy);
	with (yellowcopy)
	{
		scr_var_delay(""visible"", 0, 24);
	}
	with (bluecopy)
	{
		scr_var_delay(""visible"", 0, 24);
	}
	global.tempflag[tempflag_index]++;
	if (scr_debug())
	{
		show_debug_message_concat(""blueyellow already fought count: "", global.tempflag[tempflag_index]);
	}
	con = 4;
	timer = 0;
	battlesetup = false;
}
if (con == 4)
{
	timer += (1 / global.fps_scale);
