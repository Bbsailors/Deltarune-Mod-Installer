	c_speaker(""tenna"");
	c_msgsetloc(0, ""* ..^1. you cared about him too^1, Mike./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_801_0"");
	c_msgnextloc(""* That's why..^1. since then..^1. it feels like..^1. you're not really here./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_802_0"");
	c_msgnextloc(""* Everything is..^1. fake./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_803_0"");
