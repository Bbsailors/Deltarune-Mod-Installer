Apply("gml_Object_obj_green_bigpan_Step_0", @"timer += (1 / global.fps_scale);
if ((timer % 40) == 0)
{
	ds_list_shuffle(fire_list);
	image_index = 1;
	alarm[0] = round(12 * global.fps_scale);
	if (counter > 2 || (counter == 2 && irandom(1)))
	{
		healshot = true;
		counter -= 2;
	}
	var healshot_number = 0;
	if (healshot == true)
	{
		if ((obj_heart.x + 10) > (obj_growtangle.x + 30))
		{
			healshot_number = choose(0, 1);
		}
		else if ((obj_heart.x + 10) < (obj_growtangle.x - 30))
		{
			healshot_number = choose(1, 2);
		}
		else
		{
			healshot_number = choose(0, 2);
		}
	}
	for (a = 0; a < 3; a++)
	{
		if (healshot && a == healshot_number)
		{
			with (scr_fire_bullet(scr_get_box(2) + 20 + (60 * a) + (sin(timer * 0.15) * 20), scr_get_box(3), obj_bullet_healing, choose(0, 180), random_range(-0.5, 0.5), spr_bullet_green_egg))
			{
				mask_index = spr_bullet_green_flame_mask;
				image_xscale = 2;
				image_yscale = 2;
				depth = other.depth + 1;
				image_blend = c_lime;
				scr_lerpvar(""y"", y, y - 225, ds_list_find_value(other.fire_list, other.a), 2, ""out"");
				scr_script_delayed(scr_lerpvar, ds_list_find_value(other.fire_list, other.a), ""y"", y - 225, y, ds_list_find_value(other.fire_list, other.a), 2, ""in"");
				scr_script_delayed(instance_destroy, ds_list_find_value(other.fire_list, other.a) * 2);
			}
		}
		else
		{
			with (scr_fire_bullet(scr_get_box(2) + 20 + (60 * a) + (sin(timer * 0.15) * 20), scr_get_box(3), obj_regularbullet, choose(0, 180), random_range(-0.5, 0.5), spr_bullet_green_flame))
			{
				image_xscale = 1.5;
				image_yscale = 1.5;
				depth = other.depth + 1;
				scr_lerpvar(""y"", y, y - 225, ds_list_find_value(other.fire_list, other.a), 2, ""out"");
				scr_script_delayed(scr_lerpvar, ds_list_find_value(other.fire_list, other.a), ""y"", y - 225, y, ds_list_find_value(other.fire_list, other.a), 2, ""in"");
				scr_script_delayed(instance_destroy, ds_list_find_value(other.fire_list, other.a) * 2);
			}
		}
	}
	counter++;
	healshot = false;
}
");

Apply("gml_Object_obj_green_egg_heal_Draw_0", @"timer += (1 / global.fps_scale);
if (timer == 5)
{
	image_index = 1;
