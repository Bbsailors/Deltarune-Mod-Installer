	});
	c_var_instance(id, ""petalwinds"", 1);
	c_var_lerp_instance(id, ""petalwindspeed"", petalwindspeedmin, petalwindspeedmax, 35);
	c_wait(35);
	c_actortokris();
	c_actortocaterpillar();
	c_customfunc(function()
	{
		with (featherglow)
