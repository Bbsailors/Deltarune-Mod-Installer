			if (coindrops != 0 && (timer % 4) == 0 && timer != 0)
			{
				scr_plat_makecoins(x, y, -1, 90, 90, 8, 4, depth, undefined, undefined, 38 - timer);
				coindrops = scr_movetowards(coindrops, 0, 1);
			}
			dir += random_range(100, 140);
		}
	}
	timer += (1 / global.fps_scale);
	if (use_image_speed)
	{
		if (image_speed < 1)
		{
			image_speed = scr_movetowards(image_speed, 1, 0.1 / global.fps_scale);
		}
	}
	if (timer == 24)
	{
		timer = 0;
		con = 2;
	}
}
if (con == 2)
{
	snd_stop(other.mini_soundA);
	timer += (1 / global.fps_scale);
	if (timer == 4)
	{
		timer = 0;
		con = 3;
	}
}
if (con == 3)
{
	snd_stop(other.mini_soundB);
	snd_play(snd_enemy_defeat_big);
	scr_make_ripple(x, y, 16, 16777215, 200, 4, 20, depth - 1, undefined, undefined, undefined, undefined, undefined, undefined, 2, false);
	var _wall = round((image_angle + 180) / 90) * 90;
	if (coindrops != 0)
	{
