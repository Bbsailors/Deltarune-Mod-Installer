var debug = false;
if (debug)
{
	markerdelay = 0;
}
var ground = obj_plat_player.bbox_bottom;
var groundorig = ground;
var dm = debugmarker;
var rpush = 22;
var px = (floor(obj_plat_player.x / 40) * 40) + rpush;
var py = obj_plat_player.y;
var py_minus_ground = (groundorig - py) + 2;
var major_iter = 0;
with (obj_plat_player)
{
	var _upper_block_list = ds_list_create();
	while (px > other.bbox_left && major_iter < 5)
	{
		var pxx = px;
		px -= 40;
		var stepped_up = false;
		if (debug)
		{
			dm(px, py);
		}
		var iter = 0;
		var _wall = instance_place(px, py, obj_plat_block);
		while (_wall != -4 && iter < 5 && major_iter < 5)
		{
			var elevation;
			with (_wall)
			{
				iter++;
				if (_wall.extflag == ""shadowplatform_malleable"")
				{
					break;
				}
				px = (floor(bbox_right / 40) * 40) + rpush;
				stepped_up = true;
				py = bbox_top - py_minus_ground;
				if (debug)
				{
					dm(px, py);
				}
				ground = bbox_top;
				elevation = bbox_top;
				var upper_block = -4;
				with (obj_plat_player)
				{
					ds_list_clear(_upper_block_list);
					var _num_upper = instance_place_list(px, py, 1426, _upper_block_list, false);
					for (var i = 0; i < _num_upper; i++)
					{
						var _bl = ds_list_find_value(_upper_block_list, i);
						if (upper_block == -4 || _bl.bbox_right > upper_block.bbox_right)
						{
							if (_bl.image_xscale < 20 && _bl.id != other.id && _bl.extflag != ""shadowplatform_malleable"")
							{
								upper_block = _bl;
							}
						}
					}
				}
				if (upper_block != -4)
				{
					if (upper_block.bbox_right >= bbox_right)
					{
						px = max(px, (floor(upper_block.bbox_right / 40) * 40) + rpush);
						pxx = px + 40;
						iter--;
						major_iter++;
					}
				}
				else
				{
					var _myx = px + 40;
					var found_ceiling = false;
					var _bl2 = -4;
					with (obj_plat_player)
					{
						var ys = image_yscale;
						image_yscale *= 2;
						ds_list_clear(_upper_block_list);
						var _num_upper = instance_place_list(_myx, py + 10, 1426, _upper_block_list, false);
						for (var i = 0; i < _num_upper; i++)
						{
							var _bl = ds_list_find_value(_upper_block_list, i);
							if (_bl.bbox_right > other.bbox_right && _bl.image_xscale < 20 && (_bl2 == -4 || _bl.bbox_right < _bl2.bbox_right))
							{
								_bl2 = _bl;
								found_ceiling = true;
							}
						}
						image_yscale = ys;
					}
					if (!found_ceiling)
					{
						if (array_length(elevation_array) == 0)
						{
							array_push(elevation_array, elevation);
						}
						else
						{
							var rise = true;
							for (var i = 0; i < array_length(elevation_array); i++)
							{
								if (elevation >= elevation_array[i])
								{
									rise = false;
								}
							}
							if (rise)
							{
								array_push(elevation_array, elevation);
							}
						}
					}
					else
					{
						px = max(px, (floor(_bl2.bbox_right / 40) * 40) + rpush);
						pxx = px + 40;
						iter--;
						major_iter++;
						if (debug)
						{
							_bl2.visible = true;
							_bl2.image_blend = c_green;
							dm(_myx, py + 10, 1);
							dm(px, py, 1);
							scr_debug_print(""ceiling detected left"");
						}
					}
					if (debug)
					{
						with (instance_create(px, py, obj_animation))
						{
							sprite_index = spr_realisticexplosion;
							image_speed = 1 / global.fps_scale;
						}
					}
				}
			}
			_wall = instance_place(px, py, obj_plat_block);
			if (_wall == -4)
			{
				if (array_length(elevation_array) == 0)
				{
					array_push(elevation_array, elevation);
				}
				else
				{
					var rise = true;
					for (var i = 0; i < array_length(elevation_array); i++)
					{
						if (elevation >= elevation_array[i])
						{
							rise = false;
						}
					}
					if (rise)
					{
						array_push(elevation_array, elevation);
					}
				}
			}
		}
		px = pxx - 40;
		if (!stepped_up)
		{
			while (!place_meeting(px, py + 40, obj_plat_block) && py < (bbox_bottom + 80))
			{
				py += 40;
			}
		}
	}
	ds_list_destroy(_upper_block_list);
}
var stuck_left = false;
var hh = groundorig;
for (var i = 0; i < array_length(elevation_array); i++)
{
	if ((elevation_array[i] - hh) < -140)
	{
		stuck_left = true;
		break;
	}
	else
	{
		hh = min(elevation_array[i], hh);
	}
}
