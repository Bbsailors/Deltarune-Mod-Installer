	{
		var fx = instance_create(npc_worm.x - 24, npc_worm.y - 24, obj_marker);
		fx.depth = npc_worm.marker.depth + 100;
		npc_worm.marker.sprite_index = spr_kooby_develop_animation_eating;
		npc_worm.marker.image_speed = 0.1 / global.fps_scale;
		with (fx)
		{
			scr_darksize();
			sprite_index = spr_kooby_develop_effect;
			image_speed = 0.25 / global.fps_scale;
			scr_doom(self, 80);
		}
	}
	npc_worm.marker.image_index = min(koobytimer / 10, 5);
	if (koobytimer == 30)
	{
		snd_play(snd_sparkle_glock, 0.9, 1);
	}
	if (koobytimer >= 80)
	{
		koobycon = 2;
		koobytimer += (1 - (1 / global.fps_scale));
		npc_worm.marker.sprite_index = spr_kooby_developed_eating;
		npc_worm.marker.image_speed = 0;
		global.interact = 0;
	}
}
if (koobycon == 2)
{
	koobytimer += (1 / global.fps_scale);
