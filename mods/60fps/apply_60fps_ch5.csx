	scr_rudface(26, 7);
	global.msg[27] = stringsetloc(""\\E7* Bring him by the window^1! I'll throw something at him!/"", ""obj_rudy_slash_Step_0_gml_80_0"");
	scr_noeface(28, 8);
	global.msg[29] = stringsetloc(""\\E8* GOODBYE^1, dad./"", ""obj_rudy_slash_Step_0_gml_82_0"");
