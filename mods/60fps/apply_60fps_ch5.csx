	if (particletimer >= 2)
	{
		instance_create(random_range(x - (sprite_width / 2), x + (sprite_width / 2)), y - random(sprite_height), obj_dw_transition_particle);
		particletimer = 0;
	}
	if (con == 1)
	{
		snd_play(snd_dtrans_lw);
		with (obj_dw_leave)
		{
			if (bottom == 1)
			{
				draw_kris = 1;
				fake_v = 1;
			}
		}
		con = 2;
		alphab = 0;
		fake_v = -10;
	}
	if (con == 2)
	{
		alphab += (0.001 / global.fps_scale);
		fake_v += ((0.5 + (alphab * 20)) / global.fps_scale);
		draw_set_blend_mode(bm_add);
		draw_sprite_ext(sprite_index, 1, x, y, 99, 99, 0, c_white, fake_v / 80);
		draw_set_blend_mode(bm_normal);
		if ((fake_v / 80) >= 1.2)
		{
			pers = instance_create(0, 0, obj_persistentfadein);
			pers.image_blend = c_white;
			global.interact = 3;
			global.entrance = 24;
			snd_free(global.currentsong[0]);
			scr_become_light();
			if (global.plot == 16 && global.chapter == 2)
			{
				scr_losechar();
			}
			room_goto(nextroom);
		}
	}
}
if (bottom == 1)
{
	if (draw_kris == 1)
	{
		if (stopcon == 0)
		{
			fake_v -= (0.05 / (global.fps_scale * global.fps_scale));
		}
		kris_y += fake_v;
		kris_y = max(kris_y, y - 120);
		sus_y += fake_v;
		siner = ((siner + 60) * power(1.0166666666666666, 1 / global.fps_scale)) - 60;
		if (kris_only == 0)
		{
			draw_sprite_ext(spr_susie_dw_fall_d, siner / 6, sus_x, sus_y, 2, 2, 0, c_white, 1);
		}
		draw_sprite_ext(spr_kris_fall_d_dw, siner / 6, kris_x, kris_y, 2, 2, 0, c_white, 1);
	}
}
");

Apply("gml_Object_obj_dw_leave_flowery_Step_0", @"if (top == 1)
{
	exit;
}
if (con == 10)
{
	mus_volume(global.currentsong[1], 0, 15);
	if (instance_exists(obj_mainchara))
	{
		obj_mainchara.visible = 0;
		kr_actor = instance_create_depth(obj_mainchara.x, obj_mainchara.y, obj_mainchara.depth, obj_actor);
		obj_mainchara.x = (x - 34) + 10;
		obj_mainchara.y = y + 12;
		scr_pan_to_obj(obj_mainchara, 30);
		kr_actor.sprite_index = obj_mainchara.sprite_index;
		kr_actor.__x = kris_x + 6;
		kr_actor.__y = kris_y + 20;
		obj_mainchara.cutscene = 1;
		with (kr_actor)
		{
			scr_set_facing_sprites(""kris"");
			fun = 1;
			image_speed = 0.25;
			scr_move_to_point_over_time(__x, __y, 10);
		}
	}
	su_actor = instance_create_depth(global.cinstance[0].x, global.cinstance[0].y, global.cinstance[0].depth, obj_actor);
	su_actor.sprite_index = global.cinstance[0].sprite_index;
	su_actor.tx = sus_x;
	su_actor.ty = sus_y;
	var _wait_time = 40;
	global.cinstance[0].visible = false;
	with (su_actor)
	{
		kr_actor = other.kr_actor;
		with (kr_actor)
		{
			auto_depth = false;
		}
		scr_script_delayed(function()
		{
			scr_set_facing_sprites(""susie"");
			scr_move_to_point_over_time(tx, ty, 20);
		}, _wait_time);
		scr_script_delayed(function()
		{
			auto_depth = false;
			auto_walk = false;
			sprite_index = spr_susie_grab;
			sprite_index = spr_susie_grab_kris_lightpillar;
			image_speed = 0.25 / global.fps_scale;
			with (obj_dw_leave_flowery)
			{
				draw_kris = false;
				snd_stop(leave_sound);
				snd_play(snd_whip_crack_only);
				scr_lerp_instance_var(white_out, ""image_alpha"", 0.4, 0, 10);
			}
		}, _wait_time + 20);
		var timeadd = 8;
		if (global.flag[1358] > 1)
		{
			timeadd = 15;
		}
		scr_script_delayed(function()
		{
			with (obj_dw_leave_flowery)
			{
				stopcon = 1;
			}
		}, _wait_time + 20 + timeadd);
	}
	contimer = 0;
	con = 11;
}
if (con == 11)
{
	contimer += (1 / global.fps_scale);
	if (contimer >= 20)
	{
		white_out.visible = true;
		white_out.image_alpha = 0;
		scr_lerp_instance_var(white_out, ""image_alpha"", 0, 0.3, 50);
		leave_sound = snd_play(snd_dtrans_lw);
		draw_kris = true;
		kris_only = 1;
		with (kr_actor)
		{
			visible = false;
		}
		con = 12;
		contimer--;
	}
}
if (stopcon == 1)
{
	global.interact = 1;
	stopcon = 2;
	stopcontimer = 0;
	global.facing = 0;
	if (global.flag[1358] == 0)
	{
		scr_speaker(""susie"");
		msgsetloc(0, ""\\E5* Nope^1. Get the hell back down here./%"", ""obj_dw_leave_flowery_slash_Step_0_gml_127_0"");
		d_make();
	}
	if (global.flag[1358] == 1)
	{
		scr_speaker(""susie"");
		msgsetloc(0, ""\\E0* ..^1. you're just having fun^1, aren't you./%"", ""obj_dw_leave_flowery_slash_Step_0_gml_133_0"");
		d_make();
	}
	if (global.flag[1358] > 1)
	{
	}
	scr_flag_set(1358, global.flag[1358] + 1);
}
if (stopcon == 2 && !d_ex())
{
	stopcontimer += (1 / global.fps_scale);
	if (stopcontimer == 1)
	{
		with (su_actor)
		{
			sprite_index = dsprite;
			image_speed = 0;
			image_index = 0;
		}
		with (kr_actor)
		{
			snd_play(snd_jump);
			auto_walk = 0;
			sprite_index = spr_kris_jump_ball_fixed;
			image_speed = 0.25 / global.fps_scale;
			var jumper = scr_jump_to_point(x, y + 40, 12, 20);
			jumper.image_speed = 0.25;
		}
	}
	if (stopcontimer == 21)
	{
		stopcon = 3;
	}
}
if (stopcon == 3)
{
	mus_volume(global.currentsong[1], 1, 0);
	reset_pos();
	stopcon = 0;
	con = 0;
	kris_y = y - 80;
	fake_v = 0;
	draw_kris = 0;
	obj_mainchara.cutscene = 0;
	with (kr_actor)
	{
		obj_mainchara.x = x;
		obj_mainchara.y = y;
	}
	obj_mainchara.x -= 6;
	with (obj_mainchara)
	{
		scr_depth();
	}
	obj_mainchara.sprite_index = spr_krisd_dark;
	global.facing = 0;
	obj_mainchara.visible = true;
	global.cinstance[0].visible = true;
	with (su_actor)
	{
		global.cinstance[0].x = x;
		global.cinstance[0].y = y;
	}
	scr_caterpillar_interpolate(""all"");
	with (kr_actor)
	{
		instance_destroy();
	}
	with (su_actor)
	{
		instance_destroy();
	}
	global.interact = 0;
}
if (con != 0)
{
}
");

