Apply("gml_Object_obj_circlezoom_Step_2", @"if (type == 0)
{
	siner += (1 / global.fps_scale);
	x += (sin(siner / 8) / 2 / global.fps_scale);
	y += (cos(siner / 8) / 2 / global.fps_scale);
	zoomtimer += ((zoomtimer / 5) + 16);
	if (zoomtimer >= zoomtime)
	{
		zoomtimer = zoomtime;
	}
	lerpamount = zoomtimer / zoomtime;
	if (lerpamount >= 1)
	{
		lerpamount = 1;
	}
	radius = lerp(startradius, endradius, lerpamount);
}
if (type == 1)
{
	if (radius > endradius)
	{
		radius -= 8;
	}
	if (radius <= 0)
	{
		radius = 0;
	}
}
surface_set_target(surf);
draw_clear(c_black);
draw_set_blend_mode(bm_subtract);
draw_set_color(c_white);
draw_circle(x, y, radius, false);
surface_reset_target();
draw_set_blend_mode(bm_normal);
if (finish == 1)
{
	type = 1;
	endradius = 0;
	zoomtime += 100;
}
");

Apply("gml_Object_obj_cliff_crater_Draw_0", @"if (instance_exists(obj_dw_fcastle_top_challenge))
{
	frontmarker.visible = 0;
	backmarker.visible = 0;
	exit;
}
var _palette = false;
if (instance_exists(obj_parallax_cliffs))
{
	_palette = obj_parallax_cliffs.music_mode || obj_parallax_cliffs.non_music_shade_mode;
}
if (_palette)
{
	pal_swap_set(obj_parallax_cliffs.cliff_pal, obj_parallax_cliffs.pal_index, false);
}
if (altdraw_active && surface_exists(surf))
{
	var __sc_p = surface_get_width(surf) / 640;
	draw_surface_part_ext(surf, (x - camerax()) * __sc_p, ((y + sprite_height) - cameray()) * __sc_p, sprite_width * __sc_p, abs((y + sprite_height) - (cameray() + cameraheight())) * __sc_p, x, y + sprite_height, 1 / __sc_p, 1 / __sc_p, 16777215, 1);
}
draw_self();
if (_palette)
{
	pal_swap_reset();
}
");

Apply("gml_Object_obj_cliff_crater_Other_18", @"with (obj_mainchara)
{
	roomenterfreezeend = 1;
	if (holding_item != -4 && other.doorKeepHeldItem)
	{
		with (obj_helditem)
		{
			if (held)
			{
				if (object_index == obj_wateringcan)
				{
					if (mode == 1)
					{
						global.flag[1332] = 2;
					}
					else
					{
						global.flag[1332] = 1;
					}
				}
				if (object_index == obj_pinwheel_held)
				{
					global.flag[1332] = 3;
				}
			}
		}
	}
	else
	{
		global.flag[1332] = 0;
	}
}
global.entrance_animation = 1;
global.start_in_platmode = false;
if (doorFadeMusic)
{
	alarm[3] = round(doorFadeMusicTime * global.fps_scale);
	mus_volume(global.currentsong[1], 0, doorFadeMusicTime);
}
with (obj_overworldbulletparent)
{
	active = 0;
}
");

Apply("gml_Object_obj_cliff_crater_Step_0", @"event_inherited();
if (con == 1)
{
