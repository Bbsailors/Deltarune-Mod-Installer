Apply("gml_Object_obj_bullet_featherfall_Step_0", @"event_inherited();
var factor = sqr(1 + (0.75 * abs(((swing / pi) % 1) - 0.5)));
v_speed += ((factor - v_speed) * scr_fps_lerp_rate(1/30));
basex += ((h_speed * factor) / global.fps_scale);
basey += (((v_speed * factor) + extrav) / global.fps_scale);
swing += ((0.10471975511965977 * rate * factor) / global.fps_scale);
show_debug_message(factor);
var angle = 270 + (arc * sin(swing));
var _x = basex + lengthdir_x(dist * 2, angle);
var _y = basey + lengthdir_y(dist, angle);
x = _x;
y = _y;
image_angle = lerp(angle, 270, 0.3);
if (basey > (obj_growtangle.y + 40))
{
	image_alpha -= (0.05 / global.fps_scale);
	if (image_alpha < 0)
	{
		instance_destroy();
	}
}
else
{
