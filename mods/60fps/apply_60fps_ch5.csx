			image_index = 1;
		}
	});
	c_wait_talk();
	c_wait(30);
	c_msgsetloc(0, ""\\E6* ..^1. what^1? She's not your Lovere^1? Nor your Darling!?/"", ""obj_dw_castle_church_climb_slash_Other_19_gml_141_0"");
	c_msgnextloc(""\\E1* Then why the DEUCE am I stealingeth her?/"", ""obj_dw_castle_church_climb_slash_Other_19_gml_142_0"");
	c_msgnextloc(""\\E0* Getteth out of here^1, Fairie^1! Getteth out!/%"", ""obj_dw_castle_church_climb_slash_Other_19_gml_143_0"");
	c_talk();
	c_wait_box(0);
