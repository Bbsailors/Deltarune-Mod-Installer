knight.shake_y = 0;
knight.sintimer = 0;
knight.carrymarker = -4;
knight.flashrate = 20;
knight.clash = false;

knight_step = function()
{
	if (hover)
	{
		sintimer += (0.13962634015954636 / global.fps_scale);
		if (sintimer > (2 * pi))
		{
			sintimer -= (2 * pi);
		}
		hovery = y + (sin(sintimer) * 6);
	}
	else
	{
		hovery = y;
	}
	if (shake || shakeB)
	{
		shake_x = irandom_range(-2, 2);
		shake_y = irandom_range(-2, 2);
	}
	else if (!clash)
	{
		shake_x = 0;
		shake_y = 0;
	}
	timer += (1 / global.fps_scale);
	if (clash)
	{
		if ((timer % 4) == 0)
		{
			shake_x = irandom_range(-1, 1);
			shake_y = irandom_range(-1, 1);
		}
	}
	if ((timer % aerate) == 0 && aeon)
	{
		yprev = y;
		y = hovery;
		var _ae = scr_afterimage();
		_ae.direction = 180;
		if (shake)
		{
			_ae.direction = point_direction(0, 0, shake_x, shake_y);
		}
		_ae.speed = aespeed / global.fps_scale;
		_ae.fadeSpeed = 0.04;
		y = yprev;
	}
	if (shake && (timer % flashrate) == 0)
	{
		flashrate = choose(25, 35, 45, 40);
		flash = 1;
	}
	if (carrymarker != -4)
	{
		carrymarker.x = x + 60;
		carrymarker.y = y;
	}
};

knight.step_func = method(knight.id, knight_step);

knight_draw = function()
{
	yprev = y;
	y = hovery;
	if (carryasgore)
	{
		draw_sprite_ext(spr_asgore_grabbed, image_index, x + 60, y, 2, 2, 0, c_white, 1);
	}
	draw_sprite_ext(sprite_index, image_index, x + shake_x, y + shake_y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
	if (flash > 0)
	{
		shader_replace_simple_set_hook(41);
		shader_set_uniform_f(shader_get_uniform(shd_forcecolour, ""forceColour""), 1, 1, 1);
		draw_sprite_ext(sprite_index, image_index, x + shake_x, y + shake_y, image_xscale, image_yscale, image_angle, image_blend, flash);
		shader_replace_simple_reset_hook();
		flash = scr_approach(flash, 0, 0.15 / global.fps_scale);
	}
	y = yprev;
};

knight.draw_func = method(knight.id, knight_draw);

flowery_endstep = function()
{
	if (running_wave)
	{
		sintimer += (0.13962634015954636 / global.fps_scale);
		if (sintimer > (2 * pi))
		{
			sintimer -= (2 * pi);
		}
		y = ystart + (sin(sintimer) * 6);
	}
	else
	{
		sintimer = 0;
	}
	if (afterimaging)
	{
		var _aispeed = -15;
		timer += (1 / global.fps_scale);
		if (frac(timer) == 0 && (timer % 3) != 0)
		{
			var _ia = image_alpha;
			image_alpha = afterimage_alpha;
			var _img = scr_afterimage_fog(undefined, rainbow[rainbow_pos++], 18);
			image_alpha = _ia;
			if (rainbow_pos > 6)
			{
				rainbow_pos = 0;
			}
			var _moved = abs(x - xprevious);
			var _spd = _moved + _aispeed;
			_img.x -= _moved;
			_img.hspeed = _aispeed / global.fps_scale;
			_img.depth = depth + 100;
			_img.image_alpha = afterimage_alpha;
			_img.flowery = true;
		}
	}
	with (obj_marker_fog)
	{
		if (variable_instance_exists(id, ""flowery""))
		{
			x += (other.x - other.xprevious);
		}
	}
};

flowery_draw = function()
{
	if (mask != -4)
	{
		gpu_set_blendenable(false);
		gpu_set_colorwriteenable(false, false, false, true);
		draw_set_alpha(0);
		d_rectangle(bbox_left - 10, bbox_top, bbox_right + 10, bbox_bottom, false);
		draw_set_alpha(1);
		d_rectangle(mask.bbox_left, mask.bbox_top, mask.bbox_right, mask.bbox_bottom, false);
		gpu_set_blendenable(true);
		gpu_set_colorwriteenable(true, true, true, true);
		gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
		gpu_set_alphatestenable(true);
		draw_self();
		gpu_set_alphatestenable(false);
		gpu_set_blendmode(bm_normal);
	}
	else
	{
		draw_self();
	}
};

floradin_draw = function()
{
	if (mask != -4)
	{
		gpu_set_blendenable(false);
		gpu_set_colorwriteenable(false, false, false, true);
		draw_set_alpha(0);
		d_rectangle(x, y, x + (sprite_width * 1.1), y + (sprite_height * 1.1), false);
		draw_set_alpha(1);
		d_rectangle(mask.bbox_left, mask.bbox_top, mask.bbox_right, mask.bbox_bottom, false);
		gpu_set_blendenable(true);
		gpu_set_colorwriteenable(true, true, true, true);
		gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
		gpu_set_alphatestenable(true);
		draw_self();
		gpu_set_alphatestenable(false);
		gpu_set_blendmode(bm_normal);
	}
	else
	{
		draw_self();
	}
};

asgore_draw = function()
{
	var _ccx = camera_get_view_x(view_camera[0]);
	var _ccy = camera_get_view_y(view_camera[0]);
	var _oy = y;
	if (orb_size > 0)
	{
		y += (scr_wave(-1, 1, 2, 0) * (orb_size / 20));
	}
	var _cx = centerx();
	var _cy = centery();
	var _size = max(0, orb_size + (scr_wave(-0.5, 0.5, 3, 0) * (orb_size / 20)));
	draw_set_color(c_black);
	if (!contain)
	{
		draw_self();
	}
	if (_size > 0)
	{
		draw_set_color(c_white);
		scr_draw_circle_lowres(_cx, _cy, _size + 2, 4);
		draw_set_color(c_black);
		scr_draw_circle_lowres(_cx, _cy, _size, 3);
		scr_draw_circle_lowres(_cx, _cy, _size, 0);
		gpu_set_blendenable(false);
		gpu_set_colorwriteenable(false, false, false, true);
		draw_set_alpha(0);
		d_rectangle(_ccx, _ccy, _ccx + 640, _ccy + 480, false);
		draw_set_alpha(0.95);
		scr_draw_circle_lowres(_cx, _cy, _size - 2, 0);
		gpu_set_blendenable(true);
		gpu_set_colorwriteenable(true, true, true, true);
		gpu_set_blendmode_ext(bm_dest_alpha, bm_inv_dest_alpha);
		gpu_set_alphatestenable(true);
		draw_set_alpha(1);
		draw_set_color(c_black);
	}
	if (_size > 0)
	{
		draw_sprite_tiled_ext(spr_texture_orb, 0, -get_timer() / 10000, 0, 2, 2, c_white, 0.25);
	}
	draw_self();
	gpu_set_alphatestenable(false);
	gpu_set_blendmode(bm_normal);
	y = _oy;
};

fog_draw = function()
{
	draw_self();
	gpu_set_fog(true, color, 0, 0);
	draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, fog_amt);
	gpu_set_fog(false, c_white, 0, 0);
};

clash_effect = function(arg0)
{
	scr_shakeobj(marker_clash, 16, 2);
	var _clash_vfx = scr_dark_marker(marker_clash.x, marker_clash.y, spr_fx_hitback_vertical);
	with (_clash_vfx)
	{
		scr_lerpvar(""image_index"", 0, 4, 12);
	}
	_clash_vfx.image_xscale = 2;
	_clash_vfx.image_yscale = 2;
	with (_clash_vfx)
	{
		var _grow = scr_afterimage_grow();
		_grow.hspeed = (arg0 * 2) / global.fps_scale;
	}
	scr_doom(_clash_vfx, 16);
	_clash_vfx = scr_dark_marker(marker_clash.x, marker_clash.y, spr_fx_hitback_vertical);
	with (_clash_vfx)
	{
		scr_lerpvar(""image_index"", 0, 4, 24);
	}
	_clash_vfx.image_xscale = 2;
	_clash_vfx.image_yscale = 2;
	_clash_vfx.image_alpha = 0.5;
	scr_doom(_clash_vfx, 24);
	scr_lerpvar_instance(_clash_vfx, ""image_alpha"", 0.5, 0, 24);
	snd_stop(snd_damage);
	snd_play(snd_damage);
	snd_stop(snd_closet_impact);
	snd_stop(snd_impact);
	snd_play_x(snd_closet_impact, 1, 0.9);
	snd_play_x(snd_impact, 1, 0.7);
	with (marker_clash)
	{
		var _afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 1;
		_afterimage.speed = 4 / global.fps_scale;
		_afterimage.image_alpha = 0.8;
		_afterimage.direction = random_range(-30, 30);
		_afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 1;
		_afterimage.speed = 2 / global.fps_scale;
		_afterimage.image_alpha = 0.8;
		_afterimage.direction = 2;
		_afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 1;
		_afterimage.speed = 1 / global.fps_scale;
		_afterimage.image_alpha = 0.8;
		_afterimage.direction = 1;
		_afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 0;
		_afterimage.speed = -4 / global.fps_scale;
		_afterimage.direction = random_range(-30, 30);
		_afterimage.image_alpha = 0.8;
		_afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 0;
		_afterimage.speed = -2 / global.fps_scale;
		_afterimage.direction = -2;
		_afterimage.image_alpha = 0.8;
		_afterimage = scr_afterimage();
		_afterimage.sprite_index = spr_flowery_conflict_split;
		_afterimage.image_index = 0;
		_afterimage.speed = -1 / global.fps_scale;
		_afterimage.direction = -1;
		_afterimage.image_alpha = 0.8;
	}
};

