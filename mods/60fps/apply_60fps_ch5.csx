	c_msgnextsubloc(""~1* Or I^1, I^1, I^1, I.../%"", (global.lang == ""ja"") ? ""\\m2\t\t\t"" : ""\\m2\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_209_0"");
	c_spritenext(1619, 0, 0.25);
