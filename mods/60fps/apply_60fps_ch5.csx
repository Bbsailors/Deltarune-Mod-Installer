Apply("gml_Object_obj_plat_bread_manager_Step_0", @"if (!init)
{
	init = 1;
	with (obj_smalldough)
	{
		visible = true;
		su_act.blocked = false;
	}
}
var inc = 1 / global.fps_scale;
if (global.pause_plat)
{
	act_lenient -= (1 / global.fps_scale);
	if (act_lenient > 0)
	{
		inc = 0;
		exit;
	}
	else
	{
		inc = 0.1 / global.fps_scale;
	}
}
if (con == 0)
{
	timer += (1 / global.fps_scale);
	if (count_up)
	{
		if (counts_down)
		{
			timeleft += inc;
		}
	}
	else if (counts_down)
	{
		timeleft -= inc;
	}
	var all_broken = true;
	var any_broken = timer >= 30;
	remaining_bread = 0;
	with (obj_smalldough)
	{
		if (visible)
		{
			all_broken = false;
			other.remaining_bread++;
		}
		else
		{
			any_broken = true;
		}
	}
	if (!all_broken && any_broken > 0)
	{
		counts_down = true;
		timer_state = 1;
		timer_cutscene_mode = false;
	}
	if (all_broken)
	{
		counts_down = false;
		showfinaltime = 90;
		with (obj_dw_garden_hopschef)
		{
			bread_sequence_end(true);
		}
		con = 1;
	}
	else if (count_up)
	{
	}
	else if (timeleft <= 0)
	{
		with (obj_dw_garden_hopschef)
		{
			bread_sequence_end(false);
		}
		con = 1;
	}
}
if (con == 1)
{
	won_challenge = true;
	with (obj_smalldough)
	{
		if (visible)
		{
			other.won_challenge = false;
		}
	}
}
");

Apply("gml_Object_obj_plat_bullet_Step_1", @"if (hitstop > 0 && !global.pause_plat)
{
	hitstop -= (1 / global.fps_scale);
}
if (despawn_in_ow_mode && !instance_exists(obj_plat_player))
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
var _paused = 0;
if (hitstop > 0)
{
	_paused = 1;
}
if (!custom_paused && _paused)
{
	on_pause();
	paused = 0;
	custom_paused = true;
}
if (custom_paused && !_paused)
{
	on_unpause();
	custom_paused = false;
}
if (!paused && !custom_paused)
{
	var step = 1 / global.fps_scale;
	if (turn_timer >= 900)
	{
		turn_timer += step;
		var tt = (turn_timer - 900) / turn_duration;
		direction = lerp(startdirection, startdirection + turn_amount, clamp01(tt));
		if (tt >= 1)
		{
			direction = startdirection + turn_amount;
			turn_timer = -1;
		}
	}
	else if (turn_timer >= 0)
	{
		turn_timer -= step;
		if (turn_timer <= 0)
		{
			startdirection = direction;
			turn_timer = 900;
		}
	}
	t += (1 / global.fps_scale);
	if (neutralized > 0)
	{
		neutralized -= (1 / global.fps_scale);
		if (neutralized == 0)
		{
			image_blend = c_white;
			image_alpha = 1;
			image_xscale = 2;
			image_yscale = 2;
		}
	}
	if (is_method(step_func))
	{
		step_func();
	}
	if (align_to_direction)
	{
		image_angle = direction + align_to_direction_offset;
	}
	if (t > lifetime && lifetime != -1)
	{
		scr_afterimagefast();
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_plat_bullet_emitter_Other_10", @"var _len = 0;
