Apply("gml_Object_obj_shadowman_tommygun_Step_0", @"if (i_ex(obj_growtangle))
{
	timer += (1 / global.fps_scale);
	if (timer < 14)
	{
		x = lerp(x, scr_get_box(0) + 122, scr_fps_lerp_rate(0.16));
	}
	if (timer == 14)
	{
		sprite_index = spr_shadowman_idle_fox;
		image_speed = 1 / global.fps_scale;
	}
}
if (global.turntimer < 13)
{
	if (global.turntimer < 1)
	{
		instance_destroy();
		exit;
	}
	x = lerp(x, creatorid.x, (12 - global.turntimer) / 12);
	y = lerp(y, creatorid.y, (12 - global.turntimer) / 12);
}
if (paused || timer < 14 || (global.turntimer < 29 && bullet_counter == 0))
{
	exit;
}
if (bullet_timer > 0)
{
	bullet_timer -= (1 / global.fps_scale);
}
else
{
	snd_stop(snd_gunshot_b);
	snd = audio_play_sound(snd_gunshot_b, 0, 0);
	snd_pitch(snd_gunshot_b, 0.95 + (random(10) / 100));
	snd_volume(snd_gunshot_b, 0.7, 0);
	sprite_index = spr_shadowman_firing;
	shootsfx = 6;
	firefx = round(2 * global.fps_scale);
	gunshake = 6;
	var rep = 1;
	if (type == 1)
	{
		rep = 5;
	}
	var bullet_speed = 4 + random(3);
	repeat (rep)
	{
		var ang = (point_direction(x + 6 + lengthdir_x(gunshake, gun_angle), y + 63 + lengthdir_y(gunshake, gun_angle), obj_growtangle.x, obj_growtangle.y) - 30) + irandom(60);
		if (type == 1)
		{
			ang = 120 + irandom(90);
		}
		count++;
		if (count == 5 && instance_number(obj_dbulletcontroller) != 3)
		{
			count = -10;
			ang = (point_direction(x + 6 + lengthdir_x(gunshake, gun_angle), y + 63 + lengthdir_y(gunshake, gun_angle), obj_heart.x + 10, obj_heart.y + 10) + 6) - irandom(12);
		}
		netskie_count++;
		if (netskie_count == 2 || netskie_count == 5 || netskie_count == 8 || netskie_count == 11 || netskie_count == 14 || netskie_count == 17 || netskie_count == 20)
		{
			ang = 158 + random(31);
		}
		gun_angle = ang;
		depth = -9999;
		var tommybullet = scr_fire_bullet(x + 6 + lengthdir_x(60, gun_angle), y + 64 + lengthdir_y(60, gun_angle), obj_tommygun_bullet, 180, bullet_speed, spr_tommygun_bullet);
		tommybullet.direction = ang;
		tommybullet.damage = 55;
		tommybullet.grazepoints = 9;
		tommybullet.target = target;
		tommybullet.image_angle = tommybullet.direction;
		tommybullet.depth = depth + 1;
		if (netskie_count == 2 || netskie_count == 5 || netskie_count == 8 || netskie_count == 11 || netskie_count == 14 || netskie_count == 17 || netskie_count == 20)
		{
			tommybullet.netskie = true;
			tommybullet.sprite_index = spr_tommygun_bullet_netskie;
		}
		else
		{
			with (tommybullet)
			{
				scr_script_delayed(scr_lerpvar_instance, abs(x - scr_get_box(2)) / abs(hspeed) / global.fps_scale, id, ""image_alpha"", 1, 0, 10);
			}
		}
		depth = -9999;
	}
	bullet_timer = 4;
	bullet_counter++;
	if (bullet_counter == 12)
	{
		sprite_index = spr_shadowman_reload;
		image_speed = 0.13333333333333333 / global.fps_scale;
		bullet_counter = 0;
		bullet_timer += (10 + (irandom(1) * 5) + (4 * sameattack));
		gun_angle = 180;
	}
}
");

Apply("gml_Object_obj_shadowplatformController_Step_0", @"if (!init)
{
	init = true;
	with (obj_shadowplatform_interactable)
	{
		other.number_of_platforms = array_length(platforms);
	}
	shape = [];
	with (obj_shadowplatform_interactable)
	{
		for (var i = 0; i < array_length(platforms); i++)
		{
			var data = findspriteinfo(platforms[i], other.lay);
			array_push(other.shape, data);
		}
	}
	var preshadow_layer = layer_get_id(""PLATFORMPRESHADOWS"");
	if (layer_exists(preshadow_layer))
	{
		var elements = layer_get_all_elements(preshadow_layer);
		for (var i = 0; i < array_length(elements); i++)
		{
			other.static_shapes[i] = 
			{
				x: layer_sprite_get_x(elements[i]),
				y: layer_sprite_get_y(elements[i]),
				image_xscale: layer_sprite_get_xscale(elements[i]),
				image_yscale: layer_sprite_get_yscale(elements[i]),
				sprite_index: layer_sprite_get_sprite(elements[i])
			};
		}
	}
	loadBitmask();
	for (var i = 0; i < array_length(shape); i++)
	{
		if ((global.flag[x_flag] + global.flag[y_flag]) == 0)
		{
			shape[i].x = round((shape[i].x - loc.x) / 40);
			shape[i].y = round((shape[i].y - loc.y) / 40);
		}
		else
		{
			var locz = loadBitmask();
			for (var ii = 0; ii < array_length(shape); ii++)
			{
				shape[ii].x = locz.xbit[ii] - hbuff;
				shape[ii].y = locz.ybit[ii] - vbuff;
			}
		}
		shape[i].xprevious = shape[i].x;
		shape[i].yprevious = shape[i].y;
	}
}
siner++;
alpha_siner++;
if (resetcon == 1)
{
	resettimer += (1 / global.fps_scale);
	if (resettimer == 1)
	{
		snd_play(snd_bell);
	}
	if (resettimer >= 4)
	{
		with (obj_plat_fusumawall)
		{
			if (destroyed && recoverable)
			{
				destroyed = false;
				con = 0;
				mask_index = -4;
				if (has_collision)
				{
					block = instance_create(x, y + sprite_height, obj_solidblocksized);
					block.image_xscale = 0.5 * image_xscale;
					block.image_yscale = 0.05;
				}
			}
		}
		var shapez = [];
		with (obj_shadowplatform_interactable)
		{
			for (var i = 0; i < array_length(platforms); i++)
			{
				array_push(shapez, findspriteinfo(platforms[i], other.lay));
			}
		}
		number_of_platforms = array_length(shapez);
		for (var i = 0; i < array_length(shapez); i++)
		{
			shape[i].xprevious = shape[i].x;
			shape[i].yprevious = shape[i].y;
			shape[i].newx = round((shapez[i].x - loc.x) / 40);
			shape[i].newy = round((shapez[i].y - loc.y) / 40);
			shape[i].sprite_index = shapez[i].sprite_index;
		}
		if (!camreset)
		{
			camfocus = true;
		}
		resettimer = 0;
		resetcon = 2;
	}
}
if (resetcon == 2)
{
	resettimer += (1 / global.fps_scale);
	var lerper = ease_inout_quad(resettimer / 15, 0, 1, 1);
	for (var i = 0; i < number_of_platforms; i++)
	{
		shape[i].x = lerp(shape[i].xprevious, shape[i].newx, lerper);
		shape[i].y = lerp(shape[i].yprevious, shape[i].newy, lerper);
	}
	if (resettimer >= 15)
	{
		resettimer = 0;
		resetcon = 0;
	}
}
with (bell)
{
	if (myinteract == 3)
	{
		with (marker)
		{
			scr_lerpvar(""image_index"", 0, 6, 14, 1, ""out"");
		}
		global.interact = 1;
		myinteract = 0;
		other.resetcon = 1;
	}
}
");

Apply("gml_Object_obj_shadowplatformController_Step_2", @"if (instance_exists(obj_dw_fcastle_fusumadodge))
{
	exit;
}
var ys = array_get(scr_platswap_yscale(), 0);
if (ys == 1)
{
	if (refresh_blocks)
	{
		var li = ds_list_create();
		refresh_blocks = false;
		with (obj_plat_floor)
		{
			if (extflag == ""shadowplatform"" || extflag == ""shadowplatform_malleable"")
			{
				instance_destroy();
			}
		}
		for (var i = 0; i < array_length(static_shapes); i++)
		{
			var sh = static_shapes[i];
			var xscale = sh.image_xscale;
			var yscale = sh.image_yscale;
			var xx = sh.x;
			var yy = sh.y + lerp(0, 4, ys);
			generate_collider(li, xx, yy, xscale, yscale);
		}
		for (var i = 0; i < number_of_platforms; i++)
		{
			var sh = shape[i];
			var xscale = 2;
			var yscale = 4;
			if (shape[i].sprite_index == spr_dw_shadowplatform_2)
			{
				xscale = 4;
				yscale = 2;
			}
			if (shape[i].sprite_index == spr_dw_shadowplatform_3)
			{
				xscale = 6;
				yscale = 6;
			}
			if (shape[i].sprite_index == spr_dw_shadowplatform_4)
			{
				xscale = 4;
				yscale = 4;
			}
			var xx = (loc.x + (sh.x * 40)) - (20 * xscale);
			var yy = ((loc.y + (sh.y * 40)) - (20 * yscale)) + lerp(0, 4, ys);
			generate_collider(li, xx, yy, xscale, yscale);
		}
		ds_list_destroy(li);
	}
}
else
{
	refresh_blocks = true;
}
if (!instance_exists(obj_mainchara))
{
	abandon_focus = true;
}
else if (abandon_focus)
{
	obj_mainchara.cutscene = false;
	camreset = false;
	camfocus = false;
	abandon_focus = false;
}
if ((camreset || camfocus) && instance_exists(obj_mainchara))
{
	obj_mainchara.cutscene = true;
	var cx = camerax();
	var cy = cameray();
	var targ = scr_darkcameraideal();
	if (camfocus)
	{
		targ = gcam;
	}
	gcam.y = clamp((loc.y + (shape[targeted].y * 40)) - 240, gcam.toplimit, gcam.botlimit);
	var ease = 
	{
		x: lerp(cx, targ.x, scr_fps_lerp_rate(scr_ease_in(0.7, 3))),
		y: lerp(cy, targ.y, scr_fps_lerp_rate(scr_ease_in(0.7, 3)))
	};
	if (abs(cx - ease.x) < 0.1)
	{
		ease.x = cx;
	}
	if (abs(cy - ease.y) < 0.1)
	{
		ease.y = cy;
	}
	camera_setxy(ease.x, ease.y);
	if (ease.x == cx && ease.y == cy)
	{
		if (camreset == true)
		{
			camreset = false;
			obj_mainchara.cutscene = false;
		}
		if (camfocus == true)
		{
			camfocus = false;
			obj_mainchara.cutscene = true;
		}
	}
}
depth = lerp(1000000, 14000000, array_get(scr_platswap_yscale(), 0));
");

