Apply("gml_Object_obj_omega_pan_manager_Create_0", @"image_speed = 0;
image_xscale = 2;
image_yscale = 2;
obj_growtangle.sprite_index = spr_battlebg_round;
obj_growtangle.mask_index = spr_battlebg_round;
timer = -8;
angle_1 = 0;
angle_2 = -120;
angle_3 = 120;
angle_change = 0.5 / global.fps_scale;
pan_distance = 140;
pan_distance_offset = 0;
pan_offset = 0;
px_1 = x + lengthdir_x(pan_distance, angle_1) + lengthdir_x(pan_offset, angle_1 - 90);
py_1 = y + lengthdir_y(pan_distance, angle_1) + lengthdir_y(pan_offset, angle_1 - 90);
px_2 = x + lengthdir_x(pan_distance, angle_2) + lengthdir_x(pan_offset, angle_2 - 90);
py_2 = y + lengthdir_y(pan_distance, angle_2) + lengthdir_y(pan_offset, angle_2 - 90);
px_3 = x + lengthdir_x(pan_distance, angle_3) + lengthdir_x(pan_offset, angle_3 - 90);
py_3 = y + lengthdir_y(pan_distance, angle_3) + lengthdir_y(pan_offset, angle_3 - 90);
pan_1 = instance_create(px_1, py_1, obj_omega_pan);
pan_2 = instance_create(px_2, py_2, obj_omega_pan);
pan_3 = instance_create(px_3, py_3, obj_omega_pan);
pan_list = ds_list_create();
ds_list_add(pan_list, pan_1, pan_2, pan_3);
ds_list_shuffle(pan_list);

update_pans = function()
{
	pan_1.x = x + lengthdir_x(pan_distance, angle_1) + lengthdir_x(pan_offset, angle_1 - 90);
	pan_1.y = y + lengthdir_y(pan_distance, angle_1) + lengthdir_y(pan_offset, angle_1 - 90);
	pan_1.image_angle = point_direction(x + lengthdir_x(pan_distance, angle_1), y + lengthdir_y(pan_distance, angle_1), x, y) - 90;
	pan_2.x = x + lengthdir_x(pan_distance, angle_2) + lengthdir_x(pan_offset, angle_2 - 90);
	pan_2.y = y + lengthdir_y(pan_distance, angle_2) + lengthdir_y(pan_offset, angle_2 - 90);
	pan_2.image_angle = point_direction(x + lengthdir_x(pan_distance, angle_2), y + lengthdir_y(pan_distance, angle_2), x, y) - 90;
	pan_3.x = x + lengthdir_x(pan_distance, angle_3) + lengthdir_x(pan_offset, angle_3 - 90);
	pan_3.y = y + lengthdir_y(pan_distance, angle_3) + lengthdir_y(pan_offset, angle_3 - 90);
	pan_3.image_angle = point_direction(x + lengthdir_x(pan_distance, angle_3), y + lengthdir_y(pan_distance, angle_3), x, y) - 90;
};

update_pans();
");

Apply("gml_Object_obj_omega_pan_manager_Step_0", @"angle_1 += angle_change;
angle_2 += angle_change;
angle_3 += angle_change;
pan_distance_offset = 6 * cos((global.time * 0.25) / global.fps_scale);
pan_distance = 120 + pan_distance_offset;
pan_offset = -32 - (32 * sin((global.time * 0.125) / global.fps_scale));
update_pans();
timer += (1 / global.fps_scale);
if (timer == 25)
{
	with (ds_list_find_value(pan_list, 0))
	{
		fogdraw = 1;
	}
}
if (timer == 35)
{
	var cur_pan = ds_list_find_value(pan_list, 0);
	with (cur_pan)
	{
		image_index = 1;
		var px = x + lengthdir_x(60, image_angle + 160);
		var py = y + lengthdir_y(60, image_angle + 160);
		for (a = 0; a < 3; a++)
		{
			with (scr_fire_bullet(px + lengthdir_x(-24 + (24 * a), image_angle + 160), py + lengthdir_y(-24 + (24 * a), image_angle + 160), obj_omega_pan_fire, image_angle + 90, 9, spr_bullet_green_flame))
			{
				mask_index = spr_bullet_green_flame_mask;
				image_angle = direction + 90;
				movedir = direction;
				gravity_direction = direction;
				gravity = -0.3 / (global.fps_scale * global.fps_scale);
				if (other.a == 1)
				{
					speed += (2 / global.fps_scale);
				}
				image_xscale = 2;
				image_yscale = 1;
				scr_lerpvar(""image_xscale"", 2.5, 1.5, 8);
				scr_lerpvar(""image_yscale"", 0.75, 1.5, 8);
				depth = other.depth + 1;
				sidemove = (-3 + (3 * other.a) + random_range(-0.5, 0.5)) / global.fps_scale;
			}
		}
		scr_script_delayed(scr_var, 8, ""image_index"", 0);
	}
	ds_list_add(pan_list, ds_list_find_value(pan_list, 0));
	ds_list_delete(pan_list, 0);
	timer = 0;
}
");

