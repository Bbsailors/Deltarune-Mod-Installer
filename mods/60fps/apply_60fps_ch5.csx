Apply("gml_Object_obj_dw_garden_hopschef_Create_0", @"con = 0;
timer = 0;
init = 0;
siner = 0;
turnofflayers(""CUT"");
turnofflayers(""DEBUG"");
turnofflayers(""NPCs"");
HOPSCHEF_PROGRESS_FLAG = 1399;
SCORE_FLAG = 1858;
HI_SCORE_BIT = 0;
BREAD_BIT = 0;
TEXT_BIT = 1;
exit_barrier = -4;
scr_flag_set_ext(1878, 0, 1);
_PROGRESS_INTRO_SEEN = 1;
_PROGRESS_BREAD_IS_CAKE = 2;
hopschefinteract = scr_makenpc_fromasset(findsprite(spr_dw_hopschef_idle, ""NPCs""));
hopschefinteract.markerstick = false;
with (hopschefinteract)
{
	scr_plat_make_pauseable();
}
hopschef = hopschefinteract.marker;
hopschef.sad = false;
table = scr_marker_fromasset(findsprite(spr_dw_garden_hopschef_table, ""NPCs""), undefined, 1);
table.image_speed = 0;
table.shadow = scr_marker_frominstance(table);
table.shadow.image_index = 1;
table.shadow.depth = layer_get_depth(""TILES_GRASS"") - 1000;
bread = scr_makenpc_fromasset(findsprite(spr_dw_garden_hopschef_bread));
bread.marker.depth = table.depth - 1;
bread.marker.image_speed = 0;
bread.smashed = false;
bread.enhanced = false;
bread.cake = false;
bread.siner = 0;
bread.marker.flowermarker = -4;

bread.can_water = function()
{
	return bread.marker.flowermarker == -4;
};

bread.draw_watering_reticle = function()
{
	with (obj_dw_garden_hopschef.bread.marker)
	{
		if (!obj_dw_garden_hopschef.bread.cake)
		{
			scr_draw_outline(2, 16776960, 1);
		}
	}
};

platforming_table = instance_create(table.x, table.y, obj_sourdough_table);
platforming_bread = instance_create(bread.x, bread.y - 60, obj_sourdough);
with (platforming_table)
{
	scr_darksize();
	scr_platswap_init(self, true);
}
with (platforming_bread)
{
	scr_darksize();
}
hopgamecon = 0;
hopgametimer = 0;
hopgame_counter = 0;
hopgame_jumpwindow = 0;
hopgame_jumpedwell = 0;
hopgame_loops = 0;
hopschef_animates = 1;
act_hopping = -4;
with (hopschef)
{
	scr_platswap_init(self, true);
	mode = 1;
}
cutscenecon = 0;
platformmode = false;
shocked_timer = 0;
funcInit = 0;
flora_left = -4;
flora_right = -4;
jump_rope = -4;
time_since_jump = 0;
rope_step = false;
won_challenge = false;
bounceflower = -4;
bounceflower_leaves = -4;

make_bounceflower = function(arg0)
{
	var gm = scr_genmarker(""bounceflower"");
	bounceflower = instance_create(gm.x, gm.y, obj_slashpusher);
	var bounceflower_should_disable = scr_flag_get_ext(HOPSCHEF_PROGRESS_FLAG, BREAD_BIT, 2) != _PROGRESS_BREAD_IS_CAKE;
	with (bounceflower)
	{
		scr_plat_depthcast();
		index = 99;
		angle = 90;
		strength = 10.5;
		orb_x = x;
		orb_y = y;
		stem_ease_x = ease_in_quad;
		stem_ease_y = ease_out_quad;
		scr_delay_var(""force_yplat"", true, 4);
		scr_delay_var(""y_plat"", ystart, 4);
		disabled = bounceflower_should_disable;
		disabled_lerp = disabled;
	}
	gm = scr_genmarker(""bounceflower_leaves"");
	bounceflower_leaves = instance_create(gm.x, gm.y - 10, obj_slashpusher_anchor);
	with (bounceflower_leaves)
	{
		scr_darksize();
		index = 99;
		scr_plat_depthcast();
	}
	if (arg0)
	{
		scr_plat_depthcast();
		var xx = bounceflower.x;
		var yy = bounceflower.y;
		bounceflower.x -= 240;
		bounceflower.y += 160;
		scr_lerpvar_instance(bounceflower, ""x"", bounceflower.x, xx, 30, -1, ""out"");
		scr_lerpvar_instance(bounceflower, ""y"", bounceflower.y, yy, 15, -1, ""out"");
	}
};

hopschef_throw_money = function(arg0)
{
	if (arg0[0] > 0)
	{
		scr_plat_makecoins(hopschef.x + 60, hopschef.y + 20, -arg0[0], 60, 25, 12, 4);
	}
	if (arg0[1] > 0)
	{
		scr_plat_makecoins(hopschef.x + 60, hopschef.y + 20, arg0[1], 60, 25, 12, 4);
	}
};

last_bread_time = 0;

bread_sequence_end = function()
{
	global.interact = 1;
	with (obj_plat_bread_manager)
	{
		other.last_bread_time = timeleft;
	}
	var best_time = global.flag[SCORE_FLAG];
	if (last_bread_time < best_time || best_time == 0)
	{
		var flag = scr_flag_get_ext(HOPSCHEF_PROGRESS_FLAG, BREAD_BIT, 2);
		if (flag < _PROGRESS_BREAD_IS_CAKE)
		{
			last_bread_time = 600 - last_bread_time;
		}
		global.flag[SCORE_FLAG] = last_bread_time;
	}
	snd_free(global.currentsong[0]);
	snd_play(snd_lancerwhistle);
	cutscenecon = 5.5;
};

bread_watered = false;
bread.watered = false;

water_bread = function()
{
	bread_watered = true;
	with (bread)
	{
		if (cake)
		{
			watered += (1 / global.fps_scale);
			if ((watered % 4) == 1)
			{
				var side = -1;
				with (obj_mainchara)
				{
					if (x > other.x)
					{
						side = 1;
					}
				}
				snd_play(snd_metal_hit_strong, 0.6, 2);
				var xx = mean(bbox_left, bbox_right) + (random_range(40, 60) * side);
				var yy = y + random_range(60, 100);
				var dmg = instance_create(xx, yy, obj_dmgwriter);
				dmg.damage = 0;
				dmg.showzeroes = 1;
				dmg.noextend = 1;
				scr_make_ripple(xx, yy, 4, 16777215, 30, 30, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
			}
		}
		else if (!watered)
		{
			watered = true;
			with (marker)
			{
				flowermarker = instance_create(mean(bbox_left, bbox_right) - 20, y - 12, obj_marker);
				with (flowermarker)
				{
					sprite_index = spr_ralsei_flower_only;
					scr_darksize();
					depth = other.depth - 1;
					image_speed = 0;
					scr_lerpvar(""image_index"", 0, 6, 12);
					snd_play(snd_harp_strum, 1, 1.1);
				}
			}
		}
	}
};
");

Apply("gml_Object_obj_dw_garden_hopschef_Other_19", @"if (funcInit == true)
{
	exit;
}
var daddy = id;
with (hopschef)
{
	amjumping = false;
	
	dojump = function(arg0 = -12, arg1 = 1)
	{
		if (!amjumping)
		{
			amjumping = true;
			image_index = 0;
			vspeed = arg0 / global.fps_scale;
			gravity = arg1 / (global.fps_scale * global.fps_scale);
			var jumptime = scr_returnwait_gravity(id, y, y, arg1, arg0);
			scr_delay_var(""x"", x, jumptime - 1);
			scr_delay_var(""y"", y, jumptime - 1);
			scr_lerpvar(""image_index"", 0, sprite_get_number(sprite_index) - 1, jumptime);
			scr_delay_var(""gravity"", 0, jumptime - 1);
			scr_delay_var(""vspeed"", 0, jumptime - 1);
			scr_delay_var(""amjumping"", 0, jumptime);
		}
	};
}
funcInit = true;
");

Apply("gml_Object_obj_dw_garden_hopschef_Step_0", @"var daddy = id;
scr_populatechars();
platformmode = instance_exists(obj_plat_player);
platforming_bread.visible = platformmode == 1;
bread.marker.visible = platformmode == 0;
bread.depth = bread.marker.depth;
platforming_table.visible = platformmode == 1;
table.visible = platformmode == 0;
table.shadow.visible = platformmode == 0;
with (obj_platswap_statue)
{
	can_hit = instance_number(obj_plat_bread_manager) == 0;
}
var bounceflower_should_disable = scr_flag_get_ext(HOPSCHEF_PROGRESS_FLAG, BREAD_BIT, 2) != _PROGRESS_BREAD_IS_CAKE;
if (!funcInit)
{
	with (obj_shortcut_door)
	{
		scr_platswap_init(self, true);
	}
	event_user(9);
	var flag = scr_flag_get_ext(HOPSCHEF_PROGRESS_FLAG, BREAD_BIT, 2);
	if (flag == _PROGRESS_INTRO_SEEN)
	{
		cutscenecon = 3;
	}
	if (flag == _PROGRESS_BREAD_IS_CAKE)
	{
		bread.cake = true;
		cutscenecon = 3;
		platforming_bread.image_index = 2;
	}
	with (obj_waterable_trigger)
	{
		if (extflag == ""water_bread"")
		{
			on_water = other.water_bread;
		}
	}
	with (obj_plat_block)
	{
		if (extflag == ""blocker"")
		{
			other.exit_barrier = id;
		}
	}
}
else if (funcInit == 1)
{
	funcInit = 2;
	if (scr_trigcheck(""move_hopschef"") && !instance_exists(obj_plat_player))
	{
		hopschefinteract.x += 580;
		hopschef.x += 580;
	}
}
with (hopschef)
{
	var oldmode = mode;
	if (i_ex(obj_platswap))
	{
		mode = obj_platswap.mode;
	}
	if (mode == 1)
	{
		if (oldmode != 1)
		{
			scr_plat_depthcast();
		}
	}
	else
	{
		scr_depth();
	}
}
if (act_hopping != -4)
{
	act_hopping.blocked = platforming_bread.image_index > 0 || bread.enhanced;
}
if (instance_exists(obj_plat_player) && cutscenecon == 3 && bounceflower == -4)
{
	make_bounceflower(true);
}
var manager = id;
with (hopschefinteract)
{
	with (marker)
	{
		if (sprite_index != spr_dw_hopschef_mustache)
		{
			image_speed = 0;
			if (daddy.hopschef_animates && !global.pause_plat)
			{
				image_index += (daddy.hopschef_animates / 2 / global.fps_scale);
			}
		}
		else
		{
			image_speed = 0.25 / global.fps_scale;
		}
		if (sad)
		{
			sprite_index = spr_dw_hopschef_crying;
		}
		if (daddy.shocked_timer > 0)
		{
			daddy.shocked_timer -= 1 / global.fps_scale;
			sprite_index = spr_dw_hopschef_surprise;
			if (daddy.shocked_timer == 0)
			{
				sprite_index = spr_dw_hopschef_idle;
				if (sad)
				{
					sprite_index = spr_dw_hopschef_crying;
				}
			}
		}
	}
	if (myinteract == 3)
	{
		global.interact = 1;
		if (other.bread_watered)
		{
			if (other.bread_watered == 1)
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* Oh no^1! FLAUER grows from the moist FLOUER^1! The DOUGH is GROWING!/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_173_0"");
				msgnextloc(""* Oh!^1! (My giant BROT begins to BRECHEN the METROPOLIS!)\nYou guys!!/%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_174_0"");
			}
		}
		else
		{
			var flag = scr_flag_get_ext(manager.HOPSCHEF_PROGRESS_FLAG, manager.BREAD_BIT, 2);
			if (flag == 0)
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* Ja^1! I am HOPSCHEF!/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_181_0"");
				msgnextloc(""* I am doing FROIDERJUMPEN from my HAPPINESS!/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_182_0"");
				msgnextloc(""* Look^1! I have made DELECKERTIBLE SAUERDOUGH./"", ""obj_dw_garden_hopschef_slash_Step_0_gml_183_0"");
				msgnextloc(""* And no one has ever destroyed it^1. YIPPEE!/%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_184_0"");
				if (talked)
				{
					scr_speaker(""no_name"");
					msgsetloc(0, ""* Oh^1, FROIDERJUMPEN!/%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_189_0"");
				}
			}
			else if (flag == 2)
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* Does my \""TREE CAKE\"" bring FROIDER to your young buds?/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_197_0"");
				msgnextloc(""* Ha ha^1! If not^1, why not challenge my CIRCULAR DOUGH?/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_198_0"");
				msgnextloc(""* Try it using the JUMPENTHINGER./%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_199_0"");
				if (talked)
				{
					scr_speaker(""no_name"");
					msgsetloc(0, ""* This KUCHEN from my KITCHEN^1, I am BAUMED to it by fate./"", ""obj_dw_garden_hopschef_slash_Step_0_gml_205_0"");
					msgnextloc(""* May this TREE be your TREAT^1! Feel free^1, FREUND^1, LICHKE IT!/%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_206_0"");
				}
			}
			else
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* Next time you BRECHEN my BROT.../"", ""obj_dw_garden_hopschef_slash_Step_0_gml_212_0"");
				msgnextloc(""* If you don't BREAKENSMASHEN all CIRCULAR DOUGH in 20 seconds.../"", ""obj_dw_garden_hopschef_slash_Step_0_gml_213_0"");
				msgnextloc(""* My BROT will be BROT back to life!/%"", ""obj_dw_garden_hopschef_slash_Step_0_gml_214_0"");
			}
		}
		d_make();
		talked++;
		myinteract = 4;
	}
