			k_d(3);
			scr_speaker(""no_name"");
			msgsetloc(0, ""* I have overcome my GLUTEN INTOLERANCE./"", ""obj_npc_hammerguy_slash_Step_0_gml_43_0"");
			msgnextloc(""* ..^1. I will tell you MY SECRET./"", ""obj_npc_hammerguy_slash_Step_0_gml_44_0"");
			msgnextloc(""* The secret was NOT BEING INSIDE OF A BAKERY FOR 24 HOURS./"", ""obj_npc_hammerguy_slash_Step_0_gml_45_0"");
			msgnextloc(""* Now I can DO THE THING I WAS SUPPOSED TO BE DOING./%"", ""obj_npc_hammerguy_slash_Step_0_gml_46_0"");
			mydialoguer = d_make();
		}
		else
		{
			k_d();
		}
	}
	if (talk_con == 3 && !d_ex())
	{
		if (!i_ex(obj_fusionmenu))
		{
			talk_con = 2;
		}
	}
	if (talk_con == 2 && !d_ex())
	{
		talk_con = -1;
		con = 0;
	}
}
