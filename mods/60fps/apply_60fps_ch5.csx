");

Apply("gml_Object_obj_heart_slime_Step_0", @"if (global.turntimer <= 0)
{
	if (surface_exists(surf))
	{
		surface_free(surf);
	}
	if (surface_exists(persistent_surf))
	{
		surface_free(persistent_surf);
	}
	with (obj_heart_slime_drop)
	{
		instance_destroy();
	}
	instance_destroy();
	exit;
}
depth = obj_growtangle.depth - 1;
x = (obj_growtangle.x - 70) + 1;
y = (obj_growtangle.y - 70) + 1;
if (heartx != obj_heart.x || hearty != obj_heart.y)
{
	heart_hspeed = scr_movetowards(heart_hspeed, obj_heart.x - heartx, 1 / (global.fps_scale * global.fps_scale));
	heart_vspeed = scr_movetowards(heart_vspeed, obj_heart.y - hearty, 1 / (global.fps_scale * global.fps_scale));
	heartx = obj_heart.x;
	hearty = obj_heart.y;
	timer--;
}
else
{
	heart_hspeed = 0;
	heart_vspeed = 0;
}
if (obj_heart.dmgnoise)
{
	hitspeed = 8;
	scr_debug_print(""heart hit"");
	var _count = irandom_range(4, 7);
	var _st = random(360);
	var _a = 360 / _count;
	var _devi = _a * (1/3);
	var _slime = splatter ? 566 : 1090;
	if (splatter)
	{
		var _drop = instance_create(obj_heart.x + 10, obj_heart.y + 10, _slime);
		_drop.maxsize = irandom_range(6, 8);
		_drop.size = _drop.maxsize / 2;
	}
	for (var i = 0; i < _count; i++)
	{
		var _drop = instance_create(obj_heart.x + 10, obj_heart.y + 10, _slime);
		var _speed = splatter ? random_range(6, 10) : random_range(4, 8);
		_drop.direction = (i * _a) + random_range(-20, 20) + _st;
		_drop.delay = 1;
		_drop.speed = _speed / global.fps_scale;
		_drop.maxsize = irandom_range(6, 8);
		_drop.size = _drop.maxsize / 2;
		if (!splatter)
		{
			_drop.gravity = 0.5 / (global.fps_scale * global.fps_scale);
		}
		_drop = instance_create(obj_heart.x + 10, obj_heart.y + 10, _slime);
		_drop.direction = (i * _a) + random_range(-20, 20) + _st;
		_drop.delay = 2;
		_drop.speed = _speed / global.fps_scale;
		_drop.maxsize = irandom_range(4, 6);
		_drop.size = _drop.maxsize / 2;
		if (!splatter)
		{
			_drop.gravity = 0.5 / (global.fps_scale * global.fps_scale);
		}
		if (splatter)
		{
			_drop = instance_create(obj_heart.x + 10, obj_heart.y + 10, _slime);
			_drop.direction = (i * _a) + random_range(-20, 20) + _st;
			_drop.delay = 3;
			_drop.speed = _speed / global.fps_scale;
			_drop.maxsize = irandom_range(2, 3);
			_drop.size = _drop.maxsize / 2;
		}
	}
}
");

Apply("gml_Object_obj_heart_slime_drop_Step_0", @"if (!init)
{
	lastx[0] = x;
	lasty[0] = y;
	lastx[1] = x;
	lastx[1] = y;
}
if (floorhit)
{
	height = scr_movetowards(height, 0.5, 0.1 / global.fps_scale);
	width = scr_movetowards(width, 2, 0.1 / global.fps_scale);
	gravity = 0.1 / (global.fps_scale * global.fps_scale);
	if ((y - height) > (obj_growtangle.y + 80))
	{
		instance_destroy();
	}
	exit;
}
else
{
	lastx[1] = lastx[0];
	lasty[1] = lasty[0];
	lastx[0] = x;
	lasty[0] = y;
}
if (y > (obj_growtangle.y + 70))
{
	y = obj_growtangle.y + 70;
	if (wallhit)
	{
		if (x < obj_growtangle.x)
		{
			hspeed = vspeed;
		}
		else
		{
			hspeed = -vspeed;
		}
	}
	vspeed = 0;
	gravity = 0.1 / (global.fps_scale * global.fps_scale);
	hspeed /= 2;
	friction = 0.2 / (global.fps_scale * global.fps_scale);
	image_angle = 0;
	width = x;
	floorhit = true;
}
if (y < (obj_growtangle.y - 71) && vspeed < 0)
{
	vspeed = 0;
	friction = 0.2 / (global.fps_scale * global.fps_scale);
	gravity = 0.1 / (global.fps_scale * global.fps_scale);
	y = obj_growtangle.y - 71;
}
if (!wallhit && gravity < (0.5 / (global.fps_scale * global.fps_scale)) && vspeed > 0 && y > ((obj_growtangle.y - 70) + (height / 2)))
{
	gravity = 0.5 / (global.fps_scale * global.fps_scale);
	friction = 0;
}
if (!floorhit && (x < (obj_growtangle.x - 70) || x > (obj_growtangle.x + 70)))
{
	hspeed = 0;
	vspeed /= 2;
	if (x < obj_growtangle.x)
	{
		x = obj_growtangle.x - 70;
	}
	else
	{
		x = obj_growtangle.x + 70;
	}
	gravity = 0.5 / (global.fps_scale * global.fps_scale);
	friction = 0.3 / (global.fps_scale * global.fps_scale);
	wallhit = true;
}
");

