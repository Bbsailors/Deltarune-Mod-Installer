		}
		with (obj_plat_cam_nudgezone)
		{
			scr_lerpvar(""nudgey"", nudgey, 0, 140, 1, ""out"");
			scr_doom(self, 140);
		}
	});
	c_var_instance(hat, ""visible"", true);
	c_var_instance(hat, ""x"", rapos[0].x);
	c_var_instance(hat, ""y"", rapos[0].y);
	c_var_instance(hat, ""gravity"", -0.1 / (global.fps_scale * global.fps_scale));
	c_var_instance(hat, ""hspeed"", -3 / global.fps_scale);
	c_var_instance(hat, ""friction"", -0.02 / (global.fps_scale * global.fps_scale));
	c_lerp_var_instance(featherglow, ""image_alpha"", 1, 0, 30);
	c_lerp_var_instance(feathermarker, ""image_alpha"", 1, 0, 30);
	c_wait(100);
	c_var_lerp_instance(id, ""petalwinds"", 1, 0, 20);
	c_lerp_var_instance(819, ""anim_speed"", 0.8, 0.2, 20);
	c_customfunc(function()
	{
