makecoin = function(arg0)
{
	with (scr_marker_fancy(240, 290, 4711))
	{
		gravity = random_range(1, 1.1) / (global.fps_scale * global.fps_scale);
		scr_size(2, 2);
		spd = random_range(15, 25) / global.fps_scale;
		hspeed = lengthdir_x(spd, arg0);
		vspeed = lengthdir_y(spd, arg0);
		endy = scr_even(ystart + random_range(6, 20));
		depth = 100000 - ((endy * 10) + (sprite_height * 10));
		bouncecount = 0;
		dying = 0;
		timer = 0;
		
		end_step_func = function()
		{
			if (dying)
			{
				timer += (1 / global.fps_scale);
				if (timer > 50)
				{
					image_alpha = lerp_out_cubic(1, 0, (timer - 50) / 10);
				}
				if (timer == 60)
				{
					instance_destroy();
				}
			}
			if (y > endy && vspeed > 0)
			{
				hspeed *= 0.7;
				y = endy;
				vspeed = -vspeed * 0.4;
				var vol = lerp(0, 0.3, (abs(vspeed) * global.fps_scale) / 8);
				if (vol > 0.1)
				{
					snd_play(snd_coin, vol, 1.2);
				}
				if (dying == 0)
				{
					dying = 1;
					scr_doom(id, 80);
				}
			}
			var _left = 128;
			var _right = 352;
			if (x < _left || x > _right)
			{
				x = clamp(x, _left, _right);
				hspeed = -hspeed * 0.5;
				var vol = lerp(0, 0.3, (abs(hspeed) * global.fps_scale) / 8);
				if (vol > 0.1)
				{
					snd_play(snd_coin, vol, 1.2);
				}
			}
			image_angle -= (hspeed * 30);
		};
	}
};

if (coincon == 1)
{
	var fe = ferroll.marker;
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		with (fe)
		{
			sprite_index = spr_npc_ferroll_idle;
			image_index = 0;
			image_speed = (1/15) / global.fps_scale;
		}
	}
	if (timer == 15)
	{
		sprite_set(fe, 3241, 0, 0.35 / global.fps_scale);
	}
	if (timer == 40)
	{
		sprite_set(fe, 6030, 0, 0);
	}
	if (timer == 42)
	{
		sprite_set(fe, 6030, 1, 0);
	}
	if (timer == 44)
	{
		sprite_set(fe, 6030, 2, 0);
		snd_play(snd_horriblemetalclang);
		var range = 30;
		var count = 25;
		for (var i = 0; i < count; i++)
		{
			makecoin(lerp(90 + range, 90 - range, i / count) + random_range(-4, 4));
		}
		scr_shakescreen();
	}
	if (timer == 46)
	{
		sprite_set(fe, 6030, 3, 0);
	}
	if (timer == 48)
	{
		sprite_set(fe, 6030, 4, 0);
	}
	if (timer == 50)
	{
		sprite_set(fe, 6030, 5, 0);
		with (smashmarker)
		{
			image_index = 1;
		}
	}
	if (timer == 80)
	{
		timer = 0;
		coincon = 2;
	}
}
if (coincon == 2)
{
	var fe = ferroll.marker;
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		sprite_set(fe, 6030, 0, 0);
