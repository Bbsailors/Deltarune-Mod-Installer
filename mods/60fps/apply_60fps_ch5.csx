	if (trig == true)
	{
		cleanupCutscene();
		setTable(0);
		resetMainCharacters();
		obj_mainchara.cutscene = 0;
		with (obj_fadeout)
		{
			instance_destroy();
		}
		with (instance_create(0, 0, obj_fadein))
		{
			fadespeed = -0.03333333333333333;
			image_alpha = 1 - (fadespeed * 2);
		}
		cutscene = 1001;
	}
}
if (cutscene == 1001)
{
	if (!instance_exists(obj_fadein))
	{
		cutscene = 0;
		global.interact = 0;
	}
}
