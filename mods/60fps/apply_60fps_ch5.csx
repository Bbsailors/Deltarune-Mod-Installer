	c_msgnextloc(""\\EI* What about..^1. the diner!^1? What about skateboards!?/%"", ""obj_ch5_DW30_slash_Step_0_gml_709_0"");
	c_talk();
	c_wait_box(1);
	c_sel(fl);
	c_shakeobj();
	c_wait_talk();
	c_wait(30);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_mad);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\E2* Flowery.../"", ""obj_ch5_DW30_slash_Step_0_gml_717_0"");
	c_msgnextloc(""\\E7* ..^1. you do know I was just playing along^1, right?/"", ""obj_ch5_DW30_slash_Step_0_gml_718_0"");
	c_msgnextloc(""\\E2* My only goal was to find the truth./"", ""obj_ch5_DW30_slash_Step_0_gml_719_0"");
	c_msgnextloc(""\\E7* If anything^1, your actions toward me.../"", ""obj_ch5_DW30_slash_Step_0_gml_720_0"");
	c_msgnextloc(""\\E2* ..^1. made me realize^1, well.../"", ""obj_ch5_DW30_slash_Step_0_gml_721_0"");
	c_msgnextloc(""\\E7* How it feels^1, to receive..^1. such unasked-for affection./%"", ""obj_ch5_DW30_slash_Step_0_gml_722_0"");
	c_talk();
	c_wait_box(1);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_away);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right);
	c_wait_box(2);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_up);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right_lookdown);
	c_wait_box(3);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_down);
	c_wait_box(4);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_away);
	c_wait_box(5);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_down);
	c_wait_talk();
	c_wait(30);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_reach_right);
	c_shakeobj();
	c_speaker(""flowery"");
	c_msgsetloc(0, ""\\EK* You didn't..^1. actually like my mixtape?/"", ""obj_ch5_DW30_slash_Step_0_gml_750_0"");
	c_facenext(""asgore"", ""2"");
	c_msgnextloc(""\\E2* Well..^1. I did^1. It was^1, well^1, very thoughtful./"", ""obj_ch5_DW30_slash_Step_0_gml_752_0"");
	c_msgnextloc(""\\E3* At times^1, you seemed..^1. like a really lovely person./"", ""obj_ch5_DW30_slash_Step_0_gml_753_0"");
	c_msgnextloc(""\\EI* All of you did^1. But.../"", ""obj_ch5_DW30_slash_Step_0_gml_754_0"");
	c_facenext(""flowery"", ""J"");
	c_msgnextloc(""\\EJ* Asgore^1, listen^1! This world^1, it's perfect for you!/"", ""obj_ch5_DW30_slash_Step_0_gml_756_0"");
	c_msgnextloc(""\\EI* I've seen how alone you are^1! You want to go BACK!?/%"", ""obj_ch5_DW30_slash_Step_0_gml_757_0"");
	c_talk();
	c_wait_box(2);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_away);
	c_wait_box(6);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_reach_right);
	c_shakeobj();
	c_wait_talk();
	c_wait(30);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_look_down);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\E7* Flowery^1. Even if I wanted to..^1. I couldn't stay./"", ""obj_ch5_DW30_slash_Step_0_gml_775_0"");
	c_facenext(""flowery"", ""J"");
	c_msgnextloc(""\\EJ* Why?/"", ""obj_ch5_DW30_slash_Step_0_gml_777_0"");
	c_facenext(""asgore"", ""2"");
	c_msgnextloc(""\\E2* Back in the real world^1, my shop is waiting./"", ""obj_ch5_DW30_slash_Step_0_gml_779_0"");
	c_msgnextloc(""\\E3* It's not right to leave it empty./%"", ""obj_ch5_DW30_slash_Step_0_gml_780_0"");
	c_talk();
	c_wait_box(2);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right);
	c_wait_box(4);
	c_sel(as);
	c_sprite(spr_asgore_armor_walk_right);
	c_wait_talk();
	c_sel(as);
	c_imagespeed(0.2);
	c_walkdirect(860, 660, 30);
	c_delaycmd(31, ""imagespeed"", 0);
	c_delaycmd(31, ""imageindex"", 0);
	c_wait(15);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right);
	c_wait(30);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\E0* Someone has to take care of the flowers./"", ""obj_ch5_DW30_slash_Step_0_gml_805_0"");
	c_facenext(""flowery"", ""S"");
	c_msgnextloc(""\\ES* ..^1. heh./"", ""obj_ch5_DW30_slash_Step_0_gml_807_0"");
	c_msgnextloc(""\\E7* Can't argue with that^1, oldbuddy./%"", ""obj_ch5_DW30_slash_Step_0_gml_808_0"");
	c_talk();
	c_wait_box(2);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right_lookdown);
	c_wait_talk();
	c_sel(as);
	c_imagespeed(0.2);
	c_walkdirect_wait(990, 660, 30);
	c_visible(0);
	c_wait(30);
	c_sel(fl);
	c_sprite(spr_flowery_kneel_hurt_right_lookdown_smile);
	c_wait(5);
	c_speaker(""flowery_s"");
	c_msgsetloc(0, ""\\E3* If that's what he wants..^1. that's what he wants./%"", ""obj_ch5_DW30_slash_Step_0_gml_822_0"");
	c_talk_wait();
	c_wait(30);
	c_pannable(1);
	c_panobj(kr_actor, 60);
	c_wait(61);
	c_sel(kr);
	c_facing(""d"");
	c_pannable(0);
	c_actortokris();
	c_actortocaterpillar();
	c_terminatekillactors();
}
if (con == 3 && !i_ex(obj_cutscene_master))
{
	global.interact = 0;
	global.facing = 0;
	global.plot = 500;
	var dw40_event = instance_create(0, 0, obj_ch5_DW40);
	with (dw40_event)
	{
		set_up();
	}
	with (_flashback)
	{
		clean_up();
	}
	snd_free(flashback_track[0]);
	con = -1;
}
");

