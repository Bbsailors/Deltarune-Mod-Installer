		image_index++;
	}
	if (timer == 3)
	{
		image_index++;
		vspeed = 0;
	}
	if (timer == 13)
	{
		image_index++;
	}
	if (timer == 15)
	{
		image_index++;
		with (collision_rectangle(x + (30 * image_xscale), y + (60 * image_yscale), x + (45 * image_xscale), y + (110 * image_yscale), obj_fusuma_door, false, true))
		{
			destroy();
		}
		vspeed = (6 + (0.5 * move_forward)) / global.fps_scale;
		move_forward = 0;
	}
	scr_depth(self, -80 + (refl_idx * 0.001));
	if (timer == 17)
	{
		image_index++;
		vspeed = 0;
	}
	if (timer == 19)
	{
		image_index++;
	}
	if (image_index >= 3 && image_index <= 6)
	{
		if (global.interact == 0 && collision_rectangle(x + (30 * image_xscale), y + (60 * image_yscale), x + (45 * image_xscale), y + (110 * image_yscale), obj_mainchara, false, true))
		{
			sprite_index = touchsprite;
			scr_plat_encounter(self);
			instance_destroy();
			exit;
		}
	}
	if (timer == 25)
	{
		image_index = 0;
		scr_shakeobj();
		if (afterdir == 0)
		{
			con = 0;
			timer = 0;
			if (attack_pattern == 0)
			{
				timer = -60;
			}
		}
	}
	if (timer == 30)
	{
		var tc = instance_create(x + 28, y, obj_terracotta_overworld);
		tc.pacedir = 1 - afterdir;
		tc.sprite_index = other.sprite_index;
		tc.pacespeed = 12;
		tc.pacespeed_start = 12;
		tc.pacedistance = 999999999;
		tc.image_index = 1;
		instance_destroy();
	}
}
else if (con == 2)
{
	scr_depth(self, -80 + (refl_idx * 0.001));
	if (fake_height <= 0)
	{
		if ((i_ex(obj_testoverworldenemy) || global.interact > 0) && timer == 1)
		{
			timer = 0;
		}
		if (timer >= 1)
		{
			fake_yspeed = 1.5;
			fake_height = 2;
			snd_play(rhythm_battle_kdrum, 0.2, 1);
			with (obj_mainchara)
			{
				var hdist = (0.5 * (bbox_left + bbox_right)) - (0.5 * (other.bbox_left + other.bbox_right));
				var vdist = (0.5 * (bbox_top + bbox_bottom)) - (0.5 * (other.bbox_top + other.bbox_bottom));
				if (abs(hdist) > abs(vdist))
				{
					other.hspeed = (8 * sign(hdist)) / global.fps_scale;
					with (other)
					{
						if (collision_check(x + (hspeed * 5 * global.fps_scale), y, true))
						{
							hspeed = 0;
							if (abs(vdist) > 10)
							{
								vspeed = (8 * sign(vdist)) / global.fps_scale;
								if (collision_check(x, y + (vspeed * 5 * global.fps_scale), true))
								{
									vspeed = 0;
								}
							}
						}
					}
				}
				else
				{
					other.vspeed = (8 * sign(vdist)) / global.fps_scale;
					with (other)
					{
						if (collision_check(x, y + (vspeed * 5 * global.fps_scale), true))
						{
							vspeed = 0;
							if (abs(hdist) > 10)
							{
								hspeed = (8 * sign(hdist)) / global.fps_scale;
								if (collision_check(x + (hspeed * 5 * global.fps_scale), y, true))
								{
									hspeed = 0;
								}
							}
						}
					}
				}
			}
			if (timer == 1)
			{
			}
		}
	}
	else
	{
		fake_height += (fake_yspeed / global.fps_scale);
		fake_yspeed -= (1 / global.fps_scale);
		if (fake_height <= 0)
		{
			timer = 0;
			fake_height = 0;
			hspeed = 0;
			vspeed = 0;
			scr_vfxsprite(4027, x + (sprite_width / 2) + 60, bbox_bottom - 5, depth + 1, 0.3, undefined, undefined);
			scr_vfxsprite(4027, (x + (sprite_width / 2)) - 30, bbox_bottom - 5, depth + 1, 0.3, undefined, undefined);
		}
	}
}
if (i_ex(obj_battlecontroller))
{
	instance_destroy();
}
else if (global.interact == 0 && place_meeting(x, y, obj_mainchara) && !i_ex(obj_testoverworldenemy))
{
	sprite_index = touchsprite;
	var enem = scr_plat_encounter(self, encounterflag);
	enem.x += 20;
	enem.sprite_index = touchsprite;
	instance_destroy();
}
");

