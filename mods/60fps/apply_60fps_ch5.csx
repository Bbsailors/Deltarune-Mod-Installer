					var is_standing = false;
					with (obj_plat_follower)
					{
						if (scr_plat_standing_on(""kr"", platform))
						{
							is_standing = true;
							break;
						}
					}
					if (is_standing)
					{
						y_offset_target = 0;
						other.vinestate = 0;
					}
				}
			}
		}
		if (scr_trigcheck_ext(""vinetop"", 912) || !instance_exists(obj_plat_player))
		{
			with (obj_plat_vinehook)
			{
				if (vine_loops == 5)
				{
					y_offset_target = 0;
					other.vinestate = 0;
				}
			}
		}
	}
}
if (i_ex(obj_plat_player))
{
	if (!global.pause_plat && global.interact == 0 && cutscenecon == 0 && con == 0 && scr_trigcheck_ext(""cut1"", 912))
	{
		con = 1;
		with (obj_plat_block)
		{
			if (extflag == ""cutscene"")
			{
				x = -400;
			}
