Apply("gml_Object_obj_flower_deathmarker_Alarm_3", @"alarm[3] = round(2 * global.fps_scale);
scr_whiteflash(self, 1);
");

Apply("gml_Object_obj_flower_deathmarker_Create_0", @"event_inherited();
physics = 0;
gravity = 1 / (global.fps_scale * global.fps_scale);
deathflowercount = 6;
spin = 0;
size = 2;
grayscale_blend = 1;
__grayscalefade = shader_get_uniform(shd_grayscale_fade, ""fade"");
");

Apply("gml_Object_obj_flower_deathmarker_Step_0", @"if (global.pause_plat)
{
	alarm[3] += 1;
	alarm[4] += 1;
}
if (spin != 0)
{
	image_angle += (spin / global.fps_scale);
}
event_inherited();
");

Apply("gml_Object_obj_flower_enmparent_Alarm_2", @"if (paused || custom_paused)
{
	alarm[2] = 1;
	exit;
}
hspeed = h_knockback;
vspeed = v_knockback;
knocked_back = 2;
if (hp <= 0)
{
	if (knockback_on_death)
	{
		var marker = instance_create_depth(x, y, depth, obj_flower_deathmarker);
		with (marker)
		{
			size = other.size;
			sprite_index = other.sprite_index;
			image_index = other.image_index;
			image_xscale = other.image_xscale;
			image_yscale = other.image_yscale;
			image_speed = 0;
			hspeed = other.hspeed;
			vspeed = other.vspeed;
			deathflowercount = other.deathflowercount;
			spin = other.deathmarker_spin;
			alarm[3] = round(4 * global.fps_scale);
			alarm[4] = other.deathmarker_lifetime;
		}
		hit = 0;
		hp = 999;
	}
	instance_destroy();
}
");

Apply("gml_Object_obj_flower_enmparent_Alarm_3", @"if (paused || custom_paused)
{
	alarm[3] = 1;
	exit;
}
if (hp <= 0)
{
	alarm[3] = round(2 * global.fps_scale);
	scr_whiteflash(self, 1);
}
");

Apply("gml_Object_obj_flower_enmparent_Collision_obj_plat_player", @"if (parallax_depth != 0)
{
	exit;
}
if (hit <= 0 && hp > 0 && contact_damage > 0 && !other.hurt && !other.invincible)
{
	snd_play(snd_punchmed);
	with (other)
	{
		do_kb = true;
		hurt_type = 1;
		get_hurt(15, (other.image_xscale * -5) / global.fps_scale, -8 / global.fps_scale, other.contact_damage);
		do_hitstop(4);
		with (scr_plat_vfx(7357))
		{
			image_xscale = choose(1, -1);
			image_yscale = choose(1, -1);
			image_angle = choose(0, 90, 180, 270);
		}
	}
}
");

