Apply("gml_Object_obj_plat_fusumawall_Draw_76", @"__sc_saved = true;
__sc_sx = x;
__sc_sy = y;
if (scr_smoothcam_on())
{
	var __sc_q = 640 / surface_get_width(application_surface);
	x = round(x / __sc_q) * __sc_q;
	y = round(y / __sc_q) * __sc_q;
}
sprite_height_noparallax = sprite_height;
if (parallax > 0)
{
	scr_prepare_parallax_draw(parallax, 0.3);
}
parascale = (1 - parallax) * (1 - parallax);
if (_parallax_draw_set)
{
	var pdepth = 1 - parallax;
	var realdepth = 1 - (pdepth * pdepth);
	true_picscale = lerp(picscale, picscale * 0.7, realdepth);
}
is_visible = true;
var pcam = instance_exists(obj_plat_camera);
var cx = 0;
if (pcam)
{
	cx = obj_plat_camera.x - 320;
}
else
{
	cx = camera_get_view_x(view_camera[0]);
}
if (bbox_right < cx)
{
	is_visible = false;
	exit;
}
if (bbox_left > (cx + 640))
{
	is_visible = false;
	exit;
}
var cy = 0;
if (pcam)
{
	cy = obj_plat_camera.y - 240;
}
else
{
	cy = camera_get_view_y(view_camera[0]);
}
var sh = stalk_height * draw_stalks;
if ((bbox_bottom + sh) < cy)
{
	is_visible = 0.1;
	exit;
}
if (bbox_top > (cy + 480))
{
	is_visible = 0.1;
	exit;
}
");

