Apply("gml_Object_obj_ow_shinobeetle_Draw_0", @"if (keyboard_check(vk_numpad4))
{
	facing = 0;
}
if (keyboard_check(vk_numpad6))
{
	facing = 1;
}
event_inherited();
var sc = abs(fake_height) / 10;
var fy = fake_height * 2;
draw_sprite_ext(spr_dropshadow, 0, bbox_left + (0.5 * (bbox_right - bbox_left)), bbox_bottom, image_xscale * 2 * sc, image_yscale * sc, 0, c_black, 0.2);
var rfacing_off = 88;
if (drawaura)
{
	specialspritecase = 0;
	drawx = 0;
	fakescale = abs(fakescale);
	if (facing == 1)
	{
		fakescale = -abs(fakescale);
		drawx = rfacing_off;
	}
	drawsiner += (0.25 / global.fps_scale);
	var remx = x;
	x += drawx;
	superscalexb = 1;
	drawx = 0;
	drawscale = 1;
	xoff = 0;
	if (facing == 1)
	{
		drawscale = -1;
	}
	drawsiner += (0.25 / global.fps_scale);
	tempx = x;
	x += drawx;
	superscalex = 0;
	superdrawx = 0;
	superscalexb = 1;
	if (facing == 1)
	{
		superscalex = -4;
		superscalexb = -1;
		superdrawx = -sprite_width * 2;
		xoff = 0;
	}
	gpu_set_blendmode(bm_add);
	for (var i = 0; i < 5; i++)
	{
		var aura = (i * 9) + ((drawsiner * 3) % 9);
		var aurax = (aura * 0.75) + (sin(aura / 4) * 4);
		var auray = 45 * scr_ease_in(aura / 45, 1);
		var aurayscale = min(80 / sprite_height, 1);
		draw_sprite_ext(sprite_index, image_index, x - xoff - ((aurax / 180) * drawscale * sprite_width), (y - ((auray / 82) * sprite_height * aurayscale)) + fy, (image_xscale + (aurax / 36)) * drawscale, image_yscale + ((auray / 36) * aurayscale), image_angle, c_red, image_alpha * (1 - (auray / 45)) * 0.5 * auraalph);
	}
	gpu_set_blendmode(bm_normal);
	scr_draw_outline_ext(sprite_index, image_index, x - xoff, y + fy, image_xscale * drawscale, image_yscale, image_angle, c_red, image_alpha * 0.3, 2 * auraalph);
	x = tempx;
	mymidx = x + (sprite_width / 2);
	mymidy = y + ((bbox_bottom - y) / 2) + fy;
	x = remx;
}
if (facing == 0)
{
	draw_sprite_ext(sprite_index, image_index, x, y + fy, 2, 2, 0, image_blend, image_alpha);
}
else
{
	draw_sprite_ext(sprite_index, image_index, x + rfacing_off, y + fy, -2, 2, 0, image_blend, image_alpha);
}
if (scr_debug())
{
	var fbox = 
	{
		x1: (x + 26) - 20,
		x2: x + 26 + 36 + 20,
		y1: (y + 102) - 40,
		y2: (y + 102 + 26) - 10
	};
}
");

Apply("gml_Object_obj_ow_shinobeetle_Step_0", @"event_inherited();
if (init == 0)
{
	if (global.flag[encounterflag] == 1)
	{
		instance_destroy();
	}
	init = 1;
}
if (con == 120)
{
	if (!special)
	{
		btimer += (1 / global.fps_scale);
		if (btimer == 1)
		{
			snd_play(snd_japanese_yo_hit2, 0.5);
			battlemarker = scr_marker_frominstance(id);
			with (battlemarker)
			{
				depth = other.depth;
				y += (other.fake_height * 2);
			}
			visible = 0;
			auraalph = 0;
		}
		if (btimer == 19)
		{
			global.flag[54] = encounterflag;
			battlemarker.depth = 500;
			scr_battle(encounterno, false, battlemarker);
			scr_doom(battlemarker, 24);
			depth = 0;
		}
	}
}
if (instance_exists(obj_battlecontroller))
{
	instance_destroy();
}
if (global.interact > 0)
{
	if (_hs == 0)
	{
		_hs = hspeed;
		hspeed = 0;
	}
	if (_vs == 0)
	{
		_vs = vspeed;
		vspeed = 0;
	}
	exit;
}
else
{
	if (_hs != 0)
	{
		hspeed = _hs;
		_hs = 0;
	}
	if (_vs != 0)
	{
		vspeed = _vs;
		_vs = 0;
	}
}
timer += (1 / global.fps_scale);
if (con == -2)
{
	visible = 0;
	x = xstart;
	y = ystart;
	hspeed = 0;
	vspeed = 0;
	if (scr_trigcheck(trigger_extflag))
	{
		con = -1;
		timer = 0;
	}
}
else if (con == -1)
{
	if (timer == 1)
	{
		scr_delay_var(""visible"", 1, 6);
		with (instance_create(x - 40, y - 10, obj_animation))
		{
			sprite_index = spr_poof;
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
			depth = other.depth - 1;
		}
		snd_stop(snd_wing);
		snd_play(snd_wing);
		snd_play(snd_japanese_yo_hit1, 0.5);
	}
	if (do_yo_sound)
	{
		if (timer == 6)
		{
			if (is_shi)
			{
				image_speed = 0.25 / global.fps_scale;
				x -= 10;
				y += 4;
				sprite_index = spr_scarecrow_hurt;
			}
			else
			{
				sprite_index = spr_shinobeetle_pose;
			}
			visible = 1;
		}
		if (timer == 16)
		{
			snd_play(snd_japanese_yo, 0.75);
		}
		if (timer == 36)
		{
			if (is_shi)
			{
				con = 10;
			}
			else
			{
				con = 0;
			}
			timer = 0;
			visible = 1;
			do_yo_sound = false;
		}
	}
	else if (timer == 6)
	{
		if (is_shi)
		{
			image_speed = 0.25 / global.fps_scale;
			x -= 10;
			y += 4;
			sprite_index = spr_scarecrow_hurt;
			con = 10;
		}
		else
		{
			sprite_index = spr_shinobeetle_pose;
			con = 0;
		}
		timer = 0;
		visible = 1;
	}
}
else if (con == 0)
{
	var delay = 3;
	if (slow)
	{
		delay = 12;
	}
	if (timer == delay)
	{
		if (scr_trigcheck(trigger_extflag))
		{
			con = 1;
			timer = 0;
		}
		else
		{
			con = 2;
			timer = 0;
		}
	}
}
else if (con == 1)
{
	if (timer == hopdelay)
	{
		var krx = 0;
		var kry = 0;
		with (obj_mainchara)
		{
			krx = bbox_left + ((bbox_right - bbox_right) / 2);
			kry = bbox_top + ((bbox_bottom - bbox_top) / 2);
		}
		var targx = krx;
		var targy = kry;
		var myx = bbox.x1 + ((bbox.x2 - bbox.x1) / 2);
		var myy = bbox.y1 + ((bbox.y2 - bbox.y1) / 2);
		var dir = point_direction(myx, myy, targx, targy);
		var spd = 9;
		if (slow)
		{
			spd = 6;
		}
		var dojump = true;
		if (activearea != ""none"")
		{
			if (!scr_trigcheck(activearea))
			{
				with (daddy)
				{
					image_alpha = 0;
					setxy(xstart, ystart);
					con = 0;
					timer = 0;
				}
				with (instance_create((x - 80) + (20 * image_xscale), y - 10, obj_animation))
				{
					sprite_index = spr_poof;
					image_xscale = 2;
					image_yscale = 2;
					image_speed = 0.5 / global.fps_scale;
					depth = other.depth - 1;
				}
				snd_stop(snd_wing);
				snd_play(snd_wing);
				instance_destroy();
				exit;
			}
		}
		var blocker = instance_position(targx, targy, obj_solidenemy);
		if (instance_exists(blocker))
		{
			dojump = false;
			timer = 0;
		}
		if (dojump)
		{
			snd_play(snd_wing, 0.8, 2);
			sprite_index = spr_shinobeetle_flutter;
			for (var i = 2; i < spd; i++)
			{
				var cx = 
				{
					x1: bbox.x1 + lengthdir_x(i, dir),
					y1: bbox.y1 + lengthdir_y(i, dir),
					x2: bbox.x2 + lengthdir_x(i, dir),
					y2: bbox.y2 + lengthdir_y(i, dir)
				};
				var col = collision_rectangle(cx.x1, cx.y1, cx.x2 + i, cx.y2, obj_solidblock, false, true);
				if (!instance_exists(col))
				{
					col = collision_rectangle(cx.x1, cx.y1, cx.x2 + i, cx.y2, obj_solidenemy, false, true);
				}
				if (instance_exists(col))
				{
					spd = i;
					break;
				}
			}
			hspeed = lengthdir_x(spd, dir) / global.fps_scale;
			vspeed = lengthdir_y(spd, dir) / global.fps_scale;
			facing = sign(-hspeed);
			fake_vspeed = -2;
			con = 3;
			timer = 0;
		}
	}
}
else if (con == 2)
{
	hopcount++;
	if (hopcount < hopmax || hopforever)
	{
		hspeed = 0;
		vspeed = 0;
		timer = 0;
		con = 1;
	}
	else if (timer == 1)
	{
		with (instance_create((x - 80) + (20 * image_xscale), y - 10, obj_animation))
		{
			sprite_index = spr_poof;
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
			depth = other.depth - 1;
		}
		visible = false;
		with (scr_marker_centered_frominstance(id))
		{
			facing = other.facing;
			if (facing == 1)
			{
				image_xscale = -2;
			}
			depth = other.depth + 1;
			scr_lerpvar(""image_xscale"", image_xscale, 1 * sign(image_xscale), 3, 2, ""out"");
			scr_lerpvar(""image_alpha"", 1, 0, 6, 2, ""out"");
			scr_doom(id, 6);
		}
		con = -2;
		snd_stop(snd_wing);
		snd_play(snd_wing);
	}
}
else if (con == 3)
{
	fake_height += (fake_vspeed / global.fps_scale);
	fake_vspeed += (0.3 / global.fps_scale);
	if (fake_height >= 0)
	{
		con = 0;
		hspeed = 0;
		vspeed = 0;
		timer = 0;
		fake_height = 0;
		sprite_index = spr_shinobeetle;
	}
}
else if (con == 10)
{
	if (timer == 25)
	{
		scarebubloc(stringsetloc(""I don't remember how I got here."", ""obj_ow_shinobeetle_slash_Step_0_gml_317_0""));
		sprite_index = spr_scarecrow_idle;
	}
	if (obj_mainchara.x < (x - 100))
	{
		con = 11;
		image_speed = 0.5 / global.fps_scale;
		timer = 0;
		sprite_index = spr_scarecrow_smear;
		with (scarebubble)
		{
			instance_destroy();
		}
		scarebubloc(stringsetloc(""H-hey!! Don't run, coward! Fight me!"", ""obj_ow_shinobeetle_slash_Step_0_gml_327_0""));
	}
}
");

Apply("gml_Object_obj_pacifyspell_Create_0", @"target = 439493;
con = 1;
siner = 0;
xx = __view_get(e__VW.XView, 0);
yy = __view_get(e__VW.YView, 0);
alarm[4] = round(50 * global.fps_scale);
fail = 0;
flashcolor = c_blue;
timer = 0;
zcounter = 0;

enum e__VW
{
	XView,
	YView,
	WView,
	HView,
	Angle,
	HBorder,
	VBorder,
	HSpeed,
	VSpeed,
	Object,
	Visible,
	XPort,
	YPort,
	WPort,
	HPort,
	Camera,
	SurfaceID
}
");

Apply("gml_Object_obj_pacifyspell_Step_0", @"if (!i_ex(target) && con < 20)
{
	debug_message(""target does not exist"");
	con = 99;
	instance_destroy();
	exit;
}
if (con == 1)
{
	if (fail == 0)
	{
		siner += (1 / global.fps_scale);
		target.image_blend = merge_color(target.image_blend, flashcolor, 0.1);
		if ((siner % 2) == 0)
		{
			ai = instance_create(target.x + random(target.sprite_width), (target.y + target.sprite_height) - 20, obj_afterimage);
			ai.gravity = 0.5 / (global.fps_scale * global.fps_scale);
			ai.sprite_index = spr_savepoint;
			ai.image_speed = 0.2 / global.fps_scale;
		}
		target.x += ((siner / 4) + (sin(siner / 8) * 10)) / global.fps_scale;
		target.y -= siner / 5 / global.fps_scale;
	}
	else
	{
		siner = 0;
		con = 5;
	}
}
if (con == 2)
{
	with (target)
	{
		instance_destroy();
	}
	instance_destroy();
}
if (con == 5)
{
	con = 6;
	alarm[4] = round(8 * global.fps_scale);
}
if (con == 6)
{
	target.image_blend = merge_color(target.image_blend, flashcolor, 0.12);
}
if (con == 7)
{
	con = 8;
	alarm[4] = round(8 * global.fps_scale);
}
if (con == 8)
{
	target.image_blend = merge_color(target.image_blend, c_white, 0.16);
}
if (con == 9)
{
	target.image_blend = c_white;
	instance_destroy();
}
if (con == 20)
{
	if (timer == 0 && zcounter == 0)
	{
		snd_play(snd_pacify);
	}
	timer -= (1 / global.fps_scale);
	if (timer <= 0)
	{
		var zobj = instance_create(x, y, obj_afterimage_grow);
		zobj.sprite_index = spr_spare_z;
		zobj.speed = 12 / global.fps_scale;
		zobj.direction = zcounter * 40;
		zobj.friction = 1 / (global.fps_scale * global.fps_scale);
		timer = 2;
		zcounter++;
	}
	if (zcounter >= 9)
	{
		con++;
		instance_destroy();
	}
}
");

