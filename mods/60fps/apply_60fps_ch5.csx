Apply("gml_Object_obj_roundbellbullet_Step_0", @"event_inherited();
life_time += (1 / global.fps_scale);
if (life_time < 30)
{
	image_alpha = min(image_alpha + ((0.05 * max(1, speed)) / global.fps_scale), 1);
}
if (place_meeting(x, y, obj_heart))
{
	phase = 2;
	life_time = 999;
}
switch (phase)
{
	case 0:
		if (life_time >= 35)
		{
			life_time = 0;
			phase++;
		}
		break;
	case 1:
		shake_dir += (90 / global.fps_scale);
		if (shake_dir >= 360)
		{
			shake_dir -= 360;
		}
		var _shakelimit = 18;
		with (obj_dbulletcontroller)
		{
			switch (difficulty)
			{
				case 0:
					break;
				case 1:
					_shakelimit = 16;
					break;
				default:
					_shakelimit = 14;
					break;
			}
		}
		if (life_time >= _shakelimit)
		{
			life_time = 0;
			phase++;
			if (y < scr_get_box(5))
			{
				gravity_direction = 270;
			}
			else
			{
				gravity_direction = 90;
			}
			gravity = 0.6 / (global.fps_scale * global.fps_scale);
			with (obj_dbulletcontroller)
			{
				switch (difficulty)
				{
					case 0:
						break;
					case 1:
						other.gravity = 0.8 / (global.fps_scale * global.fps_scale);
						break;
					default:
						other.gravity = 0.9 / (global.fps_scale * global.fps_scale);
						break;
				}
			}
		}
		break;
	case 2:
		if ((life_time >= 15 && (y < scr_get_box(1) || y > scr_get_box(3))) || life_time >= 999)
		{
			speed = 0;
			gravity = 0;
			var _dir = 0;
			repeat (12)
			{
				var _s = instance_create_depth(x, y, 1, obj_fx_pinksparkle);
				_s.direction = _dir;
				_s.speed = 8 / global.fps_scale;
				_dir += 30;
			}
			if (life_time < 999)
			{
				x += ((scr_get_box(4) - x) * 2);
				life_time = 0;
			}
			else
			{
				life_time = -5;
			}
			if (y < scr_get_box(5))
			{
				y = scr_get_box(1) - 8;
				image_angle = 0;
			}
			else
			{
				y = scr_get_box(3) + 8;
				image_angle = 180;
			}
			phase = 0;
			with (obj_dbulletcontroller)
			{
				switch (difficulty)
				{
					case 0:
						break;
					case 1:
						other.life_time += 10;
						break;
					default:
						other.life_time += 20;
						break;
				}
			}
		}
		break;
}
");

