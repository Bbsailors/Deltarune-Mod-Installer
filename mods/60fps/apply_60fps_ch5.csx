			scr_speaker(""no_name"");
			msgsetloc(0, ""* Those who ask nothing^1, shall receive mountains in return^1. Well met./%"", ""obj_dw_castle_church_entrance_slash_Other_15_gml_172_0"");
			d_make();
			myinteract = 99;
		}
	}
	if (myinteract == 13 && !d_ex())
