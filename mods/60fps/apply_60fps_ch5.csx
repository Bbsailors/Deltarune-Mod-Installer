	if (_truetrackpos != 0)
	{
		trackpos = _truetrackpos;
	}
	else
	{
		trackpos = scr_loop(trackpos + (delta_time / 1000000), song_length);
	}
	if (trackpos < last_trackpos)
	{
		beat_index = 0;
		noteindex = 0;
	}
	last_trackpos = trackpos;
	if (beat_index < beat_count && trackpos > beattime[beat_index])
	{
		beat = 1;
		beat_index++;
	}
	else if (beat > 0)
	{
		beat = clamp01(beat - (delta_time / 1000000 / (60 / bpm)));
	}
}
else if (battle_started && image_alpha != 0)
{
	trackpos = scr_loop(trackpos + (delta_time / 1000000), song_length);
	target_alpha = 0;
}
