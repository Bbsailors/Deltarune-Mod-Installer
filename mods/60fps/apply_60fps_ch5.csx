					msgset_add(violence3, x - 20, y + 25, 10, 50);
					msgset_add(violence4, (camerax() + camerawidth()) - 20, y - 50, 10, 50, function()
					{
						talkmax = 120;
					});
					msgset_add(violence5, x - 20, y + 25, 10, 50, function()
