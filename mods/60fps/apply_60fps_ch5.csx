with (obj_plat_barrier)
{
	leftlerp = 1;
	rightlerp = 1;
}
bullet_colors = [4235519, 65535, 65280, 16776960, 16711680, 16711935];

clear_bullets = function()
{
	var i = array_length(bullet3d) - 1;
	while (i >= 0)
	{
		instance_destroy(bullet3d[i]);
		i--;
	}
	bullet3d = [];
};

spawn_3d_bullet = function(arg0)
{
	with (instance_create(x, y, obj_plat_bulletred))
	{
		blend = other.bullet_colors[arg0];
		variant = 3;
		image_blend = blend;
		scr_darksize();
		ampmult = 0;
		sprite_index = spr_omegaflowery_bullets;
		image_index = arg0;
		image_speed = 0;
		scr_lerpvar(""ampmult"", 0, 1, 12, -1, ""out"");
		phase = degtorad(array_length(other.bullet3d) * 60);
		phasetimer = other.subcontimer;
		con = 0;
		array_push(other.bullet3d, self);
	}
};

hurtflash = -4;
ronawait = 0;
waittime = 1;
attack_speed = 24;
jarona_repeat = 0;
jarona_repeat_target = 3;
dashbullet = -4;
_act = scr_configure_platmode_act(undefined, ""su"", """", """");
_act.blocked = 2;

flash_hurt = function(arg0 = 16777215)
{
	hurtflash = scr_oflash();
	hurtflash.flashcolor = arg0;
};

last_hit_x = x;
last_hit_y = y;

do_hit_event = function()
{
	last_hit_x = mean(x + 20, obj_plat_player.x + 10);
	last_hit_y = mean(y + 70, obj_plat_player.y + 10);
	thrash_slash_particle_system.x = last_hit_x;
	thrash_slash_particle_system.y = last_hit_y;
	thrash_slash_particle_system.depth = 5000;
	thrash_slash_struct.image_angle = choose(5 + random(25), -5 - random(25));
	thrash_slash_particle_system.emit(thrash_slash_struct);
	with (instance_create(last_hit_x, last_hit_y, obj_marker))
	{
		sprite_index = spr_explosive_shockwave;
		image_speed = 0;
		image_angle = 0;
		image_alpha = 0.8;
		image_xscale = 2;
		image_yscale = 2;
		scr_lerpvar(""image_xscale"", 2, 0, 2);
		scr_lerpvar(""image_yscale"", 2, 0, 2);
		scr_doom(id, 2);
	}
	with (scr_afterimage())
	{
		visible = false;
		with (obj_plat_camera)
		{
			shake = 4;
		}
		depth = other.depth - 1;
		sprite_index = spr_explosive_shockwave;
		image_index = 2;
		image_xscale = 2.5;
		image_yscale = 0.75;
		image_speed = 0;
		image_angle = choose(90, 270);
		x = mean(x + 20, obj_plat_player.x + 10);
		y = mean(y + 70, obj_plat_player.y + 10);
		image_alpha = 0.85;
		fadeSpeed = 0;
		daddy = other.id;
		scr_script_delayed(scr_lerpvar, 6, ""image_alpha"", 0.85, 0, 6);
		scr_script_delayed(scr_lerpvar, 6, ""image_index"", 2, 5, 6);
		scr_script_delayed(scr_lerpvar, 6, ""image_xscale"", 2.5, 6, 6);
		scr_script_delayed(scr_lerpvar, 6, ""image_yscale"", 0.75, 1.5, 6);
		scr_var_delayed(""visible"", true, 6);
	}
	with (scr_afterimage())
	{
		visible = false;
		scr_shakescreen();
		depth = other.depth - 1;
		sprite_index = spr_explosive_shockwave;
		image_index = 2;
		image_xscale = 2.5;
		image_yscale = 0.75;
		image_speed = 0;
		image_angle = choose(90, 270);
		x = mean(x + 20, obj_plat_player.x + 10);
		y = mean(y + 70, obj_plat_player.y + 10);
		image_alpha = 0.85;
		fadeSpeed = 0;
		daddy = other.id;
		scr_script_delayed(scr_lerpvar, 6, ""image_alpha"", 0.85, 0, 12);
		scr_script_delayed(scr_lerpvar, 6, ""image_index"", 2, 5, 12);
		scr_script_delayed(scr_lerpvar, 6, ""image_xscale"", 2.5, 6, 12);
		scr_script_delayed(scr_lerpvar, 6, ""image_yscale"", 0.75, 1.5, 12);
		scr_var_delayed(""hspeed"", 12 / global.fps_scale, 6);
		scr_var_delayed(""visible"", true, 6);
	}
	scr_script_delayed(function()
	{
		for (var a = 0; a < 6; a++)
		{
			with (instance_create(last_hit_x, last_hit_y, obj_marker))
			{
				sprite_index = spr_whitepixel;
				if (irandom(2))
				{
					image_yscale = 2;
					image_xscale = 2;
				}
				else
				{
					image_yscale = 4;
					image_xscale = 4;
				}
				direction = irandom(360);
				speed = (12 + random(12)) / global.fps_scale;
				hspeed *= 0.35;
				image_angle = direction;
				image_alpha = 0.85;
				x += (hspeed * 2 * global.fps_scale);
				y += (vspeed * 2 * global.fps_scale);
				hspeed += (6 / global.fps_scale);
				my_time = 8 + irandom(16);
				if (image_xscale > 2)
				{
					scr_lerpvar(""image_xscale"", image_xscale, 2, my_time - 2);
				}
				scr_lerpvar(""speed"", speed, random(2) / global.fps_scale, my_time - irandom(2), 2, ""out"");
				scr_lerpvar(""image_alpha"", 0.85, 0, my_time);
				scr_doom(id, my_time);
			}
		}
	}, 6);
};

final_jarona_offset = 0;
final_jarona_ghost_state = 0;
pressbuffer = 0;
boltspeed = 1;
qte_alpha = 0;
qte_prompt_state = 0;
