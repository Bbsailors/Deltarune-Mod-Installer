Apply("gml_Object_obj_shootable_terrain_Create_0", @"scr_platswap_init(self, 2);
init = 0;
flower = -4;
y_anchor = y;

remove_flower = function()
{
	has_flower = false;
	with (flower)
	{
		instance_destroy();
	}
};

spawn_debris = function(arg0)
{
	with (instance_create(random_range(x, x + sprite_width), random_range(y, y + sprite_height), obj_animation))
	{
		sprite_index = spr_bhero_dust;
		image_speed = random_range(0.05, 0.12);
		image_blend = choose(#CC6641, #893327, #68201B);
		image_xscale = arg0;
		image_yscale = image_xscale;
		scr_lerpvar(""image_yscale"", image_yscale, 0, 30);
		scr_lerpvar(""image_xscale"", image_xscale, 0, 30);
		depth = other.depth + 10;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		image_angle = random_range(0, 360);
		vspeed = random_range(4, 12) / global.fps_scale;
		scr_plat_make_pauseable(self);
	}
};

platform = instance_create(x, y, obj_plat_block);
platform.image_xscale = 6;
platform.image_yscale = 3;
platform.visible = false;
image_speed = 0;
is_being_shot = false;
explodetimer = 0;
active_timer = 0;
has_active_plat = true;

on_terrain_destroyed = function()
{
};

chargesound = -4;

stop_sound = function()
{
	if (chargesound != -4)
	{
		snd_stop(chargesound);
		chargesound = -4;
	}
};

get_shot = function()
{
	explodetimer = 30;
	is_being_shot = true;
	chargesound = snd_loop(391, 0.1, 0.5);
	with (obj_dw_fcastle_yellowblue)
	{
		flower_comment_con = -1;
	}
};

destroy_platform = function()
{
	on_terrain_destroyed();
	was_touched = false;
	stop_sound();
	with (platform)
	{
		scr_doom(self, 3);
	}
	with (flower)
	{
		instance_destroy();
	}
	imaage_index = 2;
};
");

Apply("gml_Object_obj_shootable_terrain_Step_0", @"if (init == 0)
{
	init = true;
	if (has_flower)
	{
		var struc = 
		{
			image_xscale: 4,
			image_yscale: 4
		};
		flower = instance_create_depth(x + (0.5 * sprite_width), y + sprite_height, depth, obj_plat_blueflower, struc);
		flower.has_coin = false;
		flower.image_yscale *= -1;
	}
}
if (!is_being_shot && has_flower && image_index == 0)
{
	if (!instance_exists(flower))
	{
		get_shot();
	}
	with (flower)
	{
		if (con != 0)
		{
			with (other)
			{
				get_shot();
			}
		}
	}
}
if (active_timer > 0 && !global.pause_plat)
{
	active_timer -= (1 / global.fps_scale);
	if (frac(active_timer) == 0)
	{
		spawn_debris(random_range(1, 2));
	}
	if (frac(active_timer) == 0)
	{
		spawn_debris(random_range(3, 5));
	}
	if (active_timer <= 0)
	{
		has_active_plat = false;
		destroy_platform();
		snd_play(snd_kikkyshift, 1, 1);
		repeat (30)
		{
			spawn_debris(random_range(1, 2));
		}
		repeat (5)
		{
			spawn_debris(random_range(3, 5));
		}
	}
}
if (explodetimer > 0 && !global.pause_plat)
{
	explodetimer -= (1 / global.fps_scale);
	if (chargesound != -4)
	{
		snd_volume(chargesound, lerp(0.1, 0.7, (25 - (explodetimer - 5)) / 25), 0);
		snd_pitch(chargesound, lerp(0.5, 1, (25 - (explodetimer - 5)) / 25));
	}
	if (explodetimer == 0)
	{
		active_timer = 30;
		image_index = 1;
		var _y = (bbox_bottom + bbox_top) / 2;
		var ang = 0;
		repeat (30)
		{
			spawn_debris(random_range(1, 2));
		}
		repeat (5)
		{
			spawn_debris(random_range(3, 5));
		}
		snd_play(snd_punchheavythunder);
		snd_play(snd_kikkyshift);
		is_being_shot = false;
	}
}
");

