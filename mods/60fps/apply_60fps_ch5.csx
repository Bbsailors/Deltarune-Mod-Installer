	c_msgsetsubloc(0, ""~1* The name's YELLOW./"", (global.lang == ""ja"") ? ""\\m4\t\t\t"" : ""\\m4\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_ch5_DWCL01_slash_Step_0_gml_206_0"");
