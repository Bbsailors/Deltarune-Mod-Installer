idiot1 = instance_create(x, y, obj_idiot_text);
idiot2 = instance_create(x, y, obj_idiot_text);
idiot2.con = 1;
pink_battle_dialogue1 = stringsetloc(""Ahuhuhu..^1. alright,&dearies^1! This is gonna be&a long battle^1, so &why don't you have&an appetizer^1, first!?/%"", ""obj_pink_enemy_slash_Create_0_gml_118_0"");
pink_battle_dialogue2 = stringsetloc(""What the&hey!?&It's&PURPLE!?/%"", ""obj_pink_enemy_slash_Create_0_gml_119_0"");
pink_battle_dialogue3 = stringsetloc(""Arrgh^1, that&stupid bug&said it was&FUCHSIA!!/%"", ""obj_pink_enemy_slash_Create_0_gml_120_0"");
pink_battle_dialogue4 = stringsetloc(""Well^1, no&matter!&You're&trapped now!/%"", ""obj_pink_enemy_slash_Create_0_gml_121_0"");
pink_battle_dialogue5 = stringsetloc(""A little floral tea &will have you tickled &pink^1! Pink^1! PINK!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_122_0"");
pink_battle_dialogue6 = stringsetloc(""Stop..^1. looking!/%"", ""obj_pink_enemy_slash_Create_0_gml_125_0"");
pink_battle_dialogue7 = stringsetloc(""Stop making my&body purr^1, you&jerks!/%"", ""obj_pink_enemy_slash_Create_0_gml_126_0"");
pink_battle_dialogue8 = stringsetloc(""Mew.&Mew!&MEW!/%"", ""obj_pink_enemy_slash_Create_0_gml_127_0"");
pink_battle_dialogue9 = stringsetloc(""What!^1? WHAT do&I look like,&a pincushion!?/%"", ""obj_pink_enemy_slash_Create_0_gml_128_0"");
pink_battle_dialogue6b = stringsetloc(""S..^1. stop&LOOKING at them!/%"", ""obj_pink_enemy_slash_Create_0_gml_130_0"");
pink_battle_dialogue6c = stringsetloc(""Stop making my&body purr^1, you&jerks!/%"", ""obj_pink_enemy_slash_Create_0_gml_131_0"");
pink_battle_dialogue6d = stringsetloc(""Stop.&STOP!&STOP!!!!/%"", ""obj_pink_enemy_slash_Create_0_gml_132_0"");
pink_battle_dialogue6e = stringsetloc(""Where are&my knives!?/%"", ""obj_pink_enemy_slash_Create_0_gml_133_0"");
pink_battle_dialogue6f = stringsetloc(""I want to&DATE^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_135_0"");
pink_battle_dialogue6g = stringsetloc(""I like you,&mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_136_0"");
pink_battle_dialogue6h = stringsetloc(""I want Yogurt&Mushroom^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_137_0"");
pink_battle_dialogue6i = stringsetloc(""I want to eat&Long Knife,&mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_138_0"");
pink_battle_dialogue10 = stringsetloc(""Purple^1, PURPLE,&you can't move,&WHATEVER!/%"", ""obj_pink_enemy_slash_Create_0_gml_142_0"");
pink_battle_dialogue11 = stringsetloc(""Figure out how&to move^1, see if&I care^1, MEW!/%"", ""obj_pink_enemy_slash_Create_0_gml_143_0"");
pink_battle_dialogue12 = stringsetloc(""Now that you're&PURPLE^1, you're&restricted in my&FELINE WEB!/%"", ""obj_pink_enemy_slash_Create_0_gml_145_0"");
pink_battle_dialogue13 = stringsetloc(""Before this body,&I was NOBODY!&A ghost^1! A NOTHING!/%"", ""obj_pink_enemy_slash_Create_0_gml_146_0"");
pink_battle_dialogue13b = stringsetloc(""Now!^1? I'm a SENSATION!&I've got FRIENDS^1!&ENEMIES^1! NEUTRALS!/%"", ""obj_pink_enemy_slash_Create_0_gml_147_0"");
pink_battle_dialogue13c = stringsetloc(""Even my own&DOKI-METER!/%"", ""obj_pink_enemy_slash_Create_0_gml_148_0"");
pink_battle_dialogue13d = stringsetloc(""..^1. h-hey^1, s-stop&staring at that!/%"", ""obj_pink_enemy_slash_Create_0_gml_149_0"");
pink_battle_dialogue14 = stringsetloc(""Jealous!?&I BET you are!/%"", ""obj_pink_enemy_slash_Create_0_gml_151_0"");
pink_battle_dialogue15 = stringsetloc(""Bet you wanna STEAL&this body^1, like a&little grubby&puppet gremlin!!/%"", ""obj_pink_enemy_slash_Create_0_gml_152_0"");
pink_battle_dialogue16 = stringsetloc(""Well^1, who WOULDN'T!?&It's even got its&own limited-edition&voice clips!/%"", ""obj_pink_enemy_slash_Create_0_gml_153_0"");
pink_battle_dialogue16b = stringsetloc(""I love you,&mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_154_0"");
pink_battle_dialogue17 = stringsetloc(""Hey^1, you stupid&gel pens!!&Stop FLIRTING!!/%"", ""obj_pink_enemy_slash_Create_0_gml_156_0"");
pink_battle_dialogue18 = stringsetloc(""You're making my&body's heart...&go funny!!/%"", ""obj_pink_enemy_slash_Create_0_gml_157_0"");
pink_battle_dialogue19 = stringsetloc(""D..^1. die!!/%"", ""obj_pink_enemy_slash_Create_0_gml_158_0"");
pink_battle_dialogue19b = stringsetloc(""Haha^1, you guys&really are doomed!/%"", ""obj_pink_enemy_slash_Create_0_gml_160_0"");
pink_battle_dialogue19c = stringsetloc(""I'm INVINCIBLE^1, and I&don't even feel a&single DOKI looking&deep into your eyes!/%"", ""obj_pink_enemy_slash_Create_0_gml_161_0"");
pink_battle_dialogue19d = stringsetloc(""S..^1. stop looking&deep into my eyes,&idiots!/%"", ""obj_pink_enemy_slash_Create_0_gml_162_0"");
pink_battle_dialogue19e = stringsetloc(""WAIT^1, it's almost&time for my concert!/%"", ""obj_pink_enemy_slash_Create_0_gml_164_0"");
pink_battle_dialogue19f = stringsetloc(""What^1? Nowadays just&being a tough battle&isn't enough to&scrape by^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_165_0"");
pink_battle_dialogue19g = stringsetloc(""You've also gotta&be an idol on&top of it!/%"", ""obj_pink_enemy_slash_Create_0_gml_166_0"");
pink_battle_dialogue19h = stringsetloc(""Doki-meter&MAX^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_168_0"");
pink_battle_dialogue19i = stringsetloc(""D-Doki meter max!?&Hey^1, wh-what does&THAT mean^1, mew!?/%"", ""obj_pink_enemy_slash_Create_0_gml_169_0"");
pink_battle_dialogue19j = stringsetloc(""HEY^1, wh-what is this&crap!^1? I didn't tell&you to.../%"", ""obj_pink_enemy_slash_Create_0_gml_170_0"");
pink_battle_dialogue19k = stringsetloc(""Special&Love-Love&Sequence&Activated,&mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_171_0"");
pink_battle_dialogue19l = stringsetloc(""HEY!!!!!!!"", ""obj_pink_enemy_slash_Create_0_gml_172_0"");
pink_battle_dialogue20 = stringsetloc(""HEY!^1! Body!!!&Why the MEW did&you have them...&DATE US!?/%"", ""obj_pink_enemy_slash_Create_0_gml_176_0"");
pink_battle_dialogue21 = stringsetloc(""I like&them^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_177_0"");
pink_battle_dialogue22 = stringsetloc(""Wh..^1. what!^1? No!&We want to KILL&them^1! LOOK!!/%"", ""obj_pink_enemy_slash_Create_0_gml_178_0"");
pink_battle_dialogue23 = stringsetloc(""Don't hurt&them^1, mew!/%"", ""obj_pink_enemy_slash_Create_0_gml_180_0"");
pink_battle_dialogue24 = stringsetloc(""Hey^1, you're MY&body^1, GET IT!?&My body means.../%"", ""obj_pink_enemy_slash_Create_0_gml_181_0"");
