Apply("gml_Object_obj_plat_game_Step_1", @"if (!paused && hitstop > 0)
{
	hitstop -= (1 / global.fps_scale);
}
var _paused = false;
if (paused)
{
	_paused = paused;
}
if (hitstop > 0)
{
	_paused = 1;
}
if (instance_exists(obj_cutscene_master))
{
	hitstop = 0;
	paused = 0;
	_paused = 0;
}
if (_paused)
{
	global.pause_plat = _paused;
}
else
{
	global.pause_plat = false;
}
if (_paused && !was_paused)
{
	with (obj_plat_pausing_helper)
	{
		on_pause();
	}
	with (obj_plat_entity)
	{
		if (!custom_paused)
		{
			on_pause();
		}
	}
	with (obj_plat_bullet)
	{
		if (!custom_paused)
		{
			on_pause();
		}
	}
}
if (!_paused && was_paused)
{
	with (obj_plat_pausing_helper)
	{
		on_unpause();
	}
	with (obj_plat_entity)
	{
		if (!custom_paused)
		{
			on_unpause();
		}
	}
	with (obj_plat_bullet)
	{
		if (!custom_paused)
		{
			on_unpause();
		}
	}
}
if (paused)
{
	with (obj_doom)
	{
		if (respects_platmode)
		{
			alarm[0]++;
		}
	}
}
was_paused = _paused;
");

