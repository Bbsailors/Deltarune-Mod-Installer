	var blueloc = findsprite(spr_blue_walk_back, ""CUT_1"", undefined, undefined);
	var kr2 = findspriteinfo(spr_krisu_dark, ""CUT_1"", undefined, undefined);
	var su2 = findspriteinfo(spr_susie_walk_up_dw, ""CUT_1"", undefined, undefined);
	var ra2 = findspriteinfo(spr_ralsei_walk_up, ""CUT_1"", undefined, undefined);
