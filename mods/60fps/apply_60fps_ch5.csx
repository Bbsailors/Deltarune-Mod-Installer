		defeatsprite = spr_gameshow_drowningRalsei_ralsei_origin_edit;
		victorysprite = spr_gameshow_drowningRalsei_ralsei_origin_edit;
		actreadysprite = spr_gameshow_drowningRalsei_ralsei_origin_edit;
