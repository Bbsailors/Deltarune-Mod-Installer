		c_imagespeed(0);
		c_speaker(""seth"");
		c_msgsetsubloc(0, ""~1* You mean^1, smile...^1? Heh./"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_173_0"");
		c_msgnextsubloc(""~1* Asgore always..^1. read us~2\""bedtime stories\""./"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_174_0"");
		c_spritenext(3161, 0);
		c_msgvar_add(""x"", 6);
		c_msgnextsubloc(""~1* I want..^1. to read a \""story\"" to~2him^1, too!/%"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_177_0"");
