		scr_flag_set_ext(room_flag, susie_comment_flagbit, 1, 2);
		talkcon = 1;
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\EN* The sunset's beautiful."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_cliff_twirlflowerplatforming_slash_Step_0_gml_97_0"");
		msgnextsubloc(""\\ES* If only Noelle..^1. could see this."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_cliff_twirlflowerplatforming_slash_Step_0_gml_98_0"");
		d_make_plat(0, 7);
