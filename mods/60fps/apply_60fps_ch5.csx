Apply("gml_Object_obj_mainchara_dash_Step_0", @"if (drown)
{
	visible = 0;
	speed = 0;
	exit;
}
if (hitstop > 0)
{
	exit;
}
if (disable_control)
{
	scr_get_inputs(false);
}
else
{
	scr_get_inputs(true);
}
t++;
shake = max(0, shake - (1 / global.fps_scale));
shake_angle = scr_wrap(shake_angle + 80 + irandom(40), 0, 360);
scr_depth_alt();
if (wraparound)
{
	if (x > (room_width + (sprite_width / 2)))
	{
		x -= (room_width + (sprite_width / 2));
		x = 0;
	}
	if (x < (-sprite_width / 2))
	{
		x += (room_width + (sprite_width / 2));
	}
}
if (!impacted)
{
	if ((t % (2 * global.fps_scale)) == 0 && (make_afterimages || jumping))
	{
		afterimage = scr_afterimage_monochrome(14522675, true);
		with (afterimage)
		{
			y = other.y - other.jumppos;
			image_alpha = 0.5;
			fadeSpeed = 0.04;
			scr_depth_alt();
			depth += 1000;
		}
	}
	var _haccel = 1;
	var _vaccel = 3;
	var hspeedinfluence = 0;
	hsp_goal = (runspeed * sign(image_xscale)) + (hinput * hspeedinfluence);
	if (touching_mud)
	{
		mudstay += (1 / global.fps_scale);
		hsp_goal = lerp(hsp_goal, hsp_goal * 0.25, min(mudstay / 2, 1));
		if ((dashtimer % 6) == 0)
		{
			snd_play(snd_splash, 0.15, random_range(0.4, 0.7));
			with (scr_vfx_above(7978))
			{
				die_animend = 1;
				image_blend = #774400;
			}
		}
	}
	else
	{
		mudstay = max(mudstay - (1 / global.fps_scale), 0);
		hsp_goal = lerp(hsp_goal * 0.75, hsp_goal, min((20 - mudstay) / 2, 1));
	}
	touching_mud = false;
	if (mudstay >= 22)
	{
		if (!stopping)
		{
			cam.accel = 0.1;
			snd_play(snd_wing);
			stopping = 1;
			scr_lerpvar(""runspeed"", runspeed, 0, 7);
			scr_lerpvar(""speed"", speed, 0, 10);
			alarm[2] = round(10 * global.fps_scale);
		}
	}
	vsp_goal = vinput * stick_vmag * (8 / global.fps_scale);
	if (runspeed != 0)
	{
		image_speed = abs(hsp_goal / runspeed) / 3 / global.fps_scale;
	}
	if (stopping)
	{
		_haccel = 1.5;
		if (instance_exists(obj_dw_cliff_gardentransition_new))
		{
			_haccel = 0.01;
		}
		_vaccel = 3;
		hsp_goal = 0;
		vsp_goal = 0;
		sprite_index = spr_kris_plat_turn;
		image_index = 0;
		if (!jumping && abs(hspeed) > 0 && (t % (2 * global.fps_scale)) == 0)
		{
			with (scr_vfx_above(5979))
			{
				depth = other.depth + 2;
				y = other.bbox_bottom;
				image_xscale = other.image_xscale;
			}
		}
	}
	else if (!jumping)
	{
		sprite_index = spr_kris_plat_run;
	}
	else if (jumpspd >= 0)
	{
		sprite_index = spr_kris_jump_up;
	}
	else
	{
		sprite_index = spr_kris_jump_down;
	}
	hspeed = scr_clamp_gradual(hspeed, hsp_goal, hsp_goal, _haccel / (global.fps_scale * global.fps_scale));
	vspeed = scr_clamp_gradual(vspeed, vsp_goal, vsp_goal, _vaccel / (global.fps_scale * global.fps_scale));
}
var _can_drown = 1;
if (jumping)
{
	_can_drown = 0;
	jumppos += (jumpspd / global.fps_scale);
	jumpspd -= (jumpgravity / global.fps_scale);
	with (cam)
	{
	}
	if (jumppos <= 0)
	{
		jumppos = 0;
		jumping = 0;
		if (impacted)
		{
			if (bounces > 0)
			{
				_can_drown = 1;
				bounces--;
				jumping = 1;
				jumpspd = bonkheight;
				hspeed *= 0.75;
				snd_play_pitch(snd_punchmed, 0.9);
				shake = 4;
			}
			else
			{
				snd_play_pitch(snd_noise, 1.1);
				hspeed = 0;
				sprite_index = spr_kris_plat_land;
				alarm[2] = round(10 * global.fps_scale);
				image_index = 0;
				image_speed = 0.25 / global.fps_scale;
			}
		}
	}
}
if (!instance_place(x, y, obj_solidblock))
{
	last_openX = x;
	last_openY = y;
}
dashtimer += (1 / global.fps_scale);
spawn_water_splash = false;
if (_can_drown && collision_line(x, bbox_bottom - 6, x, bbox_bottom, obj_waterpit, 0, 0) && !drown)
{
	var pit = instance_place(x, y + 6, obj_waterpit);
	if (pit.dash_across && !impacted)
	{
		if (pit.ripple_palette == 0)
		{
			spawn_water_splash = 1;
			if ((dashtimer % 4) == 0)
			{
				snd_play(snd_splash, 0.15, random_range(1.6, 1.8));
				with (instance_create_depth(x, y + 30, depth + 200, obj_animation))
				{
					scr_darksize();
					sprite_index = spr_dash_ripple;
					if (pit.ripple_palette == 1)
					{
						sprite_index = spr_dash_ripple_dark;
					}
					image_speed = 1 / global.fps_scale;
					image_xscale = other.image_xscale;
					hspeed = other.hspeed;
				}
			}
		}
		else
		{
			spawn_water_splash = 2;
			if ((dashtimer % 4) == 0)
			{
				snd_play(snd_splash, 0.15, random_range(1.6, 1.8));
				scr_make_ripple(x, y + 30, 120, 4600106, 400, 20, 16, 1999000, hspeed * 0.5, 0, 0, 0, 3);
			}
		}
	}
	else
	{
		audio_stop_sound(snd_punchmed);
		snd_play(snd_splash);
		drown = 1;
		with (scr_vfx_above(7978))
		{
			die_animend = 1;
		}
		visible = 0;
		with (obj_plat_dashlines)
		{
			owner = -4;
		}
		alarm[0] = round(20 * global.fps_scale);
		alarm[1] = round(40 * global.fps_scale);
		exit;
	}
}
if (battlemode == 1)
{
	global.inv -= (1 / global.fps_scale);
	if (global.inv < 0)
	{
		with (collision_rectangle(x - 9, y + 1, x + 14, y + 14, obj_overworldbulletparent, 1, 0))
		{
			event_user(5);
			scr_shakescreen();
			show_debug_message(""hit!"");
		}
	}
}
if ((place_meeting(x, y - abs(vspeed) - 2, obj_solidblock) || place_meeting(x, y - abs(vspeed) - 2, obj_solidblocksized_dash)) && vspeed <= 0)
{
	vspeed = 0;
}
if ((place_meeting(x, y + abs(vspeed) + 6, obj_solidblock) || place_meeting(x, y + abs(vspeed) + 6, obj_solidblocksized_dash)) && vspeed >= 0)
{
	vspeed = 0;
}
var solidblock = instance_place(x + (runspeed_max * image_xscale), y, obj_solidblock);
if (solidblock == -4)
{
	solidblock = instance_place(x + (runspeed_max * image_xscale), y, obj_solidblocksized_dash);
}
if ((solidblock && solidblock.object_index != obj_leafpile && solidblock.object_index != obj_solidblocksized_nodash && !object_is_ancestor(solidblock.object_index, obj_solidblocksized_nodash)) && !jumping && !impacted)
{
	if (solidblock)
	{
		if (variable_instance_exists(solidblock.id, ""__has_spinner""))
		{
			exit;
		}
		if (solidblock.object_index == obj_sdl_dark || solidblock.object_index == obj_sdr_dark)
		{
			vspeed = (-runspeed * solidblock.image_yscale) / solidblock.image_xscale;
			on_slope = 5;
			exit;
		}
		else if (solidblock.object_index == obj_sul_dark || solidblock.object_index == obj_sur_dark)
		{
			vspeed = (runspeed * solidblock.image_yscale) / solidblock.image_xscale;
			on_slope = 5;
			exit;
		}
	}
	alarm[2] = -1;
	impacted = 1;
	with (collision_rectangle(bbox_left - 120, bbox_top, bbox_right + 120, bbox_bottom, obj_treasure_fox, false, true))
	{
		if (con == 0)
		{
			con = 25;
			timer = 0;
			dir = -sign(image_xscale);
		}
	}
	bounces = 0;
	shake = 10;
	sprite_index = spr_plat_kris_ball;
	image_speed = 0.25 / global.fps_scale;
	hspeed = (-image_xscale * 1.5) / global.fps_scale;
	vspeed = 0;
	jumping = 1;
	jumpspd = bonkheight;
	jumpgravity = 1.25;
	cam.accel = 0;
	snd_play_pitch(snd_cymbal, 1.2);
	snd_play(snd_punchmed);
	with (instance_create(x + (20 * image_xscale), y, obj_plat_vfx))
	{
		sprite_index = spr_smack_vfx;
		alarm[0] = round(2 * global.fps_scale);
		image_angle = 90 * irandom(3);
	}
	with (obj_caterpillar_dash)
	{
		bonk_x = other.x;
	}
}
");

Apply("gml_Object_obj_mainchara_dash_Step_1", @"if (global.interact == 1)
{
	hitstop = 2;
}
if (hitstop > 0)
{
	if (!speeds_stored)
	{
		speeds_stored = 1;
		stored_hspeed = hspeed;
		stored_vspeed = vspeed;
	}
	hspeed = 0;
	vspeed = 0;
	image_speed = 0;
	hitstop -= (1 / global.fps_scale);
	if (hitstop <= 0)
	{
		speeds_stored = 0;
		hspeed = stored_hspeed;
		vspeed = stored_vspeed;
	}
	scr_pause_alarms(2);
}
");

Apply("gml_Object_obj_mainchara_dash_Step_2", @"update_camera();
if (hitstop > 0)
{
	exit;
}
with (collision_rectangle(bbox_left, bbox_top, bbox_right, bbox_bottom, obj_doorparent, 0, 0))
{
	event_user(9);
	global.flag[1389] = other.camera_distance;
	if (global.start_in_dashmode == UnknownEnum.Value_0)
	{
		global.start_in_dashmode = other.image_xscale;
	}
}
if (bg == 1)
{
	with (obj_backgrounderparent)
	{
		event_user(0);
	}
}
if (instance_number(obj_dw_cliffs_tallgrass) > 0)
{
	var li = ds_list_create();
	collision_rectangle_list(x - 4, bbox_top, x + 4, bbox_bottom + 10, obj_dw_cliffs_tallgrass, false, true, li, false);
	var snd = false;
	for (var i = 0; i < ds_list_size(li); i++)
	{
		if (ds_list_find_value(li, i).cut_down())
		{
			snd = true;
		}
	}
	if (snd)
	{
		snd_play(snd_wing, 0.4, 0.9);
	}
	ds_list_destroy(li);
}

enum UnknownEnum
{
	Value_0
}
");

