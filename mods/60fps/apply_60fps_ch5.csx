		with (obj_dw_fcastle_sandtrap_shijoke)
		{
			if (scarecrow)
			{
				instance_destroy();
			}
		}
		with (obj_dw_fcastle_sandtrap)
		{
			scarecrowcreatecon = 99;
		}
		visible = false;
		con = 300;
	}
}
if (con == 300 && !instance_exists(obj_battleback))
{
	global.interact = 0;
	instance_destroy();
}
