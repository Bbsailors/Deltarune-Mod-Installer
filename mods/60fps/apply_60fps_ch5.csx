Apply("gml_Object_obj_plat_enm_orange_miniboss_Other_19", @"var lastdir = direction;
var _hspeed = lengthdir_x(stored_speed, direction) * 2;
var _vspeed = lengthdir_y(stored_speed, direction) * 2;
var newdir = direction;
var cx = camerax();
var cy = cameray();
var cw = camerawidth();
var ch = cameraheight();
var padh = -20;
var padv = -20;
var hcheck = (x + _hspeed) < (cx - padh) || (x + _hspeed) > (cx + cw + padh);
var vcheck = (y + _vspeed) < (cy - padv) || (y + _vspeed) > ((cy + ch) - 120);
var got_hit = false;
if (hcheck && !vcheck)
{
	newdir = 180 - newdir;
	x += lengthdir_x(stored_speed, newdir);
	y += lengthdir_y(stored_speed, newdir);
	got_hit = true;
	with (obj_plat_camera)
	{
		shakex = 6;
	}
}
else if (vcheck && !hcheck)
{
	newdir = -1 * newdir;
	x += lengthdir_x(stored_speed, newdir);
	y += lengthdir_y(stored_speed, newdir);
	got_hit = true;
	with (obj_plat_camera)
	{
		shakey = 6;
	}
}
else if (hcheck && vcheck)
{
	newdir = 180 - newdir;
	newdir = -1 * newdir;
	x += lengthdir_x(stored_speed, newdir);
	y += lengthdir_y(stored_speed, newdir);
	got_hit = true;
	with (obj_plat_camera)
	{
		shakex = 6;
		shakey = 6;
	}
}
if (got_hit)
{
	shake = 4;
	snd_stop(snd_jump);
	snd_stop(snd_whack_absurdlyloud);
	snd_play(snd_jump, 0.4, 1.3);
	snd_play(snd_whack_absurdlyloud, 0.1, 1.3);
	repeat (4)
	{
		with (instance_create(x, y, obj_animation))
		{
			sprite_index = spr_plat_impact_splash;
			direction = lastdir + 180 + random_range(45, -45);
			speed = random_range(3, 12) / global.fps_scale;
			friction = 0.8 / (global.fps_scale * global.fps_scale);
			image_speed = 0.6 / global.fps_scale;
			image_angle = direction;
			image_blend = c_orange;
		}
	}
	var no_explode = false;
	with (obj_plat_enm_orange_miniboss)
	{
		if (con != 150)
		{
			no_explode = true;
		}
	}
	if (!no_explode)
	{
		hit = 1;
		hp = 0;
		mus_fade(global.currentsong[1], 1);
		snd_free(global.currentsong[0]);
		instance_destroy();
	}
}
direction = newdir;
");

Apply("gml_Object_obj_plat_enm_orange_miniboss_Step_0", @"event_inherited();
if (!instance_exists(obj_plat_player))
{
	scr_flower_despwn();
	exit;
}
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (!can_attack)
{
	exit;
}
if (expire_timer >= 5400)
{
	instance_destroy();
	exit;
}
if (spawn_assist_enemies && hp < 15)
{
	hp = 999;
	food_pattern = 3;
}
if (con < 120 && parallax_depth == 0 && collision_circle(x, y, 20 * abs(image_xscale), obj_plat_hbx, false, true))
{
	var cancel = false;
	with (obj_plat_hbx)
	{
		if (!hit_check(other.id))
		{
			cancel = true;
		}
	}
	if (!cancel)
	{
		if (con == 14 && contimer >= 61 && last_bounce_timer == 0)
		{
			hspeed = sign(x - obj_plat_player.x) * (abs(other.hspeed) + 12);
			vspeed -= 1;
			var ia = point_direction(0, 0, hspeed, vspeed);
			with (instance_create(x, y, obj_animation))
			{
				sprite_index = spr_vfx_directional_hit;
				image_xscale = 2;
				image_yscale = 2;
				image_speed = 0.5 / global.fps_scale;
				image_blend = c_red;
				depth = other.depth + 1;
				image_angle = ia;
			}
			scr_plat_hitstop_global(5);
			contact_damage = 0;
			scr_delay_var(""contact_damage"", 30, 30);
			if (contimer >= 65)
