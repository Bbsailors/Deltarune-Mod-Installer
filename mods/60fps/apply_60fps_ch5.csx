Apply("gml_Object_obj_flowerdie_Create_0", @"on_spawn = function(arg0)
{
};

particle_system = instance_create_depth(x, y, depth, obj_custom_particle_system);

particle_system.particle_step_func = function(arg0)
{
	if (arg0.custom_data.redirecting)
	{
		arg0.custom_data.gtime_now += 1 / global.fps_scale;
		var t = ease_in_quad(arg0.custom_data.gtime_now / arg0.custom_data.gtime, 0, 1, 1);
		arg0.x = lerp(arg0.custom_data.startx, arg0.custom_data.gx, t);
		arg0.y = lerp(arg0.custom_data.starty, arg0.custom_data.gy, t);
		arg0.hspeed = arg0.hspeed * 0.9;
		arg0.vspeed = arg0.vspeed * 0.9;
		if (t >= 1)
		{
			arg0.timer = 9999;
		}
	}
	else
	{
		arg0.hspeed = arg0.hspeed * power(0.92, 1 / global.fps_scale);
		arg0.vspeed = arg0.vspeed * power(0.92, 1 / global.fps_scale);
		if (arg0.timer >= (arg0.custom_data.fadewait * global.fps_scale))
		{
			arg0.image_alpha -= 0.05 / global.fps_scale;
			if (arg0.image_alpha <= 0)
			{
				arg0.timer = 9999;
			}
		}
	}
	arg0.image_angle += arg0.custom_data.rspeed / global.fps_scale;
	arg0.image_yscale = sin(arg0.timer * (arg0.custom_data.f / global.fps_scale)) * arg0.image_xscale;
};

particle_system.default_particle_data.image_xscale = 1;
particle_system.default_particle_data.image_yscale = 1;
particle_system.default_particle_data.gravity = 0.1;
particle_system.default_particle_data.lifetime = 4999;
particle_system.default_particle_data.sprite_index = spr_flowerfx_colorless;
init = false;
amount = 6;
regroup_target = -4;
gtime = 8;
colored = false;
scale = 1;
wall_smash = false;
spread = 360;
flower_pattern = false;
flower_sides = 8;
