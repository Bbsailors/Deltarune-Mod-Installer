Apply("gml_Object_obj_dw_fcastle_yellowblue_gun_Step_0", @"if (global.pause_plat)
{
	exit;
}
if (!init)
{
	init = true;
	snd_play(snd_spearrise, 0.7, 1.3);
	scr_lerpvar(""x"", x, x + (90 * image_xscale), 12, 1, ""out"");
	snd_play(snd_rocket_long, 0.5, 1.3);
}
timer += (1 / global.fps_scale);
if (con == 0)
{
	for (var i = 0; i < array_length(orbs); i++)
	{
		if (instance_exists(orbs[i]))
		{
			orbs[i].x += x - lastx;
		}
	}
	lastx = x;
	orbsize = scr_approach(orbsize, 2, 0.1);
	if (timer < 24 && (timer % 2) == 0)
	{
		var ang = random_range(75, -75) + 90 + (90 * -sign(image_xscale));
		var xx = x + (66 * image_xscale) + lengthdir_x(120, ang);
		var yy = (y - 8) + lengthdir_y(120, ang);
		with (instance_create(xx, yy, obj_animation))
		{
			image_blend = c_yellow;
			depth = other.depth - 1;
			scr_darksize();
			image_angle = point_direction(x, y, other.x + (66 * other.image_xscale), other.y - 8);
			sprite_index = spr_plat_impact_splash;
			array_push(other.orbs, self);
		}
	}
	if (timer == 10)
	{
		with (instance_create(x, y - 8 - 40, obj_marker))
		{
			sprite_index = spr_pxwhite;
			image_yscale = 80;
			image_blend = c_black;
			image_alpha = 0;
			image_xscale = 360 * other.image_xscale;
			scr_doom(self, 20);
			scr_lerpvar(""image_alpha"", 0, 0.5, 20);
		}
	}
	if (timer >= 30)
	{
		var xx = x + (66 * image_xscale);
		var yy = y - 8;
		var xmove = x - xstart;
		with (instance_create(xx, yy, obj_marker))
		{
			depth = other.depth - 100;
			sprite_index = spr_vfx_parry_ring;
			image_xscale = 0.3;
			image_yscale = 0.3;
			image_blend = c_yellow;
			image_angle = random_range(0, 360);
			scr_lerpvar(""image_xscale"", image_xscale, 2, 8, 1, ""out"");
			scr_lerpvar(""image_yscale"", image_xscale, 2, 8, 1, ""out"");
			scr_lerpvar(""image_alpha"", 2, 0, 8);
			scr_doom(self, 8);
		}
		with (instance_create(xx, yy, obj_animation))
		{
			depth = other.depth - 100;
			sprite_index = spr_vfx_parry_impact;
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
			image_angle = 90;
		}
		with (instance_create(xx, yy, obj_animation))
		{
			depth = other.depth - 200;
			sprite_index = spr_vfx_directional_hit;
			image_xscale = -other.image_xscale;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
		}
		with (instance_create(xx - (18 * image_xscale), yy, obj_plat_bulletred_laser))
		{
			image_xscale = -320 * other.image_xscale;
			image_yscale = 40;
			fancy_visuals = true;
			base_damage = 50;
			anchor = other;
			stick = true;
			scr_lerpvar(""x"", x, x - xmove, 60, 1, ""in"");
		}
		snd_play(snd_punchheavythunder, 0.6);
		snd_play(snd_whack_absurdlyloud, 0.2, 0.4);
		con = 1;
		scr_lerpvar(""x"", x, xstart, 60, 1, ""in"");
		scr_delay_var(""gravity"", 0.5 / (global.fps_scale * global.fps_scale), 60);
		scr_doom(self, 120);
	}
}
");

