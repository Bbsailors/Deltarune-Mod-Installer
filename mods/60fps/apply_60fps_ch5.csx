Apply("gml_Object_obj_plat_npc_Step_0", @"if (visible_is_active && !visible)
{
	exit;
}
if (paused)
{
	scr_pause_alarms();
	exit;
}
var pj = press_jump;
key_left = false;
key_right = false;
key_up = false;
key_down = false;
press_left = false;
press_right = false;
press_up = false;
press_down = false;
vinput = 0;
hinput = 0;
press_jump = false;
key_jump = false;
press_attack = false;
key_attack = false;
key_left = key_left_override;
key_right = key_right_override;
press_jump = pj;
onscreen = true;
var _early_cancel = false;
var _FollowObject = -4;
if (state == 1)
{
	var _next_marker = -4;
	var _follow = -4;
	if (is_string(followtarget))
	{
		with (obj_plat_movemarker)
		{
			if (extflag == other.followtarget)
			{
				_follow = id;
				_next_marker = next_extflag;
				break;
			}
		}
	}
	else if (instance_exists(followtarget))
	{
		_follow = followtarget;
		if (followtarget.object_index == obj_plat_movemarker)
		{
			_next_marker = followtarget.next_extflag;
		}
	}
	with (_follow)
	{
		var _dist = point_distance(x, y, other.x + other.followxoffset, other.y);
		if (_dist <= 60 && _next_marker != """" && _next_marker != -4)
		{
			other.followtarget = _next_marker;
		}
	}
	_FollowObject = _follow;
}
else if (state == -1)
{
	if (custom_state != undefined)
	{
		custom_state();
	}
}
if (instance_exists(_FollowObject))
{
	var _followX = _FollowObject.x + followxoffset;
	var _followY = _FollowObject.y;
	if (vspeed > -3 && !grounded)
	{
		var _goto_last_ground = true;
		var _ground = check_if_above_ground();
		if (instance_exists(_ground))
		{
			_goto_last_ground = false;
		}
		if (_goto_last_ground)
		{
			_followX = grounded_lastX;
		}
	}
	var _follow_dist = 10;
	var _keepmoving = 0;
	key_left = false;
	key_right = false;
	if (x > (_followX + _follow_dist))
	{
		key_left = true;
	}
	if (x < (_followX - _follow_dist))
	{
		key_right = true;
	}
	if (state == 1)
	{
		if (grounded && can_jump)
		{
			if (y > (_followY + 40) && abs(_followX - x) <= 80)
			{
				press_jump = true;
			}
		}
	}
	if (grounded)
	{
		if (hspeed > 0 && !collision_line(x, y, x, bbox_bottom + 10, obj_plat_floor, 0, 0) && !collision_line(x, y, x, bbox_bottom + 10, obj_plat_player.ground, 0, 0))
		{
			press_jump = true;
		}
		if (hspeed < 0 && !collision_line(x, y, x, bbox_bottom + 10, obj_plat_floor, 0, 0) && !collision_line(x, y, x, bbox_bottom + 10, obj_plat_player.ground, 0, 0))
		{
			press_jump = true;
		}
	}
	release_jump = 0;
	if (y < _FollowObject.y && vspeed < 0)
	{
		release_jump = 1;
	}
}
var _hspeedmax = hspeed_max;
var _haccel = ground_accel;
if (!grounded)
{
	_haccel = air_accel;
}
if (key_left)
{
	hspeed -= _haccel;
	if (hspeed <= -_hspeedmax)
	{
		hspeed = -_hspeedmax;
	}
	if (instance_place(x - 1, y, obj_plat_block) && wallcollision)
	{
		hspeed = 0;
		x = xprevious;
	}
}
if (key_right)
{
	hspeed += _haccel;
	if (hspeed >= _hspeedmax)
	{
		hspeed = _hspeedmax;
	}
	if (instance_place(x + 1, y, obj_plat_block) && wallcollision)
	{
		hspeed = 0;
		x = xprevious;
	}
}
if (physics)
{
	var _hdecel = 1;
	if (grounded)
	{
		_hdecel = ground_decel;
	}
	else
	{
		_hdecel = air_decel;
	}
	if ((!key_left && !key_right) || (key_left && key_right))
	{
		hspeed *= power(_hdecel, 1 / global.fps_scale);
	}
}
if ((press_jump || jumpsquat > 0) && (grounded || (jump_coyote_time > 0 && vspeed > -1)) && can_jump && !instance_place(x, y - 4, obj_plat_block))
{
	jumpsquat = max(jumpsquat + 1, 1);
	press_jump = false;
	if (jumpsquat > jumpsquat_max)
	{
		jumpsquat = 0;
		climbing = false;
		vspeed = -jumpheight;
		y -= 1;
		jumping = 1;
	}
}
else
{
	jumpsquat = 0;
}
if (vspeed < 0 && release_jump && jumping)
{
	vspeed *= 0.8;
	jumping = 0;
}
if (vspeed > 0)
{
	jumping = 0;
}
event_inherited();
if (state == 1)
{
	reached_target();
}
");

Apply("gml_Object_obj_plat_npc_Step_2", @"if (visible_is_active && !visible)
{
	exit;
}
event_inherited();
if (paused)
{
	exit;
}
if (shakeamt > 0)
{
	shaketimer--;
	if (shaketimer <= 0)
	{
		if (shaketype == 0)
		{
			shakex = random_range(-shakeamt, shakeamt);
			shakey = random_range(-shakeamt, shakeamt);
		}
		if (shaketype == 1)
		{
			shakex = random(shakeamt);
		}
		if (shaketype == 2)
		{
			shakex = random_range(-shakeamt, shakeamt);
		}
		if (shaketype == 3)
		{
			shakex = -random(shakeamt);
		}
		if (shaketype == 4)
		{
			shakey = random_range(-shakeamt, shakeamt);
		}
		if (shaketype == 5)
		{
			shakey = -random(shakeamt);
		}
		if (shaketype == 6)
		{
			shakey = random(shakeamt);
		}
		shaketimer = shaketime;
	}
}
else
{
	shakex = 0;
	shakey = 0;
}
if (forced_anim)
{
	exit;
}
if (grounded != groundedprev && grounded && !land_anim)
{
	land_anim = true;
	set_sprite(spr_land);
	image_index = 0;
	image_speed = 0.25 / global.fps_scale;
}
if (key_left)
{
	if (grounded && !turn_anim && hspeed > 0.1)
	{
		turn_anim = true;
		set_sprite(spr_turn);
		image_speed = 0.5 / global.fps_scale;
	}
	image_xscale = -2;
}
if (key_right)
{
	image_xscale = 2;
	if (grounded && !turn_anim && hspeed < -0.1)
	{
		turn_anim = true;
		set_sprite(spr_turn);
		image_speed = 0.5 / global.fps_scale;
	}
}
if (grounded)
{
	if (((!key_left && !key_right) || (key_left && key_right)) && !runstop_anim && !land_anim && sprite_draw == spr_run)
	{
		turn_anim = false;
		runstop_anim = true;
		set_sprite(spr_halt);
		image_index = 0;
		image_speed = 0.3 / global.fps_scale;
	}
}
if (key_left || key_right || sprite_draw != spr_halt)
{
	runstop_anim = false;
}
if (!grounded)
{
	land_anim = false;
	turn_anim = false;
	runstop_anim = false;
}
if (sprite_draw != spr_land || key_left || key_right)
{
	land_anim = false;
}
if (!land_anim && !turn_anim && !runstop_anim)
{
	if (!turn_anim)
	{
		image_speed = 0.25 / global.fps_scale;
	}
	if (grounded)
	{
		if (key_left || key_right)
		{
			set_sprite(spr_run);
		}
		if (key_left && hspeed > 0.1 && !turn_anim)
		{
			turn_anim = true;
			set_sprite(spr_turn);
		}
		if (key_right && hspeed < -0.1 && !turn_anim)
		{
			turn_anim = true;
			set_sprite(spr_turn);
		}
		if (hspeed < 0.25 && hspeed > -0.25)
		{
			if (!turn_anim)
			{
				image_speed = 0.25 / global.fps_scale;
				set_sprite(spr_idle);
			}
		}
		else
		{
			if (!turn_anim)
			{
				image_speed = (0.25 + (0.2 * (abs(hspeed) / abs(hspeed_max)))) / global.fps_scale;
			}
			if (key_left && key_right)
			{
				turn_anim = false;
				image_speed = 0.25 / global.fps_scale;
				set_sprite(spr_idle);
			}
		}
	}
	else
	{
		image_speed = 0.25 / global.fps_scale;
		if (vspeed < 1)
		{
			set_sprite(spr_jump);
		}
		else
		{
			set_sprite(spr_fall);
		}
	}
}
if (jumpsquat > 0)
{
	set_sprite(spr_land);
}
if (physics)
{
	scr_collision_failsafe();
}
");

Apply("gml_Object_obj_plat_orange_gloves_coordinator_Step_0", @"if (global.pause_plat)
{
	exit;
}
if (!instance_exists(right_glove) && !instance_exists(left_glove))
{
	instance_destroy();
	exit;
}
contimer += (1 / global.fps_scale);
if (phase == 0)
{
	if (con == -1)
	{
		if (left_glove.con == -1)
		{
			con = 0;
		}
	}
	if (con == -2 && instance_exists(right_glove))
	{
		phase++;
		con = -1;
	}
	if (con == 0)
	{
		if (left_glove.hp < 62)
		{
			var cx = camerax();
			var offset = left_glove.xstart - cx;
			with (instance_create((cx + 640) - offset, left_glove.ystart, obj_flower_spawner))
			{
				targetscale = 1;
				obj_index = 606;
				silent = true;
				_memory = 
				{
					uses_coordinator: true,
					enemy_wave: ""glove1""
				};
			}
			con = -2;
		}
		else
		{
			con = -1;
			contimer = 0;
			if (left_glove.con != 102)
			{
				left_glove.con = 100;
			}
			left_glove.contimer = 0;
		}
	}
}
else if (phase == 1)
{
	if (!instance_exists(left_glove) || !instance_exists(right_glove))
	{
		with (left_glove)
		{
			hit = 1;
			hp = 0;
			instance_destroy();
		}
		with (right_glove)
		{
			hit = 1;
			hp = 0;
			instance_destroy();
		}
		instance_destroy();
		exit;
	}
	if (left_glove.hp < 25)
	{
		phase++;
		con = -1;
	}
	else
	{
		if (con == -1)
		{
			if (left_glove.con == -1)
			{
				con = 0;
				contimer = 0;
				first_glove = left_glove;
			}
			else if (right_glove.con == -1)
			{
				con = 0;
				contimer = 0;
				first_glove = right_glove;
			}
		}
		if (con == 0)
		{
			var second_glove = (first_glove == left_glove) ? right_glove : left_glove;
			if (contimer == 15)
			{
				first_glove.con = 100;
				first_glove.contimer = 0;
			}
			else if (contimer >= 75 && second_glove.con == -1)
			{
				second_glove.con = 100;
				second_glove.contimer = 0;
				con = -1;
			}
		}
		var _hp = min(left_glove.hp, right_glove.hp);
		left_glove.hp = _hp;
		right_glove.hp = _hp;
	}
}
else
{
	if (!instance_exists(left_glove) || !instance_exists(right_glove))
	{
		with (left_glove)
		{
			hit = 1;
			hp = 0;
			instance_destroy();
		}
		with (right_glove)
		{
			hit = 1;
			hp = 0;
			instance_destroy();
		}
		instance_destroy();
		exit;
	}
	if (con == -1)
	{
		if (left_glove.waiting == 2)
		{
			if (right_glove.waiting == 2)
			{
				con = 0;
				contimer = 0;
			}
		}
		else if (left_glove.con == -1)
		{
			if (left_glove.waiting == 0 && !left_glove.is_stunned)
			{
				left_glove.con = 110;
				left_glove.waiting = 1;
				left_glove.contimer = 0;
			}
		}
		if (right_glove.waiting == 2)
		{
			if (left_glove.waiting == 2)
			{
				con = 0;
				contimer = 0;
			}
		}
		else if (right_glove.con == -1)
		{
			if (right_glove.waiting == 0 && !right_glove.is_stunned)
			{
				right_glove.con = 110;
				right_glove.waiting = 1;
				right_glove.contimer = 0;
			}
		}
	}
	if (con == 0)
	{
		if (contimer >= 15 && !left_glove.is_stunned && !right_glove.is_stunned)
		{
			left_glove.con = 111;
			left_glove.contimer = 0;
			right_glove.con = 111;
			right_glove.contimer = 0;
			con = -2;
		}
	}
	if (left_glove.con != 150 && right_glove.con != 150)
	{
		var _hp = min(left_glove.hp, right_glove.hp);
		left_glove.hp = _hp;
		right_glove.hp = _hp;
	}
}
");

Apply("gml_Object_obj_plat_orangewall_Draw_0", @"var xx = x;
var plata = 0;
var platb = 1;
var yy = y + (40 * plata);
