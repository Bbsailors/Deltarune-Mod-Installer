					msgset_add(stringsetloc(""Those was for someone&SPECIAL... rrrggghhh!!/%"", ""obj_yellow_enemy_slash_Step_0_gml_378_0""), x - 20, y + 40, 10, 50, function()
					{
						idlesprite = spr_yellow_hat_down;
