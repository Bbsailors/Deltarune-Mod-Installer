get_preset(1);
scr_get_inputs(false);
defaultdepth = depth;
image_speed = 0.25 / global.fps_scale;

deactivate = function()
{
	restore_default_behavior();
	restore_animation();
	with (back_marker)
	{
		instance_destroy();
	}
	instance_destroy(self);
};

hspeedprev = 0;
reachedtarget = false;
followtarget = ""__nothing"";
followxoffset = 0;
followyoffset = 0;
autostop_when_reached = true;
reach_timeout = 180;
reach_timeout_timer = 0;

reached_target = function()
{
	if (followtarget == ""__nothing"")
	{
		exit;
	}
	var _FollowObject = -4;
	if (state == 1)
	{
		if (is_string(followtarget))
		{
			with (obj_plat_movemarker)
			{
				if (extflag == other.followtarget)
				{
					_FollowObject = self;
					break;
				}
			}
		}
		else if (instance_exists(followtarget))
		{
			_FollowObject = followtarget;
		}
	}
	reachedtarget = false;
	if (_FollowObject == -4)
	{
		return false;
	}
	var _follow_dist = 10;
	reach_timeout_timer += (1 / global.fps_scale);
	var reached = abs(x - (_FollowObject.x + followxoffset)) < _follow_dist || reach_timeout_timer >= reach_timeout;
	if (!autostop_when_reached)
	{
		reachedtarget = reached;
	}
	else
	{
		if (reached)
		{
			hspeed = 0;
			x -= (x - (_FollowObject.x + followxoffset));
		}
		reachedtarget = reached && abs(x - (_FollowObject.x + followxoffset)) < 1;
		if (reachedtarget)
		{
			followtarget = ""__nothing"";
		}
	}
	if (reachedtarget)
	{
		followxoffset = 0;
	}
	return reachedtarget;
};

shakex = 0;
shakey = 0;
shakeamt = 0;
shaketimer = 0;
shaketype = 0;
shaketime = 0;

draw_reflection = function(arg0, arg1, arg2)
{
	var xxx = x;
	var yyy = y;
	var hei = sprite_get_height(sprite_draw) * image_yscale;
	x -= arg0;
	y = (((y - arg1) + hei) - (sprite_offset_y * image_yscale)) + 40;
	shader_set_uniform_f(arg2, (yyy - arg1) + (20 * image_yscale));
	draw_sprite_ext(sprite_draw, sprite_image_index % sprite_get_number(sprite_draw), (x + shakex) - (sprite_offset_x * image_xscale), y - shakey, image_xscale, -image_yscale, image_angle, image_blend, image_alpha);
	x = xxx;
	y = yyy;
	return [0, hei - 40];
};
");

