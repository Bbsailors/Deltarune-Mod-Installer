stacky = 0;
backupstackx = 0;
backupstacky = 0;
green = -4;
rbeer = -4;
endwaitcustom = false;
mushnpc = -4;
shroomstack = [];
backupstack = [];
stackmaxsize = 50;
congaline = [];
addshroom = scr_shroomstack_addshroom;
fox_queue = [];

return_can_to_its_place = function(arg0)
{
	var applied_speed = point_distance(0, 0, player_speedx_average, player_speedy_average);
	var applied_direction = point_direction(0, 0, player_speedx_average, player_speedy_average) + 180;
	with (obj_dw_garden_shroomstack)
	{
		var stacklength = array_length(stack);
		if (stacklength > 1)
		{
			with (instance_create(obj_mainchara.x + (0.5 * obj_mainchara.sprite_width), obj_mainchara.y - 20, obj_marker))
			{
				sprite_index = spr_dogcar_hit;
				scr_darksize();
				scr_doom(self, 3);
				snd_play(snd_punchweak);
				snd_play(snd_fall);
			}
			other.foxcon = 1;
			other.foxtimer = 0;
			var order = [];
			for (var i = 0; i < stacklength; i++)
			{
				array_push(order, i);
			}
			for (var i = 1; i < stacklength; i++)
			{
				var throwidx = irandom(array_length(order) - 1);
				var throworder = order[throwidx];
				array_delete(order, throwidx, 1);
				var xdiff = clamp(x - xprevious, -6, 6);
				var ydiff = clamp((y - yprevious) / 2, -6, 6);
				stacksize = 14;
				xdist[i] = lerp(xdist[i], xdiff * (0.5 * i), 0.15);
				ydist[i] = lerp(ydist[i], ydiff * (0.5 * i), 0.15);
				var xloc = x - (sprite_get_width(stack[i]) / 2) - xdist[i];
				var yloc = (y - sprite_get_height(stack[i]) - (i * stacksize) - ydist[i]) + abs(xdist[i] / 5);
				var s = stack[i];
				var shroom = instance_create(xloc, yloc, obj_dw_garden_physicsshroom);
				shroom.fakeheight = yloc - obj_mainchara.bbox_bottom;
				shroom.destroy_on_overlap = true;
				shroom.y = obj_mainchara.bbox_bottom;
				shroom.direction = (180 + applied_direction + 30) - ((60 * throworder) / (stacklength - 1));
				shroom.speed = random_range((2 / global.fps_scale) + (applied_speed * 0.5), (2 / global.fps_scale) + (applied_speed * 0.5));
				shroom.rotation_speed = random_range(-25, 25);
			}
			stack = [stack[0]];
			break;
		}
	}
};

shroomtalked = 0;
npc_treasurebox = -4;
event_user(0);

pick_up_big_shroom = function(arg0)
{
	var targ = -4;
	with (obj_dw_garden_shroomstack)
	{
		if (mytarget == ""kris"")
		{
			targ = id;
		}
	}
	if (!i_ex(targ))
	{
		targ = instance_create(x, y, obj_dw_garden_shroomstack);
	}
	with (mushnpc)
	{
		visible = 0;
		marker.visible = 0;
	}
	targ.sizemax = 4;
	array_push(targ.stack, 956);
	array_push(targ.xdist, 0);
	array_push(targ.ydist, 0);
	array_push(targ.size, 0.1);
	snd_stop(snd_chomp);
	snd_play_pitch(snd_chomp, min(1.4 + (0.05 * array_length(targ.stack)), 2.7));
};
");

