Apply("gml_Object_obj_fallingbox_Step_0", @"if (instance_number(obj_heart) == 1)
{
	wait -= (1 / global.fps_scale);
	image_xscale = _xs;
	image_yscale = _ys;
	with (c_top)
	{
		x = other.x;
		y = (other.y - other._ys) + 2;
	}
	with (c_bot)
	{
		x = other.x;
		y = (other.y + other._ys) - 2;
	}
	fade = scr_approach(fade, 0, 0.05);
	if (x < 156)
	{
		_xs -= (abs(h_spd) / global.fps_scale);
