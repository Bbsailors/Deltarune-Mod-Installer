			point_torso = [point_center[0] + (cos(timer * 0.05) * 4) + lengthdir_x(12, 180), (point_center[1] - 25) + (sin(timer * 0.1) * 2) + lengthdir_y(4, 180)];
			var _shoulder_angle = attack_timer * 16;
			point_shoulder_right = [point_torso[0] + lengthdir_x(18, _shoulder_angle), point_torso[1] + lengthdir_y(18, _shoulder_angle)];
			point_shoulder_left = [point_torso[0] + lengthdir_x(18, 180 + _shoulder_angle), point_torso[1] + lengthdir_y(18, 180 + _shoulder_angle)];
			point_hand_right = [point_shoulder_right[0] + lengthdir_x(25, -40 + _shoulder_angle), point_shoulder_right[1] + lengthdir_y(25, -40 + _shoulder_angle)];
			point_hand_left = [point_shoulder_left[0] + lengthdir_x(25, 140 + _shoulder_angle), point_shoulder_left[1] + lengthdir_y(25, 140 + _shoulder_angle)];
			var _head_angle = 110 + (sin(timer * 0.05) * 10);
			point_head = [point_torso[0] + lengthdir_x(30, _head_angle), point_torso[1] + lengthdir_y(30, _head_angle)];
			var _angle = point_direction(point_center[0], point_center[1], point_foot_left[0], point_foot_left[1]);
			var _knee_angle = radtodeg(-arccos(clamp((point_distance(point_center[0], point_center[1], point_foot_left[0], point_foot_left[1]) * 0.5) / 45, -1, 1)));
			point_knee_left = [point_center[0] + lengthdir_x(45, _angle + _knee_angle), point_center[1] + lengthdir_y(45, _angle + _knee_angle)];
			_angle = point_direction(point_center[0], point_center[1], point_foot_right[0], point_foot_right[1]);
			_knee_angle = radtodeg(-arccos(clamp((point_distance(point_center[0], point_center[1], point_foot_right[0], point_foot_right[1]) * 0.5) / 45, -1, 1)));
			point_knee_right = [point_center[0] + lengthdir_x(45, _angle + _knee_angle), point_center[1] + lengthdir_y(45, _angle + _knee_angle)];
			point_foot_left = [(120 + lengthdir_x(90, 255)) - 40, 120 + lengthdir_y(90, 255)];
			point_foot_right = [120 + lengthdir_x(90, 285), 120 + lengthdir_y(90, 285)];
			if (attack_timer >= 12)
			{
				if (((_shoulder_angle - 40) % 360) >= 48 && throw_left)
				{
					throw_left = false;
					snd_play(motor_upper_2_bc);
					with (instance_create((x - 142) + point_hand_right[0], (y - 138) + point_hand_right[1], obj_bullet_ballperson))
					{
						scr_bullet_inherit_from(id, 962);
						image_speed = 0;
						hspeed = -(3 + (sin(random(1.5707963267948966)) * 7.5)) / global.fps_scale;
						vspeed = -8 / global.fps_scale;
						gravity_direction = 270;
						gravity = 0.4 / (global.fps_scale * global.fps_scale);
					}
				}
			}
			if (((_shoulder_angle - 40) % 360) < 48 && !throw_left)
			{
				throw_left = true;
			}
			if (attack_timer > 10 && (attack_timer % 2) == 0)
			{
				with (instance_create_depth((x - 142) + point_hand_right[0], (y - 138) + point_hand_right[1], depth - 1, obj_marker_fancy))
