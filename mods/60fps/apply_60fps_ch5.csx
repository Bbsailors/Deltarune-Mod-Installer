		if (instance_exists(arg0.custom_data[1]))
		{
			var diff = arg0.custom_data[1].x - arg0.x;
			arg0.x += lerp(0, diff, 1 - power(clamp(arg0.custom_data[0] - 4, 0, 10) / 10, 1 / global.fps_scale));
		}
		arg0.image_xscale -= 0.045454545454545456 / global.fps_scale;
		arg0.image_yscale -= 0.045454545454545456 / global.fps_scale;
