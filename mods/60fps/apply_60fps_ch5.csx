	if (shitimer == 30)
	{
		seth_bubble = scr_messagebubble(stringsetloc(""Great job,#Aqua!"", ""obj_dw_fcastle_ultradash_slash_Step_0_gml_131_0""), npc_seth.x + 20, npc_seth.y - 120, npc_seth, 50);
		seth_bubble.tx = npc_seth.x;
		seth_bubble.ty = npc_seth.y - 60;
		seth_bubble.dropColor = merge_color(c_purple, c_black, 0.25);
		seth_bubble.textbubbleColor = merge_color(c_purple, c_white, 0.75);
	}
	if (shitimer == 80)
	{
		shicon = 2;
		global.interact = 0;
		with (obj_plat_game)
		{
			paused = true;
		}
		if (!instance_exists(obj_mainchara))
		{
			with (obj_plat_player)
			{
				var mc = instance_create(x, y, obj_mainchara);
				mc.sprite_index = sprite_index;
				mc.image_index = image_index;
				mc.image_speed = 0;
				mc.cutscene = 1;
				mc.fun = 1;
				mc.depth = depth;
			}
		}
		with (obj_plat_player)
		{
			instance_destroy();
		}
		with (obj_plat_follower)
		{
