{
	image_alpha -= (0.5 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
		exit;
	}
}
if (global.pause_plat)
{
	if (_hspeed == -999)
	{
		_hspeed = hspeed;
		_vspeed = vspeed;
	}
	hspeed = 0;
	vspeed = 0;
	exit;
}
else if (_hspeed != -999)
{
	hspeed = _hspeed;
	vspeed = _vspeed;
	_hspeed = -999;
}
if (battlemode == 1)
{
	targetx = global.monsterx[target.myself];
	targety = global.monstery[target.myself];
}
else if (instance_exists(target))
{
	targetx = target.bbox_left + (0.5 * (target.bbox_right - target.bbox_left));
	targety = target.bbox_top + (0.5 * (target.bbox_bottom - target.bbox_top));
	if (!interim_target_reached)
	{
		targetx += interim_target_x;
		targety -= 60;
		if (i_ex(obj_dw_cliff_verticalwind))
		{
			targetx -= (2 * interim_target_x);
			targety += 220;
		}
	}
}
else
{
	targetx = x + (hspeed * 2);
	targety = y + (vspeed * 2);
}
cx = targetx;
cy = targety;
if (t == 0)
{
	direction = point_direction(x, y, cx, cy) - 20;
	speed = 24 / global.fps_scale;
	friction = -1.5 / (global.fps_scale * global.fps_scale);
	if (can_hit_player)
	{
		speed = 4 / global.fps_scale;
		friction = -0.5 / (global.fps_scale * global.fps_scale);
	}
	image_angle = direction;
	if (red == 1)
	{
		sprite_index = spr_rudebuster_beam_red;
		image_xscale = 2.5;
		image_yscale = 2.5;
	}
}
if (t >= 1 && explode == 0)
{
	if (!instance_exists(target) && !scr_onscreen_tolerance(self, 120))
	{
		instance_destroy();
		exit;
	}
	bolt_timer += (1 / global.fps_scale);
	dir = point_direction(x, y, cx, cy);
	var angdif = angle_difference(dir, direction) / max(4 - ((bolt_timer / 60) * 4), 1);
	if (can_hit_player)
	{
		angdif /= 3;
		if (x > obj_plat_player.x)
		{
			angdif *= 0.05;
		}
	}
	else if (bolt_timer > 30 && abs(angdif) > 90)
	{
		x = cx;
		y = cy;
	}
	if (!can_hit_player || t < 40)
	{
		direction += (angdif / global.fps_scale);
	}
	image_angle = direction;
	if (point_distance(x, y, cx, cy) <= 40)
	{
		if (interim_target_reached)
		{
			final_bolt = bolt_timer;
			visible = 0;
			explode = 1;
			with (instance_create(target.bbox_left + (0.5 * (target.bbox_right - target.bbox_left)), target.bbox_top + (0.5 * (target.bbox_bottom - target.bbox_top)), obj_plat_susieaxe_hbx))
			{
				owner = other.owner;
				interim_target_x = other.interim_target_x;
				image_xscale = 0.5;
				image_yscale = 0.5;
				if (other.can_hit_player && place_meeting(x, y, obj_plat_player))
				{
					var hs = sign(other.hspeed);
					with (obj_plat_player)
					{
						get_hurt(6, (hs * 6) / global.fps_scale, -3 / global.fps_scale, 50);
					}
				}
			}
		}
		else
		{
			interim_target_reached = true;
		}
		if (!explodes)
		{
			snd_play(snd_rudebuster_hit);
			instance_destroy();
			exit;
		}
		t = 1;
	}
}
if (explode == 1)
