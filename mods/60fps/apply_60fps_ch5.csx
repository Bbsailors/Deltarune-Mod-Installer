	image_yscale = 2;
}
if (downward)
{
	height -= (floor(_str) / global.fps_scale);
}
else
{
	height += (floor(_str) / global.fps_scale);
}
image_blend = merge_color(c_white, c_gray, clamp01(clamp01(-_yner) + (_ys_a / 2)));
distance += (0.25 / global.fps_scale);
scr_depth(undefined, -20);
if (has_owner && owner.ys[0] > 0.5)
{
	depth += 1300200;
}
siner += ((0.5 + (_str / 2)) / global.fps_scale);
cosiner += (1 / global.fps_scale);
lifetime -= (1 / global.fps_scale);
