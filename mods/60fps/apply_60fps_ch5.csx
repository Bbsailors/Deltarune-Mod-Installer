}
else if (stuckcon == 3)
{
	if (i_ex(obj_plat_player))
	{
		stuckcon = 0;
		with (obj_shadowplatformController)
		{
			scr_lerpvar(""plat_alpha"", 0.3, 1, 5);
			refresh_blocks = true;
		}
	}
}
if (signcon == 1)
{
	signcon = 2;
	scr_flag_set_ext(_ROOM_FLAG, _BIT_SIGNERY, 1);
