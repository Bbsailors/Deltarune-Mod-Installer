Apply("gml_Object_obj_npc_wrapper_Step_0", @"if (npc == -4)
{
	instance_destroy(self);
}
with (npc)
{
	if (con == 0)
	{
		if (myinteract == 3 && global.interact == 0 && !d_ex())
		{
			global.interact = 1;
			global.msc = -99;
			global.choice = -1;
			global.choicemsg[0] = stringset("""");
			global.choicemsg[1] = stringset("""");
			global.choicemsg[2] = stringset("""");
			global.choicemsg[3] = stringset("""");
			other.con = other.setdialogue(talked);
			if (other.con == -3)
			{
				other.con = 0;
				myinteract = 0;
				exit;
			}
			if (other.con == -2)
			{
				other.con = 0;
				myinteract = 0;
				talked++;
				exit;
			}
			if (other.con == -1)
			{
				other.con = 0;
				myinteract = 0;
				global.interact = 0;
				talked++;
				exit;
			}
			d_make(dialogue_side);
			myinteract = 100;
		}
		if (other.con == undefined)
		{
			other.con = 0;
		}
		if (myinteract == 100 && other.con == 0)
		{
			myinteract = 999;
			talked++;
		}
		if (myinteract == 999 && !d_ex())
		{
			myinteract = 0;
			global.interact = 0;
		}
	}
	if (other.alwaysanimate)
	{
		marker.image_index += other.animspeed / global.fps_scale;
	}
	else if (myinteract > 3 && d_ex())
	{
		var trig = 0;
		if (!i_ex(obj_writer))
		{
			trig = 1;
		}
		with (obj_writer)
		{
			if (halt)
			{
				trig = 1;
			}
		}
		if (array_length(other.anim_messages) > 0 && other.anim_messages[obj_writer.msgno] == false)
		{
			trig = 1;
		}
		if (!trig)
		{
			marker.image_index += other.animspeed / global.fps_scale;
		}
	}
}
step_function();
if (con > 0 && (global.choice != -1 || !d_ex()))
{
	k_d(1);
	global.choicemsg[0] = stringset("""");
	global.choicemsg[1] = stringset("""");
	global.choicemsg[2] = stringset("""");
	global.choicemsg[3] = stringset("""");
	global.msc = -99;
	with (npc)
	{
		other.con = other.choices[other.con - 1]();
	}
	global.choice = -1;
	if (con == undefined)
	{
		con = 0;
	}
	else
	{
		d_make(npc.dialogue_side);
	}
	if (con == 0)
	{
		with (npc)
		{
			myinteract = 999;
			talked++;
		}
	}
}
");

Apply("gml_Object_obj_ob_checkertile_Step_0", @"if (global.interact == 0)
{
	timer += (1 / global.fps_scale);
}
if (timer >= 0 && timer <= 10)
{
	image_alpha = timer / 10;
}
if (timer == 10)
{
	active = 1;
}
if (timer >= 20)
{
	image_alpha = 3 - (timer / 10);
	active = 0;
	if (image_alpha <= 0)
	{
		if (room == room_field_checkers1)
		{
			x -= (80 / global.fps_scale);
		}
		if (room == room_field_checkers4)
		{
			x -= (40 / global.fps_scale);
			y += (40 / global.fps_scale);
			if (y >= 350)
			{
				y = 240;
				x += (120 / global.fps_scale);
			}
		}
		if (room == room_field_checkers6)
		{
			x -= (40 / global.fps_scale);
			y += (40 / global.fps_scale);
			if (y >= 310)
			{
				y = 240;
				x += (80 / global.fps_scale);
			}
		}
		timer = -10;
		if (room == room_field_checkers6)
		{
			timer = -6;
		}
		if (room == room_field_checkers4)
		{
			timer = -4;
		}
		image_alpha = 0;
	}
}
if (x < 500)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_ob_gen_Draw_0", @"var bm = 0;
with (obj_mainchara)
{
	bm = battlemode;
}
with (obj_mainchara_dash)
{
	bm = battlemode;
}
if (bm == 1)
{
	if (battlealpha < 0.8)
	{
		battlealpha += (0.04 / global.fps_scale);
	}
}
else if (battlealpha > 0)
{
	battlealpha -= (0.04 / global.fps_scale);
}
draw_set_alpha(battlealpha);
draw_set_color(c_black);
draw_rectangle(__view_get(e__VW.XView, 0) - 100, __view_get(e__VW.YView, 0) - 100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
draw_set_alpha(1);
if (instance_exists(obj_caterpillarchara))
{
	obj_caterpillarchara.image_blend = merge_color(c_white, c_black, battlealpha / 2);
	if (battlealpha <= 0)
	{
		obj_caterpillarchara.image_blend = c_white;
	}
}
if (whitecon == 1)
{
	with (obj_mainchara)
	{
		battlemode = 0;
	}
	with (obj_mainchara_dash)
	{
		battlemode = 0;
	}
	whitetimer += (1 / global.fps_scale);
	draw_set_alpha(whitetimer / 15);
	draw_set_color(c_white);
	draw_rectangle(-100, -100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
	draw_set_alpha(1);
}
if (whitecon == 2)
{
	whitetimer -= (1 / global.fps_scale);
	draw_set_alpha(whitetimer / 15);
	draw_set_color(c_white);
	draw_rectangle(-100, -100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
	draw_set_alpha(1);
	if (whitetimer <= 0)
	{
		global.interact = 0;
		whitecon = 0;
		whitetimer = 0;
	}
}

enum e__VW
{
	XView,
	YView,
	WView,
	HView,
	Angle,
	HBorder,
	VBorder,
	HSpeed,
	VSpeed,
	Object,
	Visible,
	XPort,
	YPort,
	WPort,
	HPort,
	Camera,
	SurfaceID
}
");

Apply("gml_Object_obj_ob_gen_Step_0", @"if (room == 9999999999)
{
	if (timer >= 900)
	{
		instance_create(1202, 240, obj_ob_checkertile);
		instance_create(1242, 280, obj_ob_checkertile);
		instance_create(1282, 320, obj_ob_checkertile);
		instance_create(962, 240, obj_ob_checkertile);
		instance_create(1002, 280, obj_ob_checkertile);
		instance_create(1042, 320, obj_ob_checkertile);
		instance_create(722, 240, obj_ob_checkertile);
		instance_create(762, 280, obj_ob_checkertile);
		instance_create(802, 320, obj_ob_checkertile);
	}
	if (obj_mainchara.x >= 4000 && obj_mainchara.x <= 1620)
	{
		obj_mainchara.battlemode = 1;
	}
	else
	{
		obj_mainchara.battlemode = 0;
	}
	if (global.interact == 0)
	{
		timer += (1 / global.fps_scale);
	}
	if (timer >= 40)
	{
		timer = 0;
		ch = con * 40;
		instance_create(1442 - ch, 240 + ch, obj_ob_checkertile);
		con += 1;
		if (con > 2)
		{
			con = 0;
		}
	}
}
if (whitetimer >= 20 && whitecon == 1)
{
	xdiff = obj_mainchara.x - 340;
	obj_mainchara.x = 340;
	if (i_ex(global.cinstance[0]))
	{
		global.cinstance[0].x -= xdiff;
		for (i = 25; i >= 0; i -= 1)
		{
			global.cinstance[0].remx[i] -= xdiff;
		}
	}
	if (i_ex(global.cinstance[1]))
	{
		global.cinstance[1].x -= xdiff;
		for (i = 25; i >= 0; i -= 1)
		{
			global.cinstance[1].remx[i] -= xdiff;
		}
	}
	whitecon = 2;
}
if (room == 9999999999999)
{
	if (obj_mainchara.x >= 4000 && obj_mainchara.x <= 1620)
	{
		obj_mainchara.battlemode = 1;
	}
	else
	{
		obj_mainchara.battlemode = 0;
	}
}
");

