Apply("gml_Object_obj_purple_aim_attack_Create_0", @"depth = obj_growtangle.depth - 0.1;
image_xscale = 2;
image_yscale = 2;
grazepoints = 12;
state = ""idle"";
countdown = 0;
battle_data = ds_list_create();
my_scale1 = 2;
my_scale2 = 2;
anchor_x = x;
anchor_y = y;
alarm[0] = round(30 * global.fps_scale);

explode = function()
{
	countdown = 0;
	state = ""idle"";
	snd_play(snd_bomb);
	if (place_meeting(x, y, obj_heart))
	{
		with (obj_aqua_enemy)
		{
			phasehit = true;
		}
		if (target != 3)
		{
			scr_damage();
		}
		if (target == 3)
		{
			scr_damage_all();
		}
	}
	var _collision = false;
	with (obj_grazebox)
	{
		if (place_meeting(x, y, other.id))
		{
			_collision = true;
		}
	}
	var _grazetpfactor = 1;
	var _grazetimefactor = 1;
	with (obj_grazebox)
	{
		_grazetpfactor = grazetpfactor;
		_grazetimefactor = grazetimefactor;
	}
	if (_collision)
	{
		if (global.inv < 0)
		{
			scr_tensionheal(grazepoints * _grazetpfactor);
			global.turntimer -= _grazetimefactor;
			with (obj_battlecontroller)
			{
				grazenoise = 1;
			}
			with (obj_grazebox)
			{
				grazetimer = 10;
			}
		}
	}
	alarm[0] = round(25 * global.fps_scale);
	with (instance_create(x, y, obj_bulletparent))
	{
		sprite_index = spr_explosive_shockwave;
		scr_darksize();
		image_speed = 1 / global.fps_scale;
		scr_script_delayed(instance_destroy, 6);
	}
};
");

