Apply("gml_Object_obj_huge_anime_face_Step_0", @"event_inherited();
life_time += (1 / global.fps_scale);
switch (mode)
{
	case 0:
		switch (phase)
		{
			case -1:
				if (player_moved > 0 || life_time >= 50)
				{
					audio_play_sound(snd_rumble, 1, 1);
					life_time = 0;
					phase++;
				}
				break;
			case 0:
				var _y_goal = (scr_get_box(5) - 132) + 10;
				var _risespeed = 1.25;
				var _camerashift_x = 0;
				var _camerashift_y = 0;
				var _hastening = 1;
				if (player_moved > 0)
				{
					if (y > (_y_goal + 96))
					{
						_hastening = 8;
					}
					else if (y > (_y_goal + 80))
					{
						_hastening = 7;
					}
					else if (y > (_y_goal + 64))
					{
						_hastening = 6;
					}
					else if (y > (_y_goal + 48))
					{
						_hastening = 5;
					}
					else if (y > (_y_goal + 32))
					{
						_hastening = 4;
					}
					else if (y > (_y_goal + 16))
					{
						_hastening = 3;
					}
					else
					{
						_hastening = 2;
					}
				}
				var i = 0;
				repeat (_hastening)
				{
					if (i >= 1)
					{
						life_time += (1 / global.fps_scale);
					}
					if (life_time < 20)
					{
						_risespeed = 0.5;
					}
					else if (life_time < 30)
					{
						_risespeed = 2;
					}
					else if (life_time < 72)
					{
						_risespeed = 4;
					}
					else if (life_time < 77)
					{
						_risespeed = 2;
					}
					else
					{
						_risespeed = 1;
					}
					y -= (_risespeed / global.fps_scale);
					_camerashift_x = (0.1 * _risespeed) / global.fps_scale;
					_camerashift_y = (0.08 * _risespeed) / global.fps_scale;
					i++;
				}
				if ((global.time % global.fps_scale) == 0)
				{
					var _dust = instance_create_depth(x - random(156) - 16, camera_get_view_y(view_camera[0]) + 316 + (irandom(2) * 2), -24, obj_slidedust);
					_dust.sprite_index = spr_dust1;
					_dust.vspeed = choose(0, 0, 0, -0.625) / global.fps_scale;
				}
				x += _camerashift_x;
				with (obj_purplecontrols)
				{
					x += _camerashift_x;
					y += _camerashift_y;
					tire_y += _camerashift_y;
				}
				with (obj_purplebg)
				{
					bg_x += (_camerashift_x / 4);
					bg_y += (_camerashift_y / 4);
				}
				with (obj_growtangle)
				{
					x += _camerashift_x;
					y += _camerashift_y;
				}
				with (obj_heart)
				{
					x += _camerashift_x;
					y += _camerashift_y;
				}
				with (obj_pink_battlemovement)
				{
					x += _camerashift_x;
					y += _camerashift_y;
					dest_x += _camerashift_x;
				}
				if (y <= _y_goal)
				{
					snd_stop(snd_rumble);
					y = _y_goal;
					with (obj_purplecontrols)
					{
						x = floor(0.5 + x);
						y = floor(0.5 + y);
						tire_y = floor(0.5 + tire_y);
						can_move = true;
					}
					with (obj_growtangle)
					{
						x = floor(0.5 + x);
						y = floor(0.5 + y);
					}
					with (obj_heart)
					{
						x = floor(0.5 + x);
						y = floor(0.5 + y);
					}
					with (obj_pink_battlemovement)
					{
						x = floor(0.5 + x);
						y = floor(0.5 + y);
					}
					friction = 0;
					life_time = 0;
					phase++;
				}
				break;
			case 1:
				if (player_moved > 0 || life_time >= 30)
				{
					friction = 0;
					sprite_index = spr_pinkghost_angry;
					image_index = 0;
					life_time = 0;
					phase = 0;
					mode = 1;
				}
				break;
		}
		break;
	case 1:
		pattern_time++;
		var _camerashift_x = 0;
		var _cameragoal_x = camera_get_view_x(view_camera[0]) + 320;
		if (instance_exists(obj_growtangle))
		{
			_cameragoal_x = (bbox_right * 0.25) + ((scr_get_box(4) + 16) * 0.75);
		}
		_camerashift_x = clamp((camera_get_view_x(view_camera[0]) + 320) - _cameragoal_x, -4 / global.fps_scale, 4 / global.fps_scale);
		with (obj_bulletparent)
		{
			x += _camerashift_x;
		}
		with (obj_dokiheart)
		{
			x += _camerashift_x;
			xdraw += _camerashift_x;
		}
		with (obj_purplecontrols)
		{
			x += _camerashift_x;
		}
		with (obj_purplebg)
		{
			bg_x += (_camerashift_x / 4);
		}
		with (obj_growtangle)
		{
			x += _camerashift_x;
		}
		with (obj_heart)
		{
			x += _camerashift_x;
		}
		with (obj_pink_battlemovement)
		{
			x += _camerashift_x;
			dest_x += _camerashift_x;
		}
		x = clamp(x + (1.5 / global.fps_scale), camera_get_view_x(view_camera[0]) - 160, camera_get_view_x(view_camera[0]) + 640);
		var _aggroboost = 0;
		var _aggrothreshold = 25;
		var _keep_bump_momentum = false;
		var _speedmulti;
		if (bumps <= 0)
		{
			_speedmulti = 32;
		}
		else if (bumps < 2)
		{
			_speedmulti = 1.5;
			_keep_bump_momentum = true;
		}
		else if (bumps < 3)
		{
			_speedmulti = 4;
			_keep_bump_momentum = true;
		}
		else if (bumps < 4)
		{
			_speedmulti = 9;
			_keep_bump_momentum = true;
		}
		else
		{
			_speedmulti = 11;
		}
		if (bumps >= 5)
		{
			_keep_bump_momentum = false;
			if (bumps < 6)
			{
				_aggroboost = 0.12;
			}
			else if (bumps < 7)
			{
				_aggroboost = 0.12;
			}
			else
			{
				_aggroboost = 0.667;
				_aggrothreshold = 29;
				_speedmulti = -0.06;
				super = 1;
			}
		}
		if (_speedmulti <= 0)
		{
			hspeed += (_speedmulti / (global.fps_scale * global.fps_scale));
		}
		else if (hspeed < (2.5 / global.fps_scale))
		{
			hspeed += ((0.02 * _speedmulti) / (global.fps_scale * global.fps_scale));
		}
		else if (hspeed < (4 / global.fps_scale))
		{
			hspeed += ((0.01 * _speedmulti) / (global.fps_scale * global.fps_scale));
		}
		else
		{
			hspeed += ((0.002 * _speedmulti) / (global.fps_scale * global.fps_scale));
		}
		if (_aggroboost > 0)
		{
			if (bump_timer >= (_aggrothreshold - 10) && bumps >= 7)
			{
				var _x_edge = bbox_right;
				var _y_edge = bbox_bottom;
				sprite_index = spr_pinkghost_yell_full;
				x += (_x_edge - bbox_right);
				y += (_y_edge - bbox_bottom);
			}
			if (bump_timer >= _aggrothreshold)
			{
				hspeed += (_aggroboost / (global.fps_scale * global.fps_scale));
			}
		}
		var _jc_old = jump_cycle;
		jump_cycle += (10 * speed);
		if ((_jc_old < 180 && jump_cycle >= 180) || (_jc_old < 360 && jump_cycle >= 360))
		{
			snd_play(snd_impact_bc, 0.5, 0.5);
		}
		if (jump_cycle >= 360)
		{
			jump_cycle -= 360;
		}
		bump_timer += (1 / global.fps_scale);
		var _we_bumped = false;
		if (place_meeting(x - 32, y, obj_growtangle))
		{
			with (obj_purplecontrols)
			{
				if (iframes <= 0)
				{
					_we_bumped = true;
					event_user(0);
				}
			}
		}
		if (_we_bumped)
		{
			bumps++;
			bump_timer = 0;
			show_debug_message(""bumps: "" + string(bumps));
			snd_play(snd_pink_trip);
			snd_play(snd_impact);
			scr_shakescreen();
			if (!_keep_bump_momentum)
			{
				speed = speed / 2;
			}
			speed = max(1 / global.fps_scale, speed - (1 / global.fps_scale));
			with (obj_pinklanebullet)
			{
				if (friction > 0 || speed <= (1 / global.fps_scale))
				{
					friction = 0;
					gravity_direction = direction;
					speed = 3 / global.fps_scale;
					gravity = 2 / (global.fps_scale * global.fps_scale);
				}
			}
			if (bumps < 7)
			{
				var _x_edge = bbox_right;
				image_xscale = -image_xscale;
				x += (_x_edge - bbox_right);
			}
			else if (bumps == 7)
			{
				var _x_edge = bbox_right;
				var _y_edge = bbox_bottom;
				image_xscale = -abs(image_xscale);
				sprite_index = spr_pinkghost_shock_full;
				x += (_x_edge - bbox_right);
				y += (_y_edge - bbox_bottom);
			}
			if (super >= 1)
			{
				with (obj_shake)
				{
					shakex = 8;
					shakey = 8;
				}
			}
			attacked = 0;
			pattern_time = 0;
		}
		break;
}
");

Apply("gml_Object_obj_hypnofx_Draw_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
	initsiner = random(400);
	for (i = 0; i < ringmax; i += 1)
	{
		ringsize[i] = 1 + (0.5 * i);
		ringradius[i] = 2 + (i * 12);
		ringspeed[i] = 0.3;
		ringalpha[i] = 0;
		ringsiner[i] = initsiner;
	}
}
if (timer >= 2)
{
	for (i = 0; i < ringmax; i += 1)
	{
		ringsiner[i] += ((i + 2) * ringalpha[i]) / global.fps_scale;
		if (timer < 12 && ringalpha[i] < 1)
		{
			ringalpha[i] += 0.2 / global.fps_scale;
		}
		if (timer >= 24)
		{
			ringalpha[i] -= 0.1 / global.fps_scale;
		}
		draw_sprite_ext(spr_hypnoring, 0, x + (sin(ringsiner[i] / 12) * ringradius[i]), y + (cos(ringsiner[i] / 12) * ringradius[i]), ringsize[i], ringsize[i], 0, c_white, ringalpha[i]);
	}
	if (timer >= 38)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_icespell_Draw_0", @"timer += (1 / global.fps_scale);
if (timer == 1)
{
	snd_play(snd_icespell);
}
if (timer == 1)
{
	hex[0] = instance_create(x - 25, y - 20, obj_icespell_hexagon);
}
if (timer == 4)
{
	hex[1] = instance_create(x + 25, y - 20, obj_icespell_hexagon);
}
if (timer == 7)
{
	hex[2] = instance_create(x, y + 20, obj_icespell_hexagon);
}
if (timer == 10)
{
	for (i = 0; i < 3; i++)
	{
		with (hex[i])
		{
			for (j = 0; j < 6; j++)
			{
				hexhex[j] = instance_create(x, y, obj_icespell_hexagon);
				hexhex[j].image_xscale = 0.75;
				hexhex[j].image_yscale = 0.75;
				hexhex[j].con = 1;
				hexhex[j].direction = 60 * j;
				hexhex[j].speed = 8 / global.fps_scale;
				hexhex[j].friction = 0.2 / (global.fps_scale * global.fps_scale);
			}
		}
	}
}
if (timer == 11)
{
	with (hex[0])
	{
		instance_destroy();
	}
	with (hex[1])
	{
		instance_destroy();
	}
	with (hex[2])
	{
		instance_destroy();
	}
}
if (timer == 15)
{
	if (global.fighting == 1)
	{
		global.hittarget[star] = 0;
		if (damage >= global.monsterhp[star])
		{
			if (i_ex(global.monsterinstance[star]))
			{
				if (global.monsterinstance[star].freezable == 1)
				{
					global.flag[51 + star] = 6;
				}
			}
		}
		scr_damage_enemy(star, damage);
		if (global.monster[star] == 1)
		{
			with (target)
			{
				__of = scr_oflash();
			}
		}
	}
}
if (timer >= 10 && timer <= 30)
{
	draw_set_alpha(2.2 - (timer / 10));
	draw_set_color(c_white);
	draw_circle(x, y, 60 - (timer * 6), true);
	draw_circle(x, y, 61 - (timer * 6), true);
	draw_circle(x, y, 62 - (timer * 6), true);
	draw_set_alpha(1);
}
if (timer == 60)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_icespell_hexagon_Step_0", @"if (con == 1)
{
	image_angle += ((rotspeed * 2) / global.fps_scale);
	direction += ((rotspeed * 3) / global.fps_scale);
	timer += (1 / global.fps_scale);
	if (timer >= 10)
	{
		image_alpha -= (0.1 / global.fps_scale);
	}
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_intro_ch2_Draw_0", @"if (show_queen)
{
	if (queen_animate)
	{
		queen_siner += (1 / global.fps_scale);
		queen_sprite_index = queen_siner / 3;
	}
	else
	{
		queen_sprite_index = 0;
	}
	draw_sprite_ext(queen_sprite, queen_sprite_index, view_wport[0] / 4, queen_y_pos, 1, 1, 0, c_white, queen_alpha);
}
else
{
	if (init == 0 && con == 1)
	{
		logopieces = 0;
		init = 1;
		for (i = 0; i < 9; i++)
		{
			drawlogopart[i] = 0;
		}
		con = 2;
		logotimer = 0;
	}
	if (con == 2)
	{
		logotimer += (1 / global.fps_scale);
		if ((logotimer % 8) == 0 && logotimer < 80)
		{
			snd_play_x(snd_noise, 0.8, 0.5 + random(1));
			if (logopieces == 0)
			{
				drawlogopart[0] = 1;
			}
			if (logopieces == 1)
			{
				drawlogopart[8] = 1;
			}
			if (logopieces == 2)
			{
				drawlogopart[1] = 1;
			}
			if (logopieces == 3)
			{
				drawlogopart[7] = 1;
			}
			if (logopieces == 4)
			{
				drawlogopart[2] = 1;
			}
			if (logopieces == 5)
			{
				drawlogopart[6] = 1;
			}
			if (logopieces == 6)
			{
				drawlogopart[3] = 1;
			}
			if (logopieces == 7)
			{
				drawlogopart[5] = 1;
			}
			if (logopieces == 8)
			{
				drawlogopart[4] = 1;
			}
			logopieces++;
		}
		for (i = 0; i < 9; i++)
		{
			if (drawlogopart[i] == 1)
			{
				draw_sprite_ext(IMAGE_LOGO_CENTER_SEPARATE, i, 160, 100, 1, 1, 0, c_white, 1);
			}
		}
		if (logotimer == 120)
		{
			snd_play(snd_queen_laugh_title);
		}
		if (logotimer >= 120)
		{
			draw_set_font(fnt_mainbig);
			draw_set_color(c_white);
			draw_text_ext(105, 120, ""CHAPTER 2"", 10, 900);
			scr_84_set_draw_font(""mainbig"");
		}
		if (logotimer >= 240)
		{
			room_goto(PLACE_MENU);
		}
	}
}
");

Apply("gml_Object_obj_intro_ch2_Step_0", @"if (con == 0)
{
	if (!files_exist)
	{
		timer += (1 / global.fps_scale);
		if (timer == 75)
		{
			con = 1;
		}
	}
	else
	{
		if (!show_queen)
		{
			show_queen = true;
		}
		if (show_queen)
		{
			timer += (1 / global.fps_scale);
			if (timer == 30)
			{
				queen_sprite = spr_queen_wireframe_rotate;
				scr_lerpvar(""queen_y_pos"", -150, view_hport[0] / 4, 15, -1, ""out"");
				scr_lerpvar(""queen_alpha"", 0, 1, 10);
			}
			if (timer == 50)
			{
				queen_sprite = spr_queen_wireframe;
				queen_animate = false;
			}
			if (timer == 80)
			{
				queen_sprite = spr_queen_wireframe_laugh;
				queen_animate = true;
				snd_play(snd_queen_bitcrushlaugh);
			}
			if (timer == 130)
			{
				snd_play(snd_explosion_mmx3);
				queen_sprite = spr_queen_wireframe_explode;
			}
			if (timer == 170)
			{
				scr_lerpvar(""queen_alpha"", 1, 0, 10);
			}
			if (timer == 200)
			{
				con = 99;
				room_goto(PLACE_MENU);
			}
		}
	}
}
");

Apply("gml_Object_obj_intro_ch4_Step_0", @"if (bgm != -1)
{
	bgm_pos = audio_sound_get_track_position(bgm);
}
if (!files_exist && !debug_force_nofiles)
{
	if (con == 0)
	{
		con = 1;
		bgm = mus_play(snd_init(""ch4_first_intro.ogg""));
		scr_lerp_instance_var(logo_heart, ""image_alpha"", 0, 1, 120);
	}
	if (con == 1)
	{
		if (bgm_pos >= 4)
		{
			con = 2;
		}
	}
	if (con == 2)
	{
		con = 3;
		scr_lerp_instance_var(logo_all, ""image_alpha"", 0, 1, 90);
	}
	if (con == 3)
	{
		if (bgm_pos >= 7.5)
		{
			con = 4;
			scr_lerp_instance_var(prophecy_effect, ""image_alpha"", 0, 1, 70);
		}
	}
	if (con == 4)
	{
		if (bgm_pos >= 8)
		{
			con = 5;
			scr_lerp_instance_var(id, ""chapter4_text_alpha"", 0, 1, 90);
		}
	}
	if (con == 5)
	{
		if (bgm_pos >= 15)
		{
			con = 6;
			scr_lerp_instance_var(prophecy_effect, ""scroll_speed"", prophecy_effect_scroll_speed, 0, 60);
		}
	}
	if (con == 6)
	{
		if (bgm_pos == 0)
		{
			con = 7;
			timer = 0;
		}
	}
	if (con == 7)
	{
		con = 8;
		timer = 0;
		with (prophecy_effect)
		{
			image_alpha = 0;
		}
		with (logo_all)
		{
			sprite_index = IMAGE_LOGO_CENTER_SHATTER;
		}
		chapter4_text_alpha = 0;
		var _delay_sound_time = 20;
		var snd = snd_play_complex(0, 0, undefined);
		snd_add_complex(snd, 4, 430, 1, 0.95, 0, -1, 0);
		snd_add_complex(snd, 0, 341, 0.6, 0.4, (_delay_sound_time - 1) + 2, -1, 0);
		snd_add_complex(snd, 3, 372, 0.7, 0.95, (_delay_sound_time - 1) + 0, -1, 0);
		snd_play_delay(break_noise, _delay_sound_time, 0.5, 1);
		snd_play_delay(break_noise, _delay_sound_time, 0.5, 0.94);
		var _shattersprite = IMAGE_LOGO_CENTER_SHATTER_PIECES;
		var _fragments = sprite_get_number(_shattersprite);
		var _delay = 20;
		for (var i = 0; i < _fragments; i++)
		{
			with (scr_marker_ext(room_center_x, room_center_y, _shattersprite, 2, 2, undefined, i, undefined, 19800))
			{
				direction = random(360);
				scr_delay_var(""gravity"", (0.4 + random(0.12)) / (global.fps_scale * global.fps_scale), _delay);
				scr_delay_var(""friction"", 0, _delay);
				scr_delay_var(""speed"", 4 / global.fps_scale, _delay);
				scr_doom(id, 120);
			}
		}
		with (logo_all)
		{
			instance_destroy();
		}
	}
	if (con == 8)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 20)
		{
			timer = 0;
			con = 9;
			var sparklecount = 15;
			for (var i = 0; i < sparklecount; i++)
			{
				with (instance_create((room_center_x - 199) + ((i * 398) / sparklecount) + random_range(-30, 30), room_center_y + random(60), obj_dw_church_prophecy_groundshards))
				{
					ytarg = 10000;
					scr_doom(self, 280);
				}
			}
		}
	}
	if (con == 9)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 45)
		{
			timer = 0;
			con = 10;
			scr_lerp_instance_var(logo_heart, ""image_alpha"", 1, 0, 120);
		}
	}
	if (con == 10)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 120)
		{
			timer = 0;
			con = 99;
		}
	}
}
else
{
	skip_safety++;
	if (con == 0)
	{
		con = 0.5;
		timer = 0;
		black_all.visible = true;
		black_all.image_alpha = 0;
		prophecy_effect.tile_object = logo_prophecy;
		with (prophecy_effect)
		{
			image_alpha = 1;
		}
		with (logo_prophecy)
		{
			image_alpha = 1;
		}
	}
	if (button1_p() && con < 3 && skip_safety > 3)
	{
		scr_lerp_instance_var(black_all, ""image_alpha"", black_all.image_alpha, 1, skip_time);
		alarm[0] = skip_time;
	}
	if (con == 0.5)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 75)
		{
			con = 1;
			timer -= (1 / global.fps_scale);
			scr_lerp_instance_var(prophecy_effect, ""scroll_speed"", prophecy_effect_scroll_speed, 0, 52);
		}
	}
	if (con == 1)
	{
		timer += (1 / global.fps_scale);
		if (timer > 135)
		{
			con = 2;
			timer = 0;
			with (logo_prophecy)
			{
				image_alpha = 0;
			}
			var _delay_sound_time = 20;
			var snd = snd_play_complex(0, 0, undefined);
			snd_add_complex(snd, 4, 430, 1, 0.95, 0, -1, 0);
			snd_add_complex(snd, 0, 341, 0.6, 0.4, (_delay_sound_time - 1) + 2, -1, 0);
			snd_add_complex(snd, 3, 372, 0.7, 0.95, (_delay_sound_time - 1) + 0, -1, 0);
			snd_play_delay(break_noise, _delay_sound_time, 0.5, 0.5);
			snd_play_delay(break_noise, _delay_sound_time, 0.5, 0.44);
			var _shattersprite = spr_intro_prophecy_shatter;
			var _fragments = sprite_get_number(_shattersprite);
			var _delay = 20;
			for (var i = 0; i < _fragments; i++)
			{
				with (scr_marker_ext(logo_prophecy.x, logo_prophecy.y, _shattersprite, 2, 2, undefined, i, undefined, 19800))
				{
					direction = random(360);
					scr_delay_var(""gravity"", (0.4 + random(0.12)) / (global.fps_scale * global.fps_scale), _delay);
					scr_delay_var(""friction"", 0, _delay);
					scr_delay_var(""speed"", 4 / global.fps_scale, _delay);
					scr_doom(id, 120);
				}
			}
		}
	}
	if (con == 2)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 20)
		{
			timer = 0;
			con = 4;
			var sparklecount = 15;
			for (var i = 0; i < sparklecount; i++)
			{
				var _width = 90;
				var _xx = (room_center_x - _width) + (i * ((_width * 2) / sparklecount)) + random_range(-30, 30);
				var _yy = room_center_y + random(70);
				if (i == 0)
				{
					_xx = room_center_x - _width;
				}
				if (i == (sparklecount - 1))
				{
					_xx = room_center_x + _width;
				}
				with (instance_create(_xx, _yy, obj_dw_church_prophecy_groundshards))
				{
					ytarg = 10000;
					scr_doom(self, 280);
				}
			}
		}
	}
	if (con == 3)
	{
		con = 5;
		timer = 0;
		scr_lerp_instance_var(black_all, ""image_alpha"", black_all.image_alpha, 1, skip_time);
	}
	if (con == 4)
	{
		timer += (1 / global.fps_scale);
		if (timer >= 120)
		{
			timer = 0;
			con = 99;
		}
	}
	if (con == 5)
	{
		timer += (1 / global.fps_scale);
		if (timer > skip_time)
		{
			timer = 0;
			con = 99;
		}
	}
}
if (con == 99)
{
	room_goto(PLACE_MENU);
}
");

Apply("gml_Object_obj_intro_ch5_Create_0", @"turnofflayers(""DEBUG"");
if (scr_is_switch_os())
{
	instance_create_depth(0, 0, 0, obj_switchAsyncHelper);
}
con = 0;
timer = 0;
bgm = -1;
bgmPos = 0;
debug_force_nofiles = false;
skip_time = 10;
skip_safety = 0;
snd_free_all();
