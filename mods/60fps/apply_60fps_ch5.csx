			texture_set_interpolation(false);
		}
		var _trim = ceil(_s);
		draw_set_color(c_black);
		draw_rectangle((_xx + _dispw) - _trim, 0, _ww, _wh, false);
		draw_rectangle(0, (_yy + _disph) - _trim, _ww, _wh, false);
		draw_set_color(c_white);
		draw_enable_alphablend(true);
