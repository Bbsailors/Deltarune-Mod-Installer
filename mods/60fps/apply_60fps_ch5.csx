		{
			show_debug_message_concat(""aquaseth already fought count: "", global.tempflag[tempflag_index]);
		}
	}
	if (!battlesetup && i_ex(obj_battlecontroller))
	{
		with (obj_actor)
		{
			visible = false;
		}
		battlesetup = true;
		for (var i = 0; i < array_length(knives); i++)
		{
			with (knives[i])
			{
				instance_destroy();
			}
		}
	}
	timer += (1 / global.fps_scale);
	if (timer > 45 && !i_ex(obj_battlecontroller))
	{
		timer = 0;
		con = 3.1;
	}
}
if (con == 3.1)
