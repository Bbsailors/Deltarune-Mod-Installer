	exit;
}
if (scatter_on_hit)
{
	snd_play(snd_punchmed);
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_hit_vfx;
		image_speed = 1;
	}
	with (instance_create_depth(x, y, depth, obj_plat_vfx))
	{
		sprite_index = spr_smokepuff;
		image_speed = 2;
	}
	for (var i = 0; i < 2; i++)
	{
		var xx = x;
		var yy = y + (40 * i);
		var paperscraps = instance_create_depth(xx, yy, depth - 3, obj_marker_fancy);
		with (paperscraps)
		{
			sprite_index = choose(spr_plat_paperscraps_1, spr_plat_paperscraps_2, spr_plat_paperscraps_3, spr_plat_paperscraps_4, spr_plat_paperscraps_5);
			image_speed = random_range(0.2, 0.25) / global.fps_scale;
			scr_darksize();
			timer = 0;
			swaydirection = (i * 2) - 1;
			hspeed = (10 * swaydirection) / global.fps_scale;
			vspeed = random_range(-3, 3) / global.fps_scale;
			
			step_func = function()
			{
				if (!global.pause_plat)
				{
					timer += (1 / global.fps_scale);
					hspeed = lerp(hspeed, (sin(timer * 0.1) * swaydirection * 4) / global.fps_scale, scr_fps_lerp_rate(0.1));
					hspeed *= power(0.99, 1 / global.fps_scale);
					if (abs(hspeed) < (3 / global.fps_scale))
					{
						vspeed = max(vspeed - (0.1 / (global.fps_scale * global.fps_scale)), 3 / global.fps_scale);
					}
					else
					{
						vspeed = min(vspeed + (0.1 / (global.fps_scale * global.fps_scale)), 6 / global.fps_scale);
					}
				}
			};
			
			var doomtime = 90;
			scr_lerpvar(""image_alpha"", 12, 0, doomtime);
			scr_doom(self, doomtime);
		}
	}
	broken = true;
}
hit_cooldown = 1;
image_speed = 1 / global.fps_scale;
spin_cooldown = 80;
rope_active = true;
on_hit(true);
var dir = point_direction(obj_plat_player.x, obj_plat_player.y, x, y);
add_force(lengthdir_x(3, dir), 0);
");

