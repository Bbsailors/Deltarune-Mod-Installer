Apply("gml_Object_obj_yellow_trial_manager_Step_0", @"if (evidence_mode)
{
	if (right_p())
	{
		if (evidence_counter < (ds_list_size(evidence_list) - 1))
		{
			snd_play(snd_menumove);
		}
		evidence_counter = scr_approach(evidence_counter, ds_list_size(evidence_list) - 1, global.fps_scale);
	}
	if (left_p())
	{
		if (evidence_counter > 0)
		{
			snd_play(snd_menumove);
		}
		evidence_counter = scr_approach(evidence_counter, 0, global.fps_scale);
	}
	if (button2_p() && can_cancel)
	{
		snd_play(snd_cantselect);
		evidence_mode = false;
		with (obj_battleblcon)
		{
			blcon_default_color = 16777215;
		}
	}
	if (evidence_mode)
	{
		if (button1_p() == 1)
		{
			can_control = false;
			evidence_mode = false;
			if (array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == 7)
			{
				dog_special();
			}
			else if (current_perp.perp_index == trial_array[trial_id].culprit)
			{
				var case_compare = false;
				if (array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == trial_id || (trial_id == 99 && array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == 10))
				{
					snd_play(snd_select);
					right_accusation();
				}
				else
				{
					cstate = 1;
					wrong_accusation();
				}
			}
			else if (array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == trial_id)
			{
				cstate = 0;
				wrong_accusation();
			}
			else
			{
				cstate = 2;
				wrong_accusation();
			}
		}
	}
}
smooth_counter = scr_approach(smooth_counter, evidence_counter, 0.35);
if (current_perp != -1 && can_control && !evidence_mode)
{
	if (right_p())
	{
		perp_list_id++;
		if (perp_list_id >= ds_list_size(perp_list))
		{
			perp_list_id = 0;
		}
		current_perp = ds_list_find_value(perp_list, perp_list_id);
		snd_play(snd_menumove);
		with (obj_trial_perp)
		{
			active = false;
			perp_reset();
		}
		scr_destroy_writers(""text_immune"");
		with (current_perp)
		{
			active = true;
			testimony_balloon();
		}
	}
	if (left_p())
	{
		perp_list_id--;
		if (perp_list_id == -1)
		{
			perp_list_id = ds_list_size(perp_list) - 1;
		}
		current_perp = ds_list_find_value(perp_list, perp_list_id);
		snd_play(snd_menumove);
		with (obj_trial_perp)
		{
			active = false;
			perp_reset();
		}
		scr_destroy_writers(""text_immune"");
		with (current_perp)
		{
			active = true;
			testimony_balloon();
		}
	}
	if (button1_p() == 1)
	{
		snd_play(snd_select);
		evidence_mode = true;
		evidence_choice = true;
		with (obj_battleblcon)
		{
			blcon_default_color = 4210752;
		}
	}
}
with (obj_blue_enemy)
{
	if (talked == 1)
	{
		blue_balloon_control();
	}
}
");

Apply("gml_Object_obj_yourlong_Draw_0", @"var jp = variable_global_exists(""lang"") && global.lang == ""ja"";
timer += (1 / global.fps_scale);
var str;
if (jp)
{
	if (timer < 10)
	{
		str = ""ãƒŠ"";
	}
	else if (alt)
	{
		str = ""ãƒŠ           ã‚¬ ãƒƒ"";
	}
	else
	{
		str = ""ãƒŠã€€ã‚¬           ã‚¤"";
	}
}
else if (alt)
{
	str = stringsetloc(""LO          NG"", ""obj_yourlong_slash_Draw_0_gml_20_0"");
}
else
{
	str = stringsetloc(""YOUR          LONG"", ""obj_yourlong_slash_Draw_0_gml_22_0"");
}
draw_set_alpha(1);
draw_set_color(c_white);
if (jp)
{
	draw_set_font(fnt_ja_mainbig);
}
else
{
	draw_set_font(fnt_mainbig);
}
var t = 20;
var num = 1 + ((3 - jp) * (timer > (t - (25 * alt))));
for (var pos = 1; pos <= ceil(string_length(str) / (1 + (timer < (t - (25 * alt))))); pos++)
{
	draw_text(x + irandom_range(-num, num) + (15 * pos) + (28 * alt), y + irandom_range(-num, num), string_char_at(str, pos));
}
if (timer > (55 - (30 * alt)))
{
	instance_destroy();
}
");

