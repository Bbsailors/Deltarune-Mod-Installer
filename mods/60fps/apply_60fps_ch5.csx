Apply("gml_Object_obj_dw_fcastle_seth_encounter_Create_0", @"scr_musicer(""castle_top.ogg"", 1);
con = 0;
timer = 0;
init = 0;
siner = 0;
roomphase = 0;
battlemarker = -4;
masterbeet = -4;
beets = [];
turnofflayers(""CUT"");
turnofflayers(""DEBUG"");
encounterno = 203;
encounterflag = 1482;
phase = 0;
if (global.plot < 449)
{
	global.plot = 449;
}
if (global.plot >= 450)
{
	phase = 1;
}
if (phase == 1)
{
	con = 100;
}
var shino1 = findsprite(spr_shinobeetle_pose, ""DEBUG_ASSETS"", #FFFF96);
var shino2 = findsprite(spr_shinobeetle_pose, ""DEBUG_ASSETS"", #96FFFF);
var locs = [shino1, shino2];
turnofflayers(""SETH_POINTS"");
sethpoints = findspriteinfo_all(4554, ""SETH_POINTS"");

sortByX = function(arg0, arg1)
{
	return arg0.x - arg1.x;
};

array_sort(sethpoints, sortByX);
seth = -4;
shinos = [];
if (global.flag[encounterflag] != 1)
{
	for (var i = 0; i < array_length(locs); i++)
	{
		shino = scr_marker_fromasset(locs[i], undefined, true, true);
		with (shino)
		{
			encounterno = other.encounterno;
			encounterflag = other.encounterflag;
			memsprite = sprite_index;
			image_blend = c_white;
			acttrig = ""shino"" + string(i + 1) + ""activate"";
			activearea = ""shino"" + string(i + 1);
			special = false;
			if (other.phase == 0)
			{
				special = true;
			}
			con = 0;
			timer = 0;
			image_alpha = 0;
			
			step_func = function()
			{
				if (con == 0)
				{
					if (scr_trigcheck(acttrig))
					{
						con = 1;
						timer = 0;
						x = xstart;
						y = ystart;
					}
				}
				if (con == 1)
				{
					timer += (1 / global.fps_scale);
					if (timer == 1)
					{
						snd_stop(snd_wing);
						snd_play(snd_wing);
						snd_play(snd_japanese_yo_hit1, 0.5);
						with (instance_create(x - 40, y - 10, obj_animation))
						{
							sprite_index = spr_poof;
							image_xscale = 2;
							image_yscale = 2;
							image_speed = 0.5 / global.fps_scale;
							depth = other.depth - 1;
						}
					}
					if (timer == 4)
					{
						sprite_index = memsprite;
						image_alpha = 1;
					}
					if (timer == 15)
					{
						snd_play(snd_wing, 0.8, 2);
						sprite_index = spr_shinobeetle_flutter;
						image_speed = 0.5 / global.fps_scale;
						con = 1.5;
						timer = 0;
					}
				}
				if (con == 1.5)
				{
					var targ = 
					{
						x: obj_mainchara.x - 26,
						y: obj_mainchara.y - 56
					};
					var dir = point_direction(xstart, ystart, targ.x, targ.y);
					var dist = point_distance(xstart, ystart, targ.x, targ.y);
					targx = xstart + lengthdir_x(min(dist, 160), dir);
					targy = ystart + lengthdir_y(min(dist, 160), dir);
					if (targy < (ystart + 80))
					{
						targy = ystart + 80;
					}
					grav = 1.5 / (global.fps_scale * global.fps_scale);
					vsp = -14 / global.fps_scale;
					movewait = scr_returnwait_gravity(id, y, targy, grav, vsp) + 1;
					con = 2;
				}
				if (con == 2)
				{
