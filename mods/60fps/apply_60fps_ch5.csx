Apply("gml_Object_obj_garden_diner_flas_Step_0", @"fljump = function()
{
	with (fl)
	{
		var determinewait = function()
		{
			var targy = obj_garden_diner_flas.y - 30;
			var wait = scr_returnwait_gravity(id, y, targy, gravity, vspeed) / global.fps_scale;
			scr_delay_var(""gravity"", 0, wait - 1);
			scr_delay_var(""vspeed"", 0, wait - 1);
			scr_delay_var(""y"", targy, wait - 1);
		};
		
		sprite_index = spr_flowery_jump_right;
		setxy(x - 8, y - 2);
		vspeed = -18 / global.fps_scale;
		gravity = 2 / (global.fps_scale * global.fps_scale);
		delay_function(determinewait, 5);
		var themath = 15;
		scr_lerpvar(""x"", x, xstart + 2, themath - 1);
		scr_delay_var(""sprite_index"", 5745, themath + 1);
		scr_delay_var(""depth"", obj_garden_diner_flas.mg.depth - 1, round(themath / 2));
		snd_play_delay(snd_noise, themath, 0.5, 1.4);
	}
};

flgetorange = function()
{
	with (fl)
	{
		sprite_index = spr_flowery_diner_remove_orange_glass;
		image_index = 0;
		image_speed = 0;
		x = xstart + 2;
		y = ystart - 30;
		depth = obj_garden_diner_flas.mg.depth - 1;
		scr_lerpvar(""image_index"", 0, 5, 12);
	}
};

flcrackorange = function()
{
	with (fl)
	{
		juicetoss = function()
		{
			with (obj_garden_diner_flas)
			{
				setxy(fl.x + 10, fl.y + 28, juice);
				with (juice)
				{
					depth = obj_garden_diner_flas.as.depth + 1;
					visible = true;
					vspeed = -18 / global.fps_scale;
					gravity = 1.25 / (global.fps_scale * global.fps_scale);
					
					endspot = function()
					{
						snd_play(snd_noise);
						gravity = 0;
						vspeed = 0;
						setxy(xstart + 30, ystart + 78);
						with (scr_marker_ext((x + 4) - 2, y, spr_pxwhite, 2, 2, undefined, undefined, #F79700, depth - 1))
						{
							gravity = 1 / (global.fps_scale * global.fps_scale);
							vspeed = -4 / global.fps_scale;
							scr_doom(id, 6);
						}
						with (scr_marker_ext(x + 4 + 2, y, spr_pxwhite, 2, 2, undefined, undefined, #F79700, depth - 1))
						{
							gravity = 1.25 / (global.fps_scale * global.fps_scale);
							vspeed = -5 / global.fps_scale;
							scr_doom(id, 5);
						}
					};
					
					var waittime = scr_returnwait_gravity(undefined, undefined, ystart + 78) / global.fps_scale;
					scr_lerpvar(""x"", x, xstart + 30, waittime - 1);
					delay_function(endspot, waittime - 1);
				}
			}
		};
		
		sprite_index = spr_flowery_diner_pour_orange_toss;
		image_index = 0;
		image_speed = 0;
		x = xstart + 2;
		y = ystart - 30;
		depth = obj_garden_diner_flas.mg.depth - 1;
		obj_garden_diner_flas.juice.visible = false;
		var count = 1;
		var delay = 0;
		delay += 6;
		scr_delay_var(""image_index"", 1, delay);
		delay += 3;
		scr_delay_var(""image_index"", 2, delay);
		snd_play_delay(snd_noise, delay, 0.6, 1.2);
		delay += 3;
		scr_delay_var(""image_index"", 3, delay);
		delay += 5;
		scr_delay_var(""image_index"", 2, delay);
		snd_play_delay(snd_noise, delay, 0.6, 1.4);
		delay += 4;
		scr_delay_var(""image_index"", 3, delay);
		delay += 4;
		scr_delay_var(""image_index"", 4, delay);
		delay += 15;
		scr_delay_var(""image_index"", 5, delay);
		snd_play_delay(snd_wing, delay, 0.7, 1.2);
		delay += 2;
		scr_delay_var(""image_index"", 6, delay);
		delay += 3;
		scr_delay_var(""image_index"", 7, delay);
		delay += 4;
		scr_delay_var(""image_index"", 8, delay);
		delay += 5;
		scr_delay_var(""image_index"", 9, delay);
		delay += 14;
		scr_delay_var(""image_index"", 10, delay);
		snd_play_delay(snd_item, delay, 0.7);
		delay += 20;
		scr_delay_var(""image_index"", 11, delay);
		delay += 2;
		scr_delay_var(""image_index"", 12, delay);
		snd_play_delay(snd_wing, delay);
		delay_function(juicetoss, delay);
		delay += 2;
		scr_delay_var(""image_index"", 13, delay);
		delay += 2;
		scr_delay_var(""image_index"", 14, delay);
		with (obj_garden_diner_flas)
		{
			delay_function(fljumpback, delay + 15);
		}
	}
};

fljumpback = function()
{
	with (fl)
	{
		sprite_index = spr_flowery_diner_pour_orange_toss;
		image_index = 14;
		image_speed = 0;
		x = xstart + 2;
		y = ystart - 30;
		depth = obj_garden_diner_flas.mg.depth - 1;
		gravity = 1.35 / (global.fps_scale * global.fps_scale);
		vspeed = -14 / global.fps_scale;
		sprite_index = spr_flowery_shrug_spin;
		image_index = 1;
		var waittime = scr_returnwait_gravity(undefined, undefined, ystart) / global.fps_scale;
		scr_lerpvar(""x"", x, xstart, waittime - 1);
		scr_delay_var(""depth"", obj_garden_diner_flas.mg.depth + 1, round(waittime / 2));
		
		var setinplace = function()
		{
			image_speed = 0;
			image_index = 0;
			gravity = 0;
			vspeed = 0;
			setxy(xstart, ystart);
			sprite_index = spr_flowery_diner_solo;
			snd_play(snd_wing, 0.7, 1.2);
			with (obj_garden_diner_flas)
			{
				flowerylanded = true;
			}
		};
		
		delay_function(setinplace, waittime - 1);
	}
};

doheadphones = function()
{
	with (headphones)
	{
		setxy(xstart, cameray() - sprite_height);
		visible = true;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		var wait = scr_returnwait_gravity(undefined, undefined, ystart) / global.fps_scale;
		
		ending = function()
		{
			gravity = 0;
			vspeed = 0;
			setxy(xstart, ystart);
			snd_play(snd_item);
		};
		
		delay_function(ending, wait - 1);
	}
};
");

Apply("gml_Object_obj_garden_diner_menu_Create_0", @"dinermenu = scr_makenpc_fromasset(findsprite(spr_dw_garden_diner_interactableMenu, ""NPCs""));
with (dinermenu)
{
	marker.depth -= 300;
	if (instance_exists(obj_dw_fcastle_green_checkpoint))
	{
		marker.depth -= 100;
	}
	markerstick = false;
	sparkle = -10;
	siner = 0;
	issolid = false;
	alpha = 0;
	siner = 0;
	checked = false;
	shine = scr_marker_fancy(x - 4, y - 4, 4635);
	with (shine)
	{
		image_alpha = 0;
		checked = false;
		scr_darksize();
		image_blend = c_white;
		depth = other.marker.depth - 1;
		siner = 0;
		
		step_func = function()
		{
			var me = id;
			siner += (1 / global.fps_scale);
			image_index += (0.125 / global.fps_scale);
			var targ = (sin(siner / 30) * 0.5) + 0.8;
			with (obj_garden_diner_menu)
			{
				with (dinermenu)
				{
					if (myinteract != 0)
					{
						targ = 0;
					}
					if (checked)
					{
						me.checked = true;
					}
				}
			}
			if (checked)
			{
				targ = 0;
			}
			var targalpha = lerp(image_alpha, targ, scr_fps_lerp_rate(1/3));
			image_alpha = targalpha;
			if (checked)
			{
				if (image_alpha <= 0)
				{
					instance_destroy();
				}
			}
		};
	}
}
");

