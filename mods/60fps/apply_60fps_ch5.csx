	c_imagespeed(0);
	c_imageindex(0);
	c_wait(30);
	c_speaker(""ralsei"");
	c_msgsetloc(0, ""\\EX* Oh^1, umm^1, it's just Orange.../%"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_164_0"");
	c_talk_wait();
