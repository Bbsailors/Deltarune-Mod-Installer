					var _dust = instance_create_depth(x + x_ongrid, y + y_ongrid, 0, obj_pinkdust);
					_dust.image_angle = 180;
				}
				else if (buffer_r >= 1 && instance_exists(node_id.child[0]))
				{
					input_activated_r++;
					direction = 0;
					snd_play(snd_wing);
					_moved = true;
					node_id = node_id.child[0];
					var _dust = instance_create_depth(x + x_ongrid, y + y_ongrid, 0, obj_pinkdust);
					_dust.image_angle = 0;
				}
				else if (buffer_u >= 1 && instance_exists(node_id.child[1]))
				{
					input_activated_u++;
					direction = 90;
					snd_play(snd_wing);
					_moved = true;
					node_id = node_id.child[1];
					var _dust = instance_create_depth(x + x_ongrid, y + y_ongrid, 0, obj_pinkdust);
					_dust.image_angle = 90;
				}
				else if (buffer_d >= 1 && instance_exists(node_id.child[3]))
				{
					input_activated_d++;
					direction = 270;
					snd_play(snd_wing);
					_moved = true;
					node_id = node_id.child[3];
					var _dust = instance_create_depth(x + x_ongrid, y + y_ongrid, 0, obj_pinkdust);
					_dust.image_angle = 270;
				}
				if (_moved)
				{
					heart_travel = point_distance(_old_node.dest_x, _old_node.dest_y, node_id.dest_x, node_id.dest_y);
				}
			}
			var _move_dir = point_direction(x + x_ongrid, y + y_ongrid, node_id.x, node_id.y);
			if (heart_travel > 0)
			{
				var _move_amount = min(_laneswap_speed, max(1, point_distance(x + x_ongrid, y + y_ongrid, node_id.x, node_id.y)));
				if ((global.time % global.fps_scale) == 0)
				{
					with (obj_heart)
					{
						var _trail = instance_create_depth(x, y, 0, obj_pinktrail);
						_trail.direction = _move_dir;
						_trail.speed = 1 / global.fps_scale;
					}
				}
				heart_travel -= _move_amount;
				if (heart_travel <= 0)
				{
					heart_travel = 0;
					if (direction < 45 || direction >= 315)
					{
						heartshake_x = 5;
					}
					if (direction >= 45 && direction < 135)
					{
						heartshake_y = -5;
					}
					if (direction >= 135 && direction < 225)
					{
						heartshake_x = -5;
					}
					if (direction >= 225 && direction < 315)
					{
						heartshake_y = 5;
					}
					with (node_id)
					{
						if (checkpoint == 1)
						{
							with (obj_pinknode)
							{
								if (checkpoint > 1)
								{
									checkpoint = 1;
								}
							}
							checkpoint = 2;
						}
					}
				}
			}
			x_ongrid = node_id.x - lengthdir_x(heart_travel, _move_dir) - x;
			y_ongrid = node_id.y - lengthdir_y(heart_travel, _move_dir) - y;
		}
		break;
}
x_shake = -scr_approach(x_shake, 0, 0.5);
with (obj_growtangle)
{
	other.x = x;
	other.y = y;
}
with (obj_heart)
{
	x = (other.x + other.x_ongrid) - (9 * image_xscale);
	y = (other.y + other.y_ongrid) - (9 * image_yscale);
}
var _input_activated = false;
if (input_activated_l)
{
	buffer_l = 0;
	_input_activated = true;
}
if (input_activated_r)
{
	buffer_r = 0;
	_input_activated = true;
}
if (input_activated_u)
{
	buffer_u = 0;
	_input_activated = true;
}
if (input_activated_d)
{
	buffer_d = 0;
	_input_activated = true;
}
if (_input_activated)
{
	press_l = 1;
	press_r = 1;
	press_u = 1;
	press_d = 1;
}
made = 1;
life_time += (1 / global.fps_scale);
if (life_time >= 30)
{
	if (!instance_exists(obj_heart))
	{
		with (obj_growtangle)
		{
			visible = true;
		}
		with (obj_heart)
		{
			visible = true;
		}
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_purplecontrols_Step_1", @"iframes = max(0, iframes - (1 / global.fps_scale));
");

Apply("gml_Object_obj_purplegrass_Draw_0", @"index += (0.2 / global.fps_scale);
for (i = 0; i < length; i += 1)
{
	for (j = 0; j < height; j += 1)
	{
		draw_sprite(sprite_index, index + (x / 320) + (i * 0.125) + (j * 0.125) + (y / 320), x + (40 * i), y + (40 * j));
	}
}
");

Apply("gml_Object_obj_pushable_block_Step_0", @"scr_depth();
if (movecourse == 1)
{
	if (movedir == 1)
	{
		x += (8 / global.fps_scale);
	}
	if (movedir == 0)
	{
		y += (8 / global.fps_scale);
	}
	if (movedir == 2)
	{
		y -= (8 / global.fps_scale);
	}
	if (movedir == 3)
	{
		x -= (8 / global.fps_scale);
	}
	movetimer += (1 / global.fps_scale);
	if (movetimer >= 5)
	{
		movetimer = 0;
		global.interact = 0;
		movecourse = 0;
		if (flag > 0)
		{
			global.flag[flag] = (x * 10000) + y;
		}
	}
}
var mult = array_get(scr_platswap_yscale(), 0);
image_index = round(mult);
if (instance_exists(solidblock))
{
	with (solidblock)
	{
		if (!place_meeting(other.x, other.y, obj_mainchara))
		{
			x = other.x;
			y = other.y;
		}
	}
}
if (myinteract == 3)
{
	if (i_ex(mydialoguer) == false)
	{
		global.interact = 0;
		myinteract = 0;
		with (obj_mainchara)
		{
			onebuffer = 5;
		}
	}
}
");

Apply("gml_Object_obj_rabbitbullet_Create_0", @"scr_bullet_init();
difficulty = 1;
times = 0;
activetimer = 0;
grazed = 0;
grazepoints = 5;
timepoints = 5;
target = 0;
dont = 1;
inv = 120;
damage = 92;
active = 0;
sinerspeed = 1;
netskie = false;
image_alpha = 0;
image_speed = 0;
if (!instance_exists(obj_heart))
{
	instance_destroy();
}
jumpsiner = random(100);
hspeed = (-3 - random(1)) / global.fps_scale;
jumpspeed = 8 + random(4);
jumpheight = 50 + random(10);
image_xscale = 2;
image_yscale = 2;
insidebox = false;
slowcon = 0;
");

Apply("gml_Object_obj_rabbitbullet_Step_0", @"jumpsiner += (sinerspeed / global.fps_scale);
if (image_alpha < 1 && active == 0)
{
	image_alpha += (0.1 / global.fps_scale);
}
else
{
	active = 1;
}
bottomy = (obj_growtangle.y + (obj_growtangle.sprite_height / 2)) - 20;
jsine = sin(jumpsiner / jumpspeed) * jumpheight;
y = (bottomy + jsine) - jumpheight;
image_speed = 0;
image_index = 1;
if (jsine > 0)
{
	image_index = 2;
}
if (jsine > (jumpheight / 2))
{
	image_index = 0;
}
if (x <= (obj_growtangle.x - (obj_growtangle.sprite_width / 2) - 40) && sprite_index != spr_rabbitbullet_netskie)
{
	image_alpha -= (0.1 / global.fps_scale);
}
if (sprite_index == spr_rabbitbullet_netskie)
{
	if (x < (obj_growtangle.x + 100) && x > (obj_growtangle.x - 100) && y < (obj_growtangle.y + 75) && y > (obj_growtangle.y - 75))
	{
		insidebox = true;
	}
	if (insidebox)
	{
		if (x < (obj_growtangle.x - 100) || x > (obj_growtangle.x + 100) || y < (obj_growtangle.y - 75) || y > (obj_growtangle.y + 75))
		{
			slowcon = 1;
			friction = 0.3 / (global.fps_scale * global.fps_scale);
		}
	}
}
if (slowcon && sinerspeed > 0)
{
	sinerspeed -= (0.1 / global.fps_scale);
}
");

Apply("gml_Object_obj_ralseibullet_Alarm_0", @"if (instance_exists(obj_heart))
{
	move_towards_point(obj_heart.x + 8, obj_heart.y + 8, 6 / global.fps_scale);
	if (special == 1)
	{
		speed = -speed;
	}
}
