Apply("gml_Object_obj_plat_windcontroller_new_Step_0", @"if (con < 0)
{
	exit;
}
if (scr_battlebg_fullalpha())
{
	exit;
}
if (instance_number(obj_plat_windcontroller_new) > 1)
{
	instance_destroy();
	exit;
}
var strengthmult = 1;
if (pinwheel_controlled)
{
	var active = false;
	with (obj_pinwheel_held)
	{
		if (upright)
		{
			active = true;
			break;
		}
	}
	if (!active)
	{
		strengthmult = 0;
	}
}
if (init == 0)
{
	init = 1;
	if (flag >= 0)
	{
		winddirection = [global.flag[flag]] - 2;
		change_wind_direction(winddirection, 0);
	}
	reference_direction = winddirection;
}
if (!global.pause_plat)
{
	boost_timer -= (1 / global.fps_scale);
	if (boost_timer == 0)
	{
		strength = 1;
		update_wind_strength();
	}
	flip_timer -= (1 / global.fps_scale);
	if (flip_timer == 0)
	{
		strength = 1;
		change_wind_direction(reference_direction, 0);
	}
	timer += (1 / global.fps_scale);
	if (strength > 1 && (timer % (30 - (10 * severe))) == 1)
	{
		var dx = lengthdir_x(600, 180 + winddirection);
		var dy = lengthdir_y(600, 180 + winddirection);
		var boost = instance_create(camerax() + 320 + dx, cameray() + 240 + dy, obj_plat_windboost);
		boost.direction = winddirection;
		boost.severe = severe;
		boost.winddir = winddirection;
		boost.image_angle = winddirection;
	}
}
");

Apply("gml_Object_obj_plat_windswirl_Create_0", @"points = [];
timer = 0;
timermax = random_range(50, 60);
widspeed = random_range(0.05, 0.12) / global.fps_scale;
maxalpha = 0.4;
wid = 1;
wave_offset = random_range(0, 2 * pi);
depth = 50000;
speed = random_range(3, 4) / global.fps_scale;
last_speed = -4;
freq = random_range(0.1, 0.2);
amp = random_range(1.5, 2.7);
vertlist = [];

add_points = function(arg0)
{
	array_push(points, [x, y, arg0, direction]);
};

add_points(1);
");

Apply("gml_Object_obj_plat_windswirl_Step_0", @"if (global.pause_plat)
{
	if (last_speed == -4)
	{
		last_speed = speed;
	}
	speed = 0;
	exit;
}
else
{
	if (last_speed != -4)
	{
		speed = last_speed;
		last_speed = -4;
	}
	timer += (1 / global.fps_scale);
}
if (timer < 10)
{
	wid += widspeed;
}
if (timer < timermax && (timer % 3) == 0)
{
	add_points(2);
	direction += (sin((timer * freq) + wave_offset) * amp);
}
if (timer >= (timermax * 0.35) && (timer % 4) == 0)
{
	xstart = points[0][0];
	ystart = points[0][1];
	array_delete(points, 0, 1);
}
var widthmult = 0;
var ptscount = array_length(points);
var vertlen = 0;
var vertlistlen = array_length(vertlist);
for (var i = 0; i < ptscount; i++)
{
	points[i][0] += lengthdir_x(1 / global.fps_scale, direction);
	points[i][1] += lengthdir_y(1 / global.fps_scale, direction);
	var dx = lengthdir_x(points[i][2], points[i][3] + 90) * widthmult * max(wid, 0);
	var dy = lengthdir_y(points[i][2], points[i][3] + 90) * widthmult * max(wid, 0);
	if (vertlen <= vertlistlen)
	{
		array_push(vertlist, points[i][0] + dx);
		array_push(vertlist, points[i][1] + dy);
		array_push(vertlist, points[i][0] - dx);
		array_push(vertlist, points[i][1] - dy);
	}
	else
	{
		vertlist[vertlen] = points[i][0] + dx;
		if (vertlen <= (vertlistlen + 1))
		{
			array_push(vertlist, points[i][1] + dy);
			array_push(vertlist, points[i][0] - dx);
			array_push(vertlist, points[i][1] - dy);
		}
		else
		{
			vertlist[vertlen + 1] = points[i][1] + dy;
			if (vertlen <= (vertlistlen + 2))
			{
				array_push(vertlist, points[i][0] - dx);
				array_push(vertlist, points[i][1] - dy);
			}
			else
			{
				vertlist[vertlen + 2] = points[i][0] - dx;
				if (vertlen <= (vertlistlen + 3))
				{
					array_push(vertlist, points[i][1] - dy);
				}
				else
				{
					vertlist[vertlen + 3] = points[i][1] - dy;
				}
			}
		}
	}
	vertlen += 4;
	widthmult += 0.1;
	if (i > (ptscount - 5))
	{
		widthmult -= 0.2;
	}
	widthmult = clamp01(widthmult);
}
if (vertlen < vertlistlen)
{
	array_delete(vertlist, vertlen, vertlistlen - vertlen);
}
if (timer >= timermax && array_length(points) < 2)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_platformfeather_Draw_0", @"y = ystart + (sin(current_time * 0.001) * 8);
image_xscale = 2 + (0.1 * sin(current_time * 0.005));
image_yscale = image_xscale;
image_speed = 0.25 / global.fps_scale;
image_alpha = 0.5 + (0.15 * sin(current_time * 0.003));
draw_self();
draw_sprite_ext(spr_dw_feather, current_time, x, (ystart - 4) + (sin((50 + current_time) * 0.001) * 8), 2, 2, 0, c_white, 1);
");

Apply("gml_Object_obj_platmode_recolor_Draw_0", @"if (!surface_exists(screensurface) || surface_get_width(screensurface) != surface_get_width(application_surface) || surface_get_height(screensurface) != surface_get_height(application_surface))
{
	if (surface_exists(screensurface))
	{
		surface_free(screensurface);
	}
	screensurface = surface_create(surface_get_width(application_surface), surface_get_height(application_surface));
}
surface_copy(screensurface, 0, 0, application_surface);
shader_replace_simple_set_hook(47);
shader_set_uniform_f(i_idx, 1);
shader_set_uniform_f(i_width, sprite_get_width(palette));
shader_set_uniform_f(i_height, sprite_get_height(palette));
shader_set_uniform_f(i_blend, 1 - array_get(scr_platswap_yscale(), 0));
var uvs = sprite_get_uvs(palette, 0);
shader_set_uniform_f(i_uvs, uvs[0], uvs[1], uvs[2], uvs[3]);
var t_sampler = shader_get_sampler_index(shd_palettemapper_simple, ""iPalette"");
texture_set_stage(t_sampler, sprite_get_texture(palette, 0));
draw_surface_ext(screensurface, camerax(), cameray(), camerawidth() / surface_get_width(screensurface), cameraheight() / surface_get_height(screensurface), 0, c_white, 1);
shader_replace_simple_reset_hook();
");

Apply("gml_Object_obj_platswap_Other_10", @"var lerp_in = scr_platswap_lerp_in;
var lerp_out = scr_platswap_lerp_out;
var __starting = starting_mode;
with (obj_script_delayed)
{
	if (instance_exists(target))
	{
		if (target.object_index == obj_platswap_helper)
		{
			event_user(0);
			instance_destroy(id);
		}
	}
}
if (transition_time <= 0)
{
	with (obj_darkcontroller)
	{
		charcon = 0;
	}
	var vertical_transition = false;
	var _time = transition_timemax;
	if (mode == 0 && instance_exists(obj_mainchara))
	{
		vertical_transition = obj_mainchara.used_vertical_transition;
		obj_mainchara.used_vertical_transition = false;
		if (global.start_in_platmode == UnknownEnum.Value_0)
		{
			snd_play(snd_platswap_2);
		}
		mode = 1;
		transition_time = transition_timemax;
		transition_time_lerp_offset = 0;
		if (transition_time > 10)
		{
			transition_time += 9;
			transition_time_lerp_offset = 9;
		}
		current_transition_timemax = transition_timemax;
		transition_info = [];
		with (obj_plat_floortex)
		{
			lerp_in(""image_yscale"", image_yscale, image_yscale * 0.1);
			lerp_in(""y"", y, y_plat);
			if (sloped)
			{
				lerp_in(""slopeLY"", slopeLY, slopeLYplat);
				lerp_in(""slopeRY"", slopeRY, slopeRYplat);
			}
		}
		if (!instance_exists(obj_plat_player))
		{
			instance_create(obj_mainchara.x, obj_mainchara.y, obj_plat_player);
		}
		prop_player = -4;
		var _ychanger;
		with (obj_mainchara)
		{
			autorun = 0;
			cutscene = 1;
			visible = 0;
			other.prop_player = instance_create(x + 19, y + 38, obj_platswap_prop);
			with (other.prop_player)
			{
				depth = other.depth;
				image_speed = 0.25 / global.fps_scale;
				set_entity_depth = obj_plat_player.id;
				switch (global.facing)
				{
					case 3:
						image_xscale = -2;
						break;
					case 1:
						image_xscale = 2;
						break;
				}
			}
			_ychanger = instance_place(x, y, obj_plat_floortex);
		}
		with (obj_plat_player)
		{
			hitstop = -1;
			ground = -4;
			grounded = 0;
			groundedprev = 0;
			hspeed = 0;
			vspeed = 0;
			if (global.plat_vspeed != -999)
			{
				vspeed = global.plat_vspeed;
				global.plat_vspeed = -999;
			}
			if (global.plat_hspeed != -999)
			{
				hspeed = global.plat_hspeed;
				global.plat_hspeed = -999;
			}
			stored_hspeed = 0;
			stored_vspeed = 0;
			climbing = 0;
			attacking = 0;
			sprite_index = spr_kris_plat_idle;
			x = obj_mainchara.x + 19;
			y = obj_mainchara.y + 38;
			if (_time > 1)
			{
				var statue = instance_nearest(x, y, obj_platswap_statue);
				if (instance_exists(statue) && point_distance(statue.x, statue.y, x, y) < 120)
				{
					x = statue.x;
				}
			}
			dif_x = 0;
			dif_y = 0;
			if (vspeed == 0 && instance_exists(_ychanger))
			{
				y = _ychanger.y_plat - 38;
			}
			if (instance_place(x, y, obj_plat_block))
			{
				repeat (60)
				{
					y -= 4;
					if (!instance_place(x, y, obj_plat_block))
					{
						break;
					}
				}
			}
			if (vspeed == 0)
			{
				ground = scr_ground_checks(x, bbox_bottom, 708);
				scr_plat_snap_to_ground();
				grounded = true;
				groundedprev = 1;
				land_anim = -1;
			}
			attacking = 0;
			image_xscale = other.prop_player.image_xscale;
		}
		with (prop_player)
		{
			lerp_in(""x"", x, obj_plat_player.x);
			if (_time > 25)
			{
				lerp_in(""y"", y, obj_plat_player.y);
			}
			else
			{
				scr_lerpvar(""y"", y, obj_plat_player.y - 20, _time - 2, 3, ""inout"");
				scr_script_delayed(scr_lerpvar, _time - 1, ""y"", obj_plat_player.y - 20, obj_plat_player.y, 10, -1, ""in"");
			}
			sprite_index = spr_kris_jump_down;
			image_speed = 0.25 / global.fps_scale;
		}
		if (!instance_exists(obj_plat_camera))
		{
			var _camera = instance_create(camerax() + (0.5 * camerawidth()), cameray() + (0.5 * cameraheight()), obj_plat_camera);
			_camera.target = prop_player;
			_camera.nudgex = obj_mainchara.nudgex;
			_camera.nudgey = obj_mainchara.nudgey;
			_camera.lerptime_h = 15;
			_camera.lerptime_v = 15;
		}
		if (instance_exists(obj_plat_camera))
		{
			camera_set_view_target(view_camera[0], obj_plat_camera.id);
			camera_set_view_border(view_camera[0], 640, 480);
			obj_plat_camera.target = prop_player;
		}
		var _y_ground = obj_plat_player.bbox_bottom;
		with (obj_caterpillarchara)
		{
			var _name = name;
			var platchara = instance_create(x, y, obj_plat_follower);
			with (platchara)
			{
				switch (_name)
				{
					case ""susie"":
						get_preset(1);
						break;
					case ""ralsei"":
						get_preset(2);
						break;
				}
			}
			var prop_follower = instance_create(x + 24, y + 46, obj_platswap_prop);
			prop_follower.set_entity_depth = id;
