{
	lheld++;
}
else
{
	lheld = 0;
}
if (down_h())
{
	dheld++;
}
else
{
	dheld = 0;
}
if (right_h())
{
	rheld++;
}
else
{
	rheld = 0;
}
if (up_h())
{
	uheld++;
}
else
{
	uheld = 0;
}
