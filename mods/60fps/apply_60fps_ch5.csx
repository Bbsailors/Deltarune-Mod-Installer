						{
							sf = 
							{
								x: 224,
								y: 12
							};
						}
						scr_smallface(0, 35, 0, sf.x, sf.y, small_text);
						scr_speaker(""ralsei"");
						msgsetsubloc(0, ""\\EG* She meant next next next time.\\f0"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_top_ascent_slash_Create_0_gml_114_0"");
