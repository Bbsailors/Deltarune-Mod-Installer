			{
				scr_msgno_func(array_length(dialoguerStrings) - 1, function()
				{
					snd_play(snd_glassbreak);
				});
			}
		}
		global.msgno = 0;
		var count = array_length(dialoguerStrings);
		for (var i = 0; i < count; i++)
		{
			global.msg[i] = dialoguerStrings[i];
