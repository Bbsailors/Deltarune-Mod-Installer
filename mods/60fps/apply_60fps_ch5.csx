Apply("gml_Object_obj_fakespare_Draw_0", @"repeat (reverse ? reversespeed : 1)
{
	if (reverse)
	{
		if (t >= 5 && t < 10)
		{
			tone -= (1 / global.fps_scale);
		}
		if (t >= 9)
		{
			neotone -= (1 / global.fps_scale);
		}
		else
		{
			neotone = 0;
		}
	}
	if (reverse)
	{
		if (t == 0)
		{
			first_pass = false;
		}
		else
		{
			first_pass = !first_pass;
		}
	}
	if (t != 0 && first_pass)
	{
		for (i = 0; i < starcount; i += 1)
		{
			with (star[i])
			{
				hspeed += (gravity / global.fps_scale);
				x += (hspeed / global.fps_scale);
			}
		}
	}
	if (t >= 6 && t <= 26)
	{
		if (!reverse)
		{
			afterimage += (1 / global.fps_scale);
		}
		if (!first_pass)
		{
			d3d_set_fog(true, c_white, 0, 1);
			draw_sprite_ext(sprite_index, image_index, x + (afterimage * 4), y, image_xscale, image_yscale, 0, image_blend, 0.7 - (afterimage / 25));
			draw_sprite_ext(sprite_index, image_index, x + (afterimage * 8), y, image_xscale, image_yscale, 0, image_blend, 0.4 - (afterimage / 30));
			d3d_set_fog(false, c_black, 0, 0);
		}
		if (reverse)
		{
			afterimage -= (1 / global.fps_scale);
		}
	}
	if (t < 6)
	{
		if (!first_pass)
		{
			if (t < 5)
			{
				draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, 1 - (neotone / 4));
			}
			d3d_set_fog(true, c_white, 0, 1);
			maxwhite = t / 5;
			if (maxwhite > 1)
			{
				maxwhite = 1;
			}
			draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, maxwhite - (tone / 5));
			d3d_set_fog(false, c_black, 0, 0);
		}
	}
	if (!reverse)
	{
		if (t >= 1 && t <= 5)
		{
			for (i = 0; i < 2; i += 1)
			{
				star[starcount] = instance_create(x + random(sprite_width), y + random(sprite_height), obj_marker);
				star[starcount].reversespeed = reversespeed;
				with (star[starcount])
				{
					image_xscale = 2;
					image_yscale = 2;
					sprite_index = spr_sparestar_anim;
					image_alpha = 2;
					image_speed = 0.25 / global.fps_scale;
					hspeed = -3 / global.fps_scale;
					gravity = 0.5 / (global.fps_scale * global.fps_scale);
					gravity_direction = 0;
				}
				starcount += 1;
			}
		}
		if (t >= 5 && t <= 30)
		{
			for (i = 0; i < starcount; i += 1)
			{
				with (star[i])
				{
					image_angle += (10 / global.fps_scale);
					image_alpha -= (0.1 / global.fps_scale);
					if (image_alpha <= 0)
					{
						visible = false;
					}
				}
			}
		}
	}
	else
	{
		if (t >= 6 && t <= 31)
		{
			for (i = 0; i < starcount; i += 1)
			{
				with (star[i])
				{
					image_angle -= (10 / global.fps_scale);
					image_alpha += (0.1 / global.fps_scale);
					if (!visible && image_alpha >= 0 && image_alpha < 2)
					{
						visible = true;
					}
				}
			}
		}
		if (t >= 2 && t <= 6)
		{
			for (i = 0; i < 2; i += 1)
			{
				starcount -= (1 / global.fps_scale);
				with (star[starcount])
				{
					instance_destroy();
				}
			}
		}
	}
	if (!reverse)
	{
		if (t >= 5 && t < 10)
		{
			tone += (1 / global.fps_scale);
		}
		if (t >= 9)
		{
			neotone += (1 / global.fps_scale);
		}
		else
		{
			neotone = 0;
		}
	}
	if (reverse && t == (15 * reversespeed))
	{
		snd_play(snd_reverse_spare);
	}
	if (t >= 50 && !reverse)
	{
		for (i = 0; i < starcount; i += 1)
		{
			with (star[i])
			{
				image_speed *= -reversespeed;
				hspeed = (-hspeed - gravity) / global.fps_scale;
			}
		}
		first_pass = false;
		reverse = true;
		t += (1 / global.fps_scale);
	}
	if (reverse)
	{
		t -= (1 / global.fps_scale);
	}
	else
	{
		t += (1 / global.fps_scale);
	}
	if (reverse && t < 0)
	{
		original.visible = true;
		instance_destroy();
		exit;
	}
}
");

Apply("gml_Object_obj_fallboxdrawmanager_Draw_0", @"if (i_ex(obj_heart))
{
	x_offset = obj_heart.x_offset;
}
for (i = 2; i > -1; i--)
{
	ii = 0;
	while (ii < 40)
	{
		ii++;
	}
	cloudx[i] -= (2 + (4 * (2 - i))) / global.fps_scale;
	if (cloudx[i] < -640)
	{
		cloudx[i] += 640;
	}
}
if (i_ex(obj_heart))
{
	cloudy = scr_approach(cloudy, -80, 12);
}
else
{
	cloudy = scr_approach(cloudy, 480, 12);
}
with (obj_fallingbox)
{
	if (i_ex(obj_heart))
	{
		x_offset = obj_heart.x_offset;
	}
	draw_set_colour(image_blend);
	draw_set_colour(merge_colour(#53CBFF, image_blend, fade));
	draw_set_alpha(alpha * alpha2);
	draw_set_alpha(1);
}
with (obj_pathbox)
{
	draw_set_colour(image_blend);
	draw_set_alpha(alpha * alpha2);
	var n = 80;
	if (i_ex(obj_heart) && obj_heart.dash_stop <= 0)
	{
		add -= (10 / global.fps_scale);
	}
	for (i = 0; i < (n + 5); i++)
	{
		var xx = (x - _xs) + ((i * (_xs * 2)) / n) + add;
		if (add <= -(floor(_xs * 2) / n))
		{
			add = 0;
		}
		draw_set_colour(c_gray);
		if (xx > (x - _xs) && xx < (x + _xs))
		{
			d_line(xx + x_offset, y - _ys, xx + x_offset, y + _ys);
		}
	}
	draw_set_alpha(1);
}
");

Apply("gml_Object_obj_falling_leaf_area_Create_0", @"leaves = [];
no_leafling = global.flag[1473] == 1;
is_weak_leafling = global.flag[1473] == 2 || global.flag[1473] == 3;
weak_leafling_petal = -4;
depth = 10000;
leafling_chase = true;
var _cx = camerax();
var _cy = cameray();
var _cw = camerawidth();
var _ch = cameraheight();
var i = _cx;
while (i < (_cx + _cw))
{
	var ii = _cy;
	while (ii < (_cy + _ch))
	{
		var marker = instance_create(i + random_range(-40, 40), ii, obj_marker);
		marker.depth = 4400;
		marker.is_leafling = false;
		marker.idx = array_length(leaves);
		marker.con = 0;
		if (orange)
		{
			marker.sprite_index = choose(spr_bush_leaf_orange, spr_bush_leaf2_orange, spr_bush_leaf3_orange);
		}
		else
		{
			marker.sprite_index = choose(spr_bush_leaf_pink, spr_bush_leaf2_pink, spr_bush_leaf3_pink);
		}
		marker.image_speed = random_range(0.12, 0.23) / global.fps_scale;
		with (marker)
		{
			scr_darksize();
		}
		marker.direction_offset = random_range(-5, 5);
		marker.direction = leaves_direction + marker.direction_offset;
		marker.speed = leaves_speed / global.fps_scale;
		marker.xoffset = 0;
		marker.yoffset = 0;
		scr_plat_make_pauseable(marker);
		array_push(leaves, marker);
		ii += random_range(80, 240);
	}
	i += random_range(80, 240);
}
con = 0;
leafling_petal = -4;
timer = 0;
init = false;
true_winddir = leaves_direction;
true_windspeed = 1;

turn_into_leaflings = function()
{
	con = 99;
	scr_vfx_windboost(90);
	for (var i = 0; i < array_length(leaves); i++)
	{
		with (leaves[i])
		{
			rand = random_range(-30, 30);
			timer = random_range(-30, 0);
			var r = random_range(12, 28);
			scr_lerpvar(""y"", y, y + (0.5 * sprite_height), r);
			target_scale = 0.2;
			direction = 90;
			scr_lerpvar(""target_scale"", 0.2, 2, r);
			speed = 0;
			hspeed = 0;
			vspeed = 0;
			image_speed *= 2;
			con = 99;
			sprite_index = spr_leafling_spin_spared;
			petalstorm = instance_create(x, y, obj_leaf_storm_generator);
			petalstorm.active = true;
			petalstorm.style = 1;
			petalstorm.lifetime = 10;
			petalstorm.rate = 4;
		}
	}
};

restore_normal_leaf = function(arg0)
{
	arg0.sprite_index = choose(spr_bush_leaf_pink, spr_bush_leaf2_pink, spr_bush_leaf3_pink);
	arg0.image_speed = random_range(0.12, 0.23) / global.fps_scale;
	arg0.image_xscale = 2;
	arg0.image_yscale = 2;
	arg0.visible = true;
	arg0.is_leafling = false;
	arg0.image_blend = c_white;
	weak_leafling_petal = -4;
};

make_weak_leafling = function(arg0)
{
	arg0.sprite_index = spr_leafling_spin;
	weak_leafling_petal = arg0;
	arg0.drawoffscreen = 0;
	arg0.drawsiner = 0;
	arg0.dodraw = 1;
	arg0.con = 0;
	arg0.speedstoragex = 0;
	arg0.speedstoragey = 0;
	arg0.sprite_index = spr_leafling_spin;
	weak_leafling_petal = arg0;
};
");

Apply("gml_Object_obj_falling_leaf_area_Draw_0", @"var lp = leafling_petal;
if (lp == -4)
{
	lp = weak_leafling_petal;
}
with (lp)
{
	if (drawoffscreen == 0)
	{
		dodraw = 1;
		tolerance = abs(sprite_height) + abs(sprite_width);
		if (!scr_onscreen_tolerance(id, tolerance))
		{
			dodraw = 0;
		}
	}
	else
	{
		dodraw = true;
	}
	if (dodraw && visible)
	{
		drawx = 0;
		drawsiner += (0.25 / global.fps_scale);
		tempx = x;
		x += drawx;
		superscalex = 0;
		superdrawx = 0;
		superscalexb = 1;
		if (instance_exists(obj_plat_player))
		{
			gpu_set_blendmode(bm_add);
			for (i = 0; i < 5; i++)
			{
				var aura = (i * 9) + ((drawsiner * 3) % 9);
				var aurax = (aura * 0.75) + (sin(aura / 4) * 4);
				var auray = 45 * scr_ease_in(aura / 45, 1);
				var aurayscale = min(80 / sprite_height, 1);
				draw_sprite_ext(sprite_index, image_index, x - ((aurax / 180) * sprite_width), y - ((auray / 82) * sprite_height * aurayscale), image_xscale + (aurax / 36), image_yscale + ((auray / 36) * aurayscale), image_angle, c_red, image_alpha * (1 - (auray / 45)) * 0.5);
			}
			gpu_set_blendmode(bm_normal);
			var xmult = clamp((70 / sprite_width) * 4, 4, 8);
			var ymult = min((80 / sprite_height) * 5, 5);
			var ysmult = min((80 / sprite_height) * 0.2, 0.2);
			draw_sprite_ext_centerscale(sprite_index, image_index, x + superdrawx + (sin(drawsiner / 5) * xmult), y + (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale + (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2);
			draw_sprite_ext_centerscale(sprite_index, image_index, (x + superdrawx) - (sin(drawsiner / 5) * xmult), y - (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale - (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2);
			scr_draw_outline_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, c_red, image_alpha * 0.3, 2);
		}
		draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
		x = tempx;
	}
}
");

Apply("gml_Object_obj_falling_leaf_area_Step_0", @"var wc = instance_find(obj_plat_windcontroller_new, 0);
if (!init)
{
	if (wc != -4)
	{
		true_direction = wc.winddirection;
		true_speed = wc.strength;
	}
	init = true;
}
var cx = camerax();
var cy = cameray();
var cxw = cx + camerawidth();
var cyh = cy + cameraheight();
var in_encounter = instance_exists(obj_battlecontroller) || instance_exists(obj_encounterbasic);
var strength = 2;
var dir = leaves_direction;
if (wc != -4)
{
	true_winddir = scr_approach(true_winddir, wc.winddirection, 24);
	true_windspeed = scr_approach(true_windspeed, wc.strength, 0.05);
	dir = true_winddir;
	strength = lerp(1, 6, max(0, true_windspeed - 1));
}
for (var i = 0; i < array_length(leaves); i++)
{
	var leaf = leaves[i];
	if (in_encounter)
	{
		leaf.image_alpha -= 0.1 / global.fps_scale;
	}
	else
	{
		leaf.image_alpha += 0.1 / global.fps_scale;
	}
	leaf.image_alpha = clamp01(leaf.image_alpha);
	if (global.pause_plat)
	{
		if (leaf != leafling_petal)
		{
			leaf.speed = 0;
			leaf.depth = 5000;
		}
	}
	else
	{
		if (leaf != leafling_petal && con < 99 && leaf.con != 99)
		{
			leaf.speed = (leaves_speed * strength) / global.fps_scale;
			leaf.direction = dir + leaf.direction_offset;
			if (leaf.direction < 90)
			{
				leaf.direction = lerp(leaf.direction, -90, scr_fps_lerp_rate(0.1 * (6 - strength)));
			}
			else
			{
				leaf.direction = lerp(leaf.direction, 270, scr_fps_lerp_rate(0.1 * (6 - strength)));
			}
			leaf.image_speed = (0.125 + ((strength - 1) * 0.25)) / global.fps_scale;
		}
		leaf.depth = 4400;
	}
	if (con < 99 && !global.pause_plat)
	{
		var looped = false;
		if (leaf.x < (cx - 80))
		{
			leaf.x += (cxw - cx) + 100;
			var correction = sign(leaf.xoffset) * min(10, abs(leaf.xoffset));
			leaf.xoffset -= correction;
			leaf.x -= correction;
			looped = true;
		}
		if (leaf != leafling_petal && leaf.y < (cy - 80))
		{
			leaf.y += (cyh - cy) + 100;
			looped = true;
			var correction = sign(leaf.yoffset) * min(10, abs(leaf.yoffset));
			leaf.yoffset -= correction;
			leaf.y -= correction;
		}
		if (leaf.x > (cxw + 80))
		{
			leaf.x -= (cxw - cx) + 100;
			looped = true;
			var correction = sign(leaf.xoffset) * min(10, abs(leaf.xoffset));
			leaf.xoffset -= correction;
			leaf.x -= correction;
		}
		if (leaf != leafling_petal && leaf.y > (cyh + 80))
		{
			leaf.y -= (cyh - cy) + 100;
			looped = true;
			var correction = sign(leaf.yoffset) * min(10, abs(leaf.yoffset));
			leaf.yoffset -= correction;
			leaf.y -= correction;
		}
		if (looped && can_spawn_leafling)
		{
			if (i_ex(obj_plat_player) && con == 0 && is_weak_leafling && !no_leafling)
			{
				if (leaf == weak_leafling_petal)
				{
					restore_normal_leaf(leaf);
				}
				else if (weak_leafling_petal == -4 && leaf.y < obj_plat_player.y && random(1) > 0.3)
				{
					make_weak_leafling(leaf);
				}
			}
			if (!i_ex(obj_plat_player) && leaf == leafling_petal)
			{
				restore_normal_leaf(leaf);
				con = 0;
			}
		}
		if (leafling_petal == leaf && !leafling_chase)
		{
			restore_normal_leaf(leaf);
			leafling_petal = -4;
			con = 0;
		}
	}
	else if (!global.pause_plat)
	{
		leaf.timer += 1 / global.fps_scale;
		leaf.petalstorm.active = leaf.timer < 120;
		leaf.petalstorm.x = leaf.x + (0.5 * leaf.sprite_width);
		leaf.petalstorm.y = leaf.y + leaf.sprite_height;
		if (leaf.timer > 0)
		{
			if (leaf.timer >= 1 && (leaf.timer - (1 / global.fps_scale)) < 1)
			{
				scr_vfx_windboost(90, 8);
			}
			leaf.gravity_direction = 90;
			leaf.gravity = (leaf.target_scale * 0.3) / (global.fps_scale * global.fps_scale);
		}
		leaf.image_xscale = leaf.target_scale * sin(leaf.timer / 2);
		leaf.image_yscale = 2;
	}
}
if (leafling_chase && scr_trigcheck_ext(""noleafling"", 912))
{
	leafling_chase = false;
	with (leafling_petal)
	{
		with (instance_create(x, y, obj_marker_fancy))
		{
			scr_spritematch(other);
			gravity = 1 / (global.fps_scale * global.fps_scale);
			gravity_direction = 90;
			hspeed = other.hspeed;
			vspeed = other.vspeed;
			friction = 0.5 / (global.fps_scale * global.fps_scale);
			scr_doom(self, 120);
			
			step_func = function()
			{
				image_alpha -= (0.05 / global.fps_scale);
				image_xscale = scr_approach(image_xscale, 2, 0.1);
				image_blend = merge_color(image_blend, c_white, scr_fps_lerp_rate(0.1));
			};
			
			scr_plat_make_pauseable(self);
		}
	}
}
var no_leafling_real = no_leafling || is_weak_leafling;
if (global.interact == 0 && !global.pause_plat && con == 0 && !no_leafling_real && scr_trigcheck_ext(""leafling"", 912) && instance_exists(obj_plat_player) && !obj_plat_player.fallen_in_pit)
{
	for (var i = 0; i < array_length(leaves); i++)
	{
		var l = leaves[i];
		if (l.y < (obj_plat_player.y - 10) && l.y > (obj_plat_player.y - 180) && l.x > (obj_plat_player.x + 140))
		{
			var d = point_distance(l.x, l.y, obj_plat_player.x, obj_plat_player.y);
			if (d > 40 && d < 420)
			{
				con = 1;
				timer = 0;
				l.sprite_index = choose(spr_bush_leaf_big, spr_bush_leaf2_big, spr_bush_leaf3_big);
				repeat (8)
				{
					var mrkr = instance_create(l.x + random_range(-200, 200), l.y + random_range(-200, 200), obj_marker_fancy);
					with (mrkr)
					{
