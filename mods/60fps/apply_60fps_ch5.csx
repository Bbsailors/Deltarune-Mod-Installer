Apply("gml_Object_obj_effect_ripple_Draw_0", @"var squish = 0.5;
var colortransitionrate = 0.05;
if (mode == 0)
{
	colorrate = lerp(colorrate, 1, scr_fps_lerp_rate(colortransitionrate));
	draw_set_color(merge_color(c_white, c_blue, colorrate));
	draw_set_alpha(r1a);
	d_ellipse(x - r1, y - (r1 * squish), x + r1, y + (r1 * squish), 1);
	draw_set_alpha(r2a);
	d_ellipse(x - r2, y - (r2 * squish), x + r2, y + (r2 * squish), 1);
	draw_set_alpha(r3a);
	d_ellipse(x - r3, y - (r3 * squish), x + r3, y + (r3 * squish), 1);
	r1 += (0.25 / global.fps_scale);
	r2 += (0.65 / global.fps_scale);
	r3 += (1 / global.fps_scale);
	r1a = lerp(r1a, -0.01, scr_fps_lerp_rate(0.05));
	r2a = lerp(r2a, -0.01, scr_fps_lerp_rate(0.05));
	r3a = lerp(r3a, -0.01, scr_fps_lerp_rate(0.05));
}
if (mode == 1)
{
	var expandrate = 2;
	var faderate = 0.1;
	var delayrate = 5;
	timer += (1 / global.fps_scale);
	draw_set_color(merge_color(c_white, c_blue, colorrate1));
	draw_set_alpha(r1a);
	r1 += (expandrate / global.fps_scale);
	r1a = lerp(r1a, -0.01, scr_fps_lerp_rate(faderate));
	colorrate1 = lerp(colorrate1, 1, scr_fps_lerp_rate(colortransitionrate));
	d_ellipse(x - r1, y - (r1 * squish), x + r1, y + (r1 * squish), 1);
	draw_set_alpha(r2a);
	if (timer > delayrate)
	{
		colorrate2 = lerp(colorrate2, 1, scr_fps_lerp_rate(colortransitionrate));
		draw_set_color(merge_color(c_white, c_blue, colorrate2));
		r2 += (expandrate / global.fps_scale);
		r2a = lerp(r2a, -0.01, scr_fps_lerp_rate(faderate));
		d_ellipse(x - r2, y - (r2 * squish), x + r2, y + (r2 * squish), 1);
	}
	draw_set_alpha(r3a);
	if (timer > (delayrate * 2))
	{
		colorrate3 = lerp(colorrate3, 1, scr_fps_lerp_rate(colortransitionrate));
		draw_set_color(merge_color(c_white, c_blue, colorrate3));
		r3 += (expandrate / global.fps_scale);
		r3a = lerp(r3a, -0.01, scr_fps_lerp_rate(faderate));
		d_ellipse(x - r3, y - (r3 * squish), x + r3, y + (r3 * squish), 1);
	}
}
draw_set_color(c_white);
draw_set_alpha(1);
if ((r1a + r2a + r3a) < 0)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_elevator_warp_Step_0", @"if (con == 1)
{
	con = 2;
	scr_delay_var(""con"", 3, 1);
	cutscene_master = scr_cutscene_make();
	scr_maincharacters_actors();
	c_pannable(1);
	c_sel(kr);
	c_walkdirect(kr_actor.x, kr_actor.y - 40, 15);
	if (variable_instance_exists(id, ""su_actor""))
	{
		c_sel(su);
		c_walkdirect(kr_actor.x, su_actor.y, 5);
		c_delaycmd(5, ""walkdirect"", kr_actor.x, kr_actor.y - 30, 15);
	}
	if (variable_instance_exists(id, ""ra_actor""))
	{
		c_sel(ra);
		c_walkdirect(kr_actor.x, ra_actor.y, 10);
		c_delaycmd(10, ""walkdirect"", kr_actor.x, kr_actor.y - 30, 15);
	}
	var targetx = x;
	var targety = y;
	with (obj_krmarker)
	{
		if (extflag == other.target_extflag)
		{
			targetx = x + 4;
			targety = y;
			break;
		}
	}
	c_wait(20);
	c_customfunc(function(arg0)
	{
		var fusuma = collision_rectangle(arg0[0], arg0[1], arg0[0] + 40, arg0[1] + 120, obj_fusuma_door, false, true);
		with (fusuma)
		{
			set_open_state((state + 1) % 2);
		}
	}, [x, y, target_extflag]);
	c_wait(10);
	c_customfunc(function(arg0)
	{
		cameracon = 1;
		cameratimer = 0;
		camerastartx = camerax();
		camerastarty = cameray();
		var targetx = arg0[0];
		var targety = arg0[1];
		with (obj_krmarker)
		{
			if (extflag == arg0[2])
			{
				targetx = x + 4;
				targety = y;
				break;
			}
		}
		cameraendx = clamp(targetx - 301, 0, room_width - 640);
		cameraendy = clamp(targety - 142, 0, room_height - 480);
	}, [x, y, target_extflag]);
	c_waitcustom();
	c_customfunc(function(arg0)
	{
		global.facing = 0;
		var targetx = arg0[0];
		var targety = arg0[1];
		with (obj_krmarker)
		{
			if (extflag == arg0[2])
			{
				targetx = x + 4;
				targety = y;
				break;
			}
		}
		var fusuma = collision_rectangle(targetx, targety, targetx + 40, targety + 120, obj_fusuma_door, false, true);
		with (fusuma)
		{
			if (state == 0)
			{
				set_open_state((state + 1) % 2);
				with (obj_actor)
				{
					depth = other.depth + 200;
					if (name == ""susie"")
					{
						depth -= 40;
					}
					if (name == ""kris"")
					{
						depth -= 80;
					}
				}
			}
		}
	}, [x, y, target_extflag]);
	c_sel(kr);
	c_facing(""d"");
	c_setxy(targetx - 2, targety);
	c_walkdirect(targetx - 2, targety + 60, 7);
	if (variable_instance_exists(id, ""su_actor""))
	{
		c_sel(su);
		c_facing(""d"");
		c_setxy(targetx - 18, targety - 20);
		c_walkdirect(targetx - 32, targety + 24, 7);
	}
	if (variable_instance_exists(id, ""ra_actor""))
	{
		c_sel(ra);
		c_facing(""d"");
		c_setxy(targetx + 10, targety - 30);
		c_walkdirect(targetx + 24, targety + 26, 7);
	}
	c_sel(kr);
	c_var(""depthbonus"", -240);
	c_sel(su);
	c_var(""depthbonus"", -240);
	c_sel(ra);
	c_var(""depthbonus"", -240);
	c_wait(8);
	c_customfunc(function(arg0)
	{
		var targetx = arg0[0];
		var targety = arg0[1];
		with (obj_krmarker)
		{
			if (extflag == arg0[2])
			{
				targetx = x + 4;
				targety = y;
				break;
			}
		}
		var fusuma = collision_rectangle(targetx, targety, targetx + 40, targety + 120, obj_fusuma_door, false, true);
		if (i_ex(fusuma))
		{
			with (fusuma)
			{
				set_open_state((state + 1) % 2);
			}
		}
	}, [x, y, target_extflag]);
	c_pannable(0);
	c_actortokris();
	c_actortocaterpillar();
	c_customfunc(function()
	{
		with (obj_mainchara)
		{
			scr_depth();
		}
		with (obj_caterpillarchara)
		{
			facing[target] = 0;
		}
	});
	c_terminatekillactors();
}
if (con == 3 && !i_ex(obj_cutscene_master))
{
	con = 0;
	obj_mainchara.cutscene = 0;
	global.interact = 0;
	global.facing = 0;
}
if (cameracon == 1)
{
	cameratimer += (1 / global.fps_scale);
	var len = 25;
	camerax_set(lerp_ease_inout(camerastartx, cameraendx, cameratimer / len, 2));
	cameray_set(lerp_ease_inout(camerastarty, cameraendy, cameratimer / len, 2));
	if (cameratimer >= len)
	{
		cameracon = 0;
		cameratimer = 0;
		c_waitcustom_end();
	}
}
");

