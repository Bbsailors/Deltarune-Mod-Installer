Apply("gml_Object_obj_recruitanim_Step_0", @"timer += (1 / global.fps_scale);
if (timer <= 5)
{
	lerptimer += (1 / global.fps_scale);
	image_xscale = lerp(image_xscale, 1, lerptimer / 5);
	image_yscale = lerp(image_yscale, 1, lerptimer / 5);
}
if (timer == 5)
{
	lerptimer = 0;
}
if (timer >= 5 && timer <= 8)
{
	lerptimer += (1 / global.fps_scale);
	image_xscale = lerp(image_xscale, 0.5, lerptimer / 3);
	image_yscale = lerp(image_yscale, 2, lerptimer / 3);
}
if (timer == 8)
{
	lerptimer = 0;
}
if (timer >= 8 && timer <= 10)
{
	lerptimer += (1 / global.fps_scale);
	if (lerptimer >= 2)
	{
		lerptimer = 2;
	}
	image_xscale = lerp(image_xscale, 1, lerptimer / 2);
	image_yscale = lerp(image_yscale, 1, lerptimer / 2);
}
x = xstart + (sprite_width / 2);
if (timer >= 35)
{
	vspeed -= (1 / global.fps_scale);
	image_yscale += (0.1 / global.fps_scale);
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_reedanim_Step_0", @"timer += (1 / global.fps_scale);
for (var i = 0; i < reed_count; i++)
{
	if (((timer + (32 * i)) % 30) == 0 && irandom(10) == 1)
	{
		layer_sprite_speed(reeds[i], choose(-0.05, -0.1, 0.1, 0.05) / global.fps_scale);
	}
	else if (((timer + (32 * i)) % 200) == 60)
	{
		layer_sprite_speed(reeds[i], 0);
	}
}
");

Apply("gml_Object_obj_regularbullet_Step_0", @"if (wall_destroy == 1)
{
	if (x < (__view_get(e__VW.XView, 0) - 80))
	{
		instance_destroy();
	}
	if (x > (__view_get(e__VW.XView, 0) + 760))
	{
		instance_destroy();
	}
	if (y < (__view_get(e__VW.YView, 0) - 80))
	{
		instance_destroy();
	}
	if (y > (__view_get(e__VW.YView, 0) + 580))
	{
		instance_destroy();
	}
}
if (updateimageangle == 1)
{
	image_angle = direction;
}
if (spin == 1)
{
	image_angle += (spinspeed / global.fps_scale);
}
direction += anglechange;
if (bottomfade != 0)
{
	if (y > (cameray() + bottomfade))
	{
		image_alpha *= power(0.8, 1 / global.fps_scale);
	}
}

