				{
					inst.slower = true;
				}
				slowercan = false;
				wateringcan = false;
			}
			turns += 1;
			attacked = 1;
		}
	}
	if (global.mnfight == 2 && global.turntimer <= 2 && bonsaicon == 1)
	{
		msgsetloc(0, ""* The enemy bloomed!"", ""obj_terracota_enemy_slash_Step_0_gml_82_0"");
