	}
	else
	{
		c_sprite(spr_krisu_head_down);
	}
	c_wait(60);
	if (auto_mode)
	{
		c_sprite(spr_kris_look_down_left_balloon);
	}
	else
	{
		c_sprite(spr_kris_look_down_left);
	}
	c_halt();
	c_wait(30);
	c_autowalk(0);
	if (auto_mode)
	{
		c_sprite(spr_krisd_walk_balloon_head_down);
	}
	else
	{
		c_sprite(spr_krisd_walk_head_down);
	}
	c_imagespeed(0.1);
	c_walkdirect(kr_actor.x, 240, 140);
	c_wait(60);
	c_customfunc(function()
	{
		blackall = scr_dark_marker(-10, -10, spr_pixel_white);
		blackall.image_xscale = 999;
		blackall.image_yscale = 999;
		blackall.depth = 100;
		blackall.image_blend = c_black;
		blackall.image_alpha = 0;
		with (blackall)
		{
			scr_lerpvar(""image_alpha"", 0, 1, 80);
		}
	});
	c_wait(140);
	c_customfunc(function()
	{
		var tbc_event = instance_create(0, 0, obj_credits_ch5_tbc);
		tbc_event.depth = 50;
	});
	c_waitcustom();
}
");

