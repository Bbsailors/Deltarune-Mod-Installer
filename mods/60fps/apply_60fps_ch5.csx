Apply("gml_Object_obj_plat_enm_greenfood_egg_Step_0", @"event_inherited();
if (global.pause_plat)
{
	if (!paused)
	{
		on_pause();
	}
	exit;
}
if ((enemy_wave != """" || passive) && movecon < 8)
{
	movecon = 8;
	hspeed = random_range(-4, 4) / global.fps_scale;
}
if (grounded)
{
	if (!lastgrounded)
	{
		image_xscale = 2.8;
		image_yscale = 1.2;
		scr_lerpvar(""image_xscale"", image_xscale, 2, 6, -1, ""inout"");
		scr_lerpvar(""image_yscale"", image_yscale, 2, 6, -1, ""inout"");
		lastgrounded = grounded;
	}
	vspeed = random_range(-4, -8) / global.fps_scale;
	if (movecon == 0)
	{
		hspeed = 0;
		movespeed = 0;
		movecon = 2;
	}
	else if (movecon <= 3)
	{
		bounce += 1;
		if (bounce >= bounces)
		{
			movecon = 3.5;
		}
	}
	else if (movecon == 3.5)
	{
		timer += (1 / global.fps_scale);
		hspeed = 0;
		vspeed = 0;
		image_index = min(timer / (4 - (2 * sped_up)), 2);
		if (timer >= (20 - (10 * sped_up)))
		{
			movecon = 4;
			timer = 0;
		}
	}
	else if (movecon == 4)
	{
		image_speed = 0;
		var fus = -4;
		with (obj_fusuma_door)
		{
			if (elevator_flag == ""fusuma"")
			{
				if (fus == -4 || abs((x + (0.5 * sprite_width)) - other.x) < abs((fus.x + (0.5 * fus.sprite_width)) - other.x))
				{
					fus = self;
				}
			}
		}
		if (fus == -4)
		{
		}
		else
		{
			fusuma = fus;
			var xx = fus.x + (0.5 * fus.sprite_width);
			if (xx > x)
			{
				hspeed = 4 / global.fps_scale;
			}
			else
			{
				hspeed = -4 / global.fps_scale;
			}
			movespeed = abs(hspeed);
			if ((x <= (camerax() + 340) && xx < x) || (x >= (camerax() + 300) && xx > x))
			{
				movecon = 5;
			}
			else
			{
				movecon = 6;
			}
		}
	}
	else if (movecon == 5)
	{
		if (x < (camerax() + 200) && image_xscale < 0)
		{
			movecon = 6;
			hspeed = 4 / global.fps_scale;
			movespeed = abs(hspeed);
		}
		else if (x > (camerax() + 440) && image_xscale > 0)
		{
			movecon = 6;
			hspeed = -4 / global.fps_scale;
			movespeed = abs(hspeed);
		}
		else
		{
			hspeed = (2 * image_xscale) / global.fps_scale;
		}
	}
	else if (movecon == 6)
	{
		if (x > (camerax() + 320))
		{
			hspeed = -abs(hspeed);
		}
		else
		{
			hspeed = abs(hspeed);
		}
	}
	else if (movecon == 8)
	{
		movespeed = -movespeed;
	}
	if (movecon >= 4 && movecon <= 6)
	{
		if (timer <= 3)
		{
			image_index = 1;
			hspeed = 0;
			vspeed = 0;
			timer += (1 / global.fps_scale);
			if (sped_up)
			{
				timer += (1 / global.fps_scale);
			}
		}
		else
		{
			idxbounce = (idxbounce + 1) % 2;
			image_index = idxbounce * 2;
			image_xscale = sign(hspeed) * 2;
			vspeed *= 0.75;
			timer = 0;
		}
	}
}
");

Apply("gml_Object_obj_plat_enm_gun_Create_0", @"event_inherited();
hp = 3;
t = 0;
image_speed = 0;
