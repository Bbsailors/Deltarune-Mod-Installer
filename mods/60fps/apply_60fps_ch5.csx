check_if_above_ground = function()
{
	var _dist = 40;
	repeat (15)
	{
		var _ground = instance_place(x, y + _dist, obj_plat_floor);
		if (instance_exists(_ground))
		{
			return _ground;
		}
		_dist += 40;
	}
	return -4;
};

dif_type = 1;
scr_plat_set_difference();
scr_plat_set_group(UnknownEnum.Value_3, true);
custom_paused = false;
on_pause = scr_pause_plat_entity;
on_unpause = scr_unpause_plat_entity;

enum UnknownEnum
{
	Value_3 = 3
}
");

Apply("gml_Object_obj_plat_entity_Step_0", @"if (visible_is_active && !visible)
{
	exit;
}
var _wall;
if (wallcollision)
{
	_wall = instance_place(x, y, obj_plat_block);
	if (!instance_exists(_wall) || (_wall.is_barrier && ignore_barriers))
	{
		open_x = x;
		open_y = y;
		stuck_time = 0;
	}
}
if (physics && !paused && !custom_paused)
{
	if (wallcollision)
	{
		if (instance_exists(_wall) && !(_wall.is_barrier && ignore_barriers) && enable_unstuck_failsafe)
		{
			stuck_time++;
			if (stuck_time >= 3)
			{
				stuck_time = 0;
				var _x = x;
				var _y = y;
				x = open_x;
				y = open_y;
				_wall = instance_place(x, y, obj_plat_block);
				if (instance_exists(_wall))
				{
					if (_wall.moving_platform)
					{
						vspeed = 0;
						ground = _wall;
						scr_plat_snap_to_ground();
					}
					else
					{
					}
				}
			}
		}
		wallhitspd = 0;
		var _distcheck = 2;
		var _checks = ceil(abs(hspeed));
		repeat (_checks)
		{
			_wall = instance_place(x - _distcheck, y, obj_plat_block);
			if (_wall != -4 && hspeed <= 0 && !(_wall.is_barrier && ignore_barriers))
			{
				if (hspeed < 0)
				{
					wallhitspd = hspeed;
					hspeed = 0;
				}
				if (x > _wall.bbox_right)
				{
					x = _wall.bbox_right + (round(x) - bbox_left) + 2;
				}
			}
			_wall = instance_place(x + _distcheck, y, obj_plat_block);
			if (_wall != -4 && hspeed >= 0 && !(_wall.is_barrier && ignore_barriers))
			{
				if (hspeed > 0)
				{
					wallhitspd = hspeed;
					hspeed = 0;
				}
				if (x < _wall.bbox_left)
				{
					x = _wall.bbox_left - (bbox_right - round(x)) - 2;
				}
			}
			_distcheck++;
		}
	}
	ground = -4;
	groundedprev = grounded;
	landspd = 0;
	var _ycheck = y + clamp(dif_y * 4, 4, 18);
	if (vspeed > 0)
	{
		_ycheck = y + ceil(abs(vspeed) + 4);
	}
	var _ground = scr_ground_checks(x, _ycheck, 708);
	var _slope = -4;
	if (instance_exists(_ground))
	{
		if (_ground.is_slope)
		{
			_slope = _ground;
		}
	}
	if (vspeed >= 0)
	{
		var _slopecheck = -4;
		if (!ds_exists(__checklist, ds_type_list))
		{
			__checklist = ds_list_create();
		}
		ds_list_clear(__checklist);
		var _num = collision_rectangle_list(bbox_left - 2, (y + bbox_bottom_r) - abs(speed) - 4, bbox_right + 2, y + bbox_bottom_r + 6 + abs(speed), obj_plat_slope, 1, 1, __checklist, 0);
		var i = 0;
		repeat (5)
		{
			slopecheck[i] = 0;
			i++;
		}
		for (i = 0; i < _num; i++)
		{
			var _check = ds_list_find_value(__checklist, i);
			slopecheck[i] = ds_list_find_value(__checklist, i);
			if (_check.image_xscale > 0)
			{
				if (bbox_right >= min(_check.x1, _check.x2) && bbox_right <= max(_check.x1, _check.x2))
				{
					_slopecheck = _check;
				}
				else if (bbox_left >= min(_check.x1, _check.x2) && bbox_left <= max(_check.x1, _check.x2))
				{
					_slopecheck = _check;
				}
			}
			else if (bbox_left >= min(_check.x1, _check.x2) && bbox_left <= max(_check.x1, _check.x2))
			{
				_slopecheck = _check;
			}
			else if (bbox_right >= min(_check.x1, _check.x2) && bbox_right <= max(_check.x1, _check.x2))
			{
				_slopecheck = _check;
			}
		}
		if (instance_exists(_slopecheck))
		{
			_slope = _slopecheck;
		}
		if (instance_exists(_slope))
		{
			_ground = _slope;
		}
	}
	if (can_ride_entities)
	{
		var _entity = scr_ground_entity_checks(x, _ycheck);
		if (instance_exists(_entity))
		{
			_ground = _entity;
		}
	}
	if (instance_exists(_ground) && vspeed >= 0 && !climbing)
	{
		if (!grounded)
		{
			grounded = 1;
		}
		grounded_lastX = x;
		ground = _ground;
		gravity = 0;
		gravity_direction = 270;
		landspd = vspeed;
		vspeed = 0;
		scr_plat_snap_to_ground();
	}
	else
	{
		if (grounded)
		{
			grounded = 0;
			ground = -4;
		}
		gravity = entity_gravity;
		gravity_direction = 270;
		_slope = instance_place(x, y, obj_plat_slope_runner);
		if (vspeed < 0 && instance_exists(_slope))
		{
			while (!instance_place(x, y - 4, obj_plat_block) && instance_place(x, y, _slope))
			{
				y -= 4;
			}
		}
	}
	if (grounded && instance_exists(ground))
	{
		if (ground.quicksand)
		{
			y += (ground.quicksand / global.fps_scale);
		}
		if (ground.conveyor_hspeed != 0)
		{
			var _change = ground.conveyor_hspeed / global.fps_scale;
			if (!instance_place(x + _change, y, obj_plat_block))
			{
				x += _change;
			}
		}
	}
	if (wallcollision)
	{
		var _ceiling = instance_place(x, y - abs(vspeed), obj_plat_block);
		if (_ceiling != -4 && !(_ceiling.is_barrier && ignore_barriers) && vspeed < 0)
		{
			vspeed = 0;
			y += 2;
			gravity = entity_gravity;
			gravity_direction = 270;
		}
	}
	if (vspeed > max_fallspeed)
	{
		vspeed = max_fallspeed;
	}
}
");

Apply("gml_Object_obj_plat_entity_Step_1", @"if (visible_is_active && !visible)
{
	exit;
}
if (hitstop > 0 && !global.pause_plat)
{
	hitstop -= (1 / global.fps_scale);
}
var _paused = hitstop > 0;
if (!custom_paused && _paused)
{
	on_pause();
	paused = 0;
	custom_paused = true;
}
if (custom_paused && !_paused)
{
	on_unpause();
	custom_paused = false;
}
");

Apply("gml_Object_obj_plat_finalflowery_Create_0", @"event_inherited();
hp = 100;
dronesnd = -4;
hsvslider = 0;
physics = false;
entity_gravity = 0;
con = 6;
subcon = 0;
contimer = 0;
subcontimer = 0;
u_alpha = shader_get_uniform(shd_chromatic_reflection, ""iAlpha"");
u_patternangle = shader_get_uniform(shd_chromatic_reflection, ""iPatternAngle"");
u_patterncount = shader_get_uniform(shd_chromatic_reflection, ""iPatternCount"");
u_holoangle = shader_get_uniform(shd_chromatic_reflection, ""iHoloAngle"");
u_time = shader_get_uniform(shd_chromatic_reflection, ""iTime"");
ghost_offset_x = 0;
ghost_offset_y = 0;
press_ui = instance_create(0, 0, obj_marker_fancy);
with (press_ui)
{
	depth = -10;
	
	draw_func = function()
	{
		with (obj_plat_finalflowery)
		{
			if (qte_alpha > 0)
			{
				var white_alpha = 1;
				border_color = 16711680;
				if (subcon >= 2)
				{
					if (subcon == 2)
					{
						border_color = merge_color(c_blue, c_yellow, qte_alpha);
					}
					else
					{
						border_color = 255;
					}
					qte_alpha -= (0.05 / global.fps_scale);
					white_alpha = 0;
				}
				var xx = camerax() + 140;
				var yy = cameray() + obj_plat_player.y + 40;
				draw_sprite_ext(spr_pxwhite, 0, xx, yy, 360, 80, 0, c_black, ceil(qte_alpha));
				draw_set_color(border_color);
				draw_set_alpha(ceil(qte_alpha));
				if (pressbuffer > 0)
				{
					draw_set_color(merge_color(border_color, c_white, pressbuffer / 5));
				}
				d_rectangle(xx - 1, yy - 1, (xx + 360) - 2, (yy + 80) - 2, true);
				d_rectangle(xx, yy, (xx + 360) - 1, (yy + 80) - 1, true);
				draw_sprite_ext(spr_pressfront, 0, xx, yy, 2, 2, 0, c_white, ceil(qte_alpha));
				draw_sprite_ext(spr_pressfront_b, 0, xx, yy, 2, 2, 0, c_white, ceil(qte_alpha));
				draw_sprite_ext(spr_pressspot, 0, xx + 338, yy + 2, 2, 2, 0, c_white, ceil(qte_alpha));
				if (boltframe > 180)
				{
					boltalpha = 1 + ((boltframe - boltx) / 3);
				}
				else if (imagetimer == 0 && boltalive == 1)
				{
					var img = instance_create((xx + 160 + (2 * boltframe * boltspeed)) - (boltx * boltspeed * 2), yy + 2, obj_afterimage);
					with (img)
					{
						sprite_index = spr_attackspot;
						image_alpha = 0.4;
						depth = -11;
					}
				}
				if (boltalive == 1)
				{
					draw_sprite_ext(spr_attackspot, 0, (xx + 160 + (2 * boltframe * boltspeed)) - (boltx * boltspeed * 2), yy + 2, 2, 2, 0, c_white, boltalpha * ceil(qte_alpha));
				}
				if (qte_alpha < 1 && white_alpha > 0)
				{
					draw_sprite_ext(spr_pxwhite, 0, xx, yy, 360, 80, 0, c_white, cos(ceil(qte_alpha)));
				}
				draw_set_color(c_white);
				draw_set_alpha(1);
			}
		}
	};
}
only_jarona = true;
for (i = 0; i < 5; i += 1)
{
	if (global.hp[i] < global.maxhp[i])
	{
		global.hp[i] = global.maxhp[i];
	}
}
chargesnd = -4;
sunset_index = 0;
sunset_cycle = [2, 3, 4, 5, 6];
