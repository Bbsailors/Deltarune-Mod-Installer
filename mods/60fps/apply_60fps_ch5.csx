");

Apply("gml_Object_obj_plat_bulletred_shuriken_Step_0", @"if (global.pause_plat)
{
	exit;
}
image_angle += rotation_speed;
if (instance_exists(obj_platswap))
{
	if (obj_platswap.mode == 1)
	{
		if (!depthinit)
		{
			scr_plat_wallcast();
			depthinit = 1;
		}
	}
	else
	{
		depthinit = 0;
	}
}
if (is_culled)
{
	exit;
}
timer += (1 / global.fps_scale);
if (_startsides > 0 && (timer % 3) == 0)
{
	with (obj_dw_fcastle_obscured_bullets)
	{
		var ww = other.sprite_width - 20;
		var ang = other.image_angle;
		var _inc = 360 / other._startsides;
		particle_system.depth = other.depth + 1;
		for (var i = 0; i < other._startsides; i++)
		{
			particle_system.x = other.x + lengthdir_x(ww, ang);
			particle_system.y = other.y + lengthdir_y(ww, ang);
			particle_struct.image_angle = ang;
			particle_struct.image_alpha = other.visible_outside_fusuma;
			particle_system.emit(particle_struct);
			ang += _inc;
		}
	}
}
");

