Apply("gml_Object_obj_pinkcatbullet_Step_0", @"if (wall_destroy == 1)
{
	if (x < (__view_get(e__VW.XView, 0) - 80) && hspeed <= 0)
	{
		instance_destroy();
	}
	if (x > (__view_get(e__VW.XView, 0) + 760) && hspeed >= 0)
	{
		instance_destroy();
	}
	if (y < (__view_get(e__VW.YView, 0) - 80))
	{
		instance_destroy();
	}
	if (y > (__view_get(e__VW.YView, 0) + 580))
	{
		instance_destroy();
	}
}
life_time += (1 / global.fps_scale);
if (spin_radius > 0)
{
	spin_dir -= (45 / global.fps_scale);
	if (spin_dir < 0)
	{
		spin_dir += 360;
	}
	x += (lengthdir_x(spin_radius, spin_dir) / global.fps_scale);
	y += (lengthdir_y(spin_radius, spin_dir) / global.fps_scale);
}
switch (mode)
{
	case 1:
		float_dir += (5 / global.fps_scale);
		if (float_dir >= 360)
		{
			float_dir -= 360;
		}
		x += (lengthdir_x(0.75, float_dir) / global.fps_scale);
		if (x > scr_get_box(2) && x < scr_get_box(0))
		{
			if (x < scr_get_box(4))
			{
				x -= (1 / global.fps_scale);
			}
			else
			{
				x += (1 / global.fps_scale);
			}
		}
		break;
	case 2:
		float_dir += (10 / global.fps_scale);
		if (float_dir >= 360)
		{
			float_dir -= 360;
		}
		x += (lengthdir_x(0.25, float_dir) / global.fps_scale);
		break;
}

