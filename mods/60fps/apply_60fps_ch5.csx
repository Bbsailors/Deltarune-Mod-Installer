};
falling_petal_particle_system = instance_create_depth(0, 0, depth - 1, obj_custom_particle_system);
falling_petal_particle_system.default_particle_data.sprite_index = spr_falling_petal;
falling_petal_particle_system.default_particle_data.image_speed = 1;
falling_petal_particle_system.default_particle_data.image_alpha = 0.8;
falling_petal_particle_system.default_particle_data.fadeout_speed = -0.05;
falling_petal_particle_system.default_particle_data.lifetime = 180;

falling_petal_particle_system.particle_step_func = function(arg0)
{
	arg0.image_speed -= 0.013333333333333334 / global.fps_scale;
	arg0.hspeed += arg0.custom_data[0] / global.fps_scale;
	arg0.vspeed += arg0.custom_data[1] / global.fps_scale;
};

