Apply("gml_Object_obj_plat_vinehook_small_Step_0", @"if (!init)
{
	init = true;
	depthbonus = 0;
	if (scr_flag_get_ext(1867, 0) == 1)
	{
		dog = false;
	}
	if (scr_flag_get_ext(1867, 1) == 1)
	{
		dog = false;
	}
	hook = instance_create_depth(x, y + 80, depth, obj_ralsei_hook);
	with (hook)
	{
		dog = other.dog;
		sprite_index = other.sprite_index;
		image_index = 2;
		image_speed = 0;
		menu_name = stringsetloc(""Hook"", ""obj_plat_vinehook_small_slash_Step_0_gml_16_0"");
		menu_name_orig = menu_name;
		menu_desc_orig = menu_desc;
		if (dog)
		{
			menu_name = stringsetloc(""Dog"", ""obj_plat_vinehook_small_slash_Step_0_gml_18_0"");
			menu_desc = stringsetloc(""If it hooks, a dog will hang."", ""obj_plat_vinehook_small_slash_Step_0_gml_19_0"");
		}
		owner = other;
		can_cut_down = other.can_cut_down;
		causes_splat = other.splats;
		hang_yoffset = 30;
		hang_xoffset = 14;
		if (!other.retreats)
		{
			hang_yoffset -= 10;
		}
		else
		{
			hang_yoffset += 50;
			hang_xoffset += 6;
		}
		image_xscale = other.image_xscale;
		image_yscale = other.image_yscale;
	}
}
if (global.pause_plat)
{
	exit;
}
if (retreats)
{
	if (retreat_state == 0)
	{
		if (hook.ralsei_ready)
		{
			retreat_timer += (1 / global.fps_scale);
			var maximum = 120;
			if (retreat_timer == (maximum - 30))
			{
				scr_shakeobj(hook);
				snd_play(snd_grab);
			}
			if (retreat_timer == maximum)
			{
				retreat_state = 1;
				with (obj_plat_follower)
				{
					ralsei_fall_down(60);
				}
				retreat_timer = 0;
			}
		}
		else if (retreat_timer > 0)
		{
			with (hook)
			{
				_act.blocked = true;
				if (_actsu != -4)
				{
					_actsu.blocked = true;
				}
			}
			retreat_state = 1;
			retreat_timer = 0;
		}
	}
	else
	{
		with (hook)
		{
			_act.blocked = true;
			if (_actsu != -4)
			{
				_actsu.blocked = true;
			}
		}
		retreat_timer += (1 / global.fps_scale);
		if (retreat_timer == 1)
		{
			with (hook)
			{
				image_index = 1;
			}
		}
		if (retreat_timer == -1)
		{
			retreat_state = 0;
			retreat_timer = 0;
			with (hook)
			{
				_act.blocked = false;
				if (_actsu != -4)
				{
					_actsu.blocked = false;
				}
			}
			with (hook)
			{
				image_index = 0;
			}
		}
	}
}
");

Apply("gml_Object_obj_plat_wind_Alarm_0", @"if (global.pause_plat)
{
	alarm[0] = 2;
	exit;
}
var _len = irandom(sprite_height / 2) * choose(-1, 1);
var _dir = image_angle - 90;
var _x = x + lengthdir_x(_len, _dir);
var _y = y + lengthdir_y(_len, _dir);
var no_wind = false;
var wdir = 0;
with (obj_plat_windcontroller_new)
{
	if (winddirection == -1 || strength == 0)
	{
		no_wind = true;
	}
	wdir = winddirection;
}
timer += (1 / global.fps_scale);
if (strength > 0 && !no_wind)
{
	var cx, cx2, cy, cy2;
	if (i_ex(obj_plat_camera))
	{
		cx = obj_plat_camera.x - 240;
		cx2 = obj_plat_camera.x + 240;
		cy = obj_plat_camera.y - 240;
		cy2 = obj_plat_camera.y + 240;
	}
	else
	{
		cx = camerax();
		cx2 = cx + camerawidth();
		cy = cameray();
		cy2 = cy + cameraheight();
	}
	if ((timer % 25) == 0)
	{
		var _skip = false;
		with (obj_battlealphaer)
		{
			if (cur_alpha > 0.1)
			{
				_skip = true;
			}
		}
		if (!_skip)
		{
			var randx = random_range(max(bbox_left, cx - 200), min(bbox_right, cx2 + 200));
			var randy = random_range(max(bbox_top, cy - 200), min(bbox_bottom, cy2 + 200));
			var offx = lengthdir_x(-300, wdir);
			var offy = lengthdir_y(-300, wdir);
			with (instance_create_depth(offx + randx, offy + randy, 11000, obj_plat_windswirl))
			{
				direction = wdir;
				speed = (10 + irandom(20)) / global.fps_scale;
			}
		}
	}
}
alarm[0] = 2;
");

Apply("gml_Object_obj_plat_wind_particle_Step_0", @"t += (1 / global.fps_scale);
if (owner != -4 && !instance_place(x, y, owner) && t >= 1)
{
	instance_destroy();
}
if (!controllerimmune)
{
	if (i_ex(obj_plat_windcontroller_new))
	{
		if (obj_plat_windcontroller_new.winddirection == -1)
		{
			direction = scr_angle_lerp(direction, 270, 0.3);
			speed = lerp(speed, 0.2 / global.fps_scale, scr_fps_lerp_rate(0.3));
		}
		else
		{
			direction = scr_angle_lerp(direction, obj_plat_windcontroller_new.winddirection, 0.3);
			speed = lerp(speed, startspeed * obj_plat_windcontroller_new.strength, scr_fps_lerp_rate(0.3));
		}
		image_angle = direction;
	}
}
");

Apply("gml_Object_obj_plat_windboost_Create_0", @"timer = random_range(0, 300);
timerend = timer + 200;
winddir = 0;
i_wave = shader_get_uniform(shd_windwave, ""iWave"");
i_wave_mod = shader_get_uniform(shd_windwave, ""iWaveModifier"");
image_yscale = max(room_width, room_height) / 17;
image_alpha = 0;
alpha = 0.1;
depth = 49000;
speed = 25 / global.fps_scale;
last_speed = -4;
");

Apply("gml_Object_obj_plat_windboost_Draw_0", @"draw_set_blend_mode(bm_add);
shader_replace_simple_set_hook(40);
if (severe)
{
	if (!global.pause_plat)
	{
		speed *= power(1.05, 1 / global.fps_scale);
	}
}
shader_set_uniform_f(i_wave, timer * 0.1, 0.0025, 15005.5);
shader_set_uniform_f(i_wave_mod, timer * 0.1, timerend * 0.01, -0.01);
draw_self();
shader_replace_simple_reset_hook();
draw_set_blend_mode(bm_normal);
");

Apply("gml_Object_obj_plat_windboost_Step_0", @"if (global.pause_plat)
{
	if (last_speed == -4)
	{
		last_speed = speed;
	}
	speed = 0;
	exit;
}
else
{
	if (last_speed != -4)
	{
		speed = last_speed;
		last_speed = -4;
	}
	timer += (1 / global.fps_scale);
}
if (instance_exists(obj_plat_windcontroller_new))
{
	if (obj_plat_windcontroller_new.winddirection != winddir)
	{
		image_alpha -= (0.05 / global.fps_scale);
		speed = scr_approach(speed, 0, 0.1 / global.fps_scale);
		if (image_alpha < 0)
		{
			instance_destroy();
		}
	}
	else
	{
		speed = scr_approach(speed, 7 / global.fps_scale, 0.1 / global.fps_scale);
		image_angle = direction;
		image_alpha = scr_approach(image_alpha, alpha, 0.02);
	}
}
if (timer >= timerend && !scr_onscreen(self))
{
	image_alpha -= (0.05 / global.fps_scale);
	speed = scr_approach(speed, 0, 0.1 / global.fps_scale);
	if (image_alpha < 0)
	{
		instance_destroy();
	}
}
");

