Apply("gml_Object_obj_dw_castle_church_climb_Draw_0", @"var _cx = camerax();
var _cy = cameray();
with (scoreboard)
{
	var active = false;
	if (other.climbingcon == 1)
	{
		active = true;
	}
	siner += (1 / global.fps_scale);
	image_index += 0.5;
	var _time = 0;
	if (active)
	{
		_time = other.fulltime - other.timber;
	}
	if (other.thisclimbtime != -1)
	{
		_time = other.thisclimbtime;
	}
	if (active)
	{
		x = lerp(x, _cx + 40, scr_fps_lerp_rate(0.125));
		y = lerp(y, _cy + 340 + (sin(siner / 15) * 8), scr_fps_lerp_rate(0.25));
	}
	else if (other.thisclimbtime != -1)
	{
		x = lerp(x, _cx + 30, scr_fps_lerp_rate(1/30));
		y = lerp(y, _cy + 30 + (sin(siner / 15) * 4), scr_fps_lerp_rate(0.08333333333333333));
	}
	else
	{
		x = lerp(x, _cx - 40, scr_fps_lerp_rate(0.25));
		y = lerp(y, _cy + 540, scr_fps_lerp_rate(0.25));
	}
	var formatted = floor(_time / 3);
	var num = other.formatnum(formatted);
	var col = merge_color(#FFFFC2, c_white, 0.5 + (sin(siner / 15) * 0.5));
	if (formatted >= 999)
	{
		col = merge_color(c_red, #8781BE, scr_progress(formatted, 999, 9000, 0, 1));
	}
	if (formatted >= 9000)
	{
		x += random_range(-1, 1);
		y += random_range(-1, 1);
	}
	if (formatted == 0)
	{
		col = 1184274;
	}
	if (other.thisclimbtime != -1)
	{
		col = 187386;
	}
	draw_sprite_ext(spr_glowpuzzletimer_simple, 0, x, y, 2, 2, 0, c_white, 1);
	draw_sprite_ext(spr_pxwhite, 0, x + 9, y + 9, 66, 32, 0, c_black, 0.5);
	for (var i = 0; i < 3; i++)
	{
		var bon = 0;
		if (i == 2)
		{
			bon = 4;
		}
		draw_sprite_ext(spr_timer_digits, num[i], (x - 24) + (20 * i) + bon, y - 10, 2, 2, 0, col, 1);
	}
	draw_sprite_ext(spr_pxwhite, 0, x + 50, y + 36, 4, 4, 0, col, 1);
	draw_sprite_ext(spr_glowpuzzletimer_simple_fire, siner / 2, x + 6, y + 50, 2, 2, 0, c_white, 1);
	draw_sprite_ext(spr_glowpuzzletimer_simple_fire, siner / 2, x + 64, y + 50, 2, 2, 0, c_white, 1);
}
