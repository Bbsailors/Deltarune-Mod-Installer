	else if (smashed)
	{
		marker.image_index = 1;
	}
	else
	{
		marker.image_index = 0;
	}
	siner += (1 / global.fps_scale);
	if (enhanced)
	{
		marker.image_blend = merge_color(c_white, c_yellow, 0.5 - (abs(sin(siner / 15)) * 0.5));
	}
	else
	{
		marker.image_blend = c_white;
	}
	if (myinteract == 3)
	{
