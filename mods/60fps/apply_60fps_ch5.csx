Apply("gml_Object_obj_plat_enm_aqua_miniboss_Step_0", @"event_inherited();
if (!instance_exists(obj_plat_player))
{
	scr_flower_despwn();
	exit;
}
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (is_stunned)
{
	exit;
}
if (!can_attack)
{
	exit;
}
reteleport_timer += (1 / global.fps_scale);
knifecount = 12 - hp;
var timerlimit = 45 + (2 * hp);
var attacklimit = 2 + floor(hp / 2);
if (instance_exists(obj_dw_garden_aquaplatforming))
{
	var tt = obj_dw_garden_aquaplatforming.enemywavetimer / 2700;
	knifecount = max(knifecount, floor(lerp(3, 12, tt)));
	timerlimit = min(timerlimit, ceil(lerp(67, 45, tt)));
	attacklimit = min(attacklimit, ceil(lerp(8, 2, tt)));
}
else
{
	var num_enemies = instance_number(obj_flower_enmparent);
	knifecount = ceil(knifecount / num_enemies);
}
if (protected)
{
	knifecount = floor(6 - (0.5 * hp));
}
contimer += (1 / global.fps_scale);
if (con == 2)
{
	evadecon = 0;
}
if (evadecon > 0)
{
	evadetimer += (1 / global.fps_scale);
	if (evadetimer == 1)
	{
		remx = x;
		remy = y;
	}
	var evade_ease = ease_out_quad(evadetimer / 10, 0, 1, 1);
	x = lerp(remx, remx + (12 * evadedirection), evade_ease);
	y = lerp(remy, remy - 4, evade_ease);
	if (evadetimer == 10)
	{
		evadecon = 0;
	}
}
if (con == 0)
{
	if (contimer == 30)
	{
		con = 1;
		contimer = 0;
	}
}
else if (con == 1)
{
	if (contimer == 2)
	{
		snd_play(snd_wing);
		flash_hurt(16777215);
	}
	if (contimer == 6)
	{
		attacking = true;
	}
	if (contimer >= timerlimit && evadecon == 0)
	{
		con = 2;
		nextlerp = (nextlerp + 1) % 4;
		contimer = 0;
		if (regular_enemy)
		{
			var len = random_range(140, 220) + (5 * abs(obj_plat_player.hspeed) * global.fps_scale);
			var dir = 0;
			if (obj_plat_player.x < x)
			{
				dir = random_range(-55, 55) + 180;
			}
			else
			{
				dir = random_range(-55, 55);
			}
			gx = clamp(x + lengthdir_x(len, dir), camerax() + 40, camerax() + 600);
			gy = clamp(y + lengthdir_y(len, dir), max(cameray() + 120, obj_plat_player.y - 100), obj_plat_player.y - 40);
			gtime = 15;
		}
		else
		{
			gx = xstart + (targetlerp[nextlerp][0] * -320);
			gy = ystart + (targetlerp[nextlerp][1] * 120);
			gtime = targetlerp[nextlerp][2];
		}
		lerpinst[0] = scr_lerpvar(""x"", x, gx, gtime, 2, ""inout"");
		lerpinst[1] = scr_lerpvar(""y"", y, gy, gtime, 2, ""inout"");
	}
}
else if (con == 2)
{
	if (frac(contimer) == 0)
	{
		scr_afterimage_monochrome(get_tint_blend(), true).image_alpha = 0.3;
	}
	if (contimer >= targetlerp[nextlerp][2])
	{
		con = 1;
		contimer = 0;
	}
}
if (attacking)
{
	attacking = false;
	attacktimer = 0;
	nextknife = 0;
	var _p = 912;
	aim = 0;
	if (instance_exists(_p))
	{
		aim = point_direction(x, y, _p.x, _p.y);
		aim += (-5 + irandom(10));
	}
	throwdir = choose(-1, 1);
	aim += (throwdir * (30 * knifecount * 0.5));
}
if (attacktimer >= 0)
{
