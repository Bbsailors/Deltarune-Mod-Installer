Apply("gml_Object_obj_dw_garden_fishingspot_Create_0", @"layer_set_visible(""DEBUG_ASSETS"", 0);
layer_set_visible(""NPCs"", 0);
con = 0;
timer = 0;
init = 0;
visible = true;
if (layer_exists(""ASSETS_Flowers""))
{
	var daspritez = [];
	layer_set_visible(""ASSETS_Flowers"", false);
	var elements = layer_get_all_elements(""ASSETS_Flowers"");
	for (var j = 0; j < array_length(elements); j++)
	{
		if (layer_get_element_type(elements[j]) == 4)
		{
			var spr = elements[j];
			var sprinfo = 
			{
				sprite_index: layer_sprite_get_sprite(spr),
				image_index: layer_sprite_get_index(spr),
				image_speed: layer_sprite_get_speed(spr),
				image_xscale: layer_sprite_get_xscale(spr),
				image_yscale: layer_sprite_get_yscale(spr),
				image_angle: layer_sprite_get_angle(spr),
				image_blend: layer_sprite_get_blend(spr),
				image_alpha: layer_sprite_get_alpha(spr),
				x: layer_sprite_get_x(spr),
				y: layer_sprite_get_y(spr)
			};
			array_push(daspritez, sprinfo);
		}
	}
	for (var i = 0; i < array_length(daspritez); i++)
	{
		var spr = daspritez[i];
		scr_marker_ext(scr_even(spr.x), scr_even(spr.y), spr.sprite_index, spr.image_xscale, spr.image_yscale, spr.image_angle, spr.image_index, spr.image_blend, undefined, 1, undefined, spr.image_alpha);
	}
}
visible = true;
viewcount = 0;
if (global.flag[1315] || global.plot >= 243)
{
	viewcount = 99;
}
con = 0;
shinecon = 0;
npc_sign = scr_makenpc_fromasset(findsprite(spr_npc_sign, undefined, #FFB2B2));
npc_sign.marker.image_blend = c_white;
npc_sign2 = scr_makenpc_fromasset(findsprite(spr_npc_sign, undefined, c_red));
npc_sign2.marker.image_blend = c_white;
npc_worm = scr_makenpc_fromasset(findsprite(spr_kooby_undeveloped, undefined, c_red));
npc_worm.marker.sprite_index = spr_kooby_undeveloped_eating;
npc_worm.marker.image_blend = c_white;
koobycon = 0;
koobytimer = 0;
worm_fill = 0;

npc_worm.can_water = function()
{
	return worm_fill < 1;
};

npc_worm.draw_watering_reticle = function()
{
	with (obj_dw_garden_fishingspot.npc_worm.marker)
	{
		scr_draw_outline(2, 16776960, 1);
	}
};

develop_worm = function()
{
	worm_fill += (0.02 / global.fps_scale);
	npc_worm.marker.image_index = 1;
	if (worm_fill >= 1)
	{
		worm_fill = 1;
		develop_worm_finish();
	}
};

develop_worm_finish = function()
{
	npc_worm.marker.sprite_index = spr_kooby_developed;
	global.interact = 1;
	koobycon = 1;
	global.flag[1372] = 1;
	snd_play(snd_magicsprinkle, 0.75, 0.9);
	scr_lerpvar(""image_alpha"", 1, 0, 60);
	with (obj_waterable_trigger)
	{
		instance_destroy();
	}
};

layer_set_visible(""ASSETS_AsgoreSeq1"", false);
");

Apply("gml_Object_obj_dw_garden_fishingspot_Step_0", @"if (!init)
{
	init = 1;
	if (global.flag[1372] == 1)
	{
		npc_worm.marker.sprite_index = spr_kooby_developed_eating;
		koobycon = 2;
		with (obj_waterable_trigger)
		{
			instance_destroy();
