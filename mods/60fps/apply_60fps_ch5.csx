var _history_i = array_length(player_movement_history) - 1;
while (_history_i > 0)
{
	player_speedx_average += (player_movement_history[_history_i - 1][0] - player_movement_history[_history_i][0]);
	player_speedy_average += (player_movement_history[_history_i - 1][1] - player_movement_history[_history_i][1]);
	array_set(player_movement_history, _history_i, player_movement_history[_history_i - 1]);
	_history_i--;
}
player_speedx_average += (obj_mainchara.x - player_movement_history[0][0]);
player_speedy_average += (obj_mainchara.y - player_movement_history[0][1]);
array_set(player_movement_history, 0, [obj_mainchara.x, obj_mainchara.y]);
player_speedx_average /= array_length(player_movement_history);
player_speedy_average /= array_length(player_movement_history);
if (foxcon == 0)
{
	if (scr_trigcheck(""stackbreak""))
	{
		var applied_speed = point_distance(0, 0, player_speedx_average, player_speedy_average);
		var applied_direction = point_direction(0, 0, player_speedx_average, player_speedy_average);
		with (obj_dw_garden_shroomstack)
		{
			var stacklength = array_length(stack);
			if (stacklength > 1)
			{
				with (instance_create(obj_mainchara.x + (0.5 * obj_mainchara.sprite_width), obj_mainchara.y - 20, obj_marker))
				{
