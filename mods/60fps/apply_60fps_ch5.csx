				shader_replace_simple_reset_hook();
				surface_reset_target();
			}
			draw_surface_ext(surf, x + 46, y + 10, 2, 2, 0, c_white, 1);
			var pos = 
			{
				x1: x + 6,
				y1: y + 36,
