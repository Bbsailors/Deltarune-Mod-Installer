	c_msgside(""bottom"");
	c_speaker(""flowery"");
	c_msgsetloc(0, ""\\E3* Harvesting more of your old \""personal notes,^1\"" huh?/%"", ""obj_ch5_DWCL00_slash_Step_0_gml_154_0"");
