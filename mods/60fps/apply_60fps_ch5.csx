	y = ystart + (cos(contimer * 0.4) * 6);
}
if (grounded)
{
	for (var spd = 1; spd <= 2; spd++)
	{
		for (var i = -1; i < 2; i += 2)
		{
			var bullet = instance_create(x, y - 20, obj_plat_bulletred);
			with (bullet)
			{
				do_contact_kill = function()
				{
					with (scr_plat_vfx(3614))
