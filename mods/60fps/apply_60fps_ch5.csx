		for (var i = 0; i <= target; i++)
		{
			facing[i] = global.facing;
		}
		depth = _d;
		ignoredepth = 1;
		scr_delay_var(""ignoredepth"", 0, 3);
	}
	instance_destroy();
}
instance_destroy();
");

Apply("gml_Object_obj_mainchara_dash_Create_0", @"scr_get_inputs(false);
t = 0;
wraparound = 0;
dashtimer = 0;
make_afterimages = !instance_exists(obj_dw_cliff_kawkawdash) && !instance_exists(obj_dw_cliff_gardentransition_new);
disable_control = 0;
spawn_water_splash = false;
if (global.flag[1389] > 0)
{
	camera_distance = global.flag[1389];
}
mudstay = 0;
touching_mud = false;
cam = instance_create(x, y, obj_dashmode_camera);
nudgex = 0;
nudgey = 0;
nudgelerp = 0.2;
with (cam)
{
	sprite_index = spr_plat_kris_ball;
	visible = 0;
	image_speed = 0;
	accel = 0.05;
	speeds_stored = 0;
	stored_hspeed = 0;
	stored_vspeed = 0;
	nudgex = obj_mainchara.nudgex;
	nudgey = obj_mainchara.nudgey;
}
camera_set_view_target(view_camera[0], cam);
with (obj_camera_advanced)
{
	other.nudgex = nudgex;
	other.nudgey = nudgey;
}
hitstop = 0;
speeds_stored = 0;
stored_hspeed = 0;
stored_vspeed = 0;
last_openX = x;
last_openY = y;
bg = 0;
if (instance_exists(obj_backgrounderparent))
{
	bg = 1;
}
run = 1;
stopping = 0;
jumping = 0;
jumppos = 0;
jumpspd = 34;
runspeed = 20 / global.fps_scale;
runspeed_max = runspeed;
on_slope = false;
jumpspdinit = 23;
jumpgravity = 0.4;
if (instance_exists(obj_dw_cliff_gardentransition_new))
{
	runspeed = 27 / global.fps_scale;
	runspeed_max = 27 / global.fps_scale;
}
bonkheight = 14;
impacted = 0;
impact_wait = 0;
shake = 0;
shake_angle = 0;
afterimage = -4;
image_xscale = 2;
image_yscale = 2;
drown = 0;
myheight = 40;
drawbattlemode = 1;
battlemode = 0;
battleheart = instance_create(x, y, obj_overworldheart);
battleheart.image_alpha = 0;
battleheart.image_speed = 0;
battlealpha = 0;
becamebattle = 0;
transition = false;

update_camera = function()
{
	if (instance_exists(cam))
	{
		var _cx = cam.x;
		camera_set_view_target(view_camera[0], cam);
		var _accel = 0.02;
		if (!hitstop || true)
		{
			var roomw = room_width;
			var roomh = room_height;
			var vieww = camera_get_view_width(view_camera[0]);
			var viewh = camera_get_view_height(view_camera[0]);
			if (stopping)
			{
				camera_distance = scr_approach(camera_distance, 0, (1 - (runspeed / runspeed_max)) * camera_distance);
			}
			var _dist = (runspeed * sign(image_xscale)) + (camera_distance * sign(image_xscale));
			if (impacted || drown || stopping)
			{
				_dist = lerp(_dist, 0, ease_out_sine(clamp01((10 - (alarm[2] / global.fps_scale)) / 10), 0, 1, 1));
			}
			if (impacted)
			{
				_dist = 0;
			}
			var _x = x + _dist;
			var _y = y - jumppos;
			if (impacted)
			{
				_y = y;
			}
			var nudger = instance_place(x, y, obj_camera_nudger);
			if (i_ex(nudger))
			{
				if (nudger.lerpstrength != -4)
				{
					nudgelerp = nudger.lerpstrength;
				}
				var _yoff = -2;
				if (nudger.yamt > 0)
				{
					_yoff = 2;
				}
				var _xoff = -2;
				if (nudger.xamt > 0)
				{
					_xoff = 2;
				}
				nudgex = lerp(nudgex, nudger.xamt + _xoff, scr_fps_lerp_rate(nudgelerp));
				nudgey = lerp(nudgey, nudger.yamt + _yoff, scr_fps_lerp_rate(nudgelerp));
				nudgex = clamp(nudgex, abs(nudger.xamt) * -1, abs(nudger.xamt));
				nudgey = clamp(nudgey, abs(nudger.yamt) * -1, abs(nudger.yamt));
			}
			else if (nudgelerp != -4)
			{
				nudgex = lerp(nudgex, 0, scr_fps_lerp_rate(nudgelerp));
				nudgey = lerp(nudgey, 0, scr_fps_lerp_rate(nudgelerp));
			}
			_x = _x + nudgex;
			_y = _y + nudgey;
			var clamper = instance_place(x, y, obj_camera_clamper);
			if (i_ex(clamper))
			{
				var hw = vieww / 2;
				var hh = viewh / 2;
				var lclamp = 0;
				var rclamp = roomw;
				var uclamp = 0;
				var dclamp = roomh;
				if (clamper.xmin != -4)
				{
					lclamp = clamper.xmin;
				}
				if (clamper.xmax != -4)
				{
					rclamp = clamper.xmax;
				}
				if (clamper.ymin != -4)
				{
					uclamp = clamper.ymin;
				}
				if (clamper.ymax != -4)
				{
					dclamp = clamper.ymax;
				}
				_x = clamp(_x, lclamp + hw, rclamp + hw);
				_y = clamp(_y, uclamp + hh, dclamp + hh);
			}
			with (cam)
			{
				if (other.transition)
				{
					x = _x;
					y = _y;
					other.hspeed = other.runspeed * sign(other.image_xscale);
					other.transition = false;
				}
				var _spd = abs(_x - x);
				var _spdy = abs(_y - y);
				accel = scr_approach(accel, 1, _accel + (0.05 * accel));
				var _ra = (accel >= 1) ? accel : (1 - power(1 - accel, 1 / global.fps_scale));
				_spd *= (_ra * global.fps_scale);
				_spdy *= (_ra * global.fps_scale);
				if (other.hitstop <= 0)
				{
					x = scr_approach(x, _x, _spd);
					y = scr_approach(y, _y, _spdy);
					x = clamp(x, 320, room_width - 320);
					y = clamp(y, 240, room_height - 240);
				}
			}
		}
		else
		{
			cam.speed *= 0.5;
		}
		with (cam)
		{
			scr_get_vxy(0);
			camerax_set(floor(x - (vw / 2)));
			cameray_set(floor(y - (vh / 2)));
			if (other.hitstop > 0)
			{
				if (!speeds_stored)
				{
					speeds_stored = 1;
					stored_hspeed = hspeed;
					stored_vspeed = vspeed;
				}
				hspeed = 0;
				vspeed = 0;
			}
			else if (speeds_stored)
			{
				speeds_stored = 0;
				hspeed = stored_hspeed;
				vspeed = stored_vspeed;
			}
		}
	}
};
");

Apply("gml_Object_obj_mainchara_dash_Draw_0", @"var _x = x + (lengthdir_x(shake, shake_angle) * 2);
var _y = y + (lengthdir_y(shake, shake_angle) * 2);
if (jumping)
{
	_y -= jumppos;
	draw_set_color(c_black);
	var _radius = max(0, lerp(40, 0, jumppos / 120));
	var _x1 = x - lengthdir_x(_radius, 45);
	var _y1 = 20 + y + (lengthdir_y(_radius, 45) * 0.4);
	var _x2 = x + lengthdir_x(_radius, 315);
	var _y2 = 20 + y + (lengthdir_y(_radius, 315) * 0.4);
	if (!i_ex(obj_sunshadows))
	{
		draw_ellipse(_x1, _y1, _x2, _y2, 0);
	}
}
if (battlemode == 1)
{
	becamebattle = 1;
	if (battlealpha < 0.8 && drawbattlemode)
	{
		battlealpha += (0.04 / global.fps_scale);
	}
	global.heartx = x - 12 - camerax();
	global.hearty = y - 12 - cameray();
}
else if (battlealpha > 0)
{
	battlealpha -= (0.08 / global.fps_scale);
}
battleheart.image_alpha = battlealpha;
draw_sprite_ext(spr_heart_outline2, 0, x + -12, y, 1, 1, 0, c_white, battlealpha * 2);
with (obj_dmgwriter)
{
	x = other.x + 60;
}
battleheart.x = x - 12;
battleheart.y = y;
draw_sprite_ext(sprite_index, image_index, _x, _y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
draw_sprite_ext(spr_kris_plat_run_heart, image_index, _x, _y, image_xscale, image_yscale, image_angle, (global.inv > 0) ? c_blue : image_blend, battlealpha);
if (spawn_water_splash)
{
	if (spawn_water_splash == 1)
	{
		draw_sprite_ext(spr_dash_splash, current_time / 50, x - (12 * image_xscale), y + 36, image_xscale, image_yscale, 0, c_white, 1);
	}
	else
	{
		draw_sprite_ext(spr_dash_splash_dark, current_time / 50, x - (12 * image_xscale), y + 36, image_xscale, image_yscale, 0, c_white, 1);
	}
}
");

Apply("gml_Object_obj_mainchara_dash_Other_10", @"impacted = 1;
bounces = 0;
shake = 10;
hspeed = 0;
vspeed = 0;
cam.accel = 0;
with (obj_caterpillar_dash)
{
