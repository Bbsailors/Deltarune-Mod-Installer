			scr_size(2, 2);
			scr_depth();
			depth -= 300;
			col = 13471693;
			image_blend = col;
			siner = 0;
			
			step_func = function()
			{
				with (owner)
				{
					if (instance_exists(marker))
					{
						other.depth = marker.depth - 1;
					}
				}
				siner += (1 / global.fps_scale);
				image_index += (0.16666666666666666 / global.fps_scale);
				var targ = instance_exists(obj_cutscene_master);
				image_alpha = lerp(image_alpha, ((sin(siner / 15) * 0.25) + 0.8) * !d_ex(), scr_fps_lerp_rate(0.8)) * alpha;
				image_blend = merge_color(c_white, col, (sin(siner / 15) * 0.5) + 0.5);
				visible = 1 - array_get(scr_platswap_yscale(), 0);
			};
		}
	}
};

