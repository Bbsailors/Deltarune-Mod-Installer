Apply("gml_Object_obj_dooranimation_Step_0", @"if (animation == 1)
{
	if (con == 1)
	{
		con = 2;
		with (obj_persistentfadein)
		{
			instance_destroy();
		}
		scr_fadein(15);
		global.flag[7] = 1;
	}
	if (con == 2)
	{
		global.interact = 1;
		with (obj_mainchara)
		{
			event_perform(ev_step, ev_step_end);
		}
		with (obj_mainchara)
		{
			cutscene = 1;
		}
		with (obj_caterpillarchara)
		{
			if (name == ""ralsei"")
			{
				other.ralsei = self;
			}
			if (name == ""susie"")
			{
				other.susie = self;
			}
		}
		with (obj_mainchara)
		{
			y -= 200;
			sprite_index = spr_kris_jump_ball_fixed;
			image_speed = 0.5 / global.fps_scale;
		}
		if (instance_exists(susie))
		{
			susie.x = obj_mainchara.x - 40;
			susie.y = obj_mainchara.y - 40 - 4;
			susie.sprite_index = spr_susie_dw_jump_ball;
		}
		if (instance_exists(ralsei))
		{
			ralsei.x = obj_mainchara.x + 30 + 2;
			ralsei.y = obj_mainchara.y - 60;
			ralsei.sprite_index = spr_ralsei_jump_ball;
		}
		cutscene_master = scr_cutscene_make();
		scr_maincharacters_actors();
		c_sel(kr);
		c_lerpvar_instance(kr_actor, ""y"", kr_actor.y, kr_actor.y + 200, 10);
		if (instance_exists(susie))
		{
			c_sel(su);
			c_lerpvar_instance(su_actor, ""y"", su_actor.y, su_actor.y + 220, 10);
		}
		if (instance_exists(ralsei))
		{
			c_sel(ra);
			c_lerpvar_instance(ra_actor, ""y"", ra_actor.y, ra_actor.y + 240, 10);
		}
		c_wait(10);
		c_sel(kr);
		c_facing(""d"");
		c_sprite(spr_kris_dw_landed);
		c_snd_play(snd_wing);
		c_shakeobj();
		if (instance_exists(ralsei))
		{
			c_sel(ra);
			c_facing(""d"");
			c_sprite(spr_ralsei_kneel_serious);
			c_shakeobj();
		}
		if (instance_exists(susie))
		{
			c_sel(su);
			c_facing(""d"");
			c_sprite(spr_susie_dw_landed);
			c_shakeobj();
		}
		c_wait(16);
		c_sel(kr);
		c_sprite(spr_krisd_dark);
		if (instance_exists(ralsei))
		{
			c_sel(ra);
			c_sprite(spr_ralseid);
		}
		if (instance_exists(susie))
		{
			c_sel(su);
			c_sprite(spr_susied);
		}
		c_actortokris();
		c_customfunc(function()
		{
			with (obj_mainchara)
			{
				scr_depth();
			}
		});
		c_actortocaterpillarstill();
		c_terminatekillactors();
		con = 3;
	}
	if (con == 3)
	{
		if (!instance_exists(obj_cutscene_master))
		{
			with (obj_mainchara)
			{
				scr_script_delayed(function()
				{
					global.flag[7] = 0;
				}, 2);
			}
			global.facing = 0;
			global.interact = 0;
			obj_mainchara.cutscene = 0;
			obj_mainchara.freeze = false;
			scr_caterpillar_interpolate(""all"");
			with (obj_caterpillarchara)
			{
				scr_caterpillar_facing_single(name, ""d"");
			}
			con = 0;
			instance_destroy();
		}
	}
}
if (animation == 2)
{
	if (con == 1)
	{
		con = 2;
		with (obj_persistentfadein)
		{
			instance_destroy();
		}
		scr_fadein(15);
		global.flag[7] = 1;
	}
	if (con == 2)
	{
		global.interact = 1;
		with (obj_mainchara)
		{
			event_perform(ev_step, ev_step_end);
		}
		with (obj_mainchara)
		{
			cutscene = 1;
		}
		with (obj_caterpillarchara)
		{
			if (name == ""ralsei"")
			{
				other.ralsei = self;
			}
			if (name == ""susie"")
			{
				other.susie = self;
			}
		}
		with (obj_mainchara)
		{
			if (place_meeting(x, y + 100, obj_darkslide_new))
			{
				other.on_darkslide = true;
			}
			y -= 60;
			sprite_index = spr_kris_jump_ball_fixed;
			image_speed = 0.5 / global.fps_scale;
		}
		if (instance_exists(susie))
		{
			susie.x = obj_mainchara.x - 20;
			susie.y = obj_mainchara.y - 20;
			susie.sprite_index = spr_susie_dw_jump_ball;
		}
		if (instance_exists(ralsei))
		{
			ralsei.x = obj_mainchara.x + 10;
			ralsei.y = obj_mainchara.y - 20;
			ralsei.sprite_index = spr_ralsei_jump_ball;
		}
		cutscene_master = scr_cutscene_make();
		scr_maincharacters_actors();
		c_sel(kr);
		kr_actor.auto_depth = false;
		kr_actor.depth -= 1400;
		c_lerpvar_instance(kr_actor, ""y"", kr_actor.y, kr_actor.y + 60, 20, -1, ""in"");
		if (instance_exists(susie))
		{
			su_actor.auto_depth = false;
			su_actor.depth -= 1400;
			c_sel(su);
			var targ = 
			{
				x: su_actor.x - 20,
				y: su_actor.y + 60
			};
			if (!on_darkslide)
			{
				targ.x = scr_even(kr_actor.x - 40);
				targ.y = scr_even((kr_actor.y + 60) - 24);
				c_autowalk(false);
				c_image_speed(0.25);
				ra_actor.depth = kr_actor.depth + 10;
			}
			c_lerpvar_instance(su_actor, ""x"", su_actor.x, targ.x, 20);
			c_lerpvar_instance(su_actor, ""y"", su_actor.y, targ.y, 20, -1, ""in"");
		}
		if (instance_exists(ralsei))
		{
			ra_actor.auto_depth = false;
			ra_actor.depth -= 1400;
			c_sel(ra);
			var targ = 
			{
				x: ra_actor.x + 20,
				y: ra_actor.y + 60
			};
			if (!on_darkslide)
			{
				targ.x = scr_even(kr_actor.x + 32);
				targ.y = scr_even((kr_actor.y + 60) - 20);
				c_autowalk(false);
				c_image_speed(0.25);
				ra_actor.depth = kr_actor.depth + 20;
			}
			c_lerpvar_instance(ra_actor, ""x"", ra_actor.x, targ.x, 20);
			c_lerpvar_instance(ra_actor, ""y"", ra_actor.y, targ.y, 20, -1, ""in"");
		}
		c_wait(20);
		if (!on_darkslide)
		{
			c_wait(1);
			c_sel(kr);
			c_facing(""d"");
			c_sprite(spr_kris_dw_landed);
			c_snd_play(snd_wing);
			c_shakeobj();
			if (instance_exists(ralsei))
			{
				c_sel(ra);
				c_sprite_set(ra, 759, 0, 0);
				c_shakeobj();
			}
			if (instance_exists(susie))
			{
				c_sel(su);
				c_sprite_set(su, 96, 0, 0);
				c_shakeobj();
			}
			c_wait(15);
			c_sel(kr);
			c_sprite(spr_krisd_dark);
			if (instance_exists(ralsei))
			{
				c_sel(ra);
				c_sprite(spr_ralseid);
			}
			if (instance_exists(susie))
			{
				c_sel(su);
				c_sprite(spr_susied);
			}
		}
		c_actortokris();
		c_actortocaterpillarstill();
		c_customfunc(function(arg0)
		{
			with (obj_mainchara)
			{
				scr_depth();
				if (arg0)
				{
					sprite_index = spr_krisd_slide;
				}
			}
			with (obj_caterpillarchara)
			{
				scr_depth();
				if (arg0)
				{
					sprite_index = slidesprite;
					slided = 1;
					for (i = 75; i >= 0; i -= 1)
					{
						sliding[i] = true;
					}
				}
			}
		}, on_darkslide);
		c_terminatekillactors();
		con = 3;
	}
	if (con == 3)
	{
		if (!instance_exists(obj_cutscene_master))
		{
			with (obj_mainchara)
			{
				scr_script_delayed(function()
				{
					global.flag[7] = 0;
				}, 2);
			}
			global.interact = 0;
			global.facing = 0;
			obj_mainchara.cutscene = 0;
			obj_mainchara.freeze = false;
			if (!on_darkslide)
			{
				with (obj_caterpillarchara)
				{
					scr_caterpillar_facing_single(name, ""d"");
				}
			}
			else
			{
				with (obj_caterpillarchara)
				{
					sprite_index = slidesprite;
					slided = 1;
					for (i = 75; i >= 0; i -= 1)
					{
						sliding[i] = true;
					}
				}
			}
			con = 0;
			instance_destroy();
		}
	}
}
");

Apply("gml_Object_obj_doorparent_Other_18", @"with (obj_plat_player)
{
	door_direction = sign(obj_plat_player.hspeed);
	roomenterfreezeend = 1;
	hold_jump = key_jump;
}
with (obj_mainchara)
{
	roomenterfreezeend = 1;
	if (holding_item != -4 && other.doorKeepHeldItem)
	{
		with (obj_helditem)
		{
			if (held)
			{
				if (object_index == obj_wateringcan)
				{
					if (mode == 1)
					{
						global.flag[1332] = 2;
					}
					else
					{
						global.flag[1332] = 1;
					}
				}
				if (object_index == obj_pinwheel_held)
				{
					global.flag[1332] = 3;
				}
			}
		}
	}
	else
	{
		global.flag[1332] = 0;
	}
}
if (doorPreset > 0)
{
	if (doorPreset == 1)
	{
		doorDelay = 14;
		doorPostDelay = 6;
		doorSound = snd_dooropen;
		doorSound2 = snd_doorclose;
	}
	else if (doorPreset == 2)
	{
		doorDelay = 16;
		doorPostDelay = 6;
		doorSound = snd_escaped;
	}
}
if (doorFadeMusic)
{
	alarm[3] = round(doorFadeMusicTime * global.fps_scale);
	mus_volume(global.currentsong[1], 0, doorFadeMusicTime);
	if (doorDelay <= doorFadeMusicTime)
	{
		doorDelay = doorFadeMusicTime + 1;
	}
}
if (doorDelay > 0)
{
	alarm[2] = round(doorDelay * global.fps_scale);
}
if (doorSound != -1)
{
	snd_play(doorSound);
}
if (i_ex(obj_fadeout))
{
	var off = 0;
	if (os_type == os_macosx)
	{
		off = 1;
	}
	if (alarm[2] > 0)
	{
		obj_fadeout.fadespeed = global.fps_scale / (alarm[2] - off);
	}
}
with (obj_overworldbulletparent)
{
	active = 0;
}
");

Apply("gml_Object_obj_doorw_musfade_Other_19", @"global.interact = 3;
mus_volume(global.currentsong[1], 0, 14);
instance_create(0, 0, obj_fadeout);
if (touched == 0)
{
