Apply("gml_Object_obj_dw_fcastle_cafe_western_bg_Create_0", @"bg_sprites = [6105, 7896, 4163];
bg_layer_names = [""fg"", ""md"", ""md_back"", ""bg""];
bg_ids = [];
bg_speeds = [-1, -2, -4, -8];
bg_layers = [];
for (var i = 0; i < array_length(bg_sprites); i++)
{
	var new_layer = layer_create(5000 - (i + 1));
	bg_layers[i] = layer_background_create(new_layer, bg_sprites[i]);
	layer_background_stretch(bg_layers[i], true);
	layer_background_htiled(bg_layers[i], true);
	layer_hspeed(new_layer, bg_speeds[i] / global.fps_scale);
}

clean_up = function()
{
	var i = array_length(bg_layers) - 1;
	while (i >= 0)
	{
		var layer_id = layer_background_get_id(bg_layers[i]);
		layer_background_destroy(bg_layers[i]);
		i--;
	}
	instance_destroy();
};
");

