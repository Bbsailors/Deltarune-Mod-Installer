		global.interact = 0;
	}
}
with (moa)
{
	timer += (1 / global.fps_scale);
	if (timer >= timetarg)
	{
		timer = 0;
		var range = [4, 30];
		if (marker.sprite_index == spr_dw_fcastle_bromides_moa_idle)
		{
			range = [90, 180];
		}
		timetarg = random_range(range[0], range[1]);
		if (marker.sprite_index == spr_dw_fcastle_bromides_moa_idle)
		{
			marker.sprite_index = spr_dw_fcastle_bromides_moa_lick;
			marker.image_speed = random_range(1/3, 0.2) / global.fps_scale;
		}
		else
		{
			marker.sprite_index = spr_dw_fcastle_bromides_moa_idle;
			marker.image_speed = 0;
		}
	}
	if (myinteract == 3)
	{
		global.interact = 1;
		scr_speaker(""no_name"");
		msgsetloc(0, ""* (It looks like a crow^1, but the nameplate says \""Moa\"".)/"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_82_0"");
		msgnextloc(""* (It's licking the canvas at hyperspeed..^1. a layer of bromine is forming.)/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_83_0"");
		if (talked)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* (What's certain is that it must be some kind of birb.)/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_87_0"");
		}
		d_make();
		myinteract = 999;
		talked++;
	}
	if (myinteract == 999 && !d_ex())
	{
		myinteract = 0;
		global.interact = 0;
	}
}
with (nerd)
{
	if (myinteract == 3)
	{
		global.interact = 1;
		scr_speaker(""no_name"");
		msgsetloc(0, ""* This is where we all draw bromides for Master Flowery.../"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_108_0"");
		msgnextloc(""* His long legs^1, his shining smile^1, his perfect figure.../"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_109_0"");
		msgnextloc(""* Yes^1, we draw them exactly like he asks!/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_110_0"");
		if (talked)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* Of course^1, he pays us in Flowery Dollars.../"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_114_0"");
			msgnextloc(""* ..^1. that's perfect^1! We can buy more bromides!/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_115_0"");
		}
		d_make();
		myinteract = 999;
		talked++;
	}
	if (myinteract > 3 && d_ex())
	{
		var trig = 0;
		if (!i_ex(obj_writer))
		{
			trig = 1;
		}
		with (obj_writer)
		{
			if (halt)
			{
				trig = 1;
				other.marker.image_index = 0;
			}
		}
		if (!trig)
		{
			marker.image_index += 0.25 / global.fps_scale;
		}
	}
	if (myinteract == 999 && !d_ex())
	{
		myinteract = 0;
		marker.image_index = 0;
		global.interact = 0;
	}
}
");

