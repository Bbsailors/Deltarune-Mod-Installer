Apply("gml_Object_obj_bg_givedepth_Other_4", @"layerarray = layer_get_all();
for (var i = 0; i < array_length_1d(layerarray); i++)
{
	if (layer_get_name(layerarray[i]) == ""GIVE_DEPTH"")
	{
		elements = layer_get_all_elements(layerarray[i]);
		for (var j = 0; j < array_length_1d(elements); j++)
		{
			if (layer_get_element_type(elements[j]) == 4)
			{
				sprite_array_size++;
				if (palettemode == false)
				{
					layersprite[sprite_array_size] = scr_marker(layer_sprite_get_x(elements[j]), layer_sprite_get_y(elements[j]), layer_sprite_get_sprite(elements[j]));
				}
				else
				{
					layersprite[sprite_array_size] = instance_create(layer_sprite_get_x(elements[j]), layer_sprite_get_y(elements[j]), obj_marker_palette);
					layersprite[sprite_array_size].sprite_index = layer_sprite_get_sprite(elements[j]);
				}
				layersprite[sprite_array_size].image_xscale = layer_sprite_get_xscale(elements[j]);
				layersprite[sprite_array_size].image_yscale = layer_sprite_get_yscale(elements[j]);
				layersprite[sprite_array_size].image_speed = layer_sprite_get_speed(elements[j]) / global.fps_scale;
				layersprite[sprite_array_size].image_index = layer_sprite_get_index(elements[j]);
				with (layersprite[sprite_array_size])
				{
					scr_depth();
				}
				layer_sprite_destroy(elements[j]);
			}
		}
		break;
	}
}
");

Apply("gml_Object_obj_bg_palette_swap_Draw_0", @"if (shader_enabled)
{
	if (!surface_exists(surf_recolour))
	{
		surf_recolour = surface_create(surface_get_width(application_surface), surface_get_height(application_surface));
	}
	surface_set_target(surf_recolour);
	draw_clear_alpha(c_black, 1);
	gpu_set_colorwriteenable(true, true, true, false);
	draw_surface_ext(application_surface, 0, 0, camerawidth() / surface_get_width(application_surface), cameraheight() / surface_get_height(application_surface), 0, c_white, 1);
	gpu_set_colorwriteenable(true, true, true, true);
	surface_reset_target();
	pal_swap_set(1495, 1);
	draw_surface(surf_recolour, camerax(), cameray());
	pal_swap_reset();
}
");

Apply("gml_Object_obj_blocktree_bg_Draw_0", @"siner += (1 / global.fps_scale);
if (spec < 2)
{
	draw_sprite_ext(sprite_index, 1, x, y, 2, 2, 0, image_blend, 1);
	draw_sprite_ext(sprite_index, 2, x + (sin(siner / 12) * 2), y + (cos(siner / 20) * 2), 2, 2, 0, image_blend, 1);
	draw_sprite_ext(sprite_index, 3, x + (sin(siner / 14) * 1), y + (cos(siner / 24) * 1), 2, 2, 0, image_blend, 1);
}
else
{
	draw_sprite_ext(spr_blocktree_switch, siner / 6, x, y, 2, 2, 0, image_blend, 1);
}
");

Apply("gml_Object_obj_blocktree_bg_Step_0", @"oo = 0;
if (spec < 2)
{
	blocktimer += (1 / global.fps_scale);
}
if (blocktimer == 20)
{
	xv = x + (sprite_width / 4) + random(sprite_width / 2);
	yv = y + (sprite_height / 4) + random(sprite_height / 4);
	block = scr_dark_marker(xv, yv, spr_blocktree_block);
	with (block)
	{
		hspeed = ((0.4 + random(1)) * (other.leaf_dir * -1)) / global.fps_scale;
		vspeed = (0.7 + random(1.5)) / global.fps_scale;
		gravity_direction = other.leaf_dir ? 180 : 0;
		gravity = 0.1 / (global.fps_scale * global.fps_scale);
		image_alpha = 0;
		friction = -0.1 / (global.fps_scale * global.fps_scale);
	}
	block.depth = depth - 1;
	block.image_blend = merge_color(c_white, c_black, oo);
	if (oo >= 0.8)
	{
		with (block)
		{
			instance_destroy();
		}
	}
}
if (blocktimer >= 20 && blocktimer <= 30)
{
	with (block)
	{
		if (image_alpha < 1)
		{
			image_alpha += (0.2 / global.fps_scale);
		}
	}
}
if (blocktimer >= 38)
{
	with (block)
	{
		image_alpha -= (0.1 / global.fps_scale);
	}
}
if (blocktimer >= 48)
{
	blocktimer = 0;
	with (block)
	{
		instance_destroy();
	}
}
");

