	draw_sprite_ext(spr_pxwhite, 0, xx, topy, 20 * xscale, (boty - topy) + offset, 0, watcol, alph);
	if (!ending)
	{
		draw_sprite_ext(spr_dw_church_watertile_top, colindex, xx, boty - 8, xscale, -2, 0, topcol, alph);
	}
	draw_set_blend_mode(bm_normal);
