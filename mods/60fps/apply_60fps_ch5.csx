		{
			for (var i = 0; i < 3; i++)
			{
				with (arg0[i])
				{
					if (variable_instance_exists(id, ""m_starty""))
					{
						y = lerp(m_starty, m_stopy, arg0[3]);
						scr_depth();
						depth += depthbonus;
						y -= (sin(arg0[3] / pi) * 12);
					}
				}
			}
		}, [kr_actor, ra_actor, su_actor, t / 6]);
		c_wait(1);
	}
	c_waitcustom();
	c_actortokris();
	c_actortocaterpillar();
	c_customfunc(function()
	{
		with (obj_mainchara)
		{
			scr_depth();
		}
		with (obj_caterpillarchara)
		{
			scr_depth();
		}
	});
	c_terminatekillactors();
}
if (umbrellacon == 3 && !i_ex(obj_cutscene_master))
{
	umbrellacon = 0;
	scr_caterpillar_interpolate(""all"");
}
