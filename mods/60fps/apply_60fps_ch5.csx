return_can_to_its_place = function(arg0)
{
	var targ = -4;
	with (obj_wateringcan_pedestal)
	{
		if (arg0.areasize > 2 && held_item_flag == -1)
		{
			targ = self;
			break;
		}
		if (arg0.areasize <= 2 && held_item_flag != -1)
		{
			targ = self;
			break;
		}
	}
	with (arg0)
	{
		scr_jump_to_point(targ.x + (0.5 * targ.sprite_width), (targ.y + 8) - sprite_height, 12, 30, true);
		engaged = false;
		frozen = true;
		event_user(1);
		scr_lerpvar(""image_angle"", 0, 720, 30);
		if (y > targ.y)
		{
			scr_depth(self, 300);
			scr_delay_var(""depth"", targ.depth - 40, 29);
		}
		else
		{
			depth = targ.depth - 40;
		}
		if (sprite_index == spr_wateringcan_centered)
		{
			scr_delay_var(""sprite_index"", 676, 30);
		}
		else
		{
			scr_delay_var(""sprite_index"", 155, 30);
		}
		scr_delay_var(""x"", targ.x + (0.5 * targ.sprite_width), 30);
		scr_delay_var(""y"", targ.y + 8, 30);
	}
	with (targ)
	{
		scr_delay_var(""helditem"", arg0, 30);
	}
	if (targ.held_item_flag >= 0)
	{
		global.flag[targ.held_item_flag] = targ.held_item_flag_index;
	}
};

tossTreasure = function()
{
	with (scr_marker_centered(treasure.x + 20, treasure.y + 4, 1115, 2, 2, undefined, 0, 16777215))
	{
		visible = false;
		timer = 0;
		init = 0;
		movetime = -1;
		timer = 0;
		
		step_func = function()
		{
			if (!init)
			{
				snd_play(snd_wing);
				x = room_width + 40;
				y = ystart - 80;
				visible = true;
				init = 1;
				vsp = -18 / global.fps_scale;
				grav = 1.35 / (global.fps_scale * global.fps_scale);
				var wait = scr_returnwait_gravity(undefined, undefined, ystart, grav, vsp);
				movetime = wait;
				visible = true;
			}
			timer++;
			if (timer <= movetime)
			{
				vsp += grav;
				y += vsp;
				x = lerp(room_width + 40, xstart, timer / movetime);
				image_angle = lerp(-648, 0, timer / movetime);
			}
		};
		
		endstep_func = function()
		{
			if (x == xstart && init == 1)
			{
				scr_shakescreen();
				snd_play(snd_impact);
				y = ystart;
				init = 2;
				with (obj_dw_garden_flowerygardening)
				{
					treasure.visible = true;
				}
				instance_destroy();
			}
		};
	}
};

maketreasure = 0;
madetreasure = 0;
treasure = -4;
treasure2 = -4;

maketreasure1 = function(arg0 = false)
{
	var loc = findspriteinfo(spr_treasurebox);
	treasure = instance_create(loc.x, loc.y, obj_treasure_room);
	with (treasure)
	{
		itemidchest = 31;
		itemflag = 1803;
		itemtype = ""weapon"";
	}
	if (arg0)
	{
		loc = findspriteinfo(spr_treasurebox_tail);
		setxy(loc.x, loc.y - 80, treasure);
	}
	treasure.image_index = sign(global.flag[treasure.itemflag]);
};

maketreasure2 = function()
{
	var loc = findsprite(spr_treasurebox_tail);
	treasure2 = scr_makenpc_fromasset(loc);
	treasure2.marker.sprite_index = spr_treasurebox;
};

purpflowernpc = -4;

makepurpflowernpc = function()
{
	with (purpflowernpc)
	{
		instance_destroy();
	}
	var loc = findsprite(spr_dw_flower_bg_05, ""ASSETS_WATERABLE"", undefined, undefined, undefined, 1);
	purpflowernpc = scr_makenpc_fromasset(loc);
	with (purpflowernpc)
	{
		issolid = false;
		with (marker)
		{
			instance_destroy();
		}
	}
};

if (global.flag[1301] >= 2)
{
	makepurpflowernpc();
	maketreasure1(true);
	maketreasure2();
}
");

