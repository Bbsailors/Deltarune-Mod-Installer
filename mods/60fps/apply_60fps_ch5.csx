			{
				__of = scr_oflash();
			}
		}
	}
}
if (timer >= 10 && timer <= 30)
{
	draw_set_alpha(2.2 - (timer / 10));
	draw_set_color(c_white);
	d_circle(x, y, 60 - (timer * 6), true);
	d_circle(x, y, 61 - (timer * 6), true);
	d_circle(x, y, 62 - (timer * 6), true);
	draw_set_alpha(1);
}
if (timer == 60)
{
	instance_destroy();
}
