	c_sel_spritenext(asg, 6660, 0, 0.5);
	c_talk_wait();
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\EU* And then/%"", ""obj_ch5_DWCL00_slash_Step_0_gml_221_0"");
