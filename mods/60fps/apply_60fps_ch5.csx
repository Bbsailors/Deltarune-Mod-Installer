	image_start_speed = image_speed;
	if (wall_smash)
	{
		con = 2;
	}
	else
	{
		con = 1;
	}
}
if (con == 1)
{
	if ((timer % 2) == 0 && timer <= 22)
	{
		instance_create_depth(random_range(bbox_left, bbox_right), random_range(bbox_top, bbox_bottom), depth - 5, obj_flowerdie_mini);
	}
	if (timer <= 22 && frac(timer) == 0)
