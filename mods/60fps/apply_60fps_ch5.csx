menu = instance_create(0, 0, obj_garden_diner_menu);
con = 0;
if (global.plot >= 473)
{
	con = 99;
}
green = -4;
greennpc = scr_makenpc_fromasset(findsprite(spr_enemy_green_walk_right, ""CUT"", #FF6565));
with (greennpc)
{
	markerstick = false;
