};

make_bwoosh = function(arg0, arg1, arg2, arg3 = false)
{
	scr_make_ripple(mean(bbox_left, bbox_right), mean(bbox_top, bbox_bottom), arg1, arg0, arg2, 0, 16, other.depth + 1, undefined, undefined, undefined, arg3 ? 7 : 0, undefined, 1, 2);
};

ghost_aqua_offset = 0;
ghost_seth_offset = 0;
ghost_green_offset = 0;
ghost_yellow_offset = 0;
ghost_blue_offset = 0;
ghost_orange_offset = 0;

draw_ghost = function(arg0, arg1, arg2, arg3, arg4, arg5, arg6)
{
	if (subcon != 3)
	{
		arg2 += choose(-1, 0, 1);
	}
	var t = (current_time + arg4) * 0.035 * 2;
	draw_sprite_ext(arg1, image_index, arg2, arg3, 2, 2, 0, merge_color(arg4, c_black, 0.2), arg5);
	draw_sprite_ext(arg0, image_index, arg2, arg3, 2, 2, 0, merge_color(#EEEEEE, arg4, 0.5), arg5);
	shader_replace_simple_set_hook(18);
	shader_set_uniform_f(u_time, 0.033 * t, 0.333 + (0.333 * t), 0.666 + (0.333 * t));
	draw_set_blend_mode(bm_add);
	draw_sprite_ext(arg0, image_index, arg2, arg3, 2, 2, 0, c_white, arg5);
	draw_set_blend_mode(bm_normal);
	shader_replace_simple_reset_hook();
};

switch_subcon = function(arg0)
{
	subcon = arg0;
	subcontimer = 0;
};

switch_con = function(arg0)
{
	con = arg0;
	contimer = 0;
	subcon = 0;
	subcontimer = 0;
};

remx = 0;
remy = 0;
nextcon = 0;
is_final_jarona = false;
hit = 0;
image_speed = 0.25 / global.fps_scale;
windimmune = true;
