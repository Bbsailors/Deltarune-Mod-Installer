			owner = other.id;
			speed = 2 / global.fps_scale;
			depth = other.depth - 3000;
			image_xscale = 0;
			image_yscale = 0;
			scr_lerpvar(""speed"", 4 / global.fps_scale, 0, 20);
			scr_script_delayed(scr_lerpvar, 20, ""speed"", 0, 12 / global.fps_scale, 10);
			direction = _dir;
			image_angle = 180 + direction;
			scr_lerpvar(""image_angle"", image_angle, image_angle + 540, 15, 1, ""out"");
			lifetime = 70;
			scr_lerpvar(""image_xscale"", 0, 2, 15);
			scr_lerpvar(""image_yscale"", 0, 2, 15);
			if (_dir == clamp(_dir, 90, 270))
			{
				image_yscale *= -1;
			}
		}
		nextknife += 1;
		aim -= (throwdir * 30);
		if (nextknife >= knifecount)
		{
			attacktimer = -1;
		}
		else
		{
			attacktimer = 1;
		}
	}
}
");

