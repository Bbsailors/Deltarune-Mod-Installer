Apply("gml_Object_obj_dw_cliff_dash_runner_Step_0", @"if (!init)
{
	scr_addtosunshadows(476);
	init = 1;
}
with (obj_plat_player)
{
	if (place_meeting(x, y, obj_plat_checkpoint))
	{
		other.con = -1;
	}
	if (y > (room_height + 200))
	{
		y = room_height + 200;
	}
}
if (scr_trigcheck_ext(""disable_control"", 912))
{
	if (obj_plat_player.dashing)
	{
		obj_plat_player.can_jump = false;
	}
}
if (scr_trigcheck_ext(""enable_control"", 912))
{
	obj_plat_player.can_jump = true;
}
with (npc_leafling)
{
	if (!global.pause_plat)
	{
		timer += (1 / global.fps_scale);
	}
	y = ystart + (sin(timer / 25) * 14);
	petalstorm.y = y + 40;
	petalstorm.depth = depth + 20;
	image_xscale = -2 * cos(degtorad(spintimer));
	if (con == 1)
	{
		spintimer = (spintimer * power(0.9, 1 / global.fps_scale)) - (1 / global.fps_scale);
		if (spintimer <= 0)
		{
			con = 0;
			spintimer = 0;
		}
	}
	if (spintimer < 300)
	{
		if (place_meeting(x, y, obj_plat_hbx))
		{
			con = 1;
			snd_play(snd_pirouette, 0.7);
			spintimer = 1080;
		}
	}
	if (instance_exists(bubble))
	{
		bubble.tx = x + 30;
		bubble.ty = y;
	}
	if (i_ex(obj_plat_player))
	{
		if (bubble == -4)
		{
			if (obj_plat_player.x > (x - 80))
			{
				bubble = scr_messagebubble(stringsetloc(""You only need to jump.#Trust the wind."", ""obj_dw_cliff_dash_runner_slash_Step_0_gml_69_0""), x + 140, y - 50, self, -2);
				bubble.dropColor = merge_color(c_lime, c_black, 0.25);
				bubble.textbubbleColor = merge_color(c_lime, c_white, 0.75);
			}
		}
	}
}
if (!made_tempsave && global.plot < 320 && scr_trigcheck_ext(""tempsave"", 912))
{
	made_tempsave = true;
	scr_tempsave();
}
");

Apply("gml_Object_obj_dw_cliff_eastcliff_Create_0", @"layer_set_visible(""DEBUG_ASSETS"", 0);
layer_set_visible(""NPCs"", 0);
con = 0;
timer = 0;
init = 0;
PROGRESS_FLAG = 1859;
_OCTAVE_BIT = 0;
octavecon = scr_flag_get_ext(PROGRESS_FLAG, _OCTAVE_BIT);
octave_sequence = 0;

on_umbrella_hit = function(arg0)
{
	if (octavecon == 0)
	{
		if (arg0.pitch == (octave_sequence + 1))
		{
			octave_sequence++;
			if (octave_sequence == 5)
			{
				octavecon = 1;
				scr_flag_set_ext(PROGRESS_FLAG, _OCTAVE_BIT, 1);
				snd_play(snd_sparkle_glock);
				var gm = scr_genmarker(""coins"");
				repeat (10)
				{
					with (instance_create(random_range(gm.bbox_left, gm.bbox_right), gm.y, obj_plat_coin))
					{
						physics = true;
						homing_on_player = false;
						vspeed = random_range(3, 9) / global.fps_scale;
						hspeed = random_range(-2, 2) / global.fps_scale;
						collect_cooldown = 10;
					}
				}
				snd_play(snd_creepylaugh);
				with (obj_plat_umbrellaplatform)
				{
					if (y > 2680)
					{
						con = 0.5;
						timer = 0;
					}
				}
			}
		}
		else
		{
			octave_sequence = 0;
			if (arg0.pitch == 1)
			{
				octave_sequence = 1;
			}
		}
	}
};
");

Apply("gml_Object_obj_dw_cliff_finaldash_Step_0", @"if (!init)
{
	init = 1;
	var xx = 0;
	with (obj_mainchara)
	{
		xx = x;
	}
	with (obj_plat_player)
	{
		xx = x;
	}
	if (xx > 1000)
	{
		with (obj_plat_cam_clampzone)
		{
			if (gradual_extflag == ""gradual_2"")
			{
				ymin = 640;
				ymax = 640;
			}
		}
	}
}
with (obj_papergrass)
{
	visible = 0;
}
if (cutscenecon == 0)
{
	npc_aqua = scr_plat_makeactor_fromasset(findspriteinfo(spr_aqua_sit_smile, undefined));
	npc_seth = scr_plat_makeactor_fromasset(findspriteinfo(spr_seth_idle, undefined));
	with (npc_aqua)
	{
		con = -1;
		custom_behaviour(function()
		{
			wallcollision = 0;
			physics = 0;
			vspeed = 0;
			hspeed = 0;
			gravity = 0;
			entity_gravity = 0;
			if (instance_exists(obj_plat_player))
			{
				if (con == -1)
				{
					con = 0;
					scr_plat_depthcast();
				}
				if (con == 0 && obj_plat_player.x > (x - 200) && obj_plat_player.x < (x - 60))
				{
					con = 1;
					force_animation(2398);
					x -= 2;
					y -= 4;
				}
				else if (con == 1 && (obj_plat_player.x < (x - 300) || obj_plat_player.x > x))
				{
					con = 0;
					force_animation(7736);
					x += 2;
					y += 4;
				}
			}
		});
	}
	with (npc_seth)
	{
		con = -1;
		timer = 0;
		force_yplat = true;
		custom_behaviour(function()
		{
			if (con == -1)
			{
				depth = 1899;
				con = 0;
				wallcollision = 0;
				physics = 0;
				vspeed = 0;
				hspeed = 0;
				gravity = 0;
				image_xscale *= -1;
				x -= 52;
				entity_gravity = 0;
			}
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				if (con < 6 && instance_exists(obj_plat_player) && obj_plat_player.dashing)
				{
					con = 6;
					global.plot = max(global.plot, 340);
					force_animation(3890);
					image_speed = 0.5 / global.fps_scale;
					hspeed = 8 / global.fps_scale;
					vspeed = -4 / global.fps_scale;
					gravity = 0.5 / (global.fps_scale * global.fps_scale);
				}
				if (con == 0)
				{
					if (timer == 1)
					{
						force_animation(2829);
						vspeed = -0.5 / global.fps_scale;
						image_speed = 0.25 / global.fps_scale;
					}
					if (timer == 60)
					{
						con = 1;
						timer = 0;
						vspeed = 0;
						image_speed = 0;
					}
				}
				else if (con == 1)
				{
					if (timer == 20)
					{
						scr_shakeobj();
					}
					if (timer == 35)
					{
						force_animation(3936);
						image_speed = 0.5 / global.fps_scale;
						x -= 6;
						y -= 10;
						vspeed = 1 / global.fps_scale;
					}
					if (timer == 65)
					{
						con = 2;
						timer = 0;
						vspeed = 0;
					}
				}
				else if (con == 2)
				{
					if (timer == 1)
					{
						force_animation(6204);
						image_speed = 0.25 / global.fps_scale;
						y += 10;
						sprite_image_index = 0;
					}
					if (timer == 16)
					{
						image_speed = 0;
					}
					if (timer == 36)
					{
						con = 0;
						timer = -12;
						x += 6;
						y -= 0;
						force_animation(2829);
					}
				}
			}
		});
	}
	cutscenecon = 1;
}
with (obj_plat_player)
{
	respawn_leap_enabled = false;
}
");

Apply("gml_Object_obj_dw_cliff_gardentransition_new_Step_0", @"if (global.plot < 305)
{
	with (obj_sunshadows)
	{
		sunlight_alpha = obj_parallax_cliffs.suny;
	}
}
if (i_ex(obj_mainchara_dash))
{
	with (obj_mainchara_dash)
	{
		if (!other.dashjump_height_changed && x > 3000)
		{
			other.dashjump_height_changed = 1;
			var _newY = other.dashjump_landingY;
			var _difference = abs(_newY - y);
			y += _difference;
			jumppos += _difference;
			with (obj_caterpillar_dash)
			{
				_difference = abs(_newY - y);
				y += _difference;
				jumppos += _difference;
			}
		}
		if (x >= 4090)
		{
			if (!stopping && !jumping)
			{
				snd_play(snd_wing);
				stopping = 1;
				var delay = 30;
				runspeed_max *= 0.8;
				scr_lerpvar(""runspeed"", runspeed * 0.8, 0, delay);
				scr_lerpvar(""speed"", speed * 0.8, 0, delay + 5);
				alarm[2] = round((delay + 5) * global.fps_scale);
			}
		}
	}
}
