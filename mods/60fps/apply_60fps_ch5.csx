	var alph = clamp(animindex + (sin(animindex * 4) * 0.25), 0, 0.8);
	animindex += (0.25 / global.fps_scale);
	col[0] = 15313408;
	col[1] = 15313408;
	col[2] = 15317774;
	col[3] = 15313408;
	col[4] = 15381248;
	var colindex = floor(animindex) % 4;
	watcol = col[colindex];
