	c_msgnextloc(""* Not when you treat the people who work with you like expendable trash./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_666_0"");
	c_facenext(""tenna"", 0);
	c_msgnextloc(""* T..^1. trash?/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_668_0"");
	c_msgnextloc(""* Mike^1, y-you know I don't do that!!^1! I'm always.../"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_669_0"");
	c_msgnextloc(""* I'm always^1, y'know^1, adding lots of little^1, uh^1, bonuses to their contracts!!/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_670_0"");
	c_msgnextloc(""* Y'know!^1! Paid fruit-flavored vacation^1, left over glooby slime^1, you know!!/%"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_671_0"");
