Apply("gml_Object_obj_lerpvar_Step_0", @"if ((global.pause_plat && respect_plat_pause) && !global.fighting)
{
	exit;
}
var t = time / maxtime;
var func = lerp;
if (iscolor)
{
	func = merge_color;
}
var set = variable_instance_set;
var get = variable_instance_get;
if (is_struct(target))
{
	set = variable_struct_set;
	get = variable_struct_get;
}
if (isvector)
{
	func = scr_lerp_vector2;
}
if (is_struct(target) || instance_exists(target))
{
	if (init == 0)
	{
		if (is_string(pointa))
		{
			pointa = get(target, varname);
		}
		init = 1;
	}
	var cont = 1;
	if (respectglobalinteract == true)
	{
		if (global.interact != 0)
		{
			cont = 0;
		}
	}
	if (cont)
	{
		time += (1 / global.fps_scale);
	}
	if (easetype == 0)
	{
		set(target, varname, func(pointa, pointb, time / maxtime));
	}
	else
	{
		if (easeinout == ""out"")
		{
			set(target, varname, func(pointa, pointb, lerp_ease_out(0, 1, time / maxtime, easetype)));
		}
		if (easeinout == ""in"")
		{
			set(target, varname, func(pointa, pointb, lerp_ease_in(0, 1, time / maxtime, easetype)));
		}
		if (easeinout == ""inout"")
		{
			set(target, varname, func(pointa, pointb, lerp_ease_inout(0, 1, time / maxtime, easetype)));
		}
	}
	if (time >= maxtime)
	{
		instance_destroy();
	}
}
else
{
	instance_destroy();
}
");

