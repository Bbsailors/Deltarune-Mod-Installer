	c_sel(su);
	c_spritenext(8113);
	c_facenext(""ralsei"", ""Q"");
	c_msgnextloc(""\\EQ* This is..^1. probably going to be their only Dark World./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_2049_0"");
	c_facenext(""susie"", ""R"");
	c_msgnextloc(""\\ER* .../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_2051_0"");
	c_facenext(""susie"", ""S"");
