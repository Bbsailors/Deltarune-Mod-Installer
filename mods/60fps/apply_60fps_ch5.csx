		ray = ralsei.y;
		sux = susie.x;
		suy = susie.y;
		for (var i = 0; i < 20; i++)
		{
			if (i_ex(catmarker[i]))
			{
				catsiner[i] += abs(genx[i] - catmarker[i].x);
				genx[i] = catmarker[i].x;
				geny[i] = catmarker[i].y;
