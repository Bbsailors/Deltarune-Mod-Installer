	with (_rudinn_marker)
	{
		image_speed = 0;
		image_index = 0;
	}
	with (_rudinn_ranger_marker)
	{
		image_speed = 0;
		image_index = 0;
	}
	with (_mizzle_marker)
	{
		image_speed = 0;
		image_index = 0;
	}
}
if (npc_animate)
{
	if (i_ex(obj_writer))
	{
		if (global.typer == 6)
		{
			if (obj_writer.halt >= 1)
			{
				with (npc_animate_target)
