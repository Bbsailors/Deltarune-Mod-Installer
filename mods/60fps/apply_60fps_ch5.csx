		with (obj_plat_fusumawall)
		{
			if (extflag == other.extflag)
			{
				if (extflag == ""fusuma1"")
				{
					if (y < (other.y - 100))
					{
						y = scr_approach(y, ystart - 260, 6);
						stalk_height = 40 + abs(y - ystart);
						depth_yoffset = ystart - y;
						reflect_jump_y = 2 * depth_yoffset;
					}
				}
				else
				{
					if (!variable_instance_exists(id, ""ttimer""))
					{
						ttimer = 0;
					}
					ttimer += (1 / global.fps_scale);
					var t = floor(ttimer) % 120;
					if (t < 15)
					{
						x = xstart + (t * 4);
					}
					if (t > 45 && t < 75)
					{
						x = (xstart + 60) - ((t - 45) * 4);
					}
					if (t > 105)
					{
						x = (xstart - 60) + ((t - 105) * 4);
					}
				}
			}
		}
	}
	else
	{
		with (obj_plat_fusumawall)
		{
			if (extflag == other.extflag)
			{
				if (extflag == ""fusuma1"")
				{
					if (y < (other.y - 100))
					{
						var lasty = y;
						y = scr_approach(y, ystart, 12);
						depth_yoffset = ystart - y;
						reflect_jump_y = 2 * depth_yoffset;
						stalk_height = 40 + abs(y - ystart);
						if (y == ystart && y != lasty)
						{
							snd_play(snd_locker);
						}
					}
				}
				else
				{
				}
			}
		}
	}
