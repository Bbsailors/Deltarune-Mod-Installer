		else
		{
			scr_speaker(""asgore"");
			msgsetloc(0, ""\\Em* Kris^1, I'm sorry^1. I can't say that enough./"", ""obj_ch5_DW45_slash_Step_0_gml_87_0"");
			msgnextloc(""\\E0* ..^1. but..^1. you've grown up a lot^1, haven't you?/"", ""obj_ch5_DW45_slash_Step_0_gml_88_0"");
			msgnextloc(""\\E3* When your brother finally comes home.../"", ""obj_ch5_DW45_slash_Step_0_gml_89_0"");
			msgnextloc(""\\EG* I can't wait to see how proud he'll be of you./%"", ""obj_ch5_DW45_slash_Step_0_gml_90_0"");
