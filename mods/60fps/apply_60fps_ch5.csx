	p_fl = [0, 0];
	p_fr = [0, 0];
	p_kl = [0, 0];
	p_kr = [0, 0];
	p_t = [0, 0];
	p_h = [0, 0];
	p_sl = [0, 0];
	p_sr = [0, 0];
	p_hl = [0, 0];
	p_hr = [0, 0];
	p_al = [0, 0];
	p_ar = [0, 0];
	my_surface = -4;
	
	set_points = function()
	{
		if (state == ""idle"")
		{
			point_center[0] = 120;
			point_center[1] = 124 + (sin(timer * 0.1) * 2);
			point_foot_left = [120 + lengthdir_x(90, 255), 120 + lengthdir_y(90, 255)];
			point_foot_right = [120 + lengthdir_x(90, 285), 120 + lengthdir_y(90, 285)];
			point_ass_right = [point_center[0] + 10, point_center[1]];
			point_ass_left = [point_center[0] - 10, point_center[1]];
			point_torso = [point_center[0] + (cos(timer * 0.05) * 6), (point_center[1] - 25) + (sin(timer * 0.1) * 2)];
			var _shoulder_angle = sin(timer * 0.05) * 6;
			point_shoulder_right = [point_torso[0] + lengthdir_x(25, -10 - _shoulder_angle), point_torso[1] + lengthdir_y(25, -10 - _shoulder_angle)];
			point_shoulder_left = [point_torso[0] + lengthdir_x(25, 190 + _shoulder_angle), point_torso[1] + lengthdir_y(25, 190 + _shoulder_angle)];
			point_hand_right = [point_shoulder_right[0] + lengthdir_x(25, -40 - _shoulder_angle), point_shoulder_right[1] + lengthdir_y(25, -40 - _shoulder_angle)];
			point_hand_left = [point_shoulder_left[0] + lengthdir_x(25, 220 + _shoulder_angle), point_shoulder_left[1] + lengthdir_y(25, 220 + _shoulder_angle)];
			var _head_angle = 110 + (sin(timer * 0.05) * 10);
			point_head = [point_torso[0] + lengthdir_x(30, _head_angle), point_torso[1] + lengthdir_y(30, _head_angle)];
			var _angle = point_direction(point_center[0], point_center[1], point_foot_left[0], point_foot_left[1]);
			var _knee_angle = radtodeg(-arccos(clamp((point_distance(point_center[0], point_center[1], point_foot_left[0], point_foot_left[1]) * 0.5) / 45, -1, 1)));
			point_knee_left = [point_center[0] + lengthdir_x(45, _angle + _knee_angle), point_center[1] + lengthdir_y(45, _angle + _knee_angle)];
			_angle = point_direction(point_center[0], point_center[1], point_foot_right[0], point_foot_right[1]);
			_knee_angle = radtodeg(arccos(clamp((point_distance(point_center[0], point_center[1], point_foot_right[0], point_foot_right[1]) * 0.5) / 45, -1, 1)));
			point_knee_right = [point_center[0] + lengthdir_x(45, _angle + _knee_angle), point_center[1] + lengthdir_y(45, _angle + _knee_angle)];
		}
