get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	if (hit <= 0 && arg0.is_player_hbx)
	{
		cancel_stun();
		var dirsign = sign(x - other.x);
		flash_hurt(255);
		squishtimer = 1;
		hit = 3;
		if (con == 0)
		{
			snd_play(snd_creepylaugh, 1, 0.8);
		}
		con = 1;
		timer = 0;
		contact_damage = 0;
		scr_make_ripple(x, y, 8, 16777215, 50, 15, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
		with (arg0)
		{
			do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
		}
		sprite_index = spr_faqua_blur;
		audio_stop_sound(snd_enemy_defeat_quick);
		snd_play(snd_enemy_defeat_quick);
		if (hp < 5)
		{
			speedboost += speed_increase;
		}
		hp--;
		spawn_hit_petals(3, point_direction(arg0.x, arg0.y, x, y), 1);
		if (hp <= 0)
		{
			shake = 4;
			h_knockback = dirsign * (base_knockback + (4 / global.fps_scale) + speedboost);
			v_knockback = -10 / global.fps_scale;
			hspeed = 0;
			vspeed = 0;
			alarm[2] = 8;
			alarm[3] = 4;
		}
		else if (knockback_after_every_hit)
		{
			shake = 4;
			knocked_back = 1;
			h_knockback = dirsign * (base_knockback + speedboost);
			if (instance_exists(obj_plat_player) && obj_plat_player.grounded)
			{
				v_knockback = (-12 / global.fps_scale) + (speedboost / 2);
			}
			else
			{
				v_knockback = 6 / global.fps_scale;
			}
			hspeed = 0;
			vspeed = 0;
			alarm[2] = 2;
			with (instance_create_depth(x, y, depth, obj_plat_vfx))
			{
				sprite_index = spr_hit_vfx;
				image_speed = 1;
			}
		}
	}
};
