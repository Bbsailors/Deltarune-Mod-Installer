Apply("gml_Object_obj_verlet_rope_Create_0", @"event_inherited();
performs_culling_checks = true;
scr_plat_set_depth_offset(-60);
helper = scr_platswap_init(id);
init = 0;
rope_active = false;
is_simulating = false;
broken = false;
render_limit = nodecount;
grav = 1;
iter = 2;
forces = [];
nodecount *= 0.5;
nodelength *= 2;
force_simulate = false;

constrain_segments = function()
{
	for (var i = 0; i < (nodecount - 1); i++)
	{
		var _ii = i * 4;
		var dv = point_distance(nodes[_ii], nodes[_ii + 1], nodes[_ii + 4], nodes[_ii + 5]);
		var dx = nodes[_ii] - nodes[_ii + 4];
		var dy = nodes[_ii + 1] - nodes[_ii + 5];
		var err = nodelength - dv;
		var deltax = 0;
		var deltay = 0;
		if (dx != 0)
		{
			deltax = (err * dx) / dv;
		}
		if (dy != 0)
		{
			deltay = (err * dy) / dv;
		}
		if (i > 0)
		{
			nodes[_ii] = nodes[_ii] + (0.5 * deltax);
			nodes[_ii + 1] = nodes[_ii + 1] + (0.5 * deltay);
			nodes[_ii + 4] = nodes[_ii + 4] - (0.5 * deltax);
			nodes[_ii + 5] = nodes[_ii + 5] - (0.5 * deltay);
		}
		else
		{
			nodes[_ii + 4] = nodes[_ii + 4] - deltax;
			nodes[_ii + 5] = nodes[_ii + 5] - deltay;
		}
	}
};

simulate_segments = function()
{
	var al_forces = array_length(forces);
	for (var i = 1; i < nodecount; i++)
	{
		var _ii = i * 4;
		var velx = nodes[_ii] - nodes[_ii + 2];
		var vely = nodes[_ii + 1] - nodes[_ii + 3];
		nodes[_ii + 2] = nodes[_ii];
		nodes[_ii + 3] = nodes[_ii + 1];
		vely += grav;
		var v2x = 0;
		var v2y = 0;
		var j = al_forces - 2;
		while (j >= 0)
		{
			v2x += forces[j];
			v2y += forces[j + 1];
			forces[j] *= 0.9;
			forces[j + 1] *= 0.9;
			if ((abs(forces[j]) + abs(forces[j + 1])) < 0.1)
			{
				array_delete(forces, j, 2);
				al_forces -= 2;
			}
			j -= 2;
		}
		velx += v2x;
		vely += v2y;
		nodes[_ii] += velx;
		nodes[_ii + 1] += vely;
	}
	for (var i = 0; i < iter; i++)
	{
		constrain_segments();
	}
};

add_force = function(arg0, arg1)
{
	array_push(forces, arg0);
	array_push(forces, arg1);
};

reset_forces = function()
{
	forces = [];
};

draw_interp = true;
draw_sim_time = -1000000;

refresh_draw_nodes = function()
{
	var _f = 1;
	if (draw_interp && global.fps_scale != 1)
	{
		var _k = global.time - draw_sim_time;
		if (_k >= 0 && _k < global.fps_scale)
		{
			_f = (_k + 1) / global.fps_scale;
		}
	}
	dnodes[0] = nodes[0];
	dnodes[1] = nodes[1];
	if (_f >= 1)
	{
		for (var i = 1; i < nodecount; i++)
		{
			dnodes[i * 2] = nodes[i * 4];
			dnodes[(i * 2) + 1] = nodes[(i * 4) + 1];
		}
	}
	else
	{
		for (var i = 1; i < nodecount; i++)
		{
			var _ii = i * 4;
			dnodes[i * 2] = lerp(nodes[_ii + 2], nodes[_ii], _f);
			dnodes[(i * 2) + 1] = lerp(nodes[_ii + 3], nodes[_ii + 1], _f);
		}
	}
};

draw_snap = function(arg0)
{
	if (scr_smoothcam_on())
	{
		var _q = 640 / surface_get_width(application_surface);
		return round(arg0 / _q) * _q;
	}
	return arg0;
};

nodecount = floor(nodecount);
nodes = array_create(4 * nodecount, xstart);
dnodes = array_create(2 * nodecount, xstart);
var dy = nodelength;
for (var i = 0; i < nodecount; i++)
{
	var yy = ystart + (i * dy);
	nodes[(i * 4) + 1] = yy;
	nodes[(i * 4) + 3] = yy;
}
simulate_segments();
refresh_draw_nodes();
");

Apply("gml_Object_obj_verlet_rope_Draw_0", @"if (is_simulating)
{
	draw_sim_time = global.time;
}
refresh_draw_nodes();
if (is_culled)
{
	exit;
}
var maxval = min(render_limit, nodecount - 1);
for (var i = 0; i < maxval; i++)
{
	var alpha = image_alpha;
	var _ii = i * 2;
	if (ropefade)
	{
		alpha = ((i + 1) / maxval) * image_alpha;
	}
	draw_sprite_ext(spr_2pxwhite_origin_leftcenter, 0, dnodes[_ii], dnodes[_ii + 1], point_distance(dnodes[_ii], dnodes[_ii + 1], dnodes[_ii + 2], dnodes[_ii + 3]) * 0.5, 1, point_direction(dnodes[_ii], dnodes[_ii + 1], dnodes[_ii + 2], dnodes[_ii + 3]), ropecolor, alpha);
}
");

Apply("gml_Object_obj_verlet_rope_Step_0", @"cull_buffer_top = abs(ystart - y);
cull_buffer_bottom = 100;
cull_buffer_left = 100;
cull_buffer_right = 100;
if (!init)
{
	with (helper)
	{
		remove_object(other.id);
	}
	init = true;
}
is_simulating = false;
if (rope_active && (force_simulate || !is_culled) && !global.pause_plat && (global.time % global.fps_scale) == 0)
{
	simulate_segments();
	is_simulating = true;
}
if (is_culled && !force_simulate)
{
	exit;
}
var nx = nodes[0];
var ny = nodes[1];
nodes[0] += hspeed;
nodes[2] += hspeed;
if (variable_instance_exists(id, ""y_plat""))
{
	y_ow += vspeed;
	y_plat += vspeed;
	nodes[1] = lerp(y_ow, y_plat, array_get(scr_platswap_yscale(), 0));
}
else
{
}
var diffx = nodes[0] - nx;
var diffy = nodes[1] - ny;
nodes[3] += diffy;
if (diffx != 0)
{
	for (var i = 1; i < nodecount; i++)
	{
		nodes[i * 4] += diffx;
		nodes[(i * 4) + 2] += diffx;
	}
}
if (diffy != 0)
{
	for (var i = 1; i < nodecount; i++)
	{
		nodes[(i * 4) + 1] += diffy;
		nodes[(i * 4) + 3] += diffy;
	}
}
x = nodes[(nodecount - 1) * 4];
y = nodes[((nodecount - 1) * 4) + 1];
");

