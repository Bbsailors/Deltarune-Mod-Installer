}
if (con == 3 && !i_ex(obj_cutscene_master))
{
	scr_flag_set(1311, 0);
	with (obj_plat_follower)
	{
		if (name == ""ralsei"")
		{
			get_preset(2);
		}
	}
	global.interact = 0;
	global.facing = 0;
	platcon = 1;
	con = -99;
}
if (platcon > 0 && !global.pause_plat && i_ex(obj_plat_player))
{
	scr_get_plat_followers();
	if (plat_susie == -4 || plat_ralsei == -4)
	{
		exit;
	}
	plattimer += (1 / global.fps_scale);
	plat_susie.important = true;
	plat_ralsei.important = true;
	if (platcon == 1)
	{
		if (plattimer < 5)
		{
			plat_susie.caterpillarmode = 0;
			plat_ralsei.caterpillarmode = 0;
			plat_susie.state = 1;
			plat_ralsei.state = 1;
			platmemory = [obj_plat_player.x, obj_plat_player.y];
		}
		if (plattimer == 15)
		{
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E6* I feel..^1. light?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_423_0"");
			d_make_plat(0, 1);
		}
		if (plattimer == 255)
		{
			scr_speaker(""ralsei"");
			msgsetsubloc(0, ""\\Ed* Should we try..^1. going back down?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_430_0"");
			d_make_plat(0, 1);
		}
		if (plattimer >= 15 && (platmemory[0] != obj_plat_player.x || platmemory[1] != obj_plat_player.y))
		{
			platcon = 2;
			plattimer = 0;
		}
	}
	else if (platcon == 2)
	{
		if (!obj_plat_player.grounded)
		{
			if (obj_plat_player.jumping)
			{
				platcon = 5;
			}
			else if (obj_plat_player.y >= 800)
			{
				platcon = 3;
			}
			plattimer = 0;
		}
	}
	else if (platcon == 3)
	{
		if (d_plat_exists(0) && plattimer <= 1)
		{
			plattimer = -30;
		}
		if (plattimer < 0)
		{
			if (obj_plat_player.jumping)
			{
				platcon = 5;
			}
		}
		if (plattimer == 1)
		{
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\EZ* H-hey^1! Kris!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_464_0"");
			d_make_plat(0, 2);
			platcon = 4;
			plattimer = 0;
		}
	}
	else if (platcon == 4)
	{
		if (obj_plat_player.jumping)
		{
			platcon = 5;
			plattimer = 0;
			with (plat_susie)
			{
				restore_animation();
			}
			with (plat_ralsei)
			{
				restore_animation();
			}
		}
		else if (obj_plat_player.grounded)
		{
			platcon = 4.1;
			plat_susie.state = 1;
			plat_susie.followtarget = ""sumove1"";
		}
	}
	else if (platcon == 4.1)
	{
		if (plat_susie.grounded && plat_susie.y >= 800)
		{
			plat_ralsei.state = 1;
			plat_ralsei.followtarget = ""ramove1"";
			plat_susie.state = 0;
			platcon = 4.2;
			plattimer = 0;
		}
		if (obj_plat_player.jumping)
		{
			platcon = 5;
			plattimer = 0;
		}
	}
	else if (platcon == 4.2)
	{
		if (plattimer == 15)
		{
			plat_susie.state = 1;
			plat_susie.followtarget = ""__nothing"";
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\EE* Huh^1, it's safe...?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_498_0"");
			d_make_plat(0, 2);
		}
		if (plat_ralsei.followtarget == ""ramove1"" && plat_ralsei.grounded && plat_ralsei.y >= 800)
		{
			plat_ralsei.state = 0;
		}
		if (plat_ralsei.state == 0 && plat_ralsei.y >= 1060)
		{
			plat_ralsei.state = 1;
			plat_ralsei.followtarget = ""__nothing"";
		}
		if (obj_plat_player.jumping)
		{
			platcon = 5;
			plattimer = 0;
		}
	}
	else if (platcon == 5)
	{
		if ((d_plat_exists(0) || plat_susie.grounded == false) && plattimer < 5)
		{
			plattimer = -30;
			if (scr_onscreen(plat_susie))
			{
				plat_susie.followtarget = ""__nothing"";
			}
			if (scr_onscreen(plat_susie))
			{
				plat_ralsei.followtarget = ""__nothing"";
			}
		}
		if (plattimer == 5)
		{
			plat_susie.force_animation(3009);
			plat_ralsei.force_animation(643);
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E7* Damn^1, Kris's got ups!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_532_0"");
			d_make_plat(0, 3);
		}
		if (plattimer == 60)
		{
			plat_susie.restore_animation();
			plat_ralsei.restore_animation();
			sujumping = true;
		}
		if (plattimer == 150)
		{
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E9* Ralsei^1, c'mon!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_544_0"");
			d_make_plat(0, 3);
			plat_ralsei.force_animation(643, 25);
		}
		if (plattimer == 175)
		{
			rajumping = true;
			plat_ralsei.followtarget = ""sumove2"";
		}
		if (plattimer == 300)
		{
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E7* Dude^1, this is sick^1! It's like moon shoes!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_557_0"");
			scr_anyface_next(""ralsei"", ""J"");
			msgnextsubloc(""\\EJ* What are moon shoes?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_559_0"");
			scr_anyface_next(""susie"", ""7"");
			msgnextsubloc(""\\E7* They're crazy shoes that make you sprain your ankle!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_561_0"");
			scr_anyface_next(""ralsei"", ""U"");
			msgnextsubloc(""\\EU* It's..^1. it's like that!?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_563_0"");
			d_make_plat(0, 3);
		}
		if (plattimer == 1040)
		{
			with (obj_plat_movemarker)
			{
				if (extflag == ""sumove3"")
				{
					next_extflag = ""sumove4"";
				}
				if (extflag == ""ramove3"")
				{
					next_extflag = ""ramove4"";
				}
				if (extflag == ""sumove6"")
				{
					next_extflag = ""sumove4"";
				}
				if (extflag == ""ramove6"")
				{
					next_extflag = ""ramove4"";
				}
			}
		}
		if (plattimer >= 1140 && plat_susie.hspeed == 0 && plat_ralsei.hspeed == 0)
		{
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E0* Okay^1, let's go already^1. Next room."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_garden_aquashrine_slash_Step_0_gml_579_0"");
			d_make_plat(0, 3);
			sujumping = false;
			rajumping = false;
			plat_susie.followtarget = ""__nothing"";
			plat_ralsei.followtarget = ""__nothing"";
			ra_face_player = 1;
			su_face_player = 1;
			platcon = 6;
			plattimer = 0;
		}
	}
	else if (platcon == 6)
	{
		if (plattimer == 120)
		{
			platcon = 7;
			plat_susie.followtarget = ""_offscreen"";
			su_face_player = 0;
		}
	}
	if (sujumping)
	{
		plat_susie.state = 1;
		if (plat_susie.y < 800)
		{
			plat_susie.followtarget = ""sumove1"";
		}
		else if (plat_susie.followtarget == ""sumove1"" || plat_susie.followtarget == ""__nothing"")
		{
			plat_susie.followtarget = ""sumove2"";
		}
	}
	if (rajumping)
	{
		plat_ralsei.state = 1;
		if (plat_ralsei.y < 800)
		{
			plat_ralsei.followtarget = ""ramove1"";
		}
		else if (plat_ralsei.followtarget == ""ramove1"" || plat_ralsei.followtarget == ""__nothing"")
		{
			plat_ralsei.followtarget = ""ramove2"";
		}
	}
	if (su_face_player && plat_susie.followtarget == ""__nothing"")
	{
		if (obj_plat_player.x > plat_susie.x)
		{
			plat_susie.image_xscale = 2;
		}
		else
		{
			plat_susie.image_xscale = -2;
		}
	}
	if (ra_face_player && plat_ralsei.followtarget == ""__nothing"")
	{
		if (obj_plat_player.x > plat_ralsei.x)
		{
			plat_ralsei.image_xscale = 2;
		}
		else
		{
			plat_ralsei.image_xscale = -2;
		}
	}
}
");

Apply("gml_Object_obj_dw_garden_diner_Other_11", @"with (npc_yellow)
{
	var QuestionThis = stringsetloc(""#Question This"", ""obj_dw_garden_diner_slash_Other_11_gml_6_0"");
	var LeaveHim = stringsetloc(""#Leave Him"", ""obj_dw_garden_diner_slash_Other_11_gml_7_0"");
	
	hatjump = function()
	{
		hat = scr_marker_ext(marker.x + 12, marker.y, spr_yellow_hat, 2, 2);
		with (hat)
		{
			snd_play(snd_wing, 0.7, 1.2);
			scr_limitval_upper(undefined, ""y"", y);
			gravity = 0.7 / (global.fps_scale * global.fps_scale);
			vspeed = -6 / global.fps_scale;
		}
	};
	
	hatkill = function()
	{
		with (obj_marker)
		{
			if (sprite_index == spr_yellow_hat)
			{
				instance_destroy();
			}
		}
	};
	
	if (myinteract == 0)
	{
		marker.sprite_index = spr_yellow_sit_left;
		marker.image_index = 0;
	}
	if (myinteract == 3)
	{
		marker.sprite_index = spr_yellow_sit_down;
		global.interact = 1;
		if (talked == 0)
		{
			scr_speaker(""yellow"");
			msgsetloc(0, ""* Yippee kay-yay^1, nothin' like a night at the Ol' Saloon./"", ""obj_dw_garden_diner_slash_Other_11_gml_34_0"");
			msgnextloc(""* I'm gonna eat so many cowboy-appropriate meals./"", ""obj_dw_garden_diner_slash_Other_11_gml_35_0"");
			var option1 = stringsetloc(""#Learn More"", ""obj_dw_garden_diner_slash_Other_11_gml_36_0"");
			var option2 = stringsetloc(""#Leave Him"", ""obj_dw_garden_diner_slash_Other_11_gml_37_0"");
			scr_readychoicer(option1, option2);
			myinteract = 4;
			d_make();
			talked = 1;
			with (obj_dw_garden_diner)
			{
				yellowtalk = 1;
				updateflags();
			}
		}
		else
		{
			scr_speaker(""yellow"");
			msgsetloc(0, ""* The problem with menus^1, they have too many prices and values./"", ""obj_dw_garden_diner_slash_Other_11_gml_51_0"");
			msgnextloc(""* They oughtta make a menu with only one choice^1. 'd be easier./%"", ""obj_dw_garden_diner_slash_Other_11_gml_52_0"");
			myinteract = 9;
			d_make();
		}
		talked++;
	}
	if (myinteract == 4 && global.choice != -1)
	{
		if (global.choice == 0)
		{
			k_d(1);
			scr_speaker(""susie"");
			msgsetloc(0, ""\\EK* Like what?/"", ""obj_dw_garden_diner_slash_Other_11_gml_67_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* M..^1. m..../"", ""obj_dw_garden_diner_slash_Other_11_gml_69_0"");
			msgnextloc(""* Medals...?/"", ""obj_dw_garden_diner_slash_Other_11_gml_70_0"");
			scr_anyface_next(""ralsei"", ""1"");
			msgnextloc(""\\E1* Won't you get sick if you eat that?/"", ""obj_dw_garden_diner_slash_Other_11_gml_72_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* H..^1. huh??/"", ""obj_dw_garden_diner_slash_Other_11_gml_74_0"");
			msgnextloc(""* Oh no..^1. I don't wanna get sick.../"", ""obj_dw_garden_diner_slash_Other_11_gml_75_0"");
			msgnextloc(""* I can't believe I have to get sick.../"", ""obj_dw_garden_diner_slash_Other_11_gml_76_0"");
			msgnextloc(""* ..^1. maybe Blue can take my medals for me.../"", ""obj_dw_garden_diner_slash_Other_11_gml_77_0"");
			var option1 = stringsetloc(""#Reassure Him"", ""obj_dw_garden_diner_slash_Other_11_gml_78_0"");
			var option2 = stringsetloc(""#Leave Him Be"", ""obj_dw_garden_diner_slash_Other_11_gml_79_0"");
			scr_readychoicer(option1, option2);
			d_make();
			scr_msgno_func(7, function()
			{
				marker.sprite_index = spr_yellow_sit_down_surprised;
				hatjump();
			});
			scr_msgno_func(8, function()
			{
				marker.sprite_index = spr_yellow_sit_left_shakehead;
				marker.image_speed = 0.16666666666666666 / global.fps_scale;
				hatkill();
			});
			myinteract++;
		}
		else
		{
			endConvo();
		}
	}
	if (myinteract == 5 && global.choice != -1)
	{
		if (global.choice == 0)
		{
			k_d(1);
			marker.image_speed = 0;
			scr_speaker(""ralsei"");
			msgsetloc(0, ""\\E6* You don't have to order^1, um^1, medals^1, if you don't want to./"", ""obj_dw_garden_diner_slash_Other_11_gml_109_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Oh^1, phew. I was jus' thinking I'd have some Orange Juice./"", ""obj_dw_garden_diner_slash_Other_11_gml_111_0"");
			msgnextloc(""* She puts a lot of effort into makin' it./"", ""obj_dw_garden_diner_slash_Other_11_gml_112_0"");
			scr_anyface_next(""ralsei"", ""8"");
			msgnextloc(""\\E8* Oh^1, the cook?/"", ""obj_dw_garden_diner_slash_Other_11_gml_114_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* No^1, Orange!/"", ""obj_dw_garden_diner_slash_Other_11_gml_116_0"");
			scr_anyface_next(""susie"", ""C"");
			msgnextloc(""\\EC* Huh?/"", ""obj_dw_garden_diner_slash_Other_11_gml_118_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* It's called \""Orange Juice\"" 'cause it comes from some'un named Orange./"", ""obj_dw_garden_diner_slash_Other_11_gml_120_0"");
			var option1 = QuestionThis;
			var option2 = LeaveHim;
			scr_readychoicer(option1, option2);
			d_make();
			scr_msgno_func(2, function()
			{
				marker.sprite_index = spr_yellow_sit_down;
			});
			myinteract++;
		}
		else
		{
			endConvo();
		}
	}
	if (myinteract == 6 && global.choice != -1)
	{
		if (global.choice == 0)
		{
			k_d(1);
			scr_speaker(""susie"");
			msgsetloc(0, ""\\EK* Uh^1, no^1. It comes from a fruit./"", ""obj_dw_garden_diner_slash_Other_11_gml_146_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Oh no..^1. I been drinking FRUIT's juice!?/"", ""obj_dw_garden_diner_slash_Other_11_gml_148_0"");
			msgnextloc(""* Thought I was drinking human's juice..^1. like natural.../"", ""obj_dw_garden_diner_slash_Other_11_gml_149_0"");
			scr_anyface_next(""ralsei"", ""9"");
			msgnextloc(""\\E9* Human beings don't^1, um..^1. generate..^1. juice./"", ""obj_dw_garden_diner_slash_Other_11_gml_151_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Huh^1? But she LOOKS like a human bean^1! Cowboy's honor!!/"", ""obj_dw_garden_diner_slash_Other_11_gml_153_0"");
			msgnextloc(""* She even has a tail!/"", ""obj_dw_garden_diner_slash_Other_11_gml_154_0"");
			var option1 = QuestionThis;
			var option2 = LeaveHim;
			scr_readychoicer(option1, option2);
			d_make();
			scr_msgno_func(2, function()
			{
				marker.sprite_index = spr_yellow_sit_down_surprised;
				hatjump();
			});
			scr_msgno_func(3, function()
			{
				marker.sprite_index = spr_yellow_sit_left_shakehead;
				marker.image_speed = 0.16666666666666666 / global.fps_scale;
				hatkill();
			});
			scr_msgno_func(5, function()
			{
				marker.sprite_index = spr_yellow_sit_left_shakehead;
				marker.image_speed = 0;
			});
			scr_msgno_func(7, function()
			{
				marker.sprite_index = spr_yellow_sit_down;
				marker.image_speed = 0;
			});
			myinteract++;
		}
		else
		{
			endConvo();
		}
	}
	if (myinteract == 7 && global.choice != -1)
	{
		if (global.choice == 0)
		{
			k_d(1);
			scr_speaker(""susie"");
			msgsetloc(0, ""\\EB* ..^1. do YOU have a tail?/"", ""obj_dw_garden_diner_slash_Other_11_gml_197_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Haha^1, of course I.../"", ""obj_dw_garden_diner_slash_Other_11_gml_199_0"");
			msgnextloc(""* ..^1. hm./"", ""obj_dw_garden_diner_slash_Other_11_gml_200_0"");
			msgnextloc(""* Well I'll be^1. Looks like I left it at home./"", ""obj_dw_garden_diner_slash_Other_11_gml_201_0"");
			scr_anyface_next(""susie"", ""6"");
			msgnextloc(""\\E6* What kind of tail even is it?/"", ""obj_dw_garden_diner_slash_Other_11_gml_203_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Well^1, I am a cowboy so I'dn assume it'd be a cow's tail./"", ""obj_dw_garden_diner_slash_Other_11_gml_205_0"");
			scr_anyface_next(""ralsei"", ""9"");
			msgnextloc(""\\E9* .../"", ""obj_dw_garden_diner_slash_Other_11_gml_207_0"");
			scr_anyface_next(""susie"", ""7"");
			msgnextloc(""\\E7* OK well see ya./"", ""obj_dw_garden_diner_slash_Other_11_gml_209_0"");
			scr_anyface_next(""yellow"", 0);
			msgnextloc(""* Have a nice ride on the prairie^1, y'all!/"", ""obj_dw_garden_diner_slash_Other_11_gml_211_0"");
			msgnextloc(""* And..^1. stay outta justice's way./"", ""obj_dw_garden_diner_slash_Other_11_gml_212_0"");
			scr_anyface_next(""ralsei"", ""8"");
			msgnextloc(""\\E8* Why thank you^1, sir./%"", ""obj_dw_garden_diner_slash_Other_11_gml_214_0"");
			d_make();
			scr_msgno_func(4, function()
			{
				marker.sprite_index = spr_yellow_sit_down_surprised;
				hatjump();
			});
			scr_msgno_func(8, function()
			{
				marker.sprite_index = spr_yellow_sit_down;
				hatkill();
			});
			scr_msgno_func(15, function()
			{
				marker.sprite_index = spr_yellow_sit_down_downeyes;
				hatkill();
			});
			myinteract = 9;
		}
		else
		{
			endConvo();
		}
	}
	if (myinteract == 9 && !d_ex())
	{
		endConvo();
	}
}
