{
	snd_pause(global.currentsong[1]);
	snd_play(snd_toilet);
	con = 61;
	alarm[0] = round(30 * global.fps_scale);
}
if (con == 62 && !d_ex())
{
	con = 63;
	specflush = 0;
	snd_play(snd_won);
	flush += 1;
	if (flush == 3)
	{
		specflush = 1;
	}
	if (flush == 6)
	{
		specflush = 2;
	}
	if (flush == 9)
	{
		specflush = 3;
	}
	var flush_text = stringsetloc(""* (You flushed the toilet!)/"", ""obj_room_torbathroom_slash_Step_0_gml_61_0"");
	scr_speaker(""no_name"");
	msgset(0, flush_text + ""%"");
	d_make();
	if (scr_flag_get(1435) == 0)
	{
		if (specflush > 0)
		{
			if (scr_flag_get(1436) == 0)
			{
				scr_flag_set(1436, 1);
			}
		}
	}
	else if (scr_flag_get(1435) == 2)
	{
		if (scr_flag_get(1436) == 1)
		{
			scr_flag_set(1436, 2);
		}
	}
	else if (scr_flag_get(1439) == 0)
	{
		if (scr_litemcheck(19) == 1)
		{
			scr_speaker(""no_name"");
			msgset(0, flush_text);
			scr_anyface_next(""toriel"", ""5"");
			msgnextloc(""\\E5* KRIS!!^1! DON'T FLUSH MY TOAST!!!/%"", ""obj_room_torbathroom_slash_Step_0_gml_93_0"");
			d_make();
		}
	}
}
