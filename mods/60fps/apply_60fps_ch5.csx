					{
						scr_speaker(""susie"");
						msgsetsubloc(0, ""\\E9* Double super worth."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_cliff_twirlflowerplatforming_slash_Step_0_gml_128_0"");
						d_make_plat(0, 0, undefined, undefined, 1);
