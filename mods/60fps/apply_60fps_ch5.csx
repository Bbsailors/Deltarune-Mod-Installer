check_new_gamepad_dir = function(arg0)
{
	var current_angle = scr_gamepad_get_left_axis();
	if (current_angle != -1)
	{
		if (last_accepted_input_angle > -2)
		{
			if (last_accepted_input_angle == -1)
			{
				last_accepted_input_angle = current_angle;
				return 6;
			}
		}
		return 0;
	}
	last_accepted_input_angle = -1;
	return arg0;
};

find_best_target = function(arg0)
{
	var can_act = [scr_plat_can_act(""su""), scr_plat_can_act(""ra"")];
	var pressdir = (arg0.type - 1) * 90;
	if (arg0.type == 6)
	{
		pressdir = last_accepted_input_angle;
	}
	var result = [];
	var is_on_kris = targetindex == -1;
	var i = ds_list_size(act_targets_list) - 1;
	for (; i >= 0; i--)
	{
		if (i != targetindex)
		{
			var o = ds_list_find_value(act_targets_list, i);
			if (o != -4 && instance_exists(o) && o.active)
			{
				if ((o.char == ""all"" || o.char == ""none"" || o.char == ""kr"" || can_act[o.char == ""ra""]) && !o.blocked)
				{
					var pdir = point_direction(arg0.to.cx, arg0.to.cy, o.cx, o.cy);
					var pdist = point_distance(arg0.to.cx, arg0.to.cy, o.cx, o.cy);
					var is_close = is_on_kris && pdist < 30;
					var ang = abs(angle_difference(pressdir, pdir));
					var new_best = false;
					if (!is_close && pdist < (arg0.bestdist + ((arg0.bestangle - ang) * 2)) && ang < arg0.angle_limit)
					{
						new_best = true;
					}
					if (is_close)
					{
						var pointx = lengthdir_x(1, pressdir);
						var pointy = lengthdir_y(1, pressdir);
						var pdist2 = point_distance(arg0.to.cx, arg0.to.cy, o.cx + pointx, o.cy + pointy);
						if (pdist < arg0.bestdist || (arg0.best_is_close && pdist2 > pdist))
						{
							new_best = true;
						}
					}
					if (new_best)
					{
						if (!arg0.best_is_close)
						{
							arg0.secondbest = arg0.best;
							arg0.secondbesti = arg0.besti;
							arg0.secondbestdist = arg0.bestdist;
							arg0.secondbestangle = arg0.bestangle;
						}
						arg0.best = o;
						arg0.besti = i;
						arg0.bestdist = pdist;
						arg0.bestangle = ang;
						arg0.best_is_close = is_close;
						continue;
					}
					else if (!is_close && pdist < (arg0.secondbestdist + ((arg0.secondbestangle - ang) * 2)) && ang < 85)
					{
						arg0.secondbest = o;
						arg0.secondbesti = i;
						arg0.secondbestdist = pdist;
						arg0.secondbestangle = ang;
					}
				}
			}
			else
			{
				ds_list_delete(act_targets_list, i);
			}
		}
	}
};

enum UnknownEnum
{
	Value_0,
	Value_16 = 16
}
");

