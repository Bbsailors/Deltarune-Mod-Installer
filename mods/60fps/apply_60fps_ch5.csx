	c_msgstay(3);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\El* Yes^1. Finally^1, the fruits of my research will come to bear.../"", ""obj_ch5_DWCL00_slash_Step_0_gml_162_0"");
	c_msgcmd(""mus"", ""initloop"", ""asgore_serious.ogg"", 0);
	c_msgcmd(""mus"", ""volume"", 0, 0);
	c_msgcmd(""mus"", ""volume"", 1, 30);
	c_msgnextloc(""\\EU* And then^1, I'll only need ONE last piece of proof./"", ""obj_ch5_DWCL00_slash_Step_0_gml_166_0"");
	c_msgnextloc(""\\EP* ..^1. THEM./"", ""obj_ch5_DWCL00_slash_Step_0_gml_167_0"");
	c_msgnextloc(""\\EV* ..^1. the creator of the Dark Fountain./%"", ""obj_ch5_DWCL00_slash_Step_0_gml_168_0"");
	c_talk_wait();
