	}
	scr_shakeobj();
	with (instance_create_depth(xx, yy, depth, obj_plat_vfx))
	{
		sprite_index = spr_hit_vfx;
		image_speed = 1;
	}
	with (instance_create_depth(xx, yy, depth, obj_plat_vfx))
	{
		sprite_index = spr_smokepuff;
		image_speed = 2;
	}
	if (hp <= 0)
	{
		scr_shakeobj();
		con = 99;
		timer = 0;
		current_animation = -4;
	}
};

