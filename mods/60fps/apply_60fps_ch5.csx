water_green = function()
{
	with (npc_green)
	{
		if (flower == -4)
		{
			flower = instance_create(mean(bbox_left, bbox_right) - 40, y - 16, obj_marker);
			with (flower)
			{
				sprite_index = spr_ralsei_flower_only;
				scr_darksize();
				depth = other.depth + 1;
				image_speed = 0;
				scr_lerpvar(""image_index"", 0, 6, 12);
				snd_play(snd_harp_strum, 1, 1.1);
				if (other.hspeed == (4 / global.fps_scale))
				{
					x += 80;
					image_xscale *= -1;
					hspeed = 4 / global.fps_scale;
				}
			}
		}
	}
};

green_leave = function()
{
	show_green = false;
	with (npc_green)
	{
		sprite_index = spr_enemy_green_walk_right;
		image_speed = 0.25 / global.fps_scale;
		hspeed = 4 / global.fps_scale;
		with (flower)
		{
			x += 80;
			image_xscale *= -1;
			hspeed = 4 / global.fps_scale;
		}
	}
};

if (global.plot >= 405 && global.entrance != 2 && (global.flag[1455] < 70 || global.flag[1455] >= 100))
{
	var ok = function(arg0)
	{
		if (arg0 == 1810)
		{
			return true;
		}
		if (arg0 == 1812 && global.flag[1812] && global.flag[672] == -1)
		{
			return -2;
		}
		if (arg0 == 1811 && global.flag[1811] && (global.flag[672] == -1 || global.flag[673] == -1 || global.flag[1906] == -1))
		{
			return -2;
		}
		if (arg0 == 1814 && global.flag[1814] && global.flag[675] == -1)
		{
			return -2;
		}
		if (arg0 == 1813 && global.flag[1813] && global.flag[677] == -1)
		{
			return -2;
		}
		if (arg0 == 1815 && global.flag[1815] && (global.flag[672] == -1 || global.flag[676] == -1))
		{
			return -2;
		}
		if (global.flag[arg0] == 1)
		{
			return 1;
		}
		else
		{
			return -1;
		}
	};
	
	var previousresult = [];
	for (var i = 0; i < 7; i++)
	{
		array_push(previousresult, scr_flag_get_ext(1856, i, 2));
	}
	var flowerlegend = [1811, 1812, 1813, 1810, 1814, 1815, 1816];
	var currentresult = [];
	for (var i = 0; i < array_length(flowerlegend); i++)
	{
		var check = ok(flowerlegend[i]);
		if (check == 1)
		{
			array_push(currentresult, 1);
		}
		else
		{
			array_push(currentresult, 0);
		}
	}
	for (var i = 0; i < array_length(currentresult); i++)
	{
		if (previousresult[i] != currentresult[i])
		{
			if (currentresult[i] == 1)
			{
				show_green = true;
				break;
			}
		}
	}
}
