Apply("gml_Object_obj_gigaheart_Draw_0", @"if (con == 0)
{
	timer += (1 / global.fps_scale);
	if (timer < 21)
	{
		whitealpha += (0.05 / global.fps_scale);
	}
	if (timer > 20 && timer < 36)
	{
		image_alpha += (0.1 / global.fps_scale);
	}
	if ((timer % 4) == 0)
	{
		afterimage = instance_create(x, y, obj_afterimage_fog);
		afterimage.sprite_index = sprite_index;
		afterimage.image_index = image_index;
		afterimage.image_blend = image_blend;
		afterimage.image_speed = 0;
		afterimage.depth = depth;
		afterimage.image_xscale = image_xscale;
		afterimage.image_yscale = image_yscale;
		afterimage.image_angle = image_angle;
		afterimage.image_alpha = whitealpha / 2;
		afterimage.type = 1;
	}
	timer2 += (1 / global.fps_scale);
	if (timer2 >= 8 && timer < 50)
	{
		instance_create((x - 130) + irandom(40), (y - 100) + irandom(60), obj_gigaheart_particle);
		instance_create(x - 90 - irandom(40), (y - 50) + irandom(100), obj_gigaheart_particle);
		instance_create(x - 30 - irandom(20), (y + 120) - irandom(60), obj_gigaheart_particle);
		timer2 = 0;
	}
	if (timer > 60)
	{
		whitealpha -= (0.4 / global.fps_scale);
		if (whitealpha <= 0.2)
		{
			timer = 0;
			con = 1;
			image_xscale = 2.5;
			image_yscale = 2.5;
			snd_play_x(snd_explosion_mmx3, 0.6, 0.5);
			snd_play_x(snd_explosion_mmx3, 0.6, 0.375);
			scr_shakescreen();
		}
	}
}
image_xscale = lerp(image_xscale, 2, scr_fps_lerp_rate(0.4));
image_yscale = lerp(image_yscale, 2, scr_fps_lerp_rate(0.4));
if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer > 30)
	{
		image_alpha -= (0.04 / global.fps_scale);
		whitealpha -= (0.01 / global.fps_scale);
		if (image_alpha <= 0)
		{
			instance_destroy();
		}
	}
	else
	{
	}
}
draw_self();
gpu_set_fog(1, c_white, 0, 0);
draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, whitealpha);
gpu_set_fog(0, c_white, 0, 0);
");

