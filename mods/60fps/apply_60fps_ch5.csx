	var startcamx = camerax();
	var startcamy = cameray();
	var walkspeed = 6;
	var camspeed = walkspeed;
	var camtime = scr_returnwait(startcamx, startcamy, cam.x, cam.y, camspeed);
	var camtime2 = scr_returnwait(cam.x, cam.y, cam2.x, cam2.y, camspeed);
	var krmarker = scr_heromarker(""kr"", ""floweryface"");
	var ramarker = scr_heromarker(""ra"", ""floweryface"");
	var sumarker = scr_heromarker(""su"", ""floweryface"");
	scr_maincharacters_actors();
	var _walktimeKr = ceil(point_distance(kr_actor.x, kr_actor.y, krmarker[0], krmarker[1]) / walkspeed);
	var _walktimeRa = ceil(point_distance(ra_actor.x, ra_actor.y, ramarker[0], ramarker[1]) / walkspeed);
	var _walktimeSu = ceil(point_distance(su_actor.x, su_actor.y, sumarker[0], sumarker[1]) / walkspeed);
	var waittime = max(_walktimeKr, _walktimeRa, _walktimeSu, camtime);
	var lay = ""ASSETS_FloweryFaceFinish"";
	var krisd = findspriteinfo(spr_krisd_dark, lay);
	var krisr = findspriteinfo(spr_krisr_dark, lay);
	var krisl = findspriteinfo(spr_krisl_dark, lay);
	var krisu = findspriteinfo(spr_krisu_dark, lay);
