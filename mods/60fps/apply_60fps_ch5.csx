Apply("gml_Object_obj_dokiheal_anim_Step_0", @"t += (1 / global.fps_scale);
if (i_ex(target))
{
	if (t == 1)
	{
		x = target.x;
		y = target.y;
		image_xscale = target.image_xscale;
		image_yscale = target.image_yscale;
		sprite_index = target.sprite_index;
		sw = sprite_width;
		sh = sprite_height;
		with (target)
		{
			inst = scr_oflash();
			inst.sprite_index = spr_pink_front_sweat;
		}
	}
	if (t >= 1 && heartcount > 0)
	{
		heartcount--;
		for (i = 0; i < 2; i += 1)
		{
			star[starcount] = instance_create(x + random(sw), y + random(sh), obj_marker);
			with (star[starcount])
			{
				image_angle = random(360);
				depth = -10;
				image_xscale = 2;
				image_yscale = 2;
				image_alpha = 2;
				image_speed = 0.25;
				hspeed = (2 - random(2)) / global.fps_scale;
				vspeed = (-3 - random(2)) / global.fps_scale;
				friction = 0.2 / (global.fps_scale * global.fps_scale);
			}
			star[starcount].sprite_index = particlesprite;
			star[starcount].image_blend = particlecolor;
			starcount += 1;
		}
	}
	if (t >= 5 && t <= 30)
	{
		for (i = 0; i < starcount; i += 1)
		{
			with (star[i])
			{
				image_angle -= (10 / global.fps_scale);
				image_alpha -= (0.1 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy();
				}
			}
		}
		if (t >= 30)
		{
			instance_destroy();
		}
	}
}
else
{
	for (i = 0; i < starcount; i += 1)
	{
		with (star[i])
		{
			instance_destroy();
		}
	}
	instance_destroy();
}
");

Apply("gml_Object_obj_dokiheart_Draw_0", @"var _scale = 1;
switch (floor(pulse))
{
	case 0:
		_scale = 1.5;
		break;
	case 1:
		_scale = 1.25;
		break;
	case 2:
		_scale = 1.2;
		break;
	case 3:
		_scale = 1.15;
		break;
	case 4:
		_scale = 1.1;
		break;
	case 5:
		_scale = 1.05;
		break;
}
_scale = _scale * visual_scale;
switch (mode)
{
	case 1:
		if (instance_exists(obj_huge_anime_face))
		{
			scr_draw_outline_ext(sprite_index, 0, xdraw, ydraw, image_xscale * _scale, image_yscale * _scale, image_angle + lengthdir_x(15, lifetime * 15), c_black, image_alpha * 0.5, 8);
		}
		draw_sprite_ext(sprite_index, 0, xdraw, ydraw, image_xscale * _scale, image_yscale * _scale, image_angle + lengthdir_x(15, lifetime * 15), #FF88AA, image_alpha);
		break;
	default:
		if (instance_exists(obj_huge_anime_face))
		{
			scr_draw_outline_ext(sprite_index, 0, xdraw, ydraw + lengthdir_y(2, lifetime * 10), image_xscale * _scale, image_yscale * _scale, image_angle + lengthdir_x(15, lifetime * 15), c_black, image_alpha * 0.5, 8);
		}
		draw_sprite_ext(sprite_index, 0, xdraw, ydraw + lengthdir_y(2, lifetime * 10), image_xscale * _scale, image_yscale * _scale, image_angle + lengthdir_x(15, lifetime * 15), #FF88AA, image_alpha);
}
");

Apply("gml_Object_obj_dokiheart_Step_0", @"if (mode == 1)
{
	if (friction > 0)
	{
		var _speedlimit = 0.8 / global.fps_scale;
		if (speed > _speedlimit)
		{
			friction = min((speed * 0.25) / global.fps_scale, friction);
		}
		else
		{
			speed = _speedlimit;
			gravity_direction = 90;
			gravity = 0.06 / (global.fps_scale * global.fps_scale);
			friction = 0.03 / (global.fps_scale * global.fps_scale);
		}
	}
	with (obj_dokiheart)
	{
		if (id != other.id)
		{
			var _dist = point_distance(other.x, other.y, x, y);
			if (_dist < 22)
			{
				var _dir = point_direction(other.x, other.y, x, y);
				var _spd = (4/3) / global.fps_scale;
				x += lengthdir_x(_spd, _dir);
				y += lengthdir_y(_spd, _dir);
				other.x -= lengthdir_x(_spd, _dir);
				other.y -= lengthdir_y(_spd, _dir);
				_spd = ((_dist / 22) * max(0, 1 - (speed / 3)) * 0.5) / (global.fps_scale * global.fps_scale);
				other.hspeed += lengthdir_x(_spd, _dir + 180);
				hspeed += lengthdir_x(_spd, _dir);
				break;
			}
		}
	}
	var _pickdist = 42;
	if (instance_exists(obj_heart))
	{
		var _dist = point_distance(x, y, obj_heart.x, obj_heart.y);
		if (_dist < _pickdist)
		{
			var _dir = point_direction(x, y, obj_heart.x, obj_heart.y);
			_dist = (1 + (((_pickdist - _dist) / _pickdist) * 11)) / global.fps_scale;
			x += lengthdir_x(_dist, _dir);
			y += lengthdir_y(_dist, _dir);
		}
	}
}
if (instance_exists(obj_heart))
{
	if (collision_rectangle(obj_heart.x + (2 * obj_heart.image_xscale), obj_heart.y + (2 * obj_heart.image_yscale), obj_heart.x + (18 * obj_heart.image_xscale), obj_heart.y + (18 * obj_heart.image_yscale), id, false, false))
	{
		snd_play(snd_power);
		scr_healall(1);
		if (instance_exists(act_to_change))
		{
			if (act_to_change.object_index == obj_pinknodeact)
			{
				act_to_change.mode = 1;
				act_to_change.life_time = 0;
			}
			else
			{
				with (act_to_change)
				{
					hp -= 1;
					event_user(1);
				}
			}
		}
		with (obj_tensionbar)
		{
			if (maxtensionlimitpercent < 100)
			{
				maxtensionlimitpercent = min(100, maxtensionlimitpercent + other.tension_value);
			}
			maxtensionlimit += (other.tension_value * 2.5);
			if (maxtensionlimit > 250)
			{
				maxtensionlimit = 250;
			}
		}
		if (i_ex(obj_dbulletcontroller) && obj_dbulletcontroller.type == 208)
		{
			scr_tensionheal(tension_value * 2.5);
		}
		else
		{
			scr_tensionheal(tension_value * 2.5);
		}
		snd_stop(snd_swallow);
		snd_play(snd_swallow);
		with (instance_create_depth(x + hspeed, y + vspeed, depth + 1, obj_bulletparent))
		{
			image_angle = 0;
			image_xscale = 0.1 * image_xscale;
			image_yscale = 0.1 * image_yscale * choose(-1, 1);
			scr_lerpvar(""image_xscale"", image_xscale, image_xscale * 3, 4);
			scr_lerpvar(""image_yscale"", image_yscale, image_yscale * 3, 4);
			sprite_index = spr_finisher_explosion;
			image_index = 2;
			image_speed = 1 / global.fps_scale;
			if (i_ex(obj_pink_enemy))
			{
				image_blend = obj_pink_enemy.c_pink;
			}
			scr_script_delayed(instance_destroy, 3);
		}
		if (i_ex(obj_pink_tension_glow))
		{
			with (obj_pink_tension_glow)
			{
				alphamod = 1;
			}
		}
		else
		{
			instance_create_depth(0, 0, 0, obj_pink_tension_glow);
		}
		instance_destroy();
	}
}
lifetime += (1 / global.fps_scale);
if (!i_ex(obj_heart))
{
	instance_destroy();
}
else if (lifetime >= maxlifetime && maxlifetime > 0)
{
	image_alpha = min(image_alpha, 1);
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0.001)
	{
		instance_destroy();
	}
}
else
{
	image_alpha = min(image_alpha + (0.1 / global.fps_scale), 1);
}
pulse += (1 / global.fps_scale);
if (pulse >= 15)
{
	pulse = 0;
}
");

Apply("gml_Object_obj_dokiheart_Step_2", @"var _spd = point_distance(xdraw, ydraw, x, y);
if (_spd <= (speed + 1))
{
	xdraw = x;
	ydraw = y;
}
else
{
	var _dir = point_direction(xdraw, ydraw, x, y);
	xdraw += lengthdir_x((_spd * scr_fps_lerp_rate(0.2)) + speed, _dir);
	ydraw += lengthdir_y((_spd * scr_fps_lerp_rate(0.2)) + speed, _dir);
}
if (instance_exists(mother))
{
	x = mother.x;
	y = mother.y;
}
");

