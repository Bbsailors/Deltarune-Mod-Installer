							d_line_width_color(x - 75, (y - box_extra - 75) + 2, x + 75, (y - box_extra - 75) + 2, 4, image_blend, image_blend);
							d_line_width_color((x + 75) - 2, (y + 75) - 2, (x + 75) - 2, (y - box_extra - 75) + 2, 4, image_blend, image_blend);
						}
					};
					
