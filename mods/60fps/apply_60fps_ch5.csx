Apply("gml_Object_obj_bullet_super_nubert2_Draw_0", @"for (var a = 0; a < nr; a++)
{
	if (a == 0 || nr <= global.fps_scale)
	{
		continue;
	}
	draw_primitive_begin(pr_trianglelist);
	draw_vertex_color(bbb[a][0], bbb[a][1], #0B0B3B, 1);
	draw_vertex_color(bbb[a - 1][0], bbb[a - 1][1], #0B0B3B, 1);
	draw_vertex_color(bbb[a - 1][2], bbb[a - 1][3], #0B0B3B, 1);
	draw_vertex_color(bbb[a][0], bbb[a][1], #0B0B3B, 1);
	draw_vertex_color(bbb[a][2], bbb[a][3], #0B0B3B, 1);
	draw_vertex_color(bbb[a - 1][2], bbb[a - 1][3], #0B0B3B, 1);
	draw_primitive_end();
}
for (var a = 0; a < nr; a++)
{
	if (a == 0 || nr <= global.fps_scale)
	{
		continue;
	}
	draw_primitive_begin(pr_trianglelist);
	draw_vertex_color(aaa[a][0], aaa[a][1], #ED1C24, 1);
	draw_vertex_color(aaa[a - 1][0], aaa[a - 1][1], #ED1C24, 1);
	draw_vertex_color(aaa[a - 1][2], aaa[a - 1][3], #ED1C24, 1);
	draw_vertex_color(aaa[a][0], aaa[a][1], #ED1C24, 1);
	draw_vertex_color(aaa[a][2], aaa[a][3], #ED1C24, 1);
	draw_vertex_color(aaa[a - 1][2], aaa[a - 1][3], #ED1C24, 1);
	draw_primitive_end();
	if (a == (nr - 1))
	{
		draw_sprite_ext(spr_nubert_segment_crown, 0, ns[a][0], ns[a][1], 2, 2, ns[a][2], image_blend, image_alpha);
	}
}
if (nr == 0)
{
	draw_sprite_ext(spr_nubert_sideways, 4, x, y, 2, 2, nubert_first_angle, image_blend, image_alpha);
}
if (nr >= 1 && nr <= global.fps_scale)
{
	draw_sprite_ext(spr_nubert_sideways, 3, x, y, 2, 2, nubert_first_angle, image_blend, image_alpha);
}
if (!(nubert_reverse && (nr == 0 || nr == 1)) && nr != 0 && nr != 1 && !(nr >= 1 && nr <= global.fps_scale))
{
	draw_sprite_ext(spr_nubert_butt, 0, x, y, 2, 2, nubert_first_angle, image_blend, image_alpha);
}
");

Apply("gml_Object_obj_bullet_super_nubert2_Step_0", @"if (!nubert_done && !nubert_reverse)
{
	var _speed = nubert_speed / global.fps_scale;
	var _cannon = nubert_cannon;
	if (nubert_angle != nubert_angle_goal)
	{
		_speed *= 0.5;
	}
	ns[nr] = [nubert_x, nubert_y, nubert_angle, _speed];
	aaa[nr] = [nubert_x + lengthdir_x(16, nubert_angle - 90), nubert_y + lengthdir_y(16, nubert_angle - 90), nubert_x + lengthdir_x(16, nubert_angle + 90), nubert_y + lengthdir_y(16, nubert_angle + 90)];
	bbb[nr] = [nubert_x + lengthdir_x(18, nubert_angle - 90), nubert_y + lengthdir_y(18, nubert_angle - 90), nubert_x + lengthdir_x(18, nubert_angle + 90), nubert_y + lengthdir_y(18, nubert_angle + 90)];
	nubert_hurt[nr] = instance_create(ns[nr][0], ns[nr][1], obj_collidebullet);
	with (nubert_hurt[nr])
	{
		scr_bullet_init();
		scr_bullet_inherit_from(id, 962);
		grazepoints /= global.fps_scale;
		timepoints /= global.fps_scale;
		destroyonhit = false;
		mask_index = spr_nubert_segment_m;
		image_yscale = 1.25;
