}
moving_layers = instance_create_depth(0, 0, sun_depth, obj_parallax_cliffs_moving_layers);
moving_layers.daddy = id;
lay_sun = instance_create_depth(320, 280, sun_depth, obj_parallax_cliffs_sunlayer);
for (var i = 0; i < 2; i++)
{
	var marker = instance_create(0, 0, obj_marker);
	marker.sprite_index = spr_parallax_cliffs_sunlayer_base;
	marker.depth = sun_depth + 5;
	marker.image_alpha = 0.35;
	marker.image_speed = (0.25 + (0.1 * i)) / global.fps_scale;
	marker.image_xscale = 1 + (0.1 * (i + 1));
	marker.image_yscale = 1 + (0.1 * (i + 1));
	marker.start_xscale = marker.image_xscale;
	marker.start_yscale = marker.image_yscale;
	marker.start_alpha = marker.image_alpha;
	array_push(sun_glow_markers, marker);
	marker.visible = 0;
}
