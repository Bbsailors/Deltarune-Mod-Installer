{
	if (i_ex(obj_heart))
	{
		xx = obj_heart.x;
		if (obj_heart.dash_h > 4)
		{
			y = obj_heart.y;
		}
	}
	if ((i_ex(obj_heart) && obj_heart.dash_h < 4) || !i_ex(obj_heart))
	{
		act = 1;
	}
}
else
{
	alpha -= (0.2 / global.fps_scale);
	if (alpha <= 0)
	{
		instance_destroy();
	}
}
draw_set_alpha(alpha);
