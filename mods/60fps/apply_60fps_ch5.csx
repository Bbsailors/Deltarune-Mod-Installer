		else
		{
			con = 1;
			timer = 0;
		}
	}
}
if (con == 1)
{
	if (timer == 5)
	{
		scr_oflash();
	}
	if (timer == 15)
	{
		sprite_index = spr_shinobeetle;
		with (instance_create(x + (0.5 * sprite_width), y + (0.5 * sprite_height), obj_plat_bulletred))
		{
			var dir = point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
			direction = dir;
			speed = 10 / global.fps_scale;
			depth = other.depth - 1;
		}
	}
	if (timer == 35)
	{
		if (mode == 1)
		{
