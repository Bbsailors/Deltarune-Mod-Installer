Apply("gml_Object_obj_multiboss_enemy2_Create_0", @"scr_enemy_object_init();
recruitcount = 5;
talkmax = 90;
image_speed = 0.16666666666666666 / global.fps_scale;
idlesprite = spr_diamondm_idle;
