draw_set_halign(fa_left);
");

Apply("gml_Object_obj_dw_dogballoon_Step_0", @"scr_populatechars();
if (!init)
{
	init = 1;
}
if (con == 10)
{
	timer = 0;
	global.interact = 1;
	obj_mainchara.cutscene = 1;
	global.facing = 0;
	camloc = findspriteinfo(spr_debug_cameraregionpreview, ""DEBUG_ASSETS"");
	campos = scr_getcam();
	camwait = 30;
	con = 11;
}
if (con == 11)
{
	timer += (1 / global.fps_scale);
	var camx = round(ease_out_cubic(timer, campos.x, camloc.x - campos.x, camwait));
	var camy = round(ease_out_cubic(timer, campos.y, camloc.y - campos.y, camwait));
	camera_setxy(camx, camy);
	if (timer >= camwait)
	{
		con = 12;
		timer = 0;
		camera_setxy(camloc.x, camloc.y);
	}
}
if (con == 12)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		var pedloc = findsprite(spr_wateringpedestal, ""DEBUG_ASSETS"");
		pedmarker = scr_marker_fromasset(pedloc, undefined, undefined, 1);
		with (pedmarker)
		{
			done = false;
			scr_depth();
			bouncecount = 0;
			gravity = 1 / (global.fps_scale * global.fps_scale);
			y = cameray() - 80;
			
			end_step_func = function()
			{
				if (y > ystart)
				{
					y = ystart;
					bouncecount++;
					var maxbounce = 4;
					snd_play(snd_wing, lerp(0.9, 0.4, bouncecount / maxbounce), 1.8);
					vspeed = (-vspeed * 1) / 2;
					if (bouncecount >= maxbounce)
					{
						vspeed = 0;
						gravity = 0;
						y = ystart;
						done = true;
					}
				}
			};
		}
	}
	if (timer == 15)
	{
		var waterloc = findsprite(spr_wateringcan, ""DEBUG_ASSETS"");
		watermarker = scr_marker_fromasset(waterloc, undefined, undefined, 1);
		with (watermarker)
		{
			sprite_index = spr_wateringcan_dog;
			done = false;
			depth = obj_dw_dogballoon.pedmarker.depth - 1;
			bouncecount = 0;
			gravity = 1 / (global.fps_scale * global.fps_scale);
			y = cameray() - 80;
			
			end_step_func = function()
			{
				if (y > ystart || y > (obj_dw_dogballoon.pedmarker.y + 8))
				{
					y = min(obj_dw_dogballoon.pedmarker.y + 8, ystart);
					bouncecount++;
					var maxbounce = 3;
					snd_play(snd_wing, lerp(0.9, 0.4, bouncecount / maxbounce), 2);
					vspeed = (-vspeed * 1) / 2;
					if (bouncecount >= maxbounce)
					{
						vspeed = 0;
						gravity = 0;
						y = ystart;
						done = true;
					}
				}
			};
		}
	}
	if (timer > 15 && pedmarker.done && watermarker.done)
	{
		con = 13;
		timer = 0;
		snd_play(snd_item);
		instance_create(pedmarker.x, pedmarker.y, obj_wateringcan_pedestal);
		with (pedmarker)
		{
			scr_doom(id, 1);
		}
		with (watermarker)
		{
			scr_doom(id, 1);
		}
		camloc = scr_darkcameraideal();
		campos = scr_getcam();
		camwait = 20;
	}
}
if (con == 13)
{
	timer += (1 / global.fps_scale);
	var camx = round(ease_out_cubic(timer, campos.x, camloc.x - campos.x, camwait));
	var camy = round(ease_out_cubic(timer, campos.y, camloc.y - campos.y, camwait));
	camera_setxy(camx, camy);
	if (timer >= camwait)
	{
		con = 14;
		timer = 0;
		camera_setxy(camloc.x, camloc.y);
		obj_mainchara.cutscene = false;
		global.interact = 0;
	}
}
with (obj_wateringcan)
{
	if (!variable_instance_exists(id, ""doginit""))
	{
		doginit = 1;
		wateringtimer = 0;
		dogsound = -4;
		sprite_index = spr_wateringcan_dog;
		left_idle_sprite = 8300;
		right_idle_sprite = 8537;
		left_walk_bow_sprite = 5733;
		right_walk_bow_sprite = 5863;
	}
	if (held && waterduration > 0)
	{
		if (button1_h())
		{
			wateringtimer += (1 / global.fps_scale);
		}
		else
		{
			wateringtimer = 0;
		}
		if (((wateringtimer - 1) % 6) == 0)
		{
			snd_stop(dogsound);
			dogsound = snd_play(snd_pombark, random_range(0.8, 0.9), random_range(0.2, 0.4));
		}
	}
}
");

