		c_spritenext(4969, 0);
		c_msgnextloc(""\\EI* After you left for the Festival today.../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1508_0"");
		c_spritenext(3541, 3);
		c_msgnextloc(""\\EQ* I tried to play that song^1, too^1. On the piano in Castle Town./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1510_0"");
		c_msgnextloc(""\\Ee* But I.../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1511_0"");
