Apply("gml_Object_obj_dw_fcastle_trainroom_Step_2", @"with (obj_plat_npc)
{
	if (waiting_initialization)
	{
		with (other)
		{
			if (con < 3)
			{
				con = 1;
			}
		}
		set_sprite(4776);
		if (waiting_initialization == 1)
		{
			image_xscale = 1;
			image_yscale = 1;
			vspeed = -8 / global.fps_scale;
			scr_lerpvar(""image_xscale"", 1, 2, 35, -2, ""out"");
			scr_lerpvar(""image_yscale"", 1, 2, 35, -2, ""out"");
		}
		else
		{
			y += 119;
		}
		engaged = false;
		plat = instance_create(x, y, obj_plat_movingplat);
		plat.image_xscale = 4;
		plat.movetype = -1;
		plat.visible = false;
		markersu = instance_create(x, y, obj_plat_movemarker);
		markersu.extflag = ""train_su"";
		markersu.force_facing = 1;
		markerra = instance_create(x, y, obj_plat_movemarker);
		markerra.extflag = ""train_ra"";
		markerra.force_facing = 1;
		movedir = 1;
		waiting_initialization = 0;
		custom_behaviour(function()
		{
			if (vspeed == 0)
			{
				plat.x = x - (0.5 * plat.sprite_width);
				plat.y = bbox_bottom - 18;
				markersu.x = x - 10;
				markersu.y = y;
				markerra.x = x - 60;
				markerra.y = y;
				if (scr_plat_standing_on(""kr"", plat))
				{
					with (obj_dw_fcastle_trainroom)
					{
						advance_conversation_timer = true;
					}
					hspeed = (1 * movedir) / global.fps_scale;
					engaged = true;
					if (x < xstart)
					{
						movedir = 1;
						with (obj_dw_fcastle_trainroom.npc_floradinn)
						{
							force_animation(6752);
						}
					}
					if (x > (xstart + 220))
					{
						movedir = -1;
						with (obj_dw_fcastle_trainroom.npc_floradinn)
						{
							force_animation(8535);
						}
					}
					if (obj_dw_fcastle_trainroom.con < 3)
					{
						with (obj_plat_follower)
						{
							if (caterpillarmode)
							{
								caterpillarmode = 0;
								state = 1;
								if (name == ""susie"")
								{
									followtarget = ""train_su"";
								}
								if (name == ""ralsei"")
								{
									followtarget = ""train_ra"";
								}
							}
							else if (reachedtarget)
							{
								if (name == ""susie"")
								{
									x = scr_approach(x, other.markersu.x, 1);
								}
								else
								{
									x = scr_approach(x, other.markerra.x, 1);
								}
							}
						}
					}
				}
				else if (instance_exists(obj_plat_player) && obj_plat_player.grounded && engaged)
				{
					engaged = false;
					with (obj_dw_fcastle_trainroom)
					{
						advance_conversation_timer = false;
					}
					if (obj_dw_fcastle_trainroom.con >= 3)
					{
						with (obj_plat_follower)
						{
							restore_animation();
							init_caterpillarmode();
						}
					}
				}
			}
		});
	}
}
with (leavingbubble)
{
	if (con == 0)
	{
		if (obj_orange_puppet.puppetmovement == 40)
		{
			con = 1;
			xstart = x;
			ystart = y;
			xoff = x - (obj_orange_puppet.puppet.x * 2);
			yoff = y - (obj_orange_puppet.puppet.y * 2);
		}
	}
	else
	{
		x = (obj_orange_puppet.puppet.x * 2) + xoff;
		y = (obj_orange_puppet.puppet.y * 2) + yoff;
		tx = x;
		ty = y;
	}
}
");

Apply("gml_Object_obj_dw_fcastle_ultradash_Step_0", @"if (!init)
{
	init = 1;
	scr_miniface_init_flowers();
	with (npc_aqua_start)
	{
		entity_gravity = 0;
		gravity = 0;
		con = 0;
		air_decel = 1;
		wallcollision = 0;
		physics = 0;
		loop = true;
		ground_decel = 1;
		force_animation(3483);
		timer = 0;
		custom_behaviour(function()
		{
			if (!global.pause_plat)
			{
				if (con == 0)
				{
					if (scr_trigcheck_ext(""aqua_start"", 912))
					{
						con = 1;
					}
				}
				if (con > 0)
				{
					timer += (1 / global.fps_scale);
					if (timer <= 10)
					{
						hspeed = lerp(hspeed, obj_plat_player.dashspeed * 2, timer / 10);
					}
					if (timer >= 85)
					{
						if (timer == 85)
						{
							snd_play(snd_pirouette);
							force_animation(4562);
						}
						if (timer < 105)
						{
							image_xscale = 2 * -cos(degtorad((720 * (timer - 85)) / 20));
						}
						else if (timer == 105)
						{
							force_animation(3483);
							image_xscale = 2;
						}
						hspeed += (0.5 / (global.fps_scale * global.fps_scale));
						image_speed += (0.02 / (global.fps_scale * global.fps_scale));
						vspeed -= (0.1 / (global.fps_scale * global.fps_scale));
					}
					if (timer == 25)
					{
						scr_speaker(""aqua"");
						msgsetsubloc(0, ""~1* Uuu^1, want to play fast game!?"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_ultradash_slash_Step_0_gml_55_0"");
						d_make_plat(0, 1);
					}
					if (timer == 130)
					{
						with (obj_plat_loopboundary)
						{
							if (extflag == ""aqua_x"")
							{
								instance_destroy();
							}
						}
					}
				}
			}
		});
	}
	if (room_cleared)
	{
		with (npc_aqua_start)
		{
			instance_destroy();
		}
		with (npc_aqua)
		{
			instance_destroy();
		}
		with (npc_seth)
		{
			instance_destroy();
		}
		with (obj_plat_dash_aqua)
		{
			instance_destroy();
		}
		with (obj_plat_loopboundary)
		{
			instance_destroy();
		}
		shicon = -1;
		for (var i = 0; i < array_length(shis); i++)
		{
			instance_destroy(shis[i]);
		}
	}
}
if (scr_trigcheck_ext(""disable_control"", 912))
{
	if (obj_plat_player.dashing)
	{
		obj_plat_player.can_jump = false;
	}
}
if (shicon == 0 && !global.pause_plat && scr_trigcheck_ext(""shi"", 912))
{
	shicon = 1;
	snd_play(snd_tensionhorn);
	global.interact = 1;
	with (obj_plat_player)
	{
		gravity = 0;
		cutscene = 1;
		entity_gravity = 0;
		hspeed = 0;
		vspeed = 0;
		dashing = false;
		image_speed = 0;
		paused_imgspd = 0;
		snd_stop(windloop_sound);
	}
	with (obj_plat_follower)
	{
		state = 1;
		caterpillarmode = 0;
		gravity = 0;
		cutscene = 1;
		entity_gravity = 0;
		hspeed = 0;
		image_speed = 0;
		vspeed = 0;
	}
	with (obj_plat_dashlines)
	{
		instance_destroy();
	}
}
if (shicon == 1)
{
	with (obj_plat_player)
	{
		image_speed = 0;
		paused_imgspd = 0;
	}
	shitimer += (1 / global.fps_scale);
	if (shitimer == 10)
	{
		snd_play(snd_tensionhorn, 1, 1.1);
		with (obj_darkcontroller)
		{
			charcon = 0;
		}
