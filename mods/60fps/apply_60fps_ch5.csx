					draw_sprite_ext(spr_dw_tv_starbgtile, animindex * 0.5, xloc + 80, yloc, 1, 1, 0, c_white, 1);
					draw_sprite_ext(spr_dw_tv_starbgtile, animindex * 0.5, xloc - 80, yloc, 1, 1, 0, c_white, 1);
				}
