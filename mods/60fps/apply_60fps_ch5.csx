spawn_aqua_petals = function(arg0, arg1, arg2, arg3 = 1)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fusuma_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = 0.125 * choose(1, 0.5, 0.75);
		image_blend = c_aqua;
		scr_darksize();
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		fusuma = true;
		gravity_direction = 270;
		ys = random_range(0.15, 0.25) * arg3;
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is / global.fps_scale;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

spawn_seth_petals = function(arg0, arg1, arg2, arg3 = 1)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = 0.125 * choose(1, 0.5, 0.75);
		image_blend = c_fuchsia;
		scr_darksize();
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		gravity_direction = 270;
		ys = random_range(0.15, 0.25) * arg3;
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is / global.fps_scale;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

