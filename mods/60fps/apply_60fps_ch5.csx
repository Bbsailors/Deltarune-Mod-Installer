reached_target = function()
{
	if (followtarget == ""__nothing"")
	{
		exit;
	}
	var _FollowObject = -4;
	reachedtarget = false;
	if (state == 1)
	{
		with (obj_plat_movemarker)
		{
			if (extflag == other.followtarget)
			{
				_FollowObject = self;
				break;
			}
		}
	}
	if (_FollowObject == -4)
	{
		return false;
	}
	var _follow_dist = 10;
	reachedtarget = abs(x - _FollowObject.x) < _follow_dist;
	if (reachedtarget && autostop_when_reached)
	{
		followtarget = ""__nothing"";
	}
	return reachedtarget;
};

