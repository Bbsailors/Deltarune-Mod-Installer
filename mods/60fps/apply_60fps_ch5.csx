	if (instance_exists(obj_mainchara_dash))
	{
		dist = point_distance(x + 19.5, y + 5.5, obj_mainchara_dash.x, obj_mainchara_dash.y);
		cut_down();
	}
	if (dist < 480 && touching != 2)
	{
