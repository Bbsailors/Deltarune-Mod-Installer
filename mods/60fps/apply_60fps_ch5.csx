Apply("gml_Object_obj_pink_lipsync_Step_0", @"last_trackpos = trackpos;
var _truetrackpos = audio_sound_get_track_position(global.batmusic[1]);
if (_truetrackpos > 0)
{
	trackpos = _truetrackpos;
	safety_timer = 0;
}
else if (safety_timer < 30)
{
	safety_timer += (1 / global.fps_scale);
}
if (safety_timer >= 30)
{
	trackpos += (delta_time / 1000000);
	if (trackpos >= song_length)
	{
		trackpos -= song_length;
		noteindex = 0;
	}
}
else if (trackpos < last_trackpos && safety_timer == 0)
{
	noteindex = 0;
}
while (noteindex < maxnote && !singing && trackpos > noteend[noteindex])
{
	noteindex++;
}
if (trackpos < ftime[0] || (trackpos > ftime[1] && trackpos < ftime[2]) || trackpos > ftime[3])
{
	lipsync = false;
	singing = true;
}
else if (!lipsync)
{
	lipsync = true;
	singing = false;
}
if (lipsync && noteindex < maxnote)
{
	if (!singing && trackpos >= (notetime[noteindex] + note_buffer) && trackpos < noteend[noteindex])
	{
		singing = true;
		note_buffer = 0;
	}
	else if (singing && trackpos > noteend[noteindex])
	{
		noteindex++;
		singing = false;
		if (noteindex < maxnote && noteend[noteindex - 1] == notetime[noteindex] && noteanim[noteindex] == 0)
		{
			note_buffer = 0.03;
		}
		else
		{
			note_buffer = 0;
		}
	}
}
if (!i_ex(obj_pink_enemy))
{
	if (debug)
	{
		scr_debug_delete_persistent(""pink_lipsync"");
		scr_debug_print(""removing pink lipsync object"");
	}
	instance_destroy();
}
");

