	{
		snd_volume(snd_murmur, 0.5, 30);
	}
	con = 0;
	scr_lerpvar(""cover_alpha"", cover_alpha, 0.5, 30);
}
else if (con == 0 && scr_trigcheck(""nomurmur""))
{
	if (snd_murmur != -4)
	{
		snd_volume(snd_murmur, 0, 30);
	}
	con = 1;
	scr_lerpvar(""cover_alpha"", cover_alpha, 0, 30);
}
if (global.flag[1454] > lastplot)
{
	npc_floradinn.marker.image_xscale *= 1.25;
	npc_floradinn.x -= 30;
	npc_floradinn.talked = false;
	var gm = scr_genmarker(""savepoint"");
	instance_create(gm.x, gm.y, obj_savepoint);
	with (npc_sheary_l)
	{
		talked = false;
	}
	with (npc_sheary_r)
	{
		talked = false;
	}
}
lastplot = global.flag[1454];
");

Apply("gml_Object_obj_dw_fcastle_bounce_1_Step_0", @"if (!init)
{
	init = 1;
	if (global.flag[1454] >= 100)
	{
		with (obj_doorAny)
		{
			if (doorRoom == room_dw_fcastle_left_wing_floweryscene)
			{
				doorRoom = room_dw_fcastle_shinobeetle_encounter;
				doorEntrance = 2;
			}
		}
	}
	if (documents_con >= 4)
	{
		with (obj_plat_conspiracywall)
		{
			instance_destroy();
		}
	}
	var gm = scr_genmarker(""conspiracy"");
	var i = instance_create(gm.x, gm.y, obj_interactable);
	if (!read_documents)
	{
		documents_shine = instance_create(gm.x + 40, gm.y + 30, obj_marker_fancy);
		with (documents_shine)
		{
			image_speed = 0.08 / global.fps_scale;
			sprite_index = spr_shine_white;
			scr_darksize();
			scr_depth();
			depth += 10000;
			
			step_func = function()
			{
				image_alpha = 1 - (array_get(scr_platswap_yscale(), 0) * 2);
			};
		}
	}
	with (i)
	{
		sprite_index = spr_pxwhite;
		image_xscale = gm.image_xscale;
		image_yscale = gm.image_yscale;
		talked = false;
		visible = false;
		
		on_interact = function()
		{
			if (obj_dw_fcastle_bounce_1.concon <= 0)
			{
				global.interact = 1;
				with (obj_marker_fancy)
				{
					if (sprite_index == spr_shine_white)
					{
						instance_destroy();
					}
				}
				if (!obj_dw_fcastle_bounce_1.read_documents)
				{
					with (obj_dw_fcastle_bounce_1)
					{
						concon = 2;
					}
				}
				else
				{
					with (obj_dw_fcastle_bounce_1)
					{
						concon = 1;
					}
					scr_resolve_documents_text_2x();
					d_make();
				}
			}
		};
	}
}
if (global.pause_plat)
{
	exit;
}
if (documents_con == 0)
{
	if (scr_trigcheck_ext(""documents_1"", 912))
	{
		documents_con = 1;
		scr_flag_set_ext(PROGRESS_FLAG, _DOCUMENTS_BIT, 1, 4);
		scr_speaker(""ralsei"");
		msgsetsubloc(0, ""\\E5* So many papers..."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_71_0"");
		d_make_plat(0, 0, undefined, undefined, 1);
	}
}
else if (documents_con == 1)
{
	if (scr_trigcheck_ext(""documents_2"", 912))
	{
		documents_con = 2;
		scr_flag_set_ext(PROGRESS_FLAG, _DOCUMENTS_BIT, 2, 4);
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\ED* Kris^1, I..^1. didn't realize^1, y'know?"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_80_0"");
		d_make_plat(0, 0);
	}
}
else if (documents_con == 2)
{
	if (scr_trigcheck_ext(""documents_3"", 912))
	{
		documents_con = 3;
		scr_flag_set_ext(PROGRESS_FLAG, _DOCUMENTS_BIT, 3, 4);
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\ET* Your family's..^1. got it rough^1, too."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_89_0"");
		d_make_plat(0, 0);
	}
}
else if (documents_con == 3)
{
	if (instance_number(obj_plat_conspiracywall) == 0)
	{
		documents_con = 4;
		scr_flag_set_ext(PROGRESS_FLAG, _DOCUMENTS_BIT, 4, 4);
		scr_flag_set_ext(PROGRESS_FLAG, _FLOWER_BIT, 1);
		scr_speaker(""ralsei"");
		msgsetsubloc(0, ""\\EC* Documents...!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_99_0"");
		d_make_plat(0, 0, undefined, undefined, 1);
	}
}
if (hole_con == 0 && scr_trigcheck_ext(""hole_zone"", 912))
{
	hole_con = 1;
}
else if (hole_con == 1)
{
	hole_timer += (1 / global.fps_scale);
	if (!scr_trigcheck_ext(""hole_zone"", 912))
	{
		if (hole_timer >= 60)
		{
			hole_con = 2;
			scr_flag_set_ext(PROGRESS_FLAG, _HOLE_BIT, 2, 4);
			hole_timer = 0;
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\EK* Kris^1, stop going in the hole."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_114_0"");
			d_make_plat(0, 0, undefined, undefined, 1);
		}
	}
	else
	{
		hole_timer = 0;
		hole_con = 0;
	}
}
else if (hole_con == 2)
{
	hole_timer += (1 / global.fps_scale);
	if (hole_timer >= 250)
	{
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\E8* Actually I miss the hole."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_126_0"");
		scr_flag_set_ext(PROGRESS_FLAG, _HOLE_BIT, 3, 4);
		d_make_plat(0, 0);
		hole_con = 3;
	}
}
else if (hole_con == 3)
{
	if (!d_plat_exists(0))
	{
		if (scr_trigcheck_ext(""hole_zone"", 912))
		{
			hole_con = 4;
			scr_flag_set_ext(PROGRESS_FLAG, _HOLE_BIT, 4, 4);
			hole_timer = 0;
			scr_speaker(""susie"");
			msgsetsubloc(0, ""\\E7* Great."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_138_0"");
			d_make_plat(0, 0);
		}
	}
}
if (ralsei_reminder_con == 0 && !d_plat_exists(0))
{
	if (scr_trigcheck_ext(""ralsei_reminder_zone"", 912))
	{
		ralsei_reminder_timer += (1 / global.fps_scale);
		if (ralsei_reminder_timer >= 150)
		{
			ralsei_reminder_con = 1;
			scr_flag_set_ext(PROGRESS_FLAG, _FLOWER_BIT, 1);
			scr_speaker(""ralsei"");
			msgsetsubloc(0, ""\\EU* Why^1, Kris^1! That flower looks very hittable./%"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_dw_fcastle_bounce_1_slash_Step_0_gml_154_0"");
			d_make_plat(0, 0, [200]);
		}
	}
	else
	{
		ralsei_reminder_timer = 0;
	}
}
if (concon == 1 && !d_ex())
{
	global.interact = 0;
	concon = 4;
}
if (concon == 2)
{
	k_d();
	concon = 3;
	read_documents = true;
	cutscene_master = scr_cutscene_make();
	scr_maincharacters_actors();
	c_pannable(1);
	c_mus2(""volume"", 0, 30);
	var markerL = scr_heromarker(""kr"", ""papersL"");
	var markerM = scr_heromarker(""kr"", ""papersM"");
	var markerR = scr_heromarker(""kr"", ""papersR"");
	var left = 0;
	var mid = 0;
	var right = 0;
	var left_actor = -4;
	var mid_actor = -4;
	var right_actor = -4;
	if (kr_actor.x < ra_actor.x && kr_actor.x < su_actor.x)
	{
		left_actor = kr_actor;
		left = kr;
	}
	else if (kr_actor.x >= ra_actor.x && kr_actor.x >= su_actor.x)
	{
		right_actor = kr_actor;
		right = kr;
	}
	else
	{
		mid_actor = kr_actor;
		mid = kr;
	}
	if (ra_actor.x < su_actor.x)
	{
		if (kr_actor == left_actor)
		{
			mid_actor = ra_actor;
			right_actor = su_actor;
			mid = ra;
			right = su;
		}
		else if (kr_actor == mid_actor)
		{
			left_actor = ra_actor;
			right_actor = su_actor;
			left = ra;
			right = su;
		}
		else
		{
			left_actor = ra_actor;
			mid_actor = su_actor;
			left = ra;
			mid = su;
		}
	}
	else if (kr_actor == left_actor)
	{
		mid_actor = su_actor;
		right_actor = ra_actor;
		mid = su;
		right = ra;
	}
	else if (kr_actor == mid_actor)
	{
		left_actor = su_actor;
		right_actor = ra_actor;
		left = su;
		right = ra;
	}
	else
	{
		left_actor = su_actor;
		mid_actor = ra_actor;
		left = su;
		mid = ra;
	}
	if (left == ra)
	{
		markerL[0] -= 4;
		markerL[1] -= 12;
	}
	if (mid == ra)
	{
		markerM[0] -= 4;
		markerM[1] -= 12;
	}
	if (right == ra)
	{
		markerR[0] -= 4;
		markerR[1] -= 12;
	}
	if (left == su)
	{
		markerL[0] -= 6;
		markerL[1] -= 18;
	}
	if (mid == su)
	{
		markerM[0] -= 6;
		markerM[1] -= 18;
	}
	if (right == su)
	{
		markerR[0] -= 6;
		markerR[1] -= 18;
	}
	c_msgside(""top"");
	var walktime_left = 0;
	if (left_actor.x < markerL[0])
	{
		c_sel(left);
		walktime_left = c_walkto_straight(left_actor, 
		{
			x: markerL[0],
			y: markerL[1]
		}, 4, 1, ""u"");
	}
	else
	{
		c_sel(left);
		walktime_left = scr_calculate_move_distance(left_actor.x, left_actor.y, markerL[0], markerL[1], 4);
		c_walkdirect(markerL[0], markerL[1], walktime_left, ""u"");
	}
	c_sel(mid);
	var walktime_mid = scr_calculate_move_distance(mid_actor.x, mid_actor.y, markerM[0], markerM[1], 4);
	c_walkdirect(markerM[0], markerM[1], walktime_mid, ""u"");
	c_sel(right);
	var walktime_right = scr_calculate_move_distance(right_actor.x, right_actor.y, markerR[0], markerR[1], 4);
	c_walkdirect(markerR[0], markerR[1], walktime_right, ""u"");
	c_wait(max(walktime_left, walktime_mid, walktime_right) + 1);
	c_sel(kr);
	c_facing(""u"");
	c_sel(su);
	c_sprite(spr_susie_kneel_up);
	c_sel(ra);
	c_sprite(spr_ralsei_kneel_up);
	scr_resolve_documents_text();
	c_talk_wait();
	c_panobj(kr_actor, 10);
	c_mus2(""volume"", 1, 30);
	c_wait(10);
	c_sel(kr);
	c_facing(""d"");
	c_pannable(0);
	c_actortokris();
	c_actortocaterpillar();
	c_terminatekillactors();
}
if (concon == 3 && !instance_exists(obj_cutscene_master))
{
	concon = 4;
	scr_delay_var(""concon"", 0, 1);
	global.interact = 0;
}
with (obj_plat_pinatabell)
{
	if (y < 0)
	{
		cull_buffer_bottom = abs(y) + 120;
	}
}
");

Apply("gml_Object_obj_dw_fcastle_bromides_Other_11", @"with (yuka)
{
	timer += (1 / global.fps_scale);
	if (timer >= timetarg)
	{
		timer = 0;
		var range = [4, 30];
		if (marker.sprite_index == spr_dw_fcastle_bromides_yuka_idle)
		{
			range = [90, 180];
		}
		timetarg = random_range(range[0], range[1]);
		if (marker.sprite_index == spr_dw_fcastle_bromides_yuka_idle)
		{
			marker.sprite_index = spr_dw_fcastle_bromides_yuka_draw;
			marker.image_speed = random_range(1/3, 0.2) / global.fps_scale;
		}
		else
		{
			marker.sprite_index = spr_dw_fcastle_bromides_yuka_idle;
			marker.image_speed = 0;
		}
	}
	if (myinteract == 3)
	{
		global.interact = 1;
		scr_speaker(""no_name"");
		msgsetloc(0, ""* (It looks like a Floradinn^1, but the nameplate says \""Yuka\"".)/"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_34_0"");
		msgnextloc(""* (It's drawing a bathtub using its fluffy tail on the canvas...)/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_35_0"");
		if (talked)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* (Wait^1, is that tail real or not?)/%"", ""obj_dw_fcastle_bromides_slash_Other_11_gml_39_0"");
