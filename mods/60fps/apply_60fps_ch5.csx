menu = false;
meny = 0;

menupopup = function(arg0 = 3, arg1 = 100, arg2 = 3)
{
	with (instance_create(0, 0, obj_marker_fancy))
	{
		con = 0;
		timer = 0;
		menuy = 0;
		trig = arg0;
		_cost1 = arg1;
		_cost2 = arg2;
		
		end_step_func = function()
		{
			with (obj_dialoguer)
			{
				other.depth = depth + 10;
			}
			if (con == 0)
			{
				var targetmessagenumber = trig;
				var goahead = false;
				if (instance_exists(obj_choicer_neo))
				{
					goahead = true;
				}
				with (obj_dialoguer)
				{
					if (i_ex(writer))
					{
						with (writer)
						{
							if (msgno >= targetmessagenumber)
							{
								goahead = true;
							}
						}
					}
				}
				if (goahead)
				{
					con = 1;
				}
			}
			if (con == 1)
			{
				if (global.choice != -1 || !d_ex())
				{
					instance_destroy();
				}
			}
		};
		
		draw_func = function()
		{
			var cam = scr_getcam();
			if (con == 1)
			{
				var maxmenu = 30;
				menuy = clamp(menuy + (1 / global.fps_scale), 0, maxmenu);
				var off = lerp_out_cubic(0, 1, menuy / maxmenu);
				var height = 152;
				var _x1 = (cam.x + 400) - 37;
				var _x2 = cam.x + 585;
				var _y1 = round((cam.y + 380) - (height * off));
				if (_cost2 == 0)
				{
					_y1 = round((cam.y + 380 + 32) - (height * off));
				}
				var _y2 = cam.y + 400;
				scr_darkbox(_x1, _y1, _x2, _y2);
				draw_sprite_ext(spr_pxwhite, 0, _x1 + 32, _y1 + 32, (_x2 - _x1 - 64) + 1, (_y2 - _y1 - 64) + 1, 0, c_black, 1);
				var col_p = 1472390;
				var col_p2 = 85848;
				var tx = (_x1 + 16 + 16) - 8;
				var ty = (_y1 + 16 + 8) - 4;
				var _space = 32;
				var memfnt = draw_get_font();
				draw_set_font(fnt_mainbig);
				var strcost1 = ""F$ "" + string(global.flag[1411]);
				draw_text_color(tx + 1, ty + 1, strcost1, col_p, col_p, col_p2, col_p2, 1);
				draw_text_color(tx, ty, strcost1, -1, -1, -1, -1, 1);
				col_p = 3346047;
				col_p2 = 1705791;
				ty += _space;
				if (_cost2 > 0)
				{
					strcost1 = ""P$ "" + string(global.flag[1312]);
					draw_text_color(tx + 1, ty + 1, strcost1, col_p, col_p, col_p2, col_p2, 1);
					draw_text_color(tx, ty, strcost1, -1, -1, -1, -1, 1);
				}
				draw_set_halign(fa_right);
				tx = (_x2 - 32) + 8;
				ty = (_y1 + 16 + 8) - 4;
				_space = 32;
				col_p = 11908344;
				col_p2 = 196793;
				strcost1 = string(-_cost1);
				draw_text_color(tx + 1, ty + 1, strcost1, col_p, col_p, col_p2, col_p2, 1);
				if (_cost2 > 0)
				{
					ty += _space;
					strcost1 = string(-_cost2);
					draw_text_color(tx + 1, ty + 1, strcost1, col_p, col_p, col_p2, col_p2, 1);
				}
				draw_set_halign(fa_left);
				draw_set_font(memfnt);
			}
		};
	}
};

