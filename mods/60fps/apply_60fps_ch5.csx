			explosions_struct.image_yscale = explosions_struct.image_xscale;
			explosions_struct.sprite_index = choose(spr_omegaflowery_explosion_a, spr_omegaflowery_explosion_b, spr_omegaflowery_explosion_c);
			explosions_particle_system.emit(explosions_struct);
			repeat (2)
			{
				explosions_particle_system.x = x + random_range(20, 160);
				explosions_particle_system.y = random_range(60, 360);
				explosions_struct.custom_data = choose(3, 5);
				explosions_struct.image_xscale = lerp(0.25, 1, (explosions_particle_system.x - x) / 160);
				explosions_struct.image_yscale = explosions_struct.image_xscale;
				explosions_struct.sprite_index = choose(spr_omegaflowery_explosion_a, spr_omegaflowery_explosion_b, spr_omegaflowery_explosion_c);
				explosions_particle_system.emit(explosions_struct);
			}
			if ((subcontimer % 4) == 0)
			{
				snd_stop(snd_explosion);
				snd_play(snd_explosion, 0.3, 2);
			}
		}
		if (x < (camerax() - 120))
		{
			if (jarona_repeat < jarona_repeat_target)
			{
				jarona_repeat--;
			}
			sprite_index = spr_omegaflowery_idle;
			x = camerax() + 640 + 120;
			switch_subcon(9);
			hspeed = 0;
			vspeed = 0;
		}
		if (is_final_jarona && place_meeting(x, y, obj_plat_player))
