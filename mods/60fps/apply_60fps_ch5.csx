};

wet_zone = -4;

on_water_sprout = function(arg0 = false)
{
	if (arg0)
	{
		if (sproutsound == undefined)
		{
			sproutsound = snd_loop(snd_board_lift);
		}
		else
		{
			snd_volume(sproutsound, 1, 1);
		}
	}
	if (sproutsound2 == undefined)
	{
		sproutsound2 = snd_loop(snd_rain_short);
	}
	else
	{
		snd_volume(sproutsound2, 1, 1);
	}
	if (!arg0)
	{
		exit;
	}
	if (wet_zone == -4 && instance_exists(sproutmarker))
	{
		wet_zone = instance_create(sproutmarker.x, sproutmarker.y - 26, obj_marker);
		with (wet_zone)
		{
			depth = 900200;
			sprite_index = spr_circle_256_aa;
			image_blend = c_gray;
			image_xscale = 0;
			image_yscale = 0;
		}
	}
	with (wet_zone)
	{
		image_alpha = scr_approach(image_alpha, 0.3, 0.03);
		image_xscale = scr_approach(image_xscale, 0.5, 0.05);
		image_yscale = scr_approach(image_yscale, 0.2, 0.02);
	}
	with (sproutmarker)
	{
		y -= 16;
		if (frac(other.sprouttimer) == 0)
		{
			with (scr_afterimage_monochrome(16777215, true))
			{
				image_alpha = 0.2;
				scr_lerpvar(""image_xscale"", image_xscale, image_xscale + 2.5, 4);
				scr_lerpvar(""image_yscale"", image_yscale, image_yscale + 2.5, 4);
				scr_lerpvar(""y"", y, y + (2.5 * image_yscale), 4);
				depth = other.depth + 1;
			}
		}
		y += 16;
	}
	sprouttimer += (1 / global.fps_scale);
	snd_pitch(sproutsound, (sprouttimer + 10) / 100);
};

