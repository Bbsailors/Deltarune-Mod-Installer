	msgsetloc(0, ""\\E4* ..^1. what are you waiting around for?/"", ""obj_ch5_DW45_slash_Step_0_gml_16_0"");
	msgnextloc(""\\E4* We said goodbye..^1. that means goodbye./%"", ""obj_ch5_DW45_slash_Step_0_gml_17_0"");
	d_make();
}
if (con == 12 && !d_ex() && global.interact == 0)
{
