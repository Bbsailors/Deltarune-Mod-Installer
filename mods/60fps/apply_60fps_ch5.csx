Apply("gml_Object_obj_dw_castle_church_entrance_Step_0", @"with (kk.marker)
{
	dance = function()
	{
		timer = 0;
		con = 1;
		with (scr_marker_fancy(x + 68 + (irandom_range(-6, 6) * 2), y + 10 + (irandom_range(-6, 6) * 2), 3163))
		{
			image_alpha = 3;
			var xpos = right_h() - left_h();
			var ypos = down_h() - up_h();
			hspeed = (random_range(0, 3) * sign(xpos)) / global.fps_scale;
			vspeed = (random_range(-4, -5) + ypos) / global.fps_scale;
			gravity = 0.25 / (global.fps_scale * global.fps_scale);
			
			step_func = function()
			{
				image_alpha *= power(0.8, 1 / global.fps_scale);
				if (image_alpha <= 0.1)
				{
					instance_destroy();
				}
			};
		}
	};
}
with (sweet.marker)
{
	dance = function()
	{
		timer = 0;
		con = 1;
		with (scr_marker_fancy(x + 2 + (irandom_range(-6, 6) * 2), y + 12 + (irandom_range(-6, 6) * 2), 3163))
		{
			image_alpha = 3;
			var xpos = right_h() - left_h();
			var ypos = down_h() - up_h();
			hspeed = (random_range(0, 3) * sign(xpos)) / global.fps_scale;
			vspeed = (random_range(-4, -5) + ypos) / global.fps_scale;
			gravity = 0.25 / (global.fps_scale * global.fps_scale);
			
			step_func = function()
			{
				image_alpha *= power(0.8, 1 / global.fps_scale);
				if (image_alpha <= 0.1)
				{
					instance_destroy();
				}
			};
		}
	};
}
scr_populatechars();
if (!init)
{
	init = 1;
}
event_user(5);
");

Apply("gml_Object_obj_dw_castle_rooms_ralsei_cushion_Step_0", @"if (_hit_cushion)
{
	_timer += (1 / global.fps_scale);
	if (_timer == 1)
	{
		_marker.visible = 1;
		scr_lerp_var_instance(_marker, ""image_yscale"", 0.5, 2, 15, -2, ""out"");
		with (_marker)
		{
			scr_shakeobj_ext(id, 10, 2, 1);
		}
	}
	if (_timer == 20)
	{
		with (_marker)
		{
			visible = 0;
			var defeatanim = instance_create(x, y, obj_defeatanim);
			defeatanim.sprite_index = sprite_index;
			defeatanim.image_xscale = image_xscale;
			defeatanim.image_yscale = image_yscale;
		}
		_hit_cushion = false;
	}
}
if (_heal_cushion)
{
	_timer += (1 / global.fps_scale);
	if (_timer == 1)
	{
		snd_play(snd_power);
		with (_marker)
		{
			image_alpha = 0;
			x = xstart;
			y = ystart;
			visible = true;
			scr_lerpvar(""image_alpha"", 0, 1, 12);
		}
		var healanim = instance_create(_marker.x - 48, _marker.y - 48, obj_healanim);
		healanim.target = _marker.id;
		_heal_cushion = false;
	}
}
");

Apply("gml_Object_obj_dw_castle_rooms_susie_doll_Step_0", @"if (_throw)
{
	_throw_timer += (1 / global.fps_scale);
	if (_throw_timer == 1)
	{
		vspeed = -22 / global.fps_scale;
		hspeed = -4 / global.fps_scale;
		gravity = 1 / (global.fps_scale * global.fps_scale);
		scr_lerpvar(""image_angle"", 0, 1280, 24);
	}
	if (_throw_timer == 25)
	{
		vspeed = 0;
		hspeed = 0;
		gravity = 0;
		_throw = false;
		_thrown = true;
	}
}
if (!_thrown)
{
	exit;
}
x = scr_movetowards(x, x + (40 * _direction), 0.2 / global.fps_scale);
y = scr_movetowards(y, room_height * _direction_y, 0.2 / global.fps_scale);
image_angle += ((1 * _direction) / global.fps_scale);
if (place_meeting(x, y, _bounce_trigger_left))
{
	_direction = 1;
}
else if (place_meeting(x, y, _bounce_trigger_right) || place_meeting(x, y, _bounce_trigger_corner))
{
	_direction = -1;
}
if (place_meeting(x, y, _bounce_trigger_top) || place_meeting(x, y, _bounce_trigger_top_corner))
{
	_direction_y = 1;
}
else if (place_meeting(x, y, _bounce_trigger_bottom))
{
	_direction_y = -1;
}
");

Apply("gml_Object_obj_dw_castle_town_cafe_Draw_0", @"siner += (0.08 / global.fps_scale);
_curtains.palette_index = 0.4 + sin(siner);
_cafe_counter.palette_index = 0.4 + sin(siner);
_icecream.palette_index = 0.4 + sin(siner);
pal_swap_set(bg_castle_town_cafe_palette, 0.4 + sin(siner), false);
draw_sprite(bg_dw_castle_cafe, image_index, x, y);
pal_swap_reset();
");

Apply("gml_Object_obj_dw_church_organ_Step_0", @"var kractor = -4;
with (obj_actor)
{
	if (name == ""kris"")
	{
		kractor = id;
	}
}
if (buffer > -10)
{
	buffer--;
}
if (engaged == true)
{
	if (button2_h() && buffer < 0)
	{
		endtimer += (1 / global.fps_scale);
		if (endtimer >= endtime)
		{
			engaged = false;
			endtimer = 0;
			con = 20;
		}
	}
	else
	{
		endtimer = 0;
	}
	soundtoplay = 0;
	if (left_h() && !down_h() && !right_h() && !up_h())
	{
		soundtoplay = 1;
	}
	if ((left_h() && down_h()) && !up_h() && !right_h())
	{
		soundtoplay = 2;
	}
	if (down_h() && !left_h() && !right_h() && !up_h())
	{
		soundtoplay = 3;
	}
	if ((down_h() && right_h()) && !left_h() && !up_h())
	{
		soundtoplay = 4;
	}
	if (right_h() && !left_h() && !down_h() && !up_h())
	{
		soundtoplay = 5;
	}
	if ((up_h() && right_h()) && !down_h() && !left_h())
	{
		soundtoplay = 7;
	}
	if (up_h() && !left_h() && !down_h() && !right_h())
	{
		soundtoplay = 7;
	}
	if ((up_h() && left_h()) && !down_h() && !right_h())
	{
		soundtoplay = 8;
	}
	makenote = false;
	if (buffer < 0 && con == 0)
	{
		with (obj_mainchara)
		{
			fun = 1;
			sprite_index = spr_kris_piano_loop_1;
			image_index = 3;
		}
		if (button1_p() && !button2_h())
		{
			makenote = true;
			var mysound = 0;
			var myinstrument = mysnd;
			var lowpitch = 0;
			var thispitch = 1;
			var passentry = """";
			switch (soundtoplay)
			{
				case 0:
					if (!button3_h())
					{
						thispitch = 1;
						passentry = ""a"";
					}
					else
					{
						thispitch = 0.5;
						passentry = ""i"";
					}
					break;
				case 5:
					if (!button3_h())
					{
						thispitch = 1.125;
						passentry = ""b"";
					}
					else
					{
						thispitch = 0.5625;
						passentry = ""j"";
					}
					break;
				case 4:
					if (!button3_h())
					{
						thispitch = 1.25;
						passentry = ""c"";
					}
					else
					{
						thispitch = 0.625;
						passentry = ""k"";
					}
					break;
				case 3:
					if (!button3_h())
					{
						thispitch = 4/3;
						passentry = ""d"";
					}
					else
					{
						thispitch = 2/3;
						passentry = ""l"";
					}
					break;
				case 2:
					if (!button3_h())
					{
						thispitch = 1.5;
						passentry = ""e"";
					}
					else
					{
						thispitch = 0.75;
						passentry = ""m"";
					}
					break;
				case 1:
					if (!button3_h())
					{
						thispitch = 1.6666666666666667;
						passentry = ""f"";
					}
					else
					{
						thispitch = 0.8333333333333334;
						passentry = ""n"";
					}
					break;
				case 8:
					if (!button3_h())
					{
						thispitch = 1.875;
						passentry = ""g"";
					}
					else
					{
						thispitch = 0.9375;
						passentry = ""o"";
					}
					break;
				case 7:
					if (!button3_h())
					{
						thispitch = 2;
						passentry = ""h"";
					}
					else
					{
						thispitch = 1;
						passentry = ""a"";
					}
					break;
			}
			if (selectors[trueindex].cut == true)
			{
				snd_stop(selectors[trueindex].snd);
			}
			snd_play(selectors[trueindex].snd, 0.8, thispitch);
			buffer = 0;
			with (obj_dw_castle_church_entrance)
			{
				if (button3_h())
				{
					with (kk)
					{
						marker.dance();
					}
				}
				else
				{
					with (sweet)
					{
						marker.dance();
					}
				}
			}
		}
	}
}
if (!engaged && con == 0)
{
	var trig = false;
	for (var i = 0; i < array_length(myint); i++)
	{
		if (myint[i].myinteract != 0)
		{
			trig = true;
		}
	}
	if (trig == true)
	{
		con = 10;
		global.interact = 1;
	}
}
