draw_surface_ext(surf, x + 1, y, 1, 1, 0, c_gray, 1);
draw_surface_ext(surf, x - 1, y, 1, 1, 0, c_gray, 1);
d3d_set_fog(false, c_white, 0, 1);
draw_surface_ext(surf, x, y, 1, 1, 0, c_black, 1);
gpu_set_alphatestenable(false);
