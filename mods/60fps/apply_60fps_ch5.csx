		else
		{
			scr_damage_all_platmode();
		}
		hurt = arg0 > 0;
		hurt_timer = ceil(arg0);
		hurt_counter++;
		hp -= damage;
		with (heart)
		{
			hurt = true;
			alarm[0] = round((arg0 + 30) * global.fps_scale);
			image_speed = 1 / global.fps_scale;
			global.heartx = x - 6 - camerax();
			global.hearty = y - 6 - cameray();
		}
		attacking = false;
		if (hurt && (abs(arg1) > 0 || abs(arg2) > 0))
		{
			sprite_index = spr_kris_plat_hurt_air;
			if (bullet_knockback && hurt_type == 0)
			{
				jumphovering = false;
			}
			if (hurt_type == 1)
			{
				jumphovering = false;
			}
			if (!jumphovering)
			{
				hspeed = arg1;
				vspeed = arg2;
				if (hspeed < -0.1)
				{
					image_xscale = abs(image_xscale);
				}
				if (hspeed > 0.1)
				{
					image_xscale = -abs(image_xscale);
				}
				if (grounded)
				{
					groundedprev = true;
				}
				grounded = false;
				ground = -4;
			}
		}
	}
	if (fall_in_foreground)
	{
		global.interact = 1;
		scr_lerpvar(""image_xscale"", image_xscale, image_xscale * 1.5, 24);
		scr_lerpvar(""image_yscale"", image_yscale, image_yscale * 1.5, 24);
		with (obj_plat_follower)
		{
			scr_lerpvar(""scale_multiplier"", 1, 1.5, 24);
			scr_lerpvar(""image_yscale"", image_yscale, image_yscale * 1.5, 24);
		}
		with (obj_plat_floor)
		{
			mask_index = spr_plat_blankmask;
		}
		snd_play(snd_fall);
	}
};

