		else
		{
			with (npc_animate_target)
			{
				image_speed = 0;
				image_index = 0;
			}
		}
	}
}
");

Apply("gml_Object_obj_npc_castle_tutorial_zapper_Step_0", @"_timer += (1 / global.fps_scale);
var _gain = 0;
with (obj_mainchara)
{
	_gain = clamp(1 - (distance_to_point(room_width / 2, y) / (room_width / 2)), 0.1, 0.5);
}
if (_timer == 1)
{
	scr_lerp_instance_var(_sprite, ""image_index"", 0, 2, 3);
	scr_lerp_instance_var(_sprite, ""x"", _sprite.xstart, _sprite.xstart - 28, 4, 3, ""in"");
	audio_play_sound(425, 1, 0, _gain);
}
if (_timer == 4)
{
	with (obj_castle_tutorial)
	{
		shake_stand();
	}
	audio_play_sound(312, 1, 0, _gain);
}
if (_timer == 5)
{
	_sprite.image_index = 3;
	scr_lerp_instance_var(_sprite, ""x"", _sprite.xstart - 28, _sprite.xstart, 6, 3, ""out"");
}
if (_timer == 13)
{
	_sprite.image_index = 4;
}
if (_timer == 17)
{
	_sprite.image_index = 0;
}
if (_timer == 25)
{
	_timer = 0;
}
");

