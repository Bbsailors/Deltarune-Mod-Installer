			var _origdist = _dist;
			_dir = scr_wrap(_dir + _rotated_amount, 0, 360);
			_dist = (_dist * (1 + (_dist / (_tunnel_grow_factor / other.tunnel_speed)))) + (_tunnel_grow_addition * other.tunnel_speed);
			var _scaling = max(1, _dist / _origdist);
			speed *= _scaling;
			image_xscale *= _scaling;
			image_yscale *= _scaling;
			image_angle += _rotated_amount;
			x = other.x + lengthdir_x(_dist, _dir);
			y = other.y + lengthdir_y(_dist, _dir);
		}
		with (obj_pinktrail)
