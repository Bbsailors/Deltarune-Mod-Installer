if (foxcon == 0)
{
	if (scr_trigcheck(""stackbreak""))
	{
		var applied_speed = point_distance(0, 0, player_speedx_average, player_speedy_average);
		var applied_direction = point_direction(0, 0, player_speedx_average, player_speedy_average);
		with (obj_dw_garden_shroomstack)
		{
			var stacklength = array_length(stack);
			if (stacklength > 1)
			{
				other.released_foxes = true;
