{
	bgsiner -= 7;
}
bg = 5180;
var yy = cameray();
draw_sprite_tiled_ext(bg, 0, tower_x, yy, 2, 2, colcol, 0.7 * eyebody);
draw_sprite_tiled_ext(bg, 0, tower_x - 240, yy, 2, 2, colcol, 0.3 * eyebody);
var xx = 270;
draw_set_color(c_black);
