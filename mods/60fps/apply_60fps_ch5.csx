		with (obj_marker_doomed)
		{
			image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.3));
		}
	}
	with (pink_spotlight_kris)
	{
		image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.3));
	}
	with (pink_spotlight_susie)
	{
		image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.3));
	}
	with (pink_spotlight_ralsei)
	{
		image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.3));
	}
	with (pink_spotlight_pink)
	{
		image_alpha = lerp(image_alpha, 1, scr_fps_lerp_rate(0.3));
	}
	with (obj_pink_dummy)
	{
		if (vspeed == 0)
		{
			if (type == ""bg"")
			{
				yoffset = lerp(yoffset, 124, scr_fps_lerp_rate(0.1));
			}
			if (type == ""fg"")
			{
				yoffset = lerp(yoffset, -300, scr_fps_lerp_rate(0.1));
			}
		}
	}
	if (introcon == 3 && datecount < 3)
	{
		with (obj_mewers_live)
		{
			y = lerp(y, ystart + other.mewerslive_y_target, scr_fps_lerp_rate(0.1));
		}
	}
}
if (mewerslive_y_con == 1)
{
	mewerslive_y_timer += (1 / global.fps_scale);
	mewerslive_y_target = lerp(400, 120, mewerslive_y_timer / 8);
	if (mewerslive_y_timer == 8)
	{
		mewerslive_y_timer = 0;
		mewerslive_y_con = 0;
	}
}
if (mewerslive_y_con == 2)
{
	mewerslive_y_timer += (1 / global.fps_scale);
	mewerslive_y_target = lerp(460, 120, mewerslive_y_timer / 8);
	if (mewerslive_y_timer == 8)
	{
		mewerslive_y_timer = 0;
		mewerslive_y_con = 0;
	}
}
if (pink_bg_con == 3 || datecount == 3 || _hide)
{
	pink_bg_timer++;
	with (obj_marker_doomed)
	{
		image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.3));
	}
	with (obj_pink_spotlight)
	{
		image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.3));
	}
	with (obj_pink_dummy)
	{
		if (type == ""bg"")
		{
			yoffset = lerp(yoffset, 0, scr_fps_lerp_rate(0.1));
		}
		if (type == ""fg"")
		{
			yoffset = lerp(yoffset, 0, scr_fps_lerp_rate(0.1));
		}
	}
	with (obj_mewers_live)
	{
		y = lerp(y, ystart - 90, scr_fps_lerp_rate(0.1));
	}
}
if (pink_bg_con == 0)
{
	with (obj_marker_doomed)
	{
		image_alpha = lerp(image_alpha, 0, scr_fps_lerp_rate(0.3));
	}
}
dummy_pattern_timer += (1 / global.fps_scale);
if (dummy_pattern_timer >= 120)
{
	dummy_pattern_timer = 0;
	with (obj_pink_dummy)
	{
		wavetimer = 0;
	}
	dummy_pattern = choose(""wave"", ""wave"", ""wave"", ""every other jump"", ""glowstick up and down"");
	if (dummy_pattern == ""glowstick up and down"")
	{
		with (obj_pink_dummy)
		{
			wavetimer = -10;
		}
	}
	if (dummy_pattern == ""wave"")
	{
		with (obj_pink_dummy)
		{
			wavetimer = -10;
		}
	}
	if (dummy_pattern == ""wave"")
	{
		with (obj_pink_dummy)
		{
			wavetimer = wavecon * 4;
		}
	}
	if (dummy_pattern == ""glowstick wave"")
	{
		with (obj_pink_dummy)
		{
			wavetimer = wavecon * 3;
		}
	}
}

