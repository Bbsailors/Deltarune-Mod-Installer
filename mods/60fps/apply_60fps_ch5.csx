var _stk_u = up_h() || (_stk_on && global.stick_ly < 0 && abs(global.stick_ly) >= abs(global.stick_lx));
var _stk_d = down_h() || (_stk_on && global.stick_ly > 0 && abs(global.stick_ly) >= abs(global.stick_lx));
