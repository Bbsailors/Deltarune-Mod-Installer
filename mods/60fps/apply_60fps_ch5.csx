				global.msg[i] = dialoguerStrings[i] + ""%"";
			}
		}
		d_make();
	}
}
if (updatedfriends == 2 && !d_ex())
{
	global.flag[1856] = currentresult_bitflagval;
	updatedfriends = 0;
	global.interact = 0;
}
