			var krpos = scr_heromarker(""kr"", (index == 0) ? ""scissors_left"" : ""scissors_right"");
			var rapos = scr_heromarker(""ra"", (index == 0) ? ""scissors_left"" : ""scissors_right"");
			var supos = scr_heromarker(""su"", (index == 0) ? ""scissors_left"" : ""scissors_right"");
			c_pannable(1);
			c_pan((marker.x - 120) + (240 * index), marker.y, 15);
			c_sel(kr);
			c_walkdirect(krpos[0], krpos[1], 12);
			c_sel(ra);
			c_walkdirect(rapos[0], rapos[1], 12);
			c_sel(su);
			c_walkdirect(supos[0], supos[1], 12);
			c_wait(12);
			var dir = (index == 0) ? ""r"" : ""l"";
			c_sel_facing(kr, dir);
			c_sel_facing(ra, dir);
			c_sel_facing(su, dir);
			c_waitcustom();
			c_panobj(kr_actor, 20);
			c_wait(20);
			c_pannable(0);
			c_sel_facing(kr, ""d"");
			c_actortokris();
			c_actortocaterpillar();
			c_terminatekillactors();
		}
		if (timer == 22)
		{
			snd_play(snd_lawnmower);
			con = 2;
			timer = 0;
			shake = 2;
			scr_depth(self, 100000);
			image_speed = 0.5 / global.fps_scale;
			with (obj_dw_fcastle_foyer)
			{
				initialize_draw_buffers(other.index);
			}
		}
	}
	else if (con == 2)
	{
		var yrange = 1;
		var leafcount = 3;
		if (index == 0)
		{
			hspeed = 6 / global.fps_scale;
			yrange = 4;
			leafcount = 9;
			if (!scr_onscreen(self))
			{
				con = 4;
				timer = 0;
				shake = 0;
				with (obj_dw_fcastle_foyer)
				{
					stop_draw_buffers();
				}
			}
		}
		else
		{
			if (timer == 1)
			{
				with (instance_place(x, y, obj_solidenemy_2))
				{
					other.image_angle = image_angle + 90;
				}
				hspeed = lengthdir_x(10, image_angle) / global.fps_scale;
				vspeed = lengthdir_y(10, image_angle) / global.fps_scale;
			}
			if (timer == 4)
			{
				if (!scr_onscreen(self))
				{
					con = 4;
					shake = 0;
					with (obj_dw_fcastle_foyer)
					{
						stop_draw_buffers();
					}
				}
				timer = 0;
			}
		}
		var ii = floor(image_index + image_speed);
		if ((floor(image_index) % 2) == 1 && (ii % 2) == 0 && scr_trigcheck_ext(""spawn_leaves_"" + string(index), self))
		{
			repeat (leafcount)
			{
				with (instance_create(x + random_range(-20, 20), y + (random_range(-20, 20) * yrange), obj_marker))
				{
					sprite_index = choose(spr_bush_leaf, spr_bush_leaf2, spr_bush_leaf3);
					depth = other.depth - 100;
					image_speed = 0.5 / global.fps_scale;
					hspeed = random_range(-5, 5) / global.fps_scale;
					vspeed = random_range(-5, -2) / global.fps_scale;
					friction = 0.5 / (global.fps_scale * global.fps_scale);
					gravity = 0.5 / (global.fps_scale * global.fps_scale);
					scr_darksize();
					scr_lerpvar(""image_alpha"", 1, 0, 60);
					scr_doom(self, 60);
				}
			}
		}
	}
	else if (con == 4)
	{
		if (timer == 1)
		{
			c_waitcustom_end();
		}
		if (timer == 21)
		{
			if (has_new_flowers())
			{
				with (obj_dw_fcastle_foyer)
				{
					green_come_onscreen();
				}
			}
			global.interact = 0;
			scr_tempsave();
			instance_destroy();
		}
	}
}
else
{
	if (con < 3)
	{
		scr_depth();
	}
	if (con == 1)
	{
		if (timer == 1)
		{
			scr_shakeobj();
			snd_play(snd_noise);
		}
		if (timer == 10)
		{
			scr_lerpvar(""image_angle"", image_angle, 270, 12);
			scr_lerpvar(""y"", y, y + 60, 12);
			with (obj_mainchara)
			{
				cutscene = 1;
			}
			var marker = scr_genmarker(""camregion"");
			scr_pan_lerp(marker.x, marker.y, 30);
		}
		if (timer == 22)
		{
			snd_play(snd_wing);
			con = 2;
			timer = 0;
			image_speed = 0.5 / global.fps_scale;
		}
	}
	if (con == 2)
	{
		if (timer == 1)
		{
			var lay = layer_get_id(""TILES_Leafs"");
			var tilemap = layer_tilemap_get_id(lay);
			if (layer_exists(lay))
			{
				var ti = tilemap_get_at_pixel(tilemap, x, y);
				if (ti != 0)
				{
					tilemap_set_at_pixel(tilemap, 0, x, y);
					spawn_leafs(x, y, 6);
				}
			}
			with (instance_place(x, y, obj_solidenemy_2))
			{
				other.image_angle = image_angle + 90;
				if (image_angle == 361)
				{
					other.con = 3;
					other.timer = 0;
				}
			}
			with (instance_place(x, y, obj_leafpile))
			{
				event_user(11);
			}
			if (con == 2)
			{
				hspeed = lengthdir_x(5, image_angle) / global.fps_scale;
				vspeed = lengthdir_y(5, image_angle) / global.fps_scale;
			}
		}
		if (timer == 8)
		{
			timer = 0;
		}
	}
	if (con == 3)
	{
		if (timer == 1)
		{
			image_index = 0;
			image_speed = 0;
			hspeed = 0;
			vspeed = 0;
			direction = 90;
			scr_shakeobj();
			snd_play(snd_noise);
		}
		if (timer == 21)
		{
			speed = 12 / global.fps_scale;
			direction = 155;
			image_speed = 0.75 / global.fps_scale;
		}
		if (timer > 21 && (timer % 6) == 0)
		{
			direction = (direction == 25) ? 155 : 25;
		}
		image_angle = direction;
		if (timer > 20 && timer < 70 && (timer % 3) == 0)
		{
			spawn_leafs(x, y, 3);
		}
		var me = self;
		with (obj_dw_fcastle_foyer)
		{
			for (var i = 0; i < array_length(flowers); i++)
			{
				if (i_ex(flowers[i]))
				{
					with (flowers[i])
					{
						if (place_meeting(x, y, obj_fcastle_foyer_scissor))
						{
							var col = 65535;
							if (i == 1)
							{
								col = 32768;
							}
							if (i == 2)
							{
								col = 4235519;
							}
							if (i == 3)
							{
								col = 16711680;
							}
							me.spawn_flower_destroy_effect(x, y, col);
							instance_destroy(self);
						}
					}
				}
			}
		}
		if (timer == 70)
		{
			with (obj_dw_fcastle_foyer)
			{
				for (var xx = 0; xx <= vines.sprite_width; xx += 20)
				{
					for (var yy = 0; yy <= vines.sprite_height; yy += 20)
					{
						other.spawn_leafs(vines.x + xx, vines.y + yy, 1);
					}
				}
				if (vines.image_index == 0)
				{
					vines.image_index = 1;
				}
				else
				{
					with (vines)
					{
						instance_destroy();
					}
				}
			}
			snd_play(snd_wing);
		}
		if (timer >= 130)
		{
			con = 4;
			timer = 0;
		}
	}
	if (con == 4)
	{
		if (timer == 1)
		{
			c_waitcustom_end();
		}
		if (timer == 21)
		{
			global.interact = 0;
			with (obj_dw_fcastle_foyer)
			{
				green_come_onscreen();
			}
			scr_tempsave();
			instance_destroy();
		}
	}
}
chain_sway_timer += (1 / global.fps_scale);
var chainspeed = 0.0075;
var chainspeed2 = 0.075;
with (shadowcast)
{
	x = other.x + (sin((other.chain_sway_timer * chainspeed2) + (other.y * chainspeed)) * 2);
	y = other.y + 60;
	depth = 900010;
}
timer += (1 / global.fps_scale);
");

