		rsprite = spr_ralsei_walk_right_unhappy;
		dsprite = spr_ralsei_walk_down_unhappy;
		lsprite = spr_ralsei_walk_left_unhappy;
	}
	var suwait = scr_returnwait_instance(su1, su2, 6);
	var rawait = scr_returnwait_instance(ra1, ra2, 6);
	var krwait = scr_returnwait_instance(kr1, kr2, 6);
	var dawait = max(krwait, suwait, rawait);
	dawait = min(dawait, 30);
	c_sel(ra);
	c_walkto(ra2, dawait, ""u"");
	c_sel(su);
	c_walkto(su2, dawait, ""u"");
	c_sel(kr);
	c_facing(""u"");
	c_pannable(1);
	c_pan_fancy(cam1.x, cam1.y, dawait);
	c_wait(dawait);
	c_customfunc(function()
	{
		with (a_blue)
		{
			scr_lerpvar(""image_alpha"", 0, 1, 15, 1, ""in"");
		}
	});
	c_wait(15);
	c_wait(15);
	c_speaker(""blue"");
	c_msgsetsubloc(0, ""~1* Did you choose wisely?/"", (global.lang == ""ja"") ? ""\\m5\t\t\t"" : ""\\m5\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkshop_slash_Step_0_gml_571_0"");
	c_msgnextsubloc(""~1* It seems that there are~2no more pink shards./"", (global.lang == ""ja"") ? ""\\m5\t\t\t"" : ""\\m5\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkshop_slash_Step_0_gml_572_0"");
	c_msgnextsubloc(""~1* Therefore^1, this is as far~2as we can help you in~2this dream.../"", (global.lang == ""ja"") ? ""\\m5\t\t\t"" : ""\\m5\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkshop_slash_Step_0_gml_573_0"");
	c_msgnextsubloc(""~1* ..^1. unless someone else~2decides to come to your aid./%"", (global.lang == ""ja"") ? ""\\m5\t\t\t"" : ""\\m5\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkshop_slash_Step_0_gml_574_0"");
	c_msgfunc(function()
