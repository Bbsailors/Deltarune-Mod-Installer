Apply("gml_Object_obj_papergrass_Create_0", @"scr_platswap_init(self, true);
if (big_grass)
{
	sprite_index = spr_animated_grass;
	image_speed = 0.25;
}
else
{
	var sprites = [2324, 5260, 1862];
	image_xscale = 2;
	image_yscale = 2;
	if (flagbit >= 0)
	{
		sprite_index = sprites[flagbit % 3];
	}
}
image_index = irandom(image_number);
image_speed = choose(0.15, 0.18, 0.21, 0.24) / global.fps_scale;
hp = 0.5;
y_ow = y;
y_plat = y;
ignore_yorigin = 0;
floortex = instance_place(x, y, obj_plat_floortex);
if (instance_exists(floortex))
{
	y_plat = floortex.y - sprite_height;
}
if (!appear_condition)
{
	instance_destroy();
	exit;
}
if (flag > 0)
{
	var bust = scr_get_bitmask_value(global.flag[flag], flagbit, 1);
	if (bust)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_parallax_background_Draw_76", @"if (!visible)
{
	exit;
}
var _cx = 0;
var _cy = 0;
if (instance_exists(obj_plat_camera))
{
	_cx = obj_plat_camera.x - 320;
	_cy = obj_plat_camera.y - 240;
}
else
{
	_cx = camerax();
	_cy = cameray();
}
_cx += camerax_offset;
_cy += cameray_offset;
var ys = array_get(scr_platswap_yscale(), 0);
var yoff = 0;
var y_orig_offset = 0;
if (instance_exists(obj_parallax_cliffs))
{
	yoff = (ys * -560) + (-235 + obj_parallax_cliffs.horizon_offset_default);
	_cy += ((835 - obj_parallax_cliffs.horizon_offset_default) * ys);
	y_orig_offset = (160 + obj_parallax_cliffs.horizon_offset_platswap) * ys;
}
else if (instance_exists(obj_parallax_pillars))
{
	yoff = (ys * -560) + 0;
	_cy += (600 * ys);
	y_orig_offset = 395 * ys;
}
if (!global.pause_plat)
{
	autoscroll_amt += (autoscroll_speed / global.fps_scale);
}
var _mix = merge_color(c_white, c_black, 1 - image_alpha);
var layer_count = array_length(layers);
_cx = floor(_cx);
for (var i = 0; i < layer_count; i++)
{
	layer_x(layers[i].layerid, ((_cx * layers[i].xpara) + layers[i].xoffset) - (autoscroll_amt * (1 - layers[i].xpara)));
	var mult = 1;
	layer_y(layers[i].layerid, floor(_cy * layers[i].ypara) + layers[i].yorig + (mult * y_orig_offset * (1 - layers[i].ypara)) + layers[i].yoffset + (yoff * mult));
	layer_background_blend(layers[i].bgid, _mix);
}
");

Apply("gml_Object_obj_parallax_castle_top_Draw_76", @"last_camerax = camerax();
layers[1].xoffset -= 3 / global.fps_scale;
layers[2].xoffset -= 4 / global.fps_scale;
if (has_bottom_clouds)
{
	layers[3].xoffset -= 5 / global.fps_scale;
	layers[4].xoffset -= 7 / global.fps_scale;
}
");

Apply("gml_Object_obj_parallax_cliffs_Create_0", @"if (sun_colour > 0)
{
	sun_colour++;
}
if (sun_colour != 0 && use_lut)
{
	if (!layer_exists(""Instances_LUT""))
	{
		layer_create(0, ""Instances_LUT"");
	}
	lutobject = instance_create_layer(0, 0, ""Instances_LUT"", obj_lutshader);
	lutobject.set_lut(3);
}
sunx_init = false;
last_camerax = camerax();
pal_index = 0;
