	draw_set_color(c_black);
	d_rectangle(-10, 180, 999, 482, false);
}
if (chunkfade == 0 && chunkamt > 0)
{
	chunkamt -= (fadespeed / global.fps_scale);
}
if (chunkfade == 1 && chunkamt < 1)
{
	chunkamt += (fadespeed / global.fps_scale);
}
draw_set_color(fadecolor);
alph = 0;
if (chunkamt >= 0.25)
{
	alph = 0.25;
}
if (chunkamt >= 0.5)
{
	alph = 0.5;
}
if (chunkamt >= 0.75)
{
	alph = 0.75;
}
if (chunkamt >= 1)
{
	alph = 1;
}
draw_set_alpha(alph);
d_rectangle(-10, -10, 330, 330, false);
draw_set_alpha(1);
if (ingame == 0)
{
	if (button1_p() && skipped == 0)
	{
		skipped = 1;
		skiptimer = 0;
		f = instance_create(0, 0, obj_fadeout);
		f.fadespeed = 0.08;
		mus_volume(global.currentsong[1], 0, 15);
	}
	if (skipped == 1)
	{
		skiptimer += (1 / global.fps_scale);
	}
	if (skiptimer == 19)
	{
		snd_free(global.currentsong[0]);
		global.flag[6] = 0;
	}
	if (skiptimer == 20)
	{
		room_goto(PLACE_LOGO);
	}
}
");

