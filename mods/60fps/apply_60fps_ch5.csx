show_convo = function(arg0, arg1)
{
	times_talked = arg1;
	switch (arg0)
	{
		case ""dunk_tank"":
			con = 10;
			if (scr_flag_get(1348) > 0)
			{
				con = 20;
			}
			if (scr_sideb_active())
			{
				con = 40;
				if (times_talked > 0)
				{
					con = 45;
				}
			}
			break;
		case ""dunk_tank_banner"":
			con = 25;
			break;
		case ""dunk_tank_banner_w"":
			con = 30;
			if (times_talked > 0)
			{
				con = 35;
			}
			break;
	}
};
");

Apply("gml_Object_obj_town_south_strength_Alarm_0", @"if (!strength_tester_countdown)
{
	exit;
}
if (!noelle_countdown_start)
{
	noelle_countdown_start = true;
	with (noelle_countdown)
	{
		show_speech();
	}
}
snd_play(snd_txtnoe);
countdown_char_count++;
if (countdown_char_count < countdown_char_max)
{
	alarm[0] = round(1 * global.fps_scale);
}
else if (countdown_char_index < (array_length(countdown_chars) - 1))
{
	countdown_char_count = 0;
	countdown_char_index++;
	countdown_char_max = countdown_chars[countdown_char_index];
	alarm[0] = round(45 * global.fps_scale);
	noelle_countdown_start = false;
}
else
{
	strength_tester_countdown_finish = true;
}
");

