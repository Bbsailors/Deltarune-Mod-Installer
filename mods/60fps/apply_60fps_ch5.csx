		{
			var lim = obj_dw_fcastle_orange_gauntlet.fake_floor_y + 20;
			if ((y + vspeed) >= lim)
			{
				vspeed = 0;
				y = lim;
				gravity = 0;
				air_decel = 1;
				if (jumpheight > 0)
				{
					jumpheight = 0;
					hspeed = 0;
					force_animation(1289);
					sprite_image_index = 3;
