Apply("gml_Object_obj_dw_castle_church_climb_Other_12", @"formatnum = function(arg0)
{
	var num = [];
	num[0] = clamp(floor(arg0 / 100), 0, 9);
	if (arg0 > 998)
	{
		num[1] = 9;
	}
	else
	{
		num[1] = floor((arg0 / 10) % 10);
	}
	if (arg0 > 999)
	{
		num[2] = 9;
	}
	else
	{
		num[2] = arg0 % 10;
	}
	return num;
};

confetti = function()
{
	var count = 16;
	for (var i = 0; i < count; i++)
	{
		for (var j = 0; j < 2; j++)
		{
			var wid = 60;
			with (instance_create(((scoreboard.x + 42) - (wid / 2)) + (j * wid), scoreboard.y + 16, obj_marker_fancy))
			{
				depth = other.depth + 1;
				sprite_index = spr_pxwhite;
				direction = ((i * 360) / count) + (i * 4) + random_range(-4, 4);
				hspeed *= random_range(4, 6);
				speed = random_range(4, 5) / global.fps_scale;
				image_blend = make_color_hsv(((i + (j * 4)) / count) * 255, 255, 255);
				image_xscale = choose(4, 4, 6);
				image_yscale = choose(4, 4);
				vspeed -= (random_range(8, 10) / global.fps_scale);
				gravity = 1 / (global.fps_scale * global.fps_scale);
				friction = random_range(0.01, 0.02) / (global.fps_scale * global.fps_scale);
				daddy = other.id;
				timer = 0;
				lifetime = 40;
				
				step_func = function()
				{
					if (y < (daddy.scoreboard.y - 2))
					{
						depth = daddy.depth - 1;
					}
					image_angle += ((12 * sign(hspeed)) / global.fps_scale);
					timer += (1 / global.fps_scale);
					image_alpha = lerp(2, 0, timer / lifetime);
					if (timer > lifetime)
					{
						instance_destroy();
					}
				};
				
				draw_func = function()
				{
					draw_sprite_ext(sprite_index, image_index, (round(x / 2) * 2) + 2, (round(y / 2) * 2) + 2, image_xscale, image_yscale, image_angle, merge_color(image_blend, c_black, 0.75), image_alpha * 0.2);
					draw_sprite_ext(sprite_index, image_index, round(x / 2) * 2, round(y / 2) * 2, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
				};
			}
		}
	}
};

if (effectinit == 0)
