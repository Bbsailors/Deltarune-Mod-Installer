Apply("gml_Object_obj_towery_flowery_Step_0", @"if (!instance_exists(obj_climb_kris))
{
	exit;
}
timer += (1 / global.fps_scale);
if (con == 0)
{
	if (obj_climb_kris.y < y)
	{
		if (extflag == ""final"")
		{
			con = 4;
			timer = 0;
			x = camerax() + 320;
			y = cameray() + 490;
