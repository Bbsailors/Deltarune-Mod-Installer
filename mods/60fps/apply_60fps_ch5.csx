				{
					catmarker[i].image_index += 0.125 / global.fps_scale;
					if (i == 5)
					{
						catmarker[i].image_index += 0.125 / global.fps_scale;
					}
					buff[i] = 6;
				}
				else
				{
					buff[i] -= 1 / global.fps_scale;
					if (buff[i] <= 0)
					{
						catmarker[i].image_index = 0;
					}
