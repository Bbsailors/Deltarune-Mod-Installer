			}
		}
		with (instance_create_depth(x, y, depth - 1, obj_plat_vfx))
		{
			sprite_index = spr_hit_vfx;
			image_speed = 1;
		}
		with (instance_create_depth(x, y, depth - 1, obj_plat_vfx))
		{
			sprite_index = spr_smokepuff;
			image_speed = 2;
		}
		if (remaining_combo > 0)
		{
			remaining_combo--;
			flash_hurt();
			snd_play(snd_metalhit, 1, 2 - (remaining_combo / remaining_combo_max));
			if (remaining_combo == 0)
			{
				bounce_impact(175, true);
				with (obj_plat_enm_orange_miniboss)
				{
					if (id != other.id && remaining_combo > 0)
					{
						scr_script_delayed(bounce_impact, 16, 85);
					}
				}
				scr_plat_cool_zoom();
			}
		}
		hp = max(hp, 5);
		if (hp <= 0)
		{
			instance_destroy();
			exit;
		}
	}
}
if (hit > 0)
{
