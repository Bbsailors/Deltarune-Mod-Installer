Apply("gml_Object_obj_pinkzap_Step_0", @"event_inherited();
speed = max(0.1, abs(pattern_speed));
life_time += (1 / global.fps_scale);
wave_dir += ((sign(pattern_speed) * 48) / global.fps_scale);
if (wave_dir >= 360)
{
	wave_dir -= 360;
}
if (wave_dir < 0)
{
	wave_dir += 360;
}
if (life_time < 30)
{
	if (image_alpha < 1)
	{
		image_alpha = clamp(image_alpha + (0.2 / global.fps_scale), 0, 1);
	}
}
if (image_alpha > 1)
{
	image_alpha = max(image_alpha - 0.3, 1);
}
else if (life_time >= 99999)
{
	image_alpha = min(image_alpha, 1);
	image_alpha -= 0.075;
	if (image_alpha <= 0.001)
	{
		instance_destroy();
	}
}
");

