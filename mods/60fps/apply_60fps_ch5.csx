	c_speaker(""flowery"");
	c_msgsetloc(0, ""\\E2\\VT* Ha Ha^1! Yeah^1, Man^1! That's classic Gorey for ya!/"", ""obj_ch5_DWCL00_slash_Step_0_gml_284_0"");
	c_msgnextloc(""\\E3\\VK* But^1, if I can leaf my opinion.../%"", ""obj_ch5_DWCL00_slash_Step_0_gml_287_0"");
