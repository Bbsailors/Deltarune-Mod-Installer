		if (point_distance(sux, suy, susie.x, susie.y) > (1 / global.fps_scale))
		{
			susie.image_index += 0.125 / global.fps_scale;
		}
		if (point_distance(rax, ray, ralsei.x, ralsei.y) > (1 / global.fps_scale))
		{
			ralsei.image_index += 0.125 / global.fps_scale;
		}
		if (point_distance(krx, kry, kris.x, kris.y) > (2 / global.fps_scale))
