Apply("gml_Object_obj_spellphase_Step_0", @"if (global.encounterno == 92)
{
	funny = 1;
}
if (active == 1)
{
	spelltimer += (1 / global.fps_scale);
	if (spelltimer >= global.spelldelay && i_ex(spellwriter) == false)
	{
		if (char >= 3 || spelltotal == 1)
		{
			scr_attackphase();
			with (spellwriter)
			{
				instance_destroy();
			}
			instance_destroy();
		}
		else if (scr_monsterpop() > 0)
		{
			if (gotitem[char] == 1)
			{
				re_castyet = 1;
				with (global.charinstance[char])
				{
					state = 4;
				}
				with (spellwriter)
				{
					instance_destroy();
				}
				scr_spelltext(global.charspecial[char], char);
				spellwriter = scr_battletext_default();
			}
			if (gotspell[char] == 1)
			{
				re_castyet = 1;
				with (global.charinstance[char])
				{
					state = 2;
				}
				with (spellwriter)
				{
					instance_destroy();
				}
				scr_spelltext(global.charspecial[char], char);
				spellwriter = scr_battletext_default();
			}
			global.spelldelay = 90;
			if (re_castyet == 0)
			{
				global.spelldelay = 1;
			}
			char += 1;
			repeat (2)
			{
				if (char < 3)
				{
					if (using[char] == 0)
					{
						char += 1;
					}
				}
			}
			spelltimer = 0;
			re_castyet = 0;
		}
		else
		{
			scr_attackphase();
			with (spellwriter)
			{
				instance_destroy();
			}
			instance_destroy();
		}
	}
}
");

