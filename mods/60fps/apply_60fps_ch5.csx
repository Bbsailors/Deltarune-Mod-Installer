setparty(1, 1);
con = 0;
timer = 0;
init = 0;
siner = 0;
endcustom = false;
dojumping = false;
landed = false;
endjumping = false;
knives = [];
seth = scr_marker_fromasset(findsprite(spr_seth_walk_down, ""CUTSCENE1_ASSETS""), 0, 1);
aqua = scr_marker_fromasset(findsprite(spr_aqua_walk_left, ""CUTSCENE1_ASSETS""), 0, 1);
aqua.autodepth = 0;
fl_left = -4;
fl_right = -4;
bush1 = scr_marker_fromasset(findsprite(spr_dw_aquaplant_25, undefined, #FFE5E5), 96669);
bush2 = scr_marker_fromasset(findsprite(spr_dw_aquaplant_25, undefined, #FFFF7A), 96669);
depth = 96660;
bush1.image_blend = c_white;
bush2.image_blend = c_white;
if (global.plot < 290)
{
	global.plot = 290;
}
if (global.plot == 291 || global.tempflag[51] == 1)
{
	con = 3;
	aqua.sprite_index = spr_aqua_walk_up;
	var targ = findspriteinfo(spr_aqua_walk_down, ""CUTSCENE2_ASSETS_2"", #47E6FF);
	setxy(targ.x, targ.y, aqua);
	safe_delete(seth);
	if (global.entrance == 0 && global.tempflag[51] == 1)
	{
		with (scr_marker_fancy(0, 0, 6500))
		{
			timer = 0;
			scr_size(room_width, room_height);
			depth = 0;
			
			step_func = function()
			{
				timer += (1 / global.fps_scale);
				var endtime = 8;
				image_alpha = lerp(1.2, 0, timer / endtime);
				if (timer == endtime)
				{
					instance_destroy();
				}
			};
		}
		global.facing = 2;
		targ = findspriteinfo(spr_debug_krmarker, ""DEBUG_ASSETS"", #FF0087);
		with (obj_mainchara)
		{
			setxy(targ.x, targ.y);
			scr_depth();
		}
		with (obj_caterpillarchara)
		{
			if (name == ""susie"")
			{
				setxy(targ.x - 6, targ.y + 32);
			}
			if (name == ""ralsei"")
			{
				setxy(targ.x - 2, targ.y + 84);
			}
			scr_caterpillar_interpolate();
			scr_caterpillar_facing(2);
			scr_depth();
		}
	}
}
if (global.plot >= 292)
{
	global.tempflag[51] = 0;
	con = -1;
	safe_delete(aqua);
	safe_delete(seth);
}
scr_musicer(""piano_ambience.ogg"", 1);
bushCon = 0;
bushLeft = scr_makenpc_fromasset(findsprite(spr_pxwhite, ""NPCs"", #FF6565));
bushLeft.marker.visible = false;
bushtalk = 0;
bushRight = scr_makenpc_fromasset(findsprite(spr_pxwhite, ""NPCs"", #E9FF47));
bushRight.marker.visible = false;
var _bushes = findsprite_all(5977, ""ASSETS_DAPLANTZ"");
bushMarkers = [];
var dadep = layer_get_depth(""ASSETS_BIG_PLANTS"");
for (var i = 0; i < array_length(_bushes); i++)
{
	array_push(bushMarkers, scr_marker_fromasset(_bushes[i], dadep + 1));
	if (bushMarkers[i].x < 300)
	{
		bushLeft.mybush = bushMarkers[i];
	}
	else
	{
		bushRight.mybush = bushMarkers[i];
	}
}
");

Apply("gml_Object_obj_dw_garden_aqua_Step_0", @"function makeknives()
{
	for (var i = 0; i < array_length(knives); i++)
	{
		instance_destroy(knives[i]);
	}
	knives = [];
	var target = findspriteinfo(spr_aqua_walk_down, ""CUTSCENE2_ASSETS_2"", #47E6FF);
	target.x += sprite_get_width(target.sprite_index);
	var count = 7;
	snd_free_all();
	snd_play(snd_swing, 0.7, 0.7);
	snd_play(snd_swing, 0.6, 1.8);
	for (var i = 0; i < count; i++)
	{
		var angle = ((i + 1) * (180 / count)) - 10;
		var dist = 60;
		var xloc = target.x + lengthdir_x(dist * 2, angle);
		var yloc = target.y + lengthdir_y(dist * 3, angle);
		var endxloc = target.x + lengthdir_x(dist + 30, angle);
		var endyloc = target.y + lengthdir_y(dist + 12, angle);
		knives[i] = scr_marker_ext(xloc, yloc, spr_attack_knifefan, 1, 1);
		with (knives[i])
		{
			image_alpha = 0;
			image_angle = point_direction(xloc, yloc, camerax() + 320, cameray() + 480) + 180;
			scr_lerpvar(""x"", x, endxloc, 8, -1, ""out"");
			scr_lerpvar(""y"", y, endyloc, 8, 2, ""out"");
			scr_lerpvar(""image_alpha"", 0, 1, 4);
			show_debug_message_concat(4 + (i * 2));
		}
		with (aqua)
		{
			sprite_index = spr_aqua_laugh;
			image_index = 0;
			image_speed = 0.16666666666666666 / global.fps_scale;
		}
	}
}

function floradinambush()
{
	fl_left = scr_marker_fromasset(findsprite(spr_enemy_floradin, ""CUTSCENE2_ASSETS_2"", #AAAAAA), undefined, 1);
	fl_right = scr_marker_fromasset(findsprite(spr_enemy_floradin, ""CUTSCENE2_ASSETS_2"", #BBBBBB), undefined, 1);
	fl_left.image_blend = c_white;
	fl_left.image_speed = 0;
	fl_right.image_blend = c_white;
	fl_right.image_speed = 0;
	with (fl_left)
	{
		show_debug_message_concat(""fl_left depth="", depth);
		var target = findspriteinfo(spr_enemy_floradin, ""CUTSCENE2_ASSETS_3"", #EAAAAA);
		gravity = 1.8 / (global.fps_scale * global.fps_scale);
		vspeed = -16 / global.fps_scale;
		var falltime = scr_returnwait_gravity(id, y, y, gravity, vspeed) / global.fps_scale;
		show_debug_message_concat(falltime);
		scr_delay_var(""gravity"", 0, falltime);
		scr_delay_var(""vspeed"", 0, falltime);
		scr_lerpvar(""x"", x, target.x, falltime - 1);
		scr_limitval_upper(id, ""y"", y, falltime + 2);
		scr_script_delayed(scr_flip, falltime, ""h"");
	}
	with (fl_right)
	{
		var target = findspriteinfo(spr_enemy_floradin, ""CUTSCENE2_ASSETS_3"", #EDDDDD);
		gravity = 1.8 / (global.fps_scale * global.fps_scale);
		vspeed = -16 / global.fps_scale;
		var falltime = scr_returnwait_gravity(id, y, y, gravity, vspeed) / global.fps_scale;
		scr_delay_var(""gravity"", 0, falltime);
		scr_delay_var(""vspeed"", 0, falltime);
		scr_lerpvar(""x"", x, target.x, falltime - 1);
		scr_limitval_upper(id, ""y"", y, falltime + 2);
		scr_script_delayed(scr_flip, falltime, ""h"");
		depth = other.ra_actor.depth + 10;
	}
}

function aquajumptoplace(arg0, arg1 = 0, arg2 = 8, arg3 = 1, arg4 = -12)
{
	with (aqua)
	{
		sprite_index = spr_aqua_spin;
		image_index = arg1;
		image_speed = 0;
		gravity = arg3 / (global.fps_scale * global.fps_scale);
		vspeed = arg4 / global.fps_scale;
		var jumptime = scr_returnwait_gravity(id, y, arg0.y, gravity, vspeed) / global.fps_scale;
		scr_delay_var(""gravity"", 0, jumptime - 1);
		scr_delay_var(""vspeed"", 0, jumptime - 1);
		scr_lerpvar(""x"", x, arg0.x, jumptime - 1);
		scr_lerpvar(""image_index"", arg1, arg2, jumptime);
		scr_delay_var(""x"", arg0.x, jumptime);
		scr_delay_var(""y"", arg0.y, jumptime);
		snd_play(snd_petal_recover, 0.7, 1);
		snd_play(snd_petal_recover, 0.7, 1.2);
		snd_play_delay(snd_wing, jumptime, 0.7, 1.4);
		with (obj_dw_garden_aqua)
		{
			if (!dojumping)
			{
				scr_delay_var(""endcustom"", 1, jumptime + 1);
			}
			scr_delay_var(""landed"", 1, jumptime + 1);
		}
	}
}

if (dojumping)
{
