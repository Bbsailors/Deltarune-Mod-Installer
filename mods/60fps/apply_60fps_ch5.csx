	with (gra)
	{
		x = round(x / 2) * 2;
		y = round(y / 2) * 2;
	}
	array_push(grassets, gra);
}

killgrass = function()
{
	for (var i = 0; i < array_length(grassets); i++)
	{
		with (grassets[i])
		{
			if (place_meeting(x, y, obj_solidblocksized))
			{
				instance_destroy();
			}
		}
	}
};

hideFlPodiums = function(arg0 = false)
{
	if (!arg0)
	{
		killgrass();
	}
	for (var i = 0; i < 6; i++)
	{
		with (flower[i])
		{
			marker.x = room_width * 4;
			if (arg0)
			{
				with (floorspotlight)
				{
					scr_doom(id, 120);
				}
			}
			with (podium)
			{
				myinteract = -99;
				if (arg0)
				{
					with (marker)
					{
						scr_afterimage();
					}
				}
				x = room_width * 4;
				other.trig.x = x;
			}
		}
	}
};

