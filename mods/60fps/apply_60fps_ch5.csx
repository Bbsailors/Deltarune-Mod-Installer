	c_msgnextloc(""\\EB* .../"", ""obj_dw_garden_finalplatforming_slash_Step_0_gml_484_0"");
	c_facenext(""ralsei"", ""D"");
	c_msgnextloc(""\\ED* OK^1, fine./%"", ""obj_dw_garden_finalplatforming_slash_Step_0_gml_486_0"");
	c_talk_wait();
	c_customfunc(function()
	{
		with (obj_climb_kris)
		{
			forceclimb = 2;
		}
	}, []);
	c_wait(120);
	c_customfunc(function()
	{
		with (obj_climb_kris)
		{
			instance_destroy();
		}
		with (obj_climb_susie)
		{
			instance_destroy();
		}
		with (obj_mainchara)
		{
			cutscene = false;
			freeze = false;
		}
	}, []);
	var krmarker = scr_heromarker(""kr"", ""climbcut"");
	var ramarker = scr_heromarker(""ra"", ""climbcut"");
	var sumarker = scr_heromarker(""su"", ""climbcut"");
	c_sel(kr);
	c_setxy(krmarker[0], krmarker[1]);
	c_facing(""u"");
	c_sel(ra);
	c_setxy(ramarker[0], ramarker[1]);
	c_facing(""u"");
	c_sel(su);
	c_setxy(sumarker[0], sumarker[1]);
	c_facing(""u"");
	c_pannable(1);
	c_panobj(kr_actor, 60);
	c_wait(60);
	c_mus(""piano_ambience.ogg"");
	c_speaker(""ralsei"");
	c_msgsetloc(0, ""\\E4* There must be some way we can get up there.../"", ""obj_dw_garden_finalplatforming_slash_Step_0_gml_524_0"");
	c_facenext(""susie"", ""0"");
	c_msgnextloc(""\\E0* Guess we should take a look./%"", ""obj_dw_garden_finalplatforming_slash_Step_0_gml_526_0"");
	c_talk();
	c_wait_talk();
	c_sel(kr);
	c_facing(""d"");
