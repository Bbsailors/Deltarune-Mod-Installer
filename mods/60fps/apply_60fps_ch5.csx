is_new_mode = true;
left_bush_state = 0;
right_bush_state = 0;
leftsolid = -4;
centersolid = -4;
rightsolid = -4;
legsolid = -4;

initialize_draw_buffers = function(arg0)
{
	if (surface_exists(draw_surface_0))
	{
		surface_free(draw_surface_0);
	}
	if (surface_exists(draw_surface_1))
	{
		surface_free(draw_surface_1);
	}
	if (surface_exists(draw_surface_mask))
	{
		surface_free(draw_surface_mask);
	}
	do_surface_draw = true;
	draw_surface_mask = surface_create(280, 150);
	if (arg0 == 0)
	{
		left_bush_new_state = 1;
	}
	if (arg0 == 1)
	{
		right_bush_new_state = 1;
	}
};

stop_draw_buffers = function()
{
	do_surface_draw = false;
	left_bush_state = left_bush_new_state;
	right_bush_state = right_bush_new_state;
	if (left_bush_state == 1 && right_bush_state == 0)
	{
		left_bush.image_index = 1;
		center_bush.image_index = 2;
	}
	if (left_bush_state == 0 && right_bush_state == 1)
	{
		right_bush.image_index = 1;
		center_bush.image_index = 1;
	}
	if (left_bush_state == 1 && right_bush_state == 1)
	{
		left_bush.image_index = 1;
		right_bush.image_index = 1;
		center_bush.image_alpha = 0;
	}
	left_bush.visible = !do_surface_draw;
	center_bush.visible = !do_surface_draw;
	right_bush.visible = !do_surface_draw;
	c_bush_hands.image_index = center_bush.image_index;
	c_bush_hands.image_alpha = center_bush.image_alpha;
	c_bush_hands.visible = center_bush.visible;
	c_bush_legs_l.visible = center_bush.visible;
	c_bush_legs_l.image_alpha = center_bush.image_alpha;
	c_bush_legs_r.visible = center_bush.visible;
	c_bush_legs_r.image_alpha = center_bush.image_alpha;
	bigbush_left.visible = left_bush_state == 1;
	bigbush_right.visible = right_bush_state == 1;
	bigbush_left.image_alpha = left_bush_state == 1;
	bigbush_right.image_alpha = right_bush_state == 1;
	if (left_bush_state == 1)
	{
		with (leftsolid)
		{
			instance_destroy();
		}
	}
	if (right_bush_state == 1)
	{
		with (rightsolid)
		{
			instance_destroy();
		}
	}
	if (left_bush_state == 1 && right_bush_state == 1)
	{
		with (centersolid)
		{
			instance_destroy();
		}
	}
};

