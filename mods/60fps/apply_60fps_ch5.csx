make_struct_bg = function(arg0, arg1, arg2, arg3, arg4, arg5)
{
	var d = 0;
	if (arg4 != infinity)
	{
		d = arg4 / global.parallax_focal_length;
		d = d + 1;
		d = 1 / (d * d);
	}
	arg1 = (arg1 * ((480 - (sprite_get_height(arg0) * 2)) + (d * arg3 * (room_height - 40)))) + (arg5 * (d * arg3));
	var _lay = 
	{
		bgid: arg0,
		xpara: 1 - d,
		ypara: 1 - (d * arg3),
		swidth: sprite_get_width(arg0) * 2,
		x: 0,
		y: 0,
		xoffset: 0,
		yoffset: arg2,
		yorig: arg1
	};
	array_push(struct_bgs, _lay);
};

var _focal = -26;
struct_layer_count = 0;
var y_scaler = (1680 / room_height) * 0.5;
depth = 16036000;
make_struct_bg(5548, 0, 157 + extra_y_offset, y_scaler, infinity, shift);
