	c_walkdirect(obj_krmarker.x - 60, obj_krmarker.y - 14, 30);
	c_wait(30);
	c_sprite(spr_susie_walk_right_dw_unhappy);
	c_wait(15);
	c_customfunc(function()
	{
		ralseinpcmarker = scr_dark_marker(ra_actor.x, ra_actor.y, ra_actor.sprite_index);
		ralseinpcmarker.image_index = ra_actor.image_index;
		scr_depth(ralseinpcmarker);
	});
	c_sel(kr);
	c_facing(""d"");
	c_pannable(0);
	c_actortokris();
	c_actortocaterpillar();
	c_terminatekillactors();
	show_debug_message_concat(""cutscene script complete"");
	scr_getchar(""su"");
	scr_makecaterpillar(su_actor.x, su_actor.y, 2, 0);
	with (obj_caterpillarchara)
	{
		visible = 0;
	}
}
if (con == 3 && !i_ex(obj_cutscene_master))
{
	show_debug_message_concat(""cutscene ended"");
	global.interact = 0;
	global.facing = 0;
	if (plot_check_on)
	{
		global.plot = plot_post;
	}
	con = 999;
	with (obj_caterpillarchara)
	{
		scr_caterpillar_interpolate();
	}
	scr_depth(marker_flowery, 35);
	npc_flower = instance_create(marker_flowery.x + 6, marker_flowery.bbox_bottom - 40, obj_custom_interactable_solid);
	npc_flower.image_yscale = 40;
	npc_flower.image_xscale = 40;
	
	flower_trigger = function()
	{
		myinteract = 3;
		global.interact = 1;
		global.typer = 6;
		global.fc = 0;
		global.msc = 0;
		scr_speaker(""none"");
		msgsetloc(0, ""* (A flower^1, torn in half.)/%"", ""obj_dw_flowery_tree_slash_Step_0_gml_385_0"");
		mydialoguer = instance_create(0, 0, obj_dialoguer);
	};
	
	npc_flower.trigger_event = method(npc_flower.id, flower_trigger);
	npc_ralsei = instance_create(ralseinpcmarker.x, ralseinpcmarker.bbox_bottom - 40, obj_custom_interactable_solid);
	npc_ralsei.image_yscale = 40;
	npc_ralsei.image_xscale = 40;
	npc_ralsei.talks = 0;
	
	ralsei_trigger = function()
	{
		myinteract = 3;
		global.interact = 1;
		if (scr_flag_get(1445) == 0)
		{
			scr_flag_set(1445, 1);
			scr_speaker(""ralsei"");
			msgsetloc(0, ""\\E8* ..^1. he just had to go and be dramatic^1, didn't he./"", ""obj_dw_flowery_tree_slash_Step_0_gml_408_0"");
			msgnextloc(""\\Ea* Idiot.../%"", ""obj_dw_flowery_tree_slash_Step_0_gml_409_0"");
		}
		else
		{
			scr_speaker(""ralsei"");
			msgsetloc(0, ""\\Ea* Kris..^1. please go seal the Fountain./%"", ""obj_dw_flowery_tree_slash_Step_0_gml_414_0"");
		}
		mydialoguer = instance_create(0, 0, obj_dialoguer);
	};
	
	npc_ralsei.trigger_event = method(npc_ralsei.id, ralsei_trigger);
}
");

