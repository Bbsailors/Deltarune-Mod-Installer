Apply("gml_Object_obj_plat_enm_smallglove_Create_0", @"var _c = 0;
if (variable_instance_exists(id, ""con""))
{
	_c = con;
}
event_inherited();
con = _c;
timer = 0;
hit = 0;
hp = 1;
remy = 0;
bounces = 0;
siner = 0;
sinetimer = 0;
generated = false;
spawn_direction = 0;
extrasturdy = false;
init = 0;
can_break_fusuma = true;
stun_duration = round(180 * global.fps_scale);

on_stun_recover = function()
{
};

speedmultiplier = 1;
freq_mult = 1;
flip = 1;
stored_speed = 0;
glove_combo = 0;
fusuma_bounce = false;
xscale_mod = 1;
yscale_mod = 1;
queue_sound = false;
h_knockback = (image_xscale * -8) / global.fps_scale;
v_knockback = -6 / global.fps_scale;
damage = 1;
kb_strength = 12;
spawn_effect = false;
knockback_on_death = false;
deathmarker_lifetime = 1;
breaks_on_wall_contact = false;
this_frame_overlap = false;
hit_angle = 0;
image_xscale = 1;
image_yscale = 1;
image_speed = 0;
home = -4;
x_home = x;
y_home = y;
movestate = 0;
movetimer = 0;
hit_timer = 0;
standby = false;

sublast = function()
{
	scr_plat_susie_attack_fast(self);
};

su_act.effect = sublast;
su_act.blocked = true;
performs_culling_checks = true;
cull_buffer = 20;
petal_color = 4235519;

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	if (standby)
	{
		exit;
	}
	if (parallax_depth > 0)
	{
		exit;
	}
	if (movepattern == 5 && !(!standby && (sinetimer % 360) >= 90 && (sinetimer % 360) <= 270))
	{
		exit;
	}
	cancel_stun();
	sprite_index = spr_forange_glove;
	image_xscale = abs(image_xscale);
	image_index = 0;
	if (spawn_direction != 0)
	{
		spawn_direction = 0;
		damage = 1;
	}
	if ((con < 2 || timer > 6) && con >= 0 && damage != 0)
	{
		with (arg0)
		{
			if (!hit_check(other.id))
			{
				exit;
			}
		}
		hit = 1;
		with (arg0)
		{
			do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
		}
		if (con == 1)
		{
			superstrong = true;
			scr_plat_hitstop_global(6);
		}
		else
		{
			scr_plat_hitstop_global(2);
		}
		timer = 0;
		if (instance_exists(obj_plat_player))
		{
			hit_angle = point_direction(obj_plat_player.x, obj_plat_player.y, x, y);
		}
		if (con == 2)
		{
			timer = 2;
			direction = hit_angle;
		}
		else
		{
			hspeed = 0;
			vspeed = 0;
		}
		var hit_strong = false;
		if (con == 1)
		{
			hit_strong = true;
			flash_hurt(16711935);
		}
		else
		{
			flash_hurt(16777215);
		}
		con = 2;
