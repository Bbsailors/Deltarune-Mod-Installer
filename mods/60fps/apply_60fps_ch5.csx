Apply("gml_GlobalScript_scr_rhythmgame_init", @"function scr_rhythmgame_init(arg0, arg1, arg2 = false)
{
	instrument = arg0;
	note_color[0] = #01EA9E;
	note_color[1] = #17EEFF;
	note_color[2] = c_orange;
	if (instrument == 0)
	{
		scr_rhythmgame_notechart_lead(arg1);
		if (!arg2)
		{
			exit;
		}
		performer = instance_create(280, 316, obj_rhythmgame_performer);
		performer.sprite_index = spr_kris_rock_2;
		performer.image_speed = 0.5 / global.fps_scale;
		performer.name = ""kris"";
		performer.loop = false;
	}
	else if (instrument == 1)
