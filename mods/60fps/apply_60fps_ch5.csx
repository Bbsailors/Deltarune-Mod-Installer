		{
			msgsetloc(0, ""* Truancy.&* Failure./%"", ""obj_sheary_enemy_slash_Step_0_gml_220_0"");
		}
		else if (mercy < 40)
		{
			msgsetloc(0, ""* Arts and crafts failure!/%"", ""obj_sheary_enemy_slash_Step_0_gml_221_0"");
