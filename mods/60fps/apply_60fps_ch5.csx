Apply("gml_Object_obj_sheary_smashcut_attack_Step_0", @"timer += (1 / global.fps_scale);
timer2 += (1 / global.fps_scale);
if (timer == ((24 + ((10 - difficulty) * type)) - (difficulty * 2)) && type != 2)
{
	timer = 0;
	var angle = choose(90, 90, 90, 70, 110);
	var xxx = random(72) - 37;
	for (var xx = -90; xx <= 90; xx += 90)
	{
		scr_fire_bullet(obj_growtangle.x + lengthdir_x(180, angle) + xx + xxx, obj_growtangle.y + lengthdir_y(180, angle), obj_bullet_scissor, angle + 180, 6, spr_scissor_bullet, true, false, 2);
	}
}
if (timer2 == ((25 + (10 * type)) - ((3 + type) * difficulty)) && type >= 2)
{
	side *= -1;
	timer2 = 0;
	scr_fire_bullet(obj_growtangle.x + (180 * side), obj_growtangle.y + (40 * side), obj_bullet_scissor_big, 90 + (90 * side), 5, spr_scissor_bullet_big, true, false, 3);
}
");

Apply("gml_Object_obj_sheary_smashcut_manager_Draw_73", @"if (global.turntimer < 1)
{
	instance_destroy();
	exit;
}
if (!surface_exists(smash_surface))
{
	smash_surface = surface_create(640, 480);
}
surface_set_target(smash_surface);
draw_clear(c_black);
draw_surface_ext(application_surface, 0, 0, 640 / surface_get_width(application_surface), 480 / surface_get_height(application_surface), 0, c_white, 1);
surface_reset_target();
var cut = obj_growtangle.y - cameray();
var cut2 = cameraheight() - cut;
var xoffset = 0;
timer2 += (1 / global.fps_scale);
var _shake_tick = ceil(timer2);
if (_shake_tick == 1)
{
	xoffset = 10;
}
if (_shake_tick == 2)
{
	xoffset = -9;
}
if (_shake_tick == 3)
{
	xoffset = 8;
}
if (_shake_tick == 4)
{
	xoffset = -7;
}
if (_shake_tick == 5)
{
	xoffset = 6;
}
if (_shake_tick == 6)
{
	xoffset = -5;
}
if (_shake_tick == 7)
{
	xoffset = 4;
}
if (_shake_tick == 8)
{
	xoffset = -3;
}
if (_shake_tick == 9)
{
	xoffset = 2;
}
if (_shake_tick == 10)
{
	xoffset = -1;
}
if (_shake_tick == 11)
{
	xoffset = 0;
}
ossafe_fill_rectangle_color(camerax(), cameray(), camerax() + camerawidth(), cameray() + cameraheight(), c_black, c_black, c_black, c_black);
draw_surface_part(smash_surface, 0, 0, camerawidth(), cut, camerax() + xoffset + (sin(timer) * 24 * intensity), cameray());
draw_surface_part(smash_surface, 0, 0, camerawidth(), cut, (camerax() + xoffset + (sin(timer) * 24 * intensity)) - camerawidth(), cameray());
draw_surface_part(smash_surface, 0, 0, camerawidth(), cut, camerax() + xoffset + (sin(timer) * 24 * intensity) + camerawidth(), cameray());
draw_surface_part(smash_surface, 0, cut, camerawidth(), cut2, camerax() + xoffset + (cos(timer) * 24 * intensity), cameray() + cut);
draw_surface_part(smash_surface, 0, cut, camerawidth(), cut2, (camerax() + xoffset + (cos(timer) * 24 * intensity)) - camerawidth(), cameray() + cut);
draw_surface_part(smash_surface, 0, cut, camerawidth(), cut2, camerax() + xoffset + (cos(timer) * 24 * intensity) + camerawidth(), cameray() + cut);
bar_v = scr_approach(bar_v, 0, bar_v * 0.5);
if (bar_v < 0.1)
{
	bar_v = 0;
}
var bar_height = bar_v * 0.5;
var bar_width = camerawidth() * 0.5;
if (bar_v > 0)
{
	ossafe_fill_rectangle_color(obj_growtangle.x - bar_width, obj_growtangle.y - bar_height, obj_growtangle.x + bar_width, obj_growtangle.y + bar_height, c_white, c_white, c_white, c_white);
}
");

Apply("gml_Object_obj_sheary_smashcut_manager_Step_0", @"timer += (0.025 / global.fps_scale);
if (fadetype == 0)
{
	intensity = scr_approach(intensity, 1, abs(1 - intensity) * (1 - power(0.5, 1 / global.fps_scale)) * global.fps_scale);
}
if (fadetype == 1)
{
	intensity = scr_approach(intensity, 0, 0.1);
	if (intensity == 0)
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_sheary_smashcutter_Step_2", @"timer += (1 / global.fps_scale);
if (timer >= 60)
{
	timer += (1 / global.fps_scale);
}
if (timer == 16)
{
	scr_lerpvar(""x"", x, x + 45, 8, -1, ""out"");
	scr_lerpvar(""y"", y, obj_growtangle.y, 25, -1, ""out"");
	scr_lerpvar(""xscale"", 0, 2, 12, -1, ""out"");
	scr_lerpvar(""yscale"", 0, 1, 12, -1, ""out"");
	image_angle = 180;
	scr_lerpvar(""image_angle"", 0, 180, 28, -1, ""out"");
	sound_play(snd_spearrise, 0.8);
}
if (timer == 27)
{
	scr_lerpvar(""angle"", 0, -33, 10, -1, ""out"");
	scr_lerpvar(""x"", x, x + 30, 10, -1, ""inout"");
	sound_play(snd_chain_extend, 0.8, 0.66);
}
if (timer == 38)
{
	scr_lerpvar(""angle"", angle, 0, 10, -1, ""in"");
	scr_lerpvar(""x"", x, x - 120, 12, -1, ""inout"");
	scr_lerpvar(""bladescale"", 1, 1.8, 10, -1, ""inout"");
}
if (timer == 48)
{
	shake = 2;
	scr_doom(id, 20);
	scr_lerpvar(""image_alpha"", 1, 0, 15);
	sound_play(snd_scytheburst, 0.4);
	var _smashcut = instance_create(obj_growtangle.x, obj_growtangle.y, obj_sheary_smashcut_attack);
	scr_bullet_inherit(_smashcut);
	_smashcut.type = type;
	_smashcut.do_flip = do_flip;
	_smashcut.difficulty = difficulty;
	if (abs(obj_heart.y - y) < 12 && global.inv < 0)
	{
		ti = irandom(2);
		while (ti < 3)
		{
			repeat (2)
			{
				if (global.hp[global.char[ti]] < 0 || global.char[ti] == 0)
				{
					ti++;
				}
				if (ti == 3)
				{
					ti = 0;
				}
			}
			global.inv = -1;
			target = ti;
			if (global.hp[global.char[ti]] > 0 && global.char[ti] != 0)
			{
				damage = floor(global.hp[global.char[ti]] / 2) + (3 * global.battledf[ti]);
				scr_damage();
			}
			ti += 3;
		}
		global.inv = global.invc * 40;
	}
}
");

Apply("gml_Object_obj_shi_power_up_orb_Draw_0", @"if (parenttarget != -1 && !i_ex(parenttarget))
{
	instance_destroy();
	exit;
}
if (parenttarget != -1 && i_ex(parenttarget))
{
	xstart = parenttarget.x;
	ystart = parenttarget.y;
}
if (init == 0)
{
	init = 1;
	if (thin)
	{
		lifetime /= 2;
	}
	if (track_target != -4)
	{
		xstart = 0;
		ystart = 0;
	}
	var _distance = random_range(50, 90);
	xx = xstart + lengthdir_x(_distance, direction);
	x = xx;
	yy = ystart + lengthdir_y(_distance, direction);
	y = yy;
}
if (track_target != -4)
{
	xoff = track_target.x;
	yoff = track_target.y;
}
timer += (1 / global.fps_scale);
if (timer > lifetime)
{
	instance_destroy();
	exit;
}
var _progress = timer / lifetime;
image_alpha = 0.3;
image_blend = c_gray;
image_yscale = 0.25;
image_xscale = 0.75;
image_angle = direction;
draw_self();
x = lerp(xx, xstart, scr_ease_in(_progress, 2)) + xoff;
y = lerp(yy, ystart, scr_ease_in(_progress, 2)) + yoff;
");

