							}
							if (obj_heart.x < (x - 70))
							{
								obj_heart.x = x - 70;
							}
							if (obj_heart.y < (y - ((box_extra + 75) - 5)))
							{
								obj_heart.y = y - ((box_extra + 75) - 5);
							}
						}
					};
					
					draw_function = function()
					{
						var _scale = sizer * growscale;
