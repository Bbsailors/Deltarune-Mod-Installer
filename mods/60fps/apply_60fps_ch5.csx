	draw_set_color(c_black);
	draw_rectangle(__view_get(e__VW.XView, 0) - 100, __view_get(e__VW.YView, 0) - 100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
	draw_set_alpha(1);
	if (instance_exists(obj_caterpillarchara))
