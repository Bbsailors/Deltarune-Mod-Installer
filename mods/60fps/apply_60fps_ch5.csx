	c_msgnextsubloc(""~1* It's not!!^1! Guys^1, it's not!!!/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", ""obj_dw_fcastle_cafe_slash_Other_13_gml_2263_0"");
