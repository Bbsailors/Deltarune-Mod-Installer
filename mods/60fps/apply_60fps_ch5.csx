			}
		}
		ds_list_destroy(li);
		if (!puzzle_mode)
		{
			var dist = 40;
			if (extflag == ""farpush"")
			{
				dist = 60;
			}
			var invalid_push = false;
			if (movedir == 1)
			{
				if (!collision_check(x + 40, y))
				{
					scr_lerpvar(""x"", x, x + dist, 10, 1, ""out"");
					scr_lerpvar_instance(block, ""x"", block.x, block.x + dist, 10, 1, ""out"");
					scr_lerpvar_instance(interact, ""x"", interact.x, interact.x + dist, 10, 1, ""out"");
				}
				else
				{
					invalid_push = collision_check(x, y - 40) && collision_check(x, y + 40);
				}
			}
			if (movedir == 0)
			{
				if (!collision_check(x, y + 40))
				{
					scr_lerpvar(""y"", y, y + 40, 10, 1, ""out"");
					scr_lerpvar_instance(block, ""y"", block.y, block.y + 40, 10, 1, ""out"");
					scr_lerpvar_instance(interact, ""y"", interact.y, interact.y + 40, 10, 1, ""out"");
				}
				else
				{
					invalid_push = collision_check(x - 40, y) && collision_check(x + 40, y);
				}
			}
			if (movedir == 3)
			{
				if (!collision_check(x - 40, y))
				{
					scr_lerpvar(""x"", x, x - dist, 10, 1, ""out"");
					scr_lerpvar_instance(block, ""x"", block.x, block.x - dist, 10, 1, ""out"");
					scr_lerpvar_instance(interact, ""x"", interact.x, interact.x - dist, 10, 1, ""out"");
				}
				else
				{
					invalid_push = collision_check(x, y - 40) && collision_check(x, y + 40);
				}
			}
			if (movedir == 2)
			{
				if (!collision_check(x, y - 40))
				{
					scr_lerpvar(""y"", y, y - 40, 10, 1, ""out"");
					scr_lerpvar_instance(block, ""y"", block.y, block.y - 40, 10, 1, ""out"");
					scr_lerpvar_instance(interact, ""y"", interact.y, interact.y - 40, 10, 1, ""out"");
				}
				else
				{
					invalid_push = collision_check(x - 40, y) && collision_check(x + 40, y);
				}
			}
