	c_wait(30);
	c_speaker(""flowery"");
	c_msgsetloc(0, ""\\E0\\V7* You don't really need Tori anymore./"", ""obj_ch5_DWCL00_slash_Step_0_gml_298_0"");
	c_msgnextloc(""\\E3\\Va* I mean^1, she doesn't have two diners!/%"", ""obj_ch5_DWCL00_slash_Step_0_gml_301_0"");
