					image_speed = 0.25 / global.fps_scale;
					if (!forced_anim)
					{
						sprite_index = spr_kris_plat_idle;
					}
				}
			}
		}
		else
		{
			image_speed = 0.25 / global.fps_scale;
			if (jumping == 3)
			{
				sprite_index = spr_plat_kris_ball;
			}
			else if (jumping < 2)
			{
				sprite_index = spr_kris_jump_up;
			}
			else
			{
				sprite_index = spr_kris_jump_down;
			}
		}
	}
	if (attacking)
	{
		if (grounded)
		{
			if (sprite_index == spr_kris_plat_slash_air && image_index > 10)
			{
				land_anim = 1;
				sprite_index = spr_kris_plat_land;
				image_index = 0;
				image_speed = 0.25 / global.fps_scale;
				attacking = 0;
				instance_destroy(hbx);
			}
			else
			{
				sprite_index = spr_kris_plat_slash_ground;
			}
		}
		else
		{
			sprite_index = spr_kris_plat_slash_air;
		}
	}
	if (climbing)
	{
		sprite_index = spr_kris_plat_climb;
		image_speed = 0;
		if (key_up)
		{
			image_speed = 0.25 / global.fps_scale;
		}
		if (key_down)
		{
			image_speed = -0.25 / global.fps_scale;
		}
	}
	if (_do_autorun)
	{
		sprite_index = spr_kris_plat_run;
		if (static_dash)
		{
			image_speed = 0.5 / global.fps_scale;
		}
		else
		{
			image_speed = lerp(0.25, 0.5, abs(hspeed / dashspeed_modified)) / global.fps_scale;
		}
	}
	if (jumpsquat > 0)
	{
		sprite_index = spr_kris_plat_land;
		image_speed = 0.25 / global.fps_scale;
		if (jumpsquat == 1)
		{
			image_index = 0;
		}
	}
	if (hurt)
	{
		if (grounded)
		{
			sprite_index = spr_kris_plat_hurt_ground;
		}
		else
		{
			sprite_index = spr_kris_plat_hurt_air;
		}
	}
	if (key_down && sprite_index == spr_kris_plat_idle)
	{
		sprite_index = spr_kris_plat_crouch;
	}
	if (run_zone)
	{
		image_xscale = autorun_xscale;
	}
}
if (_landingsound && sprite_index == spr_kris_plat_land)
{
	snd_play_pitch(snd_noise, 1.2);
}
if (jumphovering && fallen_in_pit == 0)
{
	scr_collision_failsafe();
}
if (state == 1)
{
	reached_target();
}
wind_jumpheight = false;
if (hspeed != 0)
{
	movement_direction = sign(hspeed);
}
if (windloop_sound != -4)
{
	snd_volume(windloop_sound, (abs(hspeed) / dashspeed) * 0.1, 0);
	snd_pitch(windloop_sound, lerp(2.5, 1.5, (y - _cameray) / _cameraheight));
}
if (windloop_sound != -4 && !dashing)
{
	snd_volume(windloop_sound, 0, 30);
	scr_script_delayed(snd_stop, 30, windloop_sound);
	windloop_sound = -4;
}
if (!grounded)
{
	time_since_ground++;
}
else
{
	time_since_ground = 0;
}

enum UnknownEnum
{
	Value_m2 = -2,
	Value_0 = 0
}
");

Apply("gml_Object_obj_plat_player_Step_1", @"t += (1 / global.fps_scale);
event_inherited();
if (!paused && !custom_paused)
{
	if (hurt_timer < 0 && hurt)
	{
		hurt = false;
		hurt_timer = 0;
		var _time = 30;
		invincible = true;
		invincible_timer = _time;
		flicker = true;
		flicker_timer = _time;
	}
	else
	{
		hurt_timer -= (1 / global.fps_scale);
	}
	if (invincible_timer < 0 && invincible)
	{
		invincible = false;
		invincible_timer = 0;
	}
	else
	{
		invincible_timer -= (1 / global.fps_scale);
	}
	if (flicker_timer <= 0 && flicker)
	{
		flicker = false;
		player_visible = true;
		flicker_timer = 0;
	}
	else
	{
		if (flicker && frac(flicker_timer) == 0)
		{
			if (player_visible)
			{
				player_visible = false;
			}
			else
			{
				player_visible = true;
			}
		}
		flicker_timer -= (1 / global.fps_scale);
	}
	if (parry_timer > 0)
	{
		parry_timer -= (1 / global.fps_scale);
		if (parry_timer == 0)
		{
			parry_chain = 0;
		}
	}
}
else
{
	player_visible = true;
}
if (instance_exists(heart))
{
	heart.heart_mode = heart_mode;
	with (heart)
	{
		if (heart_mode == 0 && other.targetmode == 0 && (instance_number(obj_plat_barrier) == 0 || instance_exists(obj_cutscene_master)))
		{
			if (image_alpha > 0)
			{
				image_alpha -= (0.05 / global.fps_scale);
			}
			else
			{
				image_alpha = 0;
			}
		}
		else if (image_alpha < 1)
		{
			image_alpha += (0.05 / global.fps_scale);
		}
		else
		{
			image_alpha = 1;
		}
	}
	if (!targetmode)
	{
		outline_alpha = heart.image_alpha;
		var _darken = outline_alpha * 200;
		image_blend = make_color_rgb(255 - _darken, 255 - _darken, 255 - _darken);
	}
}
");

Apply("gml_Object_obj_plat_playerheart_Collision_obj_plat_bullet", @"if (!instance_exists(obj_plat_player))
{
	exit;
}
if (!hurt && !immune && owner.fallen_in_pit == 0 && !retreating && other.neutralized <= 0 && other.damage > 0 && visible)
