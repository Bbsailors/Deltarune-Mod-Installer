			scr_shakeobj();
		}
		scr_speaker(""tenna"");
		msgsetloc(0, ""* What!? 3 seconds!?/%"", ""obj_gameover_band_slash_Step_0_gml_106_0"");
		var d = d_make();
		d.stay = 5;
		d.side = 0;
	}
	if (con == 10 && !d_ex())
	{
		con = 11;
		alarm[0] = round(30 * global.fps_scale);
		tenna.preset = 0;
		tenna.bounce = 1;
		tenna.sprite_index = spr_tenna_point_left;
