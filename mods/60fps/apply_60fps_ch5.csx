				scr_lerpvar(""image_yscale"", image_yscale, 2, 10, 1, ""out"");
				scr_lerpvar(""hspeed"", (6 * spd * i) / global.fps_scale, (((12 * spd) - 6) * i) / global.fps_scale, 15 + (10 * spd));
				lifetime = 160;
				damage = 22;
			}
		}
	}
	hp = 0;
	hit = true;
	instance_destroy();
}
