{
	scr_flower_despwn();
	exit;
}
if (knocked_back > 0)
{
	image_speed = 0;
	if (knocked_back >= 2)
	{
		if (knocked_back >= 4)
		{
			knocked_back += (1 / global.fps_scale);
			hspeed = 0;
			vspeed = 0;
			if (knocked_back >= 12)
			{
				knocked_back = 0;
				image_speed = 0.25 / global.fps_scale;
			}
		}
		else
		{
			knocked_back += (0.01 / global.fps_scale);
			if ((knocked_back % 1) < 0.05)
			{
				vspeed = v_knockback;
				hspeed = h_knockback;
			}
			if ((knocked_back % 1) > 0.05 && grounded)
			{
				knocked_back = ceil(knocked_back + 0.01);
				if (knocked_back >= 3)
				{
					knocked_back = 4;
					hspeed = 0;
					vspeed = 0;
				}
				else
				{
					vspeed = (-6 + (knocked_back * 2)) / global.fps_scale;
					hspeed = h_knockback;
				}
			}
			else
			{
				vspeed += (0.77 / (global.fps_scale * global.fps_scale));
			}
		}
	}
}
else
{
	var _sign = sign(image_xscale);
	if (grounded)
	{
		hspeed = -_sign * movespeed;
	}
}
var _p = instance_place(x, y - 4, obj_plat_player);
if (instance_exists(_p))
{
	if (_p.ground == id)
	{
		_p.vspeed = -8 / global.fps_scale;
		hit = 1;
		audio_stop_sound(snd_enemy_defeat_quick);
		snd_play(snd_enemy_defeat_quick);
		instance_destroy();
		exit;
	}
}
