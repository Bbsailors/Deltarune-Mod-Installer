shrub = scr_marker_fromasset(findsprite(spr_ralsei_bush, ""SHRUB_ASSETS""), undefined, 1, 1);
with (shrub)
{
	image_speed = 0;
	image_index = 0;
	head = -4;
	body = -4;
	kco = 0;
	timer = 0;
	startx = x;
	starty = y;
	
	doRalsei = function()
	{
		var spr = findspriteinfo(spr_ralsei_bush);
		x = spr.x;
		y = spr.y;
		sprite_index = spr.sprite_index;
		startx = x;
		starty = y;
	};
	
	doKris = function()
	{
		var spr = findspriteinfo(spr_kris_bush);
		x = spr.x;
		y = spr.y;
		sprite_index = spr.sprite_index;
		startx = x;
		starty = y;
	};
	
	growhead = function(arg0 = 30)
	{
		sprite_index = spr_ralsei_bush_growhead;
		image_index = 0;
		scr_lerpvar(""image_index"", 0, 3, arg0, 2, ""out"");
	};
	
	cutKris = function()
	{
		kco = 1;
		timer = 0;
		with (head)
		{
			instance_destroy();
		}
	};
	
	cleanupHead = function()
	{
		with (head)
		{
			scr_lerpvar(""image_alpha"", 1, 0, 30);
		}
	};
	
	step_func = function()
	{
		if (kco == 1)
		{
			head = scr_marker_ext(x + 22, y + 22, spr_bush_krishead, 2, 2, undefined, undefined, undefined, depth - 2, undefined, undefined, 0);
			kco = 2;
			timer = 0;
		}
		if (kco == 2)
		{
			head.image_alpha = lerp(head.image_alpha, 1.1, scr_fps_lerp_rate(0.25));
			if (head.image_alpha >= 1)
			{
				timer = 0;
				sprite_index = spr_bush_krisbody;
				x += 6;
				y += 36;
				startx = x;
				starty = y;
				kco = 3;
				with (head)
				{
					image_alpha = 1;
					gravity = 1 / (global.fps_scale * global.fps_scale);
					scr_lerpvar(""image_angle"", image_angle, 60, 20);
					scr_lerpvar(""x"", x, x - 40, 20, 1, ""out"");
					scr_delay_var(""vspeed"", -6 / global.fps_scale, 10);
					snd_play_delay(snd_noise, 10);
					scr_delay_var(""gravity"", 0, 20);
					scr_delay_var(""vspeed"", 0, 20);
				}
			}
		}
	};
}
shrubcon = 0;
shrubtimer = 0;
layer_set_visible(""SHRUB_ASSETS"", 0);
shrubshearieNPC = scr_makenpc_fromasset(findsprite(spr_scissordancer, ""NPCs"", c_blue), 1);
with (shrubshearieNPC)
{
	markerstick = false;
	issolid = false;
	scr_sizeexact(98, 68);
	x -= 36;
	y += 4;
}
shrubshearie = shrubshearieNPC.marker;
with (shrubshearie)
{
	sprite_index = spr_scissordancer_idle;
	startx = x;
	starty = y;
	image_blend = c_white;
	image_speed = 0;
	spinspeed = 1/3;
	siner = 0;
	lerpstrength = 0.1;
	startlerp = lerpstrength;
	maxlerp = 1;
	twirl = false;
	shakerate = 20;
	twirlrate = 14;
	pivot_point = 
	{
		x: obj_dw_garden_shearyguide.shrub.x + 29,
		y: obj_dw_garden_shearyguide.shrub.y + 98
	};
	
	step_func = function()
	{
		siner += (1 / global.fps_scale);
		image_speed = lerp(image_speed, spinspeed / global.fps_scale, scr_fps_lerp_rate(0.125));
		
		starttwirl = function()
		{
			twirlrate = 8;
			shakerate = 8;
			twirl = true;
			siner = 0;
		};
		
		endtwirl = function()
		{
			twirl = false;
			lerpstrength = 0.1;
		};
		
		if (twirl == true)
		{
			shakerate = lerp(shakerate, 2, scr_fps_lerp_rate(1/30));
			var rate = round(shakerate);
			if (((siner + 1) % rate) == 0)
			{
				var pitch = 1.2;
				if (((siner + 1) % (rate * 2)) == 0)
				{
					pitch = 1.8;
				}
				snd_stop(snd_wing);
				snd_play(snd_wing, 0.7, pitch);
				with (obj_dw_garden_shearyguide)
				{
					with (shrub)
					{
						with (obj_shakeobj)
						{
							instance_destroy();
						}
						setxy(startx, starty);
						scr_shakeobj(id, 6);
					}
				}
			}
			spinspeed = 1;
			lerpstrength = lerp(lerpstrength, maxlerp, scr_fps_lerp_rate(0.05));
			twirlrate = lerp(twirlrate, 24, scr_fps_lerp_rate(0.05));
			var targx = (pivot_point.x + lengthdir_x(50, siner * twirlrate)) - 42;
			var targy = (pivot_point.y + lengthdir_y(26, siner * twirlrate)) - 100;
			x = lerp(x, targx, scr_fps_lerp_rate(lerpstrength));
			y = lerp(y, targy, scr_fps_lerp_rate(lerpstrength));
		}
		if (!twirl)
		{
			spinspeed = 1/3;
			lerpstrength = lerp(lerpstrength, startlerp, scr_fps_lerp_rate(0.2));
			x = lerp(x, startx, scr_fps_lerp_rate(lerpstrength));
			y = lerp(y, starty, scr_fps_lerp_rate(lerpstrength));
		}
		scr_depth();
	};
}
