			}
			if (rr == 1)
			{
				msgsetloc(0, ""HUMAN...&DIGGING&..^1. &NO GOOD"", ""obj_terracota_enemy_slash_Step_0_gml_23_0"");
			}
			if (rr == 2)
			{
				msgsetloc(0, ""LITTLE&DIRT&NEVER&HURT"", ""obj_terracota_enemy_slash_Step_0_gml_24_0"");
			}
		}
		scr_enemyblcon(x - 20, y + 80, 10);
		talked = 1;
		talktimer = 0;
		rtimer = 0;
