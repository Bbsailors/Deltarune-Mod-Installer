flies_past = function(arg0, arg1, arg2)
{
	return arg0 >= arg2 && arg1 < arg2;
};

create_fake_bullet = function(arg0)
{
	var winddir = scr_wind_direction();
	var _dir = (winddir * 90) + 180;
	var _b = instance_create_depth(x + aquax, y + aquay, depth - 10, obj_marker);
	with (_b)
	{
		owner = other.id;
		sprite_index = spr_faqua_knife;
		scr_darksize();
		scr_doom(self, 80);
		speed = 2 / global.fps_scale;
		scr_lerpvar(""speed"", 2 / global.fps_scale, 12 / global.fps_scale, 25);
		direction = _dir + (2 * arg0);
		depth = 1700000;
		image_angle = direction;
		image_blend = merge_color(c_white, c_black, 0.75);
		var ys = 1;
		if (_dir == clamp(_dir, 90, 270))
		{
			ys *= -1;
		}
		image_xscale = 0;
		image_yscale = 0;
		scr_lerpvar(""image_xscale"", 0, 2, 60);
		scr_lerpvar(""image_yscale"", 0, 2 * ys, 60);
	}
};

create_bullet = function(arg0)
{
	var winddir = scr_wind_direction();
	var _dir = winddir * 90;
	var _x = -20;
	if (winddir == 2)
	{
		_x = room_width + 20;
	}
	var _b = instance_create_depth(_x, arg0, depth - 10, obj_plat_aquaknife_winddirect);
	with (_b)
	{
		owner = other.id;
		wind_direction = winddir;
		direction = _dir;
		damage = 25;
		lifetime = 999999;
	}
};

create_swirling_knife = function(arg0, arg1)
{
	var xx = camerax() + (0.5 * camerawidth());
	var yy = cameray() - 60;
	var _b = instance_create_depth(xx + arg0, yy + arg1, depth - 10, obj_plat_aquaknife_winddirect);
	_b.wind_direction = 1;
	_b.damage = 25;
	_b.sprite_index = spr_faqua_knife_cracked;
	_b.image_speed = 0;
	_b.lifetime = 999999;
	with (_b)
	{
		scr_plat_depthcast();
	}
};

kp_triangle = function(arg0)
{
	create_swirling_knife(arg0 - 40, 0);
	create_swirling_knife(arg0 + 40, 0);
	create_swirling_knife(arg0, -40);
};

kp_row = function(arg0, arg1, arg2, arg3)
{
	for (var i = 0; i < arg3; i++)
	{
		create_swirling_knife(arg0 + (arg1 * i), i * arg2);
	}
};

arc_knives = [];

shoot_knife = function(arg0 = -1, arg1, arg2)
{
	if (arg0 == -1)
	{
		arg0 = irandom_range(0, array_length(arc_knives) - 1);
	}
	randomize_aquasprite();
	with (arc_knives[arg0])
	{
		shoot_at(arg1, arg2);
	}
	array_delete(arc_knives, arg0, 1);
};

create_knife_arc = function(arg0)
{
	timer = -25;
	aquasprite = 3483;
	aqua_image_speed = 0.5;
	var angle = 45;
	var angle_inc = 90 / (arg0 - 1);
	for (var i = 0; i < arg0; i++)
	{
		var kn = instance_create(x + aquax, y + aquay, obj_plat_aquaknife_3d);
		kn.direction = angle;
		kn.index = i;
		kn.timer = -i * 5;
		kn.depth = depth + 5;
		kn.speed = 0;
		kn.image_angle = direction;
		array_push(arc_knives, kn);
		angle += angle_inc;
	}
};

randomize_aquasprite = function()
{
};

spawn_aqua_petals = function(arg0, arg1, arg2, arg3 = 1, arg4 = 0)
{
	var _dir = 270 + irandom_range(-15, 15);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_fancy))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = (0.125 * choose(1, 0.5, 0.75)) / global.fps_scale;
		image_blend = merge_color(c_aqua, c_black, arg4);
		scr_darksize();
		image_xscale *= (lerp(1, 0.5, arg4) * 0.5);
		image_yscale *= (lerp(1, 0.5, arg4) * 0.5);
		depth = arg2 + choose(-1, 1);
		direction = _dir;
		gravity_direction = 270;
		ys = (random_range(0.15, 0.25) * arg3) / (global.fps_scale * global.fps_scale);
		image_xscale *= choose(1, -1);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is;
				vspeed -= ys;
				x = xstart + (sin(timer * 0.12) * ((timer * 0.5) + 4) * image_xscale);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

aquascale = 1;
sethscale = 1;
last_player_y = -1;
");

