			d_make_plat(0, 1);
		}
	}
}
if (con > 0)
{
	if ((timer % 2) == 0)
	{
		spawn_aqua_petals(x + 40, y + 20, depth + 1, 1);
	}
}
if (con == 1)
{
	if (timer == 8)
	{
		sprite_index = spr_enemy_aqua_spin;
		image_speed = 0.25 / global.fps_scale;
	}
	var bullet_order = [];
	if (pattern == 0)
	{
		bullet_order = [0, 1, 0, 1, 0, [1, 1]];
	}
	else if (pattern == 1)
	{
		bullet_order = [[0, 1], 1, [1, 0], -1, [1, 1], -1, 0, [1, 1, 1], -1, -1, -1, -1, 0, -1, 1, -1, [0, 0], -1, -1, [1, 1, 1]];
	}
	if (timer >= timerlimit)
	{
		var bul = bullet_order[other.pattern_index % array_length(bullet_order)];
		timer = 0;
		if (bul != -1)
		{
			timerlimit -= 5;
			timerlimit = max(timerlimit, 5);
			if (!is_array(bul))
			{
				bul = [bul];
			}
			sprite_index = spr_enemy_aqua_hype_reverse;
			image_speed = 0;
			snd_play(snd_swing);
			scr_lerpvar(""image_index"", 3, 5, 3);
			for (var i = 0; i < array_length(bul); i++)
			{
				var bullet = instance_create(x, y, obj_plat_bulletred_rebounding);
				with (bullet)
				{
					make_sounds = true;
					scr_darksize();
					hspeed = obj_plat_player.hspeed + (4 / global.fps_scale);
					spinspeed = -23 / global.fps_scale;
					scr_lerpvar(""spinspeed"", -46 / global.fps_scale, 46 / global.fps_scale, 30, 2, ""inout"");
					image_speed = 0;
					image_index = 2;
					scr_lerpvar(""y"", y, y + 120 + (100 * bul[i]), 30, 1, ""out"");
					scr_lerpvar(""hspeed"", hspeed, hspeed - (24 / global.fps_scale), 45 + (9 * i), 1, ""in"");
					lifetime = 200;
				}
			}
		}
		pattern_index++;
		if (pattern_index == array_length(bullet_order))
		{
			con = 2;
			timer = 0;
		}
	}
	targetlerp = scr_approach(targetlerp, 1, 0.05);
	var targetx = camerax() + 560;
	var targety = cameray() + 60;
	var _tl = (targetlerp >= 1) ? targetlerp : (1 - power(1 - targetlerp, 1 / global.fps_scale));
	x = lerp(x, targetx, _tl);
	y = lerp(y, targety, _tl);
}
else if (con == 2)
{
	if (timer == 8)
	{
		sprite_index = spr_enemy_aqua_spin;
		image_speed = 0.25 / global.fps_scale;
	}
	if (timer == 45)
	{
		con = 3;
		gravity = 12 / (global.fps_scale * global.fps_scale);
		gravity_direction = 15;
		with (obj_plat_loopboundary)
		{
			if (extflag == (""aqua_"" + string(other.pattern)))
			{
				instance_destroy();
			}
		}
		scr_doom(self, 60);
	}
	targetlerp = scr_approach(targetlerp, 1, 0.05);
	var targetx = camerax() + 560;
	var targety = cameray() + 60;
	var _tl = (targetlerp >= 1) ? targetlerp : (1 - power(1 - targetlerp, 1 / global.fps_scale));
	x = lerp(x, targetx, _tl);
	y = lerp(y, targety, _tl);
}
");

