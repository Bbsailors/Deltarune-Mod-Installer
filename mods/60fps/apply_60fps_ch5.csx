	var life = random_range(60 - (30 * reduced_effects), 90 - (40 * reduced_effects));
	paperscraps_particle_struct.hspeed = lengthdir_x(len, dir);
	paperscraps_particle_struct.vspeed = lengthdir_y(len, dir);
	paperscraps_particle_struct.image_speed = random_range(0.2, 0.25);
	paperscraps_particle_struct.fadeout_speed = 4 / life;
	paperscraps_particle_struct.lifetime = life;
	paperscraps_particle_struct.sprite_index = choose(spr_plat_paperscraps_1, spr_plat_paperscraps_2, spr_plat_paperscraps_3, spr_plat_paperscraps_4, spr_plat_paperscraps_5);
	paperscraps_particle_system.emit(paperscraps_particle_struct);
}
destroyed = true;
with (block)
{
	instance_destroy();
}
