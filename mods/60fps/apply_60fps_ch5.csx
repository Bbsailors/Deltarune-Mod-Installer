		make_flora_bubble(flora_msg);
	}
}
with (npc_floradinn)
{
	scr_plat_depthcast();
	init = 1;
}
");

Apply("gml_Object_obj_dw_cliff_verticalwind_Step_0", @"if (!init)
{
