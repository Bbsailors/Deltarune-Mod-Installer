		var _notealive = notealive[notei];
		var _notescore = notescore[notei];
		var _noteend = noteend[notei];
		if (!arg2 && instrument != 1 && obj_rhythmgame.song_id == 0)
		{
			_notetime = scr_rhythmgame_noteskip(notetime[notei]);
