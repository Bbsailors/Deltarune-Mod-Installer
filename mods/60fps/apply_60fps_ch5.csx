		global.interact = 1;
		scr_get_plat_followers();
		cutscene_master = scr_cutscene_make();
		c_plat_prepare_followers();
		scr_miniface_init_flowers();
		scr_maincharacters_actors();
		aq = scr_setup_plat_actor(npc_aqua, ""aqua"");
		st = scr_setup_plat_actor(npc_seth, ""seth"");
		npc_seth.image_xscale = 2;
		npc_seth.physics = false;
		npc_aqua.jumpheight = 14;
		c_plat_action(npc_aqua, npc_aqua.force_jump);
		c_sel(aq);
		c_sprite(spr_enemy_aqua_spin);
		c_sel(st);
		c_image_speed(0);
		c_wait(30);
		var cam = findspriteinfo(spr_debug_cameraregionpreview, undefined, c_red);
		var startcamx = camerax();
		var startcamy = cameray();
		var camtime = scr_returnwait(startcamx, startcamy, cam.x, cam.y, 14);
		c_pannable(true);
		c_pan(cam.x, cam.y, camtime);
		c_wait(camtime);
		c_wait(30);
		c_mus(""free"");
		c_customfunc(scr_musicer, ""meeting_flower.ogg"");
		c_speaker(""aqua"");
		c_msgsetsubloc(0, ""~1* What are we doing^1? Keeping an eye~2out for..^1. who?/%"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_91_0"");
		c_talk_wait();
		c_plat_stop_action(npc_aqua);
		c_sel(aq);
		c_sprite(spr_enemy_aqua_unamused);
		c_flip(""x"");
		c_image_speed(0);
		c_wait(30);
		c_sprite(spr_aqua_eye_reveal);
		c_imageindex(0);
		c_wait(22);
		c_imageindex(1);
		c_wait(8);
		c_speaker(""aqua"");
		c_msgsetsubloc(0, ""~1* ..^1. how many eyes do humans have~2again?/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_107_0"");
		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* Ugh..^1. this is the last time I'm~2going to repeat this^1, OK^1, AQUA?/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_109_0"");
		c_msgfunc(function(arg0)
		{
			with (obj_plat_cam_clampzone)
			{
				if (extflag == ""prescene"")
				{
					instance_destroy();
				}
			}
			with (arg0)
			{
				turn(true);
				force_animation(90);
				image_speed = 0;
				scr_shakeobj();
			}
		}, npc_seth);
		c_facenext(""aqua"", 0);
		c_msgnextsubloc(""~1* Aqua^1? Who's Aqua?/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_122_0"");
		c_sel(aq);
		c_spritenext(7724);
		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* That's YOU^1! You're \""aqua\""-colored^1,~2so.../"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_128_0"");
		c_sel(st);
		c_spritenext(7319, 0, 0);
		c_facenext(""aqua"", 0);
		c_msgnextsubloc(""~1* Wrong^1! I'm \""Blue!\""/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_134_0"");
		c_sel(aq);
		c_spritenext(2817);
		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* No^1, no^1, there's already a \""Blue,^1\""~2remember?/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_140_0"");
		c_sel(st);
		c_spritenext(6749);
		c_facenext(""aqua"", 0);
		c_msgnextsubloc(""~1* Huh?/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_cutdown_tutorial_slash_Step_0_gml_146_0"");
		c_sel(aq);
		c_spritenext(5818);
		npc_aqua.bouncestarty = npc_aqua.y;
