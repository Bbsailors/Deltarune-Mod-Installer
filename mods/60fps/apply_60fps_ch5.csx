Apply("gml_Object_obj_trial_perp_Step_0", @"flash = scr_approach(flash, 0, 0.1);
if (do_move)
{
	if (active)
	{
		y = scr_approach(y, testimony_y, abs(y - testimony_y) * 0.15);
	}
	else
	{
		y = scr_approach(y, anchor_y, abs(y - anchor_y) * (1 - power(0.5, 1 / global.fps_scale)) * global.fps_scale);
	}
}
if (active)
{
	timer += (1 / global.fps_scale);
	if (perp_index == 0)
	{
		if (trial_index < 99999999)
		{
			if (timer == 1)
			{
				sprite_index = spr_aqua_sleevewave;
				image_speed = (1/3) / global.fps_scale;
			}
			if ((timer % 10) == 0)
			{
				image_xscale *= -1;
				if (image_xscale == 2)
				{
					x = anchor_x;
				}
				else
				{
					x = anchor_x + 41;
				}
			}
		}
	}
	if (perp_index == 1)
	{
		if (trial_index == 0)
		{
			if (timer == 1)
			{
				sprite_index = spr_seth_nervous;
				image_speed = 0.16666666666666666 / global.fps_scale;
			}
		}
	}
	if (perp_index == 2)
	{
		if (trial_index != 1)
		{
			if (timer == 1)
			{
				sprite_index = spr_green_shrug;
				image_index = 0;
				image_speed = 0;
			}
			if (timer == 10)
			{
				image_index = 1;
			}
		}
		if (trial_index == 1)
		{
			if (timer == 1)
			{
				sprite_index = spr_green_shrug;
				image_index = 0;
				image_speed = 0;
			}
			if (timer == 60)
			{
				image_index = 1;
				sprite_index = spr_green_shrug_shifty;
			}
		}
	}
	if (perp_index == 3)
	{
		if (trial_index == 3)
		{
			if (timer == 1)
			{
				sprite_index = spr_blue_suspicious_unhappy;
			}
		}
	}
	if (perp_index == 4)
	{
		if (trial_index == 0)
		{
			if (timer == 1)
			{
				sprite_index = spr_yellow_sad_walk_down;
				image_speed = 0;
			}
		}
	}
}
");

