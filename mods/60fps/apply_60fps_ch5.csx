		scr_lerpvar(""x"", x, arg0, arg2 - 5, 2, ""out"");
		scr_lerpvar(""y"", y, arg1, arg2 - 5, 2, ""out"");
		scr_script_delayed(scr_lerpvar, arg2 - 5, ""x"", arg0, x, arg2, 1, ""in"");
		scr_script_delayed(scr_lerpvar, arg2 - 5, ""y"", arg1, y, arg2, 1, ""in"");
