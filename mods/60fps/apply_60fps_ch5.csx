Apply("gml_Object_obj_dog_balloon_Create_0", @"yheight = 120;
fakey = yheight;
con = 0;
timer = 0;
siner = 0;
rate = 2;
waittime = -1;
dogsprite = 4715;
spd = 0;
pedloc = findspriteinfo(spr_wateringpedestal, ""DEBUG_ASSETS"");
myint = instance_create(x, y, obj_marker);
with (myint)
{
	visible = false;
	sprite_index = spr_pxwhite;
	myinteract = 0;
	scr_sizeexact(40, 40);
}
floatrate = lerp(4, 12, fakey / yheight);
index = irandom(5);
startloc = 
{
	x: x,
	y: y
};
nextloc = 
{
	x: xstart,
	y: ystart
};
state = ""watering"";
facing = 0;

makesparkle = function(arg0, arg1)
{
	with (scr_marker_fancy(arg0, arg1, 4635))
	{
		scr_size(2, 2);
		image_speed = 0.25 / global.fps_scale;
		timer = 0;
		death = 12;
		gravity = 0.25 / (global.fps_scale * global.fps_scale);
		depth = other.depth - 1000;
		
		step_func = function()
		{
			timer += (1 / global.fps_scale);
			image_alpha = lerp(3, 0, timer / death);
			if (timer >= death)
			{
				instance_destroy();
			}
		};
	}
};

wateringcanmarker = -4;

makewateringcanmarker = function()
{
	wateringcanmarker = scr_marker_frominstance(1010, true);
	with (wateringcanmarker)
	{
		endme = false;
		stick = true;
		toss = false;
		endloc = findspriteinfo(spr_wateringcan, ""DEBUG_ASSETS"");
		daddy = other;
		
		drop = function()
		{
			image_xscale = 2;
			stick = false;
			with (obj_wateringcan_pedestal)
			{
				other.depth = depth - 1;
			}
			gravity = 1 / (global.fps_scale * global.fps_scale);
			x = endloc.x;
			endme = true;
		};
		
		end_step_func = function()
		{
			if (stick)
			{
				with (daddy)
				{
					other.y = ((y - 124 - 6 - fakey) + (sin(siner / 8) * floatrate) + 108) - 4;
				}
				facing = daddy.facing;
				depth = daddy.depth - 1;
				if (daddy.facing == 0)
				{
					image_xscale = -2;
					x = daddy.x + 6;
				}
				else
				{
					image_xscale = 2;
					x = daddy.x + 52;
				}
			}
			if (endme)
			{
				if (y >= endloc.y)
				{
					with (obj_wateringcan_pedestal)
					{
						with (obj_helditem)
						{
							if (other.held_item_flag >= 0)
							{
								global.flag[other.held_item_flag] = other.held_item_flag_index;
							}
							image_xscale = 2;
							engaged = false;
							frozen = true;
							event_user(1);
							with (other)
							{
								helditem = other;
							}
							depth = other.depth - 50;
							snd_play(snd_noise, 0.5, 1.2);
							x = other.x + (0.5 * other.sprite_width);
							y = other.y + 8;
						}
					}
					instance_destroy();
				}
			}
		};
		
		draw_func = function()
		{
			draw_self();
		};
	}
};

penciltext = -4;

makeText = function()
{
	with (penciltext)
	{
		instance_destroy();
	}
	penciltext = instance_create(x, y, obj_object);
	with (penciltext)
	{
		snd_play(snd_pencilscratch, 0.5, 1.2);
		image_alpha = 0;
		col = 8421504;
		daddy = other;
		timer = 0;
		off = 
		{
			x: 0,
			y: 0
		};
		off2 = 
		{
			x: 0,
			y: 0
		};
		
		end_step_func = function()
		{
			if (timer < 15)
			{
				image_alpha = lerp(0, 1, timer / 14);
			}
			depth = 5000;
			timer += (1 / global.fps_scale);
			if ((timer % 2) == 0)
			{
				off.x = irandom_range(-1, 1);
				off.y = irandom_range(-1, 1);
				off2.x = irandom_range(-1, 1);
				off2.y = irandom_range(-1, 1);
			}
			x = daddy.x;
			with (daddy)
			{
				other.y = y - 124 - 6 - fakey;
			}
			if (timer > 270)
			{
				image_alpha -= ((1/30) / global.fps_scale);
			}
			if (timer >= 300)
			{
				instance_destroy();
			}
		};
		
		draw_func = function()
		{
			var strspr = 5956;
			if (global.lang == ""ja"")
			{
				strspr = 5346;
			}
			draw_sprite_ext(strspr, 0, x + 64 + off.x + 2, (y - 62) + off.y + 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, x + 64 + off.x + 0, (y - 62) + off.y + 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, (x + 64 + off.x) - 2, ((y - 62) + off.y) - 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, (x + 64 + off.x) - 0, ((y - 62) + off.y) - 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, (x + 64 + off.x) - 2, ((y - 62) + off.y) - 0, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, x + 64 + off.x, (y - 62) + off.y, 1, 1, 0, col, 1 * image_alpha);
			draw_sprite_ext(strspr, 0, x + 64 + off2.x, (y - 62) + off2.y, 1, 1, 0, col, 0.5 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, ((x + 64) - 14) + off2.x + 2, (y - 62) + 94 + off2.y + 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, ((x + 64) - 14) + off2.x + 0, (y - 62) + 94 + off2.y + 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, ((x + 64) - 14) + off2.x + 2, (y - 62) + 94 + off2.y + 0, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, (((x + 64) - 14) + off2.x) - 2, ((y - 62) + 94 + off2.y) - 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, (((x + 64) - 14) + off2.x) - 0, ((y - 62) + 94 + off2.y) - 2, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, (((x + 64) - 14) + off2.x) - 2, ((y - 62) + 94 + off2.y) - 0, 1, 1, 0, c_black, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, ((x + 64) - 14) + off2.x, (y - 62) + 94 + off2.y, 1, 1, 0, col, 1 * image_alpha);
			draw_sprite_ext(spr_string_arrow, 0, ((x + 64) - 14) + off.x, (y - 62) + 94 + off.y, 1, 1, 0, col, 0.5 * image_alpha);
		};
	}
};
");

Apply("gml_Object_obj_dog_balloon_Step_0", @"if (global.interact == 0)
{
	siner += (1 / global.fps_scale);
}
if (state == ""watering"")
{
	var breakWatering = false;
	with (obj_wateringcan)
	{
		if (held)
		{
			breakWatering = true;
		}
	}
	if (breakWatering)
	{
		timer = 0;
		con = 0;
		state = ""chasing"";
		spd = 0;
	}
	var activecount = 0;
	with (obj_dw_dogballoon)
	{
		if (!solved)
		{
			for (var i = 0; i < 6; i++)
			{
				with (fl[i])
				{
					if (active)
					{
						activecount++;
					}
				}
			}
		}
		else
		{
			activecount = 0.8;
		}
	}
	var flyspeed = lerp(2, 20, activecount / 6) / global.fps_scale;
	if (con == 0)
	{
		with (obj_dw_dogballoon)
		{
			fl[other.index].watered = 60;
		}
		index = scr_wrap(index + 1, 0, 5);
		startloc = 
		{
			x: x,
			y: y
		};
		nextloc = 
		{
			x: (obj_dw_dogballoon.fl[index].x - 12) + 12 + 12,
			y: obj_dw_dogballoon.fl[index].y + 22
		};
		rate = round(lerp(2, 20, activecount / 6));
		var waittime = scr_returnwait_instance(startloc, nextloc, rate);
		timer = 0;
		con = 1;
	}
	if (con == 1)
	{
		if (global.interact == 0)
		{
			timer += (1 / global.fps_scale);
			var dir = point_direction(x, y, nextloc.x, nextloc.y);
			var dist = point_distance(x, y, nextloc.x, nextloc.y);
			var newx = x + lengthdir_x(min(flyspeed, dist), dir);
			var newy = y + lengthdir_y(min(flyspeed, dist), dir);
			if (abs(newx - x) > 0)
			{
				if (newx > x)
				{
					facing = 1;
				}
				else
				{
					facing = 0;
				}
			}
			x = newx;
			y = newy;
			dist = point_distance(x, y, nextloc.x, nextloc.y);
			if (dist < 1)
			{
				facing = 0;
				x = nextloc.x;
				y = nextloc.y;
				con = 1.9;
				timer = 0;
			}
		}
	}
	if (con == 1.9)
	{
		timer += (1 / global.fps_scale);
		var waittime = 15;
		if (timer >= waittime)
		{
			con = 2;
			timer = 0;
		}
	}
	if (con == 2)
	{
		var endpt = -16;
		var descendrate = round(lerp(2, 5, activecount / 6));
		fakey = max(fakey - (descendrate / global.fps_scale), endpt);
		if (fakey == endpt)
		{
			con = 2.9;
			timer = 0;
		}
	}
	if (con == 2.9)
	{
		timer += (1 / global.fps_scale);
		var flowerwait = round(lerp(8, 2, activecount / 6));
		if (timer >= flowerwait)
		{
			dogsprite = 8060;
			var loc = 
			{
				x: (x - 2) + (48 * facing),
				y: ((y - fakey) + (sin(siner / 8) * floatrate)) - 53
			};
			makesparkle(loc.x, loc.y);
			con = 3;
		}
	}
	if (con == 3)
	{
		timer += (1 / global.fps_scale);
		var waitrate = round(lerp(15, 6, activecount / 6));
		if (timer >= waitrate)
		{
			dogsprite = 4715;
			timer = 0;
			con = 4;
		}
	}
	if (con == 4)
	{
		var ascendrate = round(lerp(2, 5, activecount / 6));
		fakey = min(fakey + (ascendrate / global.fps_scale), yheight);
		if (fakey == yheight)
		{
			con = 4.1;
			timer = 0;
		}
	}
	if (con == 4.1)
	{
		timer += (1 / global.fps_scale);
		var waittime = 15;
		if (timer >= waittime)
		{
			con = 0;
			timer = 0;
		}
	}
}
else if (state == ""chasing"")
{
	var breakChasing = false;
	with (obj_wateringcan)
	{
		if (!held)
		{
			breakChasing = true;
		}
	}
	if (breakChasing)
	{
		timer = 0;
		con = 0;
		state = ""watering"";
		spd = 0;
	}
	var targ = 
	{
		x: obj_mainchara.x - 20,
		y: obj_mainchara.y + 66
	};
	fakey = lerp(fakey, 40, scr_fps_lerp_rate(0.05));
	spd = lerp(spd, 8 / global.fps_scale, scr_fps_lerp_rate(1/30));
	var dist = point_distance(x, y, targ.x, targ.y);
	var dir = point_direction(x, y, targ.x, targ.y);
	var newx = x + lengthdir_x(min(spd, dist), dir);
	var newy = y + lengthdir_y(min(spd, dist), dir);
	x = round(lerp(x, newx, 0.9));
	y = round(lerp(y, newy, 0.9));
	if (abs(newx - x) > 0.5)
	{
		if (newx > x)
		{
			facing = 1;
		}
		else
		{
			facing = 0;
		}
	}
	if (point_distance(x, y, targ.x, targ.y) < 8)
	{
		global.facing = 0;
		with (obj_wateringcan)
		{
			held = false;
			event_user(1);
			x = room_width * 2;
		}
		with (obj_mainchara)
		{
			holding_item = -4;
			sprite_index = spr_krisd_dark;
		}
		makewateringcanmarker();
		state = ""returning"";
		snd_play(snd_item, 1, 0.5);
		spd = 0;
	}
}
else if (state == ""returning"")
{
	var targx = pedloc.x - 32;
	var targy = pedloc.y + 60;
	fakey = lerp(fakey, yheight, scr_fps_lerp_rate(0.05));
	spd = lerp(spd, 10 / global.fps_scale, scr_fps_lerp_rate(0.05));
	var dist = point_distance(x, y, targx, targy);
	var dir = point_direction(x, y, targx, targy);
	var newx = x + lengthdir_x(min(spd, dist), dir);
	var newy = y + lengthdir_y(min(spd, dist), dir);
	setxy(newx, newy);
	if (abs(newx - x) > 0.5)
	{
		if (newx > x)
		{
			facing = 1;
		}
		else
		{
			facing = 0;
		}
	}
	if (dist < 120)
	{
		facing = 1;
	}
	if (point_distance(x, y, targx, targy) < 2)
	{
		with (wateringcanmarker)
		{
			drop();
		}
		state = ""watering"";
		con = 0;
		timer = 0;
	}
}
depth = 100000 - ((y * 10) + 50);
floatrate = lerp(0, 6, clamp(fakey / 2 / yheight / 2, 0, 1));
");

Apply("gml_Object_obj_dog_hanging_Create_0", @"event_inherited();
t = 0;
depth = 2120;
entity_gravity = 1.25 / (global.fps_scale * global.fps_scale);
default_gravity = 1.25 / (global.fps_scale * global.fps_scale);
is_platform_mode = false;
platform_mode_target = -4;
platform_mode_offset = [0, 0];
platform_mode_timer = 0;

turn_into_platform = function(arg0, arg1, arg2)
{
	is_platform_mode = 1;
	platform_valid = false;
	hspeed = 0;
	image_alpha = 0;
	gravity = entity_gravity;
	platform_mode_timer = 0;
	platform_mode_target = arg0;
	platform_mode_offset[0] = arg1;
	platform_mode_offset[1] = arg2;
	physics = false;
};

drop_off_platform_mode = function(arg0)
{
	if (is_platform_mode || !scr_onscreen_tolerance(self, 120))
	{
		is_platform_mode = 0;
		platform_valid = false;
		physics = true;
		entity_gravity = default_gravity;
		gravity = entity_gravity;
		if (arg0)
		{
			image_alpha = 0;
			scr_lerpvar(""image_alpha"", -1, 1, 30);
		}
	}
};

defaultdepth = depth;
highlighted = false;
back_marker = -4;
image_speed = 0.25 / global.fps_scale;
platform_valid = false;
__splats = false;

ralsei_fall_down = function(arg0)
{
	if (is_platform_mode < 3)
	{
		drop_off_platform_mode(true);
		exit;
	}
	force_animation(8099);
	__splats = arg0;
	custom_behaviour(function()
	{
		hspeed = 0;
		vspeed = 0;
		platform_valid = true;
	}, 15, function()
	{
		custom_behaviour(function()
		{
			platform_valid = true;
			var list = ds_list_create();
			instance_place_list(x, y, 81, list, false);
			for (var i = 0; i < ds_list_size(list); i++)
			{
				var w = ds_list_find_value(list, i);
				if ((w.winddirection % 180) != 90)
				{
					motion_add(w.winddirection, (w.strength * (abs(vspeed) / 15)) / global.fps_scale);
				}
				else
				{
					vspeed = max(-2 / global.fps_scale, vspeed - (2 / (global.fps_scale * global.fps_scale)));
				}
			}
			ds_list_destroy(list);
			vspeed = min(vspeed + (0.5 / (global.fps_scale * global.fps_scale)), 15 / global.fps_scale);
		}, function()
		{
			return grounded;
		}, __splats ? function()
		{
			snd_play(snd_splat);
			force_animation(4440);
			custom_behaviour(function()
			{
				platform_valid = false;
				hspeed = 0;
				vspeed = 0;
			}, 60);
		} : function()
		{
			force_animation(1829);
			custom_behaviour(function()
			{
				platform_valid = true;
				hspeed = 0;
				vspeed = 0;
			}, -1);
		});
	});
};

image_alpha = 0;
platform = instance_create(-999, 0, obj_plat_movingplat);
platform.image_xscale = 2;
platform.movetype = -1;
platform.visible = false;
platform.image_yscale = 2;
platform_mode_target = -4;
platform_mode_offset = [0, 0];
platform_mode_timer = 0;
");

Apply("gml_Object_obj_dog_hanging_Step_0", @"event_inherited();
with (obj_plat_player)
{
	if (targetmode)
	{
		exit;
	}
}
t += (1 / global.fps_scale);
if (is_platform_mode)
{
	platform_mode_timer += (1 / global.fps_scale);
	if (is_platform_mode == 1)
	{
		if (platform_mode_timer == 8)
		{
			image_alpha = 0;
			is_platform_mode = 2;
			platform_mode_timer = 0;
			x = platform_mode_target.x + platform_mode_target.hang_xoffset;
			y = platform_mode_target.y + platform_mode_target.hang_yoffset + 10;
			vspeed = 0;
		}
	}
	else if (is_platform_mode == 2)
	{
		x = platform_mode_target.x + platform_mode_target.hang_xoffset;
		vspeed += (0.2 / (global.fps_scale * global.fps_scale));
		gravity = 1 / (global.fps_scale * global.fps_scale);
		image_alpha += (0.1 / global.fps_scale);
		if (y >= (platform_mode_target.y + platform_mode_target.hang_yoffset + 60))
		{
			y = platform_mode_target.y + platform_mode_target.hang_yoffset + 60;
			image_alpha = 1;
			is_platform_mode = 3;
			forced_anim = true;
			vspeed = 0;
			entity_gravity = 0;
			gravity = 0;
			snd_play(snd_grab);
			back_marker = scr_dark_marker(x, y + 10, spr_plat_ralsei_hanging_back);
			back_marker.depth = depth + 1250;
		}
	}
	if (is_platform_mode == 3)
	{
		x = platform_mode_target.x + platform_mode_target.hang_xoffset;
		y = platform_mode_target.y + platform_mode_target.hang_yoffset + 60;
		image_xscale = 2;
		image_speed = 0;
		image_index = 0;
		vspeed = 0;
		platform.mask_index = platform.sprite_index;
	}
	if (!global.pause_plat && global.interact == 0 && is_platform_mode == 3 && instance_exists(obj_plat_player))
	{
		if (obj_plat_player.ground == platform)
		{
			is_platform_mode = 3.1;
			global.start_in_platmode = -1;
			snd_volume(global.currentsong[1], 0, 1);
			with (obj_plat_camera)
			{
				cutscene = true;
			}
			global.interact = 1;
			with (obj_plat_game)
			{
				paused = true;
			}
			snd_play(snd_pombark);
			t = 0;
		}
	}
	if (is_platform_mode == 3.1)
	{
		with (obj_plat_game)
		{
			paused = true;
		}
	}
	if (is_platform_mode == 3.1 && t == 90)
	{
		is_platform_mode = 4;
		vspeed = -1 / global.fps_scale;
		x = obj_plat_player.x;
		y = obj_plat_player.bbox_bottom;
		sprite_index = spr_dog_climb_front;
		image_speed = 0.125 / global.fps_scale;
		t = 0;
		max_fallspeed = 99 / global.fps_scale;
		with (obj_plat_player)
		{
			dogjoke = true;
			global.pause_plat = true;
			state = 1;
			hspeed = 0;
		}
		with (back_marker)
		{
			instance_destroy();
		}
	}
	if (is_platform_mode == 4)
	{
		if (y < (obj_plat_player.bbox_top - 20))
		{
			vspeed = 0;
			sprite_index = spr_dog_walk;
			image_speed = 0;
			is_platform_mode = 5;
			t = 0;
		}
	}
	if (is_platform_mode == 5)
	{
		if (t == 20)
		{
			image_speed = 1 / global.fps_scale;
		}
		if (t == 40)
		{
			hspeed = -13 / global.fps_scale;
			snd_play(snd_pombark);
			gravity = 1 / (global.fps_scale * global.fps_scale);
			vspeed = -20 / global.fps_scale;
			paused_dir = direction;
			paused_spd = speed;
			paused_spr = sprite_index;
			paused_img = image_index;
			paused_imgspd = image_speed;
			entity_gravity = gravity;
			with (obj_plat_game)
			{
				paused = false;
			}
			snd_play(snd_whack_absurdlyloud, 0.2, 1);
			snd_play(snd_glove_launch);
			scr_plat_vfx(3359);
			scr_plat_vfx(352).image_angle = 270;
			with (obj_plat_player)
			{
				vspeed = 20 / global.fps_scale;
				ground = -4;
				grounded = false;
				physics = false;
				entity_gravity = 20 / (global.fps_scale * global.fps_scale);
				y += 2;
				state = 0;
				max_fallspeed = 40 / global.fps_scale;
				dogjoke = 2;
				global.interact = 1;
			}
			snd_play(snd_fall);
		}
		if (obj_plat_player.y > (cameray() + 700))
		{
			is_platform_mode = 6;
			with (instance_create(obj_plat_player.x, cameray() + cameraheight() + 60, obj_animation))
			{
				sprite_index = spr_realisticexplosion;
				image_speed = 1 / global.fps_scale;
				image_xscale = 6;
				image_yscale = 8;
				snd_play(snd_badexplosion);
			}
			t = 0;
		}
	}
	else if (is_platform_mode == 6)
	{
		if (t >= 20)
		{
			with (obj_plat_player)
			{
				fallen_in_pit = 1;
				dogjoke = false;
				state = 0;
			}
			with (obj_dw_dogplatforming)
			{
				set_trolled();
			}
			instance_destroy();
		}
	}
}
if (is_platform_mode < 3)
{
	if (i_ex(back_marker))
	{
		with (back_marker)
		{
			instance_destroy();
		}
	}
}
if (is_platform_mode == 5 && t >= 10)
{
	platform.mask_index = spr_plat_blankmask;
}
else if (is_platform_mode >= 3)
{
	if (instance_exists(platform))
	{
		platform.mask_index = platform.sprite_index;
		if (is_platform_mode == 3)
		{
			platform.x = x - (0.75 * platform.sprite_width);
			platform.y = y - 12;
		}
	}
}
else
{
	platform.mask_index = spr_plat_blankmask;
	platform.image_xscale = 1.5;
	platform.image_yscale = 2;
	platform.x = x - (0.75 * platform.sprite_width);
	platform.y = y - 12;
}
if (is_platform_mode > 1)
{
	physics = false;
}
else
{
	physics = true;
}
");

Apply("gml_Object_obj_dog_hanging_Step_1", @"if (visible_is_active && !visible)
{
	exit;
}
if (hitstop > 0 && !global.pause_plat)
{
	hitstop -= (1 / global.fps_scale);
}
var _paused = hitstop > 0;
if (!custom_paused && _paused)
{
	on_pause();
	paused = 0;
	custom_paused = true;
}
if (custom_paused && !_paused)
{
	on_unpause();
	custom_paused = false;
}
if (is_platform_mode > 3)
{
	exit;
}
if (!global.pause_plat)
{
	if (instance_exists(obj_plat_player))
	{
		depth = obj_plat_player.depth - 1000;
	}
	else
	{
		instance_destroy();
	}
}
");

Apply("gml_Object_obj_dojo_shaveeffect_Alarm_0", @"direction = point_direction(creator_x, creator_y, xstart, ystart);
speed = random_range(15, 18) / global.fps_scale;
friction = random_range(2, 3) / (global.fps_scale * global.fps_scale);
wait = false;
");

Apply("gml_Object_obj_dojo_shaveeffect_Create_0", @"creator = 1502;
creator_x = creator.x + (creator.sprite_width / 2);
creator_y = creator.y + (creator.sprite_height / 2);
depth = creator.depth - 1;
image_speed = 0;
start_color = #283F64;
image_blend = start_color;
end_speed = random_range(0.1, 0.2) / global.fps_scale;
sparkle_timer = 0;
image_xscale = 2;
image_yscale = 2;
blend_timer = -0.6;
wait = true;
alarm[0] = round(1 * global.fps_scale);
");

Apply("gml_Object_obj_dojo_shaveeffect_Draw_0", @"draw_self();
if (blend_timer < 1)
{
	blend_timer += (0.25 / global.fps_scale);
}
if (blend_timer > 0)
{
	d3d_set_fog(true, c_white, 0, 1);
	draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, c_white, blend_timer);
	d3d_set_fog(false, c_black, 0, 0);
}
");

Apply("gml_Object_obj_dojo_shaveeffect_Step_0", @"if (wait)
{
	exit;
}
if (friction > 0 && speed <= end_speed)
{
	speed = end_speed;
	friction = 0;
}
if (friction == 0)
{
	sparkle_timer += (1 / global.fps_scale);
	if (sparkle_timer == 8)
	{
		image_speed = 1 / global.fps_scale;
	}
}
if (image_index == (image_number - 1))
{
	instance_destroy();
}
");

Apply("gml_Object_obj_dojo_spareenemy_Alarm_2", @"alarm[3] = round(20 * global.fps_scale);
alarm[1] = round(40 * global.fps_scale);
scr_mercyadd(myself, 100);
snd_play_pitch(snd_damage, 1.5);
image_speed = 0;
shaved = true;
global.flag[20] = 0;
sparedsprite = spr_npc_puzzlepiece_shaved_frown;
hurtsprite = spr_npc_puzzlepiece_shock2_shaved;
var _yy = y + ((siner % 1) * 2);
instance_create(x + 22, _yy + 32, obj_dojo_shaveeffect);
instance_create(x + 46, _yy + 32, obj_dojo_shaveeffect);
instance_create(x + 24, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 28, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 32, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 36, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 40, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 44, _yy + 34, obj_dojo_shaveeffect);
instance_create(x + 26, _yy + 36, obj_dojo_shaveeffect);
instance_create(x + 42, _yy + 36, obj_dojo_shaveeffect);
instance_create(x + 30, _yy + 38, obj_dojo_shaveeffect);
instance_create(x + 34, _yy + 38, obj_dojo_shaveeffect);
instance_create(x + 38, _yy + 38, obj_dojo_shaveeffect);
list = ds_list_create();
with (obj_dojo_shaveeffect)
{
	ds_list_add(other.list, self);
}
ds_list_shuffle(list);
for (i = 0; i < ds_list_size(list); i++)
{
	var _item = ds_list_find_value(list, i);
	_item.sparkle_timer = ((i * -1) + irandom(2)) - 5;
}
ds_list_destroy(list);
");

Apply("gml_Object_obj_dojo_spareenemy_Draw_0", @"if (global.flag[20] == 0)
{
	idlesprite = shaved ? spr_npc_puzzlepiece_shaved_frown : spr_npc_puzzlepiece;
}
if (global.flag[20] == 1)
{
	idlesprite = shaved ? spr_npc_puzzlepiece_shaved_happy : spr_npc_puzzlepiece_happy;
}
if (global.flag[20] == 2)
{
	idlesprite = shaved ? spr_npc_puzzlepiece_shock2_shaved : spr_npc_puzzlepiece_shock2;
}
if (global.flag[20] == 3)
{
	idlesprite = shaved ? spr_npc_puzzlepiece_shock1_shaved : spr_npc_puzzlepiece_shock1;
}
hurtsprite = shaved ? spr_npc_puzzlepiece_shock2_shaved : spr_npc_puzzlepiece_shock2;
if (state == 3)
{
	scr_enemyhurt_tired_after_damage(0.5);
	hurttimer -= (1 / global.fps_scale);
	if (hurttimer < 0)
	{
		state = 0;
	}
	else
	{
		if (global.monster[myself] == 0)
		{
			defeatanim = instance_create(x, y, obj_launchanim);
			defeatanim.sprite_index = sprite_index;
			defeatanim.sprite_index = hurtsprite;
			defeatanim.image_index = 0;
			defeatanim.image_xscale = image_xscale;
			defeatanim.image_yscale = image_yscale;
			instance_destroy();
		}
		hurtshake += (1 / global.fps_scale);
		if (hurtshake >= 2)
		{
			if (shakex > 0)
			{
				shakex -= 1;
			}
			if (shakex < 0)
			{
				shakex += 1;
			}
			shakex = -shakex;
			hurtshake = 0;
		}
		draw_sprite_ext(hurtsprite, 0, x + shakex + hurtspriteoffx, y + hurtspriteoffy, 2, 2, 0, image_blend, 1);
	}
}
if (custom_draw_example == 0)
{
	scr_enemy_drawidle_generic(image_speed);
}
else if (state == 0)
{
	if (flash == 1)
	{
		fsiner += (1 / global.fps_scale);
	}
	siner += (0.16666666666666666 / global.fps_scale);
	if (global.mercymod[myself] >= global.mercymax[myself])
	{
		draw_monster_body_part(sparedsprite, siner, x, y);
	}
	else
	{
		draw_monster_body_part(spr_diamondm_custom_body_example, 1, x + (sin(siner) * 2), y);
		draw_monster_body_part(spr_diamondm_custom_body_example, 0, x - (sin(siner) * 2), y + cos(siner));
	}
}
if (becomeflash == 0)
{
	flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_dojo_spareenemy_Step_0", @"if (ambushed == 0)
{
	scr_ambush();
	ambushed = 1;
}
if (global.monster[myself] == 1)
{
	if (scr_isphase(""enemytalk"") && talked == 0)
	{
		global.typer = 50;
		if (checkreact == true)
		{
			checkreact = false;
			msgsetloc(0, ""\\M2Boss^1! Don't listen to&that^1! That's the wrong&ACT!^1! The wrong ACT!^1!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_19_0"");
		}
		else if (sparecon == 1)
		{
			msgsetloc(0, ""Ohhhh, boss,&you're sparing&me!?/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_23_0"");
		}
		else if (pacifycon == 1)
		{
			msgsetloc(0, ""You did it, Boss!^1&If you can manage to SPARE enemies right away.../"", ""obj_dojo_spareenemy_slash_Step_0_gml_27_0"");
			msgnextloc(""Battles will go&a lot faster!&That's all!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_28_0"");
		}
		else if (battlestate == 0)
		{
			msgsetloc(0, ""Boss!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_32_0"");
			msgnextloc(""You can ACT&and SPARE on&the same turn!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_33_0"");
			msgnextloc(""If you know Kris's&ACT will give an&enemy 100`% mercy.../"", ""obj_dojo_spareenemy_slash_Step_0_gml_34_0"");
			msgnextloc(""SPARE them on&the same turn&with Susie&or Ralsei!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_35_0"");
			battlestate = 1;
		}
		else if (battlestate <= 1)
		{
			global.battlemsg[0] = stringsetloc(""* Jigsaw Joe looks vulnerable to ACTING and SPARING on the same turn."", ""obj_dojo_spareenemy_slash_Step_0_gml_40_0"");
			if (sparecon == -1)
			{
				if (beardcount < 99)
				{
					beardcount++;
				}
				msgsetsubloc(0, ""\\M2Ah!! It's my&~1 o'clock shadow!/%"", string(beardcount), ""obj_dojo_spareenemy_slash_Step_0_gml_44_0"");
				sparecon = 0;
			}
			else if (global.mercymod[myself] > 0)
			{
				scr_mercyadd(myself, -global.mercymod[myself]);
				shaved = false;
				msgsetloc(0, ""\\M1* Jigsaw Joe's stubble regrew!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_51_0"");
				scr_battletext_default();
				sparecon = -1;
			}
			else
			{
				msgsetloc(0, ""Boss^1!&You gotta ACT&and SPARE on&the same turn!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_56_0"");
			}
		}
		else if (battlestate == 2)
		{
			global.battlemsg[0] = stringsetloc(""* Jigsaw Joe looks like he could use a bedtime story."", ""obj_dojo_spareenemy_slash_Step_0_gml_60_0"");
			global.mercymod[myself] = 0;
			msgsetloc(0, ""\\M2WAIT A SECOND!!!^1&I got something else&to remind you of!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_63_0"");
			msgnextloc(""\\M0Boss!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_64_0"");
			msgnextloc(""It works the&same with making&an enemy TIRED!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_65_0"");
			msgnextloc(""If an ACT&will make an&enemy TIRED.../"", ""obj_dojo_spareenemy_slash_Step_0_gml_66_0"");
			if (global.tension >= 40)
			{
				msgnextloc(""Use Ralsei's PACIFY&right away!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_67_0"");
			}
			else
			{
				msgnextloc(""Use Ralsei's PACIFY&right away!/"", ""obj_dojo_spareenemy_slash_Step_0_gml_74_0"");
				msgnextloc(""Of course, PACIFY is MAGIC,&so you'll need TP./"", ""obj_dojo_spareenemy_slash_Step_0_gml_75_0"");
				msgnextloc(""Spend a turn&DEFENDING to gain TP&if you have to, boss!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_76_0"");
			}
			battlestate = 3;
			global.actactor[myself][1] = 2;
			global.actname[myself][1] = stringsetloc(""SleepyStory"", ""obj_dojo_spareenemy_slash_Step_0_gml_70_0"");
			global.actdesc[myself][1] = "" "";
			global.actsimul[myself][1] = 1;
		}
		else if (battlestate == 3)
		{
			if (global.monsterstatus[myself] == 1)
			{
				pacifycon = -1;
				global.monstercomment[myself] = stringsetloc("""", ""obj_dojo_spareenemy_slash_Step_0_gml_79_0"");
				global.monsterstatus[myself] = 0;
				image_speed *= 2;
				msgsetloc(0, ""* Jigsaw Joe drank coffee^1! Jigsaw Joe stopped being TIRED!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_82_0"");
				scr_battletext_default();
			}
			else
			{
				pacifycon = 0;
				if (global.tension < 40 && pacifycon != -2)
				{
					msgsetloc(0, ""Boss^1! If you don't&have the TP to use&PACIFY^1, DEFENDing&will give you TP!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_89_0"");
				}
				else
				{
					msgsetloc(0, ""Boss^1! You're putting me&to SLEEP^1! I mean, you&AREN'T^1! Make me TIRED&and PACIFY me, boss!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_91_0"");
				}
			}
		}
		else
		{
			msgsetloc(0, ""Boss!!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_95_0"");
		}
		if (sparecon != -1 && pacifycon != -1)
		{
			scr_enemyblcon(x - 10, y + 30, 10);
		}
		if (pacifycon == -1)
		{
			talked = -1;
		}
		else
		{
			talked = 1;
		}
		talktimer = 0;
	}
	if (talked == -1 && scr_isphase(""enemytalk""))
	{
		if (talktimer < 15)
		{
			talktimer += (1 / global.fps_scale);
		}
		else if (!instance_exists(obj_writer))
		{
			talked = 0;
		}
	}
	if (talked == 1 && scr_isphase(""enemytalk""))
	{
		rtimer = 0;
		if (talktimer < 15)
		{
			talktimer += (1 / global.fps_scale);
		}
		if (!instance_exists(obj_writer) && talktimer >= 15)
		{
			global.flag[20] = 0;
			if (sparecon == -1)
			{
				talked = 0;
				exit;
			}
			if (sparecon == 1)
			{
				sparecon = 0;
				scr_fakespare();
				battlestate = 2;
				fakespare = 1;
				alarm[0] = round(90 * global.fps_scale);
				talked = 0;
				global.mnfight = 8;
				global.mercymod[myself] = 0;
			}
			else if (pacifycon == 1)
			{
				scr_spareanim();
				scr_recruit();
				scr_monsterdefeat();
				instance_destroy();
				scr_mnendturn();
				with (obj_darkener)
				{
					darken = 0;
				}
			}
			else
			{
				with (obj_darkener)
				{
					darken = 0;
				}
				scr_mnendturn();
			}
		}
	}
	if (global.mnfight == 8)
	{
		exit;
	}
}
if (global.myfight == 3)
{
	xx = __view_get(e__VW.XView, 0);
	yy = __view_get(e__VW.YView, 0);
	if (acting == 1 && actcon == 0)
	{
		actcon = 1;
		msgsetloc(0, ""* JIGSAW JOE - Beat him up to earn his life savings!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_177_0"");
		checkreact = true;
		scr_battletext_default();
	}
	if (acting == 2 && actcon == 0 && battlestate < 2)
	{
		shavesprite = scr_act_charsprite(""kris"", spr_krisb_attackready, 0, 0);
		msgsetloc(0, ""* (You shaved Jigsaw Joe's stubble!)/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_187_0"");
		scr_battletext_default();
		actcon = 2;
	}
	if (acting == 2 && actcon == 0 && battlestate >= 2)
	{
		msgsetloc(0, ""* Susie told the enemy a bedtime story about beating them up!^1&* The enemy became TIRED!/%"", ""obj_dojo_spareenemy_slash_Step_0_gml_195_0"");
		image_speed /= 2;
		snd_play(snd_hypnosis);
		scr_battletext_default();
		actcon = 1;
		scr_monster_make_tired(myself);
	}
	if (acting == 1 && actconsus == 1)
	{
		msgsetloc(0, ""* Susie acted!/%"", ""obj_dojograzeenemy_slash_Step_0_gml_97_0"");
		scr_battletext_default();
		actcon = 1;
		actconsus = 0;
	}
	if (acting == 1 && actconral == 1)
	{
		msgsetloc(0, ""* Ralsei acted!/%"", ""obj_dojograzeenemy_slash_Step_0_gml_106_0"");
		scr_battletext_default();
		actcon = 1;
		actconral = 0;
	}
	if (actcon == 2 && !instance_exists(obj_writer))
	{
		actcon = 3;
		with (shavesprite)
		{
			sprite_index = spr_krisb_attack;
			scr_animate(0, 0, 1);
		}
		alarm[2] = round(20 * global.fps_scale);
		snd_play_pitch(snd_laz_c, 1.5);
		image_speed = 0;
		var _cut = instance_create(x + 34, y + 38, obj_animation);
		_cut.sprite_index = spr_attack_cut1;
		_cut.image_xscale = 0.25;
		_cut.image_yscale = 0.25;
		_cut.depth = depth - 1;
		_cut.image_speed = (1/3) / global.fps_scale;
	}
	if (actcon == 1 && !instance_exists(obj_writer))
	{
		scr_nextact();
	}
}

