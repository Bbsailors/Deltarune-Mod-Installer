Apply("gml_Object_obj_plat_hbx_Step_2", @"if (global.pause_plat)
{
	exit;
}
if (instance_exists(owner))
{
	x = owner.x;
	y = owner.y;
	if (owner.object_index == obj_plat_player)
	{
		if (!owner.attacking)
		{
			instance_destroy();
		}
		if (owner.hitstop > 0)
		{
			exit;
		}
	}
}
var skip_ids = {};
if (!ds_exists(collision_list, ds_type_list))
{
	collision_list = ds_list_create();
}
if (instance_place_list(x, y, 281, collision_list, false) > 0)
{
	var _playclang = false;
	var _playclash = false;
	scr_plat_hitstop_global(4);
	for (var i = 0; i < ds_list_size(collision_list); i++)
	{
		with (ds_list_find_value(collision_list, i))
		{
			if (parry && !_playclash)
			{
				var _pitch = 0.8;
				with (obj_plat_player)
				{
					_pitch += (parry_chain * 0.1);
					parry_chain++;
					parry_timer = 30;
				}
				snd_play(snd_weaponpull, 1, _pitch);
				_playclash = true;
			}
			else if (!parry && !_playclang)
			{
				_playclang = true;
				snd_play(snd_metal_hit_strong, 1, 1.7);
			}
			other.invalidated = other.invalidated || !protects_single_enemy;
			if (instance_exists(protects_single_enemy))
			{
				skip_ids[protects_single_enemy.id] = true;
			}
			on_collide(other);
			var angle = point_direction(x, y, other.x, other.y);
			if (parry)
			{
				var _player_hbx = other.is_player_hbx;
				with (instance_create(lerp(x, obj_plat_player.x, 0.5), lerp(y, obj_plat_player.y, 0.5), obj_vfx_parry))
				{
					image_angle = angle;
					if (_player_hbx)
					{
						image_blend = c_aqua;
					}
					else
					{
						image_blend = c_fuchsia;
					}
				}
			}
			else
			{
				with (instance_create(x, y, obj_animation))
				{
					sprite_index = spr_sparks;
					image_speed = 1 / global.fps_scale;
					image_blend = merge_color(c_yellow, c_white, 0.5);
					scr_darksize();
					image_angle = angle;
				}
			}
		}
	}
	ds_list_clear(collision_list);
}
if (!invalidated)
{
	if (instance_place_list(x, y, 322, collision_list, false) > 0)
	{
		for (var i = 0; i < ds_list_size(collision_list); i++)
		{
			if (instance_exists(ds_list_find_value(collision_list, i)))
			{
				if (array_length(skip_ids) > ds_list_find_value(collision_list, i).id && array_get(skip_ids, ds_list_find_value(collision_list, i).id))
				{
					lifetime = 0;
				}
				else
				{
					with (ds_list_find_value(collision_list, i))
					{
						get_hurt(other);
					}
				}
			}
		}
		ds_list_clear(collision_list);
	}
}
lifetime -= (1 / global.fps_scale);
if (lifetime <= 0 || invalidated)
{
	instance_destroy();
}
");

Apply("gml_Object_obj_plat_lantern_Create_0", @"event_inherited();
performs_culling_checks = true;
cull_buffer = 80;
lit = false;
image_speed = 0;
explodetimer = 0;
depthset = 0;
pre_existing_contents = -4;
glow_surface = -4;
glowcolor1 = 65535;
glowcolor2 = 4235519;
scr_plat_set_group(UnknownEnum.Value_0, true);
minigame = 0;
angle_offset = 0;
on_destroy = -4;
parallax_depth = 0;
if (is_marker)
{
	visible = 0;
}
timer_inc = 0;
flasher = -4;
x_timer = 0;
y_timer = 0;
z_timer = 0;
parallax_z = 0;

create_contents = function()
{
	if (content_type == 1)
	{
		scr_plat_makecoins(x, y, -content_modifier, 90, 30, 6, 4, depth);
	}
	else if (content_type == 2)
	{
		if (pre_existing_contents != -4)
		{
			var marker = instance_create(x, y, obj_marker_fancy);
			with (marker)
			{
				scr_darksize();
				sprite_index = spr_pxwhite;
				scr_lerpvar(""y"", y, other.pre_existing_contents.y, 15, 1, ""in"");
				
				draw_func = function()
				{
					var ys = array_get(scr_platswap_yscale(), 1) * 2;
					var shinealpha = 0;
					var shinetimer = 0;
				};
				
				scr_doom(self, 15);
			}
			with (pre_existing_contents)
			{
				scr_delay_var(""visible"", 1, 15);
			}
		}
	}
	if (content_type == 3)
	{
	}
	if (content_type == 4)
	{
		with (instance_create_depth(x, y, depth, obj_plat_npc))
		{
			waiting_initialization = other.content_modifier;
		}
	}
	if (content_type == 5)
	{
		repeat (content_modifier)
		{
			with (instance_create_depth(x, y, depth, obj_plat_coin))
			{
				friction = 0.5 / (global.fps_scale * global.fps_scale);
				is_pink = true;
				direction = random_range(0, 360);
				speed = random_range(6, 12) / global.fps_scale;
				gravity = 1 / (global.fps_scale * global.fps_scale);
				flag = other.flag;
				flagbit = other.flagbit;
				collect_cooldown = 10;
				homing_on_player = true;
			}
		}
	}
};

if (content_type == 2)
{
	var li = ds_list_create();
	collision_rectangle_list(bbox_left, bbox_top, bbox_right, room_height, obj_platswap_statue, false, true, li, false);
	for (var i = 0; i < ds_list_size(li); i++)
	{
		pre_existing_contents = ds_list_find_value(li, i);
		break;
	}
	ds_list_destroy(li);
	if (pre_existing_contents != -4)
	{
		pre_existing_contents.visible = 0;
	}
}

destroy_self = function()
{
	for (var i = 0; i < 16; i++)
	{
		var xx = x;
		var yy = y;
		var paperscraps = instance_create_depth(xx, yy, depth + 1, obj_marker_fancy);
		with (paperscraps)
		{
			sprite_index = choose(spr_plat_paperscraps_1, spr_plat_paperscraps_2, spr_plat_paperscraps_3, spr_plat_paperscraps_4, spr_plat_paperscraps_5);
			image_speed = random_range(0.2, 0.25) / global.fps_scale;
			direction = random_range(0, 360);
			speed = random_range(6, 16) / global.fps_scale;
			image_blend = other.glowcolor2;
			
			step_func = function()
			{
				if (!global.pause_plat)
				{
					hspeed *= power(0.92, 1 / global.fps_scale);
					if (abs(hspeed) < (6 / global.fps_scale))
					{
						vspeed = min(vspeed + (0.2 / (global.fps_scale * global.fps_scale)), 2 / global.fps_scale);
					}
				}
			};
			
			var doomtime = random_range(60, 90);
			scr_lerpvar(""image_alpha"", 4, 0, doomtime);
			scr_doom(self, doomtime);
		}
	}
	if (explodetimer <= 0)
	{
		create_contents();
	}
	if (is_method(on_destroy))
	{
		on_destroy();
	}
	if (flag > 0 && content_type != 5)
	{
		scr_flag_set_ext(flag, flagbit, 1);
	}
	instance_destroy();
};

if (special == 1)
{
	image_xscale = 1;
	image_yscale = 1;
}
if (content_type == 5)
{
	sprite_index = spr_plat_lantern_pink;
	glowcolor1 = 16711935;
	glowcolor2 = 8388736;
}
if (flag > 0 && scr_flag_get_ext(flag, flagbit))
{
	if (content_type == 4)
	{
		with (instance_create_depth(x, y, depth, obj_plat_npc))
		{
			waiting_initialization = other.content_modifier + 1;
		}
	}
	instance_destroy();
}

enum UnknownEnum
{
	Value_0
}
");

