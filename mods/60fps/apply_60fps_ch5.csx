with (lancer_marker)
{
	if (tick >= _lancerspinduration)
	{
		spinning = false;
	}
	if (spinning == true)
	{
		var _percent = animcurve_channel_evaluate(animcurve_get_channel(3, ""lancer_spinspeed""), tick / _lancerspinduration);
		var _spincount = 4;
		image_xscale = cos(_percent * _spincount * 2 * pi) * 2;
		if (tick <= 20)
		{
			y = 1160 - (50 * sin((tick / 20) * pi));
		}
		tick += (1 / global.fps_scale);
	}
	if (sprite_index == spr_lancer_partyhat_streamer_unroll && image_index > (image_number - 1))
	{
		sprite_index = spr_lancer_partyhat_streamer_loop;
	}
}
