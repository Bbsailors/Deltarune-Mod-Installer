		{
			timer = 0;
			bounce = 1;
			bouncethresh = irandom_range(45, 50);
		}
	};
	
	end_step_func = function()
	{
		if (y > ystart)
		{
			y = ystart;
			vspeed = -vspeed * 0.8;
			if (bounce == 1)
			{
				bounce = 0;
				vspeed = -12 / global.fps_scale;
