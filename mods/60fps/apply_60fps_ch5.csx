");

Apply("gml_Object_obj_towery_orbiter_Step_0", @"if (!init)
{
	xoff = xoffset[hero];
	yoff = yoffset[hero];
	var _final_arc = ((finalx[hero] + xoffset[hero]) - 320) / 300;
	final_rot = 180 - scr_loop(radtodeg(arcsin(_final_arc)), 360);
	var _fz = (cos(degtorad(final_rot)) * 30) + 100;
	final_height = (((finaly[hero] + yoffset[hero]) - 240) / (100 / _fz)) + 240;
	init = true;
	riser = hero * 10;
}
var _xoff = (xoffset[hero] * image_xscale) / 2;
var _yoff = (yoffset[hero] * image_yscale) / 2;
var _tower = 921;
var _xx = (sin(degtorad(rotation)) * distance) + _tower.x;
var _yy = height + (sin(riser * 0.1) * 6) + cameray() + 240;
var _zz = (cos(degtorad(rotation)) * 30) + 100;
var _towerscroll = 4000;
faux_depth = _zz;
distance = 200;
var _os = 17 - (hero * 1);
depth = _tower.depth - 100;
var _dur = duration;
var _zoff = 0.5;
if (con == 0)
{
	rotation -= (5 / global.fps_scale);
}
else if (con >= 1)
{
	var _prog = clamp(prog, 0, _dur);
	var _ease = scr_ease_out(_prog / _dur, 4);
	var _heightease = scr_ease_out(clamp01(prog / (_dur + _os)), 2);
	if (hero == 0 && prog == 41)
	{
		with (_tower)
		{
			scr_lerpvar(""spin"", 4, 1, 60, 2, ""out"");
		}
	}
	if (con == 1)
	{
		if (hero == 0)
		{
			rotation = 180;
		}
		else
		{
			rotation = 60 + (hero * 80);
		}
	}
	else
	{
		var _start = quick ? 180 : 540;
		rotation = min(1000, lerp((hero * 60) + _start, final_rot, scr_ease_out(_prog / _dur, 2)));
		rotation -= lerp(16, 0, scr_ease_in(clamp01((prog - _dur) / _os), 2));
	}
	height = lerp((_towerscroll * 1.025) - -_tower.height, (finaly[hero] + yoffset[hero]) - 240, _ease);
	distance = lerp(150, 300, _prog / _dur);
	if (con == 1 && room == room_dw_fcastle_flowery)
	{
		height += 400;
	}
	if (con == 2 && prog == ((_dur + _os) - 1))
	{
		_yoff = (yoffset[hero] * image_yscale) / 2;
		var _burst = instance_create(x, y + _yoff, obj_petal_burst);
		_burst.depth = depth + 100;
		_burst.direction = 170;
		if (hero == 0)
		{
			_burst.sprites = [7152, 5304, 276];
		}
		if (hero == 1)
		{
			_burst.sprites = [6614, 7791, 5167];
		}
		if (hero == 2)
		{
			_burst.sprites = [2620, 4246, 4560];
		}
		_burst.count = 10;
		_burst.strength = 0.5;
	}
	if (con == 2 && prog < (_dur + _os))
	{
		prog += (1 / global.fps_scale);
	}
	if (hero == 0 && prog == _dur)
	{
		with (obj_towery_particle)
		{
			lifetime = 0;
		}
	}
	var _enddur = _dur - 30;
	if (_prog > _enddur)
	{
		var _progease = scr_ease_out((_prog - _enddur) / 30, 2);
		_zz = lerp(_zz, 100, _progease);
		_zoff = lerp(_zoff, 0, _progease);
	}
}
var _pos3 = scr_perspective_scale_ext(_xx, _yy, _zz, _tower.x, cameray() + 240);
var _scale = _pos3.z * 2;
_scale = round_to_multiple(_scale, 0.05) - _zoff;
image_xscale = _scale;
image_yscale = _scale;
truex = _xx;
truey = _yy;
x = _pos3.x;
y = _pos3.y;
if (cos(degtorad(rotation - 20)) > 0)
{
	image_xscale *= -1;
}
depth = (obj_flowery_towery.depth + ((1 - _pos3.z) * 50)) - (hero * 4);
riser += (1 / global.fps_scale);
if (timer > round(clamp01((prog - 100) / (_dur + _os)) * 10))
{
	timer = 0;
	var _px = ((-25 + irandom(50)) * image_xscale) / 2;
	var _py = (yoffset[hero] * image_yscale) / 2;
	flower_particle = instance_create_depth(x + _px, y + _py, depth + 1, obj_particle_effect);
	flower_particle.sprite_index = spr_sparestar_anim;
	flower_particle.image_speed = choose(1/3, 0.25, 0.2) / 2 / global.fps_scale;
	flower_particle.image_xscale = image_xscale;
	flower_particle.image_yscale = image_yscale;
	flower_particle.vspeed = image_yscale / global.fps_scale;
	flower_particle.image_index = 3;
	flower_particle.gravity_direction = 270;
	if (hero == 0)
	{
		flower_particle.image_blend = krisflowercolor;
	}
	if (hero == 1)
	{
		flower_particle.image_blend = susieflowercolor;
	}
	if (hero == 2)
	{
		flower_particle.image_blend = ralseiflowercolor;
	}
	var _startcol = flower_particle.image_blend;
	var _newcol = make_color_hsv(scr_loop(color_timer * 10, 255), 128, 255);
	scr_lerpcol_instance(flower_particle, ""image_blend"", _startcol, _newcol, 30);
	with (flower_particle)
	{
		scr_script_delayed(scr_lerp_var_instance, (3 / (image_speed * global.fps_scale)) - 9, id, ""image_alpha"", 1, 0, 9);
	}
	with (flower_particle)
	{
		scr_script_delayed(instance_destroy, 3 / (image_speed * global.fps_scale));
	}
}
else
{
	timer += (1 / global.fps_scale);
}
color_timer += (1 / global.fps_scale);
if (hero == 0)
{
