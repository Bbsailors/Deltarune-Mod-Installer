	c_actortocaterpillar();
	c_terminatekillactors();
}
if (con == 50 && !i_ex(obj_cutscene_master))
{
	global.interact = 0;
	global.facing = 0;
	con = 0;
	global.flag[320] = 1;
	with (obj_npc_king)
	{
		visible = 1;
	}
	instance_destroy();
}
if (i_ex(ki_actor))
{
	if (king_drink)
	{
		with (ki_actor)
		{
			if (x < 1380)
			{
				if (hspeed < (3 / global.fps_scale))
				{
					hspeed = 3 / global.fps_scale;
				}
				hspeed += (1 / (global.fps_scale * global.fps_scale));
				if (y >= (ystart - 60))
				{
					y -= (4 / global.fps_scale);
				}
			}
			else
			{
				hspeed = 0;
			}
		}
	}
	else
	{
		var xpos = obj_npc_king.xstart;
		var ypos = obj_npc_king.ystart;
		with (ki_actor)
		{
			if (x > xpos)
			{
				if (y <= ypos)
				{
					y = clamp(y + (4 / global.fps_scale), 0, ypos);
				}
				hspeed -= (1 / (global.fps_scale * global.fps_scale));
			}
			else
			{
				hspeed = 0;
				x = xpos;
			}
		}
	}
}
");

Apply("gml_Object_obj_room_garden_video_Draw_0", @"if (global.is_console)
{
	exit;
}
if (!_video_enabled)
{
	exit;
}
var _video_data = video_draw();
var _video_status = _video_data[0];
if (_video_status == 0)
{
	texture_set_interpolation(true);
	switch (video_get_format())
	{
		case 0:
			_vid_surface = _video_data[1];
			draw_surface_ext(_vid_surface, 0, 60, 0.5, 0.5, 0, c_white, 1);
			break;
	}
	texture_set_interpolation(false);
}
if (!_paused)
{
	exit;
}
if (_screenshot == -4)
{
	var __sc_tmp = surface_create(640, 480);
	if (surface_exists(__sc_tmp))
	{
		surface_set_target(__sc_tmp);
		gpu_set_blendenable(false);
		draw_surface_ext(application_surface, 0, 0, 640 / surface_get_width(application_surface), 480 / surface_get_height(application_surface), 0, c_white, 1);
		gpu_set_blendenable(true);
		surface_reset_target();
		_screenshot = sprite_create_from_surface(__sc_tmp, 0, 0, view_wport[0], view_hport[0], false, true, 0, 0);
		surface_free(__sc_tmp);
	}
	else
	{
		_screenshot = sprite_create_from_surface(application_surface, 0, 0, view_wport[0], view_hport[0], false, true, 0, 0);
	}
}
draw_enable_alphablend(false);
draw_sprite_ext(_screenshot, 0, camerax(), cameray(), 1, 1, 0, c_white, 1);
draw_enable_alphablend(true);
");

Apply("gml_Object_obj_room_garden_video_Step_0", @"if (scr_debug())
{
	if (keyboard_check_pressed(vk_space))
	{
		_status = video_get_status();
		if (_status == 2)
		{
			video_pause();
			audio_pause_sound(_mus_file[1]);
		}
		else if (_status == 3)
		{
			video_resume();
			audio_resume_sound(_mus_file[1]);
		}
	}
	if (!skip_video)
	{
		if (button2_h() || button3_h())
		{
			skip_timer += (1 / global.fps_scale);
			if (skip_timer >= 30)
			{
				skip_video = true;
				video_close();
				scr_set_video_ini_value(0);
				global.tempflag[50] = 1;
				room_goto(room_dw_garden_meetflowery);
			}
		}
		else if (skip_timer > 0)
		{
			skip_timer = 0;
		}
	}
}
if (_paused)
{
	exit;
}
var _status = video_get_status();
if (_status == 2)
{
	_timer += (1 / global.fps_scale);
	var video_pos = video_get_position() / video_get_duration();
	var mus_pos = audio_sound_get_track_position(_mus_file[1]) / audio_sound_length(_mus_file[1]);
	var mus_offset = abs((round(video_pos * 100) / 100) - (round(mus_pos * 100) / 100));
	if (mus_offset >= 0.03)
	{
		audio_sound_set_track_position(_mus_file[1], video_pos * audio_sound_length(_mus_file[1]));
	}
	if (_timer == 830)
	{
		if (global.is_console)
		{
			scr_lerpvar(""_overlay_alpha"", 0, 1, 120);
		}
		else
		{
			with (_blackall)
			{
				scr_lerpvar(""image_alpha"", 0, 1, 100);
			}
		}
	}
	if (_timer == 890)
	{
		_paused = true;
		video_pause();
		scr_script_delayed(video_resume, 90);
	}
}
");

