			instance_destroy();
		}
		with (shearies[1])
		{
			instance_destroy();
		}
	}
	if (instance_exists(obj_mainchara))
	{
		if (!obj_mainchara.holding_item)
		{
			with (obj_wateringcan_pedestal)
			{
				if (helditem != -4)
				{
					if ((obj_mainchara.y > 560 && y < 560) || (obj_mainchara.y < 560 && y > 560))
					{
						with (helditem)
						{
							instance_destroy();
						}
						helditem = -4;
						frozen = false;
					}
				}
			}
		}
	}
}
for (var i = 0; i < array_length(shearies); i++)
{
	if (shearies[i] != -4)
	{
		with (shearies[i])
		{
			if (sprite_index == spr_scissordancer)
			{
				dancetimer += (1 / global.fps_scale);
				if (dancetimer >= 30 && dancetimer <= 72)
				{
					image_index += (0.25 / global.fps_scale);
				}
				if (dancetimer >= 115 && dancetimer <= 157)
				{
					image_index -= (0.25 / global.fps_scale);
				}
				if (dancetimer >= 166)
				{
					dancetimer = 0;
				}
			}
			else if (sprite_index == spr_scissordancer_spinning && sinertimer >= 0)
			{
				sinertimer += ((1/15) / global.fps_scale);
				var ii = floor(image_index);
				image_index += (0.5 / global.fps_scale);
				x = xx + (sin(sinertimer) * 70);
				y = yy + (cos(sinertimer) * 20);
				scr_depth(id, -10);
				if ((floor(image_index) % 2) == 0 && (ii % 2) != 0)
				{
					repeat (1)
					{
						with (instance_create(lerp(x + random_range(-10, 10), xx, 0.5), y + random_range(30, 50), obj_marker))
						{
							sprite_index = choose(spr_bush_leaf, spr_bush_leaf2, spr_bush_leaf3);
							depth = other.depth - 1;
							image_speed = 0.5 / global.fps_scale;
							hspeed = random_range(-5, 5) / global.fps_scale;
							vspeed = random_range(-5, -2) / global.fps_scale;
							friction = 0.5 / (global.fps_scale * global.fps_scale);
							gravity = 0.5 / (global.fps_scale * global.fps_scale);
							scr_darksize();
							scr_lerpvar(""image_alpha"", 1, 0, 60);
							scr_doom(self, 60);
						}
					}
				}
			}
		}
	}
}
