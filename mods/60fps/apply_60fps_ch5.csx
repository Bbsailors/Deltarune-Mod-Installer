		scr_anyface_next(""aqua"", 0);
		msgnextsubloc(""~1* Uee hee hee!^1! I can feel the sky!!/%"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_knifewall_generator_slash_Step_0_gml_90_0"");
		d_make_plat(0, 5, undefined, undefined, 1);
	}
	if (timer >= 30)
