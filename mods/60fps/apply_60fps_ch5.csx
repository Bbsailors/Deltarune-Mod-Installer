				catmarker[i].x = lerp(catmarker[i].x, ralsei.x + myxoff, scr_fps_lerp_rate(lerpstrength));
				catmarker[i].y = (ralsei.y + myyoff) - abs(sin(catsiner[i] / 40) * 8);
				catmarker[i].depth = ralsei.depth + (i * 4);
