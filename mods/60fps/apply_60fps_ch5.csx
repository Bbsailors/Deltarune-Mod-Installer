Apply("gml_Object_obj_dw_fcastle_sandtrap_shijoke_Step_0", @"depth = 100000 - ((y + 128) * 10);
animindex += (1 / global.fps_scale);
if (con == 0)
{
	var trig = false;
	var caught = collision_ellipse((x + 43) - w, (y + 119) - h, x + 43 + w, y + 119 + h, obj_mainchara, true, true);
	if (instance_exists(caught))
	{
		trig = true;
	}
	if (trig)
	{
		con = 1;
	}
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		var loc = 
		{
			x: x - 40,
			y: y - 10
		};
		if (scarecrow)
		{
			loc = 
			{
				x: x - 20,
				y: y - 36
			};
		}
		with (instance_create(loc.x, loc.y, obj_animation))
		{
			sprite_index = spr_poof;
			image_xscale = 2;
			image_yscale = 2;
			image_speed = 0.5 / global.fps_scale;
			depth = other.depth - 1;
		}
		snd_stop(snd_wing);
		snd_play(snd_wing);
		snd_play(snd_japanese_yo_hit1, 0.5);
	}
	if (timer == 4)
	{
		if (scarecrow)
		{
			with (instance_create(x, y, obj_scarecrow_overworld))
			{
			}
			con = 40;
			timer = 0;
		}
		else
		{
			draw_state = ""appearing"";
		}
	}
	if (timer == 18)
	{
		con = 2;
		timer = 0;
		draw_state = ""sinking"";
		snd_play(snd_grab);
		snd_play(snd_scream, 0.7, 1.2);
	}
}
if (con == 2)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		fakey = 0;
		scr_lerpvar(""fakey"", fakey, endfakey, 30, 1, ""out"");
		snd_play(snd_wing, undefined, 0.95);
	}
	if (timer == 6)
	{
		snd_play(snd_wing, undefined, 0.93);
		doshake(8);
	}
	if (timer == 12)
	{
		snd_play(snd_wing, undefined, 0.91);
		doshake(6);
	}
	if (timer == 24)
	{
		snd_play(snd_wing, undefined, 0.89);
		doshake(4);
		con = 3;
		myint = instance_create(x, y, obj_trigger_interact);
		with (myint)
		{
			scr_sizeexact(50, 42);
			setxy(x + 18, y + 103);
			depth = 0;
		}
	}
}
if (con == 3)
{
	with (myint)
	{
		if (myinteract == 3)
		{
			global.interact = 1;
			myinteract = 4;
			scr_speaker(""no_name"");
			msgsetloc(0, ""* (Won't somebody please help me?)/%"", ""obj_dw_fcastle_sandtrap_shijoke_slash_Step_0_gml_104_0"");
			d_make();
		}
		if (myinteract == 4 && !d_ex())
		{
			global.interact = 0;
			myinteract = 0;
		}
	}
}
if (con == 40)
{
	timer += (1 / global.fps_scale);
	if (timer == 30)
	{
		var loc = -4;
		with (obj_scarecrow_overworld)
		{
			loc = id;
		}
		if (!instance_exists(loc))
		{
			instance_destroy();
			exit;
		}
		with (instance_create(loc.x - 80, loc.y - 80, obj_talkbubble))
		{
			lifetime = 180;
			daddy = loc;
			text = stringsetloc(""I don't know#how I got here."", ""obj_dw_fcastle_sandtrap_shijoke_slash_Step_0_gml_134_0"");
			siner = 0;
			var memfont = draw_get_font();
			if (global.lang == ""ja"")
			{
				draw_set_font(fnt_ja_dotumche);
			}
			else
			{
				draw_set_font(fnt_dotumche);
			}
			textwidth = string_width(text);
			locationInit = false;
			textborder = 0;
			stayonscreen = false;
			
			step_func = function()
			{
				if (!instance_exists(daddy))
				{
					instance_destroy();
					exit;
				}
				var lerpspeed = scr_fps_lerp_rate(0.2);
				var sourcepoint = 
				{
					x: daddy.x + 54,
					y: daddy.y + 52
				};
				var pd = point_direction(x, y, sourcepoint.x, sourcepoint.y);
				tx = lerp(tx, sourcepoint.x - lengthdir_x(40, pd), lerpspeed);
				ty = lerp(ty, sourcepoint.y - lengthdir_y(40, pd), lerpspeed);
				var ideal = 
				{
					x: daddy.x - 60,
					y: daddy.y - 6
				};
				if (daddy.facing == 1)
				{
					ideal = 
					{
						x: daddy.x + 158,
						y: daddy.y - 6
					};
				}
				var screenborder = 20;
				var cx = camerax();
				var cy = cameray();
				ideal.x = clamp(ideal.x, cx + screenborder + (textwidth / 2), (cx + 640) - screenborder - (textwidth / 2));
				ideal.y = clamp(ideal.y, cy + screenborder, (cy + 480) - (screenborder * 6));
				x = lerp(x, ideal.x, lerpspeed);
				y = lerp(y, ideal.y, lerpspeed);
				if (locationInit == false)
				{
					show_debug_message_concat(""tx="", tx, ""ty="", ty);
					setxy(ideal.x, ideal.y);
					locationInit = true;
					sourcepoint = 
					{
						x: daddy.x + 54,
						y: daddy.y + 52
					};
					pd = point_direction(x, y, sourcepoint.x, sourcepoint.y);
					tx = lerp(tx, sourcepoint.x - lengthdir_x(40, pd), 1);
					ty = lerp(ty, sourcepoint.y - lengthdir_y(40, pd), 1);
				}
				var kildborder = 60;
				var trigd = false;
				if (sourcepoint.x > (cx + 640 + kildborder) || sourcepoint.x < (cx - kildborder) || sourcepoint.y > (cy + 480 + kildborder) || sourcepoint.y < (cy - kildborder))
				{
					trigd = true;
				}
				if (trigd)
				{
					show_debug_message_concat(""kil'd"");
					instance_destroy();
				}
			};
		}
	}
}
");

