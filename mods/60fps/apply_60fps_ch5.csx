		}
		surface_set_target(fusurface);
		draw_clear_alpha(c_black, 0);
		draw_sprite_ext(spr_plat_orangewall_intact_slice, 0, _width / 2, 0, 1, _height / 80, 0, c_white, 1);
		draw_sprite_ext(spr_plat_orangewall_texture, 0, _width / 2, 0, 0.5, _height / 80, image_angle, image_blend, image_alpha);
		surface_reset_target();
	}
	if (break_timer < _btime)
	{
		surface_set_target(fusurface);
		gpu_set_blendmode(bm_subtract);
		draw_sprite_stretched(spr_plat_orangewall_break_top, break_timer, 0, 0, _width, impact_y / 2);
		draw_sprite_stretched(spr_plat_orangewall_break_bottom, break_timer, 0, impact_y / 2, _width, (sprite_height / 2) - (impact_y / 2));
		gpu_set_blendmode(bm_normal);
		surface_reset_target();
		draw_surface_ext(fusurface, x - (sign(xs) * _width), y, sign(xs) * 2, 2, 0, c_white, 1);
		break_timer += (1 / global.fps_scale);
	}
	else if (surface_exists(fusurface))
	{
		surface_free(fusurface);
	}
}
else
{
	draw_sprite_ext(spr_plat_orangewall_intact, 0, xx, (yy + 40) - (40 * (1 - plata)), xs, ys, image_angle, image_blend, image_alpha);
	draw_sprite_ext(spr_plat_orangewall_intact_border, 0, xx, (yy + 40) - (40 * (1 - plata)), xs, ys, image_angle, image_blend, image_alpha);
	xx += (lengthdir_y(ys + plata, image_angle) * 40);
	yy += (lengthdir_x(ys + plata, image_angle) * 40);
	xs = image_xscale;
	ys = image_yscale - (4 * platb);
	draw_sprite_ext(spr_plat_orangewall_intact, 1, xx, yy, xs, ys - (2 * plata), image_angle, image_blend, image_alpha);
	draw_sprite_ext(spr_plat_orangewall_intact_border, 1, xx, yy, xs, ys - (2 * plata), image_angle, image_blend, image_alpha);
	xx += (lengthdir_y(ys, image_angle) * 40);
	yy += ((lengthdir_x(ys, image_angle) * 40) - (80 * plata));
	xs = image_xscale;
	ys = 2 * platb;
	draw_sprite_ext(spr_plat_orangewall_intact, 2, xx, yy, xs, ys, image_angle, image_blend, image_alpha);
	draw_sprite_ext(spr_plat_orangewall_texture, 0, xx, y + (40 * plata), 0.5 * xs, sprite_height / 160, image_angle, image_blend, image_alpha);
	draw_sprite_ext(spr_plat_orangewall_intact_border, 2, xx, yy, xs, ys, image_angle, image_blend, image_alpha);
}
");

