show_convo = function(arg0, arg1)
{
	npc_animate = false;
	npc_animate_target = -4;
	times_talked = arg1;
	switch (arg0)
	{
		case ""diner_qc"":
			if (scr_sideb_active())
			{
				con = (times_talked == 0) ? 18 : 19;
			}
			else
			{
				npc_animate = true;
				npc_animate_target = qc_npc;
				if (scr_flag_get(701) > 0)
				{
					if (scr_flag_get(1757) == 0)
					{
						con = 5;
					}
					else
					{
						con = 8;
					}
				}
				else if (scr_flag_get(1757) < 4)
				{
					con = 10;
				}
				else
				{
					con = 15;
				}
			}
			break;
		case ""diner_inn"":
			con = 20;
			npc_animate = true;
			npc_animate_target = inn_npc;
			break;
		case ""diner_child"":
			con = 30;
			break;
		case ""diner_vulkin"":
			con = 40;
			npc_animate = true;
			npc_animate_target = vulkin_npc;
			if (scr_flag_get(1350) > 0)
			{
				con = 45;
			}
			break;
		case ""diner_rabbit"":
			con = 50;
			break;
		case ""diner_rainy"":
			con = 60;
			break;
	}
};
");

