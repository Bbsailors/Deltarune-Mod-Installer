		{
			x = xstart + choose(-1, 0, 1);
			y = ystart + choose(-1, 0, 1);
		}
	}
	draw_sprite_ext(current_sprite_index, anim_index, x, y, image_xscale, image_yscale, 0, c_white, 1);
}
else if (state == 13)
{
	if (!state_init)
	{
		current_sprite_index = spr_burgerpants_quit;
		anim_index = 0;
		current_state = state;
		state_init = true;
	}
	anim_timer += (1 / global.fps_scale);
	if (anim_timer == 12)
	{
		anim_index = 1;
		scr_shakeobj();
	}
	draw_sprite_ext(current_sprite_index, anim_index, x, y, image_xscale, image_yscale, 0, c_white, 1);
}
else if (state == 14)
{
	if (!state_init)
	{
		current_sprite_index = spr_burgerpants_slide;
		anim_index = 0;
		anim_timer = 0;
		current_state = state;
		state_init = true;
		scr_lerpvar(""x"", x, x + 8, 6);
	}
	anim_timer += (1 / global.fps_scale);
	if (anim_timer == 12)
	{
		anim_index = 1;
	}
	draw_sprite_ext(current_sprite_index, anim_index, x, y, image_xscale, image_yscale, 0, c_white, 1);
}
else if (state == 15)
{
	if (!state_init)
	{
		current_sprite_index = spr_burgerpants_slide_hover_hand;
		anim_index = 0;
		current_state = state;
		state_init = true;
	}
	if (!pause_anim)
	{
		anim_timer += (0.1 / global.fps_scale);
		anim_index = anim_timer;
	}
	draw_sprite_ext(current_sprite_index, anim_index, x, y, image_xscale, image_yscale, 0, c_white, 1);
}
else if (state == 16)
{
	if (!state_init)
	{
		current_sprite_index = spr_burgerpants_flap;
		anim_index = 0;
		current_state = state;
		state_init = true;
	}
	anim_timer += (0.4 / global.fps_scale);
	anim_index = anim_timer;
	draw_sprite_ext(current_sprite_index, anim_index, x, y, image_xscale, image_yscale, 0, c_white, 1);
}
");

