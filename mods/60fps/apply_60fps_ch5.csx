			image_yscale = 2;
			image_alpha = 2;
			image_speed = 0.25;
			direction = point_direction(other.x, other.y, x, y);
			speed = 6;
			friction = 0.2;
			sprite_index = spr_sparestar_anim;
			image_blend = c_orange;
			scr_doom(self, 30);
			scr_lerpvar(""image_alpha"", image_alpha, 0, 30, 1, ""out"");
		}
	}
};

auraalph = 1;
turnstun = 0;
ral_hook = instance_create(x, y, obj_ralsei_hook);
ral_hook.owner = self;
with (ral_hook)
{
	hookscale = 0;
