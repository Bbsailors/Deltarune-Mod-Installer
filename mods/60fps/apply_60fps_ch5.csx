		c_customfunc(scr_musicer, ""meeting_flower.ogg"");
		c_speaker(""aqua"");
		c_msgsetsubloc(0, ""~1* So^1, Flowery wants to give Asgore~2an \""ideal world\"".../"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_141_0"");
		c_msgnextsubloc(""~1* What's that mean?/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_142_0"");
		c_sel(aq);
		c_spritenext(6800);
		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* Haha^1, obviously^1, it means..^1. um.../"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_146_0"");
		c_sel(se);
		c_msgvar_add(""x"", 2);
		c_spritenext(6556);
		c_facenext(""aqua"", 0);
		c_msgnextsubloc(""~1* Uuuu^1, does Seth not know?/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_151_0"");
		c_sel(aq);
		c_spritenext(4067);
		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* Of course I know^1! You just~2wouldn't get it!/"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_155_0"");
		c_sel(se);
		c_msgvar_add(""x"", -2);
		c_spritenext(4419);
		c_facenext(""aqua"", 0);
		c_msgnextsubloc(""~1* I think.../"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_160_0"");
		c_msgnextsubloc(""~1* Asgore..^1. doesn't have anyone to~2play with anymore!/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_161_0"");
		c_msgnextsubloc(""~1* We could play with him^1. So he'll~2open his mouth./"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_162_0"");
		c_msgnextsubloc(""~1* And show lots and lots of teeth!/%"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_163_0"");
		c_sel(aq);
		c_spritenext(5704);
		c_talk_wait();
		c_sel(se);
		c_sprite(spr_seth_shakehead);
		c_wait(30);
