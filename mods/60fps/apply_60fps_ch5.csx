		d_make_plat(0, 1);
	}
	else if (conversation_progress == 1)
	{
		scr_speaker(""ralsei"");
		msgsetsubloc(0, ""\\E2* That's okay^1, Kris^1, try again!"", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_plat_antisoftlock_zone_slash_Step_0_gml_204_0"");
		d_make_plat(0, 1);
	}
	else if (conversation_progress == 2)
	{
		scr_speaker(""susie"");
		msgsetsubloc(0, ""\\E5* You don't have to do it on purpose."", (global.lang == ""ja"") ? stringset(""&\t\t\t"") : stringset(""&""), ""obj_plat_antisoftlock_zone_slash_Step_0_gml_209_0"");
