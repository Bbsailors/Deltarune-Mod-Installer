redsplatter = -4;

makeredsplatter = function(arg0 = true)
{
	var splat = findsprite(spr_dw_fcastle_sandtrap_redsplatter, ""CUT_BLUE"", undefined, undefined);
	redsplatter = scr_makenpc_fromasset(splat);
	with (redsplatter)
	{
		makeshine = true;
		issolid = false;
		marker.depth = obj_dw_fcastle_sandtrap.yellowhole.depth - 2;
		markerstick = false;
		with (instance_create(x + 2, y, obj_dw_fcastle_sandtrap_redsplatter_water))
		{
			depth = other.marker.depth;
			sprite_index = spr_dw_fcastle_sandtrap_redsplatter_water;
		}
		scr_sizeexact(84, 30);
		setxy(x + 72, y + 24);
		if (scr_keyitemcheck(23) || obj_dw_fcastle_sandtrap.phase >= 4 || !arg0)
		{
			x = room_width * 4;
			myinteract = 9999;
			makeshine = false;
		}
		shine = -4;
		if (makeshine)
		{
			shine = scr_marker_fancy(x + 4, y + 6, 4635);
			with (shine)
			{
				image_alpha = 0;
				scr_darksize();
				image_blend = #FF8F93;
				scr_depth();
				siner = 0;
				
				step_func = function()
				{
					siner += (1 / global.fps_scale);
					image_index += (0.2 / global.fps_scale);
					var targ = instance_exists(obj_cutscene_master);
					if (obj_dw_fcastle_sandtrap.redsplatter.myinteract >= 999)
					{
						targ = 1;
					}
					if (global.flag[1454] < 51)
					{
						targ = 1;
					}
					var targalpha = lerp(image_alpha, !targ, scr_fps_lerp_rate(0.125));
					image_alpha = targalpha;
					image_blend = merge_color(c_white, #FF8F93, (sin(siner / 15) * 0.5) + 0.5);
				};
			}
		}
	}
};

var tempblockloc = findspriteinfo(spr_pxwhite, ""ASSETS_REF"", #991076, undefined);
tempblock = instance_create(tempblockloc.x, tempblockloc.y, obj_solidblock);
