Apply("gml_Object_obj_dw_fcastle_sandtrap_aquasplash_Draw_0", @"if (!surface_exists(surf))
{
	surf = surface_create(w, h);
}
siner += (1 / global.fps_scale);
var floatamt = cos(siner / 30) * 2;
surface_set_target(surf);
draw_clear_alpha(c_white, 0);
var _x = scr_even(10 + (sin(siner / 15) * 8));
var _y = scr_even(36 + floatamt);
image_index = (siner / 5) % 7;
draw_sprite_ext(spr_enemy_aqua_redsplash, image_index, _x, _y, 2, 2, 0, c_white, 1);
surface_reset_target();
draw_surface(surf, x, y);
if (!instance_exists(obj_mainchara))
{
	exit;
}

var wprog = function(arg0, arg1, arg2)
{
	var _range = arg2 - arg1;
	var _progress = 0;
	if (_range != 0)
	{
		_progress = (arg0 - arg1) / _range;
	}
	else if (arg0 >= arg1)
	{
		_progress = 1;
	}
	return clamp(_progress, 0, 1);
};

var dist = point_distance(x, y, obj_mainchara.x, obj_mainchara.y);
var vol = lerp(0, 1, 1 - wprog(dist, 120, 320)) * 0.7;
if (vol > 0)
{
	if (image_index == 4)
	{
		snd_play(snd_splash, vol, 1.1);
	}
	if (image_index == 0)
	{
		snd_play(snd_splash, vol, 1);
	}
}
");

Apply("gml_Object_obj_dw_fcastle_sandtrap_firepitsmoke_Step_0", @"timer += (1 / global.fps_scale);
siner += (1 / global.fps_scale);
if (timer >= timertarg)
{
	timertarg = random_range(12, 18);
	timer = 0;
	array_push(smokepuff, 
	{
		x: x,
		y: y,
		alpha: 0,
		size: random_range(15, 20),
		dir: random_range(-15, 15),
		vfric: random_range(0.03, 0.04) / (global.fps_scale * global.fps_scale),
		hfric: random_range(0.02, 0.05) / (global.fps_scale * global.fps_scale),
		vspd: ((abs(cos(other.siner / 60)) * 1.25) + 0.75) / global.fps_scale,
		hspd: sin(other.siner / 15) / global.fps_scale,
		timer: 0
	});
}
var cleanup = [];
for (var i = 0; i < array_length(smokepuff); i++)
{
	with (smokepuff[i])
	{
		timer++;
		alpha = lerp(alpha, 1, scr_fps_lerp_rate(0.125));
		hspd -= (sign(hspd) * hfric);
		vspd -= (sign(vspd) * vfric);
		x += hspd;
		y -= vspd;
		size = lerp(size, -0.1, scr_fps_lerp_rate(1/15));
		if (size <= 0)
		{
			array_insert(cleanup, 0, i);
		}
	}
}
for (var i = 0; i < array_length(cleanup); i++)
{
	array_delete(smokepuff, cleanup[i], 1);
}
");

Apply("gml_Object_obj_dw_fcastle_sandtrap_greenaqua_Create_0", @"sprite_index = spr_pxwhite;
scr_depth();
splashcolor = 15191256;

entranceSplash = function()
{
	with (scr_marker_ext(x + 40, y + 138, spr_splash, 2, 2, 0, 0, splashcolor, depth - 1))
	{
		snd_play(snd_splash);
		scr_lerpvar(""image_index"", 0, 4, 10);
		scr_doom(id, 10);
	}
};

makeExitSplash = function()
{
	with (scr_marker_fancy((x - 8) + 4 + 6, y + 168, 1270))
	{
		timer = 0;
		scr_size(2, 2);
		depth = other.depth - 1;
		animtime = 12;
		snd_play(snd_splash);
		image_blend = other.splashcolor;
		
		step_func = function()
		{
			timer += (1 / global.fps_scale);
			image_index = lerp(0, 4, timer / animtime);
			if (timer == animtime)
			{
				instance_destroy();
			}
		};
		
		draw_func = function()
		{
			gpu_set_fog(true, image_blend, 0, 0);
			draw_self();
			draw_sprite_ext(sprite_index, image_index, (x + 120) - 40 - 8, y, -2, 2, 0, c_white, 1);
			gpu_set_fog(false, c_white, 0, 0);
		};
	}
};

var loc = findspriteinfo(spr_aqua_green_hold, ""NPCs"", undefined, undefined);
x = loc.x - 14;
y = loc.y - 118;
xstart = x;
ystart = y;
siner = 0;
floating = false;
w = 80;
h = 168;
surf = -4;
timer = 0;
con = 0;
version = 0;
vinit = 0;
limit = false;
aqua = 
{
	x: 14,
	y: 168,
	ylimit: 118,
	hsp: 0,
	vsp: 0,
	grav: 1 / (global.fps_scale * global.fps_scale),
	image_index: 0,
	image_speed: 0.5 / global.fps_scale,
	sprite_index: spr_aqua_green_spin
};
scissors = false;
fulltimer = 0;
");

Apply("gml_Object_obj_dw_fcastle_sandtrap_greenaqua_Step_0", @"fulltimer++;
if (vinit == 0)
{
	if (version == 2)
	{
		var loc = findspriteinfo(spr_aqua_green_hold, ""cut_blue"", undefined, undefined);
		x = loc.x - 14;
		y = loc.y - 118;
		xstart = x;
		ystart = y;
	}
	makeExitSplash();
	vinit = 1;
}
if (floating)
{
	siner += (1 / global.fps_scale);
}
if (con == 0)
{
	timer += (1 / global.fps_scale);
	if (timer == 1)
	{
		aqua.vsp = 0.5;
		aqua.vsp = -16 / global.fps_scale;
		aqua.image_index = 2.5;
		aqua.image_speed = 0.5 / global.fps_scale;
		aqua.sprite_index = spr_aqua_green_spin;
		if (version == 2)
		{
			aqua.sprite_index = spr_enemy_aqua_spin;
		}
		delay_function(function()
		{
			with (obj_dw_fcastle_sandtrap_greenaqua)
			{
				entranceSplash();
			}
		}, 23);
	}
	if (timer > 1)
	{
		if (aqua.y < aqua.ylimit && !limit)
		{
			limit = true;
		}
		else if (aqua.y == aqua.ylimit)
		{
			floating = true;
			aqua.sprite_index = spr_aqua_green_hold;
			if (version == 0)
			{
				scissors = true;
			}
			else
			{
				aqua.sprite_index = spr_enemy_aqua_idle_r;
				aqua.image_speed = 0.25 / global.fps_scale;
			}
			timer = 0;
			con = 0.5;
		}
	}
}
if (con == 0.5)
{
	timer += (1 / global.fps_scale);
	if (timer == 10)
	{
		if (version == 0)
		{
			scr_miniface_init_flowers();
			scr_speaker(""aqua"");
			msgsetsubloc(0, ""~1* Here^1, evidence^1! I did it^1,~2I did it!/"", (global.lang == ""ja"") ? ""\\m0\t\t\t"" : ""\\m0\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_sandtrap_greenaqua_slash_Step_0_gml_73_0"");
			scr_anyface_next(""no_name"", 0);
			msgnextloc(""* (SCISSORS was added to your EVIDENCE.)/%"", ""obj_dw_fcastle_sandtrap_greenaqua_slash_Step_0_gml_75_0"");
			scr_msgno_func(2, function()
			{
				snd_play(snd_item);
				with (obj_dw_fcastle_sandtrap_greenaqua)
				{
					scissors = false;
				}
			});
			d_make();
			timer = 0;
			con = 1;
		}
		else
		{
			con = -20;
			scr_debug_print(fulltimer);
		}
	}
}
if (con == 1 && !d_ex())
{
	floating = false;
	makeExitSplash();
	with (aqua)
	{
		vsp = -12 / global.fps_scale;
		image_index = 98;
		image_speed = -0.5 / global.fps_scale;
		sprite_index = spr_aqua_green_spin;
	}
	if (version == 2)
	{
		aqua.sprite_index = spr_enemy_aqua_spin;
	}
	delay_function(function()
	{
		with (obj_dw_fcastle_sandtrap_greenaqua)
		{
			entranceSplash();
		}
	}, 19);
	limit = false;
	con = 2;
}
if (con == 2)
{
	if (aqua.y > (aqua.ylimit + 80))
	{
		if (version != 2)
		{
			global.interact = 0;
			global.facing = 0;
		}
		if (version == 0)
		{
			scr_keyitemget(20);
		}
		instance_destroy();
	}
}
with (aqua)
{
	x += hsp;
	vsp += grav;
	y += vsp;
	image_index += image_speed;
}
");

Apply("gml_Object_obj_dw_fcastle_sandtrap_redsplatter_water_Draw_0", @"wave_siner += (1 / global.fps_scale);
for (var i = 0; i < wave_max; i++)
{
	var modu = sin(wave_siner / 30) * lerp(-sprite_width / 3, 0, clamp(1 - (i / wave_max), 0, 1));
	var xoff = -((((i + 1) * 1.9) - (sprite_width * 2)) + modu) - (sprite_width * 2);
	var yoff = sin(wave_siner / (30 + (i / 80)));
	draw_sprite_part_ext(sprite_index, 0, sprite_width - i, 0, 2, sprite_height, min(x + xoff, x - 6), y + yoff, 2, 2, c_white, 1);
}
");

