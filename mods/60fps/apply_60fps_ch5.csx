			instance_destroy();
		}
	}
	with (obj_readable_room1)
	{
		if (x >= 80 && x <= 210)
		{
			instance_destroy();
		}
	}
}
if (con == 54)
{
	with (obj_fadeout)
	{
		instance_destroy();
	}
	instance_create(0, 0, obj_fadein);
	con = 55;
	alarm[4] = round(20 * global.fps_scale);
}
if (con == 56)
{
	msgsetloc(0, ""* ... and turned it into a giant dusty ball./%"", ""obj_unusedclassevent_slash_Step_0_gml_225_0"");
	d_make();
	con = 57;
}
if (con == 57 && !d_ex())
{
	con = 58;
	if (global.plot < 9)
	{
		global.plot = 9;
	}
	global.interact = 0;
}
");

