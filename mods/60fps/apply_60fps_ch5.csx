if (state == 0)
{
	if (!state_init)
	{
		current_state = state;
		state_init = true;
	}
	anim_timer += (1 / global.fps_scale);
	if ((anim_timer % 8) == 1)
	{
		anim_index = choose(0, 1);
	}
	if ((anim_timer % 2) == 1)
	{
		mic_offset_x = choose(-2, -1, 0);
		x = xstart + choose(-1, 0, 1);
		y = ystart + choose(-1, 0, 1);
	}
