boltframe = 1;
boltalive = 1;
imagetimer = 4;
heart_x = 0;
heart_y = 0;
bookcon = 0;
booktimer = 0;
flowerybubble = -4;
only_jarona = true;
");

Apply("gml_Object_obj_plat_finalflowery_Draw_76", @"predraw_x = x;
predraw_y = y;
if (!i_ex(obj_plat_player))
{
	exit;
}
var limited = false;
if (global.pause_plat || obj_plat_player.targetmode)
{
	limited = true;
}
if (shake > 0 && !limited)
{
	x += irandom_range(-shake, shake);
	shake -= (1 / global.fps_scale);
}
if (!limited)
{
	sinertimer += (1 / global.fps_scale);
}
var yy = y;
y += (sin(sinertimer / 5) * sineramp * 6);
if (scr_smoothcam_on())
{
	var __sc_q = 640 / surface_get_width(application_surface);
	x = round(x / __sc_q) * __sc_q;
	y = round(y / __sc_q) * __sc_q;
}
if (qte_prompt_state < 2)
{
	hsvslider += (0.3 / global.fps_scale);
	if ((sinertimer % 2) == 1 && !limited)
	{
		var _col = make_color_hsv(((hsvslider / 14) * 255) % 255, 255, 255);
		var _afim = scr_afterimage_monochrome(_col, true);
		with (_afim)
		{
			scr_lerpvar(""image_xscale"", image_xscale, image_xscale * 1.2, 4);
			scr_lerpvar(""image_yscale"", image_yscale, image_yscale * 1.2, 4);
		}
		_afim.depth = depth + 100;
		_afim.hspeed = -10 / global.fps_scale;
		_afim.fadespeed = 0.2;
		_afim.image_alpha = 0.5;
	}
	if (i_ex(hurtflash))
	{
		hurtflash.x = x;
		hurtflash.y = y;
		hurtflash.image_xscale = image_xscale;
		hurtflash.image_yscale = image_yscale;
		hurtflash.depth = depth - 1;
	}
}
");

Apply("gml_Object_obj_plat_finalflowery_Step_0", @"if (global.pause_plat)
{
	exit;
}
event_inherited();
contimer += (1 / global.fps_scale);
subcontimer += (1 / global.fps_scale);
var __IDLE = 0;
var __BULLETS = 1;
var __JARONA = 2;
var __FINALJARONA = 3;
var __ACTING = 4;
var __FLATTER = 5;
var __INTRO = 6;
if (i_ex(obj_plat_player))
{
	if (con != 4)
	{
		if (con == 5)
		{
			depth = obj_plat_player.depth + 50;
		}
		else if (qte_prompt_state < 2)
		{
			depth = obj_plat_player.depth - 50;
		}
	}
}
if (con == __INTRO)
{
	if (contimer == 1)
	{
		x += 400;
		sprite_index = spr_omegaflowery_pose;
	}
	x = scr_approach(x, xstart, 4);
	if (contimer == 80)
	{
		snd_play_flowery(660);
	}
	if (x == xstart)
	{
		con = __IDLE;
		contimer = 1;
	}
}
if (con == __IDLE)
{
	if (contimer == 25)
	{
		if (only_jarona)
		{
			switch_con(__JARONA);
		}
		else
		{
			switch_con((nextcon % 2) + 1);
			nextcon++;
		}
	}
}
else if (con == __JARONA)
{
	if (subcon == 0)
	{
		if (subcontimer == 20)
		{
			snd_play_flowery(614);
			jarona_repeat = 0;
			jarona_repeat_target = 4;
			attack_speed = 24;
			sprite_index = spr_omegaflowery_powerup;
			if (only_jarona)
			{
				attack_speed = 20;
				jarona_repeat_target = 8;
			}
		}
		if (subcontimer == 1)
		{
			chargesnd = snd_loop(snd_chargeshot_charge);
			snd_pitch(chargesnd, 0.5);
			snd_pitch_time(chargesnd, 1.5, 60);
			snd_volume(chargesnd, 0.2, 0);
			snd_volume(chargesnd, 0.7, 60);
		}
		if (subcontimer >= 1 && (subcontimer % 4) == 0 && subcontimer <= 80)
		{
			if (subcontimer <= 60)
			{
				make_bwoosh(make_color_hsv(((1 + ((subcontimer / 4) % 6)) / 7) * 255, 255, 255), 20, 249, true);
			}
			var _col = make_color_hsv(((hsvslider / 14) * 255) % 255, 255, 255);
			var _afim = scr_afterimage_monochrome(_col, true);
			var amp = (subcontimer + 10) / 90;
			with (_afim)
			{
				scr_lerpvar(""x"", x, x - (sprite_width * (1 + amp) * 0.2), 4);
				scr_lerpvar(""y"", y, y - (sprite_height * (1 + amp) * 0.2), 4);
				scr_lerpvar(""image_xscale"", image_xscale, image_xscale * (1 + amp), 4);
				scr_lerpvar(""image_yscale"", image_yscale, image_yscale * (1 + amp), 4);
			}
			_afim.depth = depth + 100;
			_afim.fadespeed = 0.1;
			_afim.image_alpha = 0.6;
		}
		shake = subcontimer / 20;
		if (subcontimer >= 80)
		{
			switch_subcon(1);
			snd_stop(chargesnd);
		}
	}
	else if (subcon == 1)
	{
		if (subcontimer == 1)
		{
			waittime = 1;
		}
		if (nextcon >= 4)
		{
			jarona_repeat_target = 6;
			is_final_jarona = jarona_repeat == 5;
		}
		if (only_jarona)
		{
			is_final_jarona = jarona_repeat == (jarona_repeat_target - 1);
		}
		if (global.hp[global.char[0]] < 2)
		{
			is_final_jarona = true;
		}
		if (subcontimer == waittime)
		{
			if (is_final_jarona)
			{
				with (obj_plat_player)
				{
					act_enabled = false;
				}
				attack_speed = 18;
			}
			sprite_index = spr_omegaflowery_powerup;
			var ronas = [[12, round(9)], [150, round(9)], [753, round(9)], [68, round(9)]];
			var thisrona = irandom(array_length(ronas) - 1);
			snd_play_flowery(ronas[thisrona][0]);
			ronawait = ronas[thisrona][1];
			make_bwoosh(make_color_hsv((random_range(1, 7) / 7) * 255, 255, 255), ronawait, 249, true);
		}
		if (subcontimer == (waittime + ronawait))
		{
			sprite_index = spr_omegaflowery_jarona;
			switch_subcon(2);
			jarona_repeat++;
			var lowtime = 8;
			var hightime = 24;
			waittime = irandom_range(lowtime, hightime);
			snd_play(snd_punchheavythunder);
			snd_play(snd_punchheavythunder, 0.5, 0.7);
			make_bwoosh(make_color_hsv((random_range(1, 7) / 7) * 255, 255, 255), 30, 440);
			make_bwoosh(make_color_hsv((random_range(1, 7) / 7) * 255, 255, 255), 40, 330);
			make_bwoosh(make_color_hsv((random_range(1, 7) / 7) * 255, 255, 255), 50, 220);
		}
	}
	else if (subcon == 2)
	{
		if (subcontimer == 1)
		{
			flash_hurt(16711680);
			memory = choose(0, 1);
			if (is_final_jarona)
			{
				memory = 2;
			}
			dashbullet = instance_create(x, y, obj_plat_bulletred);
			dashbullet.damage = 60 + global.battledf[0];
			var ddamage = (global.hp[global.char[0]] - 1) + global.battledf[0];
			dashbullet.damage = min(floor(global.hp[global.char[0]] * 0.4) + global.battledf[0], ddamage, dashbullet.damage);
			if (dashbullet.damage < (10 + global.battledf[0]))
			{
				dashbullet.damage = ddamage;
			}
			dashbullet.image_yscale = 100;
			dashbullet.image_alpha = 0;
		}
		with (dashbullet)
		{
			x = other.x + 80;
		}
		var ylerp = 20 - ceil(0.5 * attack_speed);
		hspeed = max(-30, (-14 + (1.2 * attack_speed)) - ((0.3 * attack_speed * subcontimer) / ylerp)) / global.fps_scale;
		var ylerpease = ease_inout_sine(min((subcontimer * 0.5) / ylerp, 1), 0, 1, 1);
		if (memory == 0)
		{
			y = lerp(ystart, ystart - 20, ylerpease);
		}
		if (memory == 1)
		{
			y = lerp(ystart, ystart + 80, ylerpease);
		}
		if (memory == 2)
		{
			y = lerp(ystart, obj_plat_player.y - 20, ylerpease * 0.5);
		}
		if ((subcontimer % 2) == 0 && hspeed < 0)
