Apply("gml_Object_obj_scissors_act_player_Step_0", @"if (init == 0)
{
	init = 1;
	if (valuecut)
	{
		spd = 3;
	}
	if (hypercut)
	{
		spd = 4;
	}
}
if (up_h())
{
	x += (lengthdir_x(spd, direction) / global.fps_scale);
	y += (lengthdir_y(spd, direction) / global.fps_scale);
	cuttimer += (1 / global.fps_scale);
	if (cuttimer == 2)
	{
		image_index = 0;
	}
	if (cuttimer == 5)
	{
		linex2 = x;
		liney2 = y;
		inst = instance_create(linex1, liney1, obj_scissors_line);
		inst.image_xscale = spd * 5;
		inst.image_yscale = 2;
		inst.image_angle = point_direction(linex1, liney1, linex2, liney2);
		inst.image_blend = c_red;
		inst.count = linecount;
		inst.x2 = linex2;
		inst.y2 = liney2;
		line_array[linecount] = inst;
		linecount++;
		linex1 = x;
		liney1 = y;
		cuttimer = 0;
		image_index = 1;
		snd_play_x(snd_break1, 0.8, 1.1);
	}
	with (obj_scissors_act_controller)
	{
		acttimerstart = true;
	}
}
if (valuecut)
{
	if (left_h())
	{
		image_angle += (6 / global.fps_scale);
	}
	if (right_h())
	{
		image_angle -= (6 / global.fps_scale);
	}
}
else if (hypercut)
{
	if (left_h())
	{
		image_angle += (8 / global.fps_scale);
	}
	if (right_h())
	{
		image_angle -= (8 / global.fps_scale);
