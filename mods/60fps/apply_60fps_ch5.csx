Apply("gml_Object_obj_town_south_strength_countdown_Create_0", @"speech = [stringsetloc(""Three..."", ""obj_town_south_strength_countdown_slash_Create_0_gml_4_0""), stringsetloc(""Two..."", ""obj_town_south_strength_countdown_slash_Create_0_gml_5_0""), stringsetloc(""One..."", ""obj_town_south_strength_countdown_slash_Create_0_gml_6_0"")];
current_index = 0;
current_text = speech[current_index];
speech_time = 30;
speech_xscale = 0;
speech_yscale = 0;
speech_alpha = 1;
speech_xpos = 220;
speech_ypos = 100;
start_speech = false;
stop_speech = false;
depth = 5000;

show_speech = function()
{
	speech_alpha = 1;
	current_text = speech[current_index];
	scr_lerpvar_instance(id, ""speech_xscale"", 0, 0.5, speech_time * 0.5);
	scr_lerpvar_instance(id, ""speech_yscale"", 0, 0.5, speech_time * 0.5);
	scr_lerpvar_instance(id, ""speech_ypos"", 100, 70, speech_time * 0.5);
	alarm[1] = round(speech_time * global.fps_scale);
	current_index++;
};

clean_up = function()
{
	speed_alpha = 0;
	instance_destroy();
};
");

