draw_rectangle(x + 8 + x_offset, y + 2, (xx + x_offset) - 1, y + 17, 0);
draw_sprite_part_ext(sprite_index, 0, 10, 0, 8, 32, xx + x_offset, y, 1, 1, colour, alpha);
draw_set_alpha(1);
");

