				dc.inv = 60;
				dc.target = mytarget;
				dc.grazepoints = 6;
				dc.timepoints = 2;
				dc.active = 0;
				dc.creator = id;
				dc.damage = global.monsterat[myself] * 5;
			}
			turns += 1;
			global.turntimer = 180;
			attacked = 1;
			global.typer = 6;
			global.fc = 0;
			rr = choose(0, 1, 2, 3, 4);
