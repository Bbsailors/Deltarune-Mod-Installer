}
with (obj_marker_z)
{
	if (!movedthisframe)
	{
		movedthisframe = true;
		if (variable_instance_exists(id, ""stepper""))
		{
			if (returnmode)
			{
				tx = mycaterpillar.x;
				ty = mycaterpillar.y;
			}
			if (x == tx && y == ty)
			{
				if (returnmode == true)
				{
					with (mycaterpillar)
					{
						image_alpha = 1;
					}
					scr_caterpillar_interpolate(""all"");
					instance_destroy();
				}
				walktimer = 0;
			}
			else
			{
				dir = point_direction(x, y, tx, ty);
				if (readytogo >= 15)
				{
					x = scr_approach(x, tx, abs(lengthdir_x(walkspeed, dir)));
					y = scr_approach(y, ty, abs(lengthdir_y(walkspeed, dir)));
					walktimer += (3 / global.fps_scale);
				}
			}
			if (walktimer >= 40)
			{
				walktimer -= 40;
			}
			if (walktimer < 10)
			{
				image_index = 0;
			}
			if (walktimer >= 10)
			{
				image_index = 1;
			}
			if (walktimer >= 20)
			{
				image_index = 2;
			}
			if (walktimer >= 30)
			{
				image_index = 3;
			}
			var _face = (dir + 45) div 90;
			if (_face == 0 || _face == 4)
			{
				sprite_index = rsprite;
			}
			if (_face == 1)
			{
				sprite_index = usprite;
			}
			if (_face == 2)
			{
				sprite_index = lsprite;
			}
			if (_face == 3)
			{
				sprite_index = dsprite;
			}
			if (jumping)
			{
				var _fulldistance = point_distance(xstart, ystart, tx, ty);
				var _height = _fulldistance * 0.25;
				var _remainingdistance = point_distance(x, y, tx, ty);
				var _percentleft = 0;
				if (_remainingdistance > 0)
				{
					_percentleft = _remainingdistance / _fulldistance;
				}
				z = -(sin(_percentleft * pi) * _height);
			}
			else
			{
				z = 0;
			}
			scr_depth();
		}
	}
}
if (follow_mode)
{
	if (state == 1)
	{
		var _cx = camerax() + 530;
		var _cy = cameray() + 70;
		x = lerp(x, _cx, scr_fps_lerp_rate(0.16666666666666666));
		y = lerp(y, _cy, scr_fps_lerp_rate(0.16666666666666666));
		show_debug_message(""timer: "" + string(x) + "","" + string(y));
		scr_depth();
	}
	else
	{
		if (x != xstart || y != ystart)
		{
			stillflying = true;
			x = lerp(x, xstart, scr_fps_lerp_rate(0.125));
			y = lerp(y, ystart, scr_fps_lerp_rate(0.125));
			if (abs(x - xstart) < 0.1)
			{
				x = xstart;
			}
			if (abs(y - ystart) < 0.1)
			{
				y = ystart;
			}
			scr_depth();
		}
		stillflying = false;
	}
}
if (state == 2 && takeoff_mode)
{
	gravity_direction = 90;
	gravity = 0.1 / (global.fps_scale * global.fps_scale);
	friction = 0;
	x = xstart + random_range(-2, 2);
}
if (cutscene_mode != 0 && failtimer > 0)
{
	failtimer -= (1 / global.fps_scale);
}
");

