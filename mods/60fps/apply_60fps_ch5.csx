with (npc_aqua)
{
	visible_is_active = true;
	visible = 0;
	con = 0;
	timer = 0;
	gravity = 0;
	entity_gravity = 0;
	wallcollision = 0;
	physics = 0;
	x_anchor = x;
	y_anchor = y;
	seth = other.npc_seth;
	manager = other;
	custom_behaviour(function()
	{
		if (!global.pause_plat)
		{
			timer += (1 / global.fps_scale);
			if (con == 1)
			{
				if (timer == 45)
				{
					force_animation(7736);
					image_speed = 0.2 / global.fps_scale;
				}
				if (timer == 195)
				{
					force_animation(2398);
				}
				if (timer == 225)
				{
					with (manager)
					{
						with (su_actor)
						{
							turn(false);
							x += 6;
							force_animation(8223);
						}
						with (ra_actor)
						{
							turn(false);
							x += 6;
							force_animation(7934);
						}
					}
				}
				if (timer == 305)
				{
					con = 2;
					force_animation(7736);
					with (manager)
					{
						with (su_actor)
						{
							x -= 6;
							restore_animation();
							turn(true);
						}
						with (ra_actor)
						{
							turn(true);
							restore_animation();
							x -= 6;
						}
					}
					timer = 0;
				}
			}
			else if (con == 2)
			{
			}
			if (con < 10)
			{
				x = x_anchor;
				y = y_anchor + (sin(timer * 0.15) * 8);
				if (seth.con == 1)
				{
					seth.x = x + 30;
					seth.y = y - 4;
				}
			}
			if (con < 10)
			{
				if ((timer % 4) == 0 && visible)
				{
					obj_dw_fcastle_obscured_bullets.spawn_aqua_petals(x, y, depth, 0.3);
				}
			}
		}
	});
}
