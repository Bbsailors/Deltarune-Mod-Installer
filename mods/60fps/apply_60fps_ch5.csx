					{
						_nolongerneeded = false;
					}
				}
				returnmode = _nolongerneeded;
			}
		}
		if (puzzle_phase >= puzzle_win_phase)
		{
			showfinaltime = 90;
			if (takeoff_mode)
			{
				scr_doom(id, 120);
			}
			state = 2;
			global.interact = 1;
			alarm[0] = round(30 * global.fps_scale);
