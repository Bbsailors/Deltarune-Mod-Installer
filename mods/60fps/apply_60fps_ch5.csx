	c_speaker(""undyne"");
	c_msgsetloc(0, ""\\E0* Hey^1, by the way^1, that yellow glasses lady./"", ""obj_npc_police_slash_Step_0_gml_522_0"");
	c_msgnextloc(""\\E2* Is she your teacher?/"", ""obj_npc_police_slash_Step_0_gml_523_0"");
