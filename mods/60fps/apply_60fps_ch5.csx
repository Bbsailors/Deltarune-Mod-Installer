Apply("gml_Object_obj_chainbullet_Step_0", @"if (!instance_exists(obj_heart))
{
	instance_destroy();
}
if (init == 1)
{
	timer += (1 / global.fps_scale);
	if (timer >= firingSpeed)
	{
		timer = 0;
		bulletsSpawned++;
		d = scr_childbullet(x, y, childBullet);
		if (i_ex(d))
		{
			d.sprite_index = sprite_index;
			d.direction = direction;
			d.speed = childSpeed / global.fps_scale;
			d.gravity = childgravity / (global.fps_scale * global.fps_scale);
			direction += shotRotation;
			d.image_angle = direction;
		}
		if (bulletsSpawned >= totalBullets)
		{
			instance_destroy();
		}
	}
}
init = 1;
");

Apply("gml_Object_obj_chapter_continue_Step_0", @"if (init < round(40 * global.fps_scale))
{
	init++;
	text_alpha = clamp(text_alpha + (0.05 / global.fps_scale), 0, 1);
	ypos_offset = clamp(ypos_offset - (3 / global.fps_scale), 0, 40);
	exit;
}
if (!confirmed_selection)
{
	if (up_p())
	{
		move_noise = true;
		choice_index = ((choice_index - 1) < 0) ? 1 : 0;
	}
	if (down_p())
	{
		move_noise = true;
		choice_index = ((choice_index + 1) > 1) ? 0 : 1;
	}
	if (button1_p())
	{
		select_noise = true;
		confirmed_selection = true;
		alarm[0] = round(30 * global.fps_scale);
	}
}
if (confirmed_selection)
{
	text_alpha = clamp(text_alpha - (0.5 / global.fps_scale), 0, 1);
}
if (move_noise)
{
	move_noise = false;
	snd_play(snd_menumove);
}
if (select_noise)
{
	select_noise = false;
	snd_play(snd_select);
}
");

