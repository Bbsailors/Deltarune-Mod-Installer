}
var limited = false;
if (global.pause_plat || obj_plat_player.targetmode)
{
	limited = true;
}
bullet3d_amp = 80;
bullet3d_angle_y = -65;
bullet3d_angle_x = 32;
bullet3d_angle_z = 10 + (sin(0.1 * sinertimer) * 24);
var xx = bbox_left + (0.5 * (bbox_right - bbox_left));
var yy = y + (0.5 * sprite_height);
var bullarrlen = array_length(bullet3d);
for (var i = 0; i < bullarrlen; i++)
{
	with (bullet3d[i])
	{
		if (con == 0)
		{
			if (!limited)
			{
				phasetimer += (1 / global.fps_scale);
			}
			if (con == 0)
			{
				var siner = sin(phase + (phasetimer * 0.2));
				var coser = cos(phase + (phasetimer * 0.2));
				var xamt = lengthdir_x(coser, other.bullet3d_angle_z) + lengthdir_y(siner, other.bullet3d_angle_z);
				var yamt = lengthdir_y(coser, other.bullet3d_angle_z) + lengthdir_x(siner, other.bullet3d_angle_z);
				xamt *= (cos(degtorad(other.bullet3d_angle_x)) * other.bullet3d_amp * ampmult);
				yamt *= (cos(degtorad(other.bullet3d_angle_y)) * other.bullet3d_amp * ampmult);
				x = xx + xamt;
				y = yy + yamt;
				image_xscale = 1.5 + (0.5 * siner);
				image_yscale = image_xscale;
				depth = other.depth - (siner * 10);
				if (siner > 0)
				{
					image_blend = merge_color(blend, c_white, siner * 0.5);
				}
				else
				{
					image_blend = merge_color(blend, c_black, siner * 0.5);
				}
			}
			if ((phasetimer % 2) == 0 && !limited && instance_exists(self))
			{
				with (scr_afterimage_monochrome(image_blend, true))
				{
					depth = other.depth + 100;
					image_alpha = 0.5;
					hspeed = -10 / global.fps_scale;
				}
			}
		}
	}
}
");

