Apply("gml_Object_obj_dw_cliffs_tallgrass_Create_0", @"image_speed = 0;
image_index = 0;
image_xscale = 2;
image_yscale = 2;
scr_depth_alt();
depth -= 180;
was_cut = false;
wastouching = false;
touching = false;
boss = 0;
particle_system = -4;
sibling = -4;
var find = instance_find(object_index, 0);
if (find == id)
{
	boss = 1;
	with (obj_dw_cliff_kawkawdash)
	{
		grass_boss = other.id;
	}
	particle_system = instance_create_depth(x, y, depth - 6000, obj_custom_particle_system);
	particle_system.default_particle_data.sprite_index = spr_dw_cliffs_tallgrass_stalk;
	particle_system.default_particle_data.image_speed = 0;
	particle_system.default_particle_data.gravity = 0.1;
	particle_system.default_particle_data.animation_mode = true;
}
chosen = false;
grasses = -4;
cutdown_struct = 
{
	image_xscale: 1,
	image_yscale: 1,
	hspeed: 1,
	vspeed: 1,
	image_angle: 1,
	fadeout_speed: 1
};

cut_down_effect = function(arg0, arg1)
{
	if (instance_exists(particle_system))
	{
		var _dir = 0;
		var _len = random_range(5, 12);
		if (instance_exists(obj_mainchara_dash))
		{
			_dir = -(obj_mainchara_dash.speed * global.fps_scale * random_range(-1, 1.8));
		}
		var _lifetime = random_range(30, 90);
		var _image_alpha = random_range(1, 1.3);
		particle_system.x = arg0;
		particle_system.y = arg1;
		cutdown_struct.image_xscale = random_range(1, 3);
		cutdown_struct.image_yscale = random_range(1, 3);
		cutdown_struct.hspeed = lengthdir_x(_len, _dir);
		cutdown_struct.vspeed = lengthdir_y(_len, _dir) - random_range(5, 12);
		cutdown_struct.image_angle = _dir;
		cutdown_struct.fadeout_speed = _image_alpha / _lifetime;
		particle_system.emit(cutdown_struct);
	}
};

cut_down = function()
{
	if (was_cut)
	{
		return false;
	}
	if (instance_exists(obj_dw_cliff_kawkawdash))
	{
		with (obj_dw_cliff_kawkawdash.grass_boss)
		{
			cut_down_effect(other.x + 20, other.y + random_range(-30, 30));
		}
	}
	sprite_index = spr_dw_cliffs_tallgrass_cut;
	was_cut = true;
	if (chosen)
	{
		with (obj_dw_cliff_kawkawdash)
		{
			unlock_dogballoon(other.x, other.y);
		}
	}
	return true;
};
");

Apply("gml_Object_obj_dw_cliffs_tallgrass_Step_2", @"image_index = lerp(image_index, sign(touching) * sprite_get_number(sprite_index), scr_fps_lerp_rate(0.25));
if (touching && wastouching == false)
{
