		{
			scr_shakeobj();
		}
		with (mizzle)
		{
			sprite_index = spr_holywater_annoyed;
		}
		snd_play(snd_wing);
	});
	c_wait_talk();
	c_actortokris();
	c_terminatekillactors();
}
