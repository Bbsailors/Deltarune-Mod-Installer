			{
				x = -100;
				scr_caterpillar_interpolate();
			}
		}
		if (!i_ex(obj_yellow_enemy))
		{
			with (yellow_actor)
			{
				auto_depth = false;
				depth = -100;
			}
			with (blue_actor)
			{
				auto_depth = false;
				depth = -100;
			}
		}
		if (!i_ex(obj_battlecontroller))
		{
			snd_stop(global.batmusic[1]);
			snd_free(global.batmusic[1]);
			snd_stop(global.currentsong[1]);
			snd_free(global.currentsong[1]);
