Apply("gml_Object_obj_slashpusher_Other_10", @"if (minigame_pos > 1)
{
	exit;
}
if (minigame_tag != 0 && minigame_pos <= 0)
{
	exit;
}
if (hitcooldown > 0)
{
	exit;
}
if (closed_state == 1)
{
	exit;
}
if (!visible)
{
	exit;
}
if (move_mode)
{
	hitcooldown = 5;
}
else
{
	hitcooldown = 15;
}
var played_impact_sound = false;
var att = 0;
var pitch = 1;
with (obj_plat_camera)
{
	att = 1 - ((point_distance(other.x, other.y, x, y) - 300) / 200);
	for (var i = 0; i < (other.index % 7); i++)
	{
		pitch *= 1.059;
	}
}
if (!yellow_bouncer)
{
	with (obj_plat_hbx)
	{
		snd_stop(snd_smallswing);
		snd_stop(snd_heavyswing);
		snd_stop(snd_ultraswing);
		played_impact_sound = true;
		impact_sfx = 422;
		impact_volume = 0.3 * att;
		do_hbx_hit(-4, 6, 1.5);
	}
	bulb_hitstop = 6;
}
if (att > 0)
{
	if (!played_impact_sound)
	{
	}
	snd_stop(snd_glove_launch);
	var snd = snd_play(snd_glove_launch, att * 0.87, 1);
	snd_volume(snd, 0, 25);
	scr_script_delayed(snd_play, 4, 398, 0.8 * att, pitch).respect_plat_pause = false;
}
flash = 8;
var str = strength * 4;
if (autocloses || closed)
{
	closed_state = 1;
	sprite_index = spr_plat_slashpusher_closed;
}
lerptimer = 1;
if (!directional)
{
	lerpdirection = 180 + angle;
}
else if (i_ex(obj_plat_player))
{
	lerpdirection = 180 + point_direction(x, y, obj_plat_player.x, obj_plat_player.y);
}
if (!directional && i_ex(obj_plat_player))
{
	var x_perp = lengthdir_x(1, lerpdirection);
	var y_perp = lengthdir_y(1, lerpdirection);
	var dp = dot_product(x_perp, y_perp, obj_plat_player.x - x, obj_plat_player.y - y);
	str += (0.025 * dp);
}
if (!yellow_bouncer)
{
	obj_plat_player.paused = false;
	obj_plat_player.hspeed = lengthdir_x(str, 180 + lerpdirection) / global.fps_scale;
	obj_plat_player.vspeed = min(obj_plat_player.vspeed, lengthdir_y(str, 180 + lerpdirection) / global.fps_scale);
	obj_plat_player.jump_boost = true;
}
with (scr_plat_vfx(3359))
{
	image_xscale = choose(1, -1) * 2;
	image_yscale = choose(1, -1) * 2;
	image_angle = irandom(360);
}
with (scr_afterimage_grow())
{
	depth = other.depth + 1;
	image_blend = other.directional ? c_yellow : c_teal;
	image_angle = 0;
	image_index = other.image_index;
	direction = other.lerpdirection;
	speed = 2 / global.fps_scale;
}
with (instance_create(x, y, obj_animation))
{
	sprite_index = spr_vfx_directional_hit;
	image_xscale = 2;
	image_yscale = 2;
	image_speed = 0.5 / global.fps_scale;
	image_index = 1;
	depth = other.depth + 1;
	image_angle = other.lerpdirection;
}
if (minigame_pos == 1)
{
	with (obj_slashpush_minigame)
	{
		scr_update();
	}
}
");

Apply("gml_Object_obj_slashpusher_Step_0", @"event_inherited();
if ((instance_exists(obj_plat_game) && obj_plat_game.hitstop > 0) || global.pause_plat)
{
	exit;
}
bulb_hitstop -= (1 / global.fps_scale);
if (!init2)
{
	init2 = true;
	with (obj_slashpusher_anchor)
	{
		if (index == other.index)
		{
			if (!variable_instance_exists(id, ""y_plat""))
			{
				other.init2 = false;
				break;
			}
			other.leaves = self;
			flower = other;
			other.depth = depth;
			if (other.force_yplat)
			{
				var move = y_plat - y_ow;
				other.y_plat = other.y_ow + move + 60;
			}
			break;
		}
	}
	if (instance_exists(leaves))
	{
		var dist = point_distance(leaves.x, leaves.y, x, y);
		var distx = orb_x - leaves.x;
		var disty = orb_y - leaves.y;
		var ang = 90 + leaves.image_angle;
		var previous_point_x = leaves.x;
		var previous_point_y = leaves.y;
		for (var i = 0; i < (dist - 1); i += 1)
		{
			var t = i / dist;
			var newpoint_x = leaves.x + (stem_ease_x(t, 0, 1, 1) * distx);
			var newpoint_y = leaves.y + (stem_ease_y(t, 0, 1, 1) * disty);
			var _pdist = point_distance(previous_point_x, previous_point_y, newpoint_x, newpoint_y);
			if (_pdist >= orb_density)
			{
				previous_point_x = newpoint_x;
				previous_point_y = newpoint_y;
				array_push(arc_increments, t);
			}
			cull_buffer_left = max(cull_buffer_left, bbox_left - (newpoint_x - 20));
			cull_buffer_right = max(cull_buffer_right, (newpoint_x + 20) - bbox_right);
			cull_buffer_top = max(cull_buffer_top, bbox_top - (newpoint_y - 20)) + vertical_cull_buffer_add;
			cull_buffer_bottom = max(cull_buffer_bottom, (newpoint_y + 20) - bbox_bottom) + vertical_cull_buffer_add;
		}
	}
	if (pendulum_freq > 0)
	{
		cull_buffer_left = max(cull_buffer_left, 140);
		cull_buffer_right = max(cull_buffer_right, 140);
	}
}
if (is_culled)
{
	exit;
}
if (!global.pause_plat)
{
	if (disabled)
	{
		disabled_lerp = scr_approach(disabled_lerp, 1, 0.1);
	}
	else
	{
		disabled_lerp = scr_approach(disabled_lerp, 0, 0.1);
	}
	hitcooldown -= (1 / global.fps_scale);
	var lerpvar = 0;
	var lerpstrength = 0;
	var lerpmax = 0;
	if (move_mode || pendulum_freq > 0)
	{
		lerpmax = 40;
	}
	else
	{
		lerpmax = 80;
		if (draw_yellow)
		{
			lerpmax = 60;
		}
	}
	if (lerptimer > 0)
	{
		lerptimer += (1 / global.fps_scale);
		var len = 32;
		lerpstrength = lerp(lerpmax, 0, lerptimer / len);
		if (lerptimer < len)
		{
			lerpvar = sin(((lerptimer / (len / 6)) * pi) / 2);
		}
		if (lerptimer == len)
		{
			lerptimer = 0;
		}
	}
	else
	{
		anchorx = x;
		anchory = y;
	}
	if (!move_mode)
	{
		x = anchorx + lengthdir_x(lerpvar * lerpstrength, lerpdirection);
		y = anchory + lengthdir_y(lerpvar * lerpstrength, lerpdirection);
	}
	else if (!continuous_mode)
	{
		x += (move_speed / global.fps_scale);
		if (vspeed == 0)
		{
			y = anchory + lengthdir_y(lerpvar * lerpstrength, lerpdirection);
		}
		else
		{
			y += (move_speed / global.fps_scale);
		}
	}
	else
	{
		y = anchory + lengthdir_y(lerpvar * lerpstrength, lerpdirection);
		x += (continuous_speed / global.fps_scale);
		continuous_movetime += (1 / global.fps_scale);
		if (continuous_movetime >= continuous_duration)
		{
			continuous_speed = -continuous_speed;
			continuous_movetime = 0;
		}
	}
	if (!disabled && player_slashable && instance_exists(obj_plat_hbx) && instance_exists(obj_plat_player))
	{
		if (obj_plat_player.y < (y - 20))
		{
			if (place_meeting(x, y - 20, obj_plat_hbx))
			{
				event_user(0);
			}
		}
	}
	with (obj_plat_game)
	{
		if (!paused)
		{
			if (other.lifetime > -1)
			{
				other.lifetime -= (1 / global.fps_scale);
				if (other.lifetime == 0)
				{
					instance_destroy(other);
				}
			}
		}
	}
}
if (closed && closed_state == 0 && !global.pause_plat)
{
	if (closed_timer <= 0)
	{
		closed_state = 1;
		su_act.blocked = false;
		sprite_index = spr_plat_slashpusher_semiclosed;
	}
}
if (pendulum_angle != 0 && pendulum_freq != 0 && instance_exists(leaves))
{
	var amp = point_distance(leaves.xstart, leaves.ystart, xstart, ystart);
	pendulum_timer += (1 / global.fps_scale);
	var myangle = 270 + (pendulum_angle * sin((pendulum_freq * pendulum_timer) + degtorad(pendulum_offset)));
	if (lerptimer > 0)
	{
		anchorx = leaves.x + lengthdir_x(amp, myangle);
		anchory = leaves.y + lengthdir_y(amp, myangle);
	}
	else
	{
		x = leaves.x + lengthdir_x(amp, myangle);
		y = leaves.y + lengthdir_y(amp, myangle);
	}
}
if (strength > 8)
{
	petal_index = 2;
}
else if (strength > 5)
{
	petal_index = 1;
}
else
{
	petal_index = 0;
}
");

Apply("gml_Object_obj_slashpusher_anchor_Create_0", @"event_inherited();
scr_platswap_init();
flower = -4;
flower_rotate_speed = 0;

water = function(arg0)
{
	if (flower != -4)
	{
		flower_rotate_speed = min(flower_rotate_speed + (1 / global.fps_scale), 10);
	}
	on_water();
};

draw_reflection = function(arg0, arg1, arg2)
{
	with (flower)
	{
		var xxx = x;
		var yyy = y;
		y = (y - arg1) + 300;
		image_index = (angle + 12.25 + 360) / 22.5;
		shader_set_uniform_f(arg2, (yyy - arg1) + (40 * image_yscale) + 80);
		var orb_blend = orb_col;
		var _dist = 9999;
		if (instance_exists(leaves))
		{
			var _hitstop = 0;
			if (lerptimer > 0)
			{
				with (obj_plat_game)
				{
					_hitstop = hitstop;
				}
			}
			var ly = other.y - arg1;
			_dist = point_distance(leaves.x, ly, x, y);
			var distx = x - leaves.x;
			var disty = -(y - ly);
			var ang = 90 + leaves.image_angle;
			leaves.image_blend = image_blend;
			for (var i = 0; i < array_length(arc_increments); i++)
			{
				var t = arc_increments[i];
				var xs = image_xscale;
				if (_hitstop > 0)
				{
					xs += (max(sin((-9.42477796076938 - (t * 4)) + (3 * ((7 - _hitstop) / 8))), 0) * (1 - (_hitstop / 12)));
				}
				var ys = -xs;
				draw_sprite_ext(spr_plat_slashpusher_orb, 0, (leaves.x - arg0) + (stem_ease_x(t, 0, 1, 1) * distx), ly - (stem_ease_y(t, 0, 1, 1) * disty), xs, ys, 0, orb_blend, image_alpha);
			}
			with (leaves)
			{
				draw_sprite_ext(sprite_index, image_index, x - arg0, y - arg1, image_xscale, -image_yscale, image_angle, image_blend, image_alpha);
			}
		}
		if (closed_state == 1)
		{
			draw_self();
		}
		else
		{
			draw_sprite_ext(petal_sprite, petal_index, x - arg0, y, image_xscale, image_yscale, 0, image_blend, image_alpha);
			draw_self();
		}
		x = xxx;
		y = yyy;
	}
};
");

