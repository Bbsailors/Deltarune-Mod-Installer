Apply("gml_Object_obj_enemy_wave_Step_0", @"if (con == 0 && trigger_activated != """" && scr_trigcheck_ext(trigger_activated, 912))
{
	start_wave();
}
if (con == 1)
{
	var enmcount = 0;
	var all_gone = true;
	with (obj_flower_enmparent)
	{
		if (extflag == other.extflag)
		{
			all_gone = false;
			enmcount++;
		}
	}
	if (!global.pause_plat && array_length(enemy_spawn_queue) > 0)
	{
		if (enmcount < concurrent_enemy_limit)
		{
			spawn_timer += (1 / global.fps_scale);
		}
		if (spawn_timer >= spawn_delay)
		{
			spawn_timer -= spawn_delay;
			var enemy = enemy_spawn_queue[0];
			enemy.activate = true;
			array_delete(enemy_spawn_queue, 0, 1);
		}
	}
	if (all_gone)
	{
		with (obj_flower_spawner)
		{
			if (extflag == other.extflag)
			{
				all_gone = false;
				break;
			}
		}
	}
	if (all_gone)
	{
		with (obj_flower_respwn)
		{
			if (extflag == other.extflag)
			{
				all_gone = false;
				break;
			}
		}
	}
	if (time_limit > 0)
	{
		time_limit -= (1 / global.fps_scale);
		if (time_limit == 0)
		{
			with (obj_flower_enmparent)
			{
				if (extflag == other.extflag)
				{
					hp = 0;
					instance_destroy();
				}
			}
		}
	}
	if (all_gone)
	{
		end_wave();
	}
}
");

Apply("gml_Object_obj_excblcon_Create_0", @"alarm[0] = round(20 * global.fps_scale);
image_speed = 0.1 / global.fps_scale;
if (global.darkzone == 1)
{
	image_xscale = 2;
	image_yscale = 2;
}
");

Apply("gml_Object_obj_explosion_flamingbit_Alarm_0", @"var _fire = instance_create_depth((x - 2) + irandom(4), (y - 2) + irandom(4), depth, obj_slidedust);
_fire.image_xscale = choose(3, 2);
_fire.image_yscale = _fire.image_xscale;
_fire.sprite_index = spr_dust1;
_fire.image_blend = #FF8800;
_fire.image_speed = choose(1, 0.5) / global.fps_scale;
_fire.alarm[5] = _fire.image_number * (1 / _fire.image_speed);
_fire.vspeed = -1 / global.fps_scale;
alarm[0] = round(2 * global.fps_scale);
");

Apply("gml_Object_obj_explosion_flamingbit_Alarm_1", @"var _fire = instance_create_depth((x - 4) + irandom(8), (y - 4) + irandom(8), depth, obj_slidedust);
_fire.image_xscale = choose(4, 3);
_fire.image_yscale = _fire.image_xscale;
_fire.sprite_index = spr_dust1;
_fire.image_blend = #FF8800;
_fire.image_speed = choose(0.5, 0.334, 0.25, 0.2, 0.167) / global.fps_scale;
_fire.alarm[5] = _fire.image_number * (1 / _fire.image_speed);
_fire.vspeed = -2 / global.fps_scale;
alarm[1] = round((10 + irandom(10)) * global.fps_scale);
");

Apply("gml_Object_obj_explosion_flamingbit_Create_0", @"floor_y = y + 16 + random(32);
gravity_direction = 270;
gravity = 0.75 / (global.fps_scale * global.fps_scale);
life_time = 30 + irandom(75);
alarm[0] = round((1 + irandom(1)) * global.fps_scale);
alarm[1] = round((1 + irandom(9)) * global.fps_scale);
");

Apply("gml_Object_obj_explosion_flamingbit_Step_0", @"if (y >= floor_y)
{
	floor_y += random(vspeed * 3 * global.fps_scale);
	vspeed = -vspeed * 0.75;
	hspeed *= 0.9;
}
life_time -= (1 / global.fps_scale);
if (life_time <= 0)
{
	instance_destroy();
}
");

