d_circle(_hx - (sin(dripper / 10) * 2) - 4, (_hy - (cos((dripper - 4) / 10) * 5)) + 1, ((sin((dripper + 3) / 10) / 2) + 1) * _sizer, 0);
d_circle(_hx + (cos(dripper / 10) * 2) + 2, _hy + (sin((dripper - 4) / 10) * 5) + 1, ((cos((dripper + 3) / 10) / 2) + 1) * _sizer, 0);
surface_reset_target();
draw_set_blend_mode(bm_normal);
