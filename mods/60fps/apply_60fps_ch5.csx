			draw_surface_pos_fixed(surf, 0, pos.x1, pos.y1, pos.x2, pos.y2, pos.x3, pos.y3, pos.x4, pos.y4, 0.5);
			draw_sprite_ext(spr_dw_ralsei_castle_basketball_jumbo, 0, x, y, 2, 2, 0, c_white, 1);
			surface_free(surf);
		};
	}
}
