	enddist = lerp(transitiondist, targdist, clamp01(transitiontimer / 90));
	targyelcol = 5140;
	yelcol = merge_color(wasyelcol, targyelcol, clamp01(transitiontimer / 90));
}
if (con == 2)
{
	if (wascon != con)
	{
		constart();
	}
	wascon = con;
	transitiontimer += (1 / global.fps_scale);
	var targdist = 100;
	enddist = lerp(transitiondist, targdist, clamp01(transitiontimer / 200));
	targyelcol = 14392;
	yelcol = merge_color(wasyelcol, targyelcol, clamp01(transitiontimer / 200));
}
if (con == 3)
{
	if (wascon != con)
	{
		constart();
	}
	wascon = con;
	transitiontimer += (1 / global.fps_scale);
	var targdist = -50;
	enddist = lerp(transitiondist, targdist, clamp01(transitiontimer / 200));
	targyelcol = 65535;
	yelcol = merge_color(wasyelcol, targyelcol, clamp01(transitiontimer / 120));
}
timer += (1 / global.fps_scale);
angleoffset -= (1 / global.fps_scale);
if ((timer % 10) == 0)
{
	with (scr_marker_fancy(0, 0, 5804))
	{
		dad = other;
		index = other.timer / 10;
		angleinit = 0;
		angleprev = 0;
		daddy = other;
		depth = other.depth - 100;
		mydepth = depth;
		dist = 480;
		angledif = 0;
		timer = 0;
		endtime = 120;
		
		draw_func = function()
		{
			timer += (1 / global.fps_scale);
			var startdist = 800;
			var enddist = dad.enddist;
			depth = lerp(mydepth, mydepth + 100, timer / endtime);
			dist = lerp_out_cubic(startdist, 0, timer / endtime);
			var distprog = scr_xprog(dist, startdist, enddist, true);
			angledif = lerp(0, -120, timer / endtime);
			var _scale = lerp_out_cubic(2, 0, timer / endtime);
			var blend = merge_color(dad.yelcol, c_black, lerp_in_quad(0, 1, distprog));
			for (var i = 0; i < 5; i++)
			{
				var _x = dad.cam.x + 320 + lengthdir_x(dist, dad.angleoffset + angledif + ((i / 5) * 360));
				var _y = dad.cam.y + 240 + lengthdir_y(dist, dad.angleoffset + angledif + ((i / 5) * 360));
				var _ang = point_direction(_x, _y, dad.cam.x + 320, dad.cam.y + 240) + 22;
				draw_sprite_ext(spr_battleui_preshear, index + i, _x, _y, _scale, _scale, _ang, blend, 1);
			}
			if (timer >= endtime)
			{
				instance_destroy();
			}
		};
	}
}
");

