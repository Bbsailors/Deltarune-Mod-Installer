Apply("gml_Object_obj_plat_enm_yellow_punishmentgun_Step_0", @"event_inherited();
if (global.pause_plat)
{
	scr_pause_alarms();
	exit;
}
if (killed)
{
	su_act.blocked = killed;
	phase = 999;
	orbsize = scr_approach(orbsize, 0, 0.1);
	exit;
}
if (!can_attack)
{
	exit;
}
if (!init && scr_onscreen(self))
{
	init = true;
}
if (is_stunned)
{
	if (stun_timer < (stun_duration - round(10 * global.fps_scale)))
	{
		y = scr_approach(y, ystart + 176, 10);
	}
	else
	{
		y = scr_approach(y, ystart + 100, 10);
	}
}
if (!killed && collision_circle(x, y, 20 * image_xscale, obj_plat_hbx, false, true))
{
	with (obj_plat_hbx)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	if (hp == maxhp)
	{
		with (obj_plat_enm_yellow_punishmentgun)
		{
			talkcon = 3;
			event_user(10);
		}
	}
	hp--;
	hit = 1;
	shake = 4;
