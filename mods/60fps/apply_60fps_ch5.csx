{
	hspeed: 0,
	vspeed: 0,
	image_blend: c_white,
	custom_data: 0
};
repeat (2)
{
	with (instance_create(x + random_range(20, 160), random_range(60, 360), obj_animation))
	{
		sprite_index = choose(spr_omegaflowery_explosion_a, spr_omegaflowery_explosion_b, spr_omegaflowery_explosion_c);
		image_xscale = lerp(0.25, 1, (x - other.x) / 160);
		image_yscale = image_xscale;
		scr_delay_var(""image_blend"", make_color_hsv((irandom_range(1, 6) / 7) * 255, 255, 255), choose(2, 4));
		image_speed = 0.5 / global.fps_scale;
	}
}
explosions_particle_system = instance_create_depth(0, 0, depth - 1, obj_custom_particle_system);
