				instance_destroy();
			}
			scr_lerpvar(""x"", x, xstart, time);
			scr_lerpvar(""y"", y, ystart, time);
		}
		if (subcontimer == (time + 4))
		{
			if (jarona_repeat >= jarona_repeat_target)
			{
				switch_con(0);
			}
			else
