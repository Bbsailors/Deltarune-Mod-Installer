		c_msgnextloc(""\\m3\t\t*They go complete boom mic on&\tme^1, chief^1. Or like^1, a third of&\tthem does./"", ""obj_room_castle_dojo_slash_Step_0_gml_177_0"");
		c_msgnextloc(""\\m3\t\t*And they always want their&\t`#$@! in 3 4^1, with triplets./"", ""obj_room_castle_dojo_slash_Step_0_gml_178_0"");
		c_msgnextloc(""\\m3\t\t*And I'm like^1, ladies^1, I love&\tyou^1, my sweet beats^1, but 4 4&\tis good also./"", ""obj_room_castle_dojo_slash_Step_0_gml_179_0"");
		c_msgnextloc(""\\m3\t\t*But no^1, they want to hear the&\tthrees^1. So all my music is&\tturning into like^1,/"", ""obj_room_castle_dojo_slash_Step_0_gml_180_0"");
		c_msgnextloc(""\\m3\t\t*Pirate movie music dance&\tremixes^1, and just..^1. life is&\ttough^1, boss./"", ""obj_room_castle_dojo_slash_Step_0_gml_181_0"");
		c_msgnextloc(""\\m3\t\t*Man^1, when it was just me and&\tthe crew^1, we would just like/"", ""obj_room_castle_dojo_slash_Step_0_gml_182_0"");
		c_msgnextloc(""\\m3\t\t*We could interweave each&\tothers' leitmotifs all day./"", ""obj_room_castle_dojo_slash_Step_0_gml_183_0"");
		c_msgnextloc(""\\m3\t\t*Swing 'em^1. Remix 'em./"", ""obj_room_castle_dojo_slash_Step_0_gml_184_0"");
		c_msgnextloc(""\\m3\t\t*Where my boys at now^1. I don't&\tknow^1. It's been 24 hours^1. I&\tmight as well be dead./%"", ""obj_room_castle_dojo_slash_Step_0_gml_185_0"");
