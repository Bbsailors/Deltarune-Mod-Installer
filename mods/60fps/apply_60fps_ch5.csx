	c_facenext(""susie"", ""L"");
	c_msgnextloc(""\\EL* Hey^1, it's cool^1. You told me./"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_2059_0"");
	c_sel(su);
	c_spritenext(587);
	c_facenext(""susie"", ""N"");
	c_msgnextloc(""\\EN* We'll just..^1. enjoy hanging out while we're here^1, alright?/"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_2063_0"");
