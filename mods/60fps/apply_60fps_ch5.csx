			scr_lerpvar(""y"", y, y - 660, 30, 1, ""out"");
			image_xscale = sign(image_xscale);
			image_yscale = 1;
			sprite_index = spr_flowery_idle3_sweat;
			scr_lerpvar(""image_xscale"", image_xscale, image_xscale * 2, 20, 1, ""out"");
			scr_lerpvar(""image_yscale"", 1, 2, 20, 1, ""out"");
			if (extflag == ""1"")
			{
				make_writer(stringsetloc(""* G..^1. get back here!/"", ""obj_towery_flowery_slash_Step_0_gml_34_0""));
			}
			else if (extflag == ""2"")
			{
				make_writer(stringsetloc(""* You're not getting away!/"", ""obj_towery_flowery_slash_Step_0_gml_39_0""));
			}
			else if (extflag == ""3"")
			{
				make_writer(stringsetloc(""* Stop!!/"", ""obj_towery_flowery_slash_Step_0_gml_44_0""));
			}
		}
	}
}
else if (con == 1)
{
	image_alpha = scr_approach(image_alpha, 1, 0.1);
	if (timer == 22)
	{
		con = 2;
		timer = 0;
		depth = 30000;
		sprite_index = spr_flowery_puuunch_left;
		scr_delay_var(""con"", 3, 60);
		scr_doom(self, 260);
	}
}
else if (con == 2)
{
	hspeed = scr_approach(hspeed, (12 * -image_xscale) / global.fps_scale, 3 / global.fps_scale);
	vspeed = scr_approach(vspeed, -8 / global.fps_scale, 0.1 / global.fps_scale);
	var col = make_color_hsv(((current_time / 14) * 255) % 255, 255, 255);
	if ((global.time % global.fps_scale) == 0)
	{
		scr_afterimage_monochrome(col, true);
	}
}
if (con > 0)
{
	y_anchor = cameray() + 100;
}
if (con == 1)
{
	y = y_anchor;
}
if (con == 4)
{
	vspeed = scr_approach(vspeed, -32 / global.fps_scale, 2 / global.fps_scale);
	x = camerax() + 320 + (160 * sin(timer * 0.1));
	sprite_index = spr_flowery_punch_up_chase;
	image_xscale = 1.5 + (0.5 * cos(timer * 0.1));
	image_yscale = image_xscale;
	image_angle = cos(timer * 0.1) * -15;
	if (image_xscale > 1.5)
	{
		depth = 30000;
	}
	else if (instance_exists(obj_flowery_towery))
	{
		depth = obj_flowery_towery.depth + 1;
	}
	var col = make_color_hsv(((current_time / 14) * 255) % 255, 255, 255);
	if ((global.time % global.fps_scale) == 0)
	{
		scr_afterimage_monochrome(col, true);
	}
	image_alpha = 1;
}
if (monocon == 0)
{
	if (i_ex(monologue_writer))
	{
		monocon = 1;
		monotime = 0;
	}
}
if (monocon == 1)
{
	if (i_ex(monologue_writer))
	{
		if (monologue_writer.halt > 0)
		{
			monotime += (1 / global.fps_scale);
			var max_timer = (global.lang == ""ja"") ? 100 : 70;
			if (!i_ex(obj_climb_kris) && global.interact > 0)
			{
				monotime -= (1 / global.fps_scale);
			}
			if (monotime >= max_timer)
			{
				with (monologue_writer)
				{
					instance_destroy();
				}
				monotime = 0;
				monocon = 0;
			}
		}
	}
}
");

