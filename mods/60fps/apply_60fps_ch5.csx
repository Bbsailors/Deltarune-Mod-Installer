	else if (!failed_puzzle)
	{
		var play_error = true;
		with (obj_pushable_block)
		{
			var adjacent_box_count = 0;
			with (obj_pushable_block)
			{
				if ((x == other.x && abs(y - other.y) == 40) || (y == other.y && abs(x - other.x) == 40))
				{
					adjacent_box_count++;
				}
			}
			if (adjacent_box_count != 2)
			{
				play_error = false;
				break;
			}
		}
		if (play_error)
		{
			failed_puzzle = true;
		}
