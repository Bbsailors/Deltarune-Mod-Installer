			scr_act_charsprite(""susie"", spr_susie_hairs, 0, 1);
		}
		if (rand == 1)
		{
			scr_act_charsprite(""susie"", spr_susie_hairs2, 0, 1);
		}
		if (rand == 2)
		{
			scr_act_charsprite(""susie"", spr_susie_hairs3, 0, 1);
		}
		global.flag[1888] = 1;
		if (simulordersus == 0)
		{
			actconsus = 20;
		}
		else
		{
			actconsus = 0;
		}
	}
	if (actingral == 1 && actconral == 1)
	{
		msgsetloc(0, ""* Ralsei received a haircut!"", ""obj_sheary_enemy_slash_Step_0_gml_272_0"");
		scr_simultext(""ralsei"");
		scr_mercyadd(myself, 40);
