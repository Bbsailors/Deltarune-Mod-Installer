function overlay_layer(arg0, arg1, arg2, arg3, arg4) constructor
{
	_color = arg0;
	_alpha = arg1;
	_layer_index = arg4;
	_target_alpha = arg2;
	_time = arg3;
	_timer = 0;
	
	function get_color()
	{
		return _color;
	}
	
	function get_alpha()
	{
		return _alpha;
	}
	
	function get_layer_index()
	{
		return _layer_index;
	}
	
	function fade(arg0)
	{
		_timer += (1 / global.fps_scale);
		if (_target_alpha > 0)
		{
			_alpha = clamp(_timer / _time, 0, 1);
		}
		else
		{
			_alpha = 1 - clamp(_timer / _time, 0, 1);
		}
	}
	
	function update_fade(arg0, arg1)
	{
		_target_alpha = arg0;
		_time = arg1;
		_timer = 0;
	}
}

