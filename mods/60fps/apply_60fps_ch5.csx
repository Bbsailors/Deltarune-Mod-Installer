					if (menuOptions[mpos].watched)
					{
						msgsetloc(0, ""* Have this break again?/"", ""obj_dw_fcastle_cafe_slash_Draw_0_gml_265_0"");
					}
					scr_readychoicer(opt1, opt2);
					d_make();
				}
			}
		}
		else if (button2_p())
		{
			resetcamera = true;
			resetcameratimer = 0;
			mpos = remmpos;
			menu = 0;
			global.interact = 0;
