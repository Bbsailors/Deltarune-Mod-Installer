trial_done[2] = false;
trial_done[3] = false;
aqua_wrong_counter = 0;
aqua_scissor_counter = 0;
outfit = irandom(1);

yellow_balloon_control = function()
{
	if ((button3_p() && talktimer > 15) || !instance_exists(obj_writer))
	{
		with (obj_writer)
		{
			instance_destroy();
		}
		if (i_ex(obj_balloon_queue))
		{
			msgset_fromqueue();
		}
	}
};

yellow_balloon = function(arg0 = x - 20, arg1 = y + 25)
{
	if (i_ex(obj_balloon_queue))
	{
		msgset_fromqueue();
	}
};

yellow_justice_check = function()
{
	var justice = true;
	var dog = true;
	for (var a = 0; a < 7; a++)
	{
		if (evidence_obtained[a])
		{
			dog = false;
		}
	}
	if (!dog)
	{
		if (!evidence_obtained[trial_counter])
		{
			justice = false;
		}
	}
	global.canact[myself][1] = 1;
	global.actname[myself][1] = stringsetloc(""Justice"", ""obj_yellow_enemy_slash_Create_0_gml_312_0"");
	global.actactor[myself][1] = 4;
	if (justice)
	{
		global.actdesc[myself][1] = stringsetloc(""Begin#the trial."", ""obj_yellow_enemy_slash_Create_0_gml_317_0"");
		global.actcost[myself][1] = justice_cost;
	}
	else
	{
		global.actdesc[myself][1] = stringsetloc(""Need more#EVIDENCE!"", ""obj_yellow_enemy_slash_Create_0_gml_322_0"");
		global.actcost[myself][1] = 2497.5;
	}
};

callback_on_damage = function(arg0 = -1)
{
	var _maxhp = global.monstermaxhp[global.chartarget[arg0.myself]];
	var _hp = global.monsterhp[global.chartarget[arg0.myself]];
	if (_hp <= 1)
	{
		global.monsterhp[global.chartarget[arg0.myself]] = 1;
	}
};
");

Apply("gml_Object_obj_yellow_enemy_Step_0", @"if (global.monster[myself] == 1)
