spawn_petals = function(arg0, arg1, arg2, arg3 = 1, arg4 = 0)
{
	var _dir = 270 + irandom_range(-5, 5);
	var _len = irandom(50);
	with (instance_create(arg0 + lengthdir_x(_len, _dir), arg1 + 20 + lengthdir_y(_len * 0.5, _dir), obj_marker_parallax))
	{
		sprite_index = spr_falling_petal;
		image_index = irandom(4);
		is = 0.125 * choose(1, 0.5, 0.75);
		image_blend = merge_color(c_yellow, c_red, arg4);
		scr_darksize();
		parallax_depth = other.parallax_depth;
		_p = other;
		if (variable_instance_exists(other.id, ""_p_d""))
		{
			depth = other._p_d + 1000;
		}
		else
		{
			depth = _p.depth + 1000;
		}
		direction = _dir;
		gravity_direction = 270;
		ys = random_range(0.35, 0.5) * arg3 * 4;
		image_xscale = choose(2, -2);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer += (1 / global.fps_scale);
				image_speed = is / global.fps_scale;
				vspeed -= (ys / (global.fps_scale * global.fps_scale));
				x = xstart + (sin(timer * 0.22) * ((timer * 0.5) + 4) * image_xscale * 0.5);
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};
");

Apply("gml_Object_obj_yellow_background_controller_Step_0", @"if (global.pause_plat)
{
	exit;
}
sinertimer += (1 / global.fps_scale);
if (movecon == -1)
{
}
if (movecon == 0)
{
	if (i_ex(obj_plat_player))
	{
		if (scr_trigcheck_ext(""default_anchor"", 912))
		{
			anchoroffset_x = 560;
			anchoroffset_y = 100;
		}
		else if (scr_trigcheck_ext(""bottom_anchor"", 912))
		{
			anchoroffset_x = 400;
			anchoroffset_y = 140;
		}
		else if (scr_trigcheck_ext(""bottom_right_anchor"", 912))
		{
			anchoroffset_x = 560;
			anchoroffset_y = -40;
		}
		else if (scr_trigcheck_ext(""middle_anchor"", 912))
		{
			anchoroffset_x = 300;
			anchoroffset_y = -120;
		}
		else if (scr_trigcheck_ext(""top_right_anchor"", 912))
		{
			anchoroffset_x = 560;
			anchoroffset_y = -80;
		}
		var cx = camerax();
		var cy = cameray();
		var anchorx = cx + anchoroffset_x;
		var anchory = cy + anchoroffset_y;
		if (x < (anchorx - 20))
		{
			if (hspeed >= 0)
			{
				hspeed += (0.25 / (global.fps_scale * global.fps_scale));
			}
			else if (hspeed < 0)
			{
				hspeed += (0.5 / (global.fps_scale * global.fps_scale));
			}
		}
		else if (x > (anchorx + 20))
		{
			if (hspeed > 0)
			{
				hspeed -= (0.5 / (global.fps_scale * global.fps_scale));
			}
			else if (hspeed <= 0)
			{
				hspeed -= (0.25 / (global.fps_scale * global.fps_scale));
			}
		}
		if (y < (anchory - 20))
		{
			if (vspeed >= 0)
			{
				vspeed += (0.25 / (global.fps_scale * global.fps_scale));
			}
			else if (vspeed < 0)
			{
				vspeed += (0.5 / (global.fps_scale * global.fps_scale));
			}
		}
		else if (y > (anchory + 20))
		{
			if (vspeed > 0)
			{
				vspeed -= (0.5 / (global.fps_scale * global.fps_scale));
			}
			else if (vspeed <= 0)
			{
				vspeed -= (0.25 / (global.fps_scale * global.fps_scale));
			}
		}
		hspeed = clamp(hspeed, -14 / global.fps_scale, 14 / global.fps_scale);
		vspeed = clamp(vspeed, -12 / global.fps_scale, 12 / global.fps_scale);
	}
	else
	{
		hspeed = scr_approach(hspeed, 0, 0.2 / global.fps_scale);
		vspeed = scr_approach(vspeed, 0, 0.2 / global.fps_scale);
	}
}
else if (movecon == 1)
{
	hspeed = scr_approach(hspeed, 0, 0.18 / global.fps_scale);
	vspeed = scr_approach(vspeed, 0, 0.18 / global.fps_scale);
	var gm = scr_genmarker(""yellow_position_end"");
	y = lerp(y, gm.y, scr_fps_lerp_rate(0.1));
	finaltimer += (1 / global.fps_scale);
	if (finaltimer == 30)
	{
		sprite_index = spr_yellow_fidgeting;
		image_speed = 0;
		image_xscale = 2;
	}
	if (finaltimer == 120)
	{
		visible = 0;
	}
	var yel = id;
	with (obj_dw_fcastle_yellowblue)
	{
		with (npc_blue_atstart)
		{
			depth = yel.depth + 1;
			if (parallax_depth < 0.6)
			{
				parallax_depth = 0.6;
				fog_alpha = 0.4;
				animstate = 7;
				physics = 0;
				wallcollision = 0;
				x = yel.x + 1000;
				ystart = yel.y - 300;
				image_xscale = 2;
				force_animation(6670);
			}
			x = lerp(x, yel.x + 84, scr_fps_lerp_rate(0.1));
			ystart = lerp(ystart, yel.y + 100, scr_fps_lerp_rate(0.1));
			if (yel.finaltimer == 120)
			{
				animstate = 7;
				force_animation(5612);
				sprite_image_index = 0;
				image_speed = 0;
			}
			if (yel.finaltimer == 220)
			{
				force_animation(3049);
				sprite_image_index = 0;
				animstate = 2;
				image_speed = 0;
			}
			if (yel.finaltimer == 224)
			{
				sprite_image_index = 1;
			}
			if (yel.finaltimer == 227)
			{
				force_animation(7754);
				image_speed = 0.25 / global.fps_scale;
				animstate = 7;
			}
			if (yel.finaltimer == 250)
			{
				force_animation(2160);
				yel.movecon = 2;
				yel.hspeed = 0;
				yel.vspeed = 0;
				animstate = 7;
			}
		}
	}
}
else if (movecon == 2)
{
	hspeed = scr_approach(hspeed, 7 / global.fps_scale, 0.35 / global.fps_scale);
	vspeed = scr_approach(vspeed, -12 / global.fps_scale, 0.3 / global.fps_scale);
	var yel = id;
	with (obj_dw_fcastle_yellowblue)
	{
		with (npc_blue_atstart)
		{
			depth = yel.depth + 1;
			x = yel.x + 84;
			ystart = yel.y + 100;
		}
	}
}
if ((sinertimer % 4) == 0 && scr_onscreen_tolerance(self, 250))
{
	if (!visible)
	{
		var yel = id;
		with (obj_dw_fcastle_yellowblue)
		{
			with (npc_blue_atstart)
			{
				yel.parallax_x = parallax_x - 40;
				yel.parallax_y = parallax_y - 40;
				yel.parallax_depth = parallax_depth;
			}
		}
	}
	spawn_petals(x + 36, y + 104, depth + (1000 * parallax_depth), 0.1, parallax_depth);
}
with (obj_blue_platform)
{
	if (explodetimer > 0)
	{
		other.sprite_index = spr_yellow_shoot_background;
		var pd = other.parallax_depth;
		if (explodetimer == 5)
		{
			stop_sound();
			scr_lerpvar_instance(other, ""image_index"", 0, 4, 10);
			var spawnx = other.x + 2;
			var spawny = other.y + 50;
			with (instance_create_depth(spawnx, spawny, other.depth, obj_marker_parallax))
			{
				_hspeed = (other.x - x) / 5 / global.fps_scale;
				_vspeed = (other.y - y) / 5 / global.fps_scale;
				sprite_index = spr_smallbullet;
				image_xscale = 1;
				image_yscale = 1;
				parallax_depth = pd;
				image_blend = c_yellow;
				snd_play(snd_whack_absurdlyloud, 0.1, 1);
				snd_play(snd_glove_launch, 1, 1);
				
				step_func = function()
				{
					if (!global.pause_plat)
					{
						var steps = 4;
						repeat (steps)
						{
							parallax_depth -= (0.12 / global.fps_scale / steps);
							image_xscale += (0.2 / global.fps_scale / steps);
							image_yscale += (0.2 / global.fps_scale / steps);
							x += (_hspeed / steps);
							y += (_vspeed / steps);
							scr_afterimage_monochrome_parallax(65535, false, parallax_depth).image_alpha = 0.3;
						}
					}
				};
				
				scr_doom(self, 5);
			}
		}
	}
}
with (obj_shootable_terrain)
{
	if (explodetimer > 0 && image_index == 0)
	{
		with (obj_dw_fcastle_yellowblue)
		{
			with (yellow_bubble)
