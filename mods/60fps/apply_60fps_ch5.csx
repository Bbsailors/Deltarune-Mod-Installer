	c_speaker(""orange"");
	c_msgsetsubloc(0, ""~1* Ha-HA^1! You chibbies talking~2about ME!?/%"", (global.lang == ""ja"") ? ""\\m2\t\t\t"" : ""\\m2\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_145_0"");
	c_talk_wait();
	c_wait(10);
	c_sel(ra);
