	draw_text_transformed(440, 320, stringsetloc(""Now Playing"", ""obj_fusionmenu_slash_Draw_0_gml_194_0""), 1, 1, 0);
	draw_text_transformed(440, 345, tickerSongName, 1, 1, 0);
}
