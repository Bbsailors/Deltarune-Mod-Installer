		}
		gpu_set_fog(0, c_white, 0, 0);
	}
	if ((turnredtimer % 15) == 0)
	{
		var smokey = instance_create(x + 50, y + 35 + irandom(20), obj_afterimage_grow);
		with (smokey)
		{
			scr_script_delayed(scr_var, 1, ""visible"", 1);
		}
		smokey.visible = 0;
		smokey.depth = depth + 10;
		smokey.image_alpha = 2.5;
		smokey.sprite_index = spr_cakesmoke;
		smokey.hspeed = random_range(2, 4) / global.fps_scale;
		if (idlesprite == spr_pink_run || idlesprite == spr_mew_kick_r || idlesprite == spr_pink_yelling_r || idlesprite == spr_pink_shocked_r || idlesprite == spr_mew_pushing)
		{
			smokey.hspeed = random_range(-2, -4) / global.fps_scale;
		}
		smokey.gravity = -0.5 / (global.fps_scale * global.fps_scale);
		smokey.friction = 0.2 / (global.fps_scale * global.fps_scale);
		smokey.vspeed = random_range(-1, -2) / global.fps_scale;
	}
	if (saturation_effect_enabled)
	{
		shader_replace_simple_reset_hook();
	}
	exit;
}
if ((state == 3 && hurttimer >= 0) || hurtcon > 0)
{
