	{
		con = 10;
	}
}
if (phone_throw)
{
	phone_throw_timer += (1 / global.fps_scale);
	if (phone_throw_timer == (1 / global.fps_scale))
	{
		var phone_marker = scr_marker(su_actor.x + 30, su_actor.y - 8, spr_cellphone_diagonal);
		phone_marker.depth = su_actor.depth - 50;
		phone_marker.hspeed = 10 / global.fps_scale;
		phone_marker.vspeed = -10 / global.fps_scale;
		phone_marker.gravity = 0.8 / (global.fps_scale * global.fps_scale);
		scr_doom(phone_marker, 60);
	}
	if (phone_throw_timer == 30)
	{
		snd_play_x(snd_noise, 0.8, 0.8);
	}
}
if (susie_ice)
{
	if (susie_ice_timer == 0)
	{
		susie_ice_flip++;
	}
	susie_ice_timer += (1 / global.fps_scale);
	if (susie_ice_timer > 0)
	{
		var target_x = ((susie_ice_flip % 2) == 0) ? 95 : 245;
		with (su_actor)
		{
			sprite_index = (target_x == 95) ? spr_susie_walk_ice_cream_left : spr_susie_walk_ice_cream_right;
		}
		with (su_actor)
		{
			x = scr_movetowards(x, target_x, 3 / global.fps_scale);
		}
		if (susie_ice_timer >= 45)
		{
			susie_ice_timer = 0;
		}
	}
}
if (ocean_sound_start)
{
	ocean_sound_start = false;
	oceansong[0] = snd_init(""ocean.ogg"");
	oceansong[1] = mus_loop(oceansong[0]);
	mus_volume(oceansong[1], 0, 0);
	mus_volume(oceansong[1], 0.5, 30);
}
if (ocean_sound_stop)
{
	ocean_sound_stop = false;
	mus_volume(oceansong[1], 0, 30);
	scr_script_delayed(snd_free, 31, oceansong[1]);
}
if (susie_flip)
{
	if (su_actor.image_xscale < 0)
	{
		with (su_actor)
		{
			scr_flip(""x"");
		}
	}
	susie_flip = false;
}
global.tempflag[63] = face_extended;
if (exit_attempt)
{
	if (exit_con == 3 && !d_ex())
	{
		exit_con = 4;
		obj_mainchara.x = kr_actor.x;
		obj_mainchara.y = kr_actor.y;
		with (kr_actor)
		{
			visible = 0;
		}
		with (obj_mainchara)
		{
			visible = 1;
		}
		global.interact = 0;
		global.facing = 0;
	}
	if (exit_con == 4 && global.interact == 0)
	{
		if (left_h() || right_h() || up_h() || down_h())
		{
			kris_move_frame_timer++;
			if (kris_move_frame_timer >= global.fps_scale)
			{
				kris_move_frame_timer -= global.fps_scale;
				kris_move_timer++;
				if (i_ex(obj_mainchara))
				{
					var logical_bwspeed = obj_mainchara.bwspeed * global.fps_scale;
					logical_bwspeed = clamp(logical_bwspeed - (kris_move_timer * 0.02), 0, 1);
					if (obj_mainchara.run == 1)
					{
						logical_bwspeed -= 0.04;
					}
					obj_mainchara.bwspeed = logical_bwspeed / global.fps_scale;
					if (logical_bwspeed <= 0)
					{
						exit_con = 5;
						scr_delay_var(""exit_con"", 6, 1);
						kr_actor.x = obj_mainchara.x;
						kr_actor.y = obj_mainchara.y;
						with (kr_actor)
						{
							visible = 1;
						}
						with (obj_mainchara)
						{
							visible = 0;
						}
						global.interact = 1;
						if (right_h())
						{
							exit_fall_sprite = 2502;
						}
					}
				}
			}
		}
	}
	if (exit_con == 6)
	{
		exit_attempt = false;
		obj_mainchara.bwspeed = 3 / global.fps_scale;
	}
}
if (zorgon_mode)
{
