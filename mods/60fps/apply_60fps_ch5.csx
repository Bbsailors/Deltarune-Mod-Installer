			move = false;
		}
	}
	else if (obj_heart.box_factor == 0 && (x - _xs) > obj_heart.x && point_distance(x - _xs, 0, obj_heart.x, 0) < 300 && point_distance(y, 0, obj_heart.y, 0) > (_ys / 2))
	{
		y = scr_approach(y, obj_heart.y, 1);
	}
	ripple_left += ((ripple_l2 - ripple_left) * scr_fps_lerp_rate(0.1));
	ripple_right += ((ripple_r2 - ripple_right) * scr_fps_lerp_rate(0.1));
	ripple_l2 = scr_approach(ripple_l2, 0, 0.5);
	ripple_r2 = scr_approach(ripple_r2, 0, 0.5);
	if (obj_heart.dash_h > 0 || obj_heart.grav_h < 0)
	{
		if (collision_rectangle(x - _xs - 8, (y - _ys) + 4, (x - _xs) + 8, (y + _ys) - 4, obj_heart, 0, 0))
		{
			if (splash_a2 != 1)
			{
				ripple_left = 2;
				ripple_l2 = 2;
				ripple_spd = 100;
			}
			if (obj_heart.dash_h > 2 && splash_a2 == 0)
			{
				ripple_left = -1;
				ripple_l2 = 5;
				splash_a2 = 1;
				splash_ind2 = 1;
				splash_y = obj_heart.y - y;
			}
		}
		if (collision_rectangle(x + _xs, y - _ys, (x + _xs) - 4, y + _ys, obj_heart, 0, 0))
		{
			if (splash_a != 1)
			{
				ripple_right = 2;
				ripple_r2 = 2;
				ripple_spd = 100;
			}
			if (obj_heart.dash_h > 0 && obj_heart.grav_h == 0 && splash_a == 0)
			{
				ripple_right = -1;
				ripple_r2 = 5;
				splash_a = 1;
				splash_ind = 0;
				splash_y = obj_heart.y - y;
			}
		}
	}
	if (splash_a == 1)
	{
		splash_ind += (0.5 / global.fps_scale);
		if (splash_ind > 8)
		{
			splash_a = 0;
		}
	}
	if (splash_a2 == 1)
	{
		splash_ind2 += (0.5 / global.fps_scale);
		if (splash_ind2 > 8)
		{
			splash_a2 = 0;
		}
	}
	if (wait < 0 && canmove)
	{
		while (abs(_h) >= 1)
		{
			if (place_meeting(x + sign(h_spd), y, obj_heart) && obj_heart.dash_act == 0)
			{
				obj_heart.x += sign(h_spd);
			}
			x += sign(h_spd);
			_h -= sign(_h);
		}
		while (abs(_v) >= 1)
		{
			if (place_meeting(x, y + sign(v_spd), obj_heart) && obj_heart.dash_act == 0)
			{
				obj_heart.y += sign(v_spd);
			}
			y += sign(v_spd);
			_v -= sign(_v);
		}
	}
}
else
{
	alpha2 -= (0.2 / global.fps_scale);
	if (alpha2 <= 0)
	{
		instance_destroy();
	}
}
