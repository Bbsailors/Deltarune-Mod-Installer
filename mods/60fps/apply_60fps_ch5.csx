cloudtimer = 0;
guncon = 0;
guntimer = 0;
next_gun_side = 1;
last_ground = -4;
cutscenecon = 0;
TARGET_PLOT = 455;
cleared_room = global.plot >= TARGET_PLOT;
if (global.plot >= (TARGET_PLOT - 1))
{
	cutscenecon = 1;
}
fallstate = 0;
flower_comment_con = 0;
bounceflower = -4;
bounceflower_leaves = -4;

make_bounceflower = function(arg0)
{
	var gm = scr_genmarker(""bounceflower"");
	bounceflower = instance_create(gm.x, gm.y, obj_slashpusher);
	with (bounceflower)
	{
		scr_plat_depthcast();
		index = 99;
		angle = 90;
		strength = 10.2;
		orb_x = x;
		orb_y = y;
		if (other.cleared_room)
		{
			strength = 22.1;
		}
		stem_ease_x = ease_out_quad;
		stem_ease_y = ease_in_quad;
		scr_delay_var(""force_yplat"", true, 4);
		scr_delay_var(""y_plat"", ystart, 4);
	}
	gm = scr_genmarker(""bounceflower_leaves"");
	bounceflower_leaves = instance_create(gm.x, gm.y, obj_slashpusher_anchor);
	with (bounceflower_leaves)
	{
		scr_darksize();
		index = 99;
		image_angle = 270;
	}
	if (arg0)
	{
		scr_plat_depthcast();
		var xx = bounceflower.x;
		var yy = bounceflower.y;
		bounceflower.x = bounceflower_leaves.x + 60;
		bounceflower.y = bounceflower_leaves.y;
		scr_lerpvar_instance(bounceflower, ""x"", bounceflower.x, xx, 12, -1, ""out"");
		scr_lerpvar_instance(bounceflower, ""y"", bounceflower.y, yy, 16, -1, ""out"");
	}
};

terrain_destroyed = function()
{
	con = 1;
	make_bounceflower(true);
};

npc_blue_atstart = scr_plat_makeactor_fromasset(findspriteinfo(spr_blue_walk_l, undefined));

spawn_blue_petals = function(arg0, arg1, arg2, arg3 = 1, arg4 = 0)
{
	with (instance_create(arg0 + (random_range(-1, 1) * 60), arg1 + (random_range(-1, 1) * 60), obj_marker_parallax))
	{
		parallax_depth = arg4;
		depth = arg2 + 10;
		sprite_index = spr_bellsparkle;
		image_xscale = random_range(1, 2) * lerp(1, 0.5, arg4);
		image_yscale = image_xscale;
		image_blend = merge_color(merge_color(c_white, c_blue, random_range(0.25, 0.75)), scr_get_sunset_fade_color(), arg4);
		is = (0.5 / global.fps_scale) * choose(1, 0.5, 0.75);
		timer = 0;
		
		step_func = function()
		{
			if (!global.pause_plat)
			{
				timer++;
				image_speed = is;
				hspeed = scr_approach(hspeed, 0, 0.05 / global.fps_scale);
				image_alpha -= (0.016666666666666666 / global.fps_scale);
				if (image_alpha <= 0)
				{
					instance_destroy(id);
				}
			}
			else
			{
				vspeed = 0;
				image_speed = 0;
			}
		};
	}
};

yellow_bubble = -4;

make_yellow_bubble = function(arg0, arg1, arg2, arg3, arg4, arg5)
{
	with (yellow_bubble)
	{
		instance_destroy();
	}
	yellow_bubble = scr_messagebubble(arg5, arg1, arg2, arg0, -2);
	yellow_bubble.xoffset = arg3;
	yellow_bubble.yoffset = arg4;
	yellow_bubble.depth = max(50000, arg0.depth - 1000);
	yellow_bubble.dropColor = merge_color(c_yellow, c_black, 0.25);
	yellow_bubble.textbubbleColor = merge_color(c_yellow, c_white, 0.75);
};
");

