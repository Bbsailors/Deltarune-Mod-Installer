	if (landed)
	{
		var frames = [0, 8];
		if (endjumping)
		{
			dojumping = false;
		}
		else if (aqua.x < target.x)
		{
			target.x += random_range(50, 80);
		}
		else
		{
			target.x -= random_range(50, 80);
		}
		if (target.x > aqua.x)
		{
			frames = [8, 0];
		}
		aquajumptoplace(target, frames[0], frames[1], 1.5, -12);
		landed = false;
	}
