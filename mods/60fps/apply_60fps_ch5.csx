{
	instance_create(x - 19, y - 38, obj_mainchara);
}
with (obj_mainchara)
{
	x = other.x - 19;
	y = other.y - 38;
	global.facing = 1;
	if (other.image_xscale < 0)
	{
		global.facing = 3;
	}
	if (instance_place(x, y, obj_solidblock))
	{
		x -= other.hspeed;
	}
	if (instance_place(x, y, obj_solidblock))
	{
		x = other.last_openX - 19;
		y = other.last_openY - 38;
	}
	for (var iter = 0; place_meeting(x, y, obj_solidblock) && iter < 5; iter++)
	{
		y -= 2;
	}
	for (var iter = 0; place_meeting(x, y, obj_solidblock) && iter < 5; iter++)
	{
		if (iter == 0)
		{
			y += 10;
