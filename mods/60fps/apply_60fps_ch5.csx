		{
			bell_fail_con = 99;
		}
	}
};

if (image_yscale > 2)
{
	sprite_index = spr_plat_bell_cluster;
	image_speed = 0.1 / global.fps_scale;
	image_xscale = 2;
	image_yscale = 2;
}
scr_plat_make_pauseable(id);
su_act = scr_configure_platmode_act(ringbell, ""su"", stringsetloc(""Bellbuster"", ""obj_plat_pinatabell_slash_Create_0_gml_25_0""), stringsetloc(""Lemme take a shot."", ""obj_plat_pinatabell_slash_Create_0_gml_25_1""));
hit_cooldown = 0;

explode = function()
{
	var xx = x + lengthdir_x(0.5 * sprite_height, direction - 90);
	var yy = y + lengthdir_y(0.5 * sprite_height, direction - 90);
	var particle_system = instance_create_depth(xx, yy, depth - 1, obj_custom_particle_system);
	particle_system.auto_cleanup = true;
	particle_system.default_particle_data.sprite_index = spr_tinysparkle_x;
	particle_system.default_particle_data.image_speed = 0.5;
	particle_system.default_particle_data.friction = 0.05;
	particle_system.default_particle_data.lifetime = 60;
	for (var i = 0; i < 20; i++)
	{
		var dir = (i / 20) * 360;
		particle_system.emit(
		{
			gravity: random_range(0.3, 0.6),
			hspeed: lengthdir_x(6, dir),
			vspeed: lengthdir_y(6, dir)
		}, true);
	}
	for (var i = 0; i < 6; i++)
	{
		var dir = random_range(-25, 25) * 90;
		var randspeed = random_range(7, 12);
		particle_system.emit(
		{
			gravity: random_range(0.8, 1),
			hspeed: lengthdir_x(randspeed, dir),
			vspeed: lengthdir_y(randspeed, dir),
			sprite_index: spr_bell_shard,
			image_index: random(3),
			image_speed: 0,
			lifetime: 180,
			image_angle: random_range(0, 300)
		}, true);
	}
	
	particle_system.particle_step_func = function(arg0)
	{
		if (arg0.lifetime == 60)
		{
			arg0.image_alpha = arg0.image_alpha - (0.016666666666666666 / global.fps_scale);
		}
		else
		{
			arg0.image_angle += 16 / global.fps_scale;
		}
	};
	
	snd_play(snd_glassbreak);
	scr_plat_makecoins(x, y, coincount, 90, 45, 8, 4, undefined, undefined, true);
	broken = true;
	if (flag > 0)
	{
		global.flag[flag] = scr_set_bitmask_value(global.flag[flag], flagbit, 1, 1);
	}
};

on_hit = function(arg0)
{
};

act_draw = function()
{
	if (!broken)
	{
		draw_self();
	}
};

if (flag > 0)
{
	var bust = scr_get_bitmask_value(global.flag[flag], flagbit, 1);
	if (bust)
	{
		broken = true;
	}
}
");

