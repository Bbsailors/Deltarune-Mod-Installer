thrash_slash_particle_system.default_particle_data.sprite_index = spr_thrash_slash;
thrash_slash_particle_system.default_particle_data.image_speed = 0;
thrash_slash_particle_system.default_particle_data.image_alpha = 0.8;
thrash_slash_particle_system.default_particle_data.image_xscale = 0.65;
thrash_slash_particle_system.default_particle_data.image_yscale = 6;
