Apply("gml_Object_obj_climb_orb_Draw_0", @"siner += (1 / global.fps_scale);
if (con == 1)
{
	var pitch = 1.4;
	if (value > 1)
	{
		pitch = 1.15;
	}
	snd_play(snd_coin, 0.7, pitch);
	if (value > 1)
	{
		snd_play_delay(snd_coin, 2, 0.4, pitch * 0.75);
	}
	snd = 375;
	var delaytime = 6;
	var decay = 0.2;
	var vol = 1;
	snd_play(snd, vol, 1.5);
	var count = 1;
	snd_play_delay(snd, 1 + (delaytime * count) + 1, vol - (count * 0.2), 1.5 - (decay * count));
	count++;
	snd_play_delay(snd, 1 + (delaytime * count) + 3, vol - (count * 0.2), 1.5 - (decay * count));
	count++;
	snd_play_delay(snd, 1 + (delaytime * count) + 5, vol - (count * 0.2), 1.5 - (decay * count));
	count++;
	var thedepth = 0;
	with (obj_climb_kris)
	{
		thedepth = depth - 1;
	}
	with (instance_create_depth(x + 20, y + 20, thedepth, obj_textmarker))
	{
		if (obj_climb_kris.onrotatingtower)
		{
			x = obj_rotating_tower_controller_new.tower_x;
		}
		font = global.damagefontgold;
		mystring = ""+"" + string(other.value) + ""$"";
		vspeed = -4 / global.fps_scale;
		friction = 0.25 / (global.fps_scale * global.fps_scale);
		outline = false;
		scr_doom(id, 30);
	}
	scr_lerpvar(""image_alpha"", image_alpha, 0, 40, 2, ""out"");
	scr_lerpvar(""bowlindex"", 0, 15, 40, 2, ""out"");
	con = 2;
}
if (!dodraw)
{
	exit;
}
draw_set_alpha(image_alpha);
var _count = 32;
var light = 16777215;
var dark = 13212566;
var mycol = merge_color(c_white, c_gray, bowlindex / 15);
var mysprite = 5463;
var sinamt = sin(siner / 20) * 6 * clamp(1 - (bowlindex / 7), 0, 1);
if (con == 0)
{
	draw_sprite_ext(mysprite, siner / 4, x + 20, y + 20 + (sin(siner / 20) * 4), 2, 2, 0, c_white, 1);
}
draw_set_alpha(1);
");

Apply("gml_Object_obj_climb_scissors_Draw_0", @"animindex += (0.25 / global.fps_scale);
draw_sprite_ext(spr_scissor_nodancer, animindex, x + 20, y + 20, 2, 2, angle, c_white, 1);
");

Apply("gml_Object_obj_climb_scissors_Step_0", @"trigger_cooldown -= (1 / global.fps_scale);
if (always_retrigger && trigger_cooldown <= 0)
{
	check_trigger();
}
if (con == 0)
{
	visible = false;
	if (trig == ""noone"")
	{
		if (instance_exists(collision_line(x + 20, y, x + 20, y - 180, obj_climb_kris, false, true)))
		{
			visible = true;
			con = 1;
		}
	}
	else
	{
		check_trigger();
	}
}
if (con == 1)
{
	x = xstart;
	y = cameray() + 240 + (240 * movedirection) + (movespeed / global.fps_scale);
	con = 2;
	if (movedirection == -1)
	{
		angle = 270;
	}
	vsp = -movespeed / global.fps_scale;
	timer = 0;
}
if (con == 2)
{
	if (global.interact == 0)
	{
		if (!haveeaten)
		{
			if (instance_place(x, y, obj_climb_climbable) || instance_place(x, y, obj_climb_vinecuttable))
			{
				haveeaten = true;
			}
		}
		if (haveeaten)
		{
			if (!instance_place(x, y, obj_climb_climbable) && !instance_place(x, y, obj_climb_vinecuttable))
			{
				timer += (1 / global.fps_scale);
			}
			else
			{
				timer = 0;
			}
		}
		if (timer >= endtime || scr_trigcheck_ext(""scissor_despawn_"" + string(movedirection), self))
		{
			if (destroy_on_complete)
			{
				instance_destroy();
				exit;
			}
			con = 3;
			timer = 1 - (1 / global.fps_scale);
			with (scr_marker_ext(x + 20, y + 20, 7346, 2, 2, 0.25 / global.fps_scale, animindex, undefined, depth, undefined, undefined, undefined, true))
			{
				vspeed = -other.movespeed / global.fps_scale;
				timer = 0;
				image_angle = other.angle;
				
				step_func = function()
				{
					image_alpha -= ((1/30) / global.fps_scale);
					if (image_alpha <= 0.01)
					{
						instance_destroy();
					}
				};
			}
			visible = false;
			setxy(room_width * 4, room_height * 4);
		}
		y += vsp;
	}
}
with (obj_climb_kris)
{
	if ((fallingcon > 0 && fallingtimer < 10) || jumping || graboncon > 0)
	{
