			}
			if (variation == 0)
			{
				global.msc = -99;
				global.choice = -1;
				global.choicemsg = [stringsetloc(""#Take some"", ""obj_dw_garden_hopschef_slash_Step_0_gml_308_0""), stringsetloc(""#Do not"", ""obj_dw_garden_hopschef_slash_Step_0_gml_309_0""), stringset(""""), stringset("""")];
				scr_speaker(""no_name"");
				msgsetloc(0, ""* (Tree cake.)/"", ""obj_dw_garden_hopschef_slash_Step_0_gml_315_0"");
				msgnext(""\\C2"");
				myinteract = 12;
