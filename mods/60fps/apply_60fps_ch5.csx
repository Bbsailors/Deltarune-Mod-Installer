		c_facenext(""seth"", 0);
		c_msgnextsubloc(""~1* Ugh^1, That's why you're so.../%"", (global.lang == ""ja"") ? ""\\m1\t\t\t"" : ""\\m1\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_cliff_seth_miniboss_slash_Step_0_gml_186_0"");
