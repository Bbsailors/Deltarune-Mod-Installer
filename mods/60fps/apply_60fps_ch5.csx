	if (coindrops == 0)
	{
		exit;
	}
	scr_plat_makecoins(x, y, -coindrops, 90, 90, 8, 4, depth);
	coindrops = 0;
};

petal_color = 16777215;
size = 2;

spawn_hit_petals = function(arg0, arg1, arg2)
{
	var blend = get_tint_blend();
	with (instance_create_depth(x, y, depth + 1, obj_custom_particle_system))
	{
		auto_cleanup = true;
		default_particle_data.sprite_index = spr_falling_petal;
		default_particle_data.image_blend = blend;
		default_particle_data.gravity = 0.4;
		default_particle_data.friction = 0.1;
		repeat (arg0)
		{
			var _len = 8 + (random_range(3, 8) * arg2);
			var _dir = arg1 + random_range(-15, 15);
			emit(
			{
				gravity: 0.4,
				friction: 0.1,
				fadeout_speed: 1 / random_range(30, 60),
				image_index: random_range(0, 10),
				image_speed: random_range(0.2, 0.3),
				hspeed: lengthdir_x(_len, _dir),
				vspeed: lengthdir_y(_len, _dir)
			}, true);
		}
	}
};

get_tint_blend = function()
{
	return merge_color(petal_color, c_gray, clamp01(1 - (hp / __max_hp)));
};

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	if (parallax_depth != 0)
	{
		exit;
	}
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
		if (instance_exists(owner) && owner.id == other.id)
		{
			exit;
		}
	}
	if (hit <= 0 && arg0.is_player_hbx)
	{
		hit = 3;
		scr_make_ripple(x, y, 8, 16777215, 50, 15, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
		with (arg0)
		{
			do_hbx_hit(-4, -1, 1.5 - ((0.5 * other.hp) / other.__max_hp));
		}
		hp--;
		spawn_hit_petals(3, point_direction(arg0.x, arg0.y, x, y), 1);
		if (hp <= 0)
		{
			audio_stop_sound(snd_enemy_defeat_quick);
			snd_play(snd_enemy_defeat_quick);
			shake = 16;
			h_knockback = (arg0.image_xscale * 5.5) / global.fps_scale;
			v_knockback = -10 / global.fps_scale;
			hspeed = 0;
			vspeed = 0;
			alarm[2] = round(8 * global.fps_scale);
			alarm[3] = round(4 * global.fps_scale);
		}
		else if (knockback_after_every_hit)
		{
			shake = 12;
			knocked_back = 1;
			h_knockback = (arg0.image_xscale * 4.5) / global.fps_scale;
			v_knockback = -5 / global.fps_scale;
			hspeed = 0;
			vspeed = 0;
			alarm[2] = round(8 * global.fps_scale);
			with (instance_create_depth(x, y, depth, obj_plat_vfx))
			{
				sprite_index = spr_hit_vfx;
				image_speed = 1;
			}
		}
	}
};

enum UnknownEnum
{
	Value_5 = 5
}
");

