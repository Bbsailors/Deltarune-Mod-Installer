wardrobe = -4;

spawn_wardrobe = function()
{
	var struc = 
	{
		image_xscale: 2,
		image_yscale: 2,
		ropecolor: 16776960,
		nodecount: 15,
		nodelength: 15,
		attached_object_index: 294,
		weight: 3,
		attached_object_struct: 
		{
			image_xscale: 2,
			image_yscale: 2,
			sprite_index: spr_dw_ralseicupboard_topcenteralign
		}
	};
	var gm_wardrobe = scr_genmarker(""wardrobe"");
	with (instance_create_depth(gm_wardrobe.x, gm_wardrobe.y + 160, 50000, obj_plat_stringed_object, struc))
	{
		other.wardrobe = id;
		ropefade = false;
		rope_active = true;
		scr_lerpvar(""vspeed"", 10 / global.fps_scale, 0, 20);
		add_force(lengthdir_x(3, 0), lengthdir_y(3, 0) - 1.6666666666666667);
	}
};

npc_hat = instance_create(-100, -100, obj_marker_fancy);
with (npc_hat)
{
	con = 0;
	yel = other.npc_yellow;
	timer = 0;
	sprite_index = spr_yellow_hat_spin;
	scr_darksize();
	image_speed = 0.25 / global.fps_scale;
	image_blend = c_gray;
	image_xscale = -2;
	y = yel.y - 300;
	hspeed = 0;
	vspeed = 0;
	_vspeed = 0;
	
	step_func = function()
	{
		if (global.pause_plat)
		{
			exit;
		}
		if (con == 1)
		{
			timer += (1 / global.fps_scale);
			_vspeed = min(_vspeed + (0.2 / global.fps_scale), 8);
			y += (_vspeed / global.fps_scale);
			var goalx = yel.x - 14;
			var goaly = yel.y;
			var amp = abs(y - yel.y) * 0.2;
			image_speed = (0.25 + (sin(0.15 * timer) * 0.3) + (sin(0.05 * timer) * 0.1)) / global.fps_scale;
			x = (goalx + (amp * sin(timer * 0.08))) - (sin((timer + 0.32) * 0.03) * amp * 1.3);
			if (y >= (goaly - 40))
			{
				snd_play(snd_item);
				with (yel)
				{
					force_animation(106);
					x -= 3;
				}
				instance_destroy();
			}
		}
	};
}
");

Apply("gml_Object_obj_dw_fcastle_orange_gauntlet_Step_0", @"if (!init)
{
