	c_sel_spriteimage(asg, 5385, 0, 0);
	c_wait(20);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\EY* Oh^1, yes^1! Haha^1. Whatever am I thinking and saying?/"", ""obj_ch5_DWCL00_slash_Step_0_gml_323_0"");
	c_msgnextloc(""\\EX* Tori certainly never^1, gave me./%"", ""obj_ch5_DWCL00_slash_Step_0_gml_324_0"");
	c_talk_wait();
	c_sel_sprite(asg, 758);
	c_wait(10);
	c_speaker(""asgore"");
	c_msgsetloc(0, ""\\EY* A golden breastplate with her face on it^1, either!/"", ""obj_ch5_DWCL00_slash_Step_0_gml_332_0"");
	c_facenext(""flowery"", ""2"");
	c_msgnextloc(""\\E2\\VT* Haha^1! That's my main man^1! Let's go./%"", ""obj_ch5_DWCL00_slash_Step_0_gml_334_0"");
	c_talk_wait();
	var _time3 = ceil(abs(pos_asgore3.x - pos_asgore2.x) / 4);
