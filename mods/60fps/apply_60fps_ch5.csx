	c_msgnextloc(""* And literally only couples^1, as in DIVISIBLE BY TWO PEOPLE^1, ONLY^1, to be in love./"", ""obj_room_castle_dojo_slash_Step_0_gml_24_0"");
	c_msgnextloc(""* Get it^1? Forecast says..^1. three is a forbidden number./"", ""obj_room_castle_dojo_slash_Step_0_gml_26_0"");
	c_msgnextloc(""* That being said^1, could we..^1. get your opinion on something?/"", ""obj_room_castle_dojo_slash_Step_0_gml_28_0"");
	c_msgnextloc(""* Like..^1. does Clover count as one person^1, or three?/"", ""obj_room_castle_dojo_slash_Step_0_gml_30_0"");
	c_msgnextloc(""* I'm not sure if I should support this relationship^1, or be VERY intolerant./%"", ""obj_room_castle_dojo_slash_Step_0_gml_32_0"");
	c_talk();
	c_wait_box(1);
