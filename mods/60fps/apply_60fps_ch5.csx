Apply("gml_Object_obj_enemy_blue_boxspin_Step_0", @"timer += (1 / global.fps_scale);
dancer_speed_counter += (0.5 / global.fps_scale);
if (timer == 1)
{
	scr_lerpvar(""x"", x, obj_growtangle.x - 50, 25);
	scr_lerpvar(""y"", y, scr_get_box(1) - 240, 12, 1, ""out"");
	scr_script_delayed(scr_lerpvar, 16, ""y"", scr_get_box(1) - 240, scr_get_box(1) - 132, 12, 1, ""in"");
	with (obj_growtangle)
	{
		switch (other.mode)
		{
			case 0:
				scr_script_delayed(scr_lerpvar, 24, ""image_xscale"", image_xscale, 2.25, 8, 2, ""out"");
				scr_script_delayed(scr_lerpvar, 24, ""image_yscale"", image_yscale, 1.75, 8, 2, ""out"");
				break;
			case 1:
				scr_script_delayed(scr_lerpvar, 24, ""image_xscale"", 3.5, 3.6, 8, 2, ""out"");
				scr_script_delayed(scr_lerpvar, 24, ""image_yscale"", 2, 1.85, 8, 2, ""out"");
				break;
		}
	}
}
if (timer == 24)
{
	grow_y = obj_growtangle.y;
	image_speed = 0.25 / global.fps_scale;
}
if (mode == 0)
{
	if (timer == 32)
	{
		alarm[0] = 96;
	}
}
if (mode == 1)
{
	if (timer == 1)
	{
		for (a = 0; a < 8; a++)
