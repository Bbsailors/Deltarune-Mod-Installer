wprog = function(arg0, arg1)
{
	var _range = arg1 - arg0;
	var _progress = 0;
	if (_range != 0)
	{
		_progress = (textind - arg0) / _range;
	}
	else if (textind >= arg0)
	{
		_progress = 1;
	}
	return clamp(_progress, 0, 1);
};

xprog = function(arg0, arg1, arg2)
{
	var _range = arg2 - arg1;
	var _progress = 0;
	if (_range != 0)
	{
		_progress = (arg0 - arg1) / _range;
	}
	return _progress;
};

