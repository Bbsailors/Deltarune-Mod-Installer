		if (global.monsterhp[myself] > global.monstermaxhp[myself])
		{
			global.monsterhp[myself] = global.monstermaxhp[myself];
		}
		instance_create(x, y, obj_dmgwriter);
		with (obj_dmgwriter)
		{
			delay = 4;
			damage = other.healamount;
			type = 3;
			image_index = 2;
			image_blend = c_lime;
			image_speed = 0;
		}
		snd_stop(snd_power);
		snd_play(snd_power);
		healamount = 0;
		punchomelettimer = 0;
		punchomeletcon = 0;
	}
}
