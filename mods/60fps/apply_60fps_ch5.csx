Apply("gml_Object_obj_checkers_enemy_Draw_0", @"if (state == 3)
{
	hurttimer -= (1 / global.fps_scale);
	if (hurttimer < 0)
	{
		state = 0;
	}
	else
	{
		if (global.monster[myself] == 0)
		{
			hspeed = 12 / global.fps_scale;
			turnt -= (8 / global.fps_scale);
			vspeed = -4 / global.fps_scale;
		}
		hurtshake += 1;
		if (hurtshake > 1)
		{
			if (shakex > 0)
			{
				shakex -= (1 / global.fps_scale);
			}
			if (shakex < 0)
			{
				shakex += (1 / global.fps_scale);
			}
			shakex = -shakex;
			hurtshake = 0;
		}
		siner = 0;
		draw_sprite_ext(spr_checkers_idle, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
	}
}
if (state == 0)
{
	siner += (1 / global.fps_scale);
	thissprite = spr_checkers_idle;
	if (global.mercymod[myself] >= global.mercymax[myself])
	{
		thissprite = spr_checkers_idle;
	}
	draw_sprite_ext(thissprite, siner / 3, x, y, 2, 2, 0, image_blend, 1);
	if (flash == 1)
	{
		fsiner += (1 / global.fps_scale);
		d3d_set_fog(true, c_white, 0, 1);
		draw_sprite_ext(thissprite, siner / 3, x, y, 2, 2, 0, image_blend, (-cos(fsiner / 5) * 0.4) + 0.6);
		d3d_set_fog(false, c_black, 0, 0);
	}
}
if (becomeflash == 0)
{
	flash = 0;
}
becomeflash = 0;
sprite_index = thissprite;
image_index = siner / 3;
");

Apply("gml_Object_obj_checkers_enemy_Step_0", @"if (global.monstertype[myself] == 21)
{
	secondtime = 1;
}
if (global.monster[myself] == 1)
{
	global.flag[51 + myself] = 4;
	if (secondtime == 1)
	{
		milk_counter = 99;
	}
	if (secondtime == 1)
	{
		ralsei_lecture = 99;
	}
	if (global.mnfight == 1 && talked == 0)
	{
		scr_randomtarget();
		if (!instance_exists(obj_darkener))
		{
			instance_create(0, 0, obj_darkener);
		}
		milkmax = 1000;
		if (milk_counter > 0)
		{
			milkmax = 600;
		}
		if (global.monsterhp[myself] > milkmax)
		{
			if (!instance_exists(obj_moveheart) && !instance_exists(obj_heart))
			{
				scr_moveheart();
			}
			if (!instance_exists(obj_growtangle))
			{
				instance_create(__view_get(e__VW.XView, 0) + 320, __view_get(e__VW.YView, 0) + 170, obj_growtangle);
			}
		}
		global.mnfight = 2;
		rtimer = 0;
		global.typer = 50;
		talked = 2;
		attacked = 0;
		talktimer = 0;
	}
	if (talked == 2)
	{
		global.mnfight = 2;
	}
	if (global.mnfight == 2 && attacked == 0)
	{
		rtimer += (1 / global.fps_scale);
		if (rtimer == 12)
		{
			talked = 0;
			milkmax = 1000;
			if (milk_counter > 0)
			{
				milkmax = 600;
			}
			if (global.monsterhp[myself] <= milkmax)
			{
				if (scon == 0)
				{
					scon = 1;
				}
			}
			else
			{
				if (!instance_exists(obj_checkers_leap))
				{
					if (attacktype == 0)
					{
						rr = 0;
					}
					if (attacktype == 1)
					{
						rr = 3;
					}
					if (attacktype == 2)
					{
						rr = 1;
					}
					if (attacktype == 3)
					{
						rr = 2;
					}
					dc = instance_create(x, y, obj_checkers_leap);
					dc.leapmode = rr;
					dc.target = mytarget;
					dc.damage = global.monsterat[myself] * 5;
					attacktype += 1;
					if (attacktype > 3)
					{
						attacktype = 0;
					}
				}
				siner = 0;
				visible = 0;
				turns += 1;
			}
			global.turntimer = 999;
			attacked = 1;
			global.typer = 6;
			global.fc = 0;
			rr = choose(0);
			global.battlemsg[0] = stringsetloc(""* K.Round shuffles furiously."", ""obj_checkers_enemy_slash_Step_0_gml_77_0"");
			if (global.monsterstatus[myself] == 1)
			{
				global.battlemsg[0] = stringsetloc(""* K.Round looks weak."", ""obj_checkers_enemy_slash_Step_0_gml_79_0"");
			}
