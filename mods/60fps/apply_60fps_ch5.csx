Apply("gml_Object_obj_plat_bulletred_rebounding_Other_19", @"var _hspeed = lengthdir_x(stored_speed, direction) * 2 * global.fps_scale;
var _vspeed = lengthdir_y(stored_speed, direction) * 2 * global.fps_scale;
var newdir = direction;
var cx = camerax();
var cy = cameray();
var cw = camerawidth();
var ch = cameraheight();
var padh = -60;
var padv = -80;
var hcheck = (x + _hspeed) < (cx - padh) || (x + _hspeed) > (cx + cw + padh);
var vcheck = (y + _vspeed) < (cy - padv) || (y + _vspeed) > ((cy + ch) - 160);
if (vspeed > 0)
{
	with (obj_plat_follower)
	{
		if (name == ""ralsei"" && is_platform_mode && y > ((cy + ch) - 160))
		{
			vcheck = true;
			break;
		}
	}
}
var got_hit = false;
var make = false;
if (hcheck && !vcheck)
{
	newdir = 180 - newdir;
	x += lengthdir_x(stored_speed * global.fps_scale, newdir);
	y += lengthdir_y(stored_speed * global.fps_scale, newdir);
	make = true;
}
else if (vcheck && !hcheck)
{
	newdir = -1 * newdir;
	x += lengthdir_x(stored_speed * global.fps_scale, newdir);
	y += lengthdir_y(stored_speed * global.fps_scale, newdir);
	make = true;
}
else if (hcheck && vcheck)
{
	newdir = 180 - newdir;
	newdir = -1 * newdir;
	x += lengthdir_x(stored_speed * global.fps_scale, newdir);
	y += lengthdir_y(stored_speed * global.fps_scale, newdir);
	make = true;
}
if (make)
{
	with (obj_dw_fcastle_yellow_combat)
	{
		make_rebound_sparks(other.x, other.y, other.stored_speed * global.fps_scale, newdir);
	}
}
direction = newdir;
target_angle = 180 + direction;
if (image_xscale < 0)
{
	target_angle += 180;
}
");

