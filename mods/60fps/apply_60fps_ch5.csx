				randomText = stringsetloc(""Untied shoelaces?"", ""obj_tasque_manager_enemy_slash_Step_0_gml_36_0"");
			}
			dialogText = stringsetsubloc(""~1&Let me whip it into shape!"", randomText, ""obj_tasque_manager_enemy_slash_Step_0_gml_39_0"");
		}
