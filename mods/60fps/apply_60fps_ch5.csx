			var talk_flatter1 = stringsetloc(""Hee hee, is that&how you fight?^1 So,&if I praise enough,&I'll win too?/%"", ""obj_aqua_enemy_slash_Step_0_gml_98_0"");
			var talk_flatter2 = stringsetloc(""I'm the best!&I'm the best!&Hee hee,&I'm winning!/%"", ""obj_aqua_enemy_slash_Step_0_gml_99_0"");
			var bored1 = stringsetloc(""Didn't we play&that old game&already?/%"", ""obj_aqua_enemy_slash_Step_0_gml_101_0"");
