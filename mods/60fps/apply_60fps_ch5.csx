Apply("gml_Object_obj_sakurafubuki_new_Create_0", @"depth = 11000;
ps = part_system_create();
ps2 = part_system_create();
pe = part_emitter_create(ps);
pe2 = part_emitter_create(ps2);
rate = -5;
whirl_rate = 0;
pregen = false;
surf = -4;
