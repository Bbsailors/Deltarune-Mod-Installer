	for (i = 0; i < sprite_height; i += thickness)
	{
		draw_sprite_part_ext(spr_pink_ghost_2xscale, image_index, 0, i * thickness, sprite_width, thickness + 2, x + __offsetx + (sin((wave_siner + (i * 8)) / 30) * 3), y + (i * thickness) + __offsety, 1, 1, c_white, image_alpha);
	}
