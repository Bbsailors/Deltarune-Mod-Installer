	c_msgsetloc(0, ""\\EK* .../"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_247_0"");
	c_facenext(""susie"", ""0"");
	c_msgnextloc(""\\E0* ..^1. let's go check on her./%"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_249_0"");
	c_talk_wait();
	c_wait(10);
	c_sel(kr);
	c_facing(""d"");
	c_pannable(0);
	c_actortokris();
	c_actortocaterpillar();
	c_terminatekillactors();
}
if (cutscenecon == 2 && !instance_exists(obj_cutscene_master))
{
	global.interact = 0;
	cutscenecon = 0;
	global.flag[PINK_FLAG] = 1.5;
	var saveloc = findspriteinfo(spr_savepoint);
	instance_create(saveloc.x, saveloc.y, obj_savepoint).depth -= 120;
}
if (orange_jump != 0)
{
	orange_cooldown -= (1 / global.fps_scale);
	if (orange_cooldown <= 0)
	{
		snd_play(snd_petaldrain, 0.7, 1.5);
		with (ora_actor)
		{
			if (other.orange_jump > 0)
			{
				scr_jump_to_point(x + 16, y, 6, 10);
			}
			else
			{
				scr_jump_to_point(x - 16, y, 6, 10);
			}
		}
		orange_jump = -orange_jump;
		orange_cooldown = 10;
	}
}
if (orange_shake)
{
	if ((floor(cuttimer * global.fps_scale) % 4) == 0)
	{
		orange_cooldown = -sign(orange_cooldown + 0.5);
		ora_actor.x += 2 * orange_cooldown;
	}
}
if (con == 0 && global.flag[PINK_FLAG] == 2)
{
	if (scr_trigcheck(""remove_encounter_room""))
	{
		con = 1;
		global.flag[PINK_FLAG] = 3;
		scr_tempsave();
		snd_play(snd_sparkle_glock);
		with (obj_solidblocksized_alt)
		{
			instance_destroy();
		}
		scr_lerpvar(""path_layer_alpha"", 0, 1, 30);
		var gm = scr_genmarker(""blocker"");
		with (instance_create(gm.x, gm.y, obj_solidblocksized))
		{
			image_xscale = 2;
			image_yscale = 20;
		}
	}
}
if (con >= 1 && con <= 30)
{
	con += (1 / global.fps_scale);
	with (obj_caterpillarchara)
	{
		if (x > 520)
		{
			x -= (2 / global.fps_scale);
		}
		for (var i = 0; i < 75; i++)
		{
			if (remx[i] > 520)
			{
				array_set(remx, i, array_get(remx, i) - (2 / global.fps_scale));
			}
		}
	}
}
cuttimer -= (1 / global.fps_scale);
");

Apply("gml_Object_obj_dw_fcastle_pinkroom_ferrol_Create_0", @"cliffs = false;
with (obj_dw_cliff_silver_hammer)
{
	other.cliffs = true;
}
var alt = cliffs;
vol = 1;
if (!alt)
{
	ferrol = scr_makenpc_fromasset(findsprite(spr_npc_ferroll_idle));
}
else
{
	ferrol = scr_makenpc_fromasset(findsprite(spr_npc_ferroll_hammer));
	with (ferrol)
	{
		markerstick = false;
		scr_sizeexact(65, 52);
		x += 32;
		y += 65;
	}
}
with (ferrol)
{
	bought = false;
	with (marker)
	{
		sprite_index = spr_npc_ferroll_idle;
		image_index = 0;
		image_speed = (1/15) / global.fps_scale;
	}
	
	coincheck = function()
	{
		haveallcoins = false;
		coincount = 19;
		gardencount = scr_flag_get_ext(1825, 0) + scr_flag_get_ext(1442, 9) + scr_flag_get(1827) + scr_flag_get(1304);
		cliffscount = scr_flag_get_ext(1310, 4) + scr_flag_get_ext(1731, 16) + scr_flag_get_ext(1731, 17) + scr_flag_get_ext(1859, 10);
		fcastlercount = scr_flag_get(1835) + scr_flag_get(1836) + scr_flag_get(1840) + scr_flag_get(1875) + scr_flag_get_ext(1310, 3) + scr_flag_get_ext(1317, 5) + scr_flag_get_ext(1318, 10);
		fcastlelcount = scr_flag_get_ext(1310, 1) + scr_flag_get_ext(1310, 2);
		fcastletcount = scr_flag_get_ext(1845, 1) + scr_flag_get_ext(1818, 10);
		remainingcoins = abs((gardencount + cliffscount + fcastlercount + fcastlelcount + fcastletcount) - coincount);
		show_debug_message_concat(""remainingcoins="", remainingcoins);
		if ((gardencount + cliffscount + fcastlercount + fcastlelcount + fcastletcount) == coincount)
		{
			haveallcoins = true;
		}
	};
	
	coincheck();
}
");

Apply("gml_Object_obj_dw_fcastle_pinkroom_ferrol_Step_0", @"with (ferrol)
{
	if (myinteract == 3)
	{
		scr_flag_set_ext(1762, 1, 1, 2);
		if (!bought)
		{
			global.interact = 1;
			scr_cutscene_make();
			scr_maincharacters_actors();
			var kr1 = kr_actor;
			var su1 = su_actor;
			var ra1 = ra_actor;
			var kr2 = findspriteinfo(spr_krisu_dark, ""NPCs"");
			var su2 = 
			{
				x: kr2.x + 42,
				y: kr2.y - 16
			};
			var ra2 = 
			{
				x: kr2.x + 94,
				y: kr2.y - 12
			};
			c_sel(kr);
			var kwait = c_walkto_straight(kr1, kr2, 6, 0, ""u"");
			c_sel(su);
			var swait = c_walkto_straight(su1, su2, 6, 0, ""u"");
			c_sel(ra);
			var rwait = c_walkto_straight(ra1, ra2, 6, 0, ""u"");
			c_wait(max(kwait, swait, rwait) + 1);
			c_actortokris();
			c_actortocaterpillarstill();
			c_terminatekillactors();
			myinteract = 3.1;
		}
		else
		{
			global.interact = 1;
			myinteract = 40;
		}
	}
	if (myinteract == 3.1 && !instance_exists(obj_cutscene_master))
	{
		with (obj_caterpillarchara)
		{
			scr_caterpillar_interpolate(name);
			scr_caterpillar_facing_single(name, ""u"");
		}
		scr_speaker(""no_name"");
		msgsetloc(0, ""* AHUH^1! I realized being a cave hermit means you don't really meet people./"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_52_0"");
		msgnextloc(""* Now that you have met me^1, I'll show up here as well!/"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_53_0"");
		if (talked || obj_dw_fcastle_pinkroom_ferrol.cliffs)
		{
			scr_speaker(""no_name"");
			msgsetloc(0, ""* Feel my technique?/"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_58_0"");
		}
		var opt1 = stringsetloc(""Locate#Pink Coins#(50 F$)"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_61_0"");
		var opt2 = stringsetloc(""Do Not"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_62_0"");
		scr_readychoicer(opt1, opt2);
		if (global.lang == ""ja"")
		{
			scr_choiceradjust(10);
		}
		d_make();
		talked++;
		myinteract = 4;
	}
	if (myinteract == 4 && global.choice != -1)
	{
		if (global.choice == 0)
		{
			k_d(3);
			if (haveallcoins)
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* What!^1? There are NO PINK COINS left...!/"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_79_0"");
				msgnextloc(""* That's GREAT^1. I think I was ALLERGIC to those../%"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_80_0"");
				with (marker)
				{
					sprite_index = spr_npc_ferroll_shock;
				}
				scr_msgno_func(1, function()
				{
					with (marker)
					{
						sprite_index = spr_npc_ferroll_embarassed;
					}
				});
				d_make();
				myinteract = 99;
			}
			else if (global.flag[1411] < 50)
			{
				scr_speaker(""no_name"");
				msgsetloc(0, ""* You don't have enough FLOWERY DOLLARS!?/"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_94_0"");
				msgnextloc(""* Try seeking the BREAD CHEF^1, he has many forms of DOUGH./%"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_95_0"");
				marker.sprite_index = spr_npc_ferroll_sad;
				scr_msgno_func(1, function()
				{
					with (marker)
					{
						sprite_index = spr_npc_ferroll_idle;
						image_index = round(image_index);
						image_speed = (1/15) / global.fps_scale;
					}
				});
				d_make();
				myinteract = 99;
			}
			else
			{
				bought = true;
				coincheck();
				global.flag[1411] -= 50;
				scr_speaker(""no_name"");
				msgsetloc(0, ""* Ha^1! Locating PINK METAL..^1. now^1, THIS is something I can do!/"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_113_0"");
				msgnextloc(""* A-choo!!!../%"", ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_114_0"");
				d_make();
				myinteract = 20;
				timer = 0;
			}
		}
		else
		{
			k_d();
			myinteract = 99;
		}
	}
	if (myinteract == 20 && !d_ex())
	{
		myinteract = 21;
		timer = 1;
	}
	if (myinteract == 21)
	{
		timer += (1 / global.fps_scale);
		if (timer == 2)
		{
			mus_volume(global.currentsong[1], 0, 6);
			with (scr_marker_fancy(0, 0, 6500))
			{
				con = 0;
				depth = 900010;
				alf = 0;
				timer = 0;
				
				draw_func = function()
				{
					timer = obj_dw_fcastle_pinkroom_ferrol.ferrol.timer;
					var anim1 = 40;
					image_blend = c_black;
					if (timer <= anim1)
					{
						alf = lerp_out_cubic(0, 1, timer / anim1);
					}
					if (timer > anim1)
					{
						alf = lerp_out_cubic(1, 0, (timer - anim1) / 30);
					}
					draw_sprite_ext(spr_pxwhite, 0, 0, 0, room_width, room_height, 0, image_blend, clamp(alf, 0, 1) * 0.7);
					if (timer > (anim1 + 30))
					{
						instance_destroy();
					}
				};
			}
		}
		if (timer < 33)
		{
			sprite_set(marker, 3241, undefined, lerp_inout_cubic(0.125, 0.625, timer / 33) / global.fps_scale);
		}
		if (timer == 33)
		{
			sprite_set(marker, 6030, 0, 0);
		}
		if (timer == 37)
		{
			snd_play(snd_wing);
			sprite_set(marker, 6030, 1);
		}
		if (timer == 39)
		{
			snd_play(snd_metal_hit_strong);
			snd_play(snd_metalhit);
			sprite_set(marker, 6030, 2);
			scr_make_ripple(x + 110, y + 94, 29, 4267129, 960, 4, 80, 900000, undefined, undefined, undefined, 6, 1.5);
			scr_make_ripple(x + 110, y + 94, 30, 9472767, 960, 4, 20, 900000, undefined, undefined, undefined, 6, 1.5);
			scr_make_ripple(x + 110, y + 94, 31, 15330047, 768, 15, 20, 900000, undefined, undefined, undefined, 6, 1.5);
			with (obj_ripples)
			{
				blend = #010000;
				image_alpha = 0.9;
			}
		}
		if (timer == 41)
		{
			sprite_set(marker, 6030, 3);
		}
		if (timer == 43)
		{
			sprite_set(marker, 6030, 4);
		}
		if (timer == 45)
		{
			sprite_set(marker, 6030, 5);
		}
		if (timer == 75)
		{
			mus_volume(global.currentsong[1], 1, 30);
		}
		if (timer == 105)
		{
			myinteract = 40;
		}
	}
	if (myinteract == 40)
	{
		scr_speaker(""no_name"");
		coincheck();
		var gardenstr = stringsetsubloc(""* ~1 in GARDEN."", string(4 - gardencount), ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_215_0"");
		var cliffstr = stringsetsubloc(""* ~1 in CLIFF."", string(4 - cliffscount), ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_216_0"");
		var castlerstr = stringsetsubloc(""* ~1 in CASTLE EAST."", string(7 - fcastlercount), ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_217_0"");
		var castlelstr = stringsetsubloc(""* ~1 in CASTLE WEST."", string(2 - fcastlelcount), ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_218_0"");
		var castletstr = stringsetsubloc(""* ~1 at TOP OF CASTLE."", string(2 - fcastletcount), ""obj_dw_fcastle_pinkroom_slash_Other_17_gml_219_0"");
		var locs = [];
		if (gardencount < 4)
		{
			array_push(locs, gardenstr);
		}
		if (cliffscount < 4)
		{
			array_push(locs, cliffstr);
		}
		if (fcastlercount < 7)
		{
			array_push(locs, castlerstr);
		}
		if (fcastlelcount < 2)
		{
			array_push(locs, castlelstr);
		}
		if (fcastletcount < 2)
		{
			array_push(locs, castletstr);
		}
		var count = array_length(locs);
		var bonus = """";
		if (count == 1)
		{
			bonus = ""%"";
		}
		msgset(0, locs[0] + ""/"" + bonus);
		for (var i = 1; i < count; i++)
		{
			bonus = """";
			if ((i + 1) == count)
			{
				bonus = ""%"";
			}
			msgnext(locs[i] + ""/"" + bonus);
		}
		d_make();
		myinteract = 99;
	}
	if (myinteract == 99 && !d_ex())
	{
		scr_caterpillar_interpolate(""all"");
		with (marker)
		{
			sprite_index = spr_npc_ferroll_idle;
			image_index = round(image_index);
			image_speed = (1/15) / global.fps_scale;
		}
		myinteract = 0;
		global.interact = 0;
	}
}
");

