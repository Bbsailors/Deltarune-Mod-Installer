Apply("gml_Object_obj_spinpetalmaker_Create_0", @"petal_rate = 35;
alarm[0] = round(petal_rate * global.fps_scale);
preheat_count = 0;

make_petal = function(arg0 = false)
{
	var _petal = instance_create_depth(random_range(bbox_left, bbox_right), bbox_bottom, depth, obj_spin_petal);
	with (_petal)
	{
		vspeed = (0.8 + random(0.5)) / global.fps_scale;
