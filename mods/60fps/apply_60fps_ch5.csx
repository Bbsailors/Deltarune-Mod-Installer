	if (timer == 6)
	{
		if (instance_exists(small_aqua))
		{
			with (small_aqua)
			{
				flatten();
			}
			snd_play(snd_paperbreak);
			with (instance_create(x, y + 30, obj_animation))
			{
				sprite_index = spr_plat_vfx_book_slam;
				image_speed = 0.5 / global.fps_scale;
				scr_darksize();
			}
		}
	}
	if (timer == 30)
	{
		sprite_index = spr_enemy_book_front_idle;
		image_speed = 0.25 / global.fps_scale;
		scr_lerpvar(""sineamp"", 0, 8, 6);
	}
	if (timer >= lerp(45, 31, difficulty_scaling))
	{
		con = 0;
		timer = 0;
		lerptimer = 0;
		small_aqua = -4;
	}
}
");

