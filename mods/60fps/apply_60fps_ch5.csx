	c_msgsetsubloc(0, ""~1* I'm telling!!/%"", (global.lang == ""ja"") ? ""\\m2\t\t\t"" : ""\\m2\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_dw_fcastle_pinkroom_slash_Step_0_gml_232_0"");
	c_talk_wait();
	c_mus2(""volume"", 0, 30);
	c_wait(12);
	c_wait_if(id, ""cuttimer"", ""<="", 0);
	c_sel(su);
	c_sprite(spr_susie_walk_left_dw_unhappy);
