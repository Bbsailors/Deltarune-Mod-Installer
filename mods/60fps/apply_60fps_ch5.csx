");

Apply("gml_Object_obj_plat_enm_aqua_bouncer_Step_0", @"event_inherited();
if (global.pause_plat)
{
	alarm[2]++;
	alarm[3]++;
	if (!paused)
	{
		on_pause();
	}
	exit;
}
if (squishtimer > 0)
{
	squishtimer += (1 / global.fps_scale);
	if (squishtimer == 16)
	{
		squishtimer = 0;
	}
}
if (paused || custom_paused)
{
	exit;
}
if (hp <= 0)
{
	image_speed = 0;
	exit;
}
if (is_stunned)
{
	x -= hspeed;
	y -= vspeed;
	vspeed -= gravity;
	contact_damage = 0;
}
if (flower_despawn && (!instance_exists(obj_plat_player) || bbox_top > (room_height + 80)))
{
	scr_flower_despwn();
	exit;
}
if (con == 0)
{
	if (grounded)
	{
		if (timer == 0)
		{
			contact_damage = 35;
			squishtimer = 6;
			hspeed = 0;
		}
		timer += (1 / global.fps_scale);
		if (timer >= 10)
		{
			var sgn = sign(obj_plat_player.x - x);
			if (sgn == 0)
			{
				sgn = 1;
			}
			hspeed = movespeed * sgn;
			vspeed = -12 / global.fps_scale;
			timer = 0;
		}
	}
}
else if (con == 1)
{
	timer += (1 / global.fps_scale);
	if (timer > 15)
	{
		contact_damage = 45;
	}
	if ((timer % 3) == 0)
	{
		scr_afterimage_monochrome(get_tint_blend(), true).image_alpha = 0.3;
	}
	if (wallhitspd != 0)
	{
		hspeed = -sign(wallhitspd) * abs(h_knockback);
		wallhitspd = 0;
		h_knockback = hspeed;
		h_knockback = scr_movetowards(h_knockback, sign(hspeed) * base_knockback, 1 / global.fps_scale);
	}
	if (grounded)
	{
		vspeed = -12 / global.fps_scale;
	}
}
");

