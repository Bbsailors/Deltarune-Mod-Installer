Apply("gml_Object_obj_dw_cliff_seth_miniboss_Create_0", @"layer_set_visible(""DEBUG_ASSETS"", 0);
scr_setparty(1, 1);
con = 0;
timer = 0;
init = 0;
cutscenecon = 0;
if (global.tempflag[56] == 1)
{
	cutscenecon = 1;
}
if (global.plot > 320)
{
	cutscenecon = -1;
	scr_musicer(""cliff_jump_ambience.ogg"", 1);
}
npc_seth = scr_plat_makeactor_fromasset(findspriteinfo(spr_seth_idle, undefined, c_red));
npc_aqua = scr_plat_makeactor_fromasset(findspriteinfo(spr_enemy_aqua_idle, undefined, c_red));
if (cutscenecon == -1)
{
	npc_seth.visible = 0;
	npc_aqua.visible = 0;
}
npc_seth.target_y = false;
npc_aqua.target_y = false;
npc_seth.is_peeking = false;
npc_aqua.is_peeking = false;
npc_aqua.force_animation(7724);
npc_seth.image_xscale = -2;
layer_set_visible(""NPCs"", 0);
with (npc_aqua)
{
	scr_plat_snap_to_ground();
}
with (npc_seth)
{
	scr_plat_snap_to_ground();
}
bullet_pattern_object = -4;

bullet_pattern_die_expire = function(arg0)
{
	bullet_pattern_object = arg0;
	con = 5;
};

do_standing_combo_ending = function(arg0)
{
	bullet_pattern_object = arg0;
	con = 15;
	timer = 0;
};

peek_out = function(arg0, arg1)
{
	with (arg0)
	{
		if (is_peeking)
		{
			is_peeking = arg1 + 10;
		}
		else
		{
			target_y = y;
			is_peeking = arg1 + 10;
		}
	}
};

seth_peek_delay = function()
{
	if (instance_exists(obj_plat_enm_sethglasses_miniboss) && obj_plat_enm_sethglasses_miniboss.talkcon == 15)
	{
		peek_out(npc_seth, 130);
		with (npc_seth)
		{
			force_animation(6520, 130);
		}
	}
};

current_side = 1;
sideswitchcon = 0;
sideswitchtimer = 0;

ensure_side = function(arg0)
{
	if (current_side != arg0)
	{
		current_side = arg0;
		if (sideswitchcon == 0)
		{
			sideswitchcon = 1;
			sideswitchtimer = 0;
		}
	}
};

npc_kawkaws = [];
var cols = [16711680, 65280, 255];
for (var i = 0; i <= 2; i++)
{
	var kaw = scr_makenpc_fromasset(findsprite(spr_kawkaw_small, ""NPCs"", cols[i]), true);
	kaw.issolid = true;
	kaw.marker.image_blend = c_white;
	kaw.idx = i + 1;
	with (kaw)
	{
		with (marker)
		{
			height_percent = 2;
			parent = other;
			con = 0;
			
			step_func = function()
			{
				if (con == 1)
				{
					height_percent = max(height_percent - (0.12 / global.fps_scale), 0);
					if (height_percent <= 0)
					{
						with (parent)
						{
							instance_destroy();
						}
						instance_destroy();
					}
				}
				else if (scr_trigcheck(""kawkaw_"" + string(parent.idx)))
				{
					parent.face0allowed = 0;
					parent.face1allowed = 0;
					parent.face2allowed = 0;
					parent.face3allowed = 0;
					con = 1;
					sprite_index = spr_kawakaw_happy;
					parent.y -= 6;
					image_index = 1;
					parent.issolid = false;
					with (parent.mysolid)
					{
						instance_destroy();
					}
					snd_play(choose(snd_bird_happy_1, snd_bird_happy_2), 0.7);
				}
			};
			
			draw_func = function()
			{
				if (height_percent > 0 && array_get(scr_platswap_yscale(), 0) == 0)
				{
					var _final_percent = min(height_percent, 1);
					var _spr_trueheight = sprite_get_height(sprite_index);
					var _shakeamt = (height_percent < 1.5) ? irandom_range(-4, 4) : 0;
					draw_sprite_part_ext(sprite_index, image_index, 0, 0, sprite_width / image_xscale, _final_percent * _spr_trueheight, x + _shakeamt, y + ((1 - _final_percent) * sprite_height), image_xscale, image_yscale, image_blend, image_alpha);
					var suns = 709;
					if (suns != -4)
					{
						shader_replace_simple_set_hook(25);
						shader_set_uniform_f(suns.u_shadowblend, suns.shadowblend_r, suns.shadowblend_g, suns.shadowblend_b, suns.alpha_shadowblend);
						draw_sprite_part_ext(sprite_index, image_index, 0, 0, sprite_width / image_xscale, _final_percent * _spr_trueheight, x + _shakeamt, y + ((1 - _final_percent) * sprite_height), image_xscale, image_yscale, image_blend, image_alpha);
						shader_replace_simple_reset_hook();
					}
				}
				if (height_percent < 1)
				{
					scr_vfxsprite(choose(4029, 4027), random_range(bbox_left, bbox_right), bbox_bottom, depth - 5, 0.5, random(1) / global.fps_scale, -1 / global.fps_scale, 0.02 / (global.fps_scale * global.fps_scale));
				}
			};
		}
	}
	array_push(npc_kawkaws, kaw);
}
if (global.tempflag[72] == 0.01)
{
	global.tempflag[72] = 0;
	scr_tempsave();
}
");

