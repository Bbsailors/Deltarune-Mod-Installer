	as = actor_count + 2;
	as_actor = instance_create(camerax() + view_wport[0] + 120, 650, obj_actor);
	scr_actor_setup(as, as_actor, ""asgore"");
	as_actor.sprite_index = spr_asgore_armor_run_left;
	c_sel(kr);
	c_sprite(spr_kris_floor_down);
	c_setxy(253, 734);
	c_sel(su);
	c_visible(0);
	c_sel(ra);
	c_visible(0);
	c_pannable(1);
	c_pan(120, cameray(), 1);
