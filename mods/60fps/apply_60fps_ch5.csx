	if (mazemode)
	{
		lim = lerp(80, 66, min(attackvolley, difficulty_capped) / volleymax);
	}
	if (attacktimer >= (lim - min(4, attackvolley, difficulty_capped)))
	{
		animcon = true;
	}
	if (attacktimer >= lim)
	{
		animcon = false;
		if (attackvolley < volleymax)
		{
			attackvolley++;
			attacktimer = 46 + min(16, attackvolley, difficulty_capped);
			if (mazemode == 1)
			{
				attacktimer = 41 + min(6, attackvolley * 2, difficulty_capped);
			}
			attackcon = 1;
			if (attackmode == 2)
			{
				attacktimer += 7;
			}
		}
		else
		{
			attackvolley = 1;
			siner = 0;
			wing_index = 0;
			attackcon = 0;
			attacktimer = 0;
			with (obj_plat_loopboundary)
			{
				instance_destroy();
			}
			with (obj_dw_cliff_kawkawdash)
			{
				starwalker_defeated();
			}
			if (attackmode == 2)
			{
				scr_lerpvar(""y"", y, y - 300, 30, -1, ""in"");
				scr_delay_var(""beatcon"", 0.5, 31);
			}
		}
	}
}
if (i_ex(shadow))
{
	if (attackcon == -1)
	{
		shadow.visible = 0;
	}
	else
	{
		shadow.visible = 1;
	}
	if (mazemode == 1)
	{
		shadow.visible = 0;
	}
	shadow.x = x;
	shadow.y = shadowy;
	shadow.sprite_index = spr_starwalker_wings_tropical;
	shadow.image_index = wing_index;
	if (attackcon == 1)
	{
		shadow.sprite_index = spr_starwalker_attack;
		shadow.image_index = 0;
		shadow.image_xscale = xmake;
	}
	if (attackcon == 2)
	{
		shadow.sprite_index = spr_starwalker_attack;
		shadow.image_index = 1;
		shadow.image_xscale = xmake;
	}
}
if (beatcon == 0.5)
{
	var newpos = scr_genmarker(""starwalker"");
	if (instance_exists(newpos))
	{
		x = newpos.x;
		y = newpos.y;
	}
	beatcon = 0.6;
	vspeed = 0;
	hspeed = 0;
}
if (beatcon == 1)
{
	if (target.object_index == obj_mainchara)
	{
		with (target)
		{
			battlemode = 0;
		}
	}
	if (global.interact == 0)
	{
		with (obj_dw_garden_starwalkerdash)
		{
			starwalker_defeated();
		}
		global.interact = 1;
		beattimer = 0;
		beatcon = 2;
	}
}
if (beatcon == 2)
{
	beattimer += (1 / global.fps_scale);
	if (instance_exists(dead))
	{
		if (dead.x < (camerax() - 100) && global.interact != 0)
		{
			with (obj_dw_garden_starwalkerdash)
			{
				starwalker_gone();
			}
			with (dead)
			{
				instance_destroy();
			}
			global.interact = 0;
			beatcon = 3;
			with (obj_bulletarea_neo)
			{
				instance_destroy();
			}
			instance_destroy();
		}
	}
}
with (obj_overworld_dashbullet)
{
	with (instance_place(x, y + 40, obj_dw_cliffs_tallgrass))
	{
		touching = true;
	}
}
");

