			{
				_weird_mode_shake = true;
				_weird_mode_xx = x;
				_weird_mode_yy = y;
				_weird_mode_shakeamt = 2;
				_weird_mode_shakereduct = 0.8 / global.fps_scale;
				_weird_mode_on = 1;
				_weird_mode_shake_timer = round(choose(30, 45, 60) * global.fps_scale);
			}
		}
		if (_weird_mode_shake)
		{
			_weird_mode_shakeamt -= _weird_mode_shakereduct;
			_weird_mode_on *= -1;
			_weird_mode_xx = x + (_weird_mode_shakeamt * _weird_mode_on);
			_weird_mode_yy = y;
