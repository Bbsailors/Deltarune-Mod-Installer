						myxoff = 54;
						myyoff = -42;
						if (dir == 1)
						{
							myxoff = -14;
						}
						break;
					case 4:
						myxoff = 82;
						myyoff = -2;
						if (dir == 1)
						{
							myxoff = 50;
						}
						break;
					case 5:
						myxoff = -40;
						myyoff = -64;
						if (dir == 1)
						{
							myxoff = 80;
						}
						break;
				}
				actualcat[i].x = ralsei.x + myxoff;
				actualcat[i].y = ralsei.y + myyoff;
				actualcat[i].interpolate = true;
			}
		}
	}
	lerpstrength = lerp(lerpstrength, 0.1, scr_fps_lerp_rate(0.1));
	with (kris)
	{
