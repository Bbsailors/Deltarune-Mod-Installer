	c_speaker(""no_name"");
	c_msgsetloc(0, ""* Can we^1, uh.../"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_842_0"");
	c_msgnextloc(""* Can I^1, see the part of the employee contract.../"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_843_0"");
	c_msgnextloc(""* That stipulates^1, fruit-flavored vacations?/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_844_0"");
	c_facenext(""tenna"", 0);
	c_msgnextloc(""* Oh^1, uh^1, yeah^1! Yeah^1, right here^1! Haha^1! I'm adding it!/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_846_0"");
