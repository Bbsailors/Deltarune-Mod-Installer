Apply("gml_Object_obj_mike_bomb_Step_0", @"if (con < 0)
{
	exit;
}
if (con == 0 && !i_ex(obj_dialoguer))
{
	con = 1;
	snd_pause(global.currentsong[1]);
	scr_fadeout(1);
	timer = 0;
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	var bombdelay = 60;
	var resetdelay = 60;
	if (timer == bombdelay)
	{
		var expl = instance_create(bomb_marker.x + 20, bomb_marker.y + 40, obj_animation);
		with (expl)
		{
			image_xscale = 0.5;
			image_yscale = 0.5;
			sprite_index = spr_realisticexplosion;
			image_speed = 1 / global.fps_scale;
		}
		snd_play(snd_explosion_firework_bc);
	}
	if (timer == (bombdelay + resetdelay))
	{
		with (bomb_marker)
		{
			instance_destroy();
		}
		snd_play(snd_mike_reset);
		reset_blend = 1;
	}
	if (timer == (bombdelay + resetdelay + 150))
	{
		reset_blend = 0;
		snd_volume(global.currentsong[1], 0, 0);
	}
	if (timer == (bombdelay + resetdelay + 180))
	{
		snd_resume(global.currentsong[1]);
		snd_volume(global.currentsong[1], 1, 30);
		timer = 0;
		con = -1;
	}
}
");

