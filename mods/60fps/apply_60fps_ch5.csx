		pal_swap_reset();
	}
}
wave_siner += (1 / global.fps_scale);
if (mode == 0)
{
	for (i = 0; i < wave_max; i += 1)
	{
		if (palette_sprite == -4)
		{
			draw_sprite_part(sprite_index, 0, i, 0, 1, sprite_height, x + i + (sin((wave_siner + i) / 30) * 2), y);
		}
		else
		{
			pal_swap_set(palette_sprite, palette_index, false);
			draw_sprite_part(sprite_index, 0, i, 0, 1, sprite_height, x + i + (sin((wave_siner + i) / 30) * 2), y);
			pal_swap_reset();
		}
	}
}
if (mode == 1)
{
	wave_max = sprite_height;
	for (i = 0; i < wave_max; i += thickness)
	{
		if (palette_sprite == -4)
		{
			draw_sprite_part(sprite_index, 0, 0, i * thickness, sprite_width, thickness, x + i + (sin((wave_siner + i) / 30) * 2), y);
		}
		else
		{
			pal_swap_set(palette_sprite, palette_index, false);
			draw_sprite_part(sprite_index, 0, 0, i * thickness, sprite_width, thickness, x + i + (sin((wave_siner + i) / 30) * 2), y);
			pal_swap_reset();
		}
	}
}
if (palette_sprite == -4)
{
	draw_sprite(bg_beach_edge, 0, 358, 0);
}
else
{
	pal_swap_set(spr_palette_beach_edge, palette_index, false);
	draw_sprite(bg_beach_edge, 0, 358, 0);
	pal_swap_reset();
}
");

Apply("gml_Object_obj_whirlwind_particle_Step_0", @"if (!init)
{
	center.x = xstart;
	center.y = ystart;
	if (target != -4)
	{
		offset.x = (target.x - target.sprite_xoffset) + (target.sprite_width / 2);
		offset.y = (target.y - target.sprite_yoffset) + target.sprite_height;
	}
	init = true;
	if (downward)
	{
		height += 100;
		riser = (irandom(4) / 2) + 1;
	}
}
if (global.pause_plat)
{
	exit;
}
if (target != -4)
{
	center.x = target.x;
	center.y = target.y;
}
if (downward)
{
	distance -= (clamp(4 - riser, 0, 1) / global.fps_scale);
}
x = center.x + offset.x + (sin(siner / 8) * (distance + start_distance));
var _yner = cos(siner / 8);
y = center.y + offset.y + (_yner * (distance + start_distance) * 0.5);
if (downward && (y - height) > (owner.y + 20))
{
	instance_destroy();
}
if (lifetime <= 0)
{
	image_alpha -= (0.1 / global.fps_scale);
	if (image_alpha <= 0)
	{
		instance_destroy();
	}
}
else if (image_alpha < 1)
{
	image_alpha = scr_movetowards(image_alpha, 0.5, 0.25 / global.fps_scale);
}
lifetime -= (1 / global.fps_scale);
if (downward)
{
	height -= (riser / global.fps_scale);
	riser += (remap_clamped(80, 10, 0, 1, height) / global.fps_scale);
}
else
{
	height += (riser / global.fps_scale);
}
");

