Apply("gml_Object_obj_dw_garden_diner_bouncingstools_Draw_0", @"siner += (1 / global.fps_scale);
var height = 32;
var count = 5;
for (var i = 0; i < count; i++)
{
	draw_sprite_ext(spr_facade_diner_stool_root, 0, x, 2 + y + (i * height), 2, 2, 0, c_white, 1);
}
swaytime = lerp(swaytime, 0, scr_fps_lerp_rate(0.1));
for (var i = 0; i < count; i++)
{
	var xpos = clamp(scr_even((sin(siner / 1.4) * swaytime) / 2), -12, 12);
	var ypos = scr_even((cos((siner + (i * 40)) / 1.4) * swaytime) / 4);
	if ((i % 2) == 0)
	{
		xpos = -xpos;
		ypos = -ypos;
	}
	draw_sprite_ext(sprite_index, 0, x + xpos, 2 + y + ypos + (i * height), 2, 2, 0, c_white, 1);
}
");

Apply("gml_Object_obj_dw_garden_diner_bouncingstools_Step_0", @"if (con == 0)
{
	if (global.interact == 0)
	{
		if (scr_trigcheck(""bounceback""))
		{
			con = 1;
			var waittime = 30;
			global.interact = 1;
			snd_play(snd_bomb, 0.7, 1.4);
			snd_play(snd_bomb, 0.7, 1.1);
			with (obj_caterpillarchara)
			{
				follow = false;
			}
			with (obj_mainchara)
			{
				ignoredepth = true;
				freeze = true;
				fun = true;
				var howfast = clamp(wspeed, 0, 6 / global.fps_scale);
				hspeed = abs(howfast) * 2;
				scr_limitval_upper(id, ""y"", y, waittime);
				gravity = 1.5 / (global.fps_scale * global.fps_scale);
				show_debug_message_concat(howfast);
				vspeed = -howfast * 1.2;
				waittime = scr_returnwait_gravity(id, undefined, y) / global.fps_scale;
			}
			timer = waittime + 4;
			swaytime = waittime * 4;
		}
	}
}
if (con == 1)
{
	timer -= (1 / global.fps_scale);
	with (obj_mainchara)
	{
		hspeed = lerp(hspeed, 0, scr_fps_lerp_rate(0.125));
	}
	if (timer <= 0)
	{
		with (obj_mainchara)
		{
			ignoredepth = false;
			setxy(scr_even(x), scr_even(y));
			gravity = 0;
			vspeed = 0;
			hspeed = 0;
			friction = 0;
			fun = false;
			freeze = false;
			with (obj_limit_val)
			{
				if (target == other.id)
				{
					instance_destroy();
				}
			}
		}
		with (obj_caterpillarchara)
		{
			follow = true;
			scr_caterpillar_interpolate_old();
		}
		global.interact = 0;
		con = 0;
	}
}
");

