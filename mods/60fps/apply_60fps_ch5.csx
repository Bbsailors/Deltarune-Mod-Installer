			image_xscale = 0.2 * throw_direction;
			neutralized = 9999;
			target_x = other.shuriken_target_x;
			target_y = other.shuriken_target_y;
			throwheight = other.shuriken_throwheight;
			target_depth = depth - 100000;
			fadecolor = other.fadecolor;
			shuriken_targetflag = other.shuriken_targetflag;
			image_blend = merge_color(fadecolor, c_white, 0.2);
			x = get_real_x();
			y = get_real_y();
		}
	}
	if (timer == 20)
	{
		con = 0;
		timer = 0;
		sprite_index = spr_shinobeetle_pose;
	}
}
");

Apply("gml_Object_obj_plat_sinerbullet_Step_0", @"if (global.pause_plat)
{
	exit;
}
var _ys = array_get(scr_platswap_yscale(), 0);
if (fusumadodge && _ys < 0.5)
{
	visible = 0;
	exit;
}
timer += (timer_inc / global.fps_scale);
image_alpha = -1 + (2 * _ys);
visible = image_alpha > 0 && __visible;
if (timer >= 2)
{
	if (image_alpha < 1)
	{
		image_alpha += (0.1 / global.fps_scale);
	}
	if (image_alpha >= 1)
	{
		active = 1;
	}
}
if (amp_h == -1)
{
	amp_h = amp;
}
var lx = x;
var ly = y;
var spinrate = rotation_speed;
if (move_pattern == 0)
{
	x = xstart + (sin((timer * freq) + degtorad(offset)) * amp_h);
	spinrate = cos((timer * freq) + degtorad(offset + 45));
	image_yscale = sign(spinrate) * 2;
}
else if (move_pattern == 1)
{
	y = ystart + (sin((timer * freq) + degtorad(offset)) * amp);
	spinrate = cos((timer * freq) + degtorad(offset + 45));
}
else if (move_pattern == 2)
{
	timer_inc_sinetimer += (timer_inc_sine / global.fps_scale);
	timer += ((sin(timer_inc_sinetimer * 0.06) * 1.3) / global.fps_scale);
	x = xstart + (sin((timer * freq) + degtorad(offset)) * amp_h);
	y = ystart + (cos((timer * freq) + degtorad(offset)) * amp);
	spinrate = (1 - (abs(freq) * 3)) + (sin(timer_inc_sinetimer * 0.06) * 1);
}
else if (move_pattern == 3)
{
	x = xstart + (clamp(2 * sin((timer * freq) + degtorad(offset)), -1, 1) * amp_h);
	y = ystart + (clamp(2 * cos((timer * freq) + degtorad(offset)), -1, 1) * amp);
}
if (instance_exists(obj_plat_player))
{
	depth = obj_plat_player.depth;
}
if (visible && !behind_fusuma_only && (timer % 2) == 0 && !is_culled)
{
	afterimage_particle_system.depth = depth + 1;
	afterimage_particle_system.x = x;
	afterimage_particle_system.y = y;
	afterimage_struct.image_angle = image_angle;
	afterimage_struct.image_xscale = image_xscale;
	afterimage_struct.image_yscale = image_yscale;
	afterimage_particle_system.emit(afterimage_struct);
}
image_angle += ((-spinrate * 40) / global.fps_scale);
image_index = lerp(0, 2, abs(spinrate) * 0.5);
var coincount = array_length(coins);
if (coincount > 0)
{
	var i = coincount * coin_distance;
	while (i >= 1)
	{
		remx[i] = remx[i - 1];
		remy[i] = remy[i - 1];
		i--;
	}
	remx[0] = x;
	remy[0] = y;
	for (i = 0; i < coincount; i++)
	{
		if (instance_exists(coins[i]) && coins[i].placed_in_room)
		{
			coins[i].visible = visible;
			coins[i].depth = depth;
			coins[i].vspeed = 0;
			coins[i].x = remx[(i + 1) * coin_distance];
			coins[i].y = remy[(i + 1) * coin_distance];
		}
	}
}
");

Apply("gml_Object_obj_plat_sinerbullet_Step_1", @"if (hitstop > 0 && !global.pause_plat)
{
	hitstop -= (1 / global.fps_scale);
}
var _ys = array_get(scr_platswap_yscale(), 0);
if (fusumadodge && _ys < 0.5)
{
	exit;
}
if (!instance_exists(obj_plat_player))
{
	image_alpha = 1;
	depth = 9999999;
}
else
{
	image_alpha += (0.1 / global.fps_scale);
}
var _paused = 0;
if (hitstop > 0)
{
	_paused = 1;
}
if (!custom_paused && _paused)
{
	on_pause();
	paused = 0;
	custom_paused = true;
}
if (custom_paused && !_paused)
{
	on_unpause();
	custom_paused = false;
}
if (!paused && !custom_paused)
{
	t += (1 / global.fps_scale);
	neutralized = false;
	if (behind_fusuma_only && instance_exists(obj_plat_playerheart))
	{
		with (obj_plat_playerheart)
		{
			if (!place_meeting(x, y, obj_plat_fusumawall))
			{
				other.neutralized = true;
			}
		}
	}
	if (is_method(step_func))
	{
		step_func();
	}
	if (t > lifetime && lifetime != -1)
	{
		scr_afterimagefast();
		instance_destroy();
	}
}
");

