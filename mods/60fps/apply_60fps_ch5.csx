	candy.image_speed = 0.25 / global.fps_scale;
	candy.depth = depth - 100;
	candy.image_xscale = 2;
	candy.image_yscale = 2;
	candy.target_enemy = target_enemy;
}
if (target_enemy == ""orange"")
{
