Apply("gml_Object_obj_dw_cliff_twirlflowerplatforming_Step_0", @"if (!init)
{
	init = 1;
	with (obj_falling_leaf_area)
	{
		no_leafling = no_leafling || other.no_leafling_spawn;
	}
	with (obj_plat_pinatabell)
	{
		on_hit = other.on_bell_hit;
	}
	if (global.start_in_platmode != 0)
	{
		with (npc_floradinn)
		{
			y += 80;
		}
	}
}
if (encounterstate == 0 && i_ex(obj_battlecontroller))
{
	encounterstate = 1;
}
else if (encounterstate == 1 && i_ex(obj_battlecontroller) && obj_battlecontroller.bp <= 0)
{
	encounterstate = 2;
	var target = 1200;
	var close = -4;
	var closedist = 9999999999;
	with (obj_plat_twirlflower)
	{
		var dist = point_distance(x, y, target.x, target.y);
		if (dist < closedist)
		{
			close = self;
			closedist = dist;
		}
	}
	var diffx = [target.x];
	var diffy = [target.y];
	with (target)
	{
		x = close.x;
		y = close.y - (0.5 * target.sprite_height);
	}
	camlerp = 10;
	with (obj_tensionbar)
	{
		visible = 0;
	}
	diffx[0] = target.x - diffx[0];
	diffy[0] = target.y - diffy[0];
	with (obj_caterpillarchara)
	{
		var lastx = x;
		var lasty = y;
		x = target.x;
		y = (target.y + (0.5 * target.sprite_height)) - (0.5 * sprite_height);
		array_push(diffx, 0);
		array_push(diffy, 0);
	}
	for (var i = 0; i <= 2; i++)
	{
		global.heromakex[i] += diffx[0];
		global.heromakey[i] += diffy[0];
	}
	camerax_set(target.x - 320);
	cameray_set(target.y - 240);
}
if (camlerp >= 0)
{
	camlerp -= (1 / global.fps_scale);
	with (obj_plat_camera)
	{
		var _k = 0.1 * (10 - other.camlerp);
		var _r = (_k >= 1) ? _k : (1 - power(1 - _k, 1 / global.fps_scale));
		x = lerp(x, obj_plat_player.x, _r);
		y = lerp(y, obj_plat_player.y, _r);
	}
	if (camlerp == 0)
	{
		if (talkcon == 1)
		{
			talkcon = 2;
		}
	}
}
scr_get_plat_followers();
if (plat_susie == -4)
{
	exit;
}
if (talkcon == 0)
{
	talkcontimer += (1 / global.fps_scale);
	if (talkcontimer >= 15)
	{
