		{
			with (obj_multiboss_controller_enemy3)
			{
				global.monsterhp[myself] = global.monstermaxhp[myself];
				healamt = instance_create(global.monsterx[myself], global.monstery[myself], obj_dmgwriter);
				with (healamt)
				{
					delay = 8;
					type = 3;
					damage = global.monstermaxhp[obj_multiboss_controller_enemy3.myself];
					specialmessage = 3;
				}
				hanim = instance_create(x, y, obj_healanim);
				hanim.target = id;
			}
		}
	}
	if (healtimer >= 15)
	{
		with (milk)
		{
			instance_destroy();
		}
		healcon = 5;
		healtimer = 0;
	}
}
if (healcon == 5)
{
	healtimer += (1 / global.fps_scale);
	if (healtimer >= 30)
	{
		with (obj_writer)
		{
			instance_destroy();
		}
		healcon = 6;
		if (whohealed == 1)
		{
			msgset(0, ""* obj_multiboss_controller_enemy1's HP went up!/%"");
		}
		if (whohealed == 2)
		{
			msgset(0, ""* obj_multiboss_controller_enemy2's HP went up!/%"");
		}
		if (whohealed == 3)
		{
			msgset(0, ""* obj_multiboss_controller_enemy3's HP went up!/%"");
		}
		if (whohealed == 4)
		{
			msgset(0, ""* obj_multiboss_controller_enemy1's and obj_multiboss_controller_enemy2's HP went up!/%"");
		}
		if (whohealed == 5)
		{
			msgset(0, ""* obj_multiboss_controller_enemy1's and obj_multiboss_controller_enemy3's HP went up!/%"");
		}
		if (whohealed == 6)
		{
			msgset(0, ""* obj_multiboss_controller_enemy2's and obj_multiboss_controller_enemy3's HP went up!/%"");
		}
		scr_battletext_default();
	}
}
if (healcon == 6)
{
	global.turntimer = 999;
	if (!instance_exists(obj_writer))
	{
		global.fc = 0;
		healcon = 0;
		healtimer = 0;
		global.turntimer = 1;
	}
}

