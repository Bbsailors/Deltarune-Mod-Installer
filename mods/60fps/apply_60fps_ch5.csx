wrong_accusation = function()
{
	snd_play(snd_error);
	with (obj_yellow_enemy)
	{
		fail_counter++;
		global.actcost[myself][1] = 50;
		just_failed = true;
		justice_cost = 50;
		yellow_justice_check();
	}
	with (obj_trial_perp)
	{
		do_move = false;
		active = false;
		perp_reset();
	}
	switch (current_perp.perp_index)
	{
		case UnknownEnum.Value_0:
			if (trial_id == 2)
			{
				if (array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == 6)
				{
					if (obj_yellow_enemy.aqua_scissor_counter)
					{
						aqua_special_scissors_2();
					}
					else
					{
						aqua_special_scissors_1();
						obj_yellow_enemy.aqua_scissor_counter++;
					}
				}
				else if (obj_yellow_enemy.aqua_wrong_counter)
				{
					aqua_special_wrong_2();
				}
				else
				{
					aqua_special_wrong_1();
					obj_yellow_enemy.aqua_wrong_counter++;
				}
			}
			else
			{
				wrong_aqua();
			}
			break;
		case UnknownEnum.Value_1:
			if (trial_id == 0)
			{
				if (array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == 4)
				{
					seth_special_1();
				}
				else
				{
					seth_special_2();
				}
			}
			else
			{
				wrong_seth();
			}
			break;
		case UnknownEnum.Value_2:
			if (trial_id == 1)
			{
				green_special();
			}
			else
			{
				wrong_green();
			}
			break;
		case UnknownEnum.Value_3:
			if (trial_id == 3)
			{
				blue_special();
			}
			else
			{
				wrong_blue();
			}
			break;
		case UnknownEnum.Value_4:
			if (trial_id == 1 && array_get(ds_list_find_value(evidence_list, evidence_counter), 2) == 5)
			{
				yellow_special();
			}
			else
			{
				wrong_yellow();
			}
			break;
		case UnknownEnum.Value_5:
			wrong_flowery();
			break;
	}
};

dog_special = function()
{
	snd_play(snd_grab);
	var perp_aqua = self.perp_aqua;
	var perp_seth = self.perp_seth;
	var perp_green = self.perp_green;
	var perp_blue = self.perp_blue;
	var perp_yellow = self.perp_yellow;
	with (obj_writer)
	{
		instance_destroy();
	}
	with (obj_blue_enemy)
	{
		with (instance_create(camerax() + (camerawidth() * 0.5) + 60, cameray() + 280, obj_bulletparent))
		{
			sprite_index = spr_dog_walk;
			image_xscale = -2;
			image_yscale = 2;
			image_speed = 0.25;
			depth = -550;
		}
		msgset_add_func(function()
		{
			global.typer = 6;
			msgset(0, obj_yellow_trial_manager.dog_special_1);
			with (scr_battletext())
			{
				depth = -500;
			}
		});
		msgset_add_func(function()
		{
			global.typer = 6;
			msgset(0, obj_yellow_trial_manager.dog_special_2);
			with (scr_battletext())
			{
				depth = -500;
			}
			with (obj_bulletparent)
			{
				if (sprite_index == spr_dog_walk)
				{
					timer = 0;
					gravity_direction = 90;
					gravity = 0.5 / (global.fps_scale * global.fps_scale);
					snd_play(snd_rocket_long);
					scr_script_repeat(function()
					{
						timer++;
						if (timer == 20)
						{
							with (obj_yellow_trial_manager.perp_seth)
							{
								sprite_index = spr_seth_panic_notice;
								image_xscale *= -1;
								x += 70;
								scr_shakeobj();
							}
						}
						x += choose(-1, 1);
						y += choose(-1, 1);
						with (instance_create(x, y + 10, obj_bulletparent))
						{
							depth = -540;
							sprite_index = spr_launchsmoke;
							image_xscale = 2;
							image_yscale = 2;
							image_angle = irandom(360);
							direction = 270 + random_range(-22.5, 22.5);
							speed = (3 + random(3)) / global.fps_scale;
							scr_lerpvar(""image_alpha"", 1, 0, 30);
							scr_doom(id, 30);
						}
						if (timer >= 120)
						{
							instance_destroy();
						}
					}, 240, 1);
				}
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 100);
		});
		msgset_add(other.dog_special_3, perp_yellow.xstart, perp_yellow.ystart - perph(perp_yellow) - 5, 13, 50, function()
		{
			with (obj_battleblcon)
			{
				depth = -500;
			}
		});
		msgset_add(other.dog_special_4, perp_blue.xstart - 8, (perp_blue.ystart - perph(perp_blue)) + 5, 13, 50, function()
		{
			with (obj_battleblcon)
			{
				depth = -500;
			}
		});
		msgset_add_func(function()
		{
			with (obj_yellow_enemy)
			{
				gain_evidence();
			}
			global.typer = 6;
			snd_play(snd_item);
			msgset(0, obj_blue_enemy.blue_evidence_3);
			with (scr_battletext())
			{
				depth = -500;
			}
		});
		msgset_add_func(function()
		{
			with (obj_yellow_trial_manager)
			{
				end_trial();
			}
		});
		blue_balloon();
	}
};

right_accusation = function()
{
	with (obj_yellow_enemy)
	{
		just_succeeded = true;
		trial_counter = scr_approach(trial_counter, 3, global.fps_scale);
		fail_counter = 0;
		global.actcost[myself][1] = 100;
		justice_cost = 100;
		yellow_justice_check();
	}
	with (obj_trial_perp)
	{
		do_move = false;
		active = false;
		perp_reset();
	}
	switch (current_perp.perp_index)
	{
		case UnknownEnum.Value_0:
			right_aqua();
			break;
		case UnknownEnum.Value_1:
			right_seth();
			break;
		case UnknownEnum.Value_2:
			right_green();
			break;
		case UnknownEnum.Value_3:
			right_blue();
			break;
		case UnknownEnum.Value_4:
			wrong_yellow();
			break;
		case UnknownEnum.Value_5:
			right_flowery();
			break;
	}
};

how_close = function(arg0 = 0)
{
	var perp_aqua = self.perp_aqua;
	var perp_seth = self.perp_seth;
	var perp_green = self.perp_green;
	var perp_blue = self.perp_blue;
	var perp_yellow = self.perp_yellow;
	global.typer = 6;
	switch (cstate)
	{
		case 0:
			msgset(0, obj_yellow_trial_manager.cstate_1);
			with (scr_battletext())
			{
				depth = -500;
			}
			break;
		case 1:
			msgset(0, obj_yellow_trial_manager.cstate_2);
			with (scr_battletext())
			{
				depth = -500;
			}
			break;
		case 2:
			msgset(0, obj_yellow_trial_manager.cstate_3);
			with (scr_battletext())
			{
				depth = -500;
			}
			break;
	}
	if (!obj_yellow_enemy.evidence_obtained[trial_id])
	{
		with (obj_blue_enemy)
		{
			msgset_insert_func(function()
			{
				with (obj_yellow_enemy)
				{
					gain_evidence();
				}
				global.typer = 6;
				snd_play(snd_item);
				msgset(0, blue_evidence_3);
				with (scr_battletext())
				{
					depth = -500;
				}
			}, 1);
			msgset_insert(other.missing_evidence_2, perp_blue.xstart + 4, (perp_blue.ystart - perph(perp_blue)) + 20, 13, 50, function()
			{
				with (obj_battleblcon)
				{
					depth = -500;
				}
			}, 1);
			msgset_insert(other.missing_evidence_1, perp_blue.xstart + 4, (perp_blue.ystart - perph(perp_blue)) + 20, 13, 50, function()
			{
				with (obj_battleblcon)
				{
					depth = -500;
				}
			}, 1);
		}
	}
};

end_trial = function()
{
	if (global.encounterno == 222)
	{
		audio_stop_sound(global.batmusic[3]);
		global.batmusic[3] = mus_loop_ext(global.batmusic[0], 1, 1);
	}
	scr_lerpvar(""darkness"", darkness, 0, 10);
	with (obj_flowery_lyrics)
	{
		target_alpha = 1;
	}
	with (obj_flowery_enemy)
	{
		with (blue_marker)
		{
			scr_move_to_point_over_time(xstart, ystart, 8);
		}
		with (yellow_marker)
		{
			scr_move_to_point_over_time(xstart, ystart, 8);
		}
	}
	with (obj_trial_perp)
	{
		if (perp_index != UnknownEnum.Value_3 && perp_index != UnknownEnum.Value_4 && perp_index != UnknownEnum.Value_5)
		{
			scr_lerpvar(""image_alpha"", 1, 0, 10);
			scr_lerpvar(""y"", y, y - 20, 10);
		}
		if (perp_index == UnknownEnum.Value_3)
		{
			scr_lerpvar(""x"", x, obj_blue_enemy.x, 10);
			scr_lerpvar(""y"", y, obj_blue_enemy.y, 10);
			depth = obj_blue_enemy.depth;
		}
		if (perp_index == UnknownEnum.Value_4)
		{
			scr_lerpvar(""x"", x, obj_yellow_enemy.x, 10);
			scr_lerpvar(""y"", y, obj_yellow_enemy.y, 10);
			depth = obj_yellow_enemy.depth;
		}
		if (perp_index == UnknownEnum.Value_5)
		{
			scr_lerpvar(""x"", x, obj_flowery_enemy.x, 10);
			scr_lerpvar(""y"", y, obj_flowery_enemy.y, 10);
			depth = obj_flowery_enemy.depth;
		}
	}
	with (obj_marker)
	{
		if (sprite_index == spr_trial_podium)
		{
			instance_destroy();
		}
	}
	scr_battle_sprite_reset(""kris"");
	scr_battle_sprite_reset(""susie"");
	scr_battle_sprite_reset(""ralsei"");
	scr_script_delayed(function()
	{
		with (obj_trial_perp)
		{
			instance_destroy();
		}
		instance_destroy();
		with (obj_blue_enemy)
		{
			visible = true;
		}
		with (obj_yellow_enemy)
		{
			visible = true;
		}
		with (obj_flowery_enemy)
		{
			visible = true;
		}
		with (obj_blue_enemy)
		{
			talked = 0;
		}
		with (obj_yellow_enemy)
		{
			actcon = 1;
			talked = 0;
		}
		with (obj_flowery_enemy)
		{
			actcon = 1;
			acting = 0;
			talked = 0;
			succeed_trial_count++;
			if (succeed_trial_count == 2)
			{
				phase = 6;
			}
			event_user(0);
		}
	}, 10);
};

