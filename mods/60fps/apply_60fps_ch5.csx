Apply("gml_Object_obj_town_w_shining_Create_0", @"con = -1;
customcon = 0;
_shiny_marker = scr_marker(x, y, spr_shine_white);
with (_shiny_marker)
{
	image_speed = 0.1 / global.fps_scale;
	scr_depth();
}
_readable = instance_create(x - 10, y - 5, obj_readable_room1);
with (_readable)
{
	extflag = ""shiny_trigger"";
}

remove_shine = function()
{
	with (_shiny_marker)
	{
		instance_destroy();
	}
	with (_readable)
	{
		instance_destroy();
	}
};

show_convo = function(arg0)
{
	if (arg0 != ""shiny_trigger"")
	{
		exit;
	}
	con = 0;
};
");

Apply("gml_Object_obj_trail_effect_Step_0", @"if (!init)
{
	trail_surf = surface_create(room_width, room_height);
	init = true;
}
var _length = array_length(points);
var i = array_length(points) - 1;
while (i >= 0)
{
	points[i].life -= 1 / lifetime;
	if (life < 0)
	{
		array_delete(points, i, 1);
	}
	i--;
}
var _point = 
{
	x: xlast,
	y: ylast,
	color: c_white,
	life: 1 - (1 / lifetime)
};
array_insert(points, 0, _point);
if (demo)
{
	var _angle_a = sin(siner / 20) * 45;
	scr_debug_print_persistent(""angle"", string(_angle_a));
	hingepos.x = camerax() + 320 + lengthdir_x(240, 270 + (sin(siner / 20) * 45));
	hingepos.y = cameray() + lengthdir_y(240, 270 + (sin(siner / 20) * 45));
	x = hingepos.x + lengthdir_x(80, (siner * 10) % 360);
	y = hingepos.y + lengthdir_y(80, (siner * 10) % 360);
	siner += (1 / global.fps_scale);
}
ylast = y;
xlast = x;
");

Apply("gml_Object_obj_trashy_beam_Draw_0", @"var _size = size + (sin((global.time * 2) / global.fps_scale) * 2);
image_xscale = length;
image_yscale = _size - 3;
gpu_set_blendmode(bm_add);
d_circle_color((x + 3) - _size, y - 8, max(_size - 2, 0), 10897953, 10897953, false);
draw_sprite_ext(sprite_index, 0, x - _size, y - 8, image_xscale, max(image_yscale - 2, 0), image_angle, #214AA6, 1);
d_circle_color((x + 3) - _size - 2, y - 8, max(_size - 4, 0), 14279497, 14279497, false);
draw_sprite_ext(sprite_index, 0, x - _size, y - 8, image_xscale, max(image_yscale - 4, 0), image_angle, #49E3D9, 1);
d_circle_color((x + 3) - _size - 2, y - 8, max(_size - 8, 0), 16777215, 16777215, false);
draw_sprite_ext(sprite_index, 0, x - _size, y - 8, image_xscale, max(image_yscale - 8, 0), image_angle, c_white, 1);
gpu_set_blendmode(bm_normal);
");

Apply("gml_Object_obj_trashy_beam_Step_0", @"if (scr_debug())
{
	if (keyboard_check_pressed(vk_control))
	{
		trashy_beam_go();
	}
}
if (active)
{
	with (obj_bullet_trash_small)
	{
		if (place_meeting(x, y, other.id))
		{
			snd_play(snd_explosion_firework, 0.45, 1);
			with (instance_create_depth(x, y, depth, obj_marker))
			{
				var _size = 2;
				image_xscale = _size;
				image_yscale = _size;
				sprite_index = spr_cakesmoke;
				direction = 90 + random_range(-10, 10);
				speed = 1 / global.fps_scale;
				scr_lerpvar(""image_alpha"", 1, 0, 12);
				scr_doom(id, 12);
			}
			var _rng = random(360);
			for (var a = 0; a < 5; a++)
			{
				with (instance_create(x, y, obj_regularbullet))
				{
					scr_bullet_inherit_from(id, 962);
					speed = 1 / global.fps_scale;
					direction = (a * 72) + _rng;
					image_angle = direction;
					sprite_index = spr_ponman_eyebullet;
					image_speed = 0.5 / global.fps_scale;
					gravity_direction = direction;
					gravity = 0.225 / (global.fps_scale * global.fps_scale);
					image_yscale = 1;
					image_xscale = 1.75;
				}
			}
			instance_destroy();
		}
	}
}
");

Apply("gml_Object_obj_trashy_broom_Step_0", @"var do_sweep = false;
if (active)
{
	with (obj_bullet_trash_small)
	{
		if (place_meeting(x, y, other.id))
		{
			image_alpha -= (0.1 / global.fps_scale);
			do_sweep = true;
			other.sweep = scr_approach(other.sweep, 1, 1);
			if (image_alpha < 0.5)
			{
				instance_destroy();
				snd_play(snd_coin, 0.5, 1.5);
				if (!i_ex(other.writer))
				{
					other.writer = scr_mercyadd(obj_trashy_trio.myself, 1);
					with (other.writer)
					{
						x += 20;
						y -= 50;
						ystart = y;
						noextend = true;
						killtimer = -9999;
						delaytimer = -9999;
						delay = -9998;
					}
				}
				else
				{
					with (other.writer)
					{
						damage++;
						damagemessage = ""+"" + string(damage) + ""%"";
						global.mercymod[obj_trashy_trio.myself] = scr_approach(global.mercymod[obj_trashy_trio.myself], 99, 1 * global.fps_scale);
					}
				}
				if (global.mercymod[obj_trashy_trio.myself] >= 99)
				{
					with (obj_trashy_trio)
					{
						do_postturn = true;
					}
					with (obj_battlecontroller)
					{
						noreturn = true;
					}
				}
				with (instance_create_depth(x, y, depth, obj_marker))
				{
					var _size = 1 + random(0.5);
					image_xscale = _size;
					image_yscale = _size;
					sprite_index = spr_cakesmoke;
					direction = 90 + random_range(-10, 10);
					speed = 1 / global.fps_scale;
					scr_lerpvar(""image_alpha"", 1, 0, 12);
					scr_doom(id, 12);
				}
				with (instance_create_depth(x, y, depth, obj_marker_fancy))
				{
					direction = 90;
					speed = 0.5 / global.fps_scale;
					scr_lerpvar(""image_alpha"", 1, 0, 20);
					scr_doom(id, 20);
					
					draw_func = function()
					{
						draw_set_font(scr_84_get_font(""main""));
						var _h = draw_get_halign();
						var _v = draw_get_valign();
						draw_set_halign(fa_center);
						draw_set_valign(fa_middle);
						draw_set_color(c_yellow);
						draw_set_alpha(image_alpha);
						draw_text(x, y, ""+1"");
						draw_set_alpha(1);
						draw_set_halign(_h);
						draw_set_valign(_v);
					};
				}
			}
		}
	}
}
if (!do_sweep)
{
	sweep = scr_approach(sweep, 0, 0.2);
}
");

Apply("gml_Object_obj_trashy_broom_Step_2", @"if (i_ex(obj_heart) && !active)
{
	active = true;
	visible = true;
	mask_index = sprite_index;
}
if (!i_ex(obj_heart) && active)
{
	instance_destroy();
	exit;
}
if (active)
{
	if (obj_heart.x != obj_heart.xprevious || obj_heart.y != obj_heart.yprevious)
	{
		angle_goal = point_direction(obj_heart.xprevious, obj_heart.yprevious, obj_heart.x, obj_heart.y);
	}
	angle += scr_anglechange(angle, angle_goal, angle_difference(angle_goal, angle) * scr_fps_lerp_rate(0.2));
	var _extra = sin((global.time * 1.5) / global.fps_scale) * 10 * sweep;
	image_angle = angle + _extra;
	x = obj_heart.x + 10 + lengthdir_x(10, angle + _extra);
	y = obj_heart.y + 10 + lengthdir_y(10, angle + _extra);
}
");

Apply("gml_Object_obj_trashy_hoop_Create_0", @"image_speed = 0;
mask_index = mask_empty;
visible = false;
bottom = instance_create_depth(x, y, 4.9, obj_marker);
with (bottom)
{
	sprite_index = spr_trashy_hoop;
	image_index = 1;
	image_speed = 0;
	visible = false;
}
active = false;
goal = 1;
writer = 0;

do_mercy = function(arg0 = 3)
{
	if (!i_ex(writer))
	{
		writer = scr_mercyadd(obj_trashy_trio.myself, arg0);
		with (writer)
		{
			x += 20;
			y -= 50;
			ystart = y;
			noextend = true;
			killtimer = -9999;
			delaytimer = -9999;
			delay = -9998;
		}
	}
	else
	{
		with (writer)
		{
			damage += arg0;
			damagemessage = ""+"" + string(damage) + ""%"";
			var _pitch = 1.4;
			snd_play_x(snd_mercyadd, 0.8, _pitch);
			global.mercymod[obj_trashy_trio.myself] = scr_approach(global.mercymod[obj_trashy_trio.myself], 99, arg0 * global.fps_scale);
		}
	}
	if (global.mercymod[obj_trashy_trio.myself] >= 99)
	{
		with (obj_trashy_trio)
		{
			do_postturn = true;
		}
		with (obj_battlecontroller)
		{
			noreturn = true;
		}
	}
};

box1 = [x - (20 * image_xscale), y - 8, x - (60 * image_xscale), y + 8];
box2 = [x - (60 * image_xscale), y - 5, x - (70 * image_xscale), y + 5];
box3 = [x - (20 * image_xscale), y - 5, x - (10 * image_xscale), y + 5];
");

Apply("gml_Object_obj_trashy_trio_Create_0", @"scr_enemy_object_init();
recruitcount = 1;
do_postturn = false;
box_extra = 0;
box_extra_counter = 0;
myattackchoice = 0;
grazepoints = 4;
timepoints = 4;
turns = -1;
fight_type = ""trashy"";
trashy_counter = -1;
nubert_counter = -1;
ball_counter = -1;
back = 0;
blocked_last_turn = false;
image_speed = 0.16666666666666666;
idlesprite = spr_nothing;
hurtsprite = spr_nothing;
sparedsprite = spr_nothing;
custom_draw_example = 0;
cantalk = true;
talked = 0;
talkmax = 90;

trashy_balloon = function(arg0 = x - 20, arg1 = y + 25)
{
	if (i_ex(obj_balloon_queue))
	{
		msgset_fromqueue();
	}
	else
	{
		global.typer = 50;
		talked = 1;
		talktimer = 0;
		rtimer = 0;
		return scr_enemyblcon(arg0, arg1, 10);
	}
};

trashy_balloon_control = function()
{
	if ((button3_p() && talktimer > 15) || !instance_exists(obj_writer))
	{
		with (obj_writer)
		{
			instance_destroy();
		}
		if (i_ex(obj_balloon_queue))
		{
			msgset_fromqueue();
		}
	}
};

end_turn_action = function()
{
	event_user(1);
	if (turns != 0)
	{
		switch (myattackchoice)
		{
			case 0:
				global.battlemsg[0] = s_trash_attack;
				break;
			case 1:
				global.battlemsg[0] = s_ball_attack;
				break;
			case 2:
				global.battlemsg[0] = s_nubert_attack;
				break;
			case 3:
			case 4:
				global.battlemsg[0] = s_trash_beam;
				break;
		}
	}
	if (blocked_last_turn)
	{
		global.battlemsg[0] = s_milk_spire;
		blocked_last_turn = false;
	}
};

nubert_marker = instance_create_depth(x + 90, y + 20, depth, obj_marker_fancy);
trashy_marker = instance_create_depth(x - 70, y - 12, depth, obj_marker_fancy);
ball_marker = instance_create_depth(x + 60, y - 15, depth, obj_marker_fancy);
with (ball_marker)
{
	image_alpha = 0;
