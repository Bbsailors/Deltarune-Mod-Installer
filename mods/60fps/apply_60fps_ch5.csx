}
");

Apply("gml_Object_obj_codeentry_Step_0", @"if (con == 0)
{
	timer += (1 / global.fps_scale);
	if (left_p())
	{
		snd_play_pitch(snd_menumove, 0.9);
		mpos--;
	}
	if (right_p())
	{
		snd_play_pitch(snd_menumove, 1);
		mpos++;
	}
	if (mpos == numcount)
	{
		mpos = 0;
	}
	if (mpos < 0)
	{
		mpos = numcount - 1;
	}
	if (down_h())
	{
		dholdbuff++;
	}
	else
	{
		dholdbuff = -1;
	}
	if (up_h())
	{
		uholdbuff++;
	}
	else
	{
		uholdbuff = -1;
	}
	if (up_h() && down_h())
	{
		dholdbuff = -1;
		uholdbuff = -1;
	}
	buffmodrate = max(1, round(5 * global.fps_scale));
	if ((uholdbuff % buffmodrate) == 0)
	{
		snd_play_pitch(snd_menumove, 1);
		num[mpos]++;
	}
	else if ((dholdbuff % buffmodrate) == 0)
	{
		snd_play_pitch(snd_menumove, 0.9);
		num[mpos]--;
	}
	if (num[mpos] > maxnum)
	{
		num[mpos] = 0;
	}
	if (num[mpos] < 0)
	{
		num[mpos] = maxnum;
	}
	if (button1_p())
	{
		snd_play_pitch(snd_menumove, 1.2);
		con = 1;
		timer = 0;
	}
	if (button2_p() && !noquit)
	{
		snd_play_pitch(snd_menumove, 0.8);
		con = 1;
		result = -2;
		timer = 31;
	}
}
if (con == 1)
{
	if (!entryonly)
	{
		timer += (1 / global.fps_scale);
		if (timer == 30)
		{
			var wrong = false;
			for (var i = 0; i < numcount; i++)
			{
				if (correctcode[i] != num[i])
				{
					wrong = true;
				}
				entrystring += string(num[i]);
			}
			if (wrong == true)
			{
				snd_play(snd_error);
				txtcolor = 255;
			}
			else
			{
				snd_play(snd_bell);
				txtcolor = 65535;
			}
			result = 1 - wrong;
		}
	}
	else
	{
	}
}
");

Apply("gml_Object_obj_confetti_Create_0", @"speed = random_range(10, 30) / global.fps_scale;
friction = 2 / (global.fps_scale * global.fps_scale);
fallspeed = 0;
siner = random(94.24777960769379);
image_blend = choose(#5555FF, #55FF55, #FF5555, c_aqua, c_orange);
");

Apply("gml_Object_obj_confetti_Step_0", @"if (speed < (5 / global.fps_scale))
{
	friction = 0.4 / (global.fps_scale * global.fps_scale);
}
if (speed < (2 / global.fps_scale))
{
	fallspeed = scr_movetowards(fallspeed, 2, 0.1 / global.fps_scale);
}
y += (fallspeed / global.fps_scale);
x += ((sin(siner / 15) * (fallspeed / 2)) / global.fps_scale);
siner += (1 / global.fps_scale);
image_speed = (1 / global.fps_scale) + (speed / 15);
");

Apply("gml_Object_obj_confetti_overworld_Create_0", @"speed = random_range(10, 30) / global.fps_scale;
friction = 2 / (global.fps_scale * global.fps_scale);
fallspeed = -random_range(20, 30) / global.fps_scale;
siner = random(94.24777960769379);
image_blend = choose(#5555FF, #55FF55, #FF5555, c_aqua, c_orange);
version = 0;
bottomless = false;
if (global.chapter == 3 && i_ex(obj_rouxls_ch3_enemy))
{
	version = 1;
	speed = random_range(4, 8) / global.fps_scale;
	fallspeed = -random_range(15, 25) / global.fps_scale;
	image_blend = make_color_rgb(224, 224, 192);
	image_index = irandom(5);
}
height = 1;
airborne = true;
destroyOnLand = false;
falltime = 0;
init = false;
maxDepth = 800100;
fallFriction = friction;
miny = 320;
maxy = 340;
shadow = -4;
image_xscale = 2;
image_yscale = 2;
topdrop = 0;
bottomdrop = 0;
shine_index = 0;
lifetime = 30;
preload = false;
preload_speed = 0;
fade = 0;
start_depth = 100000;
rearDepth = 1000100;
leaf = false;
");

Apply("gml_Object_obj_confetti_overworld_Draw_0", @"if (version == 1)
{
	if (falltime == 100)
	{
		shine_index = 1;
		if (!audio_is_playing(snd_boost))
		{
			snd_play(snd_boost);
		}
	}
	if (shine_index > 0)
	{
		draw_sprite_ext(spr_lancer_card_shine4, shine_index, x + 8, (y - height) + 8, image_xscale, image_yscale, image_angle, c_white, image_alpha);
		shine_index += (1 / global.fps_scale);
		if (shine_index >= 12)
		{
			shine_index = 0;
		}
	}
}
var _color = image_blend;
if (fade && height < 0)
{
	_color = merge_color(image_blend, c_black, round_to_multiple(clamp01(inverselerp(-80, -160, height)), 0.1));
}
draw_sprite_ext(sprite_index, image_index, x, y - height, image_xscale, image_yscale, image_angle, _color, image_alpha);
");

Apply("gml_Object_obj_confetti_overworld_Step_0", @"if (global.chapter == 3 && version == 1 && airborne == true)
{
	x -= (1 / global.fps_scale);
}
if (preload)
{
	if (speed > 0)
	{
		preload_speed = speed;
		speed = 0;
	}
	exit;
}
if (!preload && preload_speed != 0)
{
	speed = preload_speed;
	preload_speed = 0;
}
if ((y - height) > (cameray() + 500) || x < (camerax() - 100) || x > (camerax() + 740) || (!airborne && y < (cameray() - 100)))
{
	with (shadow)
	{
		instance_destroy();
	}
	instance_destroy();
}
if (!init)
{
	init = true;
	if (i_ex(shadow))
	{
		shadow.depth = maxDepth + 1;
	}
}
falltime += (1 / global.fps_scale);
if (!airborne)
{
	if (!destroyOnLand)
	{
		exit;
	}
	if (lifetime > 0)
	{
		lifetime -= (1 / global.fps_scale);
		exit;
	}
	siner -= (0.1 / global.fps_scale);
	image_alpha = min(siner, 1);
	if (siner <= 0)
	{
		instance_destroy();
	}
	exit;
}
if (version == 1)
{
	if (fallspeed < 0)
	{
		fallspeed += fallFriction;
	}
	if (fallspeed > (-5 / global.fps_scale))
	{
		fallFriction = 0.8 / (global.fps_scale * global.fps_scale);
	}
	if (speed < (5 / global.fps_scale))
	{
		friction = 0.4 / (global.fps_scale * global.fps_scale);
	}
	if (fallspeed < (10 / global.fps_scale))
	{
		fallspeed = scr_movetowards(fallspeed, 10 / global.fps_scale, 0.15 / (global.fps_scale * global.fps_scale));
	}
}
else
{
	if (fallspeed < 0)
	{
		fallspeed += fallFriction;
	}
	if (fallspeed > (-5 / global.fps_scale))
	{
		fallFriction = 0.4 / (global.fps_scale * global.fps_scale);
	}
	if (speed < (5 / global.fps_scale))
	{
		friction = 0.4 / (global.fps_scale * global.fps_scale);
	}
	if (fallspeed < (2 / global.fps_scale))
	{
		fallspeed = scr_movetowards(fallspeed, 2 / global.fps_scale, 0.1 / (global.fps_scale * global.fps_scale));
	}
}
height -= fallspeed;
var _over_gap = false;
if (airborne && (topdrop != 0 || bottomdrop != 0))
{
	var _minyy = miny;
	if (topdrop == 2 && y < (miny + 20))
	{
		_minyy += ((1 - cos(abs(x - 320) / 320)) * 40);
	}
	if (y < _minyy && topdrop >= 1)
	{
		y = _minyy;
	}
	else if (y > maxy && bottomdrop == 1)
	{
		y = maxy;
	}
	else if (y < _minyy && topdrop == -1)
	{
		_over_gap = true;
	}
	else if (y > maxy && bottomdrop == -1)
	{
		_over_gap = true;
	}
}
if (bottomless)
{
	_over_gap = true;
}
var landingheight = 0;
if (version == 1)
{
	landingheight = -64;
}
if (airborne && height <= landingheight && !_over_gap && fallspeed >= 0)
{
	instance_destroy(shadow);
	fallspeed = 0;
	height = landingheight;
	airborne = false;
	if (leaf)
	{
		image_index = 0;
	}
	else
	{
		image_index = (image_index < 4) ? 3 : 7;
	}
	speed = 0;
	image_speed = 0;
	x += sin(siner / 15);
	if (version == 0)
	{
		if (collision_rectangle(x - (sprite_width / 2), y - (sprite_height / 2), x + (sprite_width / 2), y + (sprite_height / 2), obj_confetti_overworld, false, true) != -4)
		{
			var _list = ds_list_create();
			var _count = collision_rectangle_list(x - (sprite_width / 2), y - (sprite_height / 2), x + (sprite_width / 2), y + (sprite_height / 2), obj_confetti_overworld, false, true, _list, false);
			depth = maxDepth - _count;
			ds_list_destroy(_list);
		}
		else
		{
			depth = maxDepth;
		}
	}
	siner = 3;
	exit;
}
x += (sin(siner / 15) * (fallspeed / 2));
siner += (1 / global.fps_scale);
image_speed = (0.25 / global.fps_scale) + (speed / 15);
var _midy = (miny + maxy) / 2;
if (height < 0 && y < _midy)
{
	scr_depth_relative(maxDepth, _midy);
}
else
{
	scr_depth_ext(start_depth);
}
if (i_ex(shadow))
{
	shadow.image_alpha = (y > !_over_gap) ? 0 : 1;
	shadow.image_index = image_index;
	shadow.x = x + ((sprite_width - shadow.sprite_width) / 2);
	shadow.y = y + ((sprite_height - shadow.sprite_height) / 2);
	var shadowScale = clamp((40 - (height / 2)) / 20, 0, 2);
	shadow.image_xscale = shadowScale;
	shadow.image_yscale = shadowScale;
}
if (version == 1)
{
	if (i_ex(obj_rouxls_ch3_enemy))
	{
		depth = obj_rouxls_ch3_enemy.depth - 1;
	}
}
");

Apply("gml_Object_obj_confetti_wind_Step_0", @"var _list = ds_list_create();
var _num;
if (circle)
{
	_num = collision_circle_list(x, y, radius, obj_confetti_overworld, false, true, _list, false);
}
else
{
	_num = collision_rectangle_list(x - (size.x / 2), y - (size.y / 2), x + (size.x / 2), y + (size.y / 2), obj_confetti_overworld, false, true, _list, false);
}
if (_num > 0)
{
	for (i = 0; i < _num; i++)
	{
		with (ds_list_find_value(_list, i))
		{
			if (!airborne)
			{
				airborne = true;
				fallspeed = -other.upward_force / global.fps_scale;
				speed = other.force / global.fps_scale;
				if (radial)
				{
					direction = point_direction(other.x, other.y, x, y);
				}
				else
				{
					direction = other.direction;
				}
				event_user(0);
			}
		}
	}
}
if (lifetime > 0)
{
	lifetime -= (1 / global.fps_scale);
	if (lifetime <= 0)
	{
		instance_destroy();
	}
}
ds_list_destroy(_list);
");

Apply("gml_Object_obj_credits_ch5_audio_Step_0", @"if (!_active)
{
	exit;
}
if (scr_debug())
{
	if (sunkus_kb_check_pressed(82))
	{
		snd_free_all();
		room_restart();
	}
	if (sunkus_kb_check_pressed(32))
	{
		if (!paused)
		{
			paused = true;
			audio_pause_all();
		}
		else
		{
			paused = false;
			audio_resume_all();
		}
	}
}
if (paused)
{
	exit;
}
_timer += (1 / global.fps_scale);
if (_timer >= round(_time_stamps[_time_stamp_index] * 30))
{
	if (_time_stamp_index < (array_length(_time_stamps) - 1))
	{
		_time_stamp_index++;
		emit_event(""timestamp_changed"");
	}
	else
	{
		_active = false;
		emit_event(""credits_finished"");
	}
}
");

