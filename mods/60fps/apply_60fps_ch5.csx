	plate_marker.targety = pos_plate.y;
	cheese_marker.targety = pos_cheese.y;
	
	flip_func = function()
	{
		if (visible)
		{
			image_alpha++;
			if ((y + vspeed) > ystart && flipfinish < 2 && flipfinish >= 0)
			{
				flipfinish = 1;
				image_angle = 0;
				hspeed = 0;
				gravity = 0;
			}
			if ((y + vspeed) >= targety && flipfinish == 1)
			{
				flipfinish = 2;
				image_xscale = 2.4;
				image_yscale = 1.8;
				speed = 0;
				y = targety;
				if (sprite_index == spr_dw_garden_diner_roundtable)
				{
					var ref = instance_create(x - 32, y - 46, obj_reflection);
					with (ref)
					{
						sprite_index = spr_dw_garden_diner_roundtable_reflection;
						scr_darksize();
					}
				}
			}
			if (flipfinish == 0)
			{
				image_angle += (12 / global.fps_scale);
				if (sprite_index == spr_dw_garden_diner_roundtable)
				{
					image_xscale = min(image_xscale + (0.1 / global.fps_scale), 2);
					image_yscale = image_xscale;
				}
			}
			if (flipfinish > 0)
			{
				image_xscale = max(image_xscale - (0.07 / global.fps_scale), 2);
				image_yscale = min(image_yscale + (0.07 / global.fps_scale), 2);
			}
		}
	};
	
