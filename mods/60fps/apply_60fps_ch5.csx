		}
		snd_free_all();
		room_goto(room_gameover);
	}
	if (global.flag[35] == 1)
	{
		global.turntimer = -1;
		global.flag[36] = 1;
		global.flag[39] = 1;
	}
	if (global.flag[35] == 2)
	{
		audio_stop_all();
		snd_play(snd_hurt1);
		snd_free_all();
		global.entrance = 0;
		global.tempflag[9] = 1;
