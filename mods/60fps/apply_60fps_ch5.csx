			var phx = obj_plat_playerheart.x + 11;
			var phy = obj_plat_playerheart.y + 11;
			var dist = point_distance(heart_x, heart_y, phx, phy);
			var dir = point_direction(heart_x, heart_y, phx, phy);
			var i = 0.5 * dist;
			while (i < dist)
			{
				var hx = heart_x + lengthdir_x(i, dir);
				var hy = heart_y + lengthdir_y(i, dir);
				with (scr_afterimage_monochrome(65535, true))
				{
					x = hx;
					y = hy;
					sprite_index = spr_omegaflowery_heart;
					image_xscale = 1;
					image_yscale = 1;
					fade_when_paused = true;
					image_alpha = lerp(0.8, 0, 1 - ((i / dist) * 0.5));
