Apply("gml_Object_obj_dw_fcastle_fusumadodge_Step_0", @"if (!init)
{
	init = 1;
	if (global.flag[1455] >= 100)
	{
		with (obj_doorAny)
		{
			if (doorRoom == room_dw_fcastle_right_wing_floweryscene)
			{
				doorRoom = room_dw_fcastle_right_puzzle;
				doorEntrance = 3;
			}
		}
	}
	set_sethaqua_state(min(global.flag[1455], 5));
	if (sethaqua_state == 0)
	{
		with (npc_seth_beginning)
		{
			force_animation(8217);
			scr_delay_var(""image_speed"", 0, 2);
			sprite_image_index = 0;
			scr_delay_var(""sprite_image_index"", 1, 60);
			other.left_seth_bubble = scr_messagebubble(stringsetloc(""This story...#you think#he'll like it?"", ""obj_dw_fcastle_fusumadodge_slash_Step_0_gml_25_0""), x - 140, y - 30, id, -2);
			other.left_seth_bubble.dropColor = merge_color(c_purple, c_black, 0.25);
			other.left_seth_bubble.textbubbleColor = merge_color(c_purple, c_white, 0.75);
		}
	}
	if (global.flag[1455] >= 30)
	{
		with (obj_solidblocksized_alt)
		{
			instance_destroy();
		}
		with (obj_fusuma_door)
		{
			if (!can_open)
			{
				fusuma_ignore = true;
				can_open = true;
				visible = true;
				add_darkzone();
				with (instance_create(x, y, obj_reflection))
				{
					image_xscale = other.sprite_width;
					image_yscale = other.sprite_height;
					sprite_index = spr_pxwhite;
					image_blend = c_black;
					depth = other.depth + 25;
				}
			}
		}
		door_opened = true;
	}
	else
	{
		with (obj_fusuma_door)
		{
			if (!can_open)
			{
				instance_destroy();
			}
		}
		with (obj_plat_asset)
		{
			if (sprite_index == spr_dw_fcastle_arrowsign)
			{
				instance_destroy();
			}
		}
	}
	with (npc_seth_beginning)
	{
		image_xscale = -image_xscale;
		entity_gravity = 0;
		timer = 0;
		vspeed = 0;
		hspeed = 0;
		gravity = 0;
		animstate = 0;
		animstatetimer = 0;
		custom_behaviour(function()
		{
			if (visible)
			{
				timer += (1 / global.fps_scale);
				if (animstate == 1)
				{
					animstatetimer += (1 / global.fps_scale);
					if (animstatetimer == 80)
					{
						depth += 10000000;
						hspeed = 12 / global.fps_scale;
						vspeed = -6 / global.fps_scale;
						physics = true;
						wallcollision = true;
						gravity = 0.5 / (global.fps_scale * global.fps_scale);
						entity_gravity = 0.5 / (global.fps_scale * global.fps_scale);
						force_animation(4422);
						sprite_image_index = 0;
						image_speed = 0;
					}
					if (animstatetimer > 80)
					{
						hspeed = 10 / global.fps_scale;
					}
					if (animstatetimer > 90 && grounded)
					{
						if (image_speed == 0)
						{
							force_animation(4554);
							image_speed = 0.5 / global.fps_scale;
						}
						hspeed = (13 + (0.025 * (animstatetimer - 100))) / global.fps_scale;
						if (hspeed > (14 / global.fps_scale))
						{
							image_alpha -= (0.1 / global.fps_scale);
						}
						var _cx = camerax();
						if (x > (_cx + 660))
						{
							instance_destroy();
						}
						else if (x < (_cx - 20))
						{
							instance_destroy();
						}
					}
				}
			}
		});
	}
	with (npc_aqua_beginning)
	{
		entity_gravity = 0;
		timer = 0;
		vspeed = 0;
		hspeed = 0;
		gravity = 0;
		image_speed = 0.25 / global.fps_scale;
		animstate = 0;
		animstatetimer = 0;
		custom_behaviour(function()
		{
			if (visible)
			{
				timer++;
				if (animstate < 2)
				{
					y = ystart + (abs(sin(degtorad(timer * 45 * image_speed))) * 8);
					if (animstate == 0)
					{
						x = xstart + (-sin(degtorad(timer * 45 * image_speed)) * 4);
					}
				}
				if ((timer % round(4 * global.fps_scale)) == 0 && scr_onscreen_tolerance(self, 50))
				{
					obj_dw_fcastle_fusumadodge.spawn_aqua_petals(x, y, depth, 0.3);
				}
				if (animstate == 1)
				{
					animstatetimer += (1 / global.fps_scale);
					if (animstatetimer == 30)
					{
						force_animation(3483);
						scr_doom(self, 80);
						animstate = 2;
						animstatetimer = 0;
					}
				}
				else if (animstate == 2)
				{
					animstatetimer += (1 / global.fps_scale);
					vspeed -= (0.2 / (global.fps_scale * global.fps_scale));
					hspeed -= (0.08 / (global.fps_scale * global.fps_scale));
					if ((animstatetimer % 12) == 0)
					{
						with (instance_create(x, y, obj_overworld_sinerbullet))
						{
							image_xscale = 0;
							image_yscale = 0;
							freq = 0.01;
							custom = true;
							scr_lerpvar(""image_xscale"", 0, 2, 10);
							scr_lerpvar(""image_yscale"", 0, 2, 10);
							hspeed = 12 / global.fps_scale;
							vspeed = 2 / global.fps_scale;
							friction = 0.3 / (global.fps_scale * global.fps_scale);
							snd_play(snd_swing, 0.8, 1.1);
							gravity_direction = 0;
							gravity = 1 / (global.fps_scale * global.fps_scale);
							scr_doom(self, 100);
						}
					}
				}
			}
		});
	}
	with (npc_aqua_atstatue)
	{
		entity_gravity = 0;
		timer = 0;
		vspeed = 0;
		hspeed = 0;
		gravity = 0;
		image_speed = 0.25 / global.fps_scale;
		force_animation(3483);
		animstate = 0;
		animstatetimer = 0;
		y_anchor = y;
		custom_behaviour(function()
		{
			if (visible)
			{
				timer++;
				if (animstate < 2)
				{
					y = y_anchor + (sin(degtorad(timer * 45 * image_speed)) * 8);
				}
				if ((timer % round(4 * global.fps_scale)) == 0 && scr_onscreen_tolerance(self, 50))
				{
					obj_dw_fcastle_fusumadodge.spawn_aqua_petals(x, y, depth, 0.3);
				}
				if (animstate == 1)
				{
					if (animstatetimer == 0)
					{
						scr_lerpvar(""y_anchor"", y_anchor, y_anchor + 300, 45, 1, ""out"");
						scr_lerpvar(""x"", x, x - 40, 45, 1, ""out"");
					}
					animstatetimer += (1 / global.fps_scale);
					if (animstatetimer == 30)
					{
						with (obj_dw_fcastle_fusumadodge)
						{
							with (npc_aqua_leftside)
							{
								visible = true;
							}
							with (statue_aqua_bubble)
							{
								instance_destroy();
							}
							statue_aqua_bubble = scr_messagebubble(stringsetloc(""Uuu, can you#dodge this?"", ""obj_dw_fcastle_fusumadodge_slash_Step_0_gml_204_0""), other.x + 120, other.y + 60, other, 80);
							statue_aqua_bubble.dropColor = merge_color(c_aqua, c_black, 0.25);
							statue_aqua_bubble.textbubbleColor = merge_color(c_aqua, c_white, 0.75);
						}
					}
					if (animstatetimer == 65)
					{
						scr_doom(self, 180);
						animstate = 2;
						depth += 100000;
						animstatetimer = 0;
					}
				}
				else if (animstate == 2)
				{
					animstatetimer += (1 / global.fps_scale);
					vspeed = clamp(1 - (animstatetimer * 0.05), -1, 0.5) / global.fps_scale;
					hspeed = (-animstatetimer * 0.25) / global.fps_scale;
					if ((animstatetimer % 12) == 0)
					{
						with (instance_create(x, y, obj_overworld_sinerbullet))
						{
							image_xscale = 0;
							image_yscale = 0;
							freq = 0.01;
							custom = true;
							scr_lerpvar(""image_xscale"", 0, 2, 10);
							scr_lerpvar(""image_yscale"", 0, 2, 10);
							hspeed = 12 / global.fps_scale;
							vspeed = 2 / global.fps_scale;
							friction = 0.3 / (global.fps_scale * global.fps_scale);
							gravity_direction = 0;
							gravity = 1 / (global.fps_scale * global.fps_scale);
							scr_doom(self, 100);
						}
					}
					if (x < (camerax() - 40))
					{
						instance_destroy();
					}
				}
			}
		});
	}
	with (npc_seth_atstatue)
	{
		entity_gravity = 0;
		timer = 0;
		vspeed = 0;
		hspeed = 0;
		gravity = 0;
		animstate = 0;
		animstatetimer = 0;
		scr_delay_var(""image_speed"", 0, 1);
		sprite_image_index = 0;
		force_animation(8272);
		head_marker = -4;
		arms_marker = scr_marker(x, y, spr_seth_hiding_arms);
		collar_marker = scr_marker(x, y, spr_seth_hiding_collar);
		head_marker = scr_marker(x, y, spr_seth_hiding_head);
		with (arms_marker)
		{
			scr_darksize();
		}
		with (collar_marker)
		{
			scr_darksize();
		}
		with (head_marker)
		{
			scr_darksize();
		}
		hidelerp = 0;
		y -= 4;
		ystart = y;
		custom_behaviour(function()
		{
			if (instance_exists(head_marker))
			{
				head_marker.image_index = sprite_image_index;
				arms_marker.image_index = sprite_image_index;
				collar_marker.image_index = sprite_image_index;
			}
			if (visible)
			{
				timer += (1 / global.fps_scale);
				if (animstate == 0 || animstate == 1)
				{
					gravity = 0;
					entity_gravity = 0;
					vspeed = 0;
					scr_depth(self, ystart - y);
					depth += 1000000;
					if (scr_trigcheck(""hide_seth""))
					{
						hidelerp = scr_approach(hidelerp, 1, 0.2);
					}
					else
					{
						hidelerp = scr_approach(hidelerp, 0, 0.2);
					}
					if (instance_exists(head_marker))
					{
						arms_marker.depth = depth - 1000400;
						with (obj_battlealphaer)
						{
							other.arms_marker.image_blend = merge_color(c_white, c_black, battlealpha);
						}
						collar_marker.depth = depth - 15;
						head_marker.depth = depth - 35;
						y = lerp(ystart, ystart + 6, hidelerp);
						head_marker.y = lerp(head_marker.ystart, head_marker.ystart + 10, hidelerp);
						arms_marker.y = lerp(arms_marker.ystart, arms_marker.ystart - 4, hidelerp);
					}
				}
				if (animstate == 1)
				{
					if (array_get(scr_platswap_yscale(), 0) > 0)
					{
						animstate = 2;
						with (obj_dw_fcastle_fusumadodge)
						{
							with (npc_aqua_atstatue)
							{
								animstate = 1;
								animstatetimer = 0;
							}
						}
					}
				}
				else if (animstate == 2)
				{
					animstatetimer += (1 / global.fps_scale);
					if (animstatetimer == 3)
					{
						animstate = 3;
						with (obj_dw_fcastle_fusumadodge)
						{
							with (left_seth_bubble)
							{
								instance_destroy();
							}
						}
						image_speed = 0.5 / global.fps_scale;
						hspeed = -8 / global.fps_scale;
						scr_plat_depthcast();
						depth += 100000;
						entity_gravity = 1.25 / (global.fps_scale * global.fps_scale);
						with (arms_marker)
						{
							instance_destroy();
						}
						with (head_marker)
						{
							instance_destroy();
						}
						with (collar_marker)
						{
							instance_destroy();
						}
						timer = 0;
						force_animation(4554);
					}
				}
				else if (animstate == 3)
				{
					hspeed = (-10 - (0.05 * timer)) / global.fps_scale;
					var _cx = camerax();
					if (x > (_cx + 660))
					{
						instance_destroy();
					}
					else if (x < (_cx - 20))
					{
						instance_destroy();
					}
				}
			}
		});
	}
	with (npc_seth)
	{
		entity_gravity = 0;
		timer = 0;
		if (other.sethaqua_state <= 3)
		{
			custom_behaviour(function()
			{
				if (visible)
				{
					scr_plat_depthcast();
					timer += (1 / global.fps_scale);
					y = ystart + (sin(timer * 0.25) * 8);
					image_xscale = 2 * cos(degtorad(timer * 20));
					if ((timer % 4) == 0 && scr_onscreen_tolerance(self, 50))
					{
						obj_dw_fcastle_fusumadodge.spawn_aqua_petals(x, y, depth);
					}
				}
			});
		}
	}
	with (npc_aqua_rightside)
	{
		entity_gravity = 0;
		timer = 0;
		se = other.npc_seth;
		force_animation(3483);
		if (other.sethaqua_state <= 3)
		{
			knives = [];
			with (obj_plat_sinerbullet)
			{
				if (abs(x - other.x) < 300)
				{
					array_push(other.knives, self);
					__visible = other.visible;
				}
			}
			custom_behaviour(function()
			{
				for (var i = 0; i < array_length(knives); i++)
				{
					knives[i].__visible = visible;
				}
				if (visible)
				{
					scr_plat_depthcast();
					timer += (1 / global.fps_scale);
					image_speed = 0.5 / global.fps_scale;
					x = se.xstart + (cos(timer * 0.2) * 72);
					y = se.ystart + (sin(timer * 0.2) * 32);
					if (y < se.ystart)
					{
						depth = se.depth + 5;
					}
					else
					{
						depth = se.depth - 5;
					}
					if ((timer % 4) == 0 && scr_onscreen_tolerance(self, 50))
					{
						obj_dw_fcastle_fusumadodge.spawn_aqua_petals(x, y, depth);
					}
				}
			});
		}
	}
	with (npc_aqua_leftside)
	{
		x += 20;
		y += 20;
		ystart = y;
		entity_gravity = 0;
		gravity = 0;
		timer = 0;
		pirouette_timer = 0;
		knives = [];
		with (obj_plat_sinerbullet)
		{
			if (abs(x - other.x) < 100)
			{
				array_push(other.knives, self);
				__visible = other.visible;
			}
		}
		if (other.sethaqua_state < 3)
		{
			speed_up_knives = function()
			{
				scr_plat_susie_attack_fast(self, true);
				act_su.active = false;
			};
			
			act_su = scr_configure_platmode_act(speed_up_knives, ""su"", stringsetloc(""Spin"", ""obj_dw_fcastle_fusumadodge_slash_Step_0_gml_448_0""), stringsetloc(""Lemme spin it..."", ""obj_dw_fcastle_fusumadodge_slash_Step_0_gml_449_0""));
			scr_plat_depthcast();
			act_su.active = true;
			custom_behaviour(function()
			{
				for (var i = 0; i < array_length(knives); i++)
				{
					knives[i].__visible = visible;
				}
				if (visible)
				{
					scr_plat_depthcast();
					timer += (1 / global.fps_scale);
					y = ystart + (sin(timer * 0.25) * 8);
					if (pirouette_timer > 0)
					{
						image_xscale = 2 * cos(degtorad(pirouette_timer));
						if (pirouette_timer == 720)
						{
							pirouette_timer = -1;
							force_animation(3483);
							scr_lerpvar(""hspeed"", 0, 16 / global.fps_scale, 90, 1, ""in"");
							scr_lerpvar(""ystart"", ystart, ystart - 480, 90, -1, ""in"");
							scr_script_delayed(function()
							{
								with (obj_dw_fcastle_fusumadodge)
								{
									with (npc_aqua_leftside)
									{
										visible = false;
									}
									with (npc_aqua_rightside)
									{
										visible = true;
									}
									with (npc_seth)
									{
										visible = true;
									}
								}
							}, 90);
						}
					}
					else if (pirouette_timer == 0)
					{
						if (place_meeting(x, y, obj_rudebuster_bolt_plat))
						{
							with (obj_dw_fcastle_fusumadodge)
							{
								aqua_con = 1;
								with (left_aqua_bubble)
								{
									instance_destroy();
								}
								if (instance_exists(npc_aqua_leftside))
								{
									left_aqua_bubble = scr_messagebubble(stringsetloc(""Uuu, he likes#fast spinning knives!?#OK!"", ""obj_dw_fcastle_fusumadodge_slash_Step_0_gml_484_0""), npc_aqua_leftside.x + 160, npc_aqua_leftside.y - 100, npc_aqua_leftside, 120);
									left_aqua_bubble.dropColor = merge_color(c_aqua, c_black, 0.25);
									left_aqua_bubble.textbubbleColor = merge_color(c_aqua, c_white, 0.75);
								}
							}
							snd_play(snd_pirouette);
							scr_plat_makecoins(x, y, 5, 90, 45, 8, 4);
							pirouette_timer = 1;
							scr_lerpvar(""pirouette_timer"", 1, 720, 75, 3, ""out"");
							force_animation(4562);
							global.flag[1455] = 3;
							with (obj_plat_sinerbullet)
							{
								scr_lerpvar(""timer_inc"", 1, 1.5, 30);
								scr_lerpvar(""timer_inc_sine"", 0, 1, 30);
							}
							with (obj_overworld_sinerbullet)
							{
								scr_lerpvar(""timer_inc"", 1, 1.5, 30);
								scr_lerpvar(""timer_inc_sine"", 0, 1, 30);
							}
						}
					}
					else
					{
						for (var i = 0; i < array_length(knives); i++)
						{
							knives[i].xstart = x;
							knives[i].ystart = y;
						}
					}
					if ((timer % 4) == 0 && scr_onscreen_tolerance(self, 50))
					{
						obj_dw_fcastle_fusumadodge.spawn_aqua_petals(x, y, depth);
					}
				}
			});
		}
	}
