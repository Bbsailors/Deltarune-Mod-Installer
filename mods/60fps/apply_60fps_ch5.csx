{
	grazetpfactor -= 0.3;
}
if (grazetimefactor > 3)
{
	grazetimefactor = 3;
}
if (grazetpfactor > 3)
{
	grazetpfactor = 3;
}
if (grazesizefactor > 3)
{
	grazesizefactor = 3;
}
if (grazetimefactor < 0)
{
	grazetimefactor = 0;
}
if (grazetpfactor < 0)
{
	grazetpfactor = 0;
}
if (grazesizefactor < 0)
{
	grazesizefactor = 0;
}
image_xscale = grazesizefactor;
image_yscale = grazesizefactor;
angle = 0;
if (instance_exists(obj_heart))
{
	sizexoff = 0;
	sizeyoff = 0;
