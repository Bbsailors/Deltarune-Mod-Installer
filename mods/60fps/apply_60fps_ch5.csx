Apply("gml_Object_obj_ch5_LW20W_blur_Step_0", @"if (!_enabled)
{
	exit;
}
_timer += (1 / global.fps_scale);
if ((_timer % 2) == 1)
{
	if (_timer < 30)
	{
		blurradius = choose(0.5, 0.75, 1);
		spinspeed = choose(0.02, 0.06, 0.08);
	}
	else if (_timer < 120)
	{
		blurradius = choose(1, 1.5, 2);
		spinspeed = choose(0.08, 0.1, 0.125, 0.15);
	}
	else if (_timer < 240)
	{
		blurradius = choose(2, 3, 6);
		spinspeed = choose(0.08, 0.125, 0.18, 0.2);
	}
	else
	{
		blurradius = choose(2, 4, 6, 8, 15);
		spinspeed = choose(0.02, 0.125, 0.18, 0.2);
	}
}
");

Apply("gml_Object_obj_ch5_LW20W_crt_Draw_0", @"var _sw = surface_get_width(application_surface);
var _sh = surface_get_height(application_surface);
if (surface_exists(surf) && (surface_get_width(surf) != _sw || surface_get_height(surf) != _sh))
{
	surface_free(surf);
}
if (!surface_exists(surf))
{
	surf = surface_create(_sw, _sh);
}
surface_set_target(surf);
draw_clear_alpha(c_black, 0);
draw_surface(application_surface, 0, 0);
surface_reset_target();
shader_replace_simple_set_hook(shader);
shader_set_uniform_f(u_time, time);
shader_set_uniform_f(u_aber, aberration);
var _multiplier = (global.darkzone == 0) ? 0.5 : 1;
draw_surface_ext(surf, camerax(), cameray(), camerawidth() / _sw, cameraheight() / _sh, 0, c_white, alpha);
shader_replace_simple_reset_hook();
");

Apply("gml_Object_obj_ch5_LW20W_crt_Step_0", @"aberration = 0.34;
spd = scr_wave(0, 0.75, 4, 0);
