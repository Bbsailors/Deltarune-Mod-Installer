npcscene1 = function()
{
	var _seth = findsprite(spr_seth_drawing, ""NPCs"", undefined, undefined);
	npc_seth = scr_makenpc_fromasset(_seth);
	with (npc_seth)
	{
		scr_platswap_init(self, false);
		marker.image_speed = 0.16666666666666666 / global.fps_scale;
		marker.sprite_index = spr_seth_drawing_tongue;
	}
	var _papers = findsprite(spr_dw_fcastle_dangerous_platforming_papers, ""NPCs"", undefined, undefined);
	marker_paper = scr_marker_fromasset(_papers, npc_seth.marker.depth + 100);
	marker_paper.image_speed = 0;
	with (marker_paper)
	{
		scr_platswap_init(self, false);
	}
	var _aqua = findsprite(spr_enemy_aqua_idle_r, ""NPCs"", undefined, undefined);
	npc_aqua = scr_makenpc_fromasset(_aqua, undefined);
	with (npc_aqua)
	{
		marker.sprite_index = spr_enemy_aqua_idle_r_green;
		scr_platswap_init(self, false);
		markerstick = false;
		marker.image_speed = 0.25 / global.fps_scale;
		scr_sizeexact(32, 32);
		x += 20;
		y += 30;
	}
	var _book = findsprite(spr_dw_fcastle_dangerous_platforming_sethbook, ""NPCs"", undefined, undefined);
	npc_book = scr_makenpc_fromasset(_book, undefined);
	with (npc_book)
	{
		image_speed = 0;
		scr_platswap_init(self, false);
		shine = instance_create(x + 14, y - 4, obj_marker_fancy);
		with (shine)
		{
			sprite_index = spr_shine_white;
			image_speed = 0;
			alpha = 1;
			owner = other.id;
			image_alpha = 1;
			scr_size(2, 2);
			scr_depth();
			depth -= 200;
			col = 13471693;
			image_blend = col;
			siner = 0;
			
			step_func = function()
			{
				with (owner)
				{
					if (instance_exists(marker))
					{
						other.depth = marker.depth - 1;
					}
				}
				siner += (1 / global.fps_scale);
				image_index += (0.16666666666666666 / global.fps_scale);
				var targ = 1 - sign(instance_exists(obj_cutscene_master) + d_ex());
				image_alpha = lerp(image_alpha, ((sin(siner / 15) * 0.25) + 0.8) * targ, scr_fps_lerp_rate(0.2));
				image_blend = merge_color(c_white, col, (sin(siner / 15) * 0.25) + 0.25);
				visible = 1 - array_get(scr_platswap_yscale(), 0);
			};
		}
	}
};

npcscene2 = function()
{
	var _papers = findsprite(spr_dw_fcastle_dangerous_platforming_papers, ""NPCs"", undefined, undefined);
	npc_papers = scr_makenpc_fromasset(_papers, true);
