			{
				global.battlemsg[0] = """";
			}
			if (rr == 1)
			{
				global.battlemsg[0] = """";
			}
			if (rr == 2)
			{
				global.battlemsg[0] = """";
			}
			if (rr == 3)
			{
				global.battlemsg[0] = """";
			}
		}
		else
		{
			global.turntimer = 120;
		}
	}
	if (global.mnfight == 2)
	{
		if (global.turntimer <= 1)
		{
			if (battlecancel == 1)
			{
				global.mercymod[myself] = 999;
			}
			if (battlecancel == 2)
			{
				with (obj_battlecontroller)
				{
					noreturn = 1;
				}
				con = 1;
				battlecancel = 3;
			}
		}
	}
}
if (con == 1)
{
	con = 2;
	alarm[4] = round(10 * global.fps_scale);
}
if (con == 3)
{
	global.typer = 50;
	global.msg[0] = """";
	scr_enemyblcon(x - 160, y, 3);
	con = 4;
}
if (con == 4 && !instance_exists(obj_writer))
{
	hspeed = 15 / global.fps_scale;
	con = 5;
	alarm[4] = round(15 * global.fps_scale);
	with (obj_battlecontroller)
	{
		alarm[2] = round(17 * global.fps_scale);
	}
}
if (con == 6)
{
	with (obj_battlecontroller)
	{
		noreturn = 0;
	}
	scr_monsterdefeat();
	instance_destroy();
	con = 7;
}
if (global.myfight == 3)
{
	xx = __view_get(e__VW.XView, 0);
	yy = __view_get(e__VW.YView, 0);
	if (acting == 1 && actcon == 0)
	{
		actcon = 1;
		global.msg[0] = """";
		scr_battletext_default();
	}
	if (acting == 2 && actcon == 0)
	{
		actcon = 1;
		if (global.automiss[myself] == 0)
		{
			global.msg[0] = """";
			global.monstercomment[myself] = """";
			global.automiss[myself] = 1;
		}
		scr_battletext_default();
	}
	if (acting == 3 && actcon == 0)
	{
		global.msg[0] = """";
		global.mercymod[myself] += 200;
		scr_battletext_default();
		actcon = 1;
	}
	if (acting == 4 && actcon == 0)
	{
		global.msg[0] = """";
		battlecancel = 1;
		scr_battletext_default();
		actcon = 1;
	}
	if (acting == 5 && actcon == 0)
	{
		global.msg[0] = """";
		battlecancel = 2;
		scr_battletext_default();
		actcon = 1;
	}
	if (acting == 6 && actcon == 0)
	{
		global.msg[0] = """";
		global.monstercomment[myself] = """";
		global.monsterstatus[myself] = 1;
		scr_battletext_default();
		actcon = 1;
	}
	if (actcon == 1 && !instance_exists(obj_writer))
	{
		actcon = 0;
		scr_attackphase();
	}
}
if (global.myfight == 7)
{
	hspeed = 15 / global.fps_scale;
}

enum e__VW
{
	XView,
	YView,
	WView,
	HView,
	Angle,
	HBorder,
	VBorder,
	HSpeed,
	VSpeed,
	Object,
	Visible,
	XPort,
	YPort,
	WPort,
	HPort,
	Camera,
	SurfaceID
}
");

Apply("gml_Object_obj_plat_antisoftlock_zone_Step_0", @"if (!i_ex(obj_plat_player))
{
	exit;
}
if (global.pause_plat)
{
	exit;
}
if (softlock_detected && !place_meeting(x, y, obj_plat_player) && !scr_trigcheck_ext(""antisoftlock_stay_active"", 912))
{
	on_exit_softlock_zone();
	softlock_detected = false;
	exit;
}
if (!obj_plat_player.grounded)
{
	exit;
}
if (obj_plat_player.groundedprev)
{
	exit;
}
if (softlock_detected)
{
	exit;
}
