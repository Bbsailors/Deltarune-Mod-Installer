		}
	}
	draw_set_color(c_white);
	if (mpos < (page * maxnum))
	{
		mpos = ((page * maxnum) + mencount) - 1;
		update = true;
	}
	if (mpos > (((page * maxnum) + mencount) - 1))
	{
		mpos = page * maxnum;
		update = true;
	}
	var gray = 8087653;
	var thismpos = mpos - (page * maxnum);
	if (thismpos >= mencount)
	{
		thismpos = 0;
	}
	if (menu == 1)
	{
		var off = 0;
		if (global.lang == ""ja"")
		{
			off = -8;
