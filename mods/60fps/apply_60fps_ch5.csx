Apply("gml_Object_obj_town_mid_ferris_wheel_Create_0", @"_init = false;
_base_sprite = -4;
_spokes_sprite = -4;
_middle_sprite = -4;
_car_sprites = [];
_bg = instance_create(0, 0, obj_town_mid_bg);
with (_bg)
{
	depth = 1000000;
}
car_orbit = 95;
car_angle = -51;
car_special = -4;
car_sway = false;
car_sway_timer = 0;
rotate_speed = 0;
wheel_base_angle = 0;
timer = 0;
min_shake_angle = 20;

create_car = function()
{
	var car_sprite = scr_marker(0, 0, spr_festival_ferris_car);
	return car_sprite;
};

init = function()
{
	_base_sprite = scr_marker(x + 30, y - 120, spr_festival_ferris_base);
	_base_sprite.depth = depth;
	_spokes_sprite = scr_marker(160, -14, spr_festival_ferris_spokes);
	_spokes_sprite.depth = _base_sprite.depth - 10;
	for (var i = 0; i < 5; i++)
	{
		var car_sprite = create_car();
		car_sprite.depth = _spokes_sprite.depth - 10;
		_car_sprites[array_length(_car_sprites)] = car_sprite;
		if (i == 4)
		{
			car_special = car_sprite;
		}
	}
	_middle_sprite = scr_marker(_spokes_sprite.x, _spokes_sprite.y, spr_festival_ferris_middle);
	_middle_sprite.depth = _spokes_sprite.depth - 2;
	_init = true;
};

start = function()
{
	rotate_speed = 0.1 / global.fps_scale;
};

stop = function()
{
	rotate_speed = 0;
};

reset = function()
{
	stop();
	car_angle = -51;
	wheel_base_angle = 0;
};

shake = function()
{
	car_sway = true;
	car_sway_timer = 0;
	min_shake_angle = 20;
};

shake_stop = function()
{
	scr_lerpvar(""min_shake_angle"", min_shake_angle, 0, 30);
	scr_delay_var(""car_sway"", false, 31);
};
");

Apply("gml_Object_obj_town_mid_ferris_wheel_Step_0", @"if (!_init)
{
	exit;
}
wheel_base_angle -= rotate_speed;
_spokes_sprite.image_angle = wheel_base_angle;
car_angle -= rotate_speed;
var orbit = 70;
var angle = car_angle;
var center_x = _spokes_sprite.x;
var center_y = _spokes_sprite.y;
for (var i = 0; i < array_length(_car_sprites); i++)
{
	var car_sprite = _car_sprites[i];
	angle = car_angle - (73 * (i + 1));
	var car_x = lengthdir_x(orbit, angle) + center_x;
	var car_y = lengthdir_y(orbit, angle) + center_y;
	car_sprite.x = car_x;
	car_sprite.y = car_y;
}
if (car_sway)
{
	timer++;
	car_sway_timer += (0.4 / global.fps_scale);
	var target_angle = clamp(33 - car_sway_timer, min_shake_angle, 33);
	car_special.image_angle = target_angle * sin(car_sway_timer / 1.5);
}
");

