Apply("gml_Object_obj_orange_puppet_Other_21", @"draw_puppet = function(arg0)
{
	if (puppet_alpha <= 0 && omega_alpha <= 0)
	{
		exit;
	}
	if (!surface_exists(prerender_surface))
	{
		prerender_surface = surface_create(200, 200);
	}
	if (!surface_exists(puppet_surface))
	{
		puppet_surface = surface_create(puppet.w, puppet.h);
	}
	surface_set_target(puppet_surface);
	gpu_set_colorwriteenable(true, true, true, true);
	gpu_set_alphatestenable(true);
	draw_clear_alpha(c_white, 0);
	for (var i = 0; i < 4; i++)
	{
		with (parts[i])
		{
			if (visible)
			{
				if (scr_debug() && keyboard_check(vk_backspace))
				{
					var col = [255, 16711680, 65535, 16711935];
					draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, col[i], 0.9);
					draw_sprite_ext(spr_pxwhite, 0, x, y, 1, 1, 0, c_white, 1);
				}
				else
				{
					draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, c_black, 1);
				}
			}
		}
	}
	surface_reset_target();
	if (going_omega)
	{
		omega_alpha = scr_approach(omega_alpha, 1, 0.1);
		puppet_alpha = scr_approach(puppet_alpha, 0, 0.1);
	}
	else
	{
		omega_alpha = scr_approach(omega_alpha, 0, 0.1);
		puppet_alpha = scr_approach(puppet_alpha, 1, 0.1);
	}
	shakex = -shakex;
	shakey = -shakey;
	if (puppet_alpha > 0)
	{
		if (arg0)
		{
			gpu_set_colorwriteenable(true, true, true, true);
			gpu_set_alphatestenable(false);
		}
		var xx = 100;
		var yy = 150;
		surface_set_target(prerender_surface);
		draw_clear_alpha(c_white, 0);
		gpu_set_tex_filter(1);
		draw_surface_ext(puppet_surface, puppet.x + shakex, puppet.y + shakey, puppet.image_xscale, puppet.image_yscale, puppet.angle, c_white, 1);
		gpu_set_tex_filter(0);
		surface_reset_target();
		if (arg0)
		{
			gpu_set_colorwriteenable(true, true, true, false);
			gpu_set_alphatestenable(true);
		}
		draw_surface_ext(prerender_surface, drawx - (xx * 2), drawy - (yy * 2), 2, 2, 0, c_black, image_alpha * puppet_alpha);
	}
	if (abs(shakex) != 0)
	{
		shakex = (abs(shakex) - (shakexreduct / global.fps_scale)) * sign(shakex);
		if (abs(shakex) < (shakexreduct / global.fps_scale))
		{
			shakex = 0;
		}
	}
	if (abs(shakey) != 0)
	{
		shakey = (abs(shakey) - (shakeyreduct / global.fps_scale)) * sign(shakey);
		if (abs(shakey) < (shakeyreduct / global.fps_scale))
		{
			shakey = 0;
		}
	}
	if (omega_alpha > 0)
	{
		animation_timer += (1 / global.fps_scale);
		if (arg0)
		{
			gpu_set_colorwriteenable(true, true, true, true);
			gpu_set_alphatestenable(false);
		}
		if (surface_get_height(prerender_surface) < 300)
		{
			surface_free(prerender_surface);
			prerender_surface = surface_create(200, 300);
		}
		var xx = 100;
		var yy = 150;
		surface_set_target(prerender_surface);
		draw_clear_alpha(c_white, 0);
		var sign_xscale = sign(image_xscale);
		var sign_yscale = sign(image_yscale);
		var ix = floor(image_index);
		var xs = image_xscale;
		var ys = image_yscale;
		var base_angle = animation_timer * omega_speed;
		var amplitude = 20 + (20 * sin((animation_timer / 20) * omega_speed));
		for (var i = 0; i < 6; i++)
		{
			var angle = base_angle + (60 * i);
			var xxx = lengthdir_x(amplitude, angle);
			var yyy = lengthdir_y(amplitude, angle);
			draw_sprite_ext(spr_orange_omega_glove, 0, xx + xxx, yy + yyy, xs, ys, 180 + angle, c_white, 1);
		}
		surface_reset_target();
		if (arg0)
		{
			gpu_set_colorwriteenable(true, true, true, false);
			gpu_set_alphatestenable(true);
		}
		draw_surface_ext(prerender_surface, drawx - (xx * 2), drawy - (yy * 2), 2, 2, 0, c_black, image_alpha * omega_alpha);
	}
};
");

Apply("gml_Object_obj_orange_puppet_Step_0", @"resetpuppetvals = function()
{
	movecon = 0;
	animinit = 0;
	animcon = 0;
	shakex = 0;
	shakey = 0;
	shakexreduct = 1;
	shakeyreduct = 1;
	puppetmovement = 0;
	animinit = 0;
	preset = -1;
	with (puppet)
	{
		x = 0;
		y = 0;
		targx = 0;
		targy = 0;
		xlerp = 0.25;
		ylerp = 0.25;
		w = 240;
		h = 240;
		image_xscale = 1;
		image_yscale = 1;
		surfxscale = 1;
		surfyscale = 1;
		targxscale = 1;
		xscalelerp = 0.25;
		targyscale = 1;
		yscalelerp = 0.25;
		angle = 0;
		targangle = 0;
		anglelerp = 0.25;
	}
};

if (!sinerfreeze)
{
	siner += (1 / global.fps_scale);
}
if (puppetmovement == 1)
{
	puppet.x = 4 + (sin(siner) * 6);
	puppet.y = lerp(puppet.y, puppet.targy, scr_fps_lerp_rate(0.25));
}
if (puppetmovement == 2)
{
	with (puppet)
	{
		x = lerp(x, targx, scr_fps_lerp_rate(xlerp));
		y = lerp(y, targy, scr_fps_lerp_rate(ylerp));
		image_xscale = lerp(image_xscale, targxscale, scr_fps_lerp_rate(xscalelerp));
		image_yscale = lerp(image_yscale, targyscale, scr_fps_lerp_rate(yscalelerp));
		angle = lerp(angle, targangle, scr_fps_lerp_rate(anglelerp));
	}
}
if (puppetmovement == 3)
{
	with (puppet)
	{
		x = lerp(x, targx + (sin(other.siner / 5) * 4), scr_fps_lerp_rate(xlerp));
		y = lerp(y, targy, scr_fps_lerp_rate(ylerp));
		image_xscale = lerp(image_xscale, targxscale, scr_fps_lerp_rate(xscalelerp));
		image_yscale = lerp(image_yscale, targyscale, scr_fps_lerp_rate(yscalelerp));
		angle = lerp(angle, targangle, scr_fps_lerp_rate(anglelerp));
	}
}
if (puppetmovement == 4)
{
	with (puppet)
	{
		x = lerp(x, targx, scr_fps_lerp_rate(xlerp));
		y = lerp(y, targy, scr_fps_lerp_rate(ylerp));
		image_xscale = lerp(image_xscale, targxscale, scr_fps_lerp_rate(xscalelerp));
		image_yscale = lerp(image_yscale, targyscale, scr_fps_lerp_rate(yscalelerp));
		angle = lerp(angle, targangle, scr_fps_lerp_rate(anglelerp));
	}
	if ((siner % 8) == 0)
	{
		shakex = 4;
		shakexreduct = 1;
	}
	if (((siner + 4) % 6) == 0)
	{
		shakey = 1;
		shakexreduct = 1;
	}
}
if (puppetmovement == 5)
{
	with (puppet)
	{
		x = lerp(x, targx, scr_fps_lerp_rate(xlerp));
		y = lerp(y, targy - (sin(other.siner / 2) * 5), scr_fps_lerp_rate(ylerp));
		image_xscale = lerp(image_xscale, targxscale + (sin(other.siner / 2) * 0.2), scr_fps_lerp_rate(xscalelerp));
		image_yscale = lerp(image_yscale, targyscale + (sin(other.siner / 2) * 0.14), scr_fps_lerp_rate(yscalelerp));
		angle = lerp(angle, targangle, scr_fps_lerp_rate(anglelerp));
	}
}
if (puppetmovement == 40)
{
	move40_timer += (1 / global.fps_scale);
	if (move40_timer == 1)
	{
		puppet.targx = puppet.x;
		puppet.targy = puppet.y;
	}
	puppet.x = lerp_in_cubic(puppet.targx, puppet.targx + 120, clamp01(move40_timer / 90));
	puppet.y = lerp_in_cubic(puppet.targy, puppet.targy - 10, clamp01(move40_timer / 90));
}
if (preset == 0)
{
	if (animinit == 0)
	{
		timer = 0;
		siner = 0;
		animcon = 0;
		head.sprite_index = spr_sp_head_neutral;
		head.visible = true;
		head.image_angle = 0;
		neck.sprite_index = spr_sp_neck;
		neck.visible = true;
		neck.image_angle = 0;
		eye.visible = false;
		mouth.visible = false;
		neck.x = 150;
		neck.y = 130;
		neck.image_angle = 0;
		head.x = neck.x + lengthdir_x(16, neck.image_angle);
		head.y = neck.y + lengthdir_y(0, neck.image_angle);
		animinit = 1;
	}
}
if (preset == 1)
{
	if (animinit == 0)
	{
		timer = 0;
		siner = 0;
		animcon = 0;
		head.sprite_index = spr_sp_head_fierce;
		head.visible = true;
		head.image_angle = 0;
		neck.sprite_index = spr_sp_neck;
		neck.visible = true;
		neck.image_angle = 0;
		mouth.visible = true;
		mouth.sprite_index = spr_sp_jaw_fierce;
		mouth.image_angle = 0;
		eye.visible = false;
		neck.x = 150;
		neck.y = 130;
		neck.image_angle = 0;
		head.image_angle = 0;
		head.x = neck.x + 16;
		head.y = neck.y + 4;
		animinit = 1;
	}
	mouth.x = (neck.x - 4) + (sin(siner * 1.8) * 2);
	mouth.y = neck.y + 40 + (sin(siner * 1.4) * -2);
}
if (preset == 2)
{
	if (!animinit)
	{
		timer = 0;
		siner = 0;
		animcon = 0;
		animinit = 1;
	}
	head.sprite_index = spr_sp_head_stiflelaugh;
	head.image_speed = 0.25;
	head.visible = true;
	head.image_angle = 0;
	neck.sprite_index = spr_sp_neck;
	neck.visible = true;
	neck.image_angle = -15;
	neck.x = 150;
	neck.y = 130;
	mouth.visible = false;
	head.x = neck.x + 16 + (sin(siner) * 2);
	head.y = neck.y + 0 + (cos(siner) * 2);
	eye.visible = true;
	eye.sprite_index = spr_sp_eye_stifle;
	eye.image_angle = 0;
	eye.x = (head.x - 62) + (sin(siner / 3) * 2);
	eye.y = (head.y - 8) + cos(siner / 2);
}
if (preset == 3)
{
	if (animinit == 0)
	{
		timer = 0;
		siner = 0;
		animcon = 0;
		neck.sprite_index = spr_sp_neck;
		neck.visible = true;
		neck.image_angle = 0;
		neck.image_angle = 0;
		mouth.y = neck.y - 8;
		mouth.image_angle = -8;
	}
	neck.image_angle = -8;
	neck.x = 150;
	neck.y = 130;
	head.sprite_index = spr_sp_head_biglaugh;
	head.visible = true;
	head.image_angle = 0;
	mouth.visible = true;
	mouth.sprite_index = spr_sp_jaw_biglaugh;
	mouth.image_angle = lerp(mouth.image_angle, -8, 1/3);
	mouth.x = neck.x;
	var _my = neck.y + 20 + abs(sin(siner / 6) * 10);
	var _lr = 1/3;
	if (laughfast)
	{
		_my = (neck.y - 8) + 20 + abs(sin(siner / 3) * 30);
		_lr = 0.9;
	}
	mouth.y = lerp(mouth.y, _my, _lr);
	eye.visible = true;
	eye.sprite_index = spr_sp_eye_stifle;
