	npc_animate_target = _mizzle_marker;
	if (times_talked == 0)
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* You can really..^1. throw things?/"", ""obj_npc_castle_town_mizzle_slash_Step_0_gml_230_0"");
		msgnextloc(""* Where I hail from^1, most people don't even have arms^1. Haha./%"", ""obj_npc_castle_town_mizzle_slash_Step_0_gml_231_0"");
	}
	else
	{
		scr_speaker(""no_name"");
		msgsetloc(0, ""* I've heard people can even throw parties^1. But how^1? Isn't that 3 heroes?/%"", ""obj_npc_castle_town_mizzle_slash_Step_0_gml_235_0"");
	}
	var d = d_make();
	d.side = 0;
}
if (con == 90 && !d_ex() && global.interact == 0)
{
