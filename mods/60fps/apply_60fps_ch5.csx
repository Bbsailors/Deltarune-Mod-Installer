Apply("gml_Object_obj_waterfallanim_Step_0", @"var _cx = camerax();
var _cy = cameray();
var _left = max(0, (_cx - tile_size) div tile_size);
var _top = max(0, (_cy - tile_size) div tile_size);
var _right = min(tmwidth, (_cx + 700) div tile_size);
var _bottom = min(tmheight, (_cy + 520) div tile_size);
var mult = 1;
anim += ((anim_speed * mult) / global.fps_scale);
if (anim >= anim_length)
{
	anim -= anim_length;
}
for (var xx = _left; xx < _right; xx++)
{
	for (var yy = _top; yy < _bottom; yy++)
	{
		var _data = tilemap_get(tilemap, xx, yy);
		if (_data > 0)
		{
			var initial_row = _data div tile_row_length;
			var true_row = (initial_row - 5) % 5;
			var row_index = _data % tile_row_length;
			tilemap_set(tilemap, (true_row * tile_row_length) + 40 + (40 * floor(anim)) + row_index, xx, yy);
		}
	}
}
");

