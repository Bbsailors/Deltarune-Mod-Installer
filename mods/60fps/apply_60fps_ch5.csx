Apply("gml_Object_obj_dw_garden_aquadarkness_Step_0", @"if (!init)
{
	init = 1;
}
if (sndinit == false)
{
	var trig = false;
	with (obj_mainchara)
	{
		if (sliding == 1)
		{
			trig = true;
		}
	}
	if (trig)
	{
		with (instance_create(x, y, obj_object_persistent))
		{
			timer = 0;
			timer2 = 0;
			
			step_func = function()
			{
				timer2 += (1 / global.fps_scale);
				if (timer2 == 1)
				{
					loopsnd = snd_loop(snd_paper_surf);
				}
				if (timer2 == 15)
				{
					snd_volume(loopsnd, 0, 30);
				}
				if (room == room_dw_garden_aquahole)
				{
					timer += (1 / global.fps_scale);
					if (timer == 1)
					{
						snd_stop(loopsnd);
						loopsnd = snd_loop(snd_paper_surf);
						snd_volume(loopsnd, 0, 0);
						snd_volume(loopsnd, 1, 30);
					}
					if (timer > 60)
					{
						var trig = false;
						with (obj_mainchara)
						{
							if (!sliding)
							{
								trig = true;
							}
						}
						if (trig)
						{
							snd_stop(loopsnd);
							scr_debug_print(""done"");
							instance_destroy();
						}
					}
				}
			};
		}
		sndinit = true;
	}
}
if (con < 0)
{
	exit;
}
if (con == 0 && scr_trigcheck(""cut1""))
{
	con = 3;
}
if (con == 3)
{
	timer += (1 / global.fps_scale);
	if (timer == 30)
	{
		scr_fadeout(30);
	}
}
");

Apply("gml_Object_obj_dw_garden_aquaplatforming_Step_0", @"if (ask_about_jumping && !global.pause_plat && button2_p())
{
	with (obj_plat_player)
	{
		if (grounded)
		{
