		c_spritenext(3541, 3);
		c_msgnextloc(""\\E8* The more darkness gets released^1, the closer.../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1493_0"");
		c_msgnextloc(""\\ER* ..^1. the closer the Roaring becomes^1. And^1, if it happens.../"", ""obj_ch5_DWC_Onsen_slash_Step_0_gml_1494_0"");
