		c_msgnextsubloc(""~1* No Fountain^1, no cowboys^1. And that~2ain't Asgore's IDEAL WORLD./"", (global.lang == ""ja"") ? ""\\m4\t\t\t"" : ""\\m4\t\t"", (global.lang == ""ja"") ? ""&\t\t\t\t"" : ""&\t\t"", ""obj_ch5_DWCL01_slash_Step_0_gml_213_0"");
