Apply("gml_Object_obj_plat_targethelper_Draw_0", @"if (is_culled)
{
	exit;
}
if (!instance_exists(obj_plat_player))
{
	exit;
}
_character_active = scr_plat_can_act(char) && (!obj_plat_player.targetmode || is_valid_target);
if (active && blocked != 1)
{
	var draw_offset_x = 0;
	var draw_offset_y = 0;
	var idx = -1;
	var total = 0;
	for (var i = 0; i < array_length(owner.__plat_acts); i++)
	{
		if (owner.__plat_acts[i].objectname == objectname)
		{
			idx = i;
		}
		if (owner.__plat_acts[i].active)
		{
			total++;
		}
	}
	if (total > 1)
	{
		draw_offset_x = lengthdir_x(20, (idx / total) * 360);
		draw_offset_y = lengthdir_y(20, (idx / total) * 360);
	}
	cx = bbox_left + (0.5 * (bbox_right - bbox_left)) + draw_offset_x;
	cy = bbox_top + (0.5 * (bbox_bottom - bbox_top)) + draw_offset_y;
	if (newx != -1)
	{
		cx = newx + draw_offset_x;
	}
	if (newy != -1)
	{
		cy = newy + draw_offset_y;
	}
	var accent_color = 16776960;
	if (char == ""su"")
	{
		accent_color = 16711935;
	}
	else if (char == ""ra"" || char == ""dog"")
	{
		accent_color = 65280;
	}
	else if (char == ""kr"")
	{
		accent_color = 8421504;
	}
	else if (char == ""none"")
	{
		accent_color = 8421504;
		if (owner.sprite_index == spr_plat_targetmode_reticle_red)
		{
			exit;
		}
	}
	if (!obj_plat_player.targetmode)
	{
		if (owner.image_alpha <= 0)
		{
			exit;
		}
		if (global.interact != 0)
		{
			exit;
		}
		if (global.pause_plat)
		{
			exit;
		}
		if (!_character_active)
		{
			exit;
		}
		if (protected)
		{
			exit;
		}
		if (blocked == 2)
		{
			exit;
		}
		timer += (1 / global.fps_scale);
		if ((timer % 60) == ((index * 15) % 60) && char != ""none"")
		{
			var _oldx = x;
			var _oldy = y;
			x = cx;
			y = cy;
			x = _oldx;
			y = _oldy;
			bwoosh = scr_make_ripple(cx, cy, 100, accent_color, 32, 4, 12, 5000, undefined, undefined, undefined, 0, undefined, 1, 2, 1);
		}
		if (is_struct(bwoosh))
		{
			bwoosh.x = cx;
			bwoosh.y = cy;
		}
		exit;
	}
	if (hovered)
	{
		var xx = obj_plat_player.x;
		var yy = obj_plat_player.y;
		if (char == ""su"")
		{
			with (obj_plat_follower)
			{
				if (name == ""susie"")
				{
					xx = x;
					yy = y;
					break;
				}
			}
		}
		if (char == ""ra"")
		{
			with (obj_plat_follower)
			{
				if (name == ""ralsei"")
				{
					xx = x;
					yy = y;
					break;
				}
			}
		}
		var dist = point_distance(xx, yy, cx, cy);
		var dir = point_direction(xx, yy, cx, cy);
		var wavefreq = current_time * -0.005;
		var dist_off = (current_time * 0.01) % 20;
		for (var i = 20; i < (dist - 20); i += 20)
		{
			var _idist = i + dist_off;
			var _x = lengthdir_x(_idist, dir);
			var _y = lengthdir_y(_idist, dir);
			var _alpha = 1;
			if (_idist < 40)
			{
				_alpha = inverselerp(20, 40, _idist);
			}
			else if (_idist > (dist - 40))
			{
				_alpha = inverselerp(dist - 20, dist - 40, _idist);
			}
			var size = 1;
			var _alpha2 = clamp01(_alpha - (dist_off / 20)) / 3;
			_idist += (dist_off * 0.75);
			var _x2 = lengthdir_x(_idist, dir);
			var _y2 = lengthdir_y(_idist, dir);
			size = 1;
			draw_sprite_ext(spr_plat_targetmode_arrow, 0, xx + _x2, yy + _y2, size, size, dir, accent_color, _alpha2);
			draw_sprite_ext(spr_plat_targetmode_arrow, 0, xx + _x, yy + _y, size, size, dir, accent_color, _alpha);
		}
		if (!last_hovered)
		{
			if (_character_active)
			{
				flash = 0;
			}
			if (blocked == 2 || !_character_active)
			{
				snd_play(snd_plat_act_move_fail);
			}
			else
			{
				snd_play(snd_plat_act_move);
			}
		}
		hoverlerp += (0.25 / global.fps_scale);
	}
	else
	{
		flash = -1;
		hoverlerp -= (0.25 / global.fps_scale);
	}
	if (flash >= 0)
	{
		flash += (1 / global.fps_scale);
		var ff = floor(flash / 2);
		if ((ff % 2) == 1 && ff < 3)
		{
			accent_color = merge_color(accent_color, c_white, 0.7);
		}
	}
	hoverlerp = clamp(hoverlerp, 0, 1);
	angle += ((6 - (hoverlerp * 6)) / global.fps_scale);
	var aa = lerp(angle, (((floor(angle / 90) % 4) * 90) + 45) - (45 * _character_active), hoverlerp);
	if (blocked)
	{
		if (blocked == 2)
		{
			var cross_color = make_color_hsv((((current_time * 0.005) / 14) * 255) % 255, 255, 255);
			draw_sprite_ext(spr_plat_targetmode_cross, 0, cx, cy, 2, 2, 0, cross_color, 1);
		}
		else
		{
			draw_sprite_ext(spr_plat_targetmode_circle, 0, cx, cy, 2, 2, 0, accent_color, 1);
		}
	}
	else
	{
		if (protected)
		{
			accent_color = 65535;
		}
		if (!protected && _character_active)
		{
			draw_sprite_ext(spr_plat_targetmode_reticle, hoverlerp * 7, cx, cy, 1, 1, aa, accent_color, 1);
		}
		else
		{
		}
		if (_character_active)
		{
			draw_sprite_ext(spr_plat_targetmode_circle, 0, cx, cy, 2, 2, 0, accent_color, 1);
		}
		else if (is_valid_target)
		{
			draw_sprite_ext(spr_plat_targetmode_cross, 0, cx, cy, 2, 2, 0, accent_color, 1);
		}
	}
	last_hovered = hovered;
}
");

