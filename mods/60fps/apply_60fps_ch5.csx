	c_wait_box(7);
	c_wait_talk();
	c_tenna_preset(0);
	c_var_instance(te_actor, ""reversal"", 0);
	c_mus(""free_all"");
	c_wait(60);
	c_sel(te);
	c_tenna_sprite(spr_tenna_sad_turned_a);
	c_speaker(""no_name"");
	c_msgsetloc(0, ""* .../"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_718_0"");
	c_facenext(""tenna"", 0);
	c_msgnextloc(""* ..^1. I know^1. I know what this is about./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_720_0"");
	c_msgnextloc(""* You told me^1. You TOLD me you had a bad feeling about that contract./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_721_0"");
	c_msgnextloc(""* That he wasn't supposed to sign it^1. That he COULDN'T./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_722_0"");
	c_msgnextloc(""* ..^1. and if he did^1, something terrible would happen./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_723_0"");
	c_msgnextloc(""* And even though I knew that..^1. I still made him do it anyway./"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_724_0"");
	c_msgnextloc(""* But how could it be MY fault!?/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_725_0"");
	c_msgnextloc(""* I needed to be BIG..^1. I needed it just as much as anyone else!/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_726_0"");
	c_msgnextloc(""* How is it MY fault HE ran out on ME!?/"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_727_0"");
	c_msgnextloc(""* I could have helped him^1! I WOULD have^1! We could've been big TOGETHER!/%"", ""obj_room_castle_tv_mike_b_slash_Step_0_gml_728_0"");
	c_talk();
