	y: sprite_get_yoffset(spr)
};
var off = shake;
if (shake != 0)
{
	if ((floor(shake) % 2) == 0)
	{
		off = -shake;
	}
	shake -= (1 / global.fps_scale);
}
if (draw_state == ""appearing"")
{
	draw_sprite_ext(spr_shinobeetle_pose, 0, x, y, 2, 2, 0, c_white, 1);
}
if (draw_state == ""sinking"")
{
	draw_sprite_part_ext(spr, animindex / 2, 0, -round(fakey / 2) * 2, wid, hei / 2, (x - (anc.x * 2)) + off + 4, (y - (anc.y * 2)) + 16, 2, 2, c_white, 1);
}
