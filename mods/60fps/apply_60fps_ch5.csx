		controller.valuecut = valuecut;
		controller.hypercut = hypercut;
		if (global.flag[1401] == 1)
		{
			controller.type = 1;
		}
		if (global.flag[1401] == 2)
		{
			controller.type = 2;
		}
		if (global.flag[1401] > 2)
		{
			controller.type = choose(0, 1, 2);
		}
		if (saloncut)
		{
			controller.acttimermax = 460;
		}
		if (valuecut)
		{
			controller.acttimermax = 390;
		}
		if (hypercut)
		{
			controller.acttimermax = 260;
		}
		if (controller.type == 1 && (valuecut || hypercut))
		{
			controller.acttimermax += 40;
		}
		global.flag[1401]++;
		acting = 201;
	}
	if (acting == 201 && actcon == 0 && !i_ex(obj_scissors_act_controller))
