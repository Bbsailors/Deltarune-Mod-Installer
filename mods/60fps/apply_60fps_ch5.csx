			scr_lerpvar(""x"", x, camerax() + 515, 20).respect_plat_pause = false;
			scr_lerpvar(""y"", y, cameray() + 76, 20).respect_plat_pause = false;
			scr_doom(self, 25).respects_platmode = false;
		}
		with (npc_aqua)
		{
			scr_lerpvar(""x"", x, x + 140, 20).respect_plat_pause = false;
			scr_doom(self, 25).respects_platmode = false;
		}
		shicon = 2;
	}
}
if (shicon == 2)
{
	if (encounterstate == 0 && i_ex(obj_battlecontroller))
	{
		encounterstate = 1;
	}
	else if (encounterstate == 1 && i_ex(obj_battlecontroller) && obj_battlecontroller.bp <= 0)
	{
		encounterstate = 2;
		global.plot = max(global.plot, 465);
		var target = 1200;
		with (target)
		{
			cutscene = 1;
		}
		var close = -4;
		var closedist = 9999999999;
		with (obj_plat_movemarker)
		{
			var dist = point_distance(x, y, target.x, target.y);
			if (dist < closedist)
			{
				close = self;
				closedist = dist;
			}
		}
		var diffx = [target.x];
		var diffy = [target.y];
		with (target)
		{
			x = close.x;
			y = close.y - (0.5 * target.sprite_height);
			cutscene = 0;
			dashing = 0;
			entity_gravity = 1.25 / (global.fps_scale * global.fps_scale);
			if (!global.pause_plat)
			{
				gravity = 1.25 / (global.fps_scale * global.fps_scale);
			}
		}
		camlerp = 10;
		diffx[0] = target.x - diffx[0];
		diffy[0] = target.y - diffy[0];
		with (obj_caterpillarchara)
		{
			var lastx = x;
			var lasty = y;
			x = target.x;
			y = (target.y + (0.5 * target.sprite_height)) - (0.5 * sprite_height);
			array_push(diffx, 0);
			array_push(diffy, 0);
		}
		camerax_set(target.x - 320);
		cameray_set(880);
	}
	if (camlerp >= 0 && instance_exists(obj_plat_player))
	{
		camlerp -= (1 / global.fps_scale);
		cameray_set(880);
		with (obj_plat_camera)
		{
			var _k = 0.1 * (10 - other.camlerp);
			var _r = (_k >= 1) ? _k : (1 - power(1 - _k, 1 / global.fps_scale));
			x = lerp(x, obj_plat_player.x, _r);
		}
		if (camlerp == 0)
		{
			shicon = 3;
			with (obj_plat_player)
			{
				entity_gravity = 1.25 / (global.fps_scale * global.fps_scale);
				if (!global.pause_plat)
				{
					gravity = 1.25 / (global.fps_scale * global.fps_scale);
				}
			}
		}
	}
}
var manager = id;
with (npc_starwalker)
{
	if (array_get(scr_platswap_yscale(), 0) < 0.5)
	{
		marker.visible = true;
		if (myinteract == 3)
		{
			global.interact = 1;
			myinteract = 999;
			talked++;
			scr_speaker(""no_name"");
			msgsetloc(0, ""* It was a long journey but now it is time/%"", ""obj_dw_fcastle_ultradash_slash_Step_0_gml_344_0"");
			if (talked > 1)
			{
				msgsetloc(0, ""* The final\n                     \\cYStarwalker\\cW/%"", ""obj_dw_fcastle_ultradash_slash_Step_0_gml_348_0"");
			}
			else
			{
				myinteract = 4;
			}
			d_make();
		}
		else if (myinteract == 4 && !d_ex())
		{
			timer += (1 / global.fps_scale);
			if (timer == 1)
			{
				with (marker)
				{
					scr_oflash().flashspeed = 0.125;
				}
				var snd = snd_play(snd_boost, 1, 0.2);
				snd_pitch_time(snd, 0.8, 30);
			}
			if (timer == 40)
			{
				snd_stop(snd_chargeshot_charge);
				with (marker)
				{
					scr_flag_set_ext(manager.PROGRESS_FLAG, manager._SEEN_STARWALKER_BIT, 1);
					sprite_index = spr_npc_originalstarwalker_final;
					snd_play(snd_sparkle_glock);
				}
			}
			if (timer == 90)
			{
				myinteract = 3;
			}
		}
		if (myinteract == 999 && !d_ex())
		{
			myinteract = 0;
			global.interact = 0;
		}
	}
	else
	{
		marker.visible = false;
	}
}
if (has_floradinn && instance_exists(obj_platswap_prop))
{
	has_floradinn = false;
	with (obj_floradinn_overworld)
	{
		scr_lerpvar(""image_alpha"", 1, 0, 5);
		scr_doom(self, 5);
	}
}
with (obj_plat_player)
{
	if (fallen_in_pit)
	{
		with (obj_plat_bulletred)
		{
			instance_destroy();
		}
	}
}
");

