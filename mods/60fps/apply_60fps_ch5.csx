					}
					sprite_index = choose(spr_dw_cliffs_tallgrass_lightbake, spr_dw_cliffs_tallgrass_lightbake2);
				}
				with (instance_create(gs[i].x + (j * 40), gs[i].y + (k * 40) + 20, obj_dw_cliffs_tallgrass))
				{
					image_xscale = choose(-2, 2);
					if (image_xscale == -2)
					{
						x += 40;
					}
					image_yscale = 2;
					sprite_index = choose(spr_dw_cliffs_tallgrass_lightbake, spr_dw_cliffs_tallgrass_lightbake2);
				}
			}
		}
	}
}
num_grass_cut = 0;
should_check_wheat = false;

check_all_wheat_gone = function()
{
	if (num_grass_cut < 0)
	{
		exit;
	}
	if (global.flag[1872] == 1)
	{
		exit;
	}
	var boundL = 1320;
	var cut_all_grass = true;
	with (obj_dw_cliffs_tallgrass)
	{
		if (x > boundL && !was_cut)
		{
			cut_all_grass = false;
		}
	}
	if (cut_all_grass)
	{
		var grass = chosen_grass;
		num_grass_cut++;
		if (grass != -4)
		{
			grass.was_cut = false;
			grass.sprite_index = spr_dw_cliffs_tallgrass_lightbake;
			grass.image_index = 0;
			grass.chosen = num_grass_cut >= 5;
			if (num_grass_cut == 5)
			{
				num_grass_cut = -1;
			}
		}
	}
};

unlock_dogballoon = function(arg0, arg1)
{
	arg0 += 20;
	arg1 += 20;
	num_grass_cut = -1;
	var balloonmarker = instance_create(arg0, arg1, obj_marker_fancy);
	with (balloonmarker)
	{
		sprite_index = spr_plat_coinballoon_blue;
		vspeed = -6 / global.fps_scale;
		hspeed = 0;
		con = 0;
		timer = 0;
		scr_depth(self);
		scr_darksize();
		image_speed = 0.1 / global.fps_scale;
		
		step_func = function()
		{
			if (con == 0)
			{
				vspeed = scr_approach(vspeed, 0, 0.1 / global.fps_scale);
				if (vspeed == 0)
				{
					con = 1;
					ystart = y;
				}
			}
			else
			{
				timer += (1 / global.fps_scale);
				y = ystart + (sin(timer * 0.05) * 4);
			}
			hspeed = scr_approach(hspeed, 0, 0.25 / global.fps_scale);
			var target = 1200;
			if (!instance_exists(target))
			{
				target = 1662;
			}
			if (instance_exists(target))
			{
				if (x > (target.x - 180))
				{
					hspeed = max(-10 / global.fps_scale, hspeed - (0.5 / (global.fps_scale * global.fps_scale)));
				}
			}
		};
	}
	with (obj_doorAny)
	{
		if (doorRoom == room_dw_cliff_shop)
		{
			doorRoom = room_dw_dogballoon;
			doorEntrance = 2;
		}
	}
};
");

