				sound_play(snd_damage);
				scr_script_delayed(function()
				{
					sound_play(snd_damage, 0.5);
				}, 10);
				scr_script_delayed(function()
				{
					sound_play(snd_damage, 0.25);
				}, 20);
				scr_script_delayed(function()
				{
					sound_play(snd_damage, 0.1);
				}, 30);
				scr_doom(id, 31);
			}
			with (obj_yellow_trial_manager.perp_yellow)
			{
				scr_shakeobj();
			}
			with (scr_fadein(60))
			{
				depth = -1000;
				image_blend = c_white;
				fadespeed = 0;
			}
			talked = -1;
			scr_var_delay(""talked"", 1, 15);
			with (obj_heroparent)
			{
				state = 0;
			}
			with (obj_marker)
			{
				if (sprite_index == spr_trial_podium)
				{
					instance_destroy();
				}
			}
			with (obj_trial_perp)
			{
				instance_destroy();
			}
			with (obj_yellow_trial_manager)
			{
				instance_destroy();
			}
			snd_free(global.batmusic[0]);
			snd_free(global.batmusic[1]);
			snd_free(global.batmusic[2]);
			with (obj_heroparent)
			{
				state = 0;
			}
			with (obj_battlecontroller)
			{
				skipvictory = 2;
			}
			scr_wincombat();
		});
		blue_balloon();
	}
};

