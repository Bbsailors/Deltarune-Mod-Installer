draw_surface_mask = function()
{
	var surf = obj_dw_fcastle_foyer.draw_surface_mask;
	if (!surface_exists(surf))
	{
		obj_dw_fcastle_foyer.draw_surface_mask = surface_create(240, 140);
		surf = obj_dw_fcastle_foyer.draw_surface_mask;
		catch_up_surface_mask(surf);
	}
	surface_set_target(surf);
	var lena = array_length(x_history);
	var lenb = array_length(y_history);
	var xx = floor(x / 2);
	var yy = floor(y / 2);
	if ((lena == 0 && lenb == 0) || (xx != x_history[lena - 1] || yy != y_history[lenb - 1]))
	{
		array_push(x_history, xx);
		array_push(y_history, yy);
	}
	var pos = obj_dw_fcastle_foyer.surface_position_marker;
	draw_sprite_ext(spr_pxwhite, 0, xx - 10 - (pos.x / 2), yy - (0.5 * draw_height) - (pos.y / 2), 20, draw_height, 0, c_white, 1);
	surface_reset_target();
};

spawn_leafs = function(arg0, arg1, arg2)
{
	for (i = 0; i < arg2; i += 1)
	{
		var marker = instance_create(arg0 + random_range(-8, 8), arg1 + random_range(-8, 8), obj_marker);
		with (marker)
		{
			sprite_index = other.leafsprites[floor(random_range(0, array_length(other.leafsprites) - 0.01))];
			vspeed = random_range(-12, 2) / global.fps_scale;
			hspeed = random_range(-6, 6) / global.fps_scale;
			scr_lerpvar(""vspeed"", vspeed, vspeed * 0.2, 30, 1, ""out"");
			image_speed = random_range(0.2, 0.35) / global.fps_scale;
			depth = 0;
			scr_doom(self, 45);
			scr_lerpvar(""image_alpha"", 1, 0, 45);
		}
	}
};

spawn_flower_destroy_effect = function(arg0, arg1, arg2)
{
	var count = 8;
	var ang = random(33);
	for (var i = 0; i < count; i++)
	{
		with (scr_marker_ext(arg0, arg1, spr_dw_garden_cuttableflowerpetals))
		{
			image_blend = arg2;
			var life = 14;
			speed = 8 / global.fps_scale;
			direction = ((i / count) * 360) + ang;
			friction = 1 / (global.fps_scale * global.fps_scale);
			scr_doom(id, life);
			image_speed = 0;
			scr_size(2, 2);
			image_index = random(4);
			vspeed *= 0.95;
			scr_lerpvar(""image_alpha"", 4, 0, life);
		}
	}
};

has_new_flowers = function()
{
	var ok = function(arg0)
	{
		if (arg0 == 1810)
		{
			return true;
		}
		if (arg0 == 1812 && global.flag[1812] && global.flag[672] == -1)
		{
			return -2;
		}
		if (arg0 == 1811 && global.flag[1811] && (global.flag[672] == -1 || global.flag[673] == -1 || global.flag[1906] == -1))
		{
			return -2;
		}
		if (arg0 == 1814 && global.flag[1814] && global.flag[675] == -1)
		{
			return -2;
		}
		if (arg0 == 1813 && global.flag[1813] && global.flag[677] == -1)
		{
			return -2;
		}
		if (arg0 == 1815 && global.flag[1815] && (global.flag[672] == -1 || global.flag[676] == -1))
		{
			return -2;
		}
		if (global.flag[arg0] == 1)
		{
			return 1;
		}
		else
		{
			return -1;
		}
	};
	
	var previousresult = [];
	for (var i = 0; i < 7; i++)
	{
		array_push(previousresult, scr_flag_get_ext(1856, i, 2));
	}
	var flowerlegend = [1811, 1812, 1813, 1810, 1814, 1815, 1816];
	var currentresult = [];
	for (var i = 0; i < array_length(flowerlegend); i++)
	{
		var check = ok(flowerlegend[i]);
		if (check == 1)
		{
			array_push(currentresult, 1);
		}
		else
		{
			array_push(currentresult, 0);
		}
	}
	for (var i = 0; i < array_length(currentresult); i++)
	{
		if (previousresult[i] != currentresult[i])
		{
			if (currentresult[i] == 1)
			{
				return true;
			}
		}
	}
};
");

