						gpu_set_blendmode_ext_sepalpha(bm_zero, bm_zero, bm_zero, bm_inv_src_alpha);
						draw_sprite_ext(spr_fusuma_door_lock, 0, _sx + (0.5 * sprite_width), 0.5 * sprite_height, image_xscale, image_yscale, 0, c_white, 1);
					}
				}
				gpu_set_blendmode(bm_normal);
			}
		}
	}
}
