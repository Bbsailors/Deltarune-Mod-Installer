Apply("gml_Object_obj_platswap_Step_0", @"transition_time = max(transition_time - (1 / global.fps_scale), -1);
sound_cooldown -= (1 / global.fps_scale);
if (transition_time == 0)
{
	if (mode == 0)
	{
		var _target = prop_player;
		if (!instance_exists(_target))
		{
			exit;
		}
		if (!instance_exists(obj_mainchara))
		{
			instance_create(_target.x - 17, _target.y - 38, obj_mainchara);
		}
		with (obj_plat_game)
		{
			paused = false;
		}
		var _fall = 0;
		with (obj_mainchara)
		{
			scr_depth();
		}
		if (_fall)
		{
		}
		else
		{
			camera_set_view_target(view_camera[0], 1677);
		}
		with (obj_platswap_prop)
		{
			if (name != """")
			{
				var cp = instance_create(x, y, obj_caterpillarchara);
				with (cp)
				{
					name = other.name;
					if (name == ""ralsei"")
					{
						target = round(24 * global.fps_scale);
						global.cinstance[1] = id;
					}
					else
					{
						global.cinstance[0] = id;
					}
					x -= 24;
					y -= 46;
					initialize();
					image_alpha = 1;
					image_blend = c_white;
					scr_caterpillar_interpolate();
				}
			}
		}
		with (obj_platswap_prop)
		{
			instance_destroy();
		}
	}
	else
	{
		var _target = prop_player;
		if (!instance_exists(_target))
		{
			_target = 1200;
		}
		var sc = sound_cooldown;
		if (sound_cooldown <= 0)
		{
			snd_play(snd_dtrans_flip, 1, 1.3);
		}
		if (instance_exists(_target))
		{
			instance_create(_target.x, _target.y, obj_plat_player);
			with (obj_plat_player)
			{
				var _ground = instance_place(x, y + 12, obj_plat_floor);
				if (instance_exists(_ground))
				{
					ground = _ground.id;
					grounded = true;
					scr_plat_snap_to_ground();
					groundedprev = true;
					land_anim = -1;
				}
			}
			with (obj_platswap_prop)
			{
				if (id != _target.id)
				{
					var follower = instance_create(x, y, obj_plat_follower);
					with (follower)
					{
						get_preset(1 + (other.name == ""ralsei""));
						if (sc > 0)
						{
							x -= (obj_plat_player.image_xscale * 50);
							y -= 50;
						}
						depth = other.depth;
						grounded = true;
						groundedprev = true;
						land_anim = -1;
						scr_plat_snap_to_ground();
						caterpillarmode = 0;
						init_caterpillarmode();
						image_xscale = obj_plat_player.image_xscale;
					}
					instance_destroy();
				}
			}
		}
		instance_destroy(_target);
		camera_set_view_target(view_camera[0], 222);
		obj_plat_camera.target = 912;
		camera_set_view_border(view_camera[0], 640, 480);
	}
}
");

Apply("gml_Object_obj_platswap_prop_Step_0", @"switch (sprite_index)
{
	case spr_kris_plat_slash_ground:
	case spr_kris_plat_slash_air:
		if (image_index == clamp(image_index, 4.5, 5) || image_index == clamp(image_index, 7.5, 8))
		{
			sprite_index = spr_kris_plat_idle;
			image_index = 0;
		}
		break;
}
if (depth_type == 0)
{
	scr_depth();
}
else if (depth_type == 1)
{
	scr_plat_depthcast();
	depth_type = -1;
}
switch (fallmode)
{
	case 1:
		var _fallcue = instance_place(x, y, obj_platswap_fallcue);
		if (vspeed < (20 / global.fps_scale))
		{
			vspeed += (1 / (global.fps_scale * global.fps_scale));
		}
		sprite_index = sprFall;
		mask_index = spr_krisd_dark;
		if (instance_exists(_fallcue))
		{
			if (_fallcue.depth_behind != -4)
			{
				depth = _fallcue.depth_behind + 100;
			}
		}
		if (!instance_place(x, y, obj_solidblock) && !_fallcue && y >= 0)
		{
			fallmode = 2;
			alarm[0] = round(10 * global.fps_scale);
			snd_play_pitch(snd_noise, 1.2);
			vspeed = 0;
			sprite_index = sprLand;
			image_speed = 0;
			image_index = 1;
		}
		break;
	case 2:
		vspeed = 0;
		break;
}
");

Apply("gml_Object_obj_platswap_statue_Collision_obj_plat_hbx", @"if (!visible)
{
	exit;
}
if (!can_hit)
{
	exit;
}
if (floating)
{
	exit;
}
if (can_hit && other.object_index != asset_get_index(""obj_plat_susieaxe_hbx""))
{
	with (obj_plat_game)
	{
		paused = false;
		hitstop = 0;
	}
	with (obj_plat_player)
	{
		act_buffer = true;
		act_button_held = false;
	}
	obj_platswap.transition_timemax = timer_max;
	hit = 1;
	with (object_index)
	{
		can_hit = 0;
		timer = timer_max;
		alarm[0] = round(30 * global.fps_scale);
	}
	with (obj_platswap)
	{
		event_user(0);
	}
	audio_stop_sound(snd_grab);
	snd_play_pitch(snd_grab, 1.25);
	scr_make_ripple(x, y, 8, 16777215, 50, 15, 20, depth - 1, undefined, undefined, undefined, 0, undefined, undefined, 2, false);
	with (other)
	{
		do_hbx_hit(-4);
	}
	instance_destroy(obj_petalwing);
}
");

Apply("gml_Object_obj_platswap_statue_Draw_0", @"var ys = array_get(scr_platswap_yscale(), 0);
if (ys > 0.5 && can_hit)
{
	shinealpha += (0.1 / global.fps_scale);
}
else
{
	shinealpha -= (0.1 / global.fps_scale);
}
var palidx = pal_index;
if (!can_hit)
{
	pal_index = 7;
}
shinealpha = clamp01(shinealpha);
var xscale = 1.35 + (0.15 * sin(shinetimer * 0.03));
var yscale = 1.35 + (0.15 * cos(shinetimer * 0.015));
draw_sprite_ext(spr_platswap_statue_light, 0, x, y, xscale, yscale, 0, c_lime, shinealpha * ys * (0.5 + (0.15 * sin(shinetimer * 0.02))));
pal_swap_set(pal_sprite, pal_index, 0);
draw_sprite_ext(spr_platswap_statue_top_new, image_index, x, y, image_xscale, 2, 0, image_blend, 1);
pal_swap_reset();
pal_index = palidx;
");

