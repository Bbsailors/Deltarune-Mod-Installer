orbit_oscillation_timer = 0;
orbit_correction_timer = 0;
windimmune = true;
nextletter = irandom_range(0, 25);

kill_bullets = function()
{
	var i = array_length(orbiting_bullets) - 1;
	while (i >= 0)
	{
		with (orbiting_bullets[i])
		{
			killed = true;
			timer = 0;
			damage = 0;
			scr_doom(self, (i * 4) + 1);
		}
		i--;
	}
	orbiting_bullets = [];
};

bullets_attack = function()
{
	var i = array_length(orbiting_bullets) - 1;
	while (i >= 0)
	{
		with (orbiting_bullets[i])
		{
			con = 2;
			timer = -10 * i;
		}
		i--;
	}
	orbiting_bullets = [];
};

get_hurt = function(arg0)
{
	if (paused || custom_paused)
	{
		exit;
	}
	with (arg0)
	{
		if (!hit_check(other.id))
		{
			exit;
		}
	}
	if (hit <= 0 && arg0.is_player_hbx)
	{
