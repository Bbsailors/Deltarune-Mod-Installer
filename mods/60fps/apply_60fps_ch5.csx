		s = scr_marker(310, 190, spr_susieu);
		global.interact = 1;
		with (s)
		{
			vspeed = -1 / global.fps_scale;
			image_speed = 0.2 / global.fps_scale;
		}
		with (k)
		{
			vspeed = -1 / global.fps_scale;
			image_speed = 0.2 / global.fps_scale;
		}
		alarm[4] = round(90 * global.fps_scale);
	}
	else
	{
		block = instance_create(280, 100, obj_solidblock);
		block.image_xscale = 4;
		sunset = scr_marker(0, 0, spr_doorarea_sunsetoverlay);
		with (sunset)
		{
			image_alpha = 0.4;
			depth = 2000;
