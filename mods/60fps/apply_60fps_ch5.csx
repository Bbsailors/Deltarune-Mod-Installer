		{
			sprite_index = spr_enemy_green_wave_right;
			
			var wl = function()
			{
				snd_play(snd_xylophone_blink, undefined, 1.375);
				image_index = 1;
			};
			
			var wr = function()
			{
				snd_play(snd_xylophone_blink, undefined, 1);
				image_index = 0;
			};
			
			wl();
			delay_function(wr, 8);
			delay_function(wl, 16);
			delay_function(wr, 24);
			with (other)
			{
				delay_function(endseq, 32);
			}
		}
	}
}
if (global.pause_plat)
{
	exit;
}
");

Apply("gml_Object_obj_dw_fcastle_heldmushrooms_Step_0", @"if (!init)
{
	for (var _history_init_i = 0; _history_init_i < round(8 * global.fps_scale); _history_init_i++)
	{
		player_movement_history[_history_init_i] = [obj_mainchara.x, obj_mainchara.y];
	}
	init = 1;
	with (obj_treasure_fox)
	{
		with (instance_create(x, y, obj_dw_garden_secretfox))
		{
			assign_target(other);
			canshowtail = false;
		}
	}
	if (global.flag[1868] == 1)
	{
		with (obj_held_mushroom)
		{
			if (!summon_the_sun)
			{
				instance_destroy();
			}
		}
	}
}
player_speedx_average = 0;
player_speedy_average = 0;
var _history_i = array_length(player_movement_history) - 1;
while (_history_i > 0)
{
	player_speedx_average += (player_movement_history[_history_i - 1][0] - player_movement_history[_history_i][0]);
	player_speedy_average += (player_movement_history[_history_i - 1][1] - player_movement_history[_history_i][1]);
	array_set(player_movement_history, _history_i, player_movement_history[_history_i - 1]);
	_history_i--;
}
player_speedx_average += (obj_mainchara.x - player_movement_history[0][0]);
player_speedy_average += (obj_mainchara.y - player_movement_history[0][1]);
array_set(player_movement_history, 0, [obj_mainchara.x, obj_mainchara.y]);
player_speedx_average /= array_length(player_movement_history);
player_speedy_average /= array_length(player_movement_history);
with (obj_dw_garden_physicsshroom)
{
	if (state == 1 && image_xscale >= 1 && place_meeting(x, y, obj_mainchara))
	{
		hspeed = other.player_speedx_average * 1.1;
		vspeed = other.player_speedy_average * 1.1;
		fakeyspeed = -2;
		fakeheight = 0;
		state = 0;
	}
}
var _dark = dark;
var _gl = green_layer;
var _gl_wall = green_layer_wall;
with (obj_dw_garden_secretfox)
{
	with (obj_parallax_cliffs)
	{
		if (other.fromsun_visible || other.con == 2)
		{
			if (_dark.image_alpha == 0)
			{
				layer_set_visible(_gl, false);
				layer_set_visible(_gl_wall, false);
				with (obj_sunshadows)
				{
					sunlight_alpha = 0;
					alpha_shadowblend = 0;
				}
				_dark.image_alpha = 0.3;
			}
		}
		else if (_dark.image_alpha > 0)
		{
			layer_set_visible(_gl, true);
			layer_set_visible(_gl_wall, true);
			with (obj_sunshadows)
			{
				sunlight_alpha = 1;
				alpha_shadowblend = 0.7;
			}
			_dark.image_alpha = 0;
		}
	}
}
");

