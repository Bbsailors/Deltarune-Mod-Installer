	}
	for (var i = 0; i < array_length(depth_layers); i++)
	{
		var _dl = depth_layers[i];
		layer_depth(_dl[0], (obj_mainchara.depth > _dl[1] && holding) ? _dl[1] : _dl[2]);
	}
	with (obj_castlereflect)
	{
		if (holding && specialdepth == 900010)
		{
			specialdepth = 87559;
			depth = specialdepth;
		}
		else if (!holding && specialdepth == 87559)
		{
			specialdepth = 900010;
			depth = specialdepth;
		}
	}
};

add_depth_layer = function(arg0, arg1, arg2)
{
	array_push(depth_layers, [layer_get_id(arg0), arg1, arg2]);
};

