	_averagetimeunit *= global.fps_scale;
	var _end_buffer = trackpos - (3.6 * _averagetimeunit);
	if (!arg2 && instrument == 0 && hardmode)
	{
		_end_buffer = trackpos - (2.4 * _averagetimeunit);
	}
	var notei = max(minnote - 8, 0);
	for (; notei < maxnote; notei++)
	{
