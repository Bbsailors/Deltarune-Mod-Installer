	if (wait < 0)
	{
		h_spd = scr_approach(h_spd, -maxspd, 0.125);
		_h += (h_spd / global.fps_scale);
	}
	if (move)
	{
		y = 100 + _ys + (sin(mytimer / 100) * 100);
		mytimer += (10 / global.fps_scale);
		if (place_meeting(x, y, obj_heart))
