		prevtrackpos = audio_sound_get_track_position(global.currentsong[1]);
		with (obj_plat_follower)
		{
			drop_off_platform_mode(true);
		}
	}
	if (con == 1)
	{
		snd_volume(global.currentsong[1], 0, 30);
		show_debug_message_concat(""cutscene started"");
		con = 1.5;
