	{
		con = 7;
	}
}
if (con == 3 || con == 0)
{
	if (obj_knifewall_generator.con == 3)
	{
		timer = 0;
		con = 4;
		obj_plat_camera.cutscene = 1;
		global.plot = 350;
	}
}
if (con == 4 && !global.pause_plat)
{
	if (timer < 100)
	{
		with (obj_plat_camera)
		{
			y -= ((0.03 * other.timer) / global.fps_scale);
		}
		with (obj_plat_player)
		{
			y -= (1 / global.fps_scale);
			vspeed = -1.35 / global.fps_scale;
			gravity = 0;
			jumping = 2;
			entity_gravity = 0;
			grounded = false;
		}
	}
	if (timer == 100)
	{
		obj_plat_camera.cutscene = 0;
		with (obj_plat_camera)
		{
			reset_all_lerps();
		}
		con = 5;
	}
}
if (con == 9)
{
	if (scr_wind_direction() == 90 && !global.pause_plat && global.interact == 0)
	{
		con = 10;
		global.interact = 1;
		obj_plat_player.hspeed = 0;
		timer = 0;
	}
}
if (global.pause_plat)
{
	exit;
}
if (con == 10)
{
	if (timer == 1)
	{
		with (obj_plat_player)
		{
			if (grounded)
			{
				shake = 4;
			}
		}
		with (obj_plat_follower)
		{
			if (grounded)
			{
				shake = 4;
			}
			caterpillarmode = false;
			state = -1;
			important = true;
		}
	}
	if (timer >= 11)
	{
		with (obj_doorAnyVert)
		{
			ystart = cameray() - 120;
		}
		with (obj_plat_player)
		{
			y -= (((other.timer - 11) * 0.5) / global.fps_scale);
			if (vspeed > 0)
			{
				vspeed *= power(0.5, 1 / global.fps_scale);
			}
			gravity = 0;
			entity_gravity = 0;
			jumping = true;
			wallcollision = 0;
			physics = 0;
			grounded = false;
		}
		with (obj_plat_follower)
		{
			if (grounded)
			{
				vspeed = -2 / global.fps_scale;
				grounded = false;
			}
			y -= (((other.timer - 11) * 0.2) / global.fps_scale);
			if (vspeed > 0)
			{
				vspeed *= power(0.5, 1 / global.fps_scale);
			}
			gravity = 0;
			entity_gravity = 0;
			jumping = true;
			wallcollision = 0;
			physics = 0;
			grounded = false;
		}
	}
}
");

