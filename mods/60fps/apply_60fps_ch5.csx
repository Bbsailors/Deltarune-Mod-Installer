	if (timer == 19)
	{
		with (smashmarker)
		{
			instance_destroy();
		}
		sprite_set(fe, 6030, 2, 0);
		snd_play(snd_horriblemetalclang);
		var range = 30;
		var count = 24;
		for (var i = 0; i < count; i++)
		{
			makecoin(lerp(90 + range, 90 - range, i / count) + random_range(-6, 6));
		}
		scr_shakescreen();
	}
	if (timer == 21)
	{
		sprite_set(fe, 6030, 3, 0);
	}
	if (timer == 23)
	{
		sprite_set(fe, 6030, 4, 0);
	}
	if (timer == 25)
	{
		sprite_set(fe, 6030, 5, 0);
	}
	if (timer == 55)
	{
		sprite_set(fe, 6374, 0, 0);
	}
	if (timer == 115)
	{
		timer = 0;
		coincon = 3;
	}
}
if (coincon == 3)
{
	moneysmashed = 1;
	updateSmashed();
	scr_speaker(""no_name"");
	msgsetloc(0, ""* .../"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_772_0"");
	msgnextloc(""* All right^1. Maybe it wasn't my best work.../"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_773_0"");
	msgnextloc(""* I blame my pollen allergies..^1. ACHOO!/%"", ""obj_dw_cliff_silver_hammer_slash_Step_0_gml_774_0"");
	d_make(0);
	coincon = 4;
	scr_msgno_func(1, function()
	{
		sprite_set(ferroll.marker, 81, 0, 0);
	});
	scr_msgno_func(2, function()
	{
		sprite_set(ferroll.marker, 543, 0, 0);
	});
}
if (coincon == 4 && !d_ex())
{
	scr_caterpillar_interpolate(""all"");
	global.facing = 0;
	con = 99;
	coincon = 0;
}
