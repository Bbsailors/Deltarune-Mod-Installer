Apply("gml_Object_obj_scarecrow_shine_Step_0", @"if (con == 0)
{
	timer += (1 / global.fps_scale);
	image_xscale = lerp(0, 2, timer / 30);
	image_yscale = lerp(0, 2, timer / 30);
	if (timer == 30)
	{
		timer = 0;
		con = 1;
	}
}
if (con == 1)
{
	timer += (1 / global.fps_scale);
	image_xscale = 2 + (sin(timer / 2) * 0.2);
	image_yscale = 2 + (sin(timer / 2) * 0.2);
	if (!snd_is_playing(snd_sneo_overpower))
	{
		jumpchargesfx = snd_loop(snd_sneo_overpower);
		snd_pitch(jumpchargesfx, 0.9);
		snd_volume(jumpchargesfx, 0.5, 60);
	}
}
if (con == 2)
{
	timer += (1 / global.fps_scale);
	image_xscale = lerp(image_xscale, 0, timer / 10);
	image_yscale = lerp(image_yscale, 0, timer / 10);
	if (timer == 10)
	{
		instance_destroy();
	}
}
");

