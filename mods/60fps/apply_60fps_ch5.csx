evidence_obtained[0] = scr_keyitemcheck(26);
evidence_obtained[1] = scr_keyitemcheck(21);
evidence_obtained[2] = scr_keyitemcheck(23);
evidence_obtained[3] = scr_keyitemcheck(27);
evidence_obtained[4] = scr_keyitemcheck(28);
evidence_obtained[5] = scr_keyitemcheck(22);
evidence_obtained[6] = scr_keyitemcheck(20);
var start_allgathered = true;
for (var a = 0; a < 7; a++)
{
	if (!evidence_obtained[a])
	{
		start_allgathered = false;
		break;
	}
}
if (start_allgathered)
{
	with (obj_blue_enemy)
	{
		global.actdesc[myself][0] = all_evidence_gathered;
		global.actcost[myself][0] = 2497.5;
	}
}
evidence_key[0] = ""perpbook"";
evidence_key[1] = ""yellowshred"";
evidence_key[2] = ""redsplatter"";
evidence_key[3] = ""bluestring"";
evidence_key[4] = ""trainplan"";
evidence_key[5] = ""bootoil"";
evidence_key[6] = ""scissors"";

gain_evidence = function()
{
	var templist = ds_list_create();
	var templist2 = ds_list_create();
	var templist3 = ds_list_create();
	var templist4 = ds_list_create();
	var addcount = 0;
	for (var a = 4; a < 7; a++)
	{
		if (!evidence_obtained[a])
		{
			ds_list_add(templist, a);
		}
	}
	ds_list_shuffle(templist);
	if (!evidence_obtained[0])
	{
		if (trial_counter == 0)
		{
			ds_list_add(templist3, 0);
		}
		else
		{
			ds_list_add(templist2, 0);
		}
	}
	if (!evidence_obtained[1])
	{
		if (trial_counter == 1)
		{
			ds_list_add(templist3, 1);
		}
		else
		{
			ds_list_add(templist2, 1);
		}
	}
	if (!evidence_obtained[2])
	{
		if (trial_counter == 2)
		{
			ds_list_add(templist3, 2);
		}
		else
		{
			ds_list_add(templist2, 2);
		}
	}
	if (!evidence_obtained[3])
	{
		if (trial_counter == 3)
		{
			ds_list_add(templist3, 3);
		}
		else
		{
			ds_list_add(templist2, 3);
		}
	}
	ds_list_shuffle(templist2);
	while ((ds_list_size(templist) + ds_list_size(templist2)) > 0)
	{
		if (ds_list_size(templist))
		{
			ds_list_add(templist3, ds_list_find_value(templist, 0));
			ds_list_delete(templist, 0);
		}
		if (ds_list_size(templist2))
		{
			ds_list_add(templist3, ds_list_find_value(templist2, 0));
			ds_list_delete(templist2, 0);
		}
	}
	for (var a = 0; a < 2; a++)
	{
		if (ds_list_size(templist3))
		{
			ds_list_add(templist4, ds_list_find_value(templist3, 0));
			ds_list_delete(templist3, 0);
		}
	}
	ds_list_shuffle(templist4);
	for (var a = 0; a < ds_list_size(templist4); a++)
	{
		array_set(evidence_obtained, ds_list_find_value(templist4, a), true);
		with (instance_create(((camerax() + (camerawidth() * 0.5)) - 50) + (100 * a), (cameray() - 20) + irandom(80), obj_bulletparent))
		{
			depth = -550;
			sprite_index = spr_yellow_evidence;
			image_index = ds_list_find_value(templist4, a) + 1;
			image_speed = 0;
			direction = 270;
			speed = 16 / global.fps_scale;
			image_xscale = 0;
			image_yscale = 8;
			scr_lerpvar(""speed"", 16 / global.fps_scale, 0.25 / global.fps_scale, 15);
			scr_lerpvar(""image_xscale"", 0, 2, 10);
			scr_lerpvar(""image_yscale"", 8, 2, 10);
			scr_script_delayed(function()
			{
				scr_lerpvar(""image_xscale"", 2, 8, 20);
				scr_lerpvar(""image_yscale"", 2, 0, 20);
				scr_lerpvar(""image_alpha"", 1, 0, 20);
				scr_doom(id, 20);
			}, 30);
			with (instance_create(x, y, obj_bulletparent))
			{
				depth = -549;
				sprite_index = spr_yellow_evidence_angled;
				image_index = 0;
				image_speed = 0;
				direction = 270;
				speed = 16 / global.fps_scale;
				image_xscale = 0;
				image_yscale = 8;
				scr_lerpvar(""speed"", 16 / global.fps_scale, 0.25 / global.fps_scale, 15);
				scr_lerpvar(""image_xscale"", 0, 2, 10);
				scr_lerpvar(""image_yscale"", 8, 2, 10);
				scr_script_delayed(function()
				{
					scr_lerpvar(""image_xscale"", 2, 8, 20);
					scr_lerpvar(""image_yscale"", 2, 0, 20);
					scr_lerpvar(""image_alpha"", 1, 0, 20);
					scr_doom(id, 20);
				}, 30);
			}
		}
	}
	var all_gained = true;
	for (var a = 0; a < 7; a++)
	{
		if (!evidence_obtained[a])
		{
			all_gained = false;
		}
	}
	if (all_gained)
	{
		with (obj_blue_enemy)
		{
			global.actdesc[myself][0] = all_evidence_gathered;
			global.actcost[myself][0] = 2497.5;
		}
	}
	ds_list_destroy(templist);
	ds_list_destroy(templist2);
	ds_list_destroy(templist3);
	ds_list_destroy(templist4);
	yellow_justice_check();
};

