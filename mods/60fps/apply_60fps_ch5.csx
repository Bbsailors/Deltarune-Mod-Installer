	var _countingdown = false;
	with (obj_glowtile_puzzle_new)
	{
		if (flag_on_completion == 1432 && puzzle_phase == (puzzle_win_phase - 1))
		{
			_countingdown = true;
		}
	}
	if (_countingdown)
	{
		timer -= (1 / global.fps_scale);
	}
	else
	{
		timer = 60;
	}
	if (timer <= 0)
	{
		with (obj_glowtile_puzzle_new)
