		with (_readable)
		{
			extflag = ""asgore_flowers"";
			image_xscale = _readable_scale.x;
			image_yscale = _readable_scale.y;
		}
	}
}

show_convo = function(arg0)
{
	switch (arg0)
	{
		case ""asgore_morning"":
			con = 20;
			if (scr_flag_get(1328) > 0)
			{
				con = 2;
			}
			break;
		case ""asgore_mewmew"":
			con = 5;
			break;
		case ""asgore_day"":
			con = 10;
			if (scr_flag_get(1327) == 1)
			{
				con = 11;
			}
			break;
		case ""asgore_crown"":
			con = 30;
			if (scr_sideb_active())
			{
				con = 40;
				if (scr_flag_get(1883) == 1)
				{
					con = 54;
				}
			}
			break;
		case ""asgore_flowers"":
			con = 50;
			if (scr_sideb_active())
			{
				con = 52;
				if (scr_flag_get(1807) == 1)
				{
					con = 54;
				}
			}
			break;
		case ""asgore_roses"":
			con = 60;
			break;
	}
};
");

