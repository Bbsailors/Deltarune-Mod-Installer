					{
						idlesprite = spr_enemy_aqua_laugh;
						sparedsprite = spr_enemy_aqua_laugh;
					});
					msgset_add(violence8, (camerax() + camerawidth()) - 20, y - 55, 10, 50, function()
					{
						talkmax = 150;
					});
					msgset_add(violence9, x - 20, y + 25, 10, 50, function()
					{
