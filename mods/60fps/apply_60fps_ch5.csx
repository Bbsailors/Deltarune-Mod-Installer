			timer = 0;
		}
		else if (scr_trigcheck_ext(""foxpanic_left"", id))
		{
			anchor_x -= 120;
			while (place_meeting(anchor_x, anchor_y, obj_solidblock))
			{
				anchor_x += random_range(-20, 0);
				anchor_y += random_range(-20, 20);
			}
			timer = 0;
		}
	}
	if (timer == 18)
	{
		pickup_cooldown = 20;
