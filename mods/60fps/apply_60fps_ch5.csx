Apply("gml_Object_obj_date_controller_Draw_0", @"draw_set_color(c_white);
draw_set_alpha(1);
if (i_ex(obj_battlecontroller))
{
	depth = obj_battlecontroller.depth + 1;
	if (i_ex(obj_tensionbar))
	{
		obj_tensionbar.depth = depth + 1;
	}
}
