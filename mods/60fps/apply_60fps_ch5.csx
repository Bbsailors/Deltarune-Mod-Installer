width = 8;
end_size = 0;
gradient = false;
rounded = false;
lifetime = 60;
child_lifetime = 20;
max_lifetime = lifetime;
xlast = ystart;
ylast = xstart;
demo = true;
siner = 0;
hingepos = new Vector2(0, 0);
depth = -9999;
trail_surf = -4;
init = false;
active = true;
created = false;
distance = 60;
fore_start = 0;
fore_end = 0;
draw_foreground = true;
foreground_obj = -4;
foreground = false;
rising = false;
rise_start = 0;
owner = -4;
height = 0;
downward = false;

DrawTrailSegment = function(arg0 = -1, arg1 = -1)
{
	var _arraysize = array_length(points);
	if (arg0 == -1)
	{
		arg0 = _arraysize - 1;
	}
	if (arg1 == -1)
	{
		arg1 = 0;
	}
	for (var i = arg0; i >= arg1; i--)
	{
		if (i == (_arraysize - 1))
		{
			with (points[i])
			{
				draw_vertex_color(x, y, other.end_color, clamp01(other.end_alpha + min(0, other.lifetime / 10)));
			}
		}
		else
		{
			var _prog = i / (_arraysize - 1);
			var _size = sin(_prog * pi) * (_arraysize / (child_lifetime * global.fps_scale)) * 4;
			var _col = merge_color(start_color, end_color, _prog);
			var _alpha = clamp01(lerp(start_alpha, end_alpha, _prog) + min(0, lifetime / 10));
			with (points[i])
			{
				draw_vertex_color(x - (sidex * _size), y - (sidey * _size), _col, _alpha);
				draw_vertex_color(x + (sidex * _size), y + (sidey * _size), _col, _alpha);
			}
		}
	}
};
");

Apply("gml_Object_obj_wind_trail_Step_0", @"if (!init)
{
	init = true;
	if (foreground_effect)
	{
		foreground_obj = instance_create(xstart, ystart, obj_wind_trail_foreground);
		foreground_obj.depth = depth - 200;
	}
}
depth = owner.depth;
if (i_ex(owner) && owner.ys[0] > 0.5)
{
	depth += 1295500;
}
distance = lerp(100, 30, 1 - scr_ease_in(lifetime / max_lifetime, 2));
if (global.pause_plat)
{
	exit;
}
var _psuedo_depth = 0;
if (lifetime > 0)
{
	x = xstart + lengthdir_x(distance, direction);
	_psuedo_depth = lengthdir_y(distance, direction);
	if (draw_foreground)
	{
		if (_psuedo_depth > ystart)
		{
			foreground = true;
		}
		else
		{
			foreground = false;
		}
	}
	y = ystart + (_psuedo_depth * 0.5);
	var _str = 0;
	if (i_ex(owner))
	{
		_str = owner.trail_strength;
	}
	if (_str > 0 && rising)
	{
		height = scr_ease_in(1 - ((lifetime - rise_start) / max_lifetime), 3) * 500 * _str;
		y -= height;
	}
	direction -= (10 / global.fps_scale);
}
var _length = array_length(points);
var i = _length - 1;
while (i >= 0)
{
	points[i].life -= 1 / child_lifetime / global.fps_scale;
	if (points[i].life < 0)
	{
		array_delete(points, i, 1);
	}
	i--;
}
if (lifetime > 0)
{
	if (!created)
	{
		xlast = x;
		ylast = y;
	}
	var _point = 
	{
		x: xlast,
		y: ylast,
		life: 1 - (1 / child_lifetime / global.fps_scale),
		depth: depth,
		height: height,
		foreground: false,
		direction: 0,
		sidex: 0,
		sidey: 0
	};
	if (foreground_effect && foreground)
	{
		_point.foreground = true;
	}
	if (!created)
	{
		_point.direction = point_direction(xlast, ylast, x, y);
		created = true;
	}
	else
	{
		_point.direction = scr_angle_lerp(point_direction(_point.x, _point.y, x, y), point_direction(lastpoint.x, lastpoint.y, _point.x, _point.y), 0.5);
	}
	_point.sidex = lengthdir_x(1, _point.direction + 90);
	_point.sidey = lengthdir_y(1, _point.direction + 90);
	lastpoint = _point;
	array_insert(points, 0, _point);
}
if (lifetime <= (0 - child_lifetime))
{
	instance_destroy();
}
lifetime -= (1 / global.fps_scale);
ylast = y;
xlast = x;
");

Apply("gml_Object_obj_windowglow_Step_0", @"siner += (sin_speed / global.fps_scale);
pal_index = 0.5 + (sin(obj_windowglow.siner) * 0.5);
");

Apply("gml_Object_obj_windybox_Draw_0", @"if (!i_ex(obj_growtangle))
{
	exit;
}
scr_draw_in_box_begin();
d_rectangle_color(obj_growtangle.x - 75, obj_growtangle.y - 75, obj_growtangle.x + 75, obj_growtangle.y + 75, 0, 0, 0, 0, false);
for (xnum = 0; xnum < 4; xnum++)
{
	for (ynum = 0; ynum < 4; ynum++)
	{
		var tempx = xspeed[xnum][ynum] * max(scaler, 0);
		var tempy = -xspeed[xnum][ynum] / 2;
		var dir = point_direction(0, 0, tempx, tempy);
		draw_sprite_ext(spr_leafling_petal, 0, xstar[xnum][ynum], ystar[xnum][ynum], 2, 1, dir, c_dkgray, 1);
		xstar[xnum][ynum] += (tempx / global.fps_scale);
		ystar[xnum][ynum] += (tempy / global.fps_scale);
		if (ystar[xnum][ynum] > (y + 200))
		{
			xstar[xnum][ynum] = x + (xnum * 50) + 25 + random(25);
			ystar[xnum][ynum] -= 200;
			xspeed[xnum][ynum] = -5 - random(3.5);
		}
		if (xstar[xnum][ynum] < x)
		{
			ystar[xnum][ynum] = y + (ynum * 50) + 25 + random(25);
			xstar[xnum][ynum] += 200;
			xspeed[xnum][ynum] = -5 - random(3.5);
		}
	}
}
scr_draw_in_box_end();
");

Apply("gml_Object_obj_windybox_Step_0", @"scaler = scr_approach_curve(scaler, 1, 50, 0.01);
with (obj_heart)
{
	if (!place_meeting(x - 1, y, obj_battlesolid))
	{
		x -= ((1 * max(0, other.scaler)) / global.fps_scale);
	}
}
if (global.turntimer < 1)
{
	snd_stop(wind_sound);
	snd_free(wind_sound);
	instance_destroy();
}
");

Apply("gml_Object_obj_writer_Alarm_0", @"var playsound = 0;
if (rate > 2)
{
	alarm[1] = round(1 * global.fps_scale);
}
else
{
	sound_timer -= 1;
	if (first_alarm == 1 && pos >= 2 && sound_timer <= 0)
	{
		playsound = 1;
	}
}
if (pos <= length)
{
	alarm[0] = round(rate * global.fps_scale);
}
else
{
	reachedend = 1;
}
if (first_alarm == 0)
{
	getchar = string_char_at(mystring, 1);
	if (getchar == ""\\"")
	{
		pos += 3;
	}
	else
	{
		pos += 1;
	}
	first_alarm = 1;
}
else
{
	getchar = string_char_at(mystring, pos);
	nextchar = string_char_at(mystring, pos + 1);
	if (getchar == ""`"")
	{
		pos += 2;
		exit;
	}
	if (getchar == ""&"" || getchar == ""\n"")
	{
		pos += 1;
	}
	if (getchar == ""\\"")
	{
		pos += 3;
	}
	if (getchar == ""/"")
	{
		halt = 1;
		if (nextchar == ""%"")
		{
			halt = 2;
		}
		alarm[0] = -1;
	}
	getchar = string_char_at(mystring, pos);
	nextchar = string_char_at(mystring, pos + 1);
	if (getchar == ""|"")
	{
		pos += 2;
	}
	if (getchar == ""^"")
	{
		pos += 2;
		if (alarm[0] > 0)
		{
			if (nextchar == ""1"")
			{
				alarm[0] += round(5 * global.fps_scale);
			}
			if (nextchar == ""2"")
			{
				alarm[0] += round(10 * global.fps_scale);
			}
			if (nextchar == ""3"")
			{
				alarm[0] += round(15 * global.fps_scale);
			}
			if (nextchar == ""4"")
			{
				alarm[0] += round(20 * global.fps_scale);
			}
			if (nextchar == ""5"")
			{
				alarm[0] += round(30 * global.fps_scale);
			}
			if (nextchar == ""6"")
			{
				alarm[0] += round(40 * global.fps_scale);
			}
			if (nextchar == ""7"")
			{
				alarm[0] += round(60 * global.fps_scale);
			}
			if (nextchar == ""8"")
			{
				alarm[0] += round(90 * global.fps_scale);
			}
			if (nextchar == ""9"")
			{
				alarm[0] += round(150 * global.fps_scale);
			}
		}
	}
	pos += 1;
}
if (reachedend_sound_play)
{
	if (reachedend && !reachedend_sound_played)
	{
		playsound = 0;
	}
}
if (playsound)
{
	scr_textsound();
}
");

