		image_speed = 0;
		image_index = 0;
		fade = 0;
		blend = c_black;
		blendspd = 0;
		
		step_func = function()
		{
			if (fade)
			{
				blend += blendspd;
				if (blend >= #010000)
				{
					blend = #010000;
					fade = false;
					x = room_width * 4;
				}
				image_blend = merge_color(c_white, c_black, blend);
			}
		};
	}
	con = 21;
}
