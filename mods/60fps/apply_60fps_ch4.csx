            }
            draw_text_shadow_width(BOX_X1 + 25, BOX_Y1 + 22, NOWPLACE, 180);
        }
    }
}
if (MENU_NO >= 0)
{
    if (MENU_NO == 0 || MENU_NO == 2 || MENU_NO == 3 || MENU_NO == 5 || MENU_NO == 10)
