Apply("gml_Object_obj_screen_channel_change_Other_12", @"if (is_finished)
{
    exit;
}
if (scroll && !surface_exists(old_screen_surf))
{
    old_screen_surf = surface_create(camerawidth(), cameraheight());
}
if (!active || timer <= 0 || strength == 0)
{
    if (scroll)
    {
        surface_set_target(old_screen_surf);
        draw_surface(application_surface, 0, 0);
        surface_reset_target();
    }
    exit;
}
if (!surface_exists(screen_surf))
{
    screen_surf = surface_create(camerawidth(), cameraheight());
}
var _ease = scr_ease_in(timer / lifetime, 2);
var _strength = strength * _ease;
var _noisec = 0;
var _num = -1;
var _scany = 0;
if (scroll)
{
    var _yy = scroll ? scr_wrap_ondy(scr_ease_out(1 - (timer / lifetime), 4) * 480, 0, 480) : i;
    surface_set_target(screen_surf);
    draw_surface_part(old_screen_surf, 0, _yy, camerawidth(), cameraheight() - _yy, 0, 0);
    draw_surface_part(application_surface, 0, 0, camerawidth(), _yy, 0, 480 - _yy);
    surface_reset_target();
}
else
{
    surface_set_target(screen_surf);
    draw_surface(application_surface, 0, 0);
    surface_reset_target();
}
if (scroll)
{
    _strength /= 3;
}
var perlin_texture_page = sprite_get_texture(noise_sprite, 0);
shader_set(channel_shader);
texture_set_stage(perlin_stage, perlin_texture_page);
shader_set_uniform_f(shader_get_uniform(channel_shader, ""texel""), 1 / camerawidth(), 1 / cameraheight());
shader_set_uniform_f(shader_get_uniform(channel_shader, ""strength""), _strength);
var _UVs = sprite_get_uvs(noise_sprite, 0);
var _tex = sprite_get_texture(noise_sprite, 0);
var _texel_x = texture_get_texel_width(_tex);
var _texel_y = texture_get_texel_height(_tex);
var _texel_hx = _texel_x * 0.5;
var _texel_hy = _texel_y * 0.5;
shader_set_uniform_f(shader_get_uniform(channel_shader, ""u_pixelSize""), _texel_x, _texel_y);
shader_set_uniform_f(shader_get_uniform(channel_shader, ""u_UVs""), _UVs[0] + _texel_hx, _UVs[1] + _texel_hy);
shader_set_uniform_f(shader_get_uniform(channel_shader, ""scanx""), floor(scan_x) + 0.5);
draw_surface(screen_surf, camerax(), cameray());
shader_reset();
scan_x = scr_wrap_ondy(scan_x + (scroll_speed * scroll_dir * (timer / lifetime) * 2), 0, 479);
if (!infinite && timer > 0)
{
    timer -= (1 / global.fps_scale);
    if (timer <= 0)
    {
        if (!silent)
        {
            snd_stop(static_noise);
        }
        multa = random_range(10, 40);
        multb = random_range(5, 10);
    }
}
siner += (1 / global.fps_scale);
var _alpha = 0;
if (i_ex(obj_tenna_enemy))
{
    if (lightemupcon == 1)
    {
        lightemuptimer += (1 / global.fps_scale);
        if (lightemuptimer == 3)
        {
            snd_play(snd_tv_static);
        }
        if (lightemuptimer < 3)
        {
            _alpha2 = lerp(0, 1, lightemuptimer / 3);
        }
        if (lightemuptimer >= 3 && lightemuptimer < 60)
        {
            _alpha2 = 1;
        }
        if (lightemuptimer >= 60)
        {
            _alpha2 = lerp(1, 0, (lightemuptimer - 60) / 10);
        }
        if (lightemuptimer == 65)
        {
            snd_stop(snd_tv_static);
        }
        if (lightemuptimer == 70)
        {
            lightemupcon = 0;
            minigametext = instance_create_depth(x, y - 150, depth + 10, obj_tenna_enemy_minigametext);
            minigametext.mystring = """";
            minigametext.lightemup = 1;
            lifetime = 7;
        }
        draw_sprite_tiled_ext(spr_static_effect, timer, camerax(), cameray(), 2, 2, c_white, _alpha2);
    }
    else
    {
        _alpha = _ease / 3;
        if (i_ex(obj_actor_tenna) && obj_actor_tenna.changechanneltimermax < 25)
        {
            _alpha = lerp(0, _ease / 3, strength / 200);
        }
    }
}
else
{
    _alpha = _ease / 2;
}
if (infinite)
{
    draw_sprite_tiled_ext(spr_static_effect, scan_x, 0, 0, 2, 2, c_white, _alpha);
}
else
{
    draw_sprite_tiled_ext(spr_static_effect, timer / 2, 0, 0, 2, 2, c_white, _alpha);
}
");

Apply("gml_Object_obj_screen_channel_change_tester_Draw_0", @"if (scr_debug())
{
    if (keyboard_check_pressed(ord(""B"")) || gamepad_button_check_pressed(0, gp_face3))
    {
        background++;
        if (background >= 4)
        {
            background = 0;
        }
        with (obj_actor_tenna)
        {
            preset = irandom(37);
            if (preset >= 35)
            {
                preset++;
            }
        }
    }
}
if (background == 1)
{
    draw_sprite(spr_rhythmgame_bg, 4, 0, 0);
}
if (background == 2)
{
    draw_sprite_ext(bg_torhouse_bg, 0, -690, 0, 2, 2, 0, c_white, 1);
}
if (background == 3)
{
    draw_sprite_ext(spr_dw_susiezilla_bg_empty, 0, 0, 0, 2, 2, 0, c_white, 1);
}
with (obj_screen_channel_change)
{
    if (keyboard_check_pressed(ord(""I"")))
    {
        if (keyboard_check(vk_shift))
        {
            lifetime += (1 / global.fps_scale);
            debug_print(""lifetime: "" + string(lifetime));
        }
        else
        {
            strength += 10;
            debug_print(""stremgth: "" + string(strength));
        }
    }
    else if (keyboard_check_pressed(ord(""U"")))
    {
        if (keyboard_check(vk_shift))
        {
            if (lifetime > 1)
            {
                lifetime -= (1 / global.fps_scale);
            }
            debug_print(""lifetime: "" + string(lifetime));
        }
        else if (strength > 0)
        {
            strength -= 10;
            debug_print(""stremgth: "" + string(strength));
        }
    }
    if (shader_check == 1)
    {
    }
    if (keyboard_check_pressed(ord(""F"")) || gamepad_button_check_pressed(0, gp_shoulderl) || gamepad_button_check_pressed(1, gp_shoulderl))
    {
        draw_end = !draw_end;
        if (draw_end)
        {
            debug_print(""1: effect handled in Draw End event"");
        }
        else
        {
            debug_print(""0: effect handled in Draw event"");
        }
    }
    if (keyboard_check_pressed(ord(""B"")) || gamepad_button_check_pressed(0, gp_face3) || gamepad_button_check_pressed(1, gp_face3))
    {
        event_user(1);
    }
    if (keyboard_check_pressed(ord(""I"")))
    {
        infinite = !infinite;
        if (infinite)
        {
            timer = lifetime;
        }
        debug_print(""infinite: "" + string(infinite));
    }
    if (keyboard_check_pressed(ord(""V"")) || gamepad_button_check_pressed(0, gp_face4) || gamepad_button_check_pressed(1, gp_face4))
    {
        scroll = !scroll;
        debug_print(""scroll: "" + string(scroll));
    }
}
");

Apply("gml_Object_obj_screen_loading_Create_0", @"_target_chapter = -1;
_init = false;
_callback = -4;
_initialize_text = """";
_y_offset = -16;
_font = 7;

show_loading_screen = function(arg0, arg1)
{
    _target_chapter = arg0;
    _callback = arg1;
    _initialize_text = get_text(_target_chapter);
    _font = get_font();
    _init = true;
    var delay = 1;
    if (instance_exists(obj_event_manager))
    {
        if (obj_event_manager.has_pending_trophies())
        {
            delay = 30;
            obj_event_manager.resolve_trophies();
        }
    }
    alarm[0] = round(delay * global.fps_scale);
};

get_text = function(arg0)
{
    var _text = ""INITIALIZING\nCHAPTER "" + string(arg0);
    if (global.lang == ""ja"")
    {
        _text = ""CHAPTER "" + string(arg0) + ""ã‚’\nã¯ã˜ã‚ã¾ã™"";
    }
    if (arg0 == 0)
    {
        _text = ""LOADING\nCHAPTER\nSELECT"";
        if (global.lang == ""ja"")
        {
            _text = ""ãƒãƒ£ãƒ—ã‚¿ãƒ¼\né¸æŠžç”»é¢\nã‚ˆã¿ã“ã¿ä¸­"";
        }
    }
    return _text;
};

get_font = function()
{
    if (room == room_chapter_continue)
    {
        return (global.lang == ""en"") ? 7 : 13;
    }
    else
    {
        return (global.lang == ""en"") ? 8 : 16;
    }
};
");

Apply("gml_Object_obj_screen_wobbler_Draw_0", @"if (sunkus_kb_check_pressed(78))
{
    helix = !helix;
    if (helix)
    {
        scr_debug_print(""helix effect enabled"");
    }
    else
    {
        scr_debug_print(""helix effect disabled"");
    }
}
if (!active && strength <= 0)
{
    exit;
}
if (active && strength < 15)
{
    strength += (0.25 / global.fps_scale);
}
else if (!active && strength > 0)
{
    strength = scr_movetowards(strength, 0, 1.5 / global.fps_scale);
}
if (!surface_exists(screen_surf))
{
    screen_surf = surface_create(640, 480);
}
surface_set_target(screen_surf);
draw_clear_alpha(c_black, 1);
siner += (1 / global.fps_scale);
for (i = 0; i < 480; i += 2)
{
    var _sine = sin((siner + (i / 2)) / 30) * strength;
    if (helix && (i % 4) == 2)
    {
        _sine *= -1;
    }
    surface_copy_part(screen_surf, _sine, i, application_surface, 0, i, 640, 2);
}
surface_reset_target();
draw_surface(screen_surf, camerax(), cameray());
");

