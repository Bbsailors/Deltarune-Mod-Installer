    if (radius == 30)
    {
        snd_play(snd_jump);
    }
    radius = lerp(radius, 35, scr_fps_lerp_rate(0.2));
    origin_offset = lerp(origin_offset, 5, scr_fps_lerp_rate(0.2));
    sprite_set_offset(spr_spearblocker, 32 - origin_offset, 32);
    if (radius > 34)
    {
        radius = 35;
        sprite_set_offset(spr_spearblocker, 27, 32);
        diagonal_transform = 0;
    }
}
if (up_h())
{
    idealdir = 90;
}
if (right_h())
{
    idealdir = 0;
}
if (left_h())
{
    idealdir = 180;
}
if (down_h())
{
    idealdir = 270;
}
if (up_h() && right_h())
{
    idealdir = 35;
}
if (left_h() && up_h())
{
    idealdir = 135;
}
if (down_h() && left_h())
{
