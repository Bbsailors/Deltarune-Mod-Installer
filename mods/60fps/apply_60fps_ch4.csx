        c_msgnextloc(""\\E9* I mean^1, obviously he would^1, right?/"", ""obj_dw_churchb_gersonstudy_slash_Step_0_gml_216_0"");
        c_msgnextloc(""\\ED* .../"", ""obj_dw_churchb_gersonstudy_slash_Step_0_gml_217_0"");
