            star = 0;
            reviveamt = abs(global.hp[1]) + 1;
            scr_healitemspell(reviveamt);
            global.hp[1] = 1;
            with (obj_dmgwriter)
            {
                if (type == 3 && delay == 8)
                {
                    damage = abs(starthp - global.hp[1]);
