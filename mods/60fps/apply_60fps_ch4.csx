    }
}
if (image_alpha < 0)
{
    instance_destroy();
}
anim_index++;
if (gigahammer)
{
    if (fakevspeed < 0)
    {
        image_angle += (60 / global.fps_scale);
    }
    else
    {
        image_angle = 202.5;
    }
}
else if (anim_index == 3)
{
    image_angle += (40 / global.fps_scale);
    anim_index = 0;
}
if (!(gigahammer && fakevspeed >= 0))
{
    x += (fakehspeed / global.fps_scale);
    y += (fakevspeed / global.fps_scale);
    fakevspeed += (fakegravity / global.fps_scale);
}
if (gigahammer && fakevspeed >= 0 && !drop)
{
    hspeed = 0;
    vspeed = 0;
    drop = true;
    fakevspeed = 0;
    fakehspeed = 0;
    fakegravity = 0;
    gravity = 0;
    alarm[0] = round(12 * global.fps_scale);
}
if (fakevspeed > 11)
{
    fakevspeed = 11;
}
if (!drop)
{
    if (y < (cameray() + 20))
    {
        x += (1 / global.fps_scale);
        y += (2 / global.fps_scale);
    }
}
");

Apply("gml_Object_obj_gerson_hammer_bro_hammer_Step_2", @"if (gigahammer)
{
    if (y > (obj_growtangle.y + 20) && !true_drop)
    {
        with (obj_growtangle)
        {
            y += (other.y - other.yprevious);
            y = min(y, __view_get(e__VW.YView, 0) + 220);
            with (obj_heart)
            {
                y += (obj_growtangle.y - obj_growtangle.yprevious);
            }
        }
    }
    if (!true_drop && y > (__view_get(e__VW.YView, 0) + 220))
    {
        true_drop = true;
        vspeed = -16 / global.fps_scale;
        snd_play(snd_impact);
        snd_play_pitch(snd_metal_hit_reverb, 1);
        scr_shakescreen();
    }
    if (true_drop && y > (__view_get(e__VW.YView, 0) + 720))
    {
        scr_shakescreen();
        snd_play_pitch(snd_glassbreak, 0.5);
        snd_play_pitch(snd_explosion_firework, 0.75);
        instance_destroy();
    }
    if (image_alpha < 0.8)
    {
        active = 0;
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

