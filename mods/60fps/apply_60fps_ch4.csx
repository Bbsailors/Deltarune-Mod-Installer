{
    _headindex = eyesfollowgersonindex;
}
if (state == 0)
{
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
    }
    siner += (0.16666666666666666 / global.fps_scale);
    if (headflashtimer > 0)
    {
        headoffsetx += (((headflashtimer - (irandom(headflashtimer) * 2)) * 2) / global.fps_scale);
        headoffsety += (((headflashtimer - (irandom(headflashtimer) * 2)) * 1) / global.fps_scale);
    }
    if (headflashtimer > 0)
    {
        headflashtimer -= (1 / global.fps_scale);
    }
    if (headspeed > 2)
    {
        headspeed -= (headfriction / global.fps_scale);
    }
    if (headspeed < -2)
    {
        headspeed += (headfriction / global.fps_scale);
    }
    if (headoffsetx > 2)
    {
        headspeed -= (headgravity / global.fps_scale);
    }
    else if (headoffsetx < -2)
    {
        headspeed += (headgravity / global.fps_scale);
    }
    else
    {
        headoffsetx = 0;
        if (headspeed < 0.5 && headspeed > -0.5)
        {
            headspeed = 0;
        }
    }
    if (headoffsetx > 65)
    {
        headoffsetx = 65;
        headspeed = 0;
    }
    if (headoffsetx < -65)
    {
        headoffsetx = -65;
        headspeed = 0;
    }
    if (headspeed > 15)
    {
        headspeed = 15;
    }
    if (headspeed < -15)
    {
        headspeed = -15;
    }
    headoffsetx += (headspeed / global.fps_scale);
    if (headoffsety > 0)
    {
        headoffsety -= (0.5 / global.fps_scale);
    }
    if (headoffsety < 0)
    {
        headoffsety += (0.5 / global.fps_scale);
    }
    if (eyedelay < 1)
    {
        eyesiner += (1 / global.fps_scale);
    }
    animsiner += (1 / global.fps_scale);
    if (acting == 20 && global.myfight == 3)
    {
        headamplitude = lerp(headamplitude, 0, scr_fps_lerp_rate(0.25));
