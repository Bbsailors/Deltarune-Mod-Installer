    x = xstart + (sin(siner / 10) * 70);
    image_angle = sin(siner / 6) * 20;
    vspeed = (sin(siner / 4) * 8) / global.fps_scale;
    timer += (1 / global.fps_scale);
    if (timer >= 8)
    {
        timer = 0;
        shot = instance_create(x, y, obj_regularbullet);
        if (i_ex(shot))
        {
            shot.sprite_index = spr_clubsbullet_dark;
            shot.image_angle = -90;
            shot.speed = (6 / global.fps_scale) + (vspeed / 4);
            shot.active = 1;
            shot.image_angle = image_angle - 90;
            shot.direction = image_angle - 90;
            shot.target = target;
            shot.damage = damage;
            shot.grazepoints = 6;
        }
        scr_bullet_inherit(shot);
    }
}
if (con == 2)
{
    if (y > (cameray() - 30))
    {
        y = lerp(y, cameray() - 30, scr_fps_lerp_rate(0.3));
    }
    destroytimer += (1 / global.fps_scale);
    if (destroytimer == 30)
    {
        instance_destroy();
    }
}
");

