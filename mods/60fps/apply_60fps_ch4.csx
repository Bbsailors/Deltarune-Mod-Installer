            if (MENU_NO == 3)
            {
                TEMPCOMMENT = stringsetloc(""Choose a file to copy to."", ""DEVICE_MENU_slash_Draw_0_gml_225_0"");
            }
            if (MENU_NO == 4)
            {
                TEMPCOMMENT = stringsetloc(""The file will be overwritten."", ""DEVICE_MENU_slash_Draw_0_gml_226_0"");
