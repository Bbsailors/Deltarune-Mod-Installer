Apply("gml_Object_obj_ch4_DCA01_fall_Draw_0", @"if (window_timer <= 0)
{
    exit;
}
window_timer += (delta / global.fps_scale);
var _window = (delta > 0.5) ? 2297 : 1260;
for (var i = 0; i < 6; i++)
{
    draw_sprite_ext(_window, 0, camerax() + 40, (cameray() + 500) - (((window_timer * 40) - (i * 200)) % 600), 2, 2, 0, c_white, 1);
    draw_sprite_ext(_window, 0, (camerax() + 640) - 62 - 40, (cameray() + 500) - (((window_timer * 40) - (i * 200)) % 600), 2, 2, 0, c_white, 1);
}
");

Apply("gml_Object_obj_ch4_DCA01_fall_Step_0", @"extimer += (1 / global.fps_scale);
if (con == 1)
{
    window_timer = max(window_timer, 1);
    con = 0;
}
if (con == 2)
{
    roomglow.active = true;
    roomglow.shadows = false;
    with (obj_sprhighlight)
    {
        yoffset = -2;
    }
    con = 0;
}
if (con == 3)
{
    timer += (1 / global.fps_scale);
    with (obj_sprhighlight)
    {
        yoffset = lerp(-2, 2, other.timer / 3);
    }
    if (timer == 3)
    {
        con = 0;
        timer = 0;
    }
}
if (con == 4)
{
    roomglow.active = false;
    con = 0;
}
");

Apply("gml_Object_obj_ch4_DCA01_roaringknight_Step_0", @"siner2 += (1 / global.fps_scale);
y = ystart + (cos(siner2 / 8) * 8);
aetimer += (1 / global.fps_scale);
if ((aetimer % move_speed) == 0 && image_alpha != 0)
{
    if (state == 0)
    {
        afterimage = instance_create_depth(x, y, depth + 1, obj_afterimage);
        afterimage.sprite_index = sprite_index;
        afterimage.image_alpha = 0.6;
        afterimage.fadeSpeed = 0.02;
        afterimage.hspeed = (after_image_rate * after_image_dir) / global.fps_scale;
        afterimage.image_index = image_index;
        afterimage.image_speed = 0;
        afterimage.image_xscale = image_xscale;
        afterimage.image_yscale = image_yscale;
    }
}
if (beam_shoot)
{
    beam_shoot_timer += (1 / global.fps_scale);
    if ((beam_shoot_timer % 8) == 0)
    {
        beam_counter++;
        var beam = scr_dark_marker(x + 55, y + 55, spr_roaringknight_beam);
        beam.depth = depth - 10;
        with (beam)
        {
            scr_lerpvar(""image_xscale"", 0, 2, 5, 4, ""out"");
            scr_lerpvar(""image_yscale"", 0, 2, 10, 4, ""out"");
            scr_lerpvar(""y"", beam.y, cameray() - 100, 30, 4, ""out"");
        }
        scr_doom(beam, 60);
    }
    if (beam_shoot_timer >= 40)
    {
        beam_shoot = false;
    }
}
");

Apply("gml_Object_obj_ch4_DCA01_roaringknight_sword_Step_0", @"y = cameray() + 80 + ypos;
if (image_alpha < 1)
{
    ypos -= (1 / global.fps_scale);
    image_alpha += (0.1 / global.fps_scale);
}
timer += (1 / global.fps_scale);
if (timer == 1)
{
    snd_stop(snd_knight_jump_quick);
    snd_play_x(snd_knight_jump_quick, 0.5, 1.3);
}
if (timer >= 10 && timer < 16)
{
    image_blend = merge_color(c_white, c_red, (timer - 10) / 6);
    ypos = lerp(ypos, 38, (timer - 10) / 6);
}
if (timer == 16)
{
    con = y;
    ypos += 600;
    snd_stop(snd_knight_cut2);
    snd_play_x(snd_knight_cut2, 0.5, 1.3);
}
if (timer == 18)
{
    instance_destroy();
}
");

