Apply("gml_Object_obj_caterpillarchara_Step_2", @"if (scr_debug())
{
    if (keyboard_check(vk_shift) && keyboard_check_pressed(ord(""N"")))
    {
        target--;
        debug_message(""name:"" + name + "" | target="" + string(target));
