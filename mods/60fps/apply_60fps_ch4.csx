                scr_lerpvar(""y"", y, y - 15, 30);
            }
            heart_timer = 0;
            show_heart = false;
        }
    }
    if (global.interact == 1 && !show_heart)
    {
        heart_timer += (1 / global.fps_scale);
        if (heart_timer >= 45)
        {
            global.interact = 0;
            show_controls = true;
        }
    }
    if (show_controls)
    {
        if (!sunkus_kb_check_pressed(1) && !scr_gamepad_check_any())
        {
            controls_timer += (1 / global.fps_scale);
            if (controls_timer >= 1800)
            {
                writer_fadein = true;
                with (writer)
                {
                    scr_lerpvar(""writingy"", writingy, writingy - 30, 20);
                }
            }
        }
        else
        {
            writer_fadeout = true;
            with (writer)
            {
                scr_lerpvar(""writingy"", writingy, writingy + 30, 10);
            }
        }
        if (writer_fadein)
        {
            writer_blend = clamp(writer_blend + (0.05 / global.fps_scale), 0, 1);
            var blend = writer_blend;
            with (writer)
            {
                mycolor = merge_color(c_black, c_white, blend);
            }
            if (blend >= #010000)
            {
                writer_fadein = false;
            }
        }
        if (writer_fadeout)
        {
            writer_blend = clamp(writer_blend - (0.15 / global.fps_scale), 0, 1);
            var blend = writer_blend;
            with (writer)
            {
                mycolor = merge_color(c_black, c_white, blend);
            }
            if (blend <= c_black)
            {
                writer_fadeout = false;
                show_heart = false;
                show_controls = false;
                heart_control = false;
            }
        }
    }
}
