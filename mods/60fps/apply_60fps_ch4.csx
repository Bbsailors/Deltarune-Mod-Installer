        {
            follow = 0;
            if (name == ""susie"")
            {
                x = other.horizontal_endx + 185;
                y = 3980;
            }
            else
            {
                x = other.horizontal_endx + 125;
                y = 3984;
            }
        }
        with (cam)
        {
            panLimitLeft[0] = 3860;
            panLimitRight[0] = 3860;
            panLimitTop[0] = 0;
