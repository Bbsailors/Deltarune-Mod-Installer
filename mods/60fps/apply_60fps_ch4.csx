        {
            image_alpha -= (0.04 / global.fps_scale);
        }
        with (rotating_sprite_piece5)
        {
            image_alpha -= (0.04 / global.fps_scale);
        }
        with (rotating_sprite_piece6)
        {
            image_alpha -= (0.04 / global.fps_scale);
        }
    }
    if (timer > (50 / f))
    {
        instance_destroy();
        with (rotating_sprite_piece1)
        {
            instance_destroy();
        }
        with (rotating_sprite_piece2)
        {
