        if (i == 0)
        {
            checkpress = buttonb_p() || left_p();
            holdpress = buttonb_h() || left_h();
        }
        if (i == 1)
        {
            checkpress = buttonr_p() || right_p();
            holdpress = buttonr_h() || right_h();
