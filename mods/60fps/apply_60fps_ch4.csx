Apply("gml_Object_obj_ch4_PDC03_catty_preach_Alarm_0", @"speech_alpha = 1;
scr_lerpvar_instance(id, ""speech_xscale"", 0, 0.5, speech_time * 0.25);
scr_lerpvar_instance(id, ""speech_yscale"", 0, 0.5, speech_time * 0.25);
scr_lerpvar_instance(id, ""speech_ypos"", 240, 280, speech_time * 0.25);
alarm[1] = round(speech_time * 0.75 * global.fps_scale);
");

Apply("gml_Object_obj_ch4_PDC03_catty_preach_Alarm_1", @"scr_lerpvar_instance(id, ""speech_alpha"", 1, 0, speech_time * 0.15);
alarm[2] = round(speech_time * 0.25 * global.fps_scale);
");

Apply("gml_Object_obj_ch4_PDC03_catty_preach_Alarm_2", @"if (current_text != cutoff_text)
{
    current_index = clamp(current_index + 1, 0, array_length_1d(speech) - 1);
    current_text = !stop_speech ? speech[current_index] : cutoff_text;
    alarm[0] = round(speech_time * 0.25 * global.fps_scale);
}
else
{
    instance_destroy();
}
");

Apply("gml_Object_obj_ch4_PDC03_catty_preach_Step_0", @"if (start_speech)
{
    start_speech = false;
    alarm[0] = round(10 * global.fps_scale);
}
");

Apply("gml_Object_obj_ch4_PDC03_choir_song_Step_0", @"if (start_song)
{
    start_song = false;
    choir_song[1] = audio_play_sound(choir_song[0], 90, 0);
    alarm[5] = round(25 * global.fps_scale);
    exit;
}
if (global.lang == ""ja"")
{
    if (instance_exists(myd))
    {
        timer += (1 / global.fps_scale);
        if (timer == 800)
        {
            myd.rate = 3;
        }
    }
}
if (song_started && !i_ex(obj_writer))
{
    song_started = false;
    snd_free(choir_song[0]);
    instance_destroy();
}
");

