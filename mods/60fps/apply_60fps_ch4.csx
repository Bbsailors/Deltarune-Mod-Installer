    {
        reset_blend = 0;
        bomb_marker.image_speed = 0.1 / global.fps_scale;
        snd_volume(global.currentsong[1], 0, 0);
        with (obj_fadeout)
        {
            instance_destroy();
        }
        scr_fadein(30);
    }
    if (timer == (bombdelay + resetdelay + 180))
    {
        snd_resume(global.currentsong[1]);
