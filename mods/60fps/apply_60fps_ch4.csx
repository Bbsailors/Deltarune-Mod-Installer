        x = scr_approach_curve(x, temp_x, 8);
        y = scr_approach_curve(y, temp_y, 8);
    }
}
if (sameattack == pop)
{
    if (pop == 1)
    {
        timer_limit = 48 * ratio;
    }
    else
    {
