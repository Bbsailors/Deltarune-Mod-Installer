        }
        with (scr_marker_ext(camerax() - 10, cameray() - 10, spr_pxwhite, 660, 500, undefined, undefined, c_black, 5000, undefined, undefined, 0))
        {
            scr_lerpvar(""image_alpha"", 0, 1, 30);
