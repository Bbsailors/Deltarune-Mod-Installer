    {
        scr_blconskip(15);
    }
}
if (global.mnfight == 2 && global.turntimer <= 1)
{
    umbrella = 0;
    warmhat = 0;
}
if (global.myfight == 3)
{
    xx = __view_get(e__VW.XView, 0);
    yy = __view_get(e__VW.YView, 0);
    if (acting == 1 && actcon == 0)
