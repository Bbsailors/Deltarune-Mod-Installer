            scr_speaker(""no_name"");
            msgsetloc(0, ""* ADDISON'S^1! RELIABLE sales^1! NO unwanted mail or SHORT FREAKS!\\f0^2\\f1/"", ""obj_npc_room_slash_Other_10_gml_203_0"");
