    c_msgnextloc(""\\ED* The Knight took her and locked her in the shelter south of town./"", ""obj_ch4_PDC06_slash_Step_0_gml_131_0"");
    c_msgnextloc(""\\E1* We gotta get her out^1, but..^1.the door's solid steel./"", ""obj_ch4_PDC06_slash_Step_0_gml_132_0"");
    c_msgnextloc(""\\ED* There's..^1. no way we can break in./"", ""obj_ch4_PDC06_slash_Step_0_gml_133_0"");
    c_msgnextloc(""\\E0* So now we're looking for the codes to the lock./"", ""obj_ch4_PDC06_slash_Step_0_gml_134_0"");
    c_msgnextloc(""\\ER* ..^1. we thought Noelle's mom might have one^1, but.../"", ""obj_ch4_PDC06_slash_Step_0_gml_135_0"");
    c_facenext(""ralsei"", ""0"");
    c_msgnextloc(""\\E0* Are you worried about her...? Undyne?/"", ""obj_ch4_PDC06_slash_Step_0_gml_137_0"");
    c_facenext(""susie"", 5);
    c_msgnextloc(""\\E5* Me? A cop like her? Hell no!/"", ""obj_ch4_PDC06_slash_Step_0_gml_139_0"");
    c_msgnextloc(""\\ED* Y'know..^1. It's^1, just that.../"", ""obj_ch4_PDC06_slash_Step_0_gml_140_0"");
    c_facenext(""ralsei"", ""Q"");
    c_msgnextloc(""\\EQ* Don't worry^1, Susie. Someone strong like her will be OK./"", ""obj_ch4_PDC06_slash_Step_0_gml_142_0"");
    c_msgnextloc(""\\EI* I want this place to be a place.../"", ""obj_ch4_PDC06_slash_Step_0_gml_143_0"");
    c_msgnextloc(""\\E0* Where you can forget about the real world for a while./"", ""obj_ch4_PDC06_slash_Step_0_gml_144_0"");
    c_msgnextloc(""\\E2* Just relax^1, OK...?/"", ""obj_ch4_PDC06_slash_Step_0_gml_145_0"");
    c_msgnextloc(""\\EE* And if anything tough happens^1,/"", ""obj_ch4_PDC06_slash_Step_0_gml_146_0"");
    c_msgnextloc(""\\EJ* I'll come help you two^1, as fast as I can!/"", ""obj_ch4_PDC06_slash_Step_0_gml_147_0"");
    c_facenext(""susie"", ""D"");
    c_msgnextloc(""\\ED* ..^1. thanks^1, Ralsei./"", ""obj_ch4_PDC06_slash_Step_0_gml_149_0"");
    c_msgnextloc(""\\E0* .../"", ""obj_ch4_PDC06_slash_Step_0_gml_150_0"");
    c_facenext(""ralsei"", 0);
    c_msgnextloc(""\\E0* ..^1. If it's any consolation.../"", ""obj_ch4_PDC06_slash_Step_0_gml_152_0"");
    c_msgnextloc(""\\E2* I don't sense any immediate danger./"", ""obj_ch4_PDC06_slash_Step_0_gml_153_0"");
    c_msgnextloc(""\\E4* If the Knight's only goal was to hurt people.../"", ""obj_ch4_PDC06_slash_Step_0_gml_154_0"");
    c_msgnextloc(""\\EJ* They would have acted sooner^1, right?/"", ""obj_ch4_PDC06_slash_Step_0_gml_155_0"");
    c_msgnextloc(""\\EE* For now^1, let's make sure no one else gets taken./"", ""obj_ch4_PDC06_slash_Step_0_gml_156_0"");
    c_facenext(""susie"", ""D"");
    c_msgnextloc(""\\ED* ..^1. Yeah^1, alright./"", ""obj_ch4_PDC06_slash_Step_0_gml_158_0"");
    c_msgnextloc(""\\E9* ..^1. heh^1, what's with you^1, making me feel better?/%"", ""obj_ch4_PDC06_slash_Step_0_gml_159_0"");
