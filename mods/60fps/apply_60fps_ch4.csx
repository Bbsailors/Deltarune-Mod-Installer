            if (timer == (difftime + 3))
            {
                image_index = 1;
            }
            if (timer == (difftime + 4))
            {
                image_index = 0;
                con++;
                timer = 0;
                depth = 5000;
                movespeed = 0.5;
            }
        }
        if (con == 1)
        {
