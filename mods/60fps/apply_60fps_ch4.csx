        repeat (textlength)
        {
            draw_text_transformed(x + lengthdir_x(radius, angle_diff + angle), (y - 90) + (surface_h / 2) + lengthdir_y(radius, angle_diff + angle), string_char_at(text, letter_count), 1, 1, angle_diff + 270 + angle);
            var dist = -8;
            if (global.lang == ""ja"")
            {
                dist = -15;
                if (exspace)
