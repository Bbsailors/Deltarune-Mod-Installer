{
    if (scr_trigcheck_ext(""groundsparklekiller"", id))
    {
        fadeoutmode = 1;
    }
}
if (fadeoutmode == 0)
{
    if (y >= mytarg && choose(0, 1) == 0)
    {
        scr_marker_ext(scr_even(x), scr_even(y), sprite_index, 2, 2, undefined, random(30), undefined, undefined, 1);
        instance_destroy();
    }
}
if (fadeoutmode == 1)
{
    image_alpha -= (0.05 / global.fps_scale);
    if (image_alpha <= 0)
    {
        instance_destroy();
    }
}
");

