                var ypos = (global.chapter == 1) ? 140 : (y + 35);
                var ral_sprite = (global.chapter == 1) ? spr_ralsei_shock_overworld : spr_ralsei_hurt;
                char = scr_dark_marker(xpos, ypos, ral_sprite);
