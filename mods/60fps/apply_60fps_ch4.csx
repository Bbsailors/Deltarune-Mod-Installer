Apply("gml_Object_obj_rhythmgame_tenna_tester_Create_0", @"init = false;
image_speed = 1 / global.fps_scale;
timer = 0;
rhythmgame = 0;
active = false;
track = 0;
");

Apply("gml_Object_obj_rhythmgame_tenna_tester_Step_0", @"if (init == false)
{
    global.batmusic[0] = snd_init(""tenna_battle.ogg"");
    global.batmusic[1] = mus_loop(global.batmusic[0]);
    init = true;
}
track_pos = audio_sound_get_track_position(global.batmusic[1]);
if (image_speed < (2 / global.fps_scale) && track_pos > 6.4)
{
    image_speed = 2 / global.fps_scale;
}
if (image_speed == (2 / global.fps_scale) && track_pos < 6.4)
{
    image_speed = 1 / global.fps_scale;
}
if (keyboard_check(vk_space) && !active)
{
    active = true;
    rhythmgame = instance_create(0, 0, obj_rhythmgame);
    timer = 240;
    rhythmgame.tenna_boss = true;
}
if (scr_debug())
{
    if (keyboard_check(ord(""0"")) && !active)
    {
        audio_sound_set_track_position(global.batmusic[0], 0);
    }
}
if (timer > 0 && active)
{
    timer -= (1 / global.fps_scale);
    if (timer <= 0)
    {
        instance_destroy(rhythmgame);
        timer = 0;
        active = false;
    }
}
");

Apply("gml_Object_obj_ribbick_battle_fly_Create_0", @"event_inherited();
image_speed = 0.25 / global.fps_scale;
sin_timer = random(128);
timer = 0;
vspeed = 3 / global.fps_scale;
visible = false;
grazepoints = 3;
if (i_ex(obj_volumeup))
{
    image_xscale = 1.5;
    image_yscale = 1.5;
    grazepoints += 1;
}
");

Apply("gml_Object_obj_ribbick_battle_fly_Step_0", @"sin_timer += (1 / global.fps_scale);
timer += (1 / global.fps_scale);
x += ((sin(sin_timer * 0.1) * 1) / global.fps_scale);
y += ((cos(sin_timer * 0.15) * 0.5) / global.fps_scale);
if (timer == 14)
{
    vspeed = 0;
}
if (timer == 30)
{
    direction = scr_at_player();
    speed = 4 / global.fps_scale;
}
if (x < (__view_get(e__VW.XView, 0) - 80))
{
    instance_destroy();
}
if (x > (__view_get(e__VW.XView, 0) + 760))
{
    instance_destroy();
}
if (y < (__view_get(e__VW.YView, 0) - 80))
{
    instance_destroy();
}
if (y > (__view_get(e__VW.YView, 0) + 580))
{
    instance_destroy();
}
if (place_meeting(x, y, obj_ribbick_battle_frog))
{
    instance_destroy();
    with (instance_create(x, y, obj_regularbullet))
    {
        active = false;
        spin = 1;
        spinspeed = random(5) - 0.25;
        direction = 70 + random(40);
        speed = (1 + random(1)) / global.fps_scale;
        image_xscale = 0.5;
        image_yscale = 0.5;
        sprite_index = spr_cakesmoke;
        scr_lerpvar(""image_alpha"", 1, 0, 30);
        scr_script_delayed(instance_destroy, 30);
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_ribbick_battle_fly_manager_Step_0", @"var onlyflyattack = true;
var flycount = 0;
for (var i = 0; i < instance_number(obj_dbulletcontroller); i++)
{
    dbulletcontroller[i] = instance_find(obj_dbulletcontroller, i);
    if (dbulletcontroller[i].type != 111)
    {
        onlyflyattack = false;
    }
    if (dbulletcontroller[i].type == 111)
    {
        flycount++;
    }
}
if (onlyflyattack == true)
{
    if (flycount == 1)
    {
        ratio = 0.75;
    }
    if (flycount == 2)
    {
        ratio = 0.89 + (random(1) / 4);
    }
    if (flycount == 3)
    {
        ratio = 1 + random(1);
    }
}
timer += (1 / global.fps_scale);
if (init == 0)
{
    timer = 16 * ratio;
    init = 1;
}
if (timer >= (16 * ratio))
{
    timer -= (16 * ratio);
    repeat (sameattack)
    {
        fly = instance_create(scr_get_box(4) + irandom_range(-65, 65), scr_get_box(1) - 20, obj_ribbick_battle_fly);
        fly.target = target;
        fly.damage = damage;
    }
}
");

Apply("gml_Object_obj_ribbick_battle_frog_Alarm_0", @"if (canjump)
{
    state = ""jump"";
    vspeed = 0;
}
alarm[0] = round(wait_time * global.fps_scale);
");

Apply("gml_Object_obj_ribbick_battle_frog_Step_0", @"if (!i_ex(obj_heart) || global.turntimer < 1)
{
    instance_destroy();
    exit;
}
if (y < (scr_get_box(1) + 24))
{
    y = scr_get_box(1) + 24;
    image_yscale = -1;
    image_index = 0;
    vspeed = 0;
    hspeed = 0;
    gravity = 0;
    attached = true;
    patience = round((30 + irandom(30)) * global.fps_scale);
    stickiness = 15;
    canjump = false;
}
if (y < (scr_get_box(3) - 22) && !attached)
{
    if (x < (scr_get_box(2) + 24))
    {
        x = scr_get_box(2) + 24;
        attached = true;
        vspeed = 0.25 / global.fps_scale;
        hspeed = 0;
        gravity = 0;
        image_index = 0;
        image_xscale = -1;
        image_yscale = 1;
        image_angle = -90;
        canjump = true;
    }
    if (x > (scr_get_box(0) - 22))
    {
        x = scr_get_box(0) - 22;
        attached = true;
        vspeed = 0.25 / global.fps_scale;
        hspeed = 0;
        gravity = 0;
        image_index = 0;
        image_xscale = 1;
        image_yscale = 1;
        image_angle = 90;
        canjump = true;
    }
}
if (y >= (scr_get_box(3) - 22) && vspeed > 0)
{
    y = scr_get_box(3) - 22;
    vspeed = 0;
    hspeed = 0;
    gravity = 0;
    image_index = 0;
    attached = false;
    image_angle = 0;
    image_yscale = 1;
    canjump = true;
}
if (patience)
{
    patience--;
    stickiness = scr_approach(stickiness, 0, 1);
    if (patience == 0 || (stickiness == 0 && abs(x - (obj_heart.x + 8)) < 20))
    {
        patience = 0;
        stickiness = 0;
        attached = false;
        gravity = 0.25 / (global.fps_scale * global.fps_scale);
        vspeed = 0;
        image_index = 1;
    }
}
if (state == ""jump"")
{
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        image_blend = c_gray;
    }
    if (timer == 5)
    {
        image_blend = c_white;
    }
    if (timer == 10)
    {
        var aim = hop_trajectory();
        attached = false;
        image_angle = 0;
        image_yscale = 1;
        hspeed = (lengthdir_x(1, aim) * 4) / global.fps_scale;
        vspeed = ((lengthdir_y(1, aim) * 6) - 2) / global.fps_scale;
        image_index = 1;
        gravity = 0.25 / (global.fps_scale * global.fps_scale);
        timer = 0;
        state = ""none"";
        canjump = false;
        if (hspeed >= 0)
        {
            image_xscale = 1;
        }
        else
        {
            image_xscale = -1;
        }
    }
}
if (!attached && y != (scr_get_box(3) - 22))
{
    if (hspeed >= 0)
    {
        image_xscale = 1;
    }
    else
    {
        image_xscale = -1;
    }
}
");

