Apply("gml_Object_obj_recruitanim_Step_0", @"timer += (1 / global.fps_scale);
if (timer <= 5)
{
    lerptimer += (1 / global.fps_scale);
    image_xscale = lerp(image_xscale, 1, lerptimer / 5);
    image_yscale = lerp(image_yscale, 1, lerptimer / 5);
}
if (timer == 5)
{
    lerptimer = 0;
}
if (timer >= 5 && timer <= 8)
{
    lerptimer += (1 / global.fps_scale);
    image_xscale = lerp(image_xscale, 0.5, lerptimer / 3);
    image_yscale = lerp(image_yscale, 2, lerptimer / 3);
}
if (timer == 8)
{
    lerptimer = 0;
}
if (timer >= 8 && timer <= 10)
{
    lerptimer += (1 / global.fps_scale);
    if (lerptimer >= 2)
    {
        lerptimer = 2;
    }
    image_xscale = lerp(image_xscale, 1, lerptimer / 2);
    image_yscale = lerp(image_yscale, 1, lerptimer / 2);
}
x = xstart + (sprite_width / 2);
if (timer >= 35)
{
    vspeed -= (1 / global.fps_scale);
    image_yscale += (0.1 / global.fps_scale);
    image_alpha -= (0.1 / global.fps_scale);
    if (image_alpha <= 0)
    {
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_redshape_Create_0", @"event_inherited();
radius = 22;
light = 0;
image_blend = c_red;
tracking_val2 = 1;
destroyonhit = false;
speed_max *= 2.5;

do_shrivel = function()
{
};

do_pushback = function()
{
};

check_death = function()
{
};

chase_heart = function()
{
    var hx = obj_heart.x + 10;
    var hy = obj_heart.y + 10;
    if (i_ex(obj_heart))
    {
        if (point_distance(x, y, hx, hy) < (obj_darkshape_light_aura.radius + 8) || light > 0)
        {
            speed = scr_approach(speed, (speed_max * speed_max_multiplier * 0.5) / global.fps_scale, speed * 0.25);
        }
        else
        {
            speed = scr_approach(speed, (speed_max * speed_max_multiplier) / global.fps_scale, (accel * speed_max_multiplier * (1 - light)) / global.fps_scale);
        }
        var anglediff = angle_difference(direction, point_direction(x, y, hx, hy));
        if (tracking_val2 > 0)
        {
            direction = scr_angle_lerp(direction, point_direction(x, y, hx, hy), scr_fps_lerp_rate(tracking_val2 * 0.3));
        }
    }
};

image_xscale = 1;
image_yscale = 1;
scalefactor = 1;
alarm[0] = round(60 * global.fps_scale);
");

Apply("gml_Object_obj_redshape_Step_0", @"event_inherited();
image_angle += (2.8125 / global.fps_scale);
if (tracking_val2 > 0)
{
    tracking_val2 = scr_approach(tracking_val2, 0, 0.00875);
}
if (speed > (2 / global.fps_scale) && (global.time % global.fps_scale) == 0)
{
    with (scr_afterimagefast())
    {
        image_alpha = 0.3;
    }
}
");

Apply("gml_Object_obj_regular_cannon_bullet_Step_0", @"if (global.turntimer < 1)
{
    instance_destroy();
}
if (paused)
{
    exit;
}
if (!speed_set)
{
    speed_goal = speed * 0.33;
    speed_goal_change = abs(speed - speed_goal) * 0.125;
    speed_set = true;
}
if (wall_destroy == 1)
{
    if (x < (__view_get(e__VW.XView, 0) - 80))
    {
        instance_destroy();
    }
    if (x > (__view_get(e__VW.XView, 0) + 760))
    {
        instance_destroy();
    }
    if (y < (__view_get(e__VW.YView, 0) - 80))
    {
        instance_destroy();
    }
    if (y > (__view_get(e__VW.YView, 0) + 580))
    {
        instance_destroy();
    }
}
speed = scr_approach(speed, speed_goal, speed_goal_change);
spin++;
if ((spin % (2 * global.fps_scale)) == 0)
{
    image_angle += 22.5;
}
if (x < (obj_growtangle.x - (obj_growtangle.sprite_width * 0.5) - 16))
{
    image_alpha *= power(0.8, 1 / global.fps_scale);
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

