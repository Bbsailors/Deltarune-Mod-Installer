            var mycol = merge_color(darkcol, lightcol, 0.5 + sinstuff);
            draw_sprite_ext(spr_dw_church_darksmallwindow, 0, cx + (i * xspace) + xoff + bgx, cy + (ii * yspace) + yoff + bgy, 2, 2, 0, mycol, 1);
        }
    }
    draw_set_color(c_white);
}
");

