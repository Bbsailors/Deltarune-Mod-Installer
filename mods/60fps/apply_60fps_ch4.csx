            screen_dark = false;
        }
    }
}
if (piano_sequence)
{
    if (drink_finished && !piano_play)
    {
        piano_pause_timer += (1 / global.fps_scale);
        if (piano_pause_timer < 90)
        {
            exit;
        }
        if (!piano_aligned)
        {
            if (kris_marker.x != 140)
            {
                with (kris_marker)
                {
                    scr_depth();
                    if (sprite_index != spr_krisl)
                    {
