// Deltarune 60 FPS: applies the Chapter 4 code changes to a clean, unmodified data.win.
// Every edited code entry's finished GML is included below, so no other files are needed.
//
// Expected vanilla base: SHA-256 ed64789586238b52375e994e1c1cf13694dd2d0dab57d13e639b9c892e37d8f2
// The result matches the released 60 FPS build's code. Recompiling can normalize some
// formatting, so it may not be identical byte for byte.
//
// To run: in UndertaleModTool, open a clean vanilla Chapter 4 data.win, choose
// Scripts > Run other script, pick this file, then Save.
//
using System;
using UndertaleModLib;
using UndertaleModLib.Models;
using UndertaleModLib.Compiler;

// ---- base guard: refuse to run unless this looks like the exact expected vanilla ----
if (Data.Code.ByName("gml_Script_scr_fps_lerp_rate") != null)
    throw new Exception("scr_fps_lerp_rate already present -> this data.win looks already-modded. "
        + "Apply to a CLEAN vanilla Chapter 4 data.win (expected SHA-256 ed647895...).");
// (Code.Count guard relaxed for modding on top)

var __g = new CodeImportGroup(Data);
int __applied = 0;
void Apply(string name, string gml)
{
    var code = Data.Code.ByName(name);
    if (code == null)
        throw new Exception("Entry not found (is this the right vanilla Chapter 4 data.win?): " + name);
    __g.QueueReplace(code, gml);
    __applied++;
}

Apply("gml_GlobalScript___init_global", @"function __init_global()
{
    layer_force_draw_depth(true, 0);
    draw_set_colour(c_black);
    room_speed = 60;
    global.TARGET_FPS = 60;
    global.fps_scale = global.TARGET_FPS / 30;
    global.fps_debug = 0;
    global.stick_lx = 0;
    global.stick_ly = 0;
    global.stick_mag = 0;
    global.fps_speed_mode = 0;
    global.fps_speed_active = 0;
}

function scr_fps_lerp_rate(arg0)
{
    arg0 = clamp(arg0, 0, 0.999);
    return 1 - power(1 - arg0, 1 / global.fps_scale);
}
");

Apply("gml_GlobalScript_c_soundplay_wait", @"function c_soundplay_wait(arg0)
{
    c_cmd(""soundplay"", arg0, 0, 0, 0);
    c_wait(round(audio_sound_length(arg0) * 30));
}

function c_playsound_wait(arg0)
{
    c_soundplay_wait(arg0);
}
");

Apply("gml_GlobalScript_c_wait", @"function c_wait(arg0)
{
    c_cmd(""wait"", round(arg0 * global.fps_scale), 0, 0, 0);
}
");

Apply("gml_GlobalScript_c_wait_soundlength", @"function c_wait_soundlength(arg0)
{
    c_wait(round(audio_sound_length(arg0) * 30));
}
");

Apply("gml_GlobalScript_mus_fade", @"function mus_fade(arg0, arg1)
{
    audio_sound_gain(arg0, 0, (arg1 * 1000) / 30);
}
");

Apply("gml_GlobalScript_mus_volume", @"function mus_volume(arg0, arg1, arg2)
{
    audio_sound_gain(arg0, arg1 * global.flag[16], (arg2 * 1000) / 30);
}
");

Apply("gml_GlobalScript_scr_84_debug", @"function scr_84_debug(arg0)
{
    if (arg0)
    {
        return 0;
    }
    var _x = 4;
    var _y = 4;
    var _line = 14;
    draw_set_alpha(0.7);
    draw_set_color(c_black);
    if (!variable_global_exists(""dbg_panel_h""))
    {
        global.dbg_panel_h = 80;
    }
    draw_rectangle(_x - 2, _y - 2, 340, global.dbg_panel_h, false);
    draw_set_alpha(1);
    draw_set_font(fnt_main);
    draw_set_halign(fa_left);
    draw_set_color(c_white);
    if (room_speed > 60)
    {
        draw_set_color(c_lime);
        var _spd_label = ""2X"";
        if (room_speed >= 240)
        {
            _spd_label = ""4X"";
        }
        draw_text(_x, _y, ""=== 60FPS DEBUG === ["" + _spd_label + "" SPEED]"");
        draw_set_color(c_white);
    }
    else
    {
        draw_text(_x, _y, ""=== 60FPS DEBUG ==="");
    }
    _y += _line;
    draw_text(_x, _y, ""Room: "" + string(room) + "" ("" + room_get_name(room) + "")"");
    _y += _line;
    draw_text(_x, _y, ""FPS: "" + string(floor(fps_real)) + "" / "" + string(room_speed) + ""  scale:"" + string(global.fps_scale));
    _y += _line;
    draw_set_color(c_aqua);
    if (i_ex(obj_gamecontroller))
    {
        var _gpa = obj_gamecontroller.gamepad_active;
        var _gpi = obj_gamecontroller.gamepad_id;
        var _gpc = gamepad_get_device_count();
        var _gp_conn_str = """";
        for (var _gpi2 = 0; _gpi2 < 8; _gpi2++)
        {
            _gp_conn_str += (gamepad_is_connected(_gpi2) ? ""1"" : ""0"");
        }
        draw_text(_x, _y, ""GP count:"" + string(_gpc) + "" id:"" + string(_gpi) + "" active:"" + string(_gpa) + "" slots:"" + _gp_conn_str);
        _y += _line;
        draw_text(_x, _y, ""GP type: "" + string(global.gamepad_type));
        _y += _line;
    }
    else
    {
        draw_text(_x, _y, ""GP: obj_gamecontroller not found"");
        _y += _line;
    }
    draw_set_color(c_white);
    draw_text(_x, _y, ""interact:"" + string(global.interact) + "" plot:"" + string(global.plot) + "" facing:"" + string(global.facing));
    _y += _line;
    if (instance_exists(obj_cutscene_master))
    {
        draw_set_color(c_yellow);
        var cm = instance_find(obj_cutscene_master, 0);
        draw_text(_x, _y, ""CUTSCENE active id:"" + string(cm));
        _y += _line;
    }
    if (instance_exists(obj_homealone_heart))
    {
        draw_set_color(c_lime);
        var h = instance_find(obj_homealone_heart, 0);
        var hx = variable_instance_get(h, ""x"", 0);
        var hy = variable_instance_get(h, ""y"", 0);
        var hcut = variable_instance_get(h, ""cutscene"", 0);
        var hfrz = variable_instance_get(h, ""freeze"", 0);
        var hwalk = variable_instance_get(h, ""walk"", 0);
        var hwt = variable_instance_get(h, ""walktimer"", 0);
        var hwb = variable_instance_get(h, ""walkbuffer"", 0);
        draw_text(_x, _y, ""Heart x:"" + string(floor(hx)) + "" y:"" + string(floor(hy)) + "" cut:"" + string(hcut) + "" frz:"" + string(hfrz));
        _y += _line;
        draw_text(_x, _y, ""  walk:"" + string(hwalk) + "" wt:"" + string_format(hwt, 4, 1) + "" wb:"" + string_format(hwb, 3, 1));
        _y += _line;
    }
    if (instance_exists(obj_homealone_controller))
    {
        draw_set_color(c_aqua);
        var hc = instance_find(obj_homealone_controller, 0);
        draw_text(_x, _y, ""HA_ctrl con:"" + string(variable_instance_get(hc, ""con"", ""?"")));
        _y += _line;
    }
    if (instance_exists(obj_noellehouse_dess))
    {
        draw_set_color(c_fuchsia);
        var nd = instance_find(obj_noellehouse_dess, 0);
        draw_text(_x, _y, ""Dess con:"" + string(variable_instance_get(nd, ""con"", ""?"")) + "" cust:"" + string(variable_instance_get(nd, ""customcon"", ""?"")));
        _y += _line;
        var kft = variable_instance_get(nd, ""kris_fall_timer"", -1);
        var hft = variable_instance_get(nd, ""heart_fall_timer"", -1);
        if (kft >= 0 || hft >= 0)
        {
            draw_text(_x, _y, ""  kft:"" + string_format(kft, 4, 1) + "" hft:"" + string_format(hft, 4, 1));
            _y += _line;
        }
        draw_text(_x, _y, ""  hit_heart:"" + string(variable_instance_get(nd, ""hit_heart"", ""?"")) + "" bed_hide:"" + string(variable_instance_get(nd, ""kris_bed_hide"", ""?"")));
        _y += _line;
    }
    if (instance_exists(obj_noellehouse_basement))
    {
        draw_set_color(c_orange);
        var nb = instance_find(obj_noellehouse_basement, 0);
        draw_text(_x, _y, ""Bsmt hfall:"" + string(variable_instance_get(nb, ""heart_fall"", ""?"")) + "" bscn:"" + string(variable_instance_get(nb, ""basement_scene"", ""?"")) + "" bt:"" + string_format(variable_instance_get(nb, ""basement_timer"", 0), 4, 1));
        _y += _line;
    }
    if (instance_exists(obj_homealone_dess_closet_kris))
    {
        draw_set_color(c_ltgray);
        var dk = instance_find(obj_homealone_dess_closet_kris, 0);
        draw_text(_x, _y, ""DessKris mode:"" + string(variable_instance_get(dk, ""mode"", ""?"")) + "" wcon:"" + string(variable_instance_get(dk, ""walkcon"", ""?"")) + "" wt:"" + string_format(variable_instance_get(dk, ""walktimer"", 0), 4, 1) + "" rdy:"" + string(variable_instance_get(dk, ""kris_ready"", ""?"")));
        _y += _line;
    }
    if (instance_exists(obj_anim_custom))
    {
        draw_set_color(c_yellow);
        var ac = instance_find(obj_anim_custom, 0);
        draw_text(_x, _y, ""Anim active:"" + string(variable_instance_get(ac, ""anim_active"", ""?"")) + "" idx:"" + string(variable_instance_get(ac, ""anim_index"", ""?"")) + "" t:"" + string_format(variable_instance_get(ac, ""anim_timer"", 0), 5, 2));
        _y += _line;
    }
    var lv_count = instance_number(obj_lerpvar);
    var sd_count = instance_number(obj_script_delayed);
    if (lv_count > 0 || sd_count > 0)
    {
        draw_set_color(c_white);
        draw_text(_x, _y, ""Lerpvars:"" + string(lv_count) + ""  Delayed:"" + string(sd_count));
        _y += _line;
    }
    draw_set_color(c_gray);
    draw_text(_x, _y, ""Instances: "" + string(instance_count));
    if (variable_global_exists(""rb_debug_timer"") && global.rb_debug_timer > 0)
    {
        draw_set_halign(fa_center);
        draw_set_valign(fa_top);
        draw_set_font(fnt_main);
        var _rb_cx = display_get_gui_width() / 2;
        var _rb_cy = 40;
        draw_set_alpha(0.85);
        draw_set_color(c_black);
        draw_rectangle(_rb_cx - 110, _rb_cy - 6, _rb_cx + 110, _rb_cy + 50, false);
        draw_set_alpha(1);
        draw_set_color(global.rb_debug_color);
        draw_text(_rb_cx, _rb_cy, ""RUDE BUSTER: "" + string(global.rb_debug_text));
        draw_set_color(c_white);
        draw_text(_rb_cx, _rb_cy + 20, ""tier:"" + string(global.rb_debug_tier) + "" "" + string(global.rb_debug_chosen) + ""/"" + string(global.rb_debug_final));
        global.rb_debug_timer -= 1;
        draw_set_halign(fa_left);
        draw_set_valign(fa_top);
    }
    global.dbg_panel_h = _y + _line + 4;
    draw_set_color(c_white);
}
");

Apply("gml_GlobalScript_scr_act_charsprite", @"function scr_act_charsprite(arg0, arg1, arg2, arg3)
{
    _charactor = arg0;
    _charinstance = obj_herokris;
    if (_charactor == ""noelle"")
    {
        _charinstance = obj_heronoelle;
        _charnum = 4;
    }
    if (_charactor == ""ralsei"")
    {
        _charinstance = obj_heroralsei;
        _charnum = 3;
    }
    if (_charactor == ""susie"")
    {
        _charinstance = obj_herosusie;
        _charnum = 2;
    }
    if (_charactor == ""kris"")
    {
        _charinstance = obj_herokris;
        _charnum = 1;
    }
    __returnvalue = _charactsprite[_charnum];
    if (i_ex(_charinstance))
    {
        with (_charinstance)
        {
            image_alpha = 0;
            state = 0;
            global.faceaction[myself] = 0;
        }
        _charactsprite[_charnum] = scr_dark_marker(_charinstance.x, _charinstance.y, arg1);
        with (_charactsprite[_charnum])
        {
            depth = 20 - (__view_get(e__VW.YView, 0) / 40);
            scr_oflash();
            if (arg2 > 0 && arg3 == 0)
            {
                scr_animate(0, 0, arg2);
            }
            if (arg2 > 0 && arg3 == 1)
            {
                image_speed = arg2 / global.fps_scale;
            }
            a = scr_afterimage();
            a.hspeed = 2.5 / global.fps_scale;
            a.depth = depth + 1;
            b = scr_afterimage();
            b.image_alpha = 0.6;
            b.hspeed = 5 / global.fps_scale;
            b.depth = depth + 2;
        }
        __returnvalue = _charactsprite[_charnum];
    }
    return __returnvalue;
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_GlobalScript_scr_approach", @"function scr_approach(arg0, arg1, arg2)
{
    arg2 /= global.fps_scale;
    if (arg0 < arg1)
    {
        arg0 += arg2;
        if (arg0 > arg1)
        {
            return arg1;
        }
    }
    else
    {
        arg0 -= arg2;
        if (arg0 < arg1)
        {
            return arg1;
        }
    }
    return arg0;
}
");

Apply("gml_GlobalScript_scr_banish", @"function scr_banish(arg0 = id, arg1)
{
    with (instance_create_depth(0, 0, 0, obj_banish))
    {
        time = arg1;
        alarm[0] = round(arg1 * global.fps_scale);
        target = arg0;
        base = target.image_alpha;
        persistent = target.persistent;
    }
}
");

Apply("gml_GlobalScript_scr_battle", @"function scr_battle(arg0, arg1, arg2, arg3, arg4)
{
    global.specialbattle = arg1;
    global.encounterno = arg0;
    if (global.flag[9] != 2)
    {
        global.flag[9] = 1;
        if (global.chapter == 4 && room != room_dw_castle_dojo)
        {
            global.batmusic[0] = snd_init(""ch4_battle.ogg"");
        }
        else
        {
            global.batmusic[0] = snd_init(""battle.ogg"");
        }
    }
    instance_create(0, 0, obj_battleback);
    instance_create(0, 0, obj_encounterbasic);
    __enemymarker[0] = arg2;
    __enemymarker[1] = arg3;
    __enemymarker[2] = arg4;
    for (__ien = 0; __ien < 3; __ien++)
    {
        if (global.monstertype[__ien] != 0)
        {
            if (!i_ex(__enemymarker[__ien]))
            {
                __enemymarker[__ien] = scr_dark_marker(global.monstermakex[__ien] + 300, global.monstermakey[__ien], object_get_sprite(global.monsterinstancetype[__ien]));
                __enemymarker[__ien].depth = -__ien;
            }
            __enemymarker[__ien].__ien = __ien;
            with (__enemymarker[__ien])
            {
                scr_move_to_point_over_time(global.monstermakex[__ien], global.monstermakey[__ien], 20);
                __doom = instance_create(x, y, obj_doom);
                __doom.target = id;
                __doom.alarm[0] = round(25 * global.fps_scale);
            }
        }
    }
}
");

Apply("gml_GlobalScript_scr_battle_marker", @"function scr_battle_marker(arg0, arg1, arg2)
{
    thismarker = instance_create(arg0, arg1, obj_battle_marker);
    with (thismarker)
    {
        sprite_index = arg2;
        image_speed = 1 / global.fps_scale;
        image_xscale = 2;
        image_yscale = 2;
    }
    return thismarker;
}
");

