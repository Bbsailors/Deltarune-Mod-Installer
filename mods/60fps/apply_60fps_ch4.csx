            walktimer -= 40;
        }
        if (walktimer < 10)
        {
            image_index = 0;
        }
        if (walktimer >= 10)
        {
            image_index = 1;
        }
        if (walktimer >= 20)
        {
            image_index = 2;
        }
        if (walktimer >= 30)
        {
            image_index = 3;
        }
    }
    if (walkbuffer <= 0 && fun == 0 && climbing == 0)
    {
        if (walktimer < 10)
        {
            walktimer = 9.5;
        }
        if (walktimer >= 10 && walktimer < 20)
        {
            walktimer = 19.5;
        }
        if (walktimer >= 20 && walktimer < 30)
        {
            walktimer = 29.5;
        }
        if (walktimer >= 30)
        {
            walktimer = 39.5;
        }
        image_index = 0;
    }
    walkbuffer -= (0.75 / global.fps_scale);
}
