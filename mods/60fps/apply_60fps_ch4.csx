Apply("gml_Object_obj_titan_susiekris_jump_Step_0", @"repeat (updatespeed)
{
    x += (hsp / global.fps_scale);
    y += (vsp / global.fps_scale);
    vsp += (grav / global.fps_scale);
}
timer += (1 / global.fps_scale);
if (timer < 63)
{
    updatespeed = lerp(9, 1, timer / 63);
}
updatespeed = round(updatespeed);
");

Apply("gml_Object_obj_titan_throwkris_Draw_0", @"draw_self();
if (angledraw == 0)
{
    throwalpha = 0;
}
if (angledraw == 1)
{
    if (throwalpha < 1)
    {
        throwalpha += (0.125 / global.fps_scale);
    }
    draw_set_alpha(throwalpha);
    draw_set_color(merge_color(c_blue, c_white, 0.5));
    for (i = 0; i < 12; i += 1)
    {
        fr = 2;
        d_circle(kx + (lx * ((i * fr) + fro)), ky + (ly * ((i * fr) + fro)) + krisyoff[(i * fr) + fro], 4, 0);
        d_line_width(kx + (lx * ((i * fr) + fro)), ky + (ly * ((i * fr) + fro)) + krisyoff[(i * fr) + fro], kx + (lx * (((i + 1) * fr) + fro)), ky + (ly * (((i + 1) * fr) + fro)) + krisyoff[((i + 1) * fr) + fro], 2);
        draw_sprite_ext(spr_werewire_throwarrow, 0, kx, ky, 2, 2, angle, c_red, 1);
    }
    draw_set_alpha(1);
}
");

