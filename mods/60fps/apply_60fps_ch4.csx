        }
    }
    if (bounces < 2)
    {
        vspeed += (1 / (global.fps_scale * global.fps_scale));
    }
    if (y > ystart && bounces < 2 && killactive == 0)
    {
        y = ystart;
        vspeed = vstart / 2;
        bounces += 1;
    }
    if (bounces >= 2 && killactive == 0)
    {
        vspeed = 0;
        y = ystart;
    }
    if (stretchgo == 1)
