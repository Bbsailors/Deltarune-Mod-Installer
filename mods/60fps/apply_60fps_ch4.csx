        }
        var cup_block = instance_create(240, base_y + 340, obj_solidblockDark);
        with (cup_block)
        {
            image_xscale = 4;
        }
    }
}
");

Apply("gml_Object_obj_dw_churchc_finalclimb_Step_0", @"wobblex = 0;
if (wobble > 0)
{
