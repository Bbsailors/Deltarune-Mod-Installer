            instance_destroy();
        }
        if (facer == 1)
        {
            with (obj_face)
            {
                instance_destroy();
            }
        }
        instance_destroy();
    }
}
skipme = 0;
siner += (1 / global.fps_scale);
if (textalpha != 1)
{
    draw_set_alpha(1);
}
