                ra_hunch = scr_dark_marker(ra_actor.x + 2, ra_actor.y + 10, spr_ralsei_walk_hunched);
                with (ra_hunch)
                {
                    mask_index = spr_ralsei_right;
                    depth = other.ra_actor.depth;
                    offsetx = x - other.kr_actor.x;
                    offsety = y - other.kr_actor.y;
