                {
                    actconral = 0;
                }
            }
            actingral = 0;
            scr_mercyadd(myself, 4);
        }
    }
    if (actcon == 20 || actconsus == 20 || actconral == 20)
    {
        if (scr_terminate_writer())
        {
            actconsus = -1;
            actconral = -1;
            actcon = 1;
        }
    }
    if (actcon == 1 && !instance_exists(obj_writer))
    {
        scr_nextact();
    }
}
if (state == 3)
{
    scr_enemy_hurt();
}

