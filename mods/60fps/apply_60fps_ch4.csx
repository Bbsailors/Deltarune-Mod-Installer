    {
        speed = random_range(3, 7) / global.fps_scale;
        direction = 90 - (other.toggle * 90);
        depth = other.depth + 10;
        size = 80;
        image_xscale = size / 50;
        image_yscale = size / 50;
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        big = true;
    }
    _ball = instance_create(camerax() + 320 + ((spread + 100) * toggle), cameray() + 600, obj_make_fountain_ball_titan);
    with (_ball)
    {
        speed = random_range(3, 7) / global.fps_scale;
        direction = 90 - (other.toggle * 90);
        depth = other.depth + 10;
        size = 120;
        image_xscale = size / 50;
        image_yscale = size / 50;
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        big = true;
    }
    _ball = instance_create(camerax() + 320 + ((spread + 100) * toggle), cameray() + 600, obj_make_fountain_ball_titan);
    with (_ball)
    {
        speed = random_range(3, 7) / global.fps_scale;
        direction = 90 - (other.toggle * 90);
        depth = other.depth - 10;
        size = 120;
        image_xscale = size / 50;
        image_yscale = size / 50;
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        type = 2;
        big = true;
    }
    _ball = instance_create(camerax() + 320 + ((spread + 200) * toggle), cameray() + 600, obj_make_fountain_ball_titan);
    with (_ball)
    {
        speed = random_range(3, 7) / global.fps_scale;
        direction = 90 - (other.toggle * 90);
        depth = other.depth - 10;
        size = 240;
        image_xscale = size / 50;
        image_yscale = size / 50;
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        type = 2;
        big = true;
    }
    toggle = 0 - toggle;
}
with (obj_make_fountain_ball_titan)
{
    if (type == 1)
    {
        y -= ((other.fall_speed * 20) / global.fps_scale);
    }
    else if (type == 2)
    {
        y -= ((3 + (other.fall_speed * 10)) / global.fps_scale);
    }
    else
    {
        y -= ((2 + (other.fall_speed * 8)) / global.fps_scale);
    }
}
with (obj_darkness_trail)
{
