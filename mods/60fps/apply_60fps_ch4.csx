    {
        maxxscale = lerp(maxxscale, 2, scr_fps_lerp_rate(0.2));
        maxyscale = lerp(maxyscale, 2, scr_fps_lerp_rate(0.2));
        image_xscale = lerp(image_xscale, 2, scr_fps_lerp_rate(0.2));
        image_yscale = lerp(image_yscale, 2, scr_fps_lerp_rate(0.2));
