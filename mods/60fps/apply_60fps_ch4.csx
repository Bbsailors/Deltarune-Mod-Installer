{
    draw_sprite_ext(sprite_index, image_index, x + (xoff * i * dist), y + yoff + (i * dist), image_xscale + (scale * i), image_yscale + (scale * i), 0, c_white, ((0.7 + (sin(siner / 40) * 0.4)) - (0.1 * i)) * image_alpha);
}
gpu_set_blendmode(bm_normal);
");

