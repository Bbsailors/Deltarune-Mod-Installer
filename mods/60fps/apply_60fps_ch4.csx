    }
    else
    {
        damagecon = 3;
    }
}
if (damagecon == 3)
{
    timer += (1 / global.fps_scale);
    if (timer >= 8)
    {
        var animation = instance_create(x + 20, y + 20, obj_animation);
        animation.sprite_index = spr_attack_slap2;
        animation.image_blend = c_white;
        animation.image_speed = 0.5 / global.fps_scale;
