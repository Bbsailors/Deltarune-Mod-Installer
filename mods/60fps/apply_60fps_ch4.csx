        {
            with (obj_sumarker)
            {
                if (extflag == string(i))
                {
                    setxy(scr_even(x), scr_even(y));
                    array_push(other.spos, id);
                }
            }
        }
        for (var i = 0; i < array_length(spos); i++)
        {
            if (spos[i].extflag == string(global.flag[1560]))
            {
                ind = i + 1;
            }
