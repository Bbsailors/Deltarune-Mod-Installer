{
    global.hp[0] = 999;
    if (button1_p())
    {
        go = 1;
        global.myfight = -1;
        global.bmenuno = 0;
    }
    if (go)
    {
        timer += (1 / global.fps_scale);
    }
    if (timer >= 1)
    {
        global.mnfight = 2;
        global.myfight = -1;
        if (!instance_exists(obj_growtangle))
        {
            instance_create(__view_get(e__VW.XView, 0) + 320, __view_get(e__VW.YView, 0) + 170, obj_growtangle);
        }
        if (!instance_exists(obj_heart))
        {
            scr_moveheart();
        }
        for (i = 1; i < 5; i++)
        {
            global.hp[i] = global.maxhp[i];
        }
        timer = 0;
        go = 0;
    }
}
