        if (extflag == ""defender1"" && place_meeting(x, y, obj_mainchara))
        {
            trig = 1;
        }
    }
    if (trig == 1)
    {
        global.interact = 1;
        global.facing = 1;
        defendercon = 1;
        gentimer = 0;
    }
}
if (defendercon == 1)
{
    gentimer += (1 / global.fps_scale);
    if (gentimer == 1)
    {
        defender1 = scr_marker_ext(camerax() + 640 + 40, 446, spr_npc_cup_walk, -2, 2, 0.2);
        var targtime;
        with (defender1)
