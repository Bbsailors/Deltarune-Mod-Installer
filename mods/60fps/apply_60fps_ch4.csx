}
if (coughcon == 0 && !d_ex())
{
    global.interact = 1;
    coughcon = 1;
    is_coughing = true;
    snd_play(snd_rudycough);
    sprite_index = spr_rudy_cough;
    image_speed = 0.25 / global.fps_scale;
    alarm[0] = round(30 * global.fps_scale);
}
if (coughcon == 2 && !d_ex())
{
    coughcon = 3;
    sprite_index = spr_rudy_d;
    image_speed = 0;
}
if (coughcon == 3 && !d_ex())
{
    coughcon = -1;
    is_coughing = false;
