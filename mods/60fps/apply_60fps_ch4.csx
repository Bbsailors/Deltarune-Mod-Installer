        draw_sprite_ext(spr_rhythmgame_spotlight, 6, (x + camerawidth()) - (16 * image_xscale), _ystart - (50 * chart_ease), -image_xscale, image_yscale, image_angle, _col, 0.1);
        draw_set_blend_mode(bm_normal);
