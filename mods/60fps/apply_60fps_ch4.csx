        }
        if (whohealed == 4)
        {
            msgsetloc(0, ""* obj_multiboss_controller_enemy1's and obj_multiboss_controller_enemy2's HP went up!/%"", ""obj_musical_controller_slash_Step_0_gml_263_0"");
        }
        if (whohealed == 5)
