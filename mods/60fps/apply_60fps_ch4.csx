    te_actor = instance_create(camerax() + 720, cameray() + 237, obj_actor_tenna);
    scr_actor_setup(te, te_actor, ""tenna"");
    te_actor.sprite_index = spr_tenna_laugh_pose;
    te_actor.preset = -1;
    c_var_instance(kris_marker, ""visible"", 0);
    c_var_instance(susie_marker, ""visible"", 0);
    c_var_instance(ralsei_marker, ""visible"", 0);
    c_sel(kr);
