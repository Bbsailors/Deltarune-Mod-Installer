        state_init = true;
        spintimer = 0;
        current_sprite_index = spr_gerson_spin_smear;
        anim_speed = 0;
        anim_index = 0;
    }
    spintimer += (1 / global.fps_scale);
    if (spintimer < 10)
    {
        anim_index += ((2/3) / global.fps_scale);
    }
    if (spintimer == 10)
    {
        anim_index = 0;
        current_sprite_index = spr_gerson_spin;
        snd_play(snd_mercyadd);
    }
    if (spintimer >= 10)
    {
        if (anim_index < 11)
        {
            anim_index += (0.5 / global.fps_scale);
        }
        if (anim_index >= 11)
        {
            anim_index += (0.25 / global.fps_scale);
        }
        if (anim_index > 13)
        {
            anim_index = 13;
        }
    }
    if (spintimer == 50)
    {
        state_loaded = true;
    }
}
if (state == 19)
{
    if (!state_init)
    {
        state_init = true;
        anim_timer = 0;
        current_sprite_index = spr_gerson_smear_battle_ready;
        anim_speed = 0;
        anim_index = 1;
    }
    anim_timer += (1 / global.fps_scale);
    if (anim_timer == 4)
    {
        anim_index = 0;
    }
    if (anim_timer == 30)
    {
        state_loaded = true;
    }
}
if (state == 20)
{
    if (!state_init)
    {
        state_init = true;
        anim_timer = 0;
        current_sprite_index = spr_gerson_outfit_genki;
        anim_speed = 0;
        anim_index = 0;
    }
    anim_timer += (1 / global.fps_scale);
    if (anim_timer == 1)
    {
        scr_jump_to_point_sprite(x, y, 8, 8, 2205, 2205);
    }
    if (anim_timer == 14)
    {
        current_sprite_index = spr_gerson_outfit_walk_cane;
        anim_speed = 0;
        anim_index = 0;
        state_loaded = true;
    }
}
if (state == 21)
{
    if (!state_init)
    {
        state_init = true;
        writing_loop = false;
        current_sprite_index = spr_gerson_writing_look;
        anim_speed = 0;
        anim_index = 0;
        state_loaded = true;
    }
}
if (thinking_loop)
{
    thinking_timer += (1 / global.fps_scale);
    if (thinking_timer == 1)
    {
        current_state = 2;
    }
    if (thinking_timer == 70)
    {
        current_state = 3;
    }
    if (thinking_timer == 110)
    {
        thinking_timer = 0;
    }
}
if (writing_loop)
{
    writing_timer += (1 / global.fps_scale);
    if (writing_timer == 1)
    {
        current_state = 14;
    }
    if (writing_timer == 120)
    {
        current_state = 15;
    }
    if (writing_timer == 190)
    {
        current_state = 16;
    }
    if (writing_timer == 210)
    {
        writing_timer = 0;
    }
}
");

