Apply("gml_Object_obj_multiboss_enemy1_Draw_0", @"scr_enemy_drawhurt_generic();
if (custom_draw_example == 0)
{
    scr_enemy_drawidle_generic(0.16666666666666666);
}
else if (state == 0)
{
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
    }
    siner += (0.16666666666666666 / global.fps_scale);
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        draw_monster_body_part(sparedsprite, siner, x, y);
    }
    else
    {
        draw_monster_body_part(spr_diamondm_custom_body_example, 1, x + (sin(siner) * 2), y);
        draw_monster_body_part(spr_diamondm_custom_body_example, 0, x - (sin(siner) * 2), y + cos(siner));
    }
}
if (becomeflash == 0)
{
    flash = 0;
}
becomeflash = 0;
");

Apply("gml_Object_obj_multiboss_enemy1_Step_0", @"if (global.monster[myself] == 1)
{
    if (scr_isphase(""enemytalk"") && talked == 0 && !i_ex(obj_writer))
    {
        scr_randomtarget();
        myattackchoice = choose(0, 1);
