        var simultext;
        if (violenceused == 1)
        {
            simultext = stringsetloc(""* R-Action failed!/%"", ""obj_tasque_manager_enemy_slash_Step_0_gml_314_0"");
        }
        else
        {
            if (global.hp[0] <= 0 && global.hp[1] <= 0)
            {
                scr_mercyadd(myself, 10);
            }
            else
            {
                scr_mercyadd(myself, 6);
            }
            var a = choose(0, 1);
            if (a == 0)
