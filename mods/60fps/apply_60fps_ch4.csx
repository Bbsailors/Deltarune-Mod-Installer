    c_sel(su);
    var supos = scr_heromarker(""su"", ""1"");
    c_walkdirect(supos[0], supos[1], 20);
    c_sel(kr);
    var krpos = scr_heromarker(""kr"", ""1"");
    c_walkdirect(krpos[0], krpos[1], 20);
    c_sel(ra);
    var rapos = scr_heromarker(""ra"", ""1"");
    c_walkdirect(rapos[0], rapos[1], 20);
    c_wait(21);
    c_sel(kr);
    c_facing(""u"");
    c_sel(su);
    c_facing(""u"");
    c_sel(ra);
    c_facing(""u"");
