Apply("gml_Object_obj_darkshape_centipede_head_Create_0", @"event_inherited();
grazed = 1;
grazepoints = 0;
shrink_sprite = spr_darkshape_directed_head;
with (obj_darkshape_manager)
{
    basic_shapes = false;
}
destroyonhit = false;
float_timer = 0;
individuality = irandom(100);
shakeme = false;
