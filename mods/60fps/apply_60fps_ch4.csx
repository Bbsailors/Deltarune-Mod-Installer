            targ_y = ystart;
            speed = 5 / global.fps_scale;
            friction = 0.1 / (global.fps_scale * global.fps_scale);
            direction = point_direction(x, y, targ_x, targ_y);
        }
    }
}
if (completed_ticks < run_threshold)
{
    if (feared && alarm[0] == -1)
    {
        reset_timer += (1 / global.fps_scale);
        if (reset_timer > 90 || point_distance(x, y, targ_x, targ_y) < 15)
        {
            event_user(0);
            reset_timer = 0;
        }
        speed = (3 + log2(max(1, abs(ticks))) + completed_ticks) / global.fps_scale;
        direction = point_direction(x, y, targ_x, targ_y);
    }
    else if (alarm[0])
    {
        speed *= power(0.95, 1 / global.fps_scale);
        speed -= (0.125 / global.fps_scale);
    }
    else
    {
        speed = min(sqrt(max(0, timer - 30)), 4) / (1 + ticks + completed_ticks) / global.fps_scale;
        direction = scr_at_player(x, y);
    }
}
");

