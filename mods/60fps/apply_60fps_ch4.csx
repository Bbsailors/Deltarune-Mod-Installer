    if (acting == 1 && actcon == 0)
    {
        actcon = 1;
        msgsetloc(0, ""* WICABEL - A metal mage. When out of tune, she's unpredictabell./%"", ""obj_bell_enemy_slash_Step_0_gml_155_0"");
        scr_battletext_default();
    }
    if (acting == 2 && actcon == 0)
    {
        acting = 20.4;
