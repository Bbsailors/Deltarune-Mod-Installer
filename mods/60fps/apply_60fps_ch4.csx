        if (angel_mode)
        {
            shake = true;
        }
    }
    if (walkbuffer > 3 && fun == 0)
    {
        walktimer += (1.5 / global.fps_scale);
        if (runmove == 1 || (run == 1 && climbing == 1))
        {
            walktimer += (1.5 / global.fps_scale);
        }
        if (climbing == 1)
        {
            with (obj_rotating_tower_caterpillar)
            {
                index += (0.15 / global.fps_scale);
