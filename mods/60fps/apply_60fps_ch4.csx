Apply("gml_Object_obj_throwralsei_Step_0", @"if (throwcon == 1)
{
    if (throwready == 0)
    {
        angle += (anglespeed / global.fps_scale);
    }
    if (angle >= 30)
    {
        anglespeed = -2;
    }
    if (angle <= -15)
    {
        anglespeed = 2;
    }
    if (button3_p() && throwalpha >= 0.9 && throwready == 1)
    {
        activatethrow = 1;
        with (obj_writer)
        {
            instance_destroy();
        }
    }
    if (button3_p() && throwready == 0)
    {
        throwready = 1;
        with (obj_writer)
        {
            instance_destroy();
        }
        global.msg[0] = stringsetsubloc(""* Press ~1 to determine the POWER!"", scr_get_input_name(6), ""obj_throwralsei_slash_Step_0_gml_26_0"");
        scr_battletext_default();
    }
    if (activatethrow == 1)
    {
        activatethrow = 0;
        throwready = 0;
        image_index = 0;
        image_speed = 0.5 / global.fps_scale;
        sprite_index = spr_susieb_attack_unarmed;
