            {
                waittime = 18;
            }
            var chasespeedmax = 18;
            if (difficulty == 1)
            {
                chasespeedmax = 8;
            }
            timer += (1 / global.fps_scale);
            if (timer > waittime)
            {
                if (global.interact)
                {
