    {
        shadow.visible = 0;
    }
    else
    {
        shadow.visible = 1;
    }
    if (mazemode == 1)
    {
        shadow.visible = 0;
    }
    shadow.x = x;
    shadow.y = shadowy;
    shadow.sprite_index = spr_starwalker_wings;
    shadow.image_index = wing_index;
    if (attackcon == 1)
    {
        shadow.sprite_index = spr_starwalker_attack;
        shadow.image_index = 0;
        shadow.image_xscale = xmake;
    }
    if (attackcon == 2)
    {
        shadow.sprite_index = spr_starwalker_attack;
        shadow.image_index = 1;
        shadow.image_xscale = xmake;
    }
}
if (beatcon == 1)
{
    with (obj_mainchara)
    {
        battlemode = 0;
    }
    if (global.interact == 0)
    {
        global.interact = 1;
        beattimer = 0;
        beatcon = 2;
    }
}
if (beatcon == 2)
{
    beattimer += (1 / global.fps_scale);
    if (dead.x >= (__view_get(e__VW.XView, 0) + __view_get(e__VW.WView, 0)) && global.interact != 0)
    {
        with (dead)
        {
            instance_destroy();
        }
        global.interact = 0;
        beatcon = 3;
        instance_destroy();
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

