        piece_xoffset[4] = lerp(0, 10, transitiontimer / 5);
        piece_yoffset[3] -= 1 / global.fps_scale;
        piece_yoffset[4] -= 1 / global.fps_scale;
        if (transitiontimer == 5)
        {
            transitiontimer = 0;
            transitioncon = 1;
        }
    }
    if (transitioncon == 1)
    {
        transitiontimer += (1 / global.fps_scale);
