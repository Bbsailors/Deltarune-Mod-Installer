        alarm[1] = 1;
        room_speed = 1;
        motion_set(point_direction(x, y, xstart, ystart), speed + (16 / global.fps_scale));
        with (obj_mike_boundary)
        {
            instance_destroy();
        }
    }
    var num = 8;
