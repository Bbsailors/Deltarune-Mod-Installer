        }
        snd_play(snd_boost);
        global.faceaction[1] = 2;
        heartanim = instance_create(obj_herokris.x + 30, obj_herokris.y + 50, obj_animation);
        with (heartanim)
        {
            depth = -20;
            image_index = 0;
            image_xscale = 2;
            image_yscale = 2;
