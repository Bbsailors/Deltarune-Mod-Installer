{
    if (con == 0)
    {
        if (movecon == 0)
        {
            hspeed = -4 / global.fps_scale;
            sprite_index = lsprite;
        }
        if (movecon == 1)
        {
            hspeed = 4 / global.fps_scale;
            sprite_index = rsprite;
        }
        con = 1;
        contimer = 0;
        contimermax = 30;
        flipchance = choose(0, 1, 2);
        if (flipchance == 2)
        {
            sprite_index = choose(dsprite, spr_lancer_ut_flip);
            image_speed = 0.25 / global.fps_scale;
        }
    }
    if (con == 1)
    {
        stop = 0;
        contimer += (1 / global.fps_scale);
        if (x < minx)
        {
            stop = 1;
        }
        if (x > maxx)
        {
            stop = 1;
        }
        if (contimer > contimermax)
        {
            stop = 1;
        }
        if (stop == 1)
        {
            hspeed = 0;
            sprite_index = choose(dsprite, dsprite, spr_lancer_ut_flip);
            image_speed = 0.25 / global.fps_scale;
            alarm[0] = round(30 * global.fps_scale);
            con = 2;
        }
    }
}
if (movecon == 2 || movecon == 3)
{
    if (con == 0)
    {
        if (movecon == 3)
        {
            vspeed = -8 / global.fps_scale;
            gravity = 1 / (global.fps_scale * global.fps_scale);
            y -= 4;
            hspeed = random_range(-4, 4) / global.fps_scale;
        }
        spincount = 0;
        spintimer = 0;
        spinmax = 8;
        con = 1;
        sprite_index = dsprite;
    }
    if (con == 1)
    {
        if (y >= maxy)
        {
            gravity = 0;
            vspeed = 0;
        }
        if (x <= minx)
        {
            x += (4 / global.fps_scale);
            hspeed = -hspeed;
        }
        if (x >= maxx)
        {
            x -= (4 / global.fps_scale);
            hspeed = -hspeed;
        }
        spintimer += (1 / global.fps_scale);
        if (spintimer >= 3)
        {
            if (sprite_index == dsprite)
            {
                sprite_index = lsprite;
            }
            else if (sprite_index == lsprite)
            {
                sprite_index = usprite;
            }
            else if (sprite_index == usprite)
            {
                sprite_index = rsprite;
            }
            else if (sprite_index == rsprite)
            {
                sprite_index = dsprite;
            }
            spincount++;
            spintimer = 0;
        }
        if (spincount >= 8)
        {
            hspeed = 0;
            vspeed = 0;
            gravity = 0;
            con = 2;
            alarm[0] = round(30 * global.fps_scale);
        }
    }
