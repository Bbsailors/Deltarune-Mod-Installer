    var tempname = asset_get_index(""spr_dw_church_prophecy_"" + extflag);
    if (sprite_exists(tempname))
    {
        sprite_index = tempname;
    }
    if (extflag == ""knight2"")
    {
        sprite_index = spr_dw_church_prophecy_knight1;
    }
    scr_darksize();
    var _text = scr_prophecytext(extflag);
    with (prophecy_text)
    {
        initialize_text(_text, 0, 0);
    }
    var _icon = asset_get_index(""spr_dw_church_prophecy_"" + extflag + ""_icon"");
    if (sprite_exists(_icon))
    {
        if (extflag == ""knight2"")
        {
            _icon = 2480;
        }
        prophecy_icon.initialize_sprite(_icon);
    }
}
siner += (1 / global.fps_scale);
if (falltest && active && destroy == 0 && y < (cameray() + 240))
{
    destroy = 1;
}
if (destroy == 1)
{
    destroy = 2;
    var delaytime = 30;
    if (destroykind == 2)
    {
        delaytime = 10;
    }
    if (destroykind == 3)
    {
        delaytime = 5;
    }
    if (breakdelay != -1)
    {
        delaytime = breakdelay;
    }
    scr_delay_var(""destroy"", 3, delaytime);
    var type = destroykind;
    if (!nodestroysound)
    {
        var snd = snd_play_complex(0, 0, undefined);
        if (!nodestroysecondsound)
        {
            snd_add_complex(snd, 0, 236, 0.6, 0.4, (delaytime - 1) + 2, -1, 0);
            snd_add_complex(snd, 1, 390, 0.8, 0.5, (delaytime - 1) + 0, -1, 0);
            snd_add_complex(snd, 2, 390, 0.71, 0.5, (delaytime - 1) + 0, -1, 0);
            snd_add_complex(snd, 3, 269, 0.7, 0.95, (delaytime - 1) + 0, -1, 0);
        }
        if (destroykind != 3)
        {
            snd_add_complex(snd, 4, 321, 1, 0.95, 0, -1, 0);
        }
    }
    var _shattersprite = (type != 2) ? 5062 : 908;
    var count = sprite_get_number(_shattersprite);
    for (var i = 0; i < count; i++)
    {
        with (scr_marker_ext(x - 199, y - 120, _shattersprite, 2, 2, 0, i, c_white, depth))
        {
            if (type == 0)
            {
                depth = other.depth;
                if (depth < 5000)
                {
                    depth = 5000;
                }
                image_alpha = 0.8;
                speed = 2 / global.fps_scale;
                friction = 0.5 / (global.fps_scale * global.fps_scale);
                direction = random(360);
                scr_delay_var(""gravity"", (0.5 + random(0.1)) / (global.fps_scale * global.fps_scale), delaytime);
                scr_delay_var(""friction"", 0, delaytime);
                scr_delay_var(""speed"", 2 / global.fps_scale, delaytime);
                scr_doom(id, 120);
            }
            if (type == 1)
            {
                depth = other.depth;
                if (depth < 5000)
                {
                    depth = 5000;
                }
                image_alpha = 0.8;
                speed = 2 / global.fps_scale;
                friction = 0.5 / (global.fps_scale * global.fps_scale);
                direction = random(360);
                scr_doom(id, 120);
                scr_delay_var(""speed"", 4 / global.fps_scale, delaytime);
                scr_delay_var(""friction"", 0.4 / (global.fps_scale * global.fps_scale), delaytime);
                scr_script_delayed(scr_lerpvar, delaytime, ""image_alpha"", image_alpha, 0, 20);
            }
            if (type == 2)
            {
                depth = other.depth;
                image_alpha = 0.8;
                speed = 7 / global.fps_scale;
                friction = 0.75 / (global.fps_scale * global.fps_scale);
                direction = 270 + random_range(-3, 3);
                if (i == (count - 2) || i == (count - 4))
                {
                    hspeed = 0.5 / global.fps_scale;
                }
                if (i == (count - 1) || i == (count - 3))
                {
                    hspeed = -0.5 / global.fps_scale;
                }
                gravity_direction = 90;
                scr_delay_var(""gravity"", (0.25 + random(0.1)) / (global.fps_scale * global.fps_scale), delaytime);
                scr_delay_var(""friction"", 0, delaytime);
                scr_delay_var(""speed"", (2 + (((count - i) / count) * 15)) / global.fps_scale, delaytime);
                if (i > (count - 5) || (i % 2) == 0)
                {
                    scr_delay_var(""depth"", depth + 30, delaytime);
                }
            }
            if (type == 3)
            {
                depth = other.depth;
                if (depth < 5000)
                {
                    depth = 5000;
                }
                image_alpha = 0.3;
                speed = 0;
                friction = 0.5 / (global.fps_scale * global.fps_scale);
                direction = 270;
                var delay = (delaytime * random(5)) + 1;
                scr_delay_var(""gravity"", (0.5 + random(0.1)) / (global.fps_scale * global.fps_scale), delay);
                scr_delay_var(""friction"", 0, delay);
                scr_delay_var(""speed"", 2 / global.fps_scale, delay);
                scr_doom(id, 120);
            }
        }
    }
}
if (destroy == 3)
{
    if (nodestroysparkles == false)
    {
        var sparklecount = 30;
        for (var i = 0; i < sparklecount; i++)
        {
            with (instance_create((x - 199) + ((i * 398) / sparklecount) + random_range(-30, 30), y + random(120), obj_dw_church_prophecy_groundshards))
            {
                ytarg = other.y + 120 + 120;
                if (other.destroykind == 3)
                {
                    ytarg += 10000;
                    scr_doom(self, 280);
                }
            }
        }
    }
    if (destroykind < 2)
    {
        instance_destroy();
    }
    else
    {
        destroy = 4;
    }
}
if (destroy)
{
    image_alpha = -99;
}
");

