            {
                bp += round((bpy - bp) / 2.5);
            }
            else
            {
                bp += 30;
            }
        }
        else
        {
            bp = bpy;
        }
        if (bp == bpy)
        {
            intro = 0;
        }
    }
    if (intro == 2)
    {
        if (bp > 0)
        {
            if (round((bpy - bp) / 5) > 15)
            {
                bp -= round((bpy - bp) / 2.5);
            }
            else
            {
                bp -= 30;
            }
        }
        else
        {
            bp = 0;
        }
