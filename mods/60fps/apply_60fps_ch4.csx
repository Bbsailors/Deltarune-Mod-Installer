    c_msgnextloc(""\\E0* But..^1. something..^1. about her look was kinda..^1. weird./"", ""obj_lw_town_sideb_slash_Step_0_gml_93_0"");
    c_msgnextloc(""\\ED* ..^1. Why/"", ""obj_lw_town_sideb_slash_Step_0_gml_94_0"");
