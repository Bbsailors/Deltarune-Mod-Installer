    c_talk_wait();
    c_sel(ra);
    c_sprite(spr_ralsei_rock_1);
    c_sel(te);
    c_var_lerp_to_instance(te_actor, ""x"", 334, 10, 2, ""out"");
    c_speaker(""tenna"");
    c_msgsetloc(0, ""* Wow^1, looks like the band's already splitting up due to drama!/%"", ""obj_victory_rhythm_slash_Step_0_gml_35_0"");
    c_talk_wait();
    c_tenna_preset(21);
    c_speaker(""tenna"");
    c_msgsetloc(0, ""* That's how you know we've got a REAL winner on our hands^1, folks!/"", ""obj_victory_rhythm_slash_Step_0_gml_41_0"");
    c_msgnextloc(""* Anyway^1, BOARD'S OVER^1! So without further ado.../"", ""obj_victory_rhythm_slash_Step_0_gml_42_0"");
    c_msgnextloc(""* Let's see those RESULTS!!!/%"", ""obj_victory_rhythm_slash_Step_0_gml_43_0"");
    c_talk();
