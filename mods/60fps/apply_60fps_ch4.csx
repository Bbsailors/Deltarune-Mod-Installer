Apply("gml_Object_obj_darkshape_tension_glow_Draw_0", @"if (abs(apparent - global.tension) < 20)
{
    apparent = global.tension;
}
if (apparent < global.tension)
{
    apparent += (20 / global.fps_scale);
}
if (apparent > global.tension)
{
    apparent -= (20 / global.fps_scale);
}
alphamod = scr_approach(alphamod, 0, 0.15);
if (alphamod == 0)
{
    instance_destroy();
