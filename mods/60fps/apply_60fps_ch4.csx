cycle_length2 = 180;
timer = 0;
timer2 = 0;
basex = x;
basey = y;
grazed = 1;
doomed = false;
rate = 1;
base_rate = 1;
trail_length = 2;
for (var i = 1; i <= trail_length; i++)
{
    orb[i] = instance_create(x, y, obj_ghosthouse_dot);
    orb[i].float = -1;
}
grazed = true;
grazepoints = 0;
