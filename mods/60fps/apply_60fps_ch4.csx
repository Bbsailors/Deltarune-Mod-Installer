        draw_text_color(xx + txtspc + 1, yy + 1, numstringadd + string(num), c_dkgray, c_dkgray, c_navy, c_navy, 1);
    }
    draw_text(xx + txtspc, yy, numstringadd + string(num));
    draw_set_halign(fa_left);
}
draw_set_color(c_white);
");

Apply("gml_Object_obj_numberentry_Step_0", @"if (con == 0)
{
    if (down_h())
    {
        dholdbuff++;
    }
    else
    {
        dholdbuff = -1;
    }
    if (up_h())
    {
        uholdbuff++;
    }
    else
    {
        uholdbuff = -1;
    }
    if (up_h() && down_h())
    {
        dholdbuff = -1;
        uholdbuff = -1;
    }
    if (left_h())
    {
        lholdbuff++;
    }
    else
    {
        lholdbuff = -1;
    }
    if (right_h())
    {
        rholdbuff++;
    }
    else
    {
        rholdbuff = -1;
    }
    if (left_h() && right_h())
    {
        rholdbuff = -1;
        lholdbuff = -1;
    }
    var nummod = numinc;
    var uprate = 10;
    if (fasterovertime)
    {
        if (up_h() || down_h())
        {
            uspeedbuff++;
        }
        else
        {
            uspeedbuff = 0;
        }
        if (up_h() && down_h())
        {
            uspeedbuff = 0;
        }
        if (uspeedbuff == 0)
        {
            buffmodrate = buffmoddefault;
        }
        if (uspeedbuff > (uprate * 1 * global.fps_scale))
        {
            buffmodrate = 4;
        }
        if (uspeedbuff > (uprate * 2 * global.fps_scale))
        {
            buffmodrate = 3;
        }
        if (uspeedbuff > (uprate * 3 * global.fps_scale))
        {
            buffmodrate = 2;
        }
        if (uspeedbuff > (uprate * 4 * global.fps_scale))
        {
            buffmodrate = 1;
        }
        if (uspeedbuff > (uprate * 6 * global.fps_scale))
        {
            nummod = 5 * numinc;
        }
        if (uspeedbuff > (uprate * 10 * global.fps_scale))
        {
            nummod = 10 * numinc;
        }
        if (uspeedbuff > (uprate * 15 * global.fps_scale))
        {
            nummod = 100 * numinc;
        }
        if (uspeedbuff > (uprate * 20 * global.fps_scale))
        {
            nummod = 1000 * numinc;
        }
        if (nummod != 1 && roundval == true)
        {
            num = round(num / nummod) * nummod;
        }
    }
    var _repeat_period = max(1, round(buffmodrate * global.fps_scale));
    if (up_h() && (uholdbuff % _repeat_period) == 0)
    {
        if (num < maxnum)
        {
            snd_stop(snd_menumove);
            snd_play_pitch(snd_menumove, 1);
        }
        num += nummod;
    }
    else if (down_h() && (dholdbuff % _repeat_period) == 0)
    {
        if (num > minnum)
        {
            snd_stop(snd_menumove);
            snd_play_pitch(snd_menumove, 0.9);
        }
        num -= nummod;
    }
    var checkround = false;
    if (biginc != -1)
    {
        var _biginc_period = max(1, round(buffmodrate * global.fps_scale));
        if (right_h() && (rholdbuff % _biginc_period) == 0)
        {
            if (num < maxnum)
            {
                snd_stop(snd_menumove);
                snd_play_pitch(snd_menumove, 1);
            }
            num += biginc;
            checkround = false;
        }
        else if (left_h() && (lholdbuff % _biginc_period) == 0)
        {
            if (num > minnum)
            {
                snd_stop(snd_menumove);
                snd_play_pitch(snd_menumove, 0.9);
            }
            num -= biginc;
            checkround = false;
        }
        if (roundval == true && checkround)
        {
            num = round(num / biginc) * biginc;
        }
    }
    num = clamp(num, minnum, maxnum);
    if (button1_p())
    {
        snd_play_pitch(snd_menumove, 1.2);
        con = 1;
        result = num;
    }
    cancelbuffer--;
    if (cancelbuffer < 0 && button2_p())
    {
        con = 1;
        result = -2;
    }
}
if (con == 1)
{
    visible = false;
    con = 2;
    if (nokill == false)
    {
        scr_doom(id, 1000);
    }
}
");

Apply("gml_Object_obj_ob_checkertile_Step_0", @"if (global.interact == 0)
{
    timer += (1 / global.fps_scale);
}
if (timer >= 0 && timer <= 10)
{
    image_alpha = timer / 10;
}
if (timer == 10)
{
    active = 1;
}
if (timer >= 20)
{
    image_alpha = 3 - (timer / 10);
    active = 0;
    if (image_alpha <= 0)
    {
        if (room == room_field_checkers1)
        {
            x -= (80 / global.fps_scale);
        }
        if (room == room_field_checkers4)
        {
            x -= (40 / global.fps_scale);
            y += (40 / global.fps_scale);
            if (y >= 350)
            {
                y = 240;
                x += (120 / global.fps_scale);
            }
        }
        if (room == room_field_checkers6)
        {
            x -= (40 / global.fps_scale);
            y += (40 / global.fps_scale);
            if (y >= 310)
            {
                y = 240;
                x += (80 / global.fps_scale);
            }
        }
        timer = -10;
        if (room == room_field_checkers6)
        {
            timer = -6;
        }
        if (room == room_field_checkers4)
        {
            timer = -4;
        }
        image_alpha = 0;
    }
}
if (x < 500)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_ob_gen_Draw_0", @"if (obj_mainchara.battlemode == 1)
{
    if (battlealpha < 0.8)
    {
        battlealpha += (0.04 / global.fps_scale);
    }
}
else if (battlealpha > 0)
{
    battlealpha -= (0.04 / global.fps_scale);
}
draw_set_alpha(battlealpha);
draw_set_color(c_black);
ossafe_fill_rectangle(__view_get(e__VW.XView, 0) - 100, __view_get(e__VW.YView, 0) - 100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
draw_set_alpha(1);
if (instance_exists(obj_caterpillarchara))
{
    obj_caterpillarchara.image_blend = merge_color(c_white, c_black, battlealpha / 2);
    if (battlealpha <= 0)
    {
        obj_caterpillarchara.image_blend = c_white;
    }
}
if (whitecon == 1)
{
    with (obj_mainchara)
    {
        battlemode = 0;
    }
    whitetimer += (1 / global.fps_scale);
    draw_set_alpha(whitetimer / 15);
    draw_set_color(c_white);
    ossafe_fill_rectangle(-100, -100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
    draw_set_alpha(1);
}
if (whitecon == 2)
{
    whitetimer -= (1 / global.fps_scale);
    draw_set_alpha(whitetimer / 15);
    draw_set_color(c_white);
    ossafe_fill_rectangle(-100, -100, __view_get(e__VW.XView, 0) + 740, __view_get(e__VW.YView, 0) + 540, false);
    draw_set_alpha(1);
    if (whitetimer <= 0)
    {
        global.interact = 0;
        whitecon = 0;
        whitetimer = 0;
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

