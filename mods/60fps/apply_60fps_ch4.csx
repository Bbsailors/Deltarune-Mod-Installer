        if (sprite_index == spr_npc_catti_dad_diner)
        {
            if (talked == 0)
            {
                scr_speaker(""no_name"");
                msgsetloc(0, ""* Our little Catti^1, she's doin' us proud./"", ""obj_npc_room_slash_Other_10_gml_595_0"");
