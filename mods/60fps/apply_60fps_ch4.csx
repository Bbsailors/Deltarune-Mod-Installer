            TWOBUFFER = 1;
            MENU_NO = 5;
            SELNOISE = 1;
        }
        if (MENUCOORD[M] == 5)
        {
            MENUCOORD[10] = 0;
            ONEBUFFER = 1;
            TWOBUFFER = 1;
            MENU_NO = 10;
            SELNOISE = 1;
        }
        if (MENUCOORD[M] == 6)
        {
            SELNOISE = 1;
            scr_change_language();
            scr_84_load_ini();
        }
        if (MENUCOORD[M] == 7)
        {
            input_enabled = false;
            SELNOISE = 1;
            snd_free_all();
            alarm[0] = round(30 * global.fps_scale);
        }
        if (MENUCOORD[M] == 8 && CANQUIT)
        {
            SELNOISE = 1;
            ossafe_game_end();
        }
    }
    if (button2_p() && TWOBUFFER < 0)
    {
