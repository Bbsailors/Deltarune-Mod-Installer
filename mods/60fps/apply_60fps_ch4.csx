    vspeed = choose(-1, -1, 0, 0, 0, 0, 0, 0, -2) / global.fps_scale;
    scr_lerp_imageblend(id, c_white, c_black, endtime);
    scr_doom(id, endtime);
}
");

Apply("gml_Object_obj_dw_churchc_finalclimb_Create_0", @"con = -1;
customcon = 0;
