    {
        scr_speaker(""no_name"");
        msgsetloc(0, ""* Huh-hah^1! Let's feel my technique!/%"", ""obj_npc_hammerguy_slash_Step_0_gml_216_0"");
        d_make();
    }
    else if (times_fused >= 2)
    {
        scr_speaker(""no_name"");
        msgsetloc(0, ""* Let's pick up the pace./%"", ""obj_npc_hammerguy_slash_Step_0_gml_221_0"");
        d_make();
