    if (abs(HEARTDIFF) > 60)
    {
        DRAWHEART = 0;
    }
    HEARTX += HEARTDIFF;
    if (DRAWHEART == 0)
    {
        HEARTX = IDEALX;
        DRAWHEART = 1;
    }
    HEARTDIFF = (IDEALY - HEARTY) * scr_fps_lerp_rate(0.5);
