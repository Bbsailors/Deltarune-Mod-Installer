            snd_stop(snd_damage);
            snd_stop(snd_queen_punched_lower_heavy);
            snd_play(snd_damage);
            snd_play(snd_queen_punched_lower_heavy);
            scr_shakescreen();
            with (obj_shake)
            {
                shakex = 4;
                shakey = 4;
            }
        }
        if (sprite_index == spr_rudebuster_beam_green)
        {
            with (obj_titan_enemy)
            {
                if (drawstate != ""crack"")
                {
                    var delaytime = 2;
                    var snd = snd_play_complex(0, 0, undefined);
                    snd_add_complex(snd, 0, 236, 0.6, 0.4, (delaytime - 1) + 2, -1, 0);
                    snd_add_complex(snd, 1, 390, 0.8, 0.5, (delaytime - 1) + 0, -1, 0);
                    snd_add_complex(snd, 2, 390, 0.71, 0.5, (delaytime - 1) + 0, -1, 0);
                    snd_add_complex(snd, 3, 269, 0.7, 0.95, (delaytime - 1) + 0, -1, 0);
                    drawstate = ""crack"";
                    redflashtimer = 10;
                    var _x = camerax() + 500;
                    var _y = cameray() + 300;
                    var __x = (camerastartx + camerawidth()) - 494;
                    var __y = camerastarty - 88;
                    var _a = 0;
                    repeat (6)
                    {
                        mark = instance_create(__x, __y, obj_marker);
                        mark.sprite_index = spr_titan_star_break;
                        mark.image_blend = c_white;
                        mark.image_speed = 0;
                        mark.image_index = 1 + _a;
                        mark.image_xscale = 2;
                        mark.image_yscale = 2;
                        mark.gravity = 1 / (global.fps_scale * global.fps_scale);
                        mark.gravity_direction = 270;
                        mark.vspeed = (-4 - random(18)) / global.fps_scale;
                        mark.hspeed = (-6 + random(12)) / global.fps_scale;
                        mark.depth = 10;
                        _a++;
                    }
                    repeat (30)
                    {
                        mark = instance_create((_x - 40) + random(80), (_y - 40) + random(80), obj_marker);
                        mark.sprite_index = spr_gerson_item_throw;
                        mark.image_blend = merge_color(c_white, c_black, 0.3);
                        mark.image_speed = 0;
                        mark.image_index = 3;
                        mark.gravity = 1 / (global.fps_scale * global.fps_scale);
                        mark.gravity_direction = 270;
                        mark.vspeed = (-4 - random(18)) / global.fps_scale;
                        mark.hspeed = (-6 + random(12)) / global.fps_scale;
                        mark.depth = 10;
                    }
                }
            }
        }
    }
}
if (explode == 1)
{
    if (t == 1)
    {
        bonus_anim = 0;
        if (chosen_bolt > 0)
        {
            var _diff = final_bolt - chosen_bolt;
            var _tier = floor(_diff / global.fps_scale);
            if (_tier <= 0)
            {
                damage += 30;
            }
            else if (_tier == 1)
            {
                damage += 28;
            }
            else if (_tier == 2)
            {
                damage += 22;
            }
            else if (_tier == 3)
            {
                damage += 20;
            }
            else if (_tier == 4)
            {
                damage += 13;
            }
            else if (_tier == 5)
            {
                damage += 11;
            }
            else if (_tier == 6)
            {
                damage += 10;
            }
            if (_tier <= 2)
            {
                bonus_anim = 1;
                snd_play(snd_scytheburst);
            }
        }
        if (variable_global_exists(""fps_debug"") && global.fps_debug == 1)
        {
            var _rb_debug_final = bolt_timer;
            if (chosen_bolt > 0)
            {
                var _rb_debug_diff = _rb_debug_final - chosen_bolt;
                var _rb_debug_tier = floor(_rb_debug_diff / global.fps_scale);
                if (_rb_debug_tier <= 0)
                {
                    global.rb_debug_text = ""PERFECT"";
                    global.rb_debug_color = 65535;
                }
                else if (_rb_debug_tier <= 2)
                {
                    global.rb_debug_text = ""SUCCESSFUL"";
                    global.rb_debug_color = 65280;
                }
                else if (_rb_debug_tier <= 6)
                {
                    global.rb_debug_text = ""CLOSE"";
                    global.rb_debug_color = 16776960;
                }
                else
                {
                    global.rb_debug_text = ""TOO EARLY"";
                    global.rb_debug_color = 255;
                }
                global.rb_debug_tier = _rb_debug_tier;
                global.rb_debug_chosen = chosen_bolt;
                global.rb_debug_final = _rb_debug_final;
            }
            else
            {
                global.rb_debug_text = ""TOO LATE"";
                global.rb_debug_color = 255;
                global.rb_debug_tier = -1;
                global.rb_debug_chosen = chosen_bolt;
                global.rb_debug_final = _rb_debug_final;
            }
            global.rb_debug_timer = room_speed;
        }
        if (red == 1)
        {
            damage += 90;
        }
        if (battlemode == 1)
        {
            global.hittarget[star] = 0;
            if (i_ex(obj_titan_enemy))
            {
            }
            scr_damage_enemy(star, damage);
            if (sprite_index == spr_rudebuster_beam_green)
            {
                dm.type = 1.5;
                dm.ystart -= 30;
            }
            if (global.monstertype[0] != 20 && !i_ex(obj_hammer_of_justice_enemy))
            {
                with (target)
                {
                    __of = scr_oflash();
                }
                if (red == 1)
                {
                    with (target)
                    {
                        __of.flashcolor = c_red;
                    }
                }
            }
        }
        else
        {
            with (target)
            {
                __of = scr_oflash();
            }
            if (red == 1)
            {
                with (target)
                {
                    __of.flashcolor = c_red;
                }
            }
        }
        snd_stop(snd_rudebuster_hit);
        snd_play(snd_rudebuster_hit);
        for (i = 0; i < 4; i += 1)
        {
            burst[i] = scr_afterimage();
            burst[i].image_speed = 0.5 / global.fps_scale;
            burst[i].x = cx;
            burst[i].y = cy;
            burst[i].image_angle = 45 + (i * 90);
            burst[i].direction = burst[i].image_angle;
            burst[i].speed = 25 / global.fps_scale;
            if (bonus_anim == 1)
            {
                burst[i].speed = 40 / global.fps_scale;
            }
            burst[i].depth = depth - 10;
        }
        for (i = 4; i < 8; i += 1)
        {
            burst[i] = scr_afterimage();
            burst[i].image_speed = 0.5 / global.fps_scale;
            burst[i].x = cx;
            burst[i].y = cy;
            burst[i].image_angle = 45 + (i * 90);
            burst[i].direction = burst[i].image_angle;
            burst[i].speed = 25 / global.fps_scale;
            if (bonus_anim == 1)
            {
                burst[i].speed = 40 / global.fps_scale;
            }
            burst[i].depth = depth - 10;
        }
    }
    if (t >= 2)
    {
        for (i = 0; i < 4; i += 1)
        {
            with (burst[i])
            {
                speed *= power(0.75, 1 / global.fps_scale);
                image_xscale *= power(0.8, 1 / global.fps_scale);
            }
        }
        for (i = 4; i < 8; i += 1)
        {
            with (burst[i])
            {
                speed *= power(0.8, 1 / global.fps_scale);
                image_xscale *= power(0.8, 1 / global.fps_scale);
            }
        }
    }
    if (t >= 18)
    {
        instance_destroy();
    }
}
if (explode == 0 && speed != 0 && frac(t) == 0)
{
    aft[maxaft] = scr_afterimage();
    aft[maxaft].image_yscale = 1.8;
    aft[maxaft].image_angle = image_angle;
    aft[maxaft].image_index = 4;
    aft[maxaft].image_speed = 0.5 / global.fps_scale;
    aft[maxaft].image_alpha = image_alpha - 0.2;
    if (i_ex(obj_hammer_of_justice_enemy) && obj_hammer_of_justice_enemy.rudebusterhitcount == obj_hammer_of_justice_enemy.rudebusterhitcountmax)
    {
        aft[maxaft].fadeSpeed = 0.08;
    }
    maxaft += 1;
}
for (i = 0; i < maxaft; i += 1)
{
    with (aft[i])
    {
        image_yscale -= (0.1 / global.fps_scale);
        if (image_yscale <= 0.1)
        {
            instance_destroy();
        }
    }
    if (explode == 1)
    {
        with (aft[i])
        {
            image_alpha -= (0.07 / global.fps_scale);
            image_yscale *= power(0.9, 1 / global.fps_scale);
            if (image_yscale <= 0.1)
            {
                instance_destroy();
            }
        }
    }
}
a += 1;
t += (1 / global.fps_scale);
");

