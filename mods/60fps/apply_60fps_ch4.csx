                    difficulty = 3;
                }
                else if (_failures == 4)
                {
                    difficulty = 2;
                }
                else if (_failures >= 5)
                {
                    difficulty = 1;
                }
            }
        }
        if (v_ex(""musicm""))
        {
            musicm.track1_instance = track1_main;
        }
    }
}
