{
    shakex = -10 + random(20);
    shakey = -10 + random(20);
}
var xx = x + shakex;
var yy = y + shakey;
d_line(xx + sidelength, (yy - sidelength) + progress, xx + sidelength, (yy + sidelength) - progress);
d_line((xx - sidelength) + progress, yy - sidelength, (xx + sidelength) - progress, yy - sidelength);
d_line(xx - sidelength, (yy - sidelength) + progress, xx - sidelength, (yy + sidelength) - progress);
d_line((xx - sidelength) + progress, yy + sidelength, (xx + sidelength) - progress, yy + sidelength);
