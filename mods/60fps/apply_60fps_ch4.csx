Apply("gml_Object_obj_multiboss_controller_enemy1_Draw_0", @"scr_enemy_drawhurt_generic();
if (custom_draw_example == 0)
{
    scr_enemy_drawidle_generic(0.16666666666666666);
}
else if (state == 0)
{
    if (flash == 1)
    {
        fsiner += (1 / global.fps_scale);
    }
    siner += (0.16666666666666666 / global.fps_scale);
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        draw_monster_body_part(sparedsprite, siner, x, y);
    }
    else
