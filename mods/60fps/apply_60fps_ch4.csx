        anim_speed = 0.1;
        anim_index = 0;
        state_loaded = true;
    }
}
if (state == 4)
{
    if (!state_init)
    {
        state_init = true;
        state_loaded = true;
        thinking_loop = true;
        thinking_timer = 0;
    }
}
if (state == 5)
{
