        scr_speaker(""tenna"");
        msgsetloc(0, ""* But don't worry. I^1, your loving agent^1, have booked you ANOTHER show!!/"", ""obj_gameover_band_slash_Step_0_gml_88_0"");
        msgnextloc(""* It starts in.../%"", ""obj_gameover_band_slash_Step_0_gml_89_0"");
