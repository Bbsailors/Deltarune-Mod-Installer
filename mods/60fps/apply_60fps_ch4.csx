    draw_sprite_ext(spr_spearblocker, 2, x + shakex, y + shakey, image_xscale, image_yscale, image_angle, c_white, fadealpha);
    d3d_set_fog(false, c_black, 0, 0);
    fadealpha -= (0.05 / global.fps_scale);
}
