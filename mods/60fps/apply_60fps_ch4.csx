            sprite_index = spr_incense_sparkle;
            scr_lerpvar(""image_alpha"", 2, 0, 20 + ceil(speed / 3));
            friction = speed / (24 + speed) / (global.fps_scale * global.fps_scale);
            image_xscale = 0.5;
            image_yscale = 0.5;
            image_speed = 0.1 / global.fps_scale;
        }
    }
}
