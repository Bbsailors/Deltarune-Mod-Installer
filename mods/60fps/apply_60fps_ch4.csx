    c_sprite(spr_ralsei_rock_1);
    c_setxy(486, 304);
    c_autodepth(0);
    c_depth(97020);
    c_sel(te);
    c_autodepth(0);
    c_depth(97500);
    c_mus2(""initloop"", ""berdly_audience.ogg"", 0);
    c_var_instance(audience_cheer, ""audience_show"", true);
    c_var_instance(audience_cheer, ""rose_throw"", true);
    c_wait(30);
    c_sel(ra);
    c_sprite(spr_ralsei_rock_pose);
    c_speaker(""ralsei"");
    c_msgsetloc(0, ""\\EH* Wow^1, they loved it^1! I'm starting to feel like a real rocker!/"", ""obj_victory_rhythm_slash_Step_0_gml_20_0"");
    c_facenext(""susie"", ""9"");
    c_msgnextloc(""\\E9* Yeah^1, that was sick^1! Though^1, uh.../"", ""obj_victory_rhythm_slash_Step_0_gml_22_0"");
    c_msgnextloc(""\\EL* Lucky I was carrying you guys. We barely passed./%"", ""obj_victory_rhythm_slash_Step_0_gml_23_0"");
    c_talk();
    c_wait_box(2);
    c_sel(su);
    c_sprite(spr_susie_drum_ready);
    c_wait_box(3);
    c_sel(su);
    c_sprite(spr_susie_drum);
    c_sel(ra);
    c_sprite(spr_ralsei_rock_surprise);
