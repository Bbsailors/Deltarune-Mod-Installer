        animation.image_yscale = 3;
        if (i_ex(obj_rotating_tower_controller_new))
        {
            animation.x = obj_rotating_tower_controller_new.tower_x;
            animation.y = obj_rotating_tower_controller_new.krisy;
        }
        with (animation)
