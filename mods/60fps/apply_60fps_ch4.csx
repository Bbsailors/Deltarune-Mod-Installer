    {
        if (chaseenemy.donebattle == false)
        {
            if (scr_trigcheck(""enemygoaway""))
            {
                with (chaseenemy)
                {
                    with (scr_afterimage())
                    {
                        gravity = -0.5 / (global.fps_scale * global.fps_scale);
                    }
                    instance_destroy();
                }
                econ = 0;
