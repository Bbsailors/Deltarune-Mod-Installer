                instance_destroy(paper_marker);
            }
            snd_play_pitch(snd_wing, 1.2);
            paper_marker = scr_dark_marker(x + 14, y + 46, spr_gerson_paper_fall);
            with (paper_marker)
            {
                vspeed = 6 / global.fps_scale;
                scr_var_delay(""sprite_index"", spr_gerson_paper_floor, 6);
                scr_var_delay(""vspeed"", 0, 4);
                scr_var_delay(""hspeed"", -6 / global.fps_scale, 3);
                scr_var_delay(""friction"", 1 / (global.fps_scale * global.fps_scale), 8);
            }
        }
    }
    if (paper_con == 1)
    {
        paper_timer += (1 / global.fps_scale);
        if (paper_timer == 1)
        {
            current_sprite_index = spr_gerson_hand_up_look_down;
            anim_index = 0;
        }
        if (paper_timer == 10)
        {
            current_sprite_index = spr_gerson_reach_down;
            anim_index = 0;
        }
        if (paper_timer == 14)
        {
            anim_index = 1;
        }
    }
}
if (state == 14)
{
