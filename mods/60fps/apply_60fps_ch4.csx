    event_user(0);
    msgsetloc(0, ""THIS IS YOUR NAME."", ""DEVICE_NAMER_slash_Draw_0_gml_84_0"");
    if (global.lang == ""ja"")
    {
        JA_XOFF = -30;
    }
    W = instance_create(78 + JA_XOFF, 20 + JA_YOFF, obj_writer);
    with (W)
    {
        hspace *= 0.8;
        skipme = 1;
    }
    DRAWNAME = 1;
    FIXY = 0;
    EVENT = 74;
    global.choice = -1;
    CHOICE = instance_create(100, 100, DEVICE_CHOICE);
    CHOICE.depth = -100;
}
if (EVENT == 74)
{
    if (FIXY < 100)
    {
        FIXY += (2 / global.fps_scale);
    }
    if (global.choice == 0)
    {
        CANCELMENU = 1;
    }
    if (global.choice == 1)
    {
        snd_free_all();
        snd_play(snd_dtrans_lw);
        fade = scr_fadeout(80);
        fade.depth = -1;
        fade.image_blend = c_white;
        EVENT = 75;
        TIMER = 0;
    }
}
if (CANCELMENU == 1)
{
    if (EVENT == 74)
    {
        DRAWNAME = 0;
        EVENT = 70;
        with (DEVICE_MENU)
        {
            ONEBUFFER = 3;
            TWOBUFFER = 3;
        }
        safe_delete(obj_writer);
        safe_delete(DEVICE_CHOICE);
    }
    else
    {
        DRAWNAME = 0;
        with (DEVICE_MENU)
        {
            MENU_NO = 0;
            ONEBUFFER = 3;
            TWOBUFFER = 3;
        }
        with (obj_writer)
        {
            instance_destroy();
        }
        instance_destroy();
        exit;
    }
}
if (EVENT == 75)
{
    TIMER += (1 / global.fps_scale);
    if (TIMER >= 130)
    {
        EVENT = 76;
    }
}
if (EVENT == 76)
{
    global.flag[20] = 0;
    global.plot = 0;
    scr_initialize_charnames();
    room_goto(room_cc_fountain);
}
if (DRAWNAME)
{
    scr_84_set_draw_font(""main"");
    draw_set_color(c_white);
    draw_set_halign(fa_center);
    draw_text_transformed(camerax() + 160, cameray() + 40 + (FIXY / 2), global.truename, 1 + (FIXY / 100), 1 + (FIXY / 100), 1 + random(4));
    draw_set_halign(fa_left);
}
if (scr_debug() && sunkus_kb_check_pressed(82))
{
    room_restart();
}
");

