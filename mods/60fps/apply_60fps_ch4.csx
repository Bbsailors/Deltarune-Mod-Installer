            on *= -1;
            if (shakexamt < 0)
            {
                shakexamt = 0;
            }
            if (shakeyamt < 0)
            {
                shakeyamt = 0;
            }
            target.x = nowx + (shakexamt * on);
            target.y = nowy + (shakeyamt * on);
            if (shakexamt <= 0 && shakeyamt <= 0)
