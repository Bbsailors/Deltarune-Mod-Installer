                msgnextloc(""* Servin' us pickles^1, terrifyin' us with their shape^1,/"", ""obj_npc_room_slash_Other_10_gml_597_0"");
                msgnextloc(""* Tryin' to get us to leave./"", ""obj_npc_room_slash_Other_10_gml_598_0"");
