{
    if (window_get_width() == 1280)
    {
        window_set_size(640, 480);
    }
    else
    {
        window_set_size(1280, 960);
    }
}
if (keyboard_check_pressed(ord(""1"")))
{
    if (global.monster[0] == 0)
    {
        global.monster[0] = 1;
    }
    else if (scr_monsterpop() > 1)
    {
        global.monster[0] = 0;
    }
}
if (keyboard_check_pressed(ord(""2"")))
{
    if (global.monster[1] == 0)
    {
        global.monster[1] = 1;
    }
    else if (scr_monsterpop() > 1)
    {
