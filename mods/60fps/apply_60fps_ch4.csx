    length = string_length(pattern[choice]);
}
if (timer <= 0 && index < length)
{
    var _bullet = instance_create(x, y, obj_darkness_sound_bullet);
    _bullet.dir = real(string_char_at(pattern[choice], index + 1));
    _bullet.delay = delay * 2;
