        }
        if (sprite_index == spr_npc_wrapmouse)
        {
            if (talked == 0)
            {
                scr_speaker(""no_name"");
                msgsetloc(0, ""* Kris? Remember me...? Sorry if I was too strict when I babysat you and Noelle./"", ""obj_npc_room_slash_Other_10_gml_881_0"");
