    {
        savedir = direction;
        savex = x;
        savey = y;
        type = choose(0, 1);
    }
    if (image_angle == 0)
    {
        if (type == 1)
        {
            y = lerp(savey + fadespeardist, savey, fadespeartimer / fadespeartimermax);
