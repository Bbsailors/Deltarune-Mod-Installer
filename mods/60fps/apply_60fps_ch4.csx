        {
            if (shakex > 0)
            {
                shakex -= (1 / global.fps_scale);
            }
            if (shakex < 0)
            {
                shakex += (1 / global.fps_scale);
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(spr_clubs_hurt, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
    }
}
if (state == 0)
{
