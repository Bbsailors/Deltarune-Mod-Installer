        {
            run = 0;
        }
        else
        {
            run = 1;
        }
    }
    else if (button2_h() && twobuffer < 0)
    {
        run = 1;
    }
    else
    {
        run = 0;
    }
    if (autorun > 0)
    {
        if (autorun == 1)
        {
            run = 1;
            runtimer = 200;
        }
        if (autorun == 2)
        {
            run = 1;
            runtimer = 50;
        }
    }
    if (run == 1)
    {
        if (darkmode == 0)
        {
            wspeed = bwspeed + (1 / global.fps_scale);
            if (runtimer > 10)
            {
                wspeed = bwspeed + (2 / global.fps_scale);
            }
            if (runtimer > 60)
            {
                wspeed = bwspeed + (3 / global.fps_scale);
            }
        }
        if (darkmode == 1)
        {
            wspeed = bwspeed + (2 / global.fps_scale);
            if (runtimer > 10)
            {
                wspeed = bwspeed + (4 / global.fps_scale);
            }
            if (runtimer > 60)
            {
                wspeed = bwspeed + (5 / global.fps_scale);
            }
        }
    }
    if (run == 0)
    {
        wspeed = bwspeed;
    }
    if (climbing == 1)
    {
        wspeed = ceil(wspeed * global.fps_scale * 0.7) / global.fps_scale;
    }
    var slowwalker = instance_place(x, y, obj_slowwalk);
    if (instance_exists(slowwalker))
    {
        run = 0;
        wspeed = clamp(wspeed, 0, slowwalker.maxwalkspeed / global.fps_scale);
    }
    if (global.chapter == 4)
    {
        if (global.darkzone == 0 && global.plot >= 290)
        {
            wspeed = ceil(wspeed * global.fps_scale * 0.6) / global.fps_scale;
        }
    }
    if (left_h())
    {
        press_l = 1;
    }
    if (right_h())
    {
        press_r = 1;
    }
    if (up_h())
    {
        press_u = 1;
    }
    if (down_h())
    {
        press_d = 1;
    }
    px = 0;
    py = 0;
    pressdir = -1;
    if (global.stick_mag > 0 && global.flag[960] >= 1)
    {
        var _maxc = max(abs(global.stick_lx), abs(global.stick_ly));
        if (global.flag[960] == 1)
        {
            px = (global.stick_lx / _maxc) * global.stick_mag * wspeed;
            py = (global.stick_ly / _maxc) * global.stick_mag * wspeed;
        }
        else
        {
            px = (global.stick_lx / _maxc) * wspeed;
            py = (global.stick_ly / _maxc) * wspeed;
        }
        if (abs(global.stick_lx) >= abs(global.stick_ly))
        {
            if (global.stick_lx > 0)
            {
                pressdir = 1;
            }
            else
            {
                pressdir = 3;
            }
        }
        else if (global.stick_ly > 0)
        {
            pressdir = 0;
        }
        else
        {
            pressdir = 2;
        }
    }
    else
    {
        if (press_r == 1)
        {
            px = wspeed;
            pressdir = 1;
        }
        if (press_l == 1)
        {
            px = -wspeed;
            pressdir = 3;
        }
        if (press_d == 1)
        {
            py = wspeed;
            pressdir = 0;
        }
        if (press_u == 1)
        {
            py = -wspeed;
            pressdir = 2;
        }
    }
    if (global.stick_mag > 0 && global.flag[960] >= 1)
    {
        if (pressdir != -1 && abs(abs(global.stick_lx) - abs(global.stick_ly)) > (global.stick_mag * 0.15))
        {
            global.facing = pressdir;
        }
    }
    else
    {
        if (nopress == 1 && pressdir != -1)
        {
            global.facing = pressdir;
        }
        if (global.facing == 2)
        {
            if (press_d == 1)
            {
                global.facing = 0;
            }
            if (press_u == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 0)
        {
            if (press_u == 1)
            {
                global.facing = 2;
            }
            if (press_d == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 3)
        {
            if (press_r == 1)
            {
                global.facing = 1;
            }
            if (press_l == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
        if (global.facing == 1)
        {
            if (press_l == 1)
            {
                global.facing = 3;
            }
            if (press_r == 0 && pressdir != -1)
            {
                global.facing = pressdir;
            }
        }
    }
