Apply("gml_Object_obj_face_Step_0", @"buffer -= (1 / global.fps_scale);
if (buffer < 0)
{
    if (mouthmove == 1 && mouthtimer == 0)
    {
        mouthtimer = 1;
        face_index = 1;
    }
}
if (mouthtimer > 0)
{
    mouthtimer += (rate / global.fps_scale);
}
if (mouthtimer >= 1 && mouthtimer <= 5)
{
    face_index = 1;
}
else
{
    face_index = 0;
}
if (mouthtimer >= 9)
{
    mouthtimer = 0;
    mouthmove = 0;
}
");

Apply("gml_Object_obj_fadein_Draw_0", @"image_alpha += (fadespeed / global.fps_scale);
draw_sprite_ext(sprite_index, image_index, x, y, length, height, 0, image_blend, image_alpha);
if (image_alpha <= 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_fadeout_Draw_0", @"image_alpha += (fadespeed / global.fps_scale);
draw_sprite_ext(sprite_index, image_index, x, y, length, height, 0, image_blend, image_alpha);
if (fadein == 1 && image_alpha <= 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_fadingbullet_Draw_0", @"if (timer >= lifetime)
{
    active = false;
    image_alpha -= (0.1 / global.fps_scale);
    if (image_alpha <= 0)
    {
        instance_destroy();
    }
}
draw_self();
timer += (1 / global.fps_scale);
");

Apply("gml_Object_obj_fakespare_Draw_0", @"repeat (reverse ? reversespeed : 1)
{
    if (reverse)
    {
        if (t >= 5 && t < 10)
        {
            tone -= (1 / global.fps_scale);
        }
        if (t >= 9)
        {
            neotone -= (1 / global.fps_scale);
        }
        else
        {
            neotone = 0;
        }
    }
    if (reverse)
    {
        if (t == 0)
        {
            first_pass = false;
        }
        else
        {
            first_pass = !first_pass;
        }
    }
    if (t != 0 && first_pass)
    {
        for (i = 0; i < starcount; i += 1)
        {
            with (star[i])
            {
                hspeed += (gravity / global.fps_scale);
                x += (hspeed / global.fps_scale);
            }
        }
    }
    if (t >= 6 && t <= 26)
    {
        if (!reverse)
        {
            afterimage += (1 / global.fps_scale);
        }
        if (!first_pass)
        {
            d3d_set_fog(true, c_white, 0, 1);
            draw_sprite_ext(sprite_index, image_index, x + (afterimage * 4), y, image_xscale, image_yscale, 0, image_blend, 0.7 - (afterimage / 25));
            draw_sprite_ext(sprite_index, image_index, x + (afterimage * 8), y, image_xscale, image_yscale, 0, image_blend, 0.4 - (afterimage / 30));
            d3d_set_fog(false, c_black, 0, 0);
        }
        if (reverse)
        {
            afterimage -= (1 / global.fps_scale);
        }
    }
    if (t < 6)
    {
        if (!first_pass)
        {
            if (t < 5)
            {
                draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, 1 - (neotone / 4));
            }
            d3d_set_fog(true, c_white, 0, 1);
            maxwhite = t / 5;
            if (maxwhite > 1)
            {
                maxwhite = 1;
            }
            draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, maxwhite - (tone / 5));
            d3d_set_fog(false, c_black, 0, 0);
        }
    }
    if (!reverse)
    {
        if (t >= 1 && t <= 5)
        {
            for (i = 0; i < 2; i += 1)
            {
                star[starcount] = instance_create(x + random(sprite_width), y + random(sprite_height), obj_marker);
                star[starcount].reversespeed = reversespeed;
                with (star[starcount])
                {
                    image_xscale = 2;
                    image_yscale = 2;
                    sprite_index = spr_sparestar_anim;
                    image_alpha = 2;
                    image_speed = 0.25 / global.fps_scale;
                    hspeed = -3 / global.fps_scale;
                    gravity = 0.5 / (global.fps_scale * global.fps_scale);
                    gravity_direction = 0;
                }
                starcount += 1;
            }
        }
        if (t >= 5 && t <= 30)
        {
            for (i = 0; i < starcount; i += 1)
            {
                with (star[i])
                {
                    image_angle += (10 / global.fps_scale);
                    image_alpha -= (0.1 / global.fps_scale);
                    if (image_alpha <= 0)
                    {
                        visible = false;
                    }
                }
            }
        }
    }
    else
    {
        if (t >= 6 && t <= 31)
        {
            for (i = 0; i < starcount; i += 1)
            {
                with (star[i])
                {
                    image_angle -= (10 / global.fps_scale);
                    image_alpha += (0.1 / global.fps_scale);
                    if (!visible && image_alpha >= 0 && image_alpha < 2)
                    {
                        visible = true;
                    }
                }
            }
        }
        if (t >= 2 && t <= 6)
        {
            for (i = 0; i < 2; i += 1)
            {
                starcount -= (1 / global.fps_scale);
                with (star[starcount])
                {
                    instance_destroy();
                }
            }
        }
    }
    if (!reverse)
    {
        if (t >= 5 && t < 10)
        {
            tone += (1 / global.fps_scale);
        }
        if (t >= 9)
        {
            neotone += (1 / global.fps_scale);
        }
        else
        {
            neotone = 0;
        }
    }
    if (reverse && t == (15 * reversespeed))
    {
        snd_play(snd_reverse_spare);
    }
    if (t >= 50 && !reverse)
    {
        for (i = 0; i < starcount; i += 1)
        {
            with (star[i])
            {
                image_speed *= -reversespeed;
                hspeed = (-hspeed - gravity) / global.fps_scale;
            }
        }
        first_pass = false;
        reverse = true;
        t += (1 / global.fps_scale);
    }
    if (reverse)
    {
        t -= (1 / global.fps_scale);
    }
    else
    {
        t += (1 / global.fps_scale);
    }
    if (reverse && t < 0)
    {
        original.visible = true;
        instance_destroy();
        exit;
    }
}
");

Apply("gml_Object_obj_fancy_ripples_Draw_0", @"if (visible)
{
    var _cx = camerax();
    var _cy = cameray();
    if (!surface_exists(surf_ripples))
    {
        surf_ripples = surface_create(640, 480);
    }
    var _delcount = 0;
    shader_set(shd_ripple);
    surface_set_target(surf_ripples);
    draw_clear_alpha(c_black, 0);
    var _ripplecount = array_length(ripples);
    for (var i = 0; i < _ripplecount; i++)
    {
        var _thisripple = ripples[i];
        _thisripple.life = max(0, _thisripple.life - (1 / global.fps_scale));
        _thisripple.x += _thisripple.hsp / global.fps_scale;
        _thisripple.y += _thisripple.vsp / global.fps_scale;
        if (_thisripple.hsp > 0)
        {
            _thisripple.hsp = scr_approach(_thisripple.hsp, 0, _thisripple.fric);
        }
        if (_thisripple.vsp > 0)
        {
            _thisripple.vsp = scr_approach(_thisripple.vsp, 0, _thisripple.fric);
        }
        var _xx = _thisripple.x - _cx;
        var _yy = _thisripple.y - _cy;
        _thisripple.rad = lerp(_thisripple.radstart, _thisripple.radmax, animcurve_channel_evaluate(curves[_thisripple.curve], 1 - (_thisripple.life / _thisripple.lifemax)));
        if (_thisripple.rad > 0)
        {
            shader_set_uniform_f(u_center, _xx, _yy);
            shader_set_uniform_f(u_rad, _thisripple.rad, _thisripple.radmax, _thisripple.thickness);
            draw_set_colour(_thisripple.col);
            var _rad = _thisripple.rad;
            ossafe_fill_rectangle(_xx - _rad, _yy - _rad, _xx + _rad, _yy + _rad, false);
            if (_thisripple.life == 0)
            {
                _delcount++;
                _thisripple = undefined;
            }
        }
    }
    surface_reset_target();
    shader_reset();
    repeat (_delcount)
    {
        array_delete(ripples, 0, 1);
    }
    draw_surface_ext(surf_ripples, _cx, _cy, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
}
");

