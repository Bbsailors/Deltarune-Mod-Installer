        var plcamy = clamp(obj_mainchara.y - floor((viewh / 2) - (obj_mainchara.initht / 2)), 0, roomh - viewh);
        camstrength = lerp(camstrength, 4, scr_fps_lerp_rate(0.010101010101010102));
        camx = lerp(camx, plcamx, scr_fps_lerp_rate(camstrength / 8));
