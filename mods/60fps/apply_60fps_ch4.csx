        hspeed = 0.5 / global.fps_scale;
        friction = 0.1 / (global.fps_scale * global.fps_scale);
        target_y = 108;
    }
    if (push_timer == 13)
    {
        hspeed = -hspeed;
        vspeed = -vspeed / 2;
    }
    if (push_timer == 16)
    {
        vspeed = -vspeed / 2;
    }
    if (y >= target_y)
    {
        hspeed = scr_movetowards(hspeed, 0, 0.1 / global.fps_scale);
        vspeed = 0;
        gravity = 0;
        if (hspeed == 0)
        {
