Apply("gml_Object_obj_homealone_dess_snowflake_Step_0", @"if (stop_blowing)
{
    if (!is_blowing)
    {
        exit;
    }
    stop_blowing = false;
    is_blowing = false;
    angleV = 0.04;
}
if (start_blowing)
{
    if (is_blowing)
    {
        exit;
    }
    start_blowing = false;
    is_blowing = true;
    push = true;
    push_timer = 0;
    angle_temp = angle;
    angleV = 0;
    stop_timer = 0;
}
if (pull_down)
{
    pull_down = false;
    stop_timer = 0;
    angleV = -angleV;
    push_timer = 0;
}
if (push)
{
    push_timer += (1 / global.fps_scale);
    if (push_timer == 1)
    {
        var target_angle = is_hit ? 1.5707963267948966 : 0.7853981633974483;
        scr_lerp_instance_var(id, ""angle"", angle_temp, target_angle, 4);
    }
    if (is_hit)
    {
        if (push_timer == 8)
        {
            if (!snowflake_finished)
            {
                snowflake_finished = true;
                with (obj_homealone_dess_closet_controller)
                {
                    drop_ornament = true;
                }
            }
            is_hit = false;
        }
    }
    if (push_timer >= 8)
    {
        var force = swing_gravity * sin(angle);
        angleA = (-1 * force) / len;
        angleV += (angleA / global.fps_scale);
        if (!is_blowing)
        {
            angle += (angleV / global.fps_scale);
            stop_timer += (1 / global.fps_scale);
            if (stop_timer >= 240)
            {
                angleV *= power(0.98, 1 / global.fps_scale);
                if (angleA < 0.00001 && force < 0.0001)
                {
                    angleV = 0;
                    angle = 0;
                }
            }
        }
    }
    x = (len * sin(angle)) + origin_x;
    y = (len * cos(angle)) + origin_y;
}
");

Apply("gml_Object_obj_homealone_heart_Draw_0", @"if (angel_mode)
{
    if (shake)
    {
        shake_timer += (1 / global.fps_scale);
        if (shake_timer == 1)
        {
            var _offset = 4;
            if (i_ex(obj_noellehouse_basement) && obj_noellehouse_basement.move_wait)
            {
                _offset = 8;
            }
            shake_x_offset -= _offset;
        }
        if (shake_timer == 4)
        {
            var _offset = 4;
            if (i_ex(obj_noellehouse_basement) && obj_noellehouse_basement.move_wait)
            {
                _offset = 8;
            }
            shake_x_offset += _offset;
            shake = false;
            shake_timer = 0;
        }
    }
    else
    {
        shake_x_offset = 0;
    }
    draw_sprite_ext(spr_noellehouse_basement_angel, 0, x + 4, y + 2, 1, 1, image_angle + shake_x_offset, c_white, 1);
}
else
{
    draw_self();
}
");

Apply("gml_Object_obj_homealone_heart_Step_0", @"wallcheck = 0;
