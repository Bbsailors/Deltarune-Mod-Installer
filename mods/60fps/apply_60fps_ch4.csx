    upstairs_check = true;
}
if (make_npcs)
{
    make_npcs = false;
    toriel_npc = scr_marker(500, 121, spr_toriel_dance_loop);
    toriel_npc.image_speed = 0.15 / global.fps_scale;
    with (toriel_npc)
    {
        scr_depth();
    }
    sans_npc = scr_marker(466, 142, spr_sans_dance_loop);
    sans_npc.image_speed = 0.15 / global.fps_scale;
    with (sans_npc)
    {
        scr_depth();
    }
    var dance_collider = instance_create(457, sans_npc.y, obj_solidblockLight);
    dance_collider.image_xscale = 4;
    dance_collider.image_yscale = 1.5;
    var dance_readable = instance_create(467, sans_npc.y + 8, obj_readable_room1);
    dance_readable.image_xscale = 4;
    dance_readable.image_yscale = 1.18;
    dance_npc = true;
    with (door_frame_marker)
    {
        depth = 100000;
    }
}
if (dance_npc)
{
    dance_timer += (1 / global.fps_scale);
    if (!dance_kick)
    {
        sinerx = 0;
        siner0 += (siner_add0 / global.fps_scale);
        sinmove = sin(siner0) * 0.8;
        toriel_npc.x += lengthdir_x(sinmove, siner_direction0) / global.fps_scale;
        sans_npc.x -= lengthdir_x(sinmove, siner_direction0) / global.fps_scale;
    }
    if (dance_timer == 1)
    {
        dance_kick = false;
        toriel_npc.visible = 1;
        toriel_npc.sprite_index = spr_toriel_dance_loop_back;
        sans_npc.sprite_index = spr_sans_dance_loop_back;
        dance_speed = 0.15;
        sans_npc.image_speed = dance_speed / global.fps_scale;
    }
    if (dance_timer == 120)
    {
        toriel_npc.sprite_index = spr_toriel_dance_loop;
        sans_npc.sprite_index = spr_sans_dance_loop;
    }
    if (dance_timer == 240)
    {
        dance_kick = true;
        toriel_npc.visible = 0;
        sans_npc.sprite_index = spr_toriel_sans_dance_loop;
        dance_speed = 0.25;
        sans_npc.image_speed = dance_speed / global.fps_scale;
    }
    if (dance_timer == 360)
    {
        sans_npc.sprite_index = spr_toriel_sans_dance_kick_stop;
    }
    if (dance_timer >= 360 && sans_npc.image_index >= 7)
    {
        dance_timer = 0;
    }
    if (music_faster)
    {
        if (dance_pitch < 1.36)
        {
            dance_pitch = 1.36;
        }
        if (toriel_npc != -4)
        {
            if (toriel_npc.image_speed != ((dance_speed * 2) / global.fps_scale))
            {
                toriel_npc.image_speed = (dance_speed * 2) / global.fps_scale;
            }
        }
        if (sans_npc != -4)
        {
            if (sans_npc.image_speed != ((dance_speed * 2) / global.fps_scale))
            {
                sans_npc.image_speed = (dance_speed * 2) / global.fps_scale;
            }
        }
    }
    else
    {
        if (dance_pitch > 1)
        {
            dance_pitch = 1;
        }
        if (toriel_npc != -4)
        {
            if (toriel_npc.image_speed != (dance_speed / global.fps_scale))
            {
                toriel_npc.image_speed = dance_speed / global.fps_scale;
            }
        }
        if (sans_npc != -4)
        {
            if (sans_npc.image_speed != (dance_speed / global.fps_scale))
            {
                sans_npc.image_speed = dance_speed / global.fps_scale;
            }
        }
    }
    var current_pitch = scr_movetowards(audio_sound_get_pitch(global.currentsong[0]), dance_pitch, 0.25 / global.fps_scale);
    snd_pitch(global.currentsong[0], current_pitch);
}
if (upstairs_check)
{
    if (upstairs_con == 0)
    {
        if (obj_mainchara.x < 160 && obj_mainchara.y < 80)
        {
            global.interact = 1;
            global.facing = 2;
            upstairs_con = 1;
        }
    }
    if (upstairs_con == 1)
    {
        upstairs_con = 2;
        cutscene_master = scr_cutscene_make();
        scr_maincharacters_actors();
        c_sound_play(snd_escaped);
        c_var_lerp_instance(blackall, ""image_alpha"", 0, 1, 30);
        c_mus2(""volume"", 0, 30);
        c_wait(210);
        c_actortokris();
        c_actortocaterpillar();
        c_terminatekillactors();
    }
    if (upstairs_con == 2 && !i_ex(obj_cutscene_master))
    {
        snd_free_all();
        upstairs_con = 99;
        upstairs_check = false;
        scr_flag_set(778, 0);
        if (scr_flag_get(931) == 0)
        {
            with (obj_event_manager)
            {
                trigger_event(UnknownEnum.Value_0, UnknownEnum.Value_4);
            }
        }
        with (obj_event_manager)
        {
            trigger_event(UnknownEnum.Value_2, UnknownEnum.Value_1);
        }
        scr_complete_save_file();
        room_goto(room_krisroom_dark);
    }
}
if (play_music)
{
    play_timer += (1 / global.fps_scale);
    if (play_timer == 1)
    {
        var start_x = phono_marker.x + 10 + irandom(10);
        var start_y = phono_marker.y + 10;
        var note_marker = scr_marker(start_x, start_y, spr_musical_notes_small);
        note_marker.depth = phono_marker.depth - 10;
        note_marker.image_alpha = 0;
        var note_speed = music_faster ? 0.5 : 1;
        scr_lerp_var_instance(note_marker, ""image_alpha"", 0, 1, 10 * note_speed);
        scr_lerp_var_instance(note_marker, ""x"", start_x, start_x + 20 + irandom(10), 30 * note_speed);
        scr_lerp_var_instance(note_marker, ""y"", start_y, start_y - (30 + irandom(10)), 30 * note_speed);
        with (note_marker)
        {
            scr_script_delayed(scr_lerp_var_instance, 11 * note_speed, id, ""image_alpha"", 1, 0, 10 * note_speed);
        }
        scr_doom(note_marker, 61 * note_speed);
    }
    if (music_faster)
    {
        with (phono_marker)
        {
            image_speed = 0.3 / global.fps_scale;
        }
        if (play_timer >= 10)
        {
            play_timer = 0;
        }
    }
    else
    {
        with (phono_marker)
        {
            image_speed = 0.15 / global.fps_scale;
        }
        if (play_timer >= 20)
        {
            play_timer = 0;
        }
    }
}
if (toriel_fall)
{
    if (to_actor.image_index < 11)
    {
        exit;
    }
    toriel_fall_timer += (1 / global.fps_scale);
    with (to_actor)
    {
        if (hspeed < (1 / global.fps_scale))
        {
            hspeed = scr_movetowards(hspeed, 1 / global.fps_scale, 0.25 / global.fps_scale);
        }
    }
    if (toriel_fall_timer == 17)
    {
        sound_play(snd_bump);
        scr_shakescreen();
        with (to_actor)
        {
            friction = 1 / (global.fps_scale * global.fps_scale);
        }
        toriel_fall = false;
    }
}

enum UnknownEnum
{
    Value_0,
    Value_1,
    Value_2,
    Value_4 = 4
}
");

Apply("gml_Object_obj_ch4_LWF04A_phone_Step_0", @"if (start_speech)
{
    speech_delay_timer -= (1 / global.fps_scale);
    if (speech_delay_timer <= 0)
    {
        start_speech = false;
        speech_active = true;
        show_text = true;
    }
}
if (speech_active)
{
    if (i_ex(obj_writer))
    {
        var text_finished = false;
        with (obj_writer)
        {
            text_finished = reachedend;
        }
        if (text_finished && show_text_timer <= 0)
        {
            show_text_timer = 75;
            fade_bubble = true;
        }
    }
    else
    {
        if (stop_speech)
        {
            exit;
        }
        show_text_timer -= (1 / global.fps_scale);
        if (show_text_timer <= 0)
        {
            if (speech_index >= array_length(speech))
            {
                speech_active = false;
                exit;
            }
            draw_set_font(scr_84_get_font(""dotumche""));
            snd_play(spr_kris_phone_message);
            bg_base_alpha = 0;
            current_text = speech[speech_index];
            global.msg[0] = current_text;
            start_pos_x = 14;
            start_pos_y = cameray() + 162;
            var text_height = string_height(current_text) * 0.25;
            var text_width = ((string_width(current_text) / 2) + 20) * 0.75;
            var bubble = instance_create((start_pos_x - (text_width / 2)) + 20, start_pos_y, obj_text_spikeballoon);
            bubble.y = start_pos_y;
            bubble.tailx = start_pos_x + 35;
            bubble.taily = start_pos_y - 30;
            bubble.w = (string_width(current_text) / 2) + 20;
            bubble.depth = 90;
            global.typer = 81;
            writer = instance_create((start_pos_x - (text_width / 2)) + 20, (start_pos_y - text_height) + 4, obj_writer);
            writer.shake = 0.75;
            writer.rate = 4;
            writer.textscale = 0.5;
            writer.hspace = 5;
            writer.vspace = 9;
            writer.fadeonend = 0.02;
            writer.depth = bubble.depth - 10;
            with (writer)
            {
                skippable = 0;
            }
            speech_index++;
        }
    }
}
if (stop_speech)
{
    if (!i_ex(obj_writer))
    {
        stop_speech = false;
        instance_destroy();
    }
}
if (fade_bubble)
{
    fade_bubble_timer += (1 / global.fps_scale);
    if (fade_bubble_timer == 10)
    {
        with (obj_text_spikeballoon)
        {
            scr_lerpvar(""image_alpha"", 0.7, 0, 60);
        }
    }
    if (fade_bubble_timer == 70)
    {
        fade_bubble = false;
        fade_bubble_timer = 0;
        with (obj_text_spikeballoon)
        {
            instance_destroy();
        }
    }
}
");

