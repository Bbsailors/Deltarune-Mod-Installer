Apply("gml_Object_obj_multiboss_controller_Step_0", @"if (scr_isphase(""enemytalk"") && talked == 0)
{
    scr_randomtarget();
    myattackchoice = choose(0, 1);
    if (obj_multiboss_controller.taunt == 1)
    {
        myattackchoice = 2;
    }
    obj_multiboss_controller.taunt = 0;
