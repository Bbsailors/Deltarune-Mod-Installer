        snd_play_delay(snd_tensionhorn, 10, undefined, 1.1);
    }
    if (timer == 32)
    {
        global.flag[54] = encounterflag;
        scr_battle(encounterno, 0, undefined, angymarker);
        enemcon = 3;
    }
}
