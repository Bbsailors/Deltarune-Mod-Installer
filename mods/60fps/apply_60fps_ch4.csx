        throwcon = 2;
        snd_play(snd_ultraswing);
        ral = instance_create(rx, ry, obj_ralseithrown);
        ral.speed = mypower / global.fps_scale;
        ral.mypower = mypower;
        ral.image_xscale = 2;
        ral.image_yscale = 2;
        ral.direction = angle;
        ral.image_angle = angle;
        ral.gravity = ralgrav / (global.fps_scale * global.fps_scale);
    }
    if (throwready == 1)
    {
        mypower += ((powerdir * powerspeed) / global.fps_scale);
        if (mypower >= maxpower)
        {
            powerdir = -1;
        }
        if (mypower <= minpower)
        {
            powerdir = 1;
        }
    }
}
if (throwcon == 2)
{
    if (image_index >= 5)
    {
        image_speed = 0;
    }
}
if (angledraw == 1)
{
    lx = lengthdir_x(mypower, angle);
    ly = lengthdir_y(mypower, angle);
    for (i = 0; i < 42; i += 1)
    {
        ralyadd = ralgrav + (ralgrav * i);
        if (i > 0)
        {
            ralyoff[i] = ralyoff[i - 1] + ralyadd;
        }
        else
        {
            ralyoff[0] = ralyadd;
        }
    }
}
");

