    with (shadow_npc)
    {
        image_speed = 0.4 / global.fps_scale;
        normalanim = -1;
    }
}
if (con == 1)
{
    shadow_timer += (1 / global.fps_scale);
    if ((shadow_timer % 16) == 1)
    {
        var sound = choose(511, 167, 567);
        snd_play(sound);
    }
    if (shadow_timer >= 32)
    {
        shadow_timer = 0;
        con = 2;
        alarm[0] = round(20 * global.fps_scale);
        with (shadow_npc)
        {
            image_speed = 0;
        }
        shadow_npc.normalanim = shadow_anim;
    }
}
if (con == 3)
{
