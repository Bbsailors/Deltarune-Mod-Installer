");

Apply("gml_Object_obj_baseenemy_Draw_0", @"scr_enemy_drawhurt_generic();
if (custom_draw_example == 0)
{
    scr_enemy_drawidle_generic(0.16666666666666666);
}
else if (state == 0)
{
