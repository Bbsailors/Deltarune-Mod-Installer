Apply("gml_Object_obj_tutorial_bullet_Step_0", @"image_angle = direction;
if (y > (cameray() + 220) || x < ((camerax() + 320) - 120) || x > (camerax() + 320 + 120))
{
    fade = true;
}
if (fade == true)
{
