    {
        direction = (scr_at_player(x, y) - 15) + random(30);
        speed = (13 + (4 * hits)) / global.fps_scale;
        if (speed_scale && hits == 0 && point_distance(x, y, obj_heart.x + 5, obj_heart.y + 5) < 240)
        {
            speed -= (logn(3, 240 - point_distance(x, y, obj_heart.x + 5, obj_heart.y + 5)) / global.fps_scale);
        }
    }
}
if (tutu == 2)
{
