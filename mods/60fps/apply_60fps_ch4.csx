    d_triangle(x1 + (w / 3), y2, x1 + ((w / 3) * 2), y2, x1 + (w / 2) + (random_range(-3, 3) * r), y2 + 7 + (random(3) * r), false);
    d_triangle(x2, y1, x2 - (w / 3), y2, x2 + (random(6) * r), y2 + 7 + (random(3) * r), false);
    var t2x1 = (x2 - (w / 3)) + (random_range(-2, 2) * r);
