Apply("gml_Object_obj_dw_church_prophecy_groundshards_Step_0", @"if (i_ex(obj_ch4_DCA04))
{
    depth = 7000;
}
siner += (1 / global.fps_scale);
if ((siner % 8) == 0)
{
