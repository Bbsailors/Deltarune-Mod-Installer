            darkness.image_alpha = darkness_initial + max(0, ((kris.x - darkness_startx) / (darkness_midx - darkness_startx)) * (darkness_mid - darkness_initial));
        }
        light_player.size = light_player_size - (60 * darkness.image_alpha);
