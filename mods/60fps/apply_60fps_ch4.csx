                shiftX = -1;
            }
            var col = 8388736;
            var startArray = [0, 21, 41];
            var widthArray = [21, 20, 21];
            var totalStartX = (tower_x + tile_x[_tilex] + xoff) - 20;
            var totalWidth = (obj_climb_kris.jumpchargetimer / obj_climb_kris.chargetime2) * 62;
            count = 3;
