            _descs[2] = ""Shows a debug readout (room name and number, FPS, coordinates) in the top-left corner. Turn this ON to report exactly where a bug happens."";
            _descs[3] = ""Aim the shield a full 360 degrees with a controller in the Gerson fight. MOVE BOX adds an interesting visual effect: the box shifts toward where you aim. FIXED BOX plays like the standard fight, but with 360 aiming. Off by default, as 360 aiming can affect the fight's intended balance."";
            _descs[4] = ""Enables the V key to fast-forward the game. Pick 2X or 4X, then press V during play to toggle the speed-up on and off. OFF disables the key."";
            _descs[5] = ""How fast holding the CANCEL button (The C key by default) skips through text. OFF: normal speed. ON: faster (the quicker skip from earlier versions)."";
