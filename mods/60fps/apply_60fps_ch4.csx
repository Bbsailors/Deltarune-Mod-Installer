    }
    draw_monster_body_part(turthead, _headindex, x + 26 + headoffsetx + (sin(animsiner / 8) * headamplitude), y + 56 + headoffsety + ((cos(animsiner / 6) * headamplitude) / 2));
    if (global.myfight != 3 && acting != 20)
    {
        var spareable = 1;
