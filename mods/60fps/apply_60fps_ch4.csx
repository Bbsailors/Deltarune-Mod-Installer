    if (y > (__view_get(e__VW.YView, 0) + 520))
    {
        instance_destroy();
    }
}
dont = 0;

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_chaseenemy_Draw_0", @"if (drawoffscreen == 0)
{
    dodraw = 1;
    tolerance = sprite_height + sprite_width;
    if (!scr_onscreen_tolerance(id, tolerance))
    {
        dodraw = 0;
    }
}
else
{
    dodraw = true;
}
if (dodraw)
{
    drawx = 0;
    drawscale = 1;
    if (facing == 1 && specialspritecase == 0)
    {
        drawscale = -1;
        drawx = sprite_width;
    }
    drawsiner += (0.25 / global.fps_scale);
    tempx = x;
    x += (drawx / global.fps_scale);
    superscalex = 0;
    superdrawx = 0;
    superscalexb = 1;
    if (specialspritecase == 0)
    {
        if (facing == 0)
        {
            superscalex = 0;
        }
        else
        {
            superscalex = -4;
            superscalexb = -1;
            superdrawx = -sprite_width * 2;
        }
    }
    if (specialspritecase == ""tasque"")
    {
        if (facing == 1)
        {
            sprite_index = spr_tasque_idle_flipped;
        }
        if (facing == 0)
        {
            sprite_index = spr_tasque_idle;
        }
    }
    gpu_set_blendmode(bm_add);
    for (i = 0; i < 5; i++)
    {
        var aura = (i * 9) + ((drawsiner * 3) % 9);
        var aurax = (aura * 0.75) + (sin(aura / 4) * 4);
        var auray = 45 * scr_ease_in(aura / 45, 1);
        var aurayscale = min(80 / sprite_height, 1);
        draw_sprite_ext(sprite_index, walk_index, x - ((aurax / 180) * drawscale * sprite_width), y - ((auray / 82) * sprite_height * aurayscale), (image_xscale + (aurax / 36)) * drawscale, image_yscale + ((auray / 36) * aurayscale), image_angle, c_red, image_alpha * (1 - (auray / 45)) * 0.5);
    }
    gpu_set_blendmode(bm_normal);
    var xmult = min((70 / sprite_width) * 4, 4);
    var ymult = min((80 / sprite_height) * 5, 5);
    var ysmult = min((80 / sprite_height) * 0.2, 0.2);
    draw_sprite_ext_centerscale(sprite_index, walk_index, x + superdrawx + (sin(drawsiner / 5) * xmult), y + (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale + (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2);
    draw_sprite_ext_centerscale(sprite_index, walk_index, (x + superdrawx) - (sin(drawsiner / 5) * xmult), y - (cos(drawsiner / 5) * ymult), image_xscale + superscalex, image_yscale - (sin(drawsiner / 5) * ysmult), image_angle, 255, image_alpha * 0.2);
    scr_draw_outline_ext(sprite_index, walk_index, x, y, image_xscale * drawscale, image_yscale, image_angle, c_red, image_alpha * 0.3, 2);
    draw_sprite_ext(sprite_index, walk_index, x, y, image_xscale * drawscale, image_yscale, image_angle, image_blend, image_alpha);
    x = tempx;
    mymidx = x + (sprite_width / 2);
    mymidy = y + ((bbox_bottom - y) / 2);
}
if (largetouchregion)
{
    var xx = x + (sprite_width / 2);
    var yy = y + (sprite_height / 2);
}
");

Apply("gml_Object_obj_chaseenemy_Step_0", @"if (encounterflag > 0 && init == 0)
{
    if (global.flag[encounterflag] == 1)
    {
        instance_destroy();
    }
    if (global.flag[encounterflag] == 6)
    {
        if (frozensprite == 0)
        {
            frozensprite = touchsprite;
        }
        frozennpc = instance_create(x, y, obj_frozennpc);
        frozennpc.sprite_index = frozensprite;
        frozennpc.fresh = 1;
        instance_destroy();
        if (sprite_index == spr_werewire_hang_overworld)
        {
            frozennpc.sprite_index = spr_werewire_hurt;
        }
    }
    init = 1;
}
scr_depth_alt();
targetx = (obj_mainchara.x + (obj_mainchara.sprite_width / 2)) - (sprite_width / 2);
targety = (obj_mainchara.bbox_bottom - sprite_height) + (sprite_get_yoffset(sprite_index) * image_yscale);
if (global.interact == 0 || global.interact == 4)
{
    frozen = 0;
}
if (scr_outside_camera(200) && offscreen_frozen == 1)
{
    frozen = 1;
}
else
{
    frozen = 0;
}
if (global.interact != 0 && global.interact != 4)
{
    frozen = 1;
}
if (frozen == 1 && ignorefreeze == 0)
{
    if (hadfrozen == 0)
    {
        remspeed = speed;
        speed = 0;
        hadfrozen = 1;
    }
}
if (frozen == 0)
{
    if (hadfrozen == 1)
    {
        if (speed == 0)
        {
            speed = remspeed;
        }
        hadfrozen = 0;
    }
    if (pacecon == 0)
    {
        pacetimer += (1 / global.fps_scale);
        if (pacetype == 0)
        {
        }
        if (pacetype == 1)
        {
            if (pacetimer == 10)
            {
                hspeed = 2 / global.fps_scale;
            }
            if (pacetimer == 34)
            {
                hspeed = 0;
            }
            if (pacetimer == 50)
            {
                hspeed = -2 / global.fps_scale;
            }
            if (pacetimer == 74)
            {
                hspeed = 0;
            }
            if (pacetimer == 80)
            {
                pacetimer = 0;
            }
        }
        if (pacetype == 2)
        {
            hspeed = (sin(pacetimer / 24) * 4) / global.fps_scale;
            vspeed = (cos(pacetimer / 24) * 4) / global.fps_scale;
        }
        if (pacetype == 5)
        {
            if (pacetimer == 1)
            {
                vspeed = 6 / global.fps_scale;
            }
            if (pacetimer == 25)
            {
                vspeed = -6 / global.fps_scale;
            }
            if (y < ystart)
            {
                pacetimer = 0;
            }
        }
        if (pacetype == 6)
        {
            cancelwalk = 1;
            walk_index += (0.25 / global.fps_scale);
        }
        if (pacetype == 7)
        {
            hspeed = (-sin(pacetimer / 30) * 10) / global.fps_scale;
        }
        if (pacetype == 7.1)
        {
            hspeed = (-sin(pacetimer / 30) * 10) / global.fps_scale;
        }
        if (pacetype == 7.5)
        {
            hspeed = (sin(pacetimer / 30) * 10) / global.fps_scale;
        }
        if (pacetype == 8)
        {
            vspeed = (-sin(pacetimer / 25) * 12.5) / global.fps_scale;
        }
        if (pacetype == 9)
        {
            if (float != 0)
            {
                y = yy - (sin(pacetimer / 5) * float);
            }
            hspeed = (sin(pacetimer / (pacespeed * 30)) * (moveradius / 20)) / global.fps_scale;
            pacespeed = 0.8;
        }
        if (pacetype == 9.5)
        {
            if (float != 0)
            {
                y = yy - sin(pacetimer / float);
            }
            hspeed = (2 * (sin(pacetimer / 24) * (moveradius / 20))) / global.fps_scale;
        }
        if (pacetype == 10)
        {
            if (pacecon2 == 0)
            {
                if (vspeed > 0)
                {
                    vspeed *= power(0.9, 1 / global.fps_scale);
                }
                if (vspeed <= (0.5 / global.fps_scale) && pacecon2 == 0)
                {
                    pacecon2 = 1;
                }
            }
            if (pacecon2 == 1)
            {
                move_towards_point(obj_mainchara.x, obj_mainchara.y, 4 / global.fps_scale);
            }
        }
        if (pacetype == 11)
        {
            cancelwalk = 1;
            image_speed = 0.25 / global.fps_scale;
            if (pathSpeed == 0)
            {
                pathSpeed = 6;
            }
            if (direction >= 136 && direction <= 225)
            {
                facing = 0;
            }
            if (direction >= 306 || direction <= 45)
            {
                facing = 1;
            }
        }
        if (pacetype == 12)
        {
            hspeed = (-sin(pacetimer / 30) * 10) / global.fps_scale;
            vspeed = (-sin(pacetimer / 12) * 12.5) / 10 / global.fps_scale;
        }
        if (pacetype == 13)
        {
            t = (t + (increment / global.fps_scale)) % 360;
            shift = amplitude * dsin(t);
            y = yy + shift;
        }
        if (pacetype == 14)
        {
            var _c = dcos(rotation);
            var _s = dsin(rotation);
            x = xx + (_c * distance) + (_s * distance);
            y = yy + (-_s * distance) + (_c * distance);
            rotation += (spd / global.fps_scale);
            if (rotation > 359)
            {
                rotation -= 360;
            }
        }
        if (pacetype == 15)
        {
            if (float != 0)
            {
                y = yy - sin(pacetimer / float);
            }
            t = (t + (increment / global.fps_scale)) % 360;
            shift = amplitude * dsin(t);
            x = xx + shift;
            vspeed = (-sin(pacetimer / 12) * 12.5) / 10 / global.fps_scale;
        }
        if (pacetype == 16)
        {
            if (pacecon2 == 0)
            {
                hspeed *= power(1.2, 1 / global.fps_scale);
                hspeed = clamp(hspeed, -12 / global.fps_scale, 12 / global.fps_scale);
                if (x <= 240)
                {
                    pacecon2 = 0.1;
                }
            }
            if (pacecon2 == 0.1)
            {
                hspeed *= power(0.7, 1 / global.fps_scale);
                if (abs(hspeed) < (0.5 / global.fps_scale))
                {
                    hspeed = 1 / global.fps_scale;
                    pacecon2 = 1;
                }
            }
            if (pacecon2 == 1)
            {
                hspeed *= power(1.2, 1 / global.fps_scale);
                hspeed = clamp(hspeed, -12 / global.fps_scale, 12 / global.fps_scale);
                if (x >= 860)
                {
                    pacecon2 = 1.1;
                }
            }
            if (pacecon2 == 1.1)
            {
                hspeed *= power(0.7, 1 / global.fps_scale);
                if (abs(hspeed) < (0.5 / global.fps_scale))
                {
                    hspeed = -1 / global.fps_scale;
                    pacecon2 = 0;
                }
            }
        }
        if (pacetype == 17)
        {
            y = yy - sin(pacetimer / 5);
            x = xx - (sin(pacetimer / 20) * 10);
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
        if (pacetype == 18)
        {
            y = yy - sin(pacetimer / 5);
        }
        if (pacetype == 19)
        {
            x = xx - (sin(pacetimer / 20) * 20);
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
        if (pacetype == 20)
        {
            if (float != 0)
            {
                y = yy - sin(pacetimer / float);
            }
            image_speed = 0.25 / global.fps_scale;
            cancelwalk = 1;
            if (pacecon2 == 0)
            {
                if (x < (xstart + moveradius))
                {
                    x += (pacespeed / global.fps_scale);
                }
                else
                {
                    x = xstart + moveradius;
                    pacecon2 = 1;
                }
            }
            if (pacecon2 == 1)
            {
                if (x > (xstart - moveradius))
                {
                    x -= (pacespeed / global.fps_scale);
                }
                else
                {
                    x = xstart - moveradius;
                    pacecon2 = 0;
                }
            }
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
        if (pacetype == 21 || pacetype == 22)
        {
            if (paceinit == 0)
            {
                leftbound = 0;
                leftboundcheck = 0;
                while (leftboundcheck == 0)
                {
                    if (place_meeting(x - leftbound, y, obj_solidblock) || place_meeting(x - leftbound, y, obj_solidenemy) || place_meeting(x - leftbound, y, obj_solidenemy_2) || leftbound >= 480)
                    {
                        leftboundcheck = 1;
                        show_debug_message(""leftbound:"" + string(leftbound));
                    }
                    else
                    {
                        leftbound++;
                    }
                }
                rightbound = 0;
                rightboundcheck = 0;
                while (rightboundcheck == 0)
                {
                    if (place_meeting(x + rightbound, y, obj_solidblock) || place_meeting(x + rightbound, y, obj_solidenemy) || place_meeting(x + rightbound, y, obj_solidenemy_2) || rightbound >= 480)
                    {
                        rightboundcheck = 1;
                        show_debug_message(""rightbound:"" + string(rightbound));
                    }
                    else
                    {
                        rightbound++;
                    }
                }
                if (leftbound < rightbound)
                {
                    moveradius = leftbound - 8;
                }
                else
                {
                    moveradius = rightbound - 8;
                }
                show_debug_message(""moveradius:"" + string(moveradius));
                siner = 0;
                pacesinspeed = moveradius / (pacespeed * 3);
                paceinit = 1;
            }
            siner += (1 / global.fps_scale);
            if (pacetype == 21)
            {
                x = xx - (sin(siner / pacesinspeed) * moveradius);
            }
            if (pacetype == 22)
            {
                x = xx + (sin(siner / pacesinspeed) * moveradius);
            }
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
        if (pacetype == 23)
        {
            y = yy - sin(pacetimer / 5);
            x = xx - (sin(pacetimer / 20) * moveradius);
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
        if (pacetype == 24)
        {
            pacespeed = 25;
            y = yy + (sin(pacetimer / 20) * 10);
            x = xx - (sin(pacetimer / pacespeed) * moveradius);
            if (x > xprevious)
            {
                facing = 1;
            }
            else
            {
                facing = 0;
            }
        }
    }
    viewblocked = 0;
    viewpointx = ((bbox_left + bbox_right) / 2) + detectpointxoffset;
    viewpointy = bbox_bottom + detectpointyoffset;
    if (canAlertThroughWalls == 0)
    {
        mcx = (obj_mainchara.bbox_left + obj_mainchara.bbox_right) / 2;
        mcy = obj_mainchara.bbox_bottom;
        if (collision_line(viewpointx, viewpointy, mcx, mcy, obj_solidblock, 1, 1) > 0)
        {
            viewblocked = 1;
        }
        if (collision_line(viewpointx, viewpointy, mcx, mcy, obj_interactablesolid, 1, 0) > 0)
        {
            viewblocked = 1;
        }
        if (collision_line(viewpointx, viewpointy, mcx, mcy, obj_solidenemy, 1, 0) > 0)
        {
            viewblocked = 1;
        }
    }
    if (alerted == 0)
    {
        if (alerttype == 0)
        {
            if (point_distance(viewpointx, viewpointy, charaHeartX(), charaHeartY()) <= radius && blind == 0)
            {
                alerted = 1;
            }
        }
        if (alerttype == 1)
        {
            if (direction >= 45 && direction <= 135)
            {
                if (point_in_rectangle(obj_mainchara.x + 20, obj_mainchara.y + 35, (x + sprite_width) - radius, y + (sprite_height / 2), x + radius, (y + (sprite_height / 2)) - ((radius * 3) / 4)))
                {
                    alerted = 1;
                }
            }
            if (direction >= 225 && direction <= 315)
            {
                if (point_in_rectangle(obj_mainchara.x + 20, obj_mainchara.y + 35, (x + sprite_width) - radius, y + (sprite_height / 2), x + radius, y + (sprite_height / 2) + ((radius * 3) / 4)))
                {
                    alerted = 1;
                }
            }
            if ((direction >= 315 && direction <= 405) || (direction >= -45 && direction <= 45))
            {
                if (point_in_rectangle(obj_mainchara.x + 20, obj_mainchara.y + 35, x + (sprite_width / 2), (y + sprite_height) - radius, x + sprite_width + radius, y + radius))
                {
                    alerted = 1;
                }
            }
            if (direction >= 135 && direction <= 225)
            {
                if (point_in_rectangle(obj_mainchara.x + 20, obj_mainchara.y + 35, x - radius, (y + sprite_height) - radius, x + (sprite_width / 2), y + radius))
                {
                    alerted = 1;
                }
            }
        }
    }
    if (viewblocked == 1)
    {
        alerted = 0;
    }
    if (alerted == 1)
    {
        speed = 0;
        pacecon = 1;
        alerttimer = 0;
        alertcon = 1;
        if (pacetype == 11)
        {
            path_end();
        }
        if (alertskip == 0)
        {
            if (noAlertSound == 0)
            {
                snd_play(snd_b);
            }
            targalarm = 20;
            if (chasetype == 8)
            {
                targalarm = 8;
            }
            excl = instance_create(x + (sprite_width / 2), y - 20, obj_excblcon);
            excl.alarm[0] = round(targalarm * global.fps_scale);
            alarm[4] = round(targalarm * global.fps_scale);
        }
        else
        {
            alertcon = 2;
        }
        alerted = 2;
    }
    if (alertcon == 2)
    {
        if (chasetype == -1)
        {
            alerttimer = 0;
            alertcon = 0;
            pacecon = 0;
        }
        if (chasetype == 0)
        {
            if (speed < (4 / global.fps_scale))
            {
                speed = 4 / global.fps_scale;
            }
            if (speed < (7 / global.fps_scale))
            {
                speed += (0.5 / global.fps_scale);
            }
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 1)
        {
            if (alerttimer == 0)
            {
                move_towards_point(targetx, targety, 10 / global.fps_scale);
            }
            alerttimer += (1 / global.fps_scale);
            if (alerttimer >= 20)
            {
                speed *= power(0.75, 1 / global.fps_scale);
            }
            if (alerttimer >= 25)
            {
                speed = 0;
            }
            if (alerttimer >= 27)
            {
                alerttimer = 0;
            }
        }
        if (chasetype == 2)
        {
            if (alerttimer == 0)
            {
                xnext = 0;
                ynext = 0;
                if (right_h())
                {
                    xnext = 132;
                }
                if (left_h())
                {
                    xnext = -132;
                }
                if (down_h())
                {
                    ynext = 132;
                }
                if (up_h())
                {
                    ynext = -132;
                }
                move_towards_point(targetx + xnext, targety + ynext, 10 / global.fps_scale);
            }
            alerttimer += (1 / global.fps_scale);
            if (alerttimer >= 20)
            {
                speed *= power(0.75, 1 / global.fps_scale);
            }
            if (alerttimer >= 25)
            {
                speed = 0;
            }
            if (alerttimer >= 27)
            {
                alerttimer = 0;
            }
        }
        if (chasetype == 3)
        {
            if (speed < (2 / global.fps_scale))
            {
                speed = 2 / global.fps_scale;
            }
            if (speed < (4 / global.fps_scale))
            {
                speed += (0.5 / global.fps_scale);
            }
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 4)
        {
            if (speed < (6 / global.fps_scale))
            {
                speed = 6 / global.fps_scale;
            }
            if (speed < (14 / global.fps_scale))
            {
                speed += (0.5 / global.fps_scale);
            }
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 5)
        {
            hspeed += (lengthdir_x(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            vspeed += (lengthdir_y(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            if (speed < (4 / global.fps_scale))
            {
                speed = 4 / global.fps_scale;
            }
            if (speed < (7 / global.fps_scale))
            {
                speed += (0.5 / global.fps_scale);
            }
            if (speed >= (7 / global.fps_scale))
            {
                speed = 7 / global.fps_scale;
            }
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 5.5)
        {
            hspeed += (lengthdir_x(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            vspeed += (lengthdir_y(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            if (speed < (startchasespeed / global.fps_scale))
            {
                speed = startchasespeed / global.fps_scale;
            }
            if (speed != (topchasespeed / global.fps_scale))
            {
                speed = lerp(speed, topchasespeed / global.fps_scale, scr_fps_lerp_rate(chaseaccel));
            }
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 6)
        {
            speed = 8 / global.fps_scale;
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 7)
        {
            if (speed == 0)
            {
                speed = 6 / global.fps_scale;
            }
            if (speed < (10 / global.fps_scale))
            {
                speed *= power(1.1, 1 / global.fps_scale);
            }
            image_speed = 0.25 / global.fps_scale;
            move_towards_point(targetx, targety, speed);
        }
        if (chasetype == 8)
        {
            mymidx = x + (sprite_width / 2);
            mymidy = y + ((bbox_bottom - y) / 2);
            if (point_distance(mymidx, mymidy, charaHeartX(), charaHeartY()) > 50)
            {
                direction = point_direction(mymidx, mymidy, charaHeartX(), charaHeartY()) + 180;
            }
            speed = 6 / global.fps_scale;
        }
        if (chasetype == 9)
        {
            hspeed += (lengthdir_x(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            vspeed += (lengthdir_y(0.5, point_direction(x, y, targetx, targety)) / global.fps_scale);
            speed = clamp(speed, minspeed / global.fps_scale, maxspeed / global.fps_scale);
            move_towards_point(targetx, targety, speed);
        }
    }
    facetimer += (1 / global.fps_scale);
    if (facetimer >= 10)
    {
        if (hspeed <= -0.2 && facing == 1)
        {
            facing = 0;
            facetimer = 0;
        }
        if (hspeed >= 0.2 && facing == 0)
        {
            facing = 1;
            facetimer = 0;
        }
    }
    if (cancelwalk == 0)
    {
        walk_index += (speed / 20);
        if (speed == 0)
        {
            walk_index = 0;
        }
    }
    else
    {
        walk_index = image_index;
    }
    if (test_release_bullet == 1)
    {
        test_release_bullet_timer += (1 / global.fps_scale);
        if (test_release_bullet_timer > 20)
        {
            bullet = instance_create(x, y, obj_encounter_bullet);
            bullet.creator = id;
            with (bullet)
            {
                move_towards_point(obj_mainchara.x + 20, obj_mainchara.y + 20, 4 / global.fps_scale);
            }
            test_release_bullet_timer = 0;
        }
    }
}
if (sprite_index == spr_werewire_hang_overworld)
{
    detectpointyoffset = -88;
    customhitbox = 1;
    hitx1 = -2;
    hitx2 = 66;
    hity1 = 42;
    hity2 = 130;
}
if (sprite_index == spr_virovirokun_idle)
{
    detectpointyoffset = -50;
}
");

Apply("gml_Object_obj_chaseenemy_Step_2", @"if (alertcon >= 1 && frozen == 0 && ignoresolid == 0)
{
    if (slide == 0)
    {
        if (collision_rectangle(bbox_left, bbox_top, bbox_right, bbox_bottom, obj_solidblock, false, true) || collision_rectangle(bbox_left, bbox_top, bbox_right, bbox_bottom, obj_solidenemy, false, true))
        {
            x -= hspeed;
            y -= vspeed;
            hspeed = 0;
            vspeed = 0;
        }
    }
    if (slide == 1)
    {
        var repositioned = 0;
        if (place_meeting(x, y, obj_solidblock) || place_meeting(x, y, obj_solidenemy))
        {
            if (!place_meeting(x - hspeed, y, obj_solidblock) && !place_meeting(x - hspeed, y, obj_solidenemy))
            {
                x -= hspeed;
                repositioned = 1;
            }
            if (!repositioned && !place_meeting(x, y - vspeed, obj_solidblock) && !place_meeting(x, y - vspeed, obj_solidenemy))
            {
                y -= vspeed;
                repositioned = 1;
            }
            if (!repositioned)
            {
                x -= hspeed;
                y -= vspeed;
            }
        }
    }
}
if (pacetype == 11)
{
    if (global.interact == 0)
    {
        if (path_speed == 0)
        {
            path_speed = pathSpeed / global.fps_scale;
        }
    }
    else
    {
        path_speed = 0;
    }
}
var dotouch = false;
if (customhitbox == 1)
{
    hitvar = collision_rectangle(x + hitx1, y + hity1, x + hitx2, y + hity2, obj_mainchara, true, true);
}
if (largetouchregion)
{
    var xx = x + (sprite_width / 2);
    var yy = y + (sprite_height / 2);
    var touched = collision_circle(xx, yy, largetouchregion, obj_mainchara, false, true);
    if (i_ex(touched))
    {
        dotouch = true;
    }
}
if ((place_meeting(x, y, obj_mainchara) && customhitbox == 0) || (customhitbox == 1 && hitvar != -4) || dotouch)
{
    if (global.interact == 0 || global.interact == 4)
    {
        if (encounterflag > 0)
        {
            global.flag[54] = encounterflag;
        }
        event_user(0);
    }
}
");

