        {
            var tool = (global.lweapon == 12) ? stringsetloc(""an eraser"", ""obj_ch4_PDC03_slash_Step_0_gml_700_0"") : stringsetloc(""a pencil"", ""obj_ch4_PDC03_slash_Step_0_gml_700_1"");
