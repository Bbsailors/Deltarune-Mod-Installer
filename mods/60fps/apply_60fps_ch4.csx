Apply("gml_Object_obj_homealone_kitchen_choco_Draw_0", @"if (!is_thrown && t == 0)
{
    draw_self();
}
if (t == 1)
{
    bounce_xpos = obj_homealone_heart.x;
    bounce_ypos = obj_homealone_heart.y;
    bounce_bottle = scr_marker(bounce_xpos, bounce_ypos, sprite_index);
    bounce_bottle.depth = depth - 100;
    base_alpha = 1;
}
if (t >= 1)
{
    var base_x = x + 10;
    var base_y = y - 10;
    xDist = base_x - bounce_xpos;
    yDist = base_y - bounce_ypos;
    smear_width = 1;
    smear_length = abs(sqrt(sqr(xDist) + sqr(yDist)));
    smear_angle = degtorad(point_direction(base_x, base_y, bounce_xpos, bounce_ypos));
    alph = 0.1 / smear_length;
    base_alpha -= (0.25 / global.fps_scale);
    for (var i = 0; i < smear_length; i += smear_width)
    {
        draw_sprite_ext(spr_noellehouse_kitchen_choco_afterimage, 0, base_x + (cos(smear_angle) * i) + (cos(smear_angle) * (smear_width / 2)), (base_y - (sin(smear_angle) * i)) + (sin(smear_angle) * (smear_width / 2)), 1, 1, 0, c_white, base_alpha * ((t / 8) + (i / smear_length)));
    }
    if (t == 2)
    {
        bounce = true;
        snd_play(snd_hurt1);
        with (obj_homealone_kitchen)
        {
            hit_heart = true;
        }
    }
    if (base_alpha <= 0)
    {
        if (loop)
        {
            t = 0;
            g = 0;
        }
        else
        {
            throw_choco = false;
            t = 0;
            g = 0;
            is_thrown = true;
        }
    }
}
if (bounce)
{
    bounce_timer += (1 / global.fps_scale);
    if (bounce_timer >= 2)
    {
        var velocity = bounce_timer * 4;
        with (bounce_bottle)
        {
            var ypos = clamp(obj_homealone_heart.y + 10, y, 212);
            if (obj_homealone_heart.image_angle < 0)
            {
                hspeed = ((y != ypos) ? -2 : 0) / global.fps_scale;
            }
            else
            {
                hspeed = ((y != ypos) ? 2 : 0) / global.fps_scale;
            }
            y = scr_movetowards(y, ypos, velocity);
        }
    }
}
");

Apply("gml_Object_obj_homealone_kitchen_choco_Step_0", @"if (throw_choco)
{
    g += 1;
    if (g >= 1)
    {
        t += (1 / global.fps_scale);
    }
}
");

Apply("gml_Object_obj_homealone_kitchen_phone_Step_0", @"if (start_speech)
{
    speech_delay_timer -= (1 / global.fps_scale);
    if (speech_delay_timer <= 0)
    {
        start_speech = false;
        speech_active = true;
        show_text = true;
    }
}
if (speech_active)
{
    if (i_ex(obj_writer))
    {
        var text_finished = false;
        with (obj_writer)
        {
            text_finished = reachedend;
        }
        if (text_finished && show_text_timer <= 0)
        {
            show_text_timer = 75;
            fade_bubble = true;
        }
    }
    else
    {
        if (stop_speech)
        {
            exit;
        }
        show_text_timer -= (1 / global.fps_scale);
        if (show_text_timer <= 0)
        {
            if (speech_index >= array_length(speech))
            {
                speech_active = false;
                exit;
            }
            draw_set_font(scr_84_get_font(""dotumche""));
            snd_play(spr_kris_phone_message);
            bg_base_alpha = 0;
            scr_flag_set(736, speech_index);
            current_text = speech[speech_index];
            global.msg[0] = current_text;
            var text_height = string_height(current_text) * 0.25;
            var text_width = string_width(current_text) * 0.75;
            var bubble = instance_create(phone_marker.x - (text_width / 2), phone_marker.y, obj_text_spikeballoon);
            bubble.y = phone_marker.y + 30;
            bubble.tailx = phone_marker.x + 12;
            bubble.taily = phone_marker.y + 15;
            bubble.w = (string_width(current_text) / 2) + 20;
            global.typer = 81;
            writer = instance_create(phone_marker.x - (text_width / 2), speech_base_ypos - text_height, obj_writer);
            writer.shake = 0.75;
            writer.rate = 4;
            writer.textscale = 0.5;
            writer.hspace = 5;
            writer.vspace = 9;
            writer.fadeonend = 0.02;
            with (writer)
            {
                skippable = 0;
            }
            speech_index++;
        }
    }
}
if (stop_speech)
{
    if (!i_ex(obj_writer))
    {
        stop_speech = false;
        instance_destroy();
    }
}
if (fade_bubble)
{
    fade_bubble_timer += (1 / global.fps_scale);
    if (fade_bubble_timer == 10)
    {
        with (obj_text_spikeballoon)
        {
            scr_lerpvar(""image_alpha"", 0.7, 0, 60);
        }
    }
    if (fade_bubble_timer == 70)
    {
        fade_bubble = false;
        fade_bubble_timer = 0;
        with (obj_text_spikeballoon)
        {
            instance_destroy();
        }
    }
}
");

