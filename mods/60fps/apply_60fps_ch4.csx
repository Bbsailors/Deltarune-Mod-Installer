    with (dead)
    {
        walkcon = 1;
        walktimer = 0;
    }
    with (shadow)
    {
        instance_destroy();
    }
}
targetx = obj_mainchara.x + (obj_mainchara.sprite_width / 2);
targety = obj_mainchara.y + (obj_mainchara.sprite_height / 2);
if (mazemode == 0)
{
    if (abs(targetx - x) <= 200 && introcon == 0)
    {
        introcon = 1;
        with (obj_mainchara)
        {
            battlemode = 1;
        }
    }
    if (introcon == 1)
    {
        attackcon = 0;
        vspeed = -2 / global.fps_scale;
        introcon = 2;
    }
    if (introcon == 2)
    {
        attacktimer = 0;
        introtimer += (1 / global.fps_scale);
        if (introtimer >= 20)
        {
            introcon = 3;
            vspeed = 0;
        }
    }
    if (introcon == 3)
    {
        friction = 0.5 / (global.fps_scale * global.fps_scale);
        if (targetx < x)
        {
            if (x <= (targetx + 150))
            {
                hspeed += (1 / global.fps_scale);
            }
            if (x >= (targetx + 250))
            {
                hspeed -= (1 / global.fps_scale);
            }
        }
        if (targetx > x)
        {
            if (x >= (targetx - 150))
            {
                hspeed -= (1 / global.fps_scale);
            }
            if (x <= (targetx - 250))
            {
                hspeed += (1 / global.fps_scale);
            }
        }
    }
}
if (mazemode == 1)
{
    if (targety <= y && introcon == 0)
    {
        introcon = 1;
        with (obj_mainchara)
        {
            battlemode = 1;
        }
    }
    if (introcon == 1)
    {
        attackcon = 0;
        vspeed = -8 / global.fps_scale;
        introcon = 2;
    }
    if (introcon == 2)
    {
        attacktimer = 0;
        introtimer += (1 / global.fps_scale);
        if (introtimer >= 5)
        {
            introcon = 3;
            vspeed = 0;
            attacktimer = 36;
        }
    }
    if (introcon == 3)
    {
        friction = 0.7 / (global.fps_scale * global.fps_scale);
        if (targety < (y - 20))
        {
            vspeed -= (1.5 / global.fps_scale);
        }
        if (targety > (y + 20))
        {
            vspeed += (1.5 / global.fps_scale);
        }
    }
}
if (beatcon == 0)
{
    if (attackcon >= 0)
    {
        if (obj_mainchara.battlemode == 1)
        {
            attacktimer += (1 / global.fps_scale);
        }
    }
    if (attackcon == 0)
    {
        wingtimer += (1 / global.fps_scale);
        if (wingtimer >= 0)
        {
            snd_play(snd_wing);
            wingtimer = -16;
        }
    }
    if (attacktimer >= 42 && attackcon == 0)
    {
        wingtimer = 0;
        shakefactor = 6;
        attackcon = 1;
        if (shot == 1)
        {
            for (i = 0; i < 3; i += 1)
            {
                with (starbullet[i])
                {
                    instance_destroy();
                }
            }
        }
    }
    if (attacktimer >= 60 && attackcon == 1)
    {
        snd_play(snd_crow);
        attackcon = 2;
        shot = 1;
        for (i = 0; i < 3; i += 1)
        {
            starbullet[i] = instance_create(x + (17 * xmake), y + 42, obj_overworldbulletparent);
            starbullet[i].sprite_index = spr_starbullet_test;
            starbullet[i].image_xscale = 2;
            starbullet[i].image_yscale = 2;
            starbullet[i].damage = 15;
            starbullet[i].active = 1;
            starbullet[i].target = 3;
            starbullet[i].speed = 10 / global.fps_scale;
            starbullet[i].friction = -0.2 / (global.fps_scale * global.fps_scale);
            starbullet[i].direction = (point_direction(x + (17 * xmake), y + 42, obj_mainchara.x + (xcheck_average * 10) + (obj_mainchara.sprite_width / 2), obj_mainchara.y + (obj_mainchara.sprite_height / 2)) - 17) + (17 * i);
            starbullet[i].depth = 1000;
        }
    }
    if (attacktimer >= 80)
    {
        siner = 0;
        wing_index = 0;
        attackcon = 0;
        attacktimer = 0;
        if (mazemode == 1)
        {
            attacktimer = 38;
        }
    }
}
if (i_ex(shadow))
{
