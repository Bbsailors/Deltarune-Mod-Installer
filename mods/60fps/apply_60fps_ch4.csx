            global.mercymod[myself] += 120;
        }
        if (global.mercymod[myself] >= global.mercymax[myself])
        {
            global.msg[0] = """";
        }
    }
    if (acting == 2)
    {
        if (acttimer == 0)
        {
            global.msg[0] = """";
