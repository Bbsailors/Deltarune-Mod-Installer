    c_facenext(""ralsei"", ""Q"");
    c_msgnextloc(""\\EQ* Yes..^1. it is^1, a big deal^1, Susie!/"", ""obj_dw_church_shadowgerson_slash_Step_0_gml_143_0"");
    c_facenext(""susie"", ""7"");
