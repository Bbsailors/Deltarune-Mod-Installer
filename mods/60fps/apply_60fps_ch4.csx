    con = 6;
}
if (excl == 1)
{
    excl = 0;
    with (obj_actor)
    {
        if (name == ""susie"")
        {
            var doomtime = 20;
            with (scr_marker_ext(x + 20, y - 20, spr_exc, 2, 2, undefined, undefined, undefined, depth - 1, undefined, doomtime))
            {
                vspeed = -3 / global.fps_scale;
                gravity = 0.7 / (global.fps_scale * global.fps_scale);
                scr_limitval_upper(id, ""y"", y);
