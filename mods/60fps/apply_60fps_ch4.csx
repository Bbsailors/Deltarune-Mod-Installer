    var t2x2 = x1 + (w / 3) + (random_range(-2, 2) * r);
    var t2y2 = t2y1;
    var t2x3 = ((t2x1 + t2x2) / 2) + 1;
    var t2y3 = y1 - 3;
    d_triangle(x1 + (w / 3), y1, x1 + ((w / 3) * 2), y1, t2x1, t2y1, false);
