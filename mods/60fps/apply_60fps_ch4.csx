if (act == 1)
{
    hspeed *= power(0.99, 1 / global.fps_scale);
    sprite_index = spr_lancer_wave;
    image_index = max(4, image_index);
    if (y < 200)
    {
        vspeed *= power(0.95, 1 / global.fps_scale);
    }
}
if (image_index > 8)
{
    image_index = 4;
}
if (y > room_height)
{
    scr_sparkle(8);
    with (obj_mike_minigame_controller)
    {
        game_over = true;
    }
    instance_destroy();
}
if (hits >= max_hits)
{
    act = 2;
    gravity_direction = 90;
}
if (act == 2)
{
    sprite_index = spr_lancer_wave;
    image_index = max(4, image_index);
    if (y < -32)
