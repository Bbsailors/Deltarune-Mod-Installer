    }
}
if (timer > (75 + (110 * small)) && tutu < 2 && !fully_aggro && polite != 2)
{
    if (move_directly)
    {
        x += (lengthdir_x(direct_spd, direct_dir) / global.fps_scale);
        y += (lengthdir_y(direct_spd, direct_dir) / global.fps_scale);
        direct_spd = scr_approach_curve(direct_spd, 3, 52 + adjust_delay);
        if (abs(angle_difference(direct_dir, scr_at_player(x, y))) > 60 || direct_adjust)
        {
            if (direct_adjust > 0)
            {
                direct_adjust -= (1 / global.fps_scale);
            }
            else
            {
                direct_adjust = ceil(adjust_delay);
                adjust_delay *= power(0.9, 1 / global.fps_scale);
            }
            direct_spd = 0.99;
            if (direct_adjust > 0)
            {
                direct_dir += (angle_difference(scr_at_player(x, y), direct_dir) / direct_adjust / global.fps_scale);
            }
        }
    }
    else
    {
        if (!pause && !(polite && place_meeting(x, y, obj_heart)))
        {
            path_speed = scr_approach_curve(path_speed, (3.5 - (2 * polite)) / global.fps_scale, 30 + (40 * power(path_speed * global.fps_scale, 0.8)) + (10 * polite), 0.1 / global.fps_scale);
        }
        if (point_distance(x, y, path_get_point_x(path, point_reached), path_get_point_y(path, point_reached)) < path_speed && polite >= 0 && obj_growtangle.sprite_index != spr_ghost_house_yourtutu)
        {
