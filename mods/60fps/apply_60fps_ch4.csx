Apply("gml_Object_obj_homealone_dess_ornament_Step_0", @"event_inherited();
if (drop_ornament)
{
    drop_timer += (1 / global.fps_scale);
    if (drop_timer == 1)
    {
        gravity = 0.5 / (global.fps_scale * global.fps_scale);
        friction = 0.1 / (global.fps_scale * global.fps_scale);
    }
    if (drop_timer == 13)
    {
        with (obj_homealone_dess_closet_controller)
        {
            hit_tree = true;
        }
        vspeed = -vspeed / 2;
        hspeed = -0.5 / global.fps_scale;
    }
    if (drop_timer == 18)
