                tile_index[idx][tmidx] = tilemap_get_at_pixel(tm_tileset[tmidx], arg0 + (tile_width_fine * (i + 2)), arg1 + (tile_height_fine * ii));
                if (tile_index[idx][tmidx] != ti)
