        xscale = -xscale;
        motion_set(direction, 0.25 / global.fps_scale);
    }
}
if (action == 5)
{
    if (lastaction != 5)
    {
        sprite_index = spr_mike_cat_hold_outline;
        if ((abs(hspeed) + abs(vspeed)) > 22)
        {
            snd_play(snd_criticalswing);
            is_launched = true;
        }
        else
        {
            snd_play(snd_wing);
            is_launched = false;
        }
    }
    if (is_launched)
    {
        if ((global.time % global.fps_scale) == 0)
        {
            with (scr_afterimage())
            {
                image_alpha = 0.3;
            }
        }
    }
    if (y >= (cameray() + 310))
    {
        vspeed = 0;
        y = cameray() + 310;
        gravity = 0;
        friction = 0;
        side = choose(1, -1);
        xscale = side;
        hspeed = (side * irandom_range(3, 5)) / global.fps_scale;
        sprite_index = spr_mike_cat_walk_outline;
        action = 0;
    }
    else
    {
        if (y < 0)
        {
            y = 0;
            vspeed = -vspeed;
        }
        gravity = 1 / (global.fps_scale * global.fps_scale);
    }
    if (x > (camerax() + camerawidth()))
    {
        hspeed = -hspeed;
    }
    if (x < camerax())
    {
        hspeed = -hspeed;
    }
}
lastaction = action;

enum e__VW
{
