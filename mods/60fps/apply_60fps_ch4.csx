    if (i_ex(global.cinstance[1]))
    {
        global.cinstance[1].x -= xdiff;
        for (i = 25; i >= 0; i -= 1)
        {
            global.cinstance[1].remx[i] -= xdiff;
        }
    }
    whitecon = 2;
}
if (room == 9999999999999)
{
