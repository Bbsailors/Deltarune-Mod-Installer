        c_msgsetloc(0, ""* ..^1. what? You want to give me your TV?/"", ""obj_town_north_slash_Step_0_gml_40_0"");
        c_msgnextloc(""* I..^1. don't understand. Is there some kind of catch?/"", ""obj_town_north_slash_Step_0_gml_41_0"");
