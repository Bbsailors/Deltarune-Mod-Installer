obj_rotating_tower_controller_new.copy_tilemap_image_index = function(arg0, arg1, arg2, arg3)
{
    var changed = 0;
    for (i = 0; i < 2; i++)
    {
        for (ii = 0; ii < 2; ii++)
        {
            var tilex = (arg2 / tile_width_fine) + i;
            var tiley = (arg3 / tile_height_fine) + ii;
            for (tmidx = 0; tmidx < tileset_count; tmidx++)
            {
