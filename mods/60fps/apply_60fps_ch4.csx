                }
                else
                {
                    scr_speaker(""no_name"");
                    msgsetloc(0, ""* And..^1. she was muttering something like..^1. \""You don't scare me\""...?/%"", ""obj_npc_room_slash_Other_10_gml_895_0_b"");
