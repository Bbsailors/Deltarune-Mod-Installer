        performer.animspeed = 0.5;
        performer.mid = spr_ralsei_sing_polite;
        performer.idle = spr_ralsei_sing_polite_closed;
    }
    performer.image_xscale = 2;
    performer.image_yscale = 2;
    performer.depth = depth - 10;
