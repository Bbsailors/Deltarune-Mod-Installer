    {
        draw_set_font(global.damagefontgold);
    }
    if (hspeed > 0)
    {
        hspeed -= (1 / (global.fps_scale * global.fps_scale));
    }
    if (hspeed < 0)
    {
        hspeed += (1 / (global.fps_scale * global.fps_scale));
    }
    if (abs(hspeed) < 1)
    {
        hspeed = 0;
    }
    if (nohbounce)
    {
        hspeed = 0;
