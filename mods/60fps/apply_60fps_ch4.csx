        skipped = 1;
    }
    if (skipped == 1)
    {
        skiptimer += 1;
        if (skiptimer >= 28)
        {
            room_speed = global.TARGET_FPS;
        }
        if (skiptimer >= ((30 * global.TARGET_FPS) / 15))
        {
            room_goto(PLACE_MENU);
        }
    }
}
");

