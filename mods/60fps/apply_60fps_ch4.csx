            {
                con = 1;
            }
            with (obj_holywater_spiral)
            {
                instance_destroy();
            }
            with (obj_regularbullet)
            {
                if (object_index != obj_mizzle_spotlight_eye)
                {
                    instance_destroy();
                }
            }
            break;
        }
    }
}
");

