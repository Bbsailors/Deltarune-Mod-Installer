Apply("gml_Object_obj_panner_Step_0", @"var _rx = __view_get(e__VW.XView, 0) + panx + panresidx;
var _ry = __view_get(e__VW.YView, 0) + pany + panresidy;
var _sx = round(_rx);
var _sy = round(_ry);
panresidx = _rx - _sx;
panresidy = _ry - _sy;
__view_set(e__VW.XView, 0, _sx);
__view_set(e__VW.YView, 0, _sy);
pantimer += 1;
if (pantimer >= panmax)
{
    instance_destroy();
}

