    choice = instance_create(100, 120, DEVICE_CHOICE);
    EVENT = 5;
}
if (EVENT == 5)
{
    if (global.choice == 0)
    {
        with (obj_writer)
        {
            instance_destroy();
        }
        EVENT = 6;
    }
    if (global.choice == 1)
    {
        with (obj_writer)
        {
            instance_destroy();
        }
        EVENT = 26;
    }
}
if (EVENT == 6)
{
    snd_free_all();
    global.flag[6] = 1;
    global.msg[0] = scr_84_get_lang_string(""DEVICE_FAILURE_slash_Step_0_gml_68_0"");
    W = instance_create(50, 80, obj_writer);
    EVENT = 7;
    alarm[4] = round(30 * global.fps_scale);
    if (global.tempflag[3] >= 1)
    {
        with (obj_writer)
        {
            instance_destroy();
        }
        alarm[4] = round(1 * global.fps_scale);
    }
}
if (EVENT == 8)
{
    WHITEFADE = 1;
    FADEUP = 0.01 / global.fps_scale;
    EVENT = 9;
    alarm[4] = round(120 * global.fps_scale);
    if (global.tempflag[3] >= 1)
    {
        FADEUP = 0.03 / global.fps_scale;
        alarm[4] = round(45 * global.fps_scale);
    }
    global.tempflag[3] += 1;
}
if (EVENT == 10)
{
    scr_windowcaption(scr_84_get_lang_string(""DEVICE_FAILURE_slash_Step_0_gml_95_0""));
    scr_tempload();
    EVENT = 11;
}
if (EVENT == 26)
{
    snd_free_all();
    global.msg[0] = scr_84_get_lang_string(""DEVICE_FAILURE_slash_Step_0_gml_103_0"");
    EVENT = 27;
    W = instance_create(60, 80, obj_writer);
}
if (EVENT == 27 && !instance_exists(obj_writer))
{
    global.currentsong[0] = snd_init(""AUDIO_DARKNESS.ogg"");
    global.currentsong[1] = mus_play(global.currentsong[0]);
    EVENT = 28;
    DARK_WAIT = 0;
}
if (EVENT == 28)
{
    DARK_WAIT += 1;
    if (DARK_WAIT >= round(2040 * global.fps_scale))
    {
        ossafe_game_end();
    }
    if (!snd_is_playing(global.currentsong[1]))
    {
        ossafe_game_end();
    }
    if (os_type == os_ps4 || os_type == os_ps5 || scr_is_switch_os())
    {
        if (DARK_WAIT >= round(90 * global.fps_scale) && !restart)
        {
            for (var i = 0; i < array_length_1d(gamepad_controls); i++)
            {
                if (gamepad_button_check_pressed(obj_gamecontroller.gamepad_id, gamepad_controls[i]))
                {
                    if (gamepad_controls[i] == global.button0 || gamepad_controls[i] == global.button1 || gamepad_controls[i] == global.button2 || gamepad_controls[i] == gp_shoulderlb)
                    {
                        mus_volume(global.currentsong[1], 0, 80);
                        restart = true;
                        break;
                    }
                }
            }
        }
        if (restart)
        {
            restart_timer += (1 / global.fps_scale);
            if (restart_timer >= 100)
            {
                ossafe_game_end();
            }
        }
    }
}
if (EVENT >= 0 && EVENT <= 4)
{
    if (button2_h())
    {
        var _step = (global.flag[965] == 1) ? 2 : round(2 / global.fps_scale);
        var _spec = (global.flag[965] == 1) ? 0.1 : (0.1 / global.fps_scale);
        with (obj_writer)
        {
            if (pos < (length - 3))
            {
                pos += _step;
            }
            if (specfade <= 0.9)
            {
                specfade -= _spec;
            }
            if (rate <= 1)
            {
                rate = 1;
            }
        }
    }
}
");

Apply("gml_Object_DEVICE_GONERMAKER_Draw_0", @"FA = (10 - FADEBUFFER) / 10;
if (FA > 1)
{
    FA = 1;
}
for (k = 0; k < STEP; k += 1)
{
    img = IMAGE_GONERHEAD;
    if (k == 1)
    {
        img = IMAGE_GONERBODY;
    }
    if (k == 2)
    {
        img = IMAGE_GONERLEGS;
    }
    if (LOCK[k] == 1)
    {
        s_size = abs(sin(siner / 16) / 2);
        draw_sprite_ext(img, PART[k], x - ((s_size * sprite_width) / 2), (y + sy[k]) - ((s_size * sprite_height) / 2), 2 + s_size, 2 + s_size, 0, c_white, 0.4 * FA);
        s_size = abs(sin(siner / 21) / 2);
        draw_sprite_ext(img, PART[k], x - ((s_size * sprite_width) / 2), (y + sy[k]) - ((s_size * sprite_height) / 2), 2 + s_size, 2 + s_size, 0, c_white, 0.4 * FA);
    }
}
if (CANCEL == 0)
{
    draw_sprite_ext(IMAGE_SOUL_BLUR, 0, initx + 10, inity - 30, 1, 1, 0, c_white, 1 * FA);
}
for (j = 0; j < STEP; j += 1)
{
    img = IMAGE_GONERHEAD;
    if (j == 1)
    {
        img = IMAGE_GONERBODY;
    }
    if (j == 2)
    {
        img = IMAGE_GONERLEGS;
    }
    if (s == j)
    {
        for (i = 0; i <= PARTMAX[j]; i += 1)
        {
            alpha = 1 - (abs(PARTX[j] + (i * 50)) / 120);
            draw_sprite_ext(img, i, x + PARTX[j] + (i * 50), y + sy[j], 2, 2, 0, image_blend, alpha * FA);
        }
    }
    else
    {
        draw_sprite_ext(img, PART[j], x, y + sy[j], 2, 2, 0, image_blend, 1 * FA);
    }
}
NAMEFADE_COMPLETE = 0;
if (instance_exists(DEVICE_CHOICE))
{
    if (DEVICE_CHOICE.TYPE == 3)
    {
        NAMEFADE_COMPLETE = 1;
        NAMEFADE += (0.03 / global.fps_scale);
        NAMEFADE *= power(1.25, 1 / global.fps_scale);
        if (NAMEFADE >= 1)
        {
            NAMEFADE = 1;
        }
    }
}
if (NAMEFADE_COMPLETE == 0)
{
    NAMEFADE -= (0.03 / global.fps_scale);
    NAMEFADE *= power(0.75, 1 / global.fps_scale);
    if (NAMEFADE <= 0)
    {
        NAMEFADE = 0;
    }
}
image_blend = merge_color(c_white, c_black, NAMEFADE);
");

Apply("gml_Object_DEVICE_GONERMAKER_Step_0", @"siner += (1 / global.fps_scale);
x = initx + (sin(siner / 24) * 2);
y = inity + (cos(siner / 30) * 2);
if (FINISH == 0 && ONEBUFFER < 0 && CANCEL == 0)
{
    if (left_p())
    {
        PART[s] -= 1;
    }
    if (right_p())
    {
        PART[s] += 1;
    }
    if (button1_p() && LOCK[s] == 1)
    {
        FINISH = 1;
        global.flag[900 + s] = PART[s];
        global.flag[20] = 1;
    }
}
for (i = 0; i < 3; i += 1)
{
    if (PART[i] > PARTMAX[i])
    {
        PART[i] = PARTMAX[i];
    }
    if (PART[i] < 0)
    {
        PART[i] = 0;
    }
    IDEALX[i] = PART[i] * -50;
    if (PARTX[i] < IDEALX[i])
    {
        if (abs(IDEALX[i] - PARTX[i]) >= 0)
        {
            PARTX[i] += 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 50)
        {
            PARTX[i] += 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 100)
        {
            PARTX[i] += 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 150)
        {
            PARTX[i] += 10 / global.fps_scale;
        }
    }
    if (PARTX[i] > IDEALX[i])
    {
        if (abs(IDEALX[i] - PARTX[i]) >= 0)
        {
            PARTX[i] -= 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 50)
        {
            PARTX[i] -= 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 100)
        {
            PARTX[i] -= 10 / global.fps_scale;
        }
        if (abs(IDEALX[i] - PARTX[i]) > 150)
        {
            PARTX[i] -= 10 / global.fps_scale;
        }
    }
    if (PARTX[i] == IDEALX[i])
    {
        LOCK[i] = 1;
    }
    else
    {
        LOCK[i] = 0;
    }
}
ONEBUFFER -= (1 / global.fps_scale);
if (FADEBUFFER > 0 && FINISH <= 0)
{
    FADEBUFFER -= (1 / global.fps_scale);
}
if (FINISH == 1)
{
    FADEBUFFER += (1 / global.fps_scale);
}
if (FADEBUFFER > 10)
{
    instance_destroy();
}
");

Apply("gml_Object_DEVICE_MENU_Draw_0", @"scr_84_set_draw_font(""main"");
if (BGMADE == 1)
{
    ANIM_SINER += (1 / global.fps_scale);
    ANIM_SINER_B += (1 / global.fps_scale);
    BG_SINER += (1 / global.fps_scale);
