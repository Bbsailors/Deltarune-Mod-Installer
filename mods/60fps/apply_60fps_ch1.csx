        if (s_yscale <= 2)
        {
            s_yscale = 2;
        }
    }
    if (timer >= 30 && timer < 41)
    {
        spintimer += (1 / global.fps_scale);
        s_xscale = sin(spintimer / 3) * 2;
        s_vspeed -= (3 / global.fps_scale);
        s_y += (s_vspeed / global.fps_scale);
        s_alpha -= (0.1 / global.fps_scale);
    }
    if (timer >= 41)
    {
        if (instance_exists(obj_battlecontroller))
        {
            if (global.turntimer > 10)
            {
                timer = 0;
                condition = 4;
            }
        }
    }
    draw_sprite_ext(s_sprite, 0, offx, offy + s_y, s_xscale, s_yscale, 0, image_blend, s_alpha);
}
if (condition == 0 || condition == 1)
