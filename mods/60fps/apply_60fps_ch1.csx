    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

Apply("gml_Object_obj_ob_gen_Step_0", @"if (room == room_field_checkers1)
{
    if (timer >= 900)
    {
        instance_create(1202, 240, obj_ob_checkertile);
        instance_create(1242, 280, obj_ob_checkertile);
        instance_create(1282, 320, obj_ob_checkertile);
        instance_create(962, 240, obj_ob_checkertile);
        instance_create(1002, 280, obj_ob_checkertile);
        instance_create(1042, 320, obj_ob_checkertile);
        instance_create(722, 240, obj_ob_checkertile);
        instance_create(762, 280, obj_ob_checkertile);
        instance_create(802, 320, obj_ob_checkertile);
    }
    if (obj_mainchara.x >= 4000 && obj_mainchara.x <= 1620)
    {
        obj_mainchara.battlemode = 1;
    }
    else
    {
        obj_mainchara.battlemode = 0;
    }
    if (global.interact == 0)
    {
        timer += (1 / global.fps_scale);
    }
    if (timer >= 40)
    {
        timer = 0;
        ch = con * 40;
        instance_create(1442 - ch, 240 + ch, obj_ob_checkertile);
        con += 1;
        if (con > 2)
        {
            con = 0;
        }
    }
}
if (whitetimer >= 20 && whitecon == 1)
{
    xdiff = obj_mainchara.x - 340;
    obj_mainchara.x = 340;
    if (instance_exists(global.cinstance[0]))
    {
        global.cinstance[0].x -= xdiff;
        i = round(25 * global.fps_scale);
        while (i >= 0)
        {
            global.cinstance[0].remx[i] -= xdiff;
            i -= 1;
        }
    }
    if (instance_exists(global.cinstance[1]))
    {
        global.cinstance[1].x -= xdiff;
        i = round(25 * global.fps_scale);
        while (i >= 0)
        {
            global.cinstance[1].remx[i] -= xdiff;
            i -= 1;
        }
    }
    whitecon = 2;
}
if (room == room_field_checkers4 || room == room_field_checkers6)
{
    if (obj_mainchara.x >= 4000 && obj_mainchara.x <= 1620)
    {
        obj_mainchara.battlemode = 1;
    }
    else
    {
        obj_mainchara.battlemode = 0;
    }
}
");

Apply("gml_Object_obj_oflash_Draw_0", @"if (instance_exists(target))
{
    image_index = target.image_index;
    sprite_index = target.sprite_index;
}
siner += (flashspeed / global.fps_scale);
d3d_set_fog(true, flashcolor, 0, 1);
draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, sin(siner / 3));
d3d_set_fog(false, c_black, 0, 0);
if (siner > 4 && sin(siner / 3) < 0)
{
    instance_destroy();
}
");

Apply("gml_Object_obj_onion_event_Step_0", @"if (instance_exists(obj_mainchara))
{
    if (onioncount > 0)
    {
        onioncount -= 1;
    }
    if (global.flag[258] == 0)
    {
        if (onioncount >= round(200 * global.fps_scale) && con == 0 && global.flag[258] == 0)
        {
            global.flag[258] = 1;
            onioncount = 1;
            global.facing = 1;
            con = 1;
            alarm[4] = round(10 * global.fps_scale);
            global.interact = 1;
        }
    }
    if (con == 2)
    {
        with (onion)
        {
            on = 1;
        }
        con = 3;
        alarm[4] = round(50 * global.fps_scale);
    }
    if (con == 4)
    {
        global.facing = 1;
        with (onion)
        {
            on = 2;
        }
        con = 5;
        alarm[4] = round(150 * global.fps_scale);
    }
    if (con == 6)
    {
        global.fc = 0;
        global.typer = 5;
        global.msc = 195;
        scr_text(global.msc);
        instance_create(0, 0, obj_dialoguer);
        con = 7;
    }
    if (con == 7 && !d_ex())
    {
        global.interact = 1;
        onion.on = 4;
        con = 8;
        alarm[4] = round(150 * global.fps_scale);
    }
    if (con == 9)
    {
        with (onion)
        {
            instance_destroy();
        }
        con = 10;
        global.interact = 0;
        global.facing = 0;
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_onionbody_Draw_0", @"siner += (1 / global.fps_scale);
if (on >= 1 && on <= 4)
{
    if (on == 1 && special == 1)
    {
        special = 2;
    }
    if (on == 1 || on == 2 || on == 3)
    {
        if (onion_blue_alpha < 1)
        {
            onion_blue_alpha += (0.05 / global.fps_scale);
        }
    }
    draw_sprite_ext(spr_onionblue, 0, x, y, 0.1 + onion_blue_alpha + (sin(siner / 4) * 0.05), onion_blue_alpha + (sin(siner / 4) * 0.05), 0, c_white, onion_blue_alpha);
}
if (on == 2 || on == 3 || on == 4)
{
    if (global.flag[20] == 0)
    {
        onionsprite = spr_onionsan_kawaii;
    }
    if (global.flag[20] == 1)
    {
        onionsprite = spr_onionsan_yhear;
    }
    if (global.flag[20] == 2)
    {
        onionsprite = spr_onionsan_wistful;
    }
    if (global.flag[20] == 3)
    {
        onionsprite = spr_onionsan_disappoint;
    }
    if (global.flag[20] == 4)
    {
        onionsprite = spr_onionsan_sing;
    }
    if (global.flag[20] == 5)
    {
        onionsprite = spr_onionsan_menace;
    }
    draw_sprite_part(onionsprite, floor(siner / 6), 0, 0, 63, floor(onionh), x - 32, y - floor(onionh));
    if (on == 2 || on == 3)
    {
        if (onionh < 63)
        {
            onionh += (0.5 / global.fps_scale);
        }
    }
    if (on == 4)
    {
        if (onionh > 0)
        {
            onionh -= (0.5 / global.fps_scale);
        }
        else if (onion_blue_alpha > 0)
        {
            onion_blue_alpha -= (0.05 / global.fps_scale);
        }
    }
}
");

