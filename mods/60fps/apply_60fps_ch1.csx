    {
        for (t = 0; t < 16; t += 1)
        {
            bul[t] = instance_create(-20, -20, obj_regularbullet_permanent);
            bul[t].damage = damage;
            with (bul[t])
            {
                grazepoints = 2;
                timepoints = 1;
                depth = 0;
                image_alpha = 0;
                sprite_index = spr_heartbullet;
            }
        }
        made = 1;
    }
    if (type == 0)
    {
        if (radius > maxradius)
        {
            radius -= (5 / global.fps_scale);
        }
        else
        {
            radius += (sin(siner / 10) / 2 / global.fps_scale);
        }
    }
    if (type == 1)
    {
        if (radius > maxradius && radcon == 0)
        {
            radius -= (4 / global.fps_scale);
        }
        else
        {
            radcon = 1;
            radius += (8 / global.fps_scale);
            active = 0;
            image_alpha -= (0.1 / global.fps_scale);
        }
    }
    dir += (2 / global.fps_scale);
    siner += (1.5 / global.fps_scale);
    tcount = 0;
    for (t = 0; t < 16; t += 1)
    {
        if (instance_exists(bul[t]))
        {
            tcount += 1;
            if (radcon == 0)
            {
                with (bul[t])
                {
                    if (image_alpha < 1)
                    {
                        image_alpha += (0.1 / global.fps_scale);
                    }
                }
            }
            xx = sin(((pi * t) / 8) + (siner / 20)) * radius;
            yy = cos(((pi * t) / 8) + (siner / 20)) * radius;
            xxx = thisx + 8 + xx;
            yyy = (thisy + 8) - yy;
            bul[t].x = xxx;
            bul[t].y = yyy;
            if (radcon == 1)
            {
                with (bul[t])
                {
                    image_alpha -= (0.1 / global.fps_scale);
                    active = 0;
                    if (image_alpha <= 0.1)
                    {
                        instance_destroy();
                    }
                }
            }
        }
    }
    if (tcount == 0)
    {
        instance_destroy();
    }
}
