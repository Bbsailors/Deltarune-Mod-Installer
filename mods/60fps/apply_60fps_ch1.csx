Apply("gml_Object_obj_caterpillarchara_Step_2", @"scr_depth();
depth += 5;
nowx = x;
nowy = y;
moved = 0;
walk = 0;
runmove = 0;
if (obj_mainchara.x != remx[0])
{
    moved = 1;
}
if (obj_mainchara.y != remy[0])
{
    moved = 1;
}
if (moved == 1)
{
    blushtimer = 0;
    i = round(25 * global.fps_scale);
    while (i > 0)
    {
        remx[i] = remx[i - 1];
        remy[i] = remy[i - 1];
        facing[i] = facing[i - 1];
        i -= 1;
    }
    remx[0] = obj_mainchara.x;
    remy[0] = obj_mainchara.y;
    facing[0] = global.facing;
    if (usprite == spr_susieu_dark)
    {
        x = remx[target] - 6;
    }
    else
    {
        x = remx[target] - 4;
    }
    if (usprite == spr_susieu_dark)
    {
        y = remy[target] - 16;
    }
    else
    {
        y = remy[target] - 12;
    }
    if (abs(remx[target + 1] - remx[target]) > (4 / global.fps_scale))
    {
        runmove = 1;
    }
    if (abs(remy[target + 1] - remy[target]) > (4 / global.fps_scale))
    {
        runmove = 1;
    }
    dir = facing[target];
}
if (x != nowx)
{
    walk = 1;
}
if (y != nowy)
{
    walk = 1;
}
if (walk == 1)
{
    walkbuffer = 6;
}
if (walkbuffer > 3 && fun == 0)
{
    walktimer += (1.5 / global.fps_scale);
    if (runmove == 1)
    {
        walktimer += (1.5 / global.fps_scale);
    }
    if (walktimer >= 40)
    {
        walktimer -= 40;
    }
    if (walktimer < 10)
    {
        image_index = 0;
    }
    if (walktimer >= 10)
    {
        image_index = 1;
    }
    if (walktimer >= 20)
    {
        image_index = 2;
    }
    if (walktimer >= 30)
    {
        image_index = 3;
    }
}
if (walkbuffer <= 0 && fun == 0)
{
    if (walktimer < 10)
    {
        walktimer = 9.5;
    }
    if (walktimer >= 10 && walktimer < 20)
    {
        walktimer = 19.5;
    }
    if (walktimer >= 20 && walktimer < 30)
    {
        walktimer = 29.5;
    }
    if (walktimer >= 30)
    {
        walktimer = 39.5;
    }
    image_index = 0;
}
walkbuffer -= (0.75 / global.fps_scale);
if (fun == 0)
{
    if (facing[target] == 0)
    {
        sprite_index = dsprite;
    }
    if (facing[target] == 1)
    {
        sprite_index = rsprite;
    }
    if (facing[target] == 2)
    {
        sprite_index = usprite;
    }
    if (facing[target] == 3)
    {
        sprite_index = lsprite;
    }
}
if (dsprite == spr_ralseid && global.interact == 0 && fun == 0)
{
    distfrommcx = obj_mainchara.x - (x + 4);
    distfrommcy = obj_mainchara.y - (y + 12);
    if (abs(distfrommcy) <= 10 && abs(distfrommcx) <= 16)
    {
        if (distfrommcx <= 0 && global.facing == 1)
        {
            blushtimer += (1 / global.fps_scale);
        }
        if (distfrommcx >= 0 && global.facing == 3)
        {
            blushtimer += (1 / global.fps_scale);
        }
    }
    else
    {
        blushtimer = 0;
    }
    if (blushtimer >= 300)
    {
        if (sprite_index == dsprite)
        {
            sprite_index = dsprite_blush;
        }
        if (sprite_index == rsprite)
        {
            sprite_index = rsprite_blush;
        }
        if (sprite_index == usprite)
        {
            sprite_index = usprite_blush;
        }
        if (sprite_index == lsprite)
        {
            sprite_index = lsprite_blush;
        }
    }
}
else
{
    blushtimer = 0;
}
");

