Apply("gml_Object_obj_placeholderenemy_Draw_0", @"if (state == 3)
{
    hurttimer -= (1 / global.fps_scale);
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        if (global.monster[myself] == 0)
        {
            hspeed = 12 / global.fps_scale;
            turnt -= 8;
            vspeed = -4 / global.fps_scale;
        }
        hurtshake += 1;
        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= 1;
            }
            if (shakex < 0)
            {
                shakex += 1;
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(spr_diamondm_hurt, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
    }
}
if (state == 0)
{
    siner += (1 / global.fps_scale);
    thissprite = spr_diamondm_idle;
    if (global.mercymod[myself] >= global.mercymax[myself])
    {
        thissprite = spr_diamondm_spared;
    }
    draw_sprite_ext(thissprite, siner / 5, x, y, 2, 2, 0, image_blend, 1);
    if (flash == 1)
    {
