        {
            rotspeed += (1 / (global.fps_scale * global.fps_scale));
        }
    }
    if (un == 1)
    {
        if (rotspeed >= (-10 / global.fps_scale))
        {
            rotspeed -= (1 / (global.fps_scale * global.fps_scale));
        }
    }
    sine += sinespeed;
    dir += dirspeed;
    if (insanity == 1)
    {
        if (dirspeed > 0 && dirspeed < (3 / global.fps_scale))
        {
            dirspeed += (0.01 / (global.fps_scale * global.fps_scale));
        }
        if (dirspeed < 0 && dirspeed > (-3 / global.fps_scale))
        {
            dirspeed -= (0.01 / (global.fps_scale * global.fps_scale));
