        {
            t = ((i * 2 * pi) / 20) + (siner / 60);
            xx = 16 * (sin(t) * sin(t) * sin(t));
            yy = (13 * cos(t)) - (5 * cos(2 * t)) - (2 * cos(3 * t)) - cos(4 * t);
            xxx = obj_heart.x + 8 + (xx * radius);
            yyy = (obj_heart.y + 8) - (yy * radius);
            draw_sprite(spr_heartbullet, 0, xxx, yyy);
        }
    }
}
if (actual == 1)
{
