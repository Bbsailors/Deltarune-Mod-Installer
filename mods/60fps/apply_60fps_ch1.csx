Apply("gml_Object_obj_npc_hammerguy_Step_0", @"if (myinteract == 3)
{
}
if (myinteract == 3 && con == 0)
{
    if (instance_exists(mydialoguer) == false)
    {
        sprite_index = spr_hammerguy;
        image_speed = 0.1 / global.fps_scale;
        global.interact = 0;
        myinteract = 0;
        with (obj_mainchara)
        {
            onebuffer = 5;
        }
    }
}
if (con >= 5)
{
    if (con == 10 || con == 30 || con == 50)
    {
        if (!d_ex())
        {
            snd_pause(global.currentsong[1]);
            sprite_index = spr_hammerguy_powerup;
            image_index = 0;
            image_speed = 0.5 / global.fps_scale;
            snd_play(snd_noise);
            con += 1;
            alarm[4] = round(30 * global.fps_scale);
            charcycle = 0;
            charamt = 0;
            if (global.char[1] > 0)
            {
                charamt = 1;
            }
            if (global.char[2] > 0)
            {
                charamt = 2;
            }
            charcycle = charamt;
        }
    }
    if (con == 12 || con == 32 || con == 52)
    {
        hitmode = 1;
        sprite_index = spr_hammerguy_hit;
        image_speed = 0.5 / global.fps_scale;
        image_index = 0;
        con += 1;
    }
    if (con == 15)
    {
        with (char)
        {
            instance_destroy();
        }
        with (global.cinstance[0])
        {
            visible = 1;
        }
        with (global.cinstance[1])
        {
            visible = 1;
        }
        obj_mainchara.visible = 1;
        con = 13;
        charcycle -= 1;
        if (charcycle < 0)
        {
            con = 16;
        }
    }
    if (con == 13)
    {
        chartype = global.char[charcycle];
        if (charcycle == 0)
        {
            with (obj_mainchara)
            {
                visible = 0;
            }
            char = scr_dark_marker(390, 125, spr_krisd_dark);
            with (char)
            {
                depth = 400000;
            }
        }
