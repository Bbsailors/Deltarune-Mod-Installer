        if (hurtshake > 1)
        {
            if (shakex > 0)
            {
                shakex -= 1;
            }
            if (shakex < 0)
            {
                shakex += 1;
            }
            shakex = -shakex;
            hurtshake = 0;
        }
        draw_sprite_ext(hurtsprite, 0, x + shakex, y, 2, 2, 0, image_blend, 1);
    }
}
