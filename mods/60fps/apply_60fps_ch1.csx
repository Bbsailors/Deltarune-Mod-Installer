        image_xscale = 2.5;
        image_yscale = 2.5;
    }
}
if (t >= 1 && explode == 0)
{
    bolt_timer += 1;
    if (button1_p() && bolt_timer >= round(4 * global.fps_scale) && chosen_bolt == 0)
    {
        chosen_bolt = bolt_timer;
    }
    dir = point_direction(x, y, cx, cy);
    direction += (angle_difference(dir, direction) / 4 / global.fps_scale);
    image_angle = direction;
    if (point_distance(x, y, cx, cy) <= 40)
    {
        if (global.flag[966] == 1)
        {
            final_bolt = bolt_timer;
        }
        else
        {
            final_bolt = chosen_bolt;
        }
        visible = 0;
        explode = 1;
        t = 1;
    }
}
if (explode == 1)
{
    if (t == 1)
    {
        bonus_anim = 0;
        if (chosen_bolt > 0)
        {
            var _diff = final_bolt - chosen_bolt;
            var _tier = floor(_diff / global.fps_scale);
            if (_tier <= 0)
            {
                damage += 30;
            }
            else if (_tier == 1)
            {
                damage += 28;
            }
            else if (_tier == 2)
            {
                damage += 22;
            }
            else if (_tier == 3)
            {
                damage += 20;
            }
            else if (_tier == 4)
            {
                damage += 13;
            }
            else if (_tier == 5)
            {
                damage += 11;
            }
            else if (_tier == 6)
            {
                damage += 10;
            }
            if (_tier <= 2)
            {
                bonus_anim = 1;
                snd_play(snd_scytheburst);
            }
        }
        if (variable_global_exists(""fps_debug"") && global.fps_debug == 1)
        {
            var _rb_debug_final = bolt_timer;
            if (chosen_bolt > 0)
            {
                var _rb_debug_diff = _rb_debug_final - chosen_bolt;
                var _rb_debug_tier = floor(_rb_debug_diff / global.fps_scale);
                if (_rb_debug_tier <= 0)
                {
                    global.rb_debug_text = ""PERFECT"";
                    global.rb_debug_color = 65535;
                }
                else if (_rb_debug_tier <= 2)
                {
                    global.rb_debug_text = ""SUCCESSFUL"";
                    global.rb_debug_color = 65280;
                }
                else if (_rb_debug_tier <= 6)
                {
                    global.rb_debug_text = ""CLOSE"";
                    global.rb_debug_color = 16776960;
                }
                else
                {
                    global.rb_debug_text = ""TOO EARLY"";
                    global.rb_debug_color = 255;
                }
                global.rb_debug_tier = _rb_debug_tier;
                global.rb_debug_chosen = chosen_bolt;
                global.rb_debug_final = _rb_debug_final;
            }
            else
            {
                global.rb_debug_text = ""TOO LATE"";
                global.rb_debug_color = 255;
                global.rb_debug_tier = -1;
                global.rb_debug_chosen = chosen_bolt;
                global.rb_debug_final = _rb_debug_final;
            }
            global.rb_debug_timer = room_speed;
        }
        if (red == 1)
