        }
        if (global.facing == 0)
        {
            draw_rectangle(x + 4, y + 28, (x + sprite_width) - 4, y + sprite_height + 15, true);
        }
        if (global.facing == 2)
        {
            draw_rectangle(x + 3, (y + sprite_height) - 5, (x + sprite_width) - 5, y + 5, true);
        }
    }
    if (global.darkzone == 1)
