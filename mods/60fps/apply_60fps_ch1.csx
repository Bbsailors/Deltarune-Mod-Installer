Apply("gml_Object_obj_finalchain_Step_0", @"if (chaincon == 0)
{
    if (chain_noise == 0)
    {
        chainsound = snd_loop(snd_chain_extend);
        chain_noise = 1;
    }
    if (sons < 40)
    {
        sons += 1;
        son[sons] = instance_create(x, y, obj_chainpiece);
        son[sons].image_blend = c_red;
    }
    if (x <= obj_nonsolid_growtangle.x)
    {
        if (chain_noise == 1)
        {
            chain_noise = 2;
