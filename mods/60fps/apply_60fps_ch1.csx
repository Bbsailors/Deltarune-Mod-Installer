            draw_sprite(spr_heart, 0, xx + 220, yy + 400);
        }
        draw_text(xx + 240, yy + 390, string_hash_to_newline(scr_84_get_lang_string(""obj_thrashcontroller_slash_Draw_0_gml_171_0"")));
        if (endcoord == 1)
        {
