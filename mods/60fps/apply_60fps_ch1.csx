Apply("gml_Object_obj_starwalker_overworld_Draw_0", @"targetx = obj_mainchara.x + (obj_mainchara.sprite_width / 2);
bodyfacing = 1;
if (targetx <= (x - 30))
{
    bodyfacing = 0;
}
if (targetx >= (x + 30))
{
    bodyfacing = 2;
}
if (attackcon < 2)
{
    if (bodyfacing == 0)
    {
        xmake = -2;
    }
    if (bodyfacing == 2)
    {
        xmake = 2;
    }
}
bounce = sin(siner / 5);
wing_index += ((0.2 + abs(bounce / 8)) / global.fps_scale);
if (attackcon == -1)
{
    draw_sprite_ext(spr_starwalker_attack, 0, x, y + (bounce * 4), xmake, 2, image_angle, c_white, image_alpha);
}
if (attackcon == 0)
{
    siner += (1 / global.fps_scale);
    draw_sprite_ext(spr_starwalker_wings, wing_index, x, y + (bounce * 4), 2, 2, image_angle, c_white, image_alpha);
    draw_sprite_ext(spr_starwalker_body, bodyfacing, x, y + (sin(siner / 5) * 2), 2, 2, image_angle, c_white, image_alpha);
}
if (attackcon == 1)
{
    draw_sprite_ext(spr_starwalker_attack, 0, x, y + (bounce * 4), xmake, 2, image_angle, c_white, image_alpha);
}
if (attackcon == 2)
{
    shkx = random(shakefactor);
    shky = random(shakefactor);
    if (shakefactor > 0)
    {
        shakefactor -= (1 / global.fps_scale);
    }
    draw_sprite_ext(spr_starwalker_attack, 1, x + shkx, y + shky + (bounce * 4), xmake, 2, image_angle, c_white, image_alpha);
}
");

Apply("gml_Object_obj_starwalker_overworld_Step_0", @"if (instance_exists(obj_mainchara))
{
    if (loc_check == 0)
    {
        if (room == room_forest_starwalker)
        {
            if (obj_mainchara.x >= (room_width / 2))
            {
                x = 2200;
            }
        }
        loc_check = 1;
    }
    for (i = 5; i > 0; i -= 1)
    {
        char_xcheck[i] = char_xcheck[i - 1];
        char_ycheck[i] = char_ycheck[i - 1];
    }
    char_xcheck[0] = obj_mainchara.x;
    char_ycheck[0] = obj_mainchara.y;
    xcheck_average = ((obj_mainchara.x - char_xcheck[1]) + (obj_mainchara.x - char_xcheck[2]) + (obj_mainchara.x - char_xcheck[3])) / 3;
    if (xcheck_average >= 2 && x >= obj_mainchara.x)
    {
        xcheck_average = 0;
    }
    if (xcheck_average <= -2 && x <= obj_mainchara.x)
    {
        xcheck_average = 0;
    }
    ycheck_average = ((obj_mainchara.y - char_ycheck[1]) + (obj_mainchara.y - char_ycheck[2]) + (obj_mainchara.y - char_ycheck[3])) / 3;
}
if (keyboard_check_pressed(vk_backspace) && beatcon == 89898 && scr_debug())
{
    visible = 0;
    beatcon = 1;
    beattimer = 0;
    with (obj_mainchara)
    {
        battlemode = 0;
    }
    dead = instance_create(x - 92, y - 74, obj_starwalker_battle);
    with (dead)
    {
        walkcon = 1;
        walktimer = 0;
    }
    with (shadow)
    {
        instance_destroy();
    }
}
targetx = obj_mainchara.x + (obj_mainchara.sprite_width / 2);
targety = obj_mainchara.y + (obj_mainchara.sprite_height / 2);
if (mazemode == 0)
{
    if (abs(targetx - x) <= 200 && introcon == 0)
    {
        introcon = 1;
        with (obj_mainchara)
        {
            battlemode = 1;
        }
    }
    if (introcon == 1)
    {
        attackcon = 0;
        vspeed = -2 / global.fps_scale;
        introcon = 2;
    }
    if (introcon == 2)
    {
        attacktimer = 0;
        introtimer += 1;
        if (introtimer >= round(20 * global.fps_scale))
        {
            introcon = 3;
            vspeed = 0;
        }
    }
    if (introcon == 3)
    {
        friction = 0.5 / (global.fps_scale * global.fps_scale);
        if (targetx < x)
        {
            if (x <= (targetx + 150))
            {
                hspeed += (1 / (global.fps_scale * global.fps_scale));
            }
            if (x >= (targetx + 250))
            {
                hspeed -= (1 / (global.fps_scale * global.fps_scale));
            }
        }
        if (targetx > x)
        {
            if (x >= (targetx - 150))
            {
                hspeed -= (1 / (global.fps_scale * global.fps_scale));
            }
            if (x <= (targetx - 250))
            {
                hspeed += (1 / (global.fps_scale * global.fps_scale));
            }
        }
    }
}
if (mazemode == 1)
{
    if (targety <= y && introcon == 0)
    {
        introcon = 1;
        with (obj_mainchara)
        {
            battlemode = 1;
        }
    }
    if (introcon == 1)
    {
        attackcon = 0;
        vspeed = -8 / global.fps_scale;
        introcon = 2;
    }
    if (introcon == 2)
    {
        attacktimer = 0;
        introtimer += 1;
        if (introtimer >= round(5 * global.fps_scale))
        {
            introcon = 3;
            vspeed = 0;
            attacktimer = round(36 * global.fps_scale);
        }
    }
    if (introcon == 3)
    {
        friction = 0.7 / (global.fps_scale * global.fps_scale);
        if (targety < (y - 20))
        {
            vspeed -= (1.5 / (global.fps_scale * global.fps_scale));
        }
        if (targety > (y + 20))
        {
            vspeed += (1.5 / (global.fps_scale * global.fps_scale));
        }
    }
}
if (beatcon == 0)
{
    if (attackcon >= 0)
    {
        if (obj_mainchara.battlemode == 1)
        {
            attacktimer += 1;
        }
    }
    if (attackcon == 0)
    {
        wingtimer += 1;
        if (wingtimer >= 0)
        {
            snd_play(snd_wing);
            wingtimer = -round(16 * global.fps_scale);
        }
    }
    if (attacktimer >= round(42 * global.fps_scale) && attackcon == 0)
    {
        wingtimer = 0;
        shakefactor = 6;
        attackcon = 1;
        if (shot == 1)
        {
            for (i = 0; i < 3; i += 1)
            {
                with (starbullet[i])
                {
                    instance_destroy();
                }
            }
        }
    }
    if (attacktimer >= round(60 * global.fps_scale) && attackcon == 1)
    {
        snd_play(snd_crow);
        attackcon = 2;
        shot = 1;
        for (i = 0; i < 3; i += 1)
        {
            starbullet[i] = instance_create(x + (17 * xmake), y + 42, obj_overworldbulletparent);
            starbullet[i].sprite_index = spr_starbullet_test;
            starbullet[i].image_xscale = 2;
            starbullet[i].image_yscale = 2;
            starbullet[i].damage = 15;
            starbullet[i].active = 1;
            starbullet[i].target = 3;
            starbullet[i].speed = 10 / global.fps_scale;
            starbullet[i].friction = -0.2 / (global.fps_scale * global.fps_scale);
            starbullet[i].direction = (point_direction(x + (17 * xmake), y + 42, obj_mainchara.x + (xcheck_average * 10) + (obj_mainchara.sprite_width / 2), obj_mainchara.y + (obj_mainchara.sprite_height / 2)) - 17) + (17 * i);
            starbullet[i].depth = 1000;
        }
    }
    if (attacktimer >= round(80 * global.fps_scale))
    {
        siner = 0;
        wing_index = 0;
        attackcon = 0;
        attacktimer = 0;
        if (mazemode == 1)
        {
            attacktimer = round(38 * global.fps_scale);
        }
    }
}
if (instance_exists(shadow))
{
    if (attackcon == -1)
    {
        shadow.visible = 0;
    }
    else
    {
        shadow.visible = 1;
    }
    if (mazemode == 1)
    {
        shadow.visible = 0;
    }
    shadow.x = x;
    shadow.y = shadowy;
    shadow.sprite_index = spr_starwalker_wings;
    shadow.image_index = wing_index;
    if (attackcon == 1)
    {
        shadow.sprite_index = spr_starwalker_attack;
        shadow.image_index = 0;
        shadow.image_xscale = xmake;
    }
    if (attackcon == 2)
    {
        shadow.sprite_index = spr_starwalker_attack;
        shadow.image_index = 1;
        shadow.image_xscale = xmake;
    }
}
if (beatcon == 1)
{
    with (obj_mainchara)
    {
        battlemode = 0;
    }
    if (global.interact == 0)
    {
        global.interact = 1;
        beattimer = 0;
        beatcon = 2;
    }
}
if (beatcon == 2)
{
    beattimer += 1;
    if (dead.x >= (__view_get(e__VW.XView, 0) + __view_get(e__VW.WView, 0)) && global.interact != 0)
    {
        with (dead)
        {
            instance_destroy();
        }
        global.interact = 0;
        beatcon = 3;
        instance_destroy();
    }
}

enum e__VW
{
    XView,
    YView,
    WView,
    HView,
    Angle,
    HBorder,
    VBorder,
    HSpeed,
    VSpeed,
    Object,
    Visible,
    XPort,
    YPort,
    WPort,
    HPort,
    Camera,
    SurfaceID
}
");

