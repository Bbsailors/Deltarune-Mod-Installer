Apply("gml_Object_obj_joker_body_Draw_0", @"floatsiner += (floatsinerspeed / global.fps_scale);
fly = sin(floatsiner / 8) * 3 * ((floatsinerspeed * 2) - 1);
flyx = 0;
if (dancelv >= 1)
{
    flyx = cos(floatsiner / 8) * 3 * ((floatsinerspeed * 2) - 1);
}
if (dancelv == 4)
{
    flyx = 0;
    fly = 0;
}
offx = x + 20;
offy = y + 18;
if (condition == 0)
{
