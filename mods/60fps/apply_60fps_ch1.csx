Apply("gml_Object_obj_lancerbike_Step_0", @"if (lcon == 1)
{
    orx = x;
    ory = y;
    ang = 0;
    ltimer = 0;
    shrinktimer = 0;
    lcon = 1.5;
}
if (lcon == 1.5)
{
    ltimer += (1 / global.fps_scale);
    if (ltimer >= 10)
    {
        ltimer = 0;
        lcon = 2;
        snd_play(snd_cardrive);
    }
}
if (lcon >= 6 && lcon < 10)
{
    btimer += (1 / global.fps_scale);
    if (btimer >= 10)
    {
        xoff = lengthdir_x(40, image_angle - 20);
        yoff = lengthdir_y(40, image_angle - 20);
        snd_play(snd_spearrise);
        bullet = instance_create(x - xoff, y - yoff, obj_regularbullet);
        with (bullet)
        {
            target = obj_lancerbike.target;
            damage = obj_lancerbike.damage;
            if (target == 0)
            {
                if (global.hp[1] <= (global.maxhp[1] / 2))
                {
                    damage = ceil(global.hp[1] / 3);
                }
            }
            timepoints = 0;
            sprite_index = spr_spadebullet;
            move_towards_point(obj_heart.x + 8, obj_heart.y + 8, 4 / global.fps_scale);
            image_angle = direction;
            friction = -0.4 / (global.fps_scale * global.fps_scale);
        }
        bullet.depth = depth + 1;
        btimer = 0;
    }
}
if (lcon == 2)
{
    ltimer += (1 / global.fps_scale);
    shrinktimer += (1 / global.fps_scale);
    hspeed = (sin(ltimer / 3) * 5) / global.fps_scale;
    image_yscale = 2 - (sin(ltimer / 5) * 1);
    if (shrinktimer > 4)
    {
        image_yscale = 2 - (sin(ltimer / 5) * 1 * (8 / shrinktimer));
    }
    if (ltimer > 7)
    {
        image_angle -= ((abs(sin(ltimer / 5)) * 4) / global.fps_scale);
        ang = -image_angle;
    }
    if (ltimer > 4 && abs(sin(ltimer / 5)) <= 0.06)
    {
        lcon = 5;
        image_yscale = 2;
        direction = 180;
        speed = 4 / global.fps_scale;
    }
}
if (lcon == 5)
{
    if (speed < (16 / global.fps_scale))
    {
        speed += (2 / (global.fps_scale * global.fps_scale));
    }
    if (ang < 45)
    {
        ang += (4 / global.fps_scale);
    }
    image_angle = -ang;
    if (x < (__view_get(e__VW.XView, 0) + 80))
    {
        lcon = 6;
    }
}
if (lcon == 6)
{
    if (ang < 135)
    {
        ang += (10 / global.fps_scale);
    }
    image_angle = -ang;
    if (x <= (__view_get(e__VW.XView, 0) + 5))
    {
        lcon = 7;
        direction = 90;
    }
}
if (lcon == 7)
{
    if (y < (__view_get(e__VW.YView, 0) + 80))
    {
        if (ang < 225)
        {
            ang += (10 / global.fps_scale);
        }
        if (y <= (__view_get(e__VW.YView, 0) + 5))
        {
            direction = 0;
            lcon = 8;
        }
    }
    else if (ang < 135)
    {
        ang += (10 / global.fps_scale);
    }
    image_angle = -ang;
}
if (lcon == 8)
{
    if (x >= (__view_get(e__VW.XView, 0) + 540))
    {
        if (ang < 315)
        {
            ang += (10 / global.fps_scale);
        }
        if (x >= (__view_get(e__VW.XView, 0) + 630))
        {
            direction = 270;
            lcon = 9;
        }
    }
    else if (ang < 225)
    {
        ang += (10 / global.fps_scale);
    }
    image_angle = -ang;
}
if (lcon == 9)
{
    if (y > (ory - 70))
    {
        if (ang < 360)
        {
            ang += (10 / global.fps_scale);
        }
        if (y >= (ory - 5))
        {
            y = ory;
            direction = 180;
            lcon = 10;
        }
    }
    else if (ang < 315)
    {
        ang += (10 / global.fps_scale);
    }
    image_angle = -ang;
}
if (lcon == 10)
{
    ang = 0;
    image_angle = 0;
    if (x <= orx)
    {
        speed = 0;
        x = orx;
        lcon = 11;
        ltimer = 0;
    }
}
if (lcon == 11)
{
    sprite_index = spr_lancerbike_l;
    ltimer += (1 / global.fps_scale);
    if (ltimer >= 25)
    {
        with (obj_regularbullet)
        {
            active = 0;
            image_alpha -= (0.2 / global.fps_scale);
        }
        image_alpha = 1;
    }
    if (ltimer >= 30)
    {
        lcon = 0;
        endcon = 1;
    }
}
if (racecon == 1)
{
    sy = 0;
    s_moveup = 0;
    if (instance_exists(obj_susieandlancer_event))
    {
        s = obj_susieandlancer_event.s;
        sy = s.y;
