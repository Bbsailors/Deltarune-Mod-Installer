        }
        if (global.facing == 0)
        {
            draw_rectangle(x + 4, y + 56, (x + sprite_width) - 8, y + sprite_height + 30, true);
        }
        if (global.facing == 2)
        {
            draw_rectangle(x + 3, (y + sprite_height) - 10, (x + sprite_width) - 10, y + 10, true);
        }
    }
}
if (battlemode == 1)
{
