    {
        onoff = 2;
    }
    if (onoff == 0.5)
    {
        onoff = 1;
    }
    if (onoff == 0)
    {
        ashake = -shakeamt;
        onoff = 0.5;
    }
    if (onoff == 1)
    {
        ashake = shakeamt;
        if (shakeamt > 0)
        {
            shakeamt -= 1;
        }
        onoff = 1.5;
    }
