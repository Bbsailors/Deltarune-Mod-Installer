Apply("gml_Object_obj_mainchara_Step_0", @"scr_depth();
wallcheck = 0;
nowx = x;
nowy = y;
var nopress = 0;
if (press_d == 0 && press_l == 0 && press_u == 0 && press_r == 0)
{
    nopress = 1;
}
press_l = 0;
press_r = 0;
press_d = 0;
press_u = 0;
bkx = 0;
bky = 0;
bkxy = 0;
jelly = 2;
if (global.interact == 0)
{
    if (button3_p() && threebuffer < 0)
    {
        if (global.flag[7] == 0 && battlemode == 0)
        {
            with (obj_darkcontroller)
            {
                threebuffer = 2;
            }
            with (obj_overworldc)
            {
                movenoise = 1;
                threebuffer = 2;
            }
            global.menuno = 0;
            global.interact = 5;
            threebuffer = 2;
            twobuffer = 2;
        }
    }
    if (global.flag[11] == 1)
    {
        if (button2_h() && twobuffer < 0)
        {
            run = 0;
        }
        else
        {
            run = 1;
        }
    }
    else if (button2_h() && twobuffer < 0)
    {
        run = 1;
    }
    else
    {
        run = 0;
    }
    if (autorun > 0)
    {
        if (autorun == 1)
        {
            run = 1;
            runtimer = 200;
        }
        if (autorun == 2)
        {
            run = 1;
            runtimer = 50;
        }
    }
    if (run == 1)
    {
        if (darkmode == 0)
        {
