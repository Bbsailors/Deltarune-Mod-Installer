    yshake = lengthdir_y(shakeamt, shakedir);
    obj_heart.x += xshake;
    obj_heart.y += yshake;
    obj_growtangle.x += xshake;
    obj_growtangle.y += yshake;
    shakeamt -= (2 / global.fps_scale);
    if (shakeamt < 0)
    {
        chaincon = 3;
    }
}
if (chaincon == 3)
{
    chaincon = 5;
    smashtime = 1;
    bullettimer = 0;
}
