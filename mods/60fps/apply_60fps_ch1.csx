        instance_create(x, (y + sprite_height) - 40, obj_soliddark);
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_darkwakeevent_Step_0", @"if (con == 1)
{
    waketimer += 1;
    canclick = 0;
    if (waketimer < round(50 * global.fps_scale))
    {
        canclick = 1;
    }
    if (waketimer < round(110 * global.fps_scale) && waketimer > round(65 * global.fps_scale))
    {
        canclick = 1;
    }
    if (waketimer > round(125 * global.fps_scale) && waketimer < round(170 * global.fps_scale))
    {
        canclick = 1;
    }
    if (canclick == 1)
    {
        if (left_p())
        {
            waketimer += 2;
        }
        if (right_p())
        {
            waketimer += 2;
        }
        if (down_p())
        {
            waketimer += 2;
        }
        if (up_p())
        {
            waketimer += 2;
        }
    }
    if (waketimer == round(60 * global.fps_scale) || waketimer == round(62 * global.fps_scale))
    {
        with (k)
        {
            sprite_index = spr_kris_fallen_dark;
            x = xstart + choose(-2, 2);
            y = ystart + choose(-2, 2);
        }
    }
    if (waketimer == round(63 * global.fps_scale))
    {
        with (k)
        {
            x = xstart;
            y = ystart;
        }
    }
    if (waketimer == round(120 * global.fps_scale) || waketimer == round(121 * global.fps_scale) || waketimer == round(122 * global.fps_scale) || waketimer == round(123 * global.fps_scale))
    {
        with (k)
        {
            x = xstart + choose(-2, 2, 0);
            y = ystart + choose(-2, 2, 0);
        }
    }
    if (waketimer >= round(180 * global.fps_scale) && waketimer <= round(184 * global.fps_scale))
    {
        with (k)
        {
            x = xstart + choose(-2, 2, 0);
            y = ystart + choose(-2, 2, 0);
        }
    }
    if (waketimer == round(185 * global.fps_scale))
    {
        with (k)
        {
            instance_destroy();
        }
        with (obj_mainchara)
        {
            visible = 1;
        }
        global.interact = 0;
        con = 2;
        if (global.plot < 11)
        {
            global.plot = 11;
        }
        scr_tempsave();
        instance_destroy();
    }
}
");

Apply("gml_Object_obj_dbullet_maker_Draw_0", @"if (dont == 0)
{
    if (active == 0)
    {
        futuredir = point_direction(x, y, obj_heart.x + 8, obj_heart.y + 8);
        draw_sprite_ext(spr_diamondbullet_form, 0, x, y, 3 - (image_alpha * 2), 3 - (image_alpha * 2), futuredir, c_white, 1 - image_alpha);
        if (image_alpha < 1)
        {
            image_alpha += (0.1 / global.fps_scale);
        }
        else
        {
            move_towards_point(obj_heart.x + 8, obj_heart.y + 8, 2 / global.fps_scale);
            futuredir = direction;
            active = 1;
            speed = 0;
        }
    }
    draw_sprite_ext(sprite_index, 0, x, y, 2 - image_alpha, 2 - image_alpha, futuredir, c_white, image_alpha);
    if (active == 1)
    {
        activetimer += (1 / global.fps_scale);
        if (activetimer >= 5 && times < difficulty)
        {
            mybul = instance_create(x, y, obj_regularbullet);
            if (instance_exists(mybul))
            {
                mybul.damage = damage;
                mybul.target = target;
                mybul.sprite_index = spr_diamondbullet;
                mybul.direction = futuredir;
                with (mybul)
                {
                    speed = 6 / global.fps_scale;
                    image_angle = direction;
                }
            }
            times += 1;
            activetimer = 0;
        }
        if (activetimer >= 5 && times >= difficulty)
        {
            image_alpha -= (0.2 / global.fps_scale);
            if (image_alpha <= 0)
            {
                instance_destroy();
            }
        }
    }
}
dont = 0;
");

