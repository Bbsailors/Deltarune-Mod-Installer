    {
        timer = 0;
        condition = 3;
        size = 0;
    }
}
if (condition == 5)
{
    timer += (1 / global.fps_scale);
    if (timer == 1)
    {
        spintimer = 0;
        s_xscale = 2;
        s_yscale = 2;
        s_sprite = spr_joker_teleport;
        s_y = 0;
        s_vspeed = 0;
        s_alpha = 1;
        snd_play(scr_84_get_sound(""snd_joker_metamorphosis""));
    }
    if (timer >= 1 && timer <= 3)
    {
        s_xscale *= power(1.3, 1 / global.fps_scale);
        s_yscale *= power(0.7, 1 / global.fps_scale);
    }
    if (timer >= 5 && timer <= 15)
    {
        s_xscale *= power(0.7, 1 / global.fps_scale);
        s_yscale *= power(1.3, 1 / global.fps_scale);
    }
    if (timer >= 15 && timer <= 30)
    {
        spintimer += (1 / global.fps_scale);
        s_xscale = sin(spintimer / 3) * 2;
